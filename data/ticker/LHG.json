 Hậu mở rộng, Khu dân cư – Tái định cư xã Long Hậu và Khu công nghiệp Long Hậu 3 – giai đoạn 1. LHG được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Bất động sản","type":"CT","listed":"2010-03-23","state":0.48665267,"foreign":0.07229575,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Phát triển Công nghiệp Tân Thuận","p":null,"t":"CORPORATE","q":24338478,"pct":48.67,"d":"2026-02-10"},{"n":"Võ Tấn Thịnh","p":null,"t":"INDIVIDUAL","q":10014580,"pct":20.0,"d":"2020-08-28"},{"n":"Lumen Vietnam Fund","p":null,"t":"CORPORATE","q":2447700,"pct":4.89,"d":"2025-10-05"},{"n":"KITMC Worldwide Vietnam RSP Balanced Fund","p":null,"t":"CORPORATE","q":1324600,"pct":2.65,"d":"2025-10-05"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":548600,"pct":1.1,"d":"2025-10-05"},{"n":"Kim Investment Funds - Kim Vietnam Growth Fund","p":null,"t":"CORPORATE","q":394400,"pct":0.79,"d":"2025-10-05"},{"n":"Đoàn Hồng Dũng","p":null,"t":"INDIVIDUAL","q":125414,"pct":0.481,"d":"2015-09-14"},{"n":"Công ty Cổ phần Xuất nhập khẩu Thủy sản Miền Trung","p":null,"t":"CORPORATE","q":137910,"pct":0.28,"d":"2025-10-05"},{"n":"Bùi Vân Ảnh","p":null,"t":"INDIVIDUAL","q":20280,"pct":0.078,"d":"2015-09-14"},{"n":"Nguyễn Việt Dũng","p":null,"t":"INDIVIDUAL","q":9514,"pct":0.036,"d":"2015-09-14"},{"n":"Lê Mạnh Thường","p":null,"t":"INDIVIDUAL","q":13730,"pct":0.027,"d":"2025-10-05"},{"n":"Võ Thị Huyền Lan","p":null,"t":"INDIVIDUAL","q":5187,"pct":0.02,"d":"2025-10-05"},{"n":"Tô Hữu Duy","p":null,"t":"INDIVIDUAL","q":2067,"pct":0.008,"d":"2015-09-14"},{"n":"Trần Vân Khánh Giang","p":null,"t":"INDIVIDUAL","q":1590,"pct":0.006,"d":"2015-09-14"},{"n":"Diệp Dũng","p":null,"t":"INDIVIDUAL","q":1277,"pct":0.005,"d":"2015-09-14"},{"n":"Nguyễn Thị Bích Ngà","p":null,"t":"INDIVIDUAL","q":650,"pct":0.002,"d":"2015-09-14"}],"rel":[{"c":"IGREENCORP","n":"Công Ty Cổ Phần Công Nghệ Igreen","t":"affiliate","pct