, dự án cao tốc Nội Bài - Lào Cai, dự án mở rộng Quốc lộ 1A qua Bình Thuận. Ngày 03/07/2023, LUT chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-01-04","state":0.022,"foreign":0.00535233,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bùi Đình Hưng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4344000,"pct":29.04,"d":"2025-10-05"},{"n":"Đinh Anh Kiệt","p":null,"t":"INDIVIDUAL","q":692870,"pct":4.62,"d":"2025-10-05"},{"n":"Huỳnh Hoàng Hương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":690000,"pct":4.61,"d":"2025-10-05"},{"n":"Nguyễn Thị Hồng","p":null,"t":"INDIVIDUAL","q":542500,"pct":3.62,"d":"2025-10-05"},{"n":"Đặng Thanh Qui","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":540000,"pct":3.61,"d":"2025-10-05"},{"n":"Nguyễn Văn Giang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":537600,"pct":3.59,"d":"2025-10-05"},{"n":"Bành Trường Giang","p":null,"t":"INDIVIDUAL","q":330000,"pct":2.206,"d":"2015-09-14"},{"n":"Phạm Đức Trí","p":null,"t":"INDIVIDUAL","q":330000,"pct":2.206,"d":"2015-09-14"},{"n":"Tổng Công ty Xây Dựng Công Trình Giao Thông 6 - Công ty Cổ phần","p":null,"t":"CORPORATE","q":330000,"pct":2.2,"d":"2015-06-15"},{"n":"Nguyễn Như Trực","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.668,"d":"2015-09-14"},{"n":"Huỳnh Thị Thanh Phương","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.201,"d":"2015-09-14"},{"n":"Đỗ Khắc Công","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.1,"d":"2025-10-05"},{"n":"Phan Anh Tuấn","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":10510,"pct":0.07,"d":"2025-10-05"},{"n":"Công ty TNHH MTV Chứng Khoán Ngân hàng Số Vikki","p":null,"t":"CORPORATE","q":2450,"pct":0.02,"d":"2025-10-05"},{"n":"Phạm Thị Thu Nga","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Thị Bích Quyên","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.017,"d":"2025-10-05"}],"events":[{"c":"MOVE","t":"LUT - Chuyển sàn từ HNX sang UPCoM","d":"2