 thương phẩm và gạch không nung. Hiện nay, Công ty đã có 4 dây chuyền sản xuất hiện đại với tổng công suất trên 1 triệu tấn/năm, hệ thống đóng bao tự động, tổng công suất đóng bao 120 tấn/giờ. Công ty có mạng lưới phân phối rộng với hơn 100 đại lý tại các khu vực: Đồng bằng Sông Cửu Long, các tỉnh Đông Nam Bộ, tỉnh Bình Thuận, Đắk Lắk, Đắk Nông, thành phố Hồ Chí Minh và thị trường Campuchia. Ngày 06/07/2018, CCM chính thức được giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-09-18","state":0.0,"foreign":0.00080582,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty Tnhh Thái Hưng","p":null,"t":"CORPORATE","q":1659926,"pct":26.77,"d":"2026-01-28"},{"n":"Thái Minh Thuyết","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1138445,"pct":18.362,"d":"2026-01-28"},{"n":"Nguyễn Thị Út Em","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1026068,"pct":16.55,"d":"2026-01-28"},{"n":"Nguyễn Thị Út","p":null,"t":"INDIVIDUAL","q":747500,"pct":16.25,"d":"2015-09-14"},{"n":"Thái Vân Thanh","p":null,"t":"INDIVIDUAL","q":884375,"pct":14.264,"d":"2026-01-28"},{"n":"Thái Châu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":620000,"pct":10.0,"d":"2026-01-28"},{"n":"Thái Hoàng Tước","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":620000,"pct":10.0,"d":"2026-01-28"},{"n":"Nguyễn Kim Hoàng","p":null,"t":"INDIVIDUAL","q":275000,"pct":5.978,"d":"2015-09-14"},{"n":"Nguyễn Thị Hồng Nguyên","p":null,"t":"INDIVIDUAL","q":275000,"pct":5.978,"d":"2015-09-14"},{"n":"Nguyễn Phan Ngọc Dung","p":null,"t":"INDIVIDUAL","q":229900,"pct":4.998,"d":"2015-09-14"},{"n":"Nguyễn Thế Xuân ý","p":null,"t":"INDIVIDUAL","q":77000,"pct":1.674,"d":"2015-09-14"},{"n":"Đặng Hoài Bảo","p":null,"t":"INDIVIDUAL","q":660,"pct":0.014,"d":"2015-09-14"},{"n":"Trương Ngọc Quang","p":null,"t":"INDIVIDUAL","q":50,"pct":0.001,"d":"2015-09-14"},{"n":"Trần Kỹ Xiết","p":null,"t":"INDIVIDUAL","q":40,"pct":0.