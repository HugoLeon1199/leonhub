uốc, tương đương với 66% thị phần vận tải của Petrolimex. VTO được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2007.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2007-10-09","state":0.51918052,"foreign":0.03987331,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Vận Tải Thủy Petrolimex","p":null,"t":"CORPORATE","q":41465217,"pct":51.918,"d":"2026-08-26"},{"n":"Huỳnh Quế Hà","p":null,"t":"INDIVIDUAL","q":3105000,"pct":3.937,"d":"2015-09-14"},{"n":"KITMC Worldwide Vietnam RSP Balanced Fund","p":null,"t":"CORPORATE","q":1573900,"pct":1.97,"d":"2025-10-05"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":1100000,"pct":1.38,"d":"2025-10-05"},{"n":"La Văn Út","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1000000,"pct":1.252,"d":"2026-08-26"},{"n":"Tmam Vietnam Equity Mother Fund","p":null,"t":"CORPORATE","q":1000000,"pct":1.25,"d":"2025-10-05"},{"n":"Văn Thị Hồng Phượng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":700000,"pct":0.876,"d":"2026-08-20"},{"n":"Nguyễn Thị Tuyết","p":null,"t":"INDIVIDUAL","q":651950,"pct":0.816,"d":"2026-07-14"},{"n":"Kim Investment Funds - Kim Vietnam Growth Fund","p":null,"t":"CORPORATE","q":534500,"pct":0.67,"d":"2025-10-05"},{"n":"KIM PMAA Vietnam Securities Investment Trust 1(Equity)","p":null,"t":"CORPORATE","q":352900,"pct":0.44,"d":"2025-10-05"},{"n":"Đàm Xuân Trọng","p":null,"t":"INDIVIDUAL","q":106640,"pct":0.135,"d":"2015-09-14"},{"n":"Trần Tố Uyên","p":null,"t":"INDIVIDUAL","q":101630,"pct":0.127,"d":"2026-08-26"},{"n":"Hoàng Thị Mỹ Lợi","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.125,"d":"2026-08-26"},{"n":"Phan Thị Thuý Hằng","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":80000,"pct":0.1,"d":"2026-08-26"},{"n":"Nguyễn Công Định","p":null,"t":"INDIVIDUAL","q":47970,"pct":0.061,"d":"2015-09-14"},{"n":"Nguyễn Thanh Tuyên","p":"Trưởng Ban kiểm soát","t":"INDIV