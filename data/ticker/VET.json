sản xuất, kinh doanh thuốc thú y, thú y thủy sản, và nghiên cứu khoa học về thú y, các phương pháp chẩn đoán, phòng chống bệnh gia súc gia cầm. VET chính thức hoạt động theo mô hình công ty cổ phần từ năm 2013. Công ty đang quản lý vận hành 03 phân xưởng sản xuất là phân xưởng sản xuất vắc xin siêu vi trùng, phân xưởng sản xuất vắc xin vi trùng và phân xưởng sản xuất dược phẩm với gần 160 sản phẩm vắc xin và dược phẩm thú y, thú y thủy sản. VET được giao dịch trên thị trường UPCOM từ cuối năm 2017.","sector":"Hóa chất","type":"CT","listed":"2017-12-13","state":0.65,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bộ Nông Nghiệp Và Phát Triển Nông Thôn","p":null,"t":"CORPORATE","q":10400000,"pct":65.0,"d":"2026-01-26"},{"n":"Công ty Cổ phần Tập đoàn Nova Consumer","p":null,"t":"CORPORATE","q":1949431,"pct":12.184,"d":"2026-01-26"},{"n":"Phạm Thị Cúc","p":null,"t":"INDIVIDUAL","q":936219,"pct":5.85,"d":"2025-10-05"},{"n":"Trần Hải Ninh","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.63,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Lan","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":46400,"pct":0.29,"d":"2026-01-26"},{"n":"Dương Mạnh Lân","p":null,"t":"INDIVIDUAL","q":42700,"pct":0.267,"d":"2025-10-05"},{"n":"Trần Xuân Hạnh","p":null,"t":"INDIVIDUAL","q":35700,"pct":0.22,"d":"2025-10-05"},{"n":"Nguyễn Thị Hồng Hoa","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":26400,"pct":0.17,"d":"2026-01-26"},{"n":"Hồ Cảnh Sơn","p":null,"t":"INDIVIDUAL","q":26500,"pct":0.166,"d":"2025-10-05"},{"n":"Phạm Quang Thái","p":null,"t":"INDIVIDUAL","q":16200,"pct":0.101,"d":"2025-10-05"},{"n":"Trầm Tuấn Khanh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":10700,"pct":0.07,"d":"2026-01-26"},{"n":"Đỗ Thị Hải Thanh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":11000,"pct":0.069,"d":"2026-01-26"},{"n":"Nguyễn Hữu Huân","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":7000,"pct":0.044,"d":"2026-01-26"},{"n":"Ng