.419],["2021",8.642],["2022",8.794],["2023",5.134],["2024",6.423],["2025",9.472]]}},"co":{"short":"Tài chính Tổng hợp Điện lực","profile":"Công ty Tài chính Tổng hợp Cổ phần Điện Lực (EVF) được thành lập vào tháng 07/2008. Công ty hoạt động trong lĩnh vực i) Huy động vốn, (ii) Cho vay ngắn hạn, trung hạn và dài hạn, (iii) Chiết khấu thương phiếu, trái phiếu và giấy tờ có giá. EVF trở thành công ty đại chúng từ tháng 09/2008. Công ty đóng vai trò là đầu mối thu xếp vốn, quản trị vốn cho các dự án điện thuộc Tập đoàn Điện lực Việt Nam và các đơn vị thành viên, đồng thời cung cấp các sản phẩm dịch vụ tài chính cho các đơn vị trong ngành điện và các đơn vị thuộc các thành phần kinh tế khác. Tính đến thời điểm 31/12/2024, Tổng tài sản của Công ty đạt 59.598 tỷ đồng tăng 21% so với cùng kỳ năm trước. Tỷ suất lợi nhuận trên vốn chủ sở hữu bình quân và tỷ suất lợi nhuận trên tổng tài sản bình quân lần lượt ở mức 6,43% và 1,08%. Ngày 12/01/2022, EVF giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Dịch vụ tài chính","type":"NH","listed":"2018-08-07","state":0.0,"foreign":0.00226937,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Đầu Tư Tài Chính Hòa An","p":null,"t":"CORPORATE","q":35046456,"pct":4.61,"d":"2026-01-05"},{"n":"Ngân hàng Thương mại Cổ phần An Bình","p":null,"t":"CORPORATE","q":8158600,"pct":2.32,"d":"2025-10-05"},{"n":"Nguyễn Văn Cảnh","p":null,"t":"INDIVIDUAL","q":7540000,"pct":1.39,"d":"2026-01-05"},{"n":"Tăng Minh Vương","p":null,"t":"INDIVIDUAL","q":7180000,"pct":0.99,"d":"2026-01-06"},{"n":"Lê Mạnh Linh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3310980,"pct":0.435,"d":"2026-07-30"},{"n":"Phạm Trung Kiên","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3295927,"pct":0.433,"d":"2026-07-30"},{"n":"Công ty Cổ phần Quản Lý Quỹ Amber","p":null,"t":"CORPORATE","q":3063112,"pct":0.4,"d":"2026-01-05"},{"n":"Mai Danh Hiền","p":null,"t":"INDIVIDUAL",