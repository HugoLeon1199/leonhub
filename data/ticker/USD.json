ình Đô thị Sóc Trăng (USD) có tiền thân là Công ty Quản lý Công trình Đô thị Thị xã Sóc Trăng được thành lập vào năm 1988. Công ty hoạt động chủ yếu trong các lĩnh vực dịch vụ công ích trên địa bàn thành phố Sóc Trăng và các huyện, thị thuộc tỉnh Sóc Trăng. Bên cạnh đó, Công ty còn có chức năng thực hiện hoạt động kinh doanh dịch vụ trong và ngoài tỉnh Sóc Trăng, tạo thêm nguồn thu để duy trì, phát triển doanh nghiệp. USD chính thức hoạt động theo mô hình công ty cổ phần từ tháng 01/2018.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2019-01-30","state":0.38884554,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Sóc Trăng","p":null,"t":"CORPORATE","q":2177535,"pct":38.88,"d":"2026-08-19"},{"n":"Lâm Hữu Tùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1199165,"pct":21.41,"d":"2026-08-19"},{"n":"Công Ty Cổ Phần Ô Tô Chuyên Dùng Hiệp Hoà","p":null,"t":"CORPORATE","q":1000000,"pct":17.86,"d":"2026-08-19"},{"n":"Lê Thị Hòa","p":null,"t":"INDIVIDUAL","q":435000,"pct":7.77,"d":"2025-10-05"},{"n":"Trịnh Xuân Thắng","p":null,"t":"INDIVIDUAL","q":279000,"pct":4.98,"d":"2025-10-05"},{"n":"Đậu Đức Hiển","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":40800,"pct":0.729,"d":"2026-08-19"},{"n":"Nguyễn Đức Khôi","p":null,"t":"INDIVIDUAL","q":36200,"pct":0.65,"d":"2025-10-05"},{"n":"Trần Tuyết Nương","p":null,"t":"INDIVIDUAL","q":21100,"pct":0.38,"d":"2025-10-05"},{"n":"Đặng Thanh Bình","p":null,"t":"INDIVIDUAL","q":6900,"pct":0.12,"d":"2025-10-05"},{"n":"Hồ Thống Nhất","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6300,"pct":0.112,"d":"2026-08-19"},{"n":"Phùng Thanh Tâm","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":4700,"pct":0.084,"d":"2026-08-19"},{"n":"Huỳnh Thị Thùy Trang","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":4000,"pct":0.071,"d":"2026-08-19"},{"n":"Đoàn Thị Bích Nga","p":null,"t":"INDIVIDUAL","q":3600,"pct":0.064,"d":"