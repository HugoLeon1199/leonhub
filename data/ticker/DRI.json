ong lĩnh vực khai thác, chế biến mủ cao su và cây ăn quả. Công ty hiện đang quản lý vườn cao su trồng tại 2 tỉnh ChămPaSăk và Salaval tại Lào thông qua công ty con, tổng diện tích cao su lên đến 8.810,5 ha. DRI chủ yếu sản xuất các sản phẩm SVR3L, SVR10 và SVR60. Ngoài ra, Công ty còn tham gia vào hoạt động sản xuất và kinh doanh các sản phẩm nông nghiệp và lâm nghiệp khác như trồng cà phê, điều và bạch đàn. DRI được giao dịch trên thị trường UPCOM từ tháng 05/2017.","sector":"Hóa chất","type":"CT","listed":"2017-05-23","state":0.66598361,"foreign":0.01975791,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Cao su Đắk Lắk","p":null,"t":"CORPORATE","q":32940000,"pct":45.0,"d":"2026-08-05"},{"n":"Quỹ Đầu tư Cổ phiếu Triển vọng Bảo Việt","p":null,"t":"CORPORATE","q":500000,"pct":0.683,"d":"2020-07-14"},{"n":"Bùi Quang Ninh","p":null,"t":"INDIVIDUAL","q":150000,"pct":0.2,"d":"2025-10-05"},{"n":"Nguyễn Độ","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":112511,"pct":0.15,"d":"2026-08-05"},{"n":"Nguyễn Viết Tượng","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.137,"d":"2026-08-05"},{"n":"Nguyễn Thị Hải","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":50000,"pct":0.068,"d":"2026-08-05"}],"rel":[{"c":"2040186","n":"Công ty TNHH Cao Su Đắk Lắk","t":"subsidiary","pct":100.0},{"c":"6001605111","n":"Công ty TNHH Nông Nghiệp Công Nghệ Cao Dri","t":"subsidiary","pct":83.87}],"rel_count":2,"events":[{"c":"OTHE","t":"DRI - Thay đổi địa chỉ","d":"2026-07-02","record":null,"ex":null},{"c":"AGME","t":"DRI - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-22","record":"2026-05-18","ex":"2026-05-15"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2024 - 500 VND","d":"2025-07-18","record":"2025-07-30","ex":"2025-07-29"},{"c":"DDIND","t":"Bùi Quang Ninh - Đăng kí Bán 150,000 DRI","d":"2025-05-06","record":null,"ex":null},{"c":"DDIND","t":"Bùi Quang Ninh - Đăng kí