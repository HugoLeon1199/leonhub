o":{"short":"VLXD Biên Hòa","profile":"Công ty Cổ phần Xây dựng và Sản xuất Vật liệu Xây dựng Biên Hòa (VLB) được thành lập năm 1983 với tiền thân là Xí nghiệp Khai thác Đất Biên Hòa. Công ty đã có kinh nghiệm hơn 30 năm hoạt động trong lĩnh vực khai thác, chế biến vật liệu xây dựng. Trên địa bàn tỉnh Đồng Nai, VLB đang quản lý, khai thác và kinh doanh 6 mỏ đá và hệ thống các bến thủy nội địa có công suất bốc dỡ đá trên 2 triệu m3 đá thành phẩm/năm để cung cấp vật liệu xây dựng cho khu vực phía nam. VLB được giao dịch trên thị trường UPCOM từ tháng 09/2016.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-09-22","state":0.49081873,"foreign":0.00012574,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Công Nghiệp Thực Phẩm Đồng Nai - MTV Công ty TNHH","p":null,"t":"CORPORATE","q":23030000,"pct":49.08,"d":"2026-08-06"},{"n":"Công ty TNHH Đầu tư Phát triển Công nghiệp KSB","p":null,"t":"CORPORATE","q":10300000,"pct":21.95,"d":"2025-10-23"},{"n":"Công ty Cổ phần Hóa An","p":null,"t":"CORPORATE","q":4715000,"pct":10.09,"d":"2026-08-26"},{"n":"Nguyễn Xuân Việt","p":null,"t":"INDIVIDUAL","q":101040,"pct":0.215,"d":"2025-10-05"},{"n":"Phạm Thái Hợp","p":"Phó Giám đốc","t":"INDIVIDUAL","q":97800,"pct":0.21,"d":"2026-08-06"},{"n":"Huỳnh Kim Vũ","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":60000,"pct":0.13,"d":"2026-08-06"},{"n":"Nguyễn Văn Dũng","p":null,"t":"INDIVIDUAL","q":48774,"pct":0.104,"d":"2025-10-05"},{"n":"Trần Thị Thanh Bình","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.085,"d":"2026-08-06"},{"n":"Hứa Hồ Điệp","p":null,"t":"INDIVIDUAL","q":39440,"pct":0.084,"d":"2025-10-05"},{"n":"Trần Quốc Triều","p":"Kế toán trưởng","t":"INDIVIDUAL","q":31800,"pct":0.07,"d":"2026-08-06"},{"n":"Nguyễn Thị Thuận Hiếu","p":null,"t":"INDIVIDUAL","q":29640,"pct":0.063,"d":"2025-10-05"},{"n":"Huỳnh Xuân Đạo","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":14000,"pct":0.03,"d":"2026-08-06"},{"n":"Huỳnh Đư