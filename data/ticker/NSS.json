93],["2026-Q2",-2.893]],"y":[["2018",16.996],["2019",11.824],["2020",0.0],["2021",28.607],["2022",12.901],["2023",3.263],["2024",-2.964],["2025",-2.893]]}},"co":{"short":"Nông súc sản Đồng Nai","profile":"Công ty Cổ phần Nông súc sản Đồng Nai (NSS) có tiền thân là Công ty Chăn nuôi Đồng Nai được thành lập vào năm 1978 bởi UBND Tỉnh Đồng Nai. Công ty hoạt động chính trong lĩnh vực chăn nuôi gia súc theo mô hình công nghiệp. NSS chính thức hoạt động theo mô hình công ty cổ phần từ năm 2005. Công ty hiện đang quản lý 03 trại chăn nuôi heo, 01 xưởng chế biến thực phẩm và 01 cửa hàng giới thiệu sản phẩm trên địa bàn tỉnh Đồng Nai. Ngoài ra, Công ty còn tham gia kinh doanh cho thuê mặt bằng kho bãi và đầu tư tài chính. NSS được giao dịch trên thị trường UPCOM từ cuối tháng 10/2018.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2018-10-30","state":0.84315967,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Công Nghiệp Thực Phẩm Đồng Nai - MTV Công ty TNHH","p":null,"t":"CORPORATE","q":8654142,"pct":84.32,"d":"2026-08-14"},{"n":"Lê Thị Khánh Xương","p":null,"t":"INDIVIDUAL","q":810000,"pct":7.89,"d":"2026-08-14"},{"n":"Trần Minh Phương","p":"Phó Giám đốc","t":"INDIVIDUAL","q":67800,"pct":0.66,"d":"2026-08-14"},{"n":"Ngô Thị Kim Hưng","p":null,"t":"INDIVIDUAL","q":36800,"pct":0.36,"d":"2026-08-14"},{"n":"Lâm Hùng Phương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":35600,"pct":0.35,"d":"2026-08-14"},{"n":"Nguyễn Diên Tường","p":null,"t":"INDIVIDUAL","q":13400,"pct":0.13,"d":"2025-10-05"},{"n":"Trương Tấn Cường","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":13300,"pct":0.13,"d":"2026-08-14"},{"n":"Phan Thị Hiền Nhi","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":5000,"pct":0.049,"d":"2026-08-14"},{"n":"Đinh Ngọc Mến","p":"Phó Chủ tịch Hội đồng Quản trị/Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":3400,"pct":0.03,"d":"2026-08-14"},{"n":"Nguyễn Sỹ Sinh","p":"Thành viên