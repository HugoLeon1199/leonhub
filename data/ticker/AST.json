5.666],["2024",36.921],["2025",47.902]]}},"co":{"short":"Dịch vụ Hàng không Taseco","profile":"Công ty Cổ phần Dịch vụ Hàng không Taseco (AST) có tiền thân là Công ty Cổ phần Dịch vụ Hàng không Taseco Nội Bài được thành lập vào năm 2015. Năm 2017, Công ty chuyển đổi mô hình kinh doanh, thành Công ty Cổ phần Dịch vụ Hàng không Taseco. Công ty hoạt động trong lĩnh vực cung cấp dịch vụ nhà hàng, bán hàng bách hóa, lưu niệm tại sân bay, kinh doanh khách sạn, dịch vụ quảng cáo và sản xuất cung cấp xuất ăn hàng không. Mạng lưới hoạt động dinh doanh của AST rộng khắp các cảng hàng không quốc tế trên cả nước. Chuỗi dịch vụ của Taseco Airs có mặt trên các sân bay từ miền Bắc (Sân bay quốc tế Nội Bài, Sân bay quốc tế Vân Đồn) vào miền Trung (Sân bay Quốc tế Đà Nẵng và Sân bay quốc tế Phú Bài – Huế) đến miền Nam (Sân bay Quốc tế Tân Sơn Nhất và Sân bay quốc tế Phú Quốc). Ngày 04/01/2018, AST chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bán lẻ","type":"CT","listed":"2018-01-04","state":0.0,"foreign":0.46309503,"rating":"BUY","target":80600.0,"rating_as_of":"2025-08-26","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn Taseco","p":null,"t":"CORPORATE","q":22950000,"pct":51.0,"d":"2026-07-31"},{"n":"Penm Iv Germany Gmbh & Co.kg","p":null,"t":"CORPORATE","q":7939300,"pct":17.64,"d":"2026-07-31"},{"n":"Stic Pan-asia 4th Industry Growth Private Equity Fund","p":null,"t":"CORPORATE","q":4500000,"pct":10.0,"d":"2026-07-31"},{"n":"Phạm Ngọc Thanh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":125000,"pct":0.278,"d":"2026-07-31"},{"n":"Lê Anh Quốc","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":62500,"pct":0.139,"d":"2026-07-31"},{"n":"Nguyễn Minh Hải","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":62500,"pct":0.139,"d":"2026-07-31"},{"n":"Đào Tiến Dương","p":null,"t":"INDIVIDUAL","q":37500,"pct":0.08,"d":"2025-10-05"},{"n":"Trần Thị Loan","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q"