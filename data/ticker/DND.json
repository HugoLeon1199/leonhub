Công ty cổ phần từ năm 2005. DNC hiện quản lý và vận hành 2 trạm trộn bê tông thương phẩm với công suất 600m3/h và Nhà máy Gạch Tuynel Long Thành với công suất 20 triệu viên gạch tiêu chuẩn/năm. Bên cạnh đó, DND được cấp giấy phép khai thác Mỏ đá xây dựng Tân Cang 5 vào năm 2009 với khối lượng khai thác 1 triệu m3/năm, và Mỏ đá Thiện Tân 5 vào năm 2013 với diện tích 27,7ha. DND được giao dịch trên thị trường UPCOM từ cuối năm 2016.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-11-09","state":0.35992987,"foreign":0.00312451,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Phát triển Khu Công nghiệp","p":null,"t":"CORPORATE","q":4619340,"pct":35.99,"d":"2026-08-17"},{"n":"Công ty Cổ Phần Xây Dựng Số 2 Đồng Nai","p":null,"t":"CORPORATE","q":3134737,"pct":24.43,"d":"2026-08-17"},{"n":"Công ty CP Cấu Kiện Bê Tông Nhơn Trạch 2","p":null,"t":"CORPORATE","q":3020000,"pct":23.53,"d":"2026-08-17"},{"n":"Công ty Cổ phần Chứng khoán Đại Việt","p":null,"t":"CORPORATE","q":1000000,"pct":7.87,"d":"2025-11-13"},{"n":"Trương Cường","p":null,"t":"INDIVIDUAL","q":18600,"pct":0.15,"d":"2026-04-15"},{"n":"Phạm Thái Hoài Hương","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.03,"d":"2025-12-23"},{"n":"Nguyễn Tiến Toản","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.01,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"DND - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-27","record":"2026-03-12","ex":"2026-03-11"},{"c":"AGME","t":"DND - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-25","record":"2025-03-17","ex":"2025-03-14"},{"c":"AIS","t":"DND - Đăng ký giao dịch bổ sung 4.000.000 cổ phiếu","d":"2025-02-07","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 45.3%","d":"2024-11-20","record":"2024-11-19","ex":"2024-11-19"},{"c":"DDINS","t":"Công ty Cổ Phần Xây Dựng Số 2 Đồng Nai - Đăng kí Mua 980,000 DND","d":"2024-11-20","record":null,"ex":null},{"c":"AGME","t":"DND - Tổ chức ĐHĐCĐ thường niên 2024"