ổ phần Dược phẩm Trung Ương 3 (DP3) có tiền thân là Xí nghiệp Dược phẩm Trung ương 3 trực thuộc Bộ Y tế được thành lập vào năm 1962. Hoạt động chính của Công ty là sản xuất, kinh doanh dược phẩm, hóa chất, mỹ phẩm, thực phẩm bổ dưỡng. Công ty đang sản xuất hơn 100 loại thuốc trong đó có các sản phẩm đã khẳng định được vị trí trong và ngoài nước như Cao Sao Vàng, Hoàn Bổ Thận Âm, Sâm Nhung. Công ty có 03 chi nhánh và trên 10 nhà phân phối độc quyền với kênh phân phối chủ yếu là thông qua đấu thầu để cung cấp cho các bệnh viện trên cả nước. DP3 được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2015.","sector":"Y tế","type":"CT","listed":"2015-07-17","state":0.22074892,"foreign":0.00845403,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Dược Việt Nam - CTCP","p":null,"t":"CORPORATE","q":4746087,"pct":22.07,"d":"2026-02-11"},{"n":"Nguyễn Đình Khái","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3150850,"pct":14.655,"d":"2026-07-27"},{"n":"Lê Thanh Thuỷ","p":null,"t":"INDIVIDUAL","q":2086332,"pct":9.704,"d":"2026-02-11"},{"n":"Bùi Xuân Hưởng","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":1371800,"pct":6.38,"d":"2026-07-27"},{"n":"Đinh Văn Cường","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1199170,"pct":5.578,"d":"2026-07-27"},{"n":"Nguyễn Thanh Tuấn","p":null,"t":"INDIVIDUAL","q":1059127,"pct":4.926,"d":"2025-10-05"},{"n":"Lê Thị Vân","p":null,"t":"INDIVIDUAL","q":1004280,"pct":4.671,"d":"2026-02-11"},{"n":"Lê Văn Hùng","p":"Thành viên Hội đồng Quản trị/Giám đốc Chi nhánh","t":"INDIVIDUAL","q":962062,"pct":4.475,"d":"2026-07-27"},{"n":"Hoàng Thị Mơ","p":null,"t":"INDIVIDUAL","q":951622,"pct":4.426,"d":"2026-02-11"},{"n":"Nguyễn Thị Minh Hương","p":null,"t":"INDIVIDUAL","q":114075,"pct":0.531,"d":"2026-02-11"},{"n":"Hoàng Duy Anh","p":null,"t":"INDIVIDUAL","q":20700,"pct":0.3,"d":"2016-08-26"},{"n":"Bùi Thị Loan","p":"Phó Tổng 