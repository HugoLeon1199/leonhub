 Công nghiệp Thực phẩm Hapro tại xã Lệ Chi, huyện Gia Lâm, Hà Nội. HAF được giao dịch trên thị trường UPCOM từ tháng 07/2017.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-07-24","state":0.19996897,"foreign":6.9e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Phát Triển Kinh Doanh Khánh An","p":null,"t":"CORPORATE","q":3419700,"pct":23.58,"d":"2025-10-31"},{"n":"Công ty TNHH Tư Vấn Thiết Kế Quốc Tế Tầm Nhìn Mới","p":null,"t":"CORPORATE","q":3386700,"pct":23.36,"d":"2025-11-24"},{"n":"Công ty Cổ Phần Đầu Tư Thông Minh Quốc Tế","p":null,"t":"CORPORATE","q":3383123,"pct":23.33,"d":"2025-11-24"},{"n":"Tổng Công ty Thương mại Hà Nội – Công ty cổ phần","p":null,"t":"CORPORATE","q":2899550,"pct":20.0,"d":"2026-06-03"},{"n":"Trương Thị Nga","p":null,"t":"INDIVIDUAL","q":3100,"pct":0.021,"d":"2025-10-05"},{"n":"Lê Thị Ngọc Diệp","p":null,"t":"INDIVIDUAL","q":2100,"pct":0.014,"d":"2025-10-05"},{"n":"Chu Việt Cường","p":"Giám đốc","t":"INDIVIDUAL","q":1600,"pct":0.011,"d":"2026-04-24"},{"n":"Nguyễn Kim Huyền","p":null,"t":"INDIVIDUAL","q":1300,"pct":0.009,"d":"2025-10-05"}],"rel":[{"c":"0102615796","n":"Công ty Cổ Phần Thương Mại Dịch Vụ Bắc Qua","t":"subsidiary","pct":55.57},{"c":"0103058548","n":"Công ty Cổ Phần Thương Mại Lãng Yên","t":"subsidiary","pct":51.0},{"c":"0102144804","n":"Công ty Cổ Phần Sản Xuất Kinh Doanh Gia Súc, Gia Cầm","t":"affiliate","pct":37.04},{"c":"0106130954","n":"Công ty Cổ Phần Ẩm Thực Hà Nội","t":"affiliate","pct":27.59}],"rel_count":4,"events":[{"c":"AGME","t":"HAF - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-17","record":"2026-05-04","ex":"2026-04-29"},{"c":"EGME","t":"HAF - Tổ chức ĐHĐCĐ bất thường 2026","d":"2025-11-28","record":"2025-12-12","ex":"2025-12-11"},{"c":"DDINS","t":"Công ty TNHH Tư Vấn Thiết Kế Quốc Tế Tầm Nhìn Mới - Đăng kí Mua HAF","d":"2025-11-24","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ Phần Đầu Tư Thông Minh Quốc Tế - Đăng kí Mua HAF","d":"2025-11