h hàng của Công ty hiện có hơn 50 nhà đầu tư, trong đó có những nhà đầu tư lớn đến từ Trung Quốc, Hồng Kông và Đài Loan. Ngày 10/11/2015, PTD chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2011-01-14","state":0.0,"foreign":0.01797971,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Hoàng Cát Tường","p":null,"t":"CORPORATE","q":15000000,"pct":75.0,"d":"2026-01-08"},{"n":"Ngô Liên Đồng Hoàng Lan","p":null,"t":"INDIVIDUAL","q":500000,"pct":10.0,"d":"2025-10-05"},{"n":"Phùng Nghĩa Minh Trí","p":null,"t":"INDIVIDUAL","q":1187500,"pct":5.94,"d":"2026-02-13"},{"n":"HỒ THANH ĐỨC","p":null,"t":"INDIVIDUAL","q":250000,"pct":5.0,"d":"2025-10-05"},{"n":"Hà Năng Nam","p":null,"t":"INDIVIDUAL","q":11190,"pct":0.35,"d":"2015-09-14"},{"n":"Hoàng Trường Giang","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.188,"d":"2026-01-22"},{"n":"Trần Thị Bích Ngọc","p":null,"t":"INDIVIDUAL","q":4640,"pct":0.145,"d":"2015-09-14"},{"n":"Trần Ngọc Tú","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.125,"d":"2026-01-22"},{"n":"Phan Thị Ninh","p":null,"t":"INDIVIDUAL","q":1600,"pct":0.05,"d":"2015-09-14"},{"n":"Nguyễn Thị Quyên","p":null,"t":"INDIVIDUAL","q":1480,"pct":0.046,"d":"2015-09-14"},{"n":"Dương Thị Ngọc Thùy","p":null,"t":"INDIVIDUAL","q":500,"pct":0.016,"d":"2026-01-22"},{"n":"Nguyễn Hoàng Vũ","p":"Kế toán trưởng","t":"INDIVIDUAL","q":75,"pct":0.0,"d":"2026-08-17"},{"n":"Yang Pei Long","p":null,"t":"INDIVIDUAL","q":50,"pct":0.0,"d":"2026-02-03"}],"rel":[{"c":"PHUCTHINHCAM","n":"Công ty Phuc Thinh Corporation","t":"subsidiary","pct":60.0},{"c":"BOILONG","n":"Công ty CP Bồi Long","t":"affiliate","pct":45.0}],"rel_count":2,"events":[{"c":"AIS","t":"PTD - Niêm yết bổ sung 15.000.000 cổ phiếu","d":"2026-05-06","record":null,"ex":null},{"c":"AGME","t":"PTD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-24","record":"2026-03-12","ex":"2026-03-11"},{"c":"DDIND","t":"Tô Khải Đạt - Đăng k