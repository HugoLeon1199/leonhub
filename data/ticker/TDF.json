inh doanh gạch ngói đất sét nung hàng đầu tại Nghệ An với công suất 188 triệu viên gạch xây, ngói lợp quy chuẩn mỗi năm. Năm 2020, TDF chính thức được giao dịch tại Thị trường Upcom.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2020-05-12","state":0.08634377,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thị Mỹ Cảnh","p":null,"t":"INDIVIDUAL","q":7149526,"pct":20.43,"d":"2026-08-10"},{"n":"Nguyễn Hồng Sơn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5905661,"pct":16.87,"d":"2026-08-10"},{"n":"Nguyễn Hoàng Phương Nga","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5066667,"pct":14.48,"d":"2026-08-10"},{"n":"Tổng Công ty Xây dựng Hà Nội - CTCP","p":null,"t":"CORPORATE","q":3022032,"pct":8.63,"d":"2026-08-10"},{"n":"Hoàng Công Phúc","p":null,"t":"INDIVIDUAL","q":1795916,"pct":5.13,"d":"2026-06-04"},{"n":"Nguyễn Hồng Hải","p":null,"t":"INDIVIDUAL","q":859726,"pct":2.46,"d":"2026-08-10"},{"n":"Nguyễn Thị Thu Huyền","p":null,"t":"INDIVIDUAL","q":400000,"pct":1.14,"d":"2026-08-10"},{"n":"Nguyễn Duy Hiền","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":367445,"pct":0.98,"d":"2026-08-10"},{"n":"Trần Văn Hoàn","p":"Phó Giám đốc","t":"INDIVIDUAL","q":245368,"pct":0.65,"d":"2026-08-10"},{"n":"Phan Đăng Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":205611,"pct":0.59,"d":"2026-08-10"},{"n":"Đoàn Quang Lê","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":197066,"pct":0.56,"d":"2026-08-10"},{"n":"Phan Thị Hoàng Yến","p":null,"t":"INDIVIDUAL","q":191148,"pct":0.55,"d":"2026-08-10"},{"n":"Nguyễn Thị Minh","p":null,"t":"INDIVIDUAL","q":145799,"pct":0.486,"d":"2026-07-15"},{"n":"Nguyễn Nam Khánh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":74229,"pct":0.2,"d":"2026-08-10"},{"n":"Dương Thị Mai Huệ","p":null,"t":"INDIVIDUAL","q":61407,"pct":0.164,"d":"2026-08-10"},{"n":"Trần Quốc Hùng","p":"T