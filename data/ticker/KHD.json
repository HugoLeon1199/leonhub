hai thác 845.000 m3/năm và tổng trữ lượng còn lại 2.474.498m3 tính đến 30/06/2016. KHD được giao dịch trên thị trường UPCOM từ cuối năm 2016.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2016-12-22","state":0.18790996,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ngô Quang Huy","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":797219,"pct":24.43,"d":"2026-03-05"},{"n":"Phạm Hồng Thịnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":672860,"pct":20.62,"d":"2026-03-05"},{"n":"Nguyễn Xuân Kiên","p":null,"t":"INDIVIDUAL","q":660000,"pct":20.23,"d":"2026-03-05"},{"n":"Phạm Đức Khoa","p":null,"t":"INDIVIDUAL","q":261890,"pct":8.03,"d":"2025-10-05"},{"n":"Đào Văn Tiến","p":null,"t":"INDIVIDUAL","q":248529,"pct":7.62,"d":"2025-10-05"},{"n":"Phạm Thị Thu Hằng","p":null,"t":"INDIVIDUAL","q":183300,"pct":5.62,"d":"2025-10-05"},{"n":"Hồ Văn Tuấn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":168300,"pct":5.16,"d":"2026-03-05"},{"n":"Trần Văn Sừ","p":null,"t":"INDIVIDUAL","q":64950,"pct":1.97,"d":"2025-10-05"},{"n":"Đoàn Văn Cường","p":"Phó Giám đốc","t":"INDIVIDUAL","q":24449,"pct":0.75,"d":"2026-03-05"},{"n":"Vũ Văn Trào","p":null,"t":"INDIVIDUAL","q":1595,"pct":0.05,"d":"2025-10-05"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":100,"pct":0.003,"d":"2025-10-05"}],"rel":[{"c":"12398","n":"Công ty Cổ Phần Đức Chung Thái Nguyên","t":"subsidiary","pct":99.99}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2026 - 2,000 VND","d":"2026-08-14","record":"2026-08-25","ex":"2026-08-24"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2025 - 2,500 VND","d":"2026-04-29","record":"2026-05-11","ex":"2026-05-08"},{"c":"AGME","t":"KHD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-11","record":"2026-03-27","ex":"2026-03-26"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2025 - 500 VND","d":"2025-12-19","record":"2025-12-29","ex":"2025-12-26"},{"c":"DDIND","t":"H