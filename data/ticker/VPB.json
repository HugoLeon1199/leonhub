ng chủ yếu trong lĩnh vực huy động vốn và cho vay tín dụng. Bên cạnh đó, VPBank còn tham gia các hoạt động thanh toán quốc tế, kinh doanh ngoại hối, đầu tư tài chính, quản lý rủi ro và bảo toàn vốn. Năm 2025, so với cùng kỳ, biên lãi thuần (NIM) ở mức 5.48%, giảm 0.44%. Tỷ lệ nợ xấu ở mức 3.33%, giảm 0.83%. Tỷ lệ bao phủ nợ xấu ở mức 55.39%, giảm 0.91%. Lợi nhuận sau thuế công ty mẹ có giá trị bằng 24,0 nghìn tỷ đồng, tăng 52.04%. Tỷ suất lợi nhuận trên vốn chủ sở hữu (ROE) ở mức 15.49%, tăng 4.08%. VPBank được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 08/2017.","sector":"Ngân hàng","type":"NH","listed":"2017-08-17","state":0.0,"foreign":0.22855062,"rating":"BUY","target":38000.0,"rating_as_of":"2026-05-18","source":"Vietcap"},"owners":[{"n":"Sumitomo Mitsui Banking Corporation","p":null,"t":"CORPORATE","q":1190500000,"pct":15.005,"d":"2026-02-25"},{"n":"Công ty Cổ phần Diera Corp","p":null,"t":"CORPORATE","q":348748866,"pct":4.396,"d":"2026-07-31"},{"n":"Ngô Chí Dũng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":328553899,"pct":4.141,"d":"2026-07-31"},{"n":"Hoàng Anh Minh","p":null,"t":"INDIVIDUAL","q":326753193,"pct":4.118,"d":"2026-07-31"},{"n":"Vũ Thị Quyên","p":null,"t":"INDIVIDUAL","q":325888953,"pct":4.108,"d":"2026-07-31"},{"n":"Trần Ngọc Lan","p":null,"t":"INDIVIDUAL","q":309825922,"pct":3.905,"d":"2025-10-05"},{"n":"Trần Ngọc Trung","p":null,"t":"INDIVIDUAL","q":305089402,"pct":3.845,"d":"2025-10-05"},{"n":"Kim Ngọc Cẩm Ly","p":null,"t":"INDIVIDUAL","q":286603963,"pct":3.612,"d":"2026-07-31"},{"n":"Lý Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":282127582,"pct":3.556,"d":"2026-07-31"},{"n":"Lê Việt Anh","p":null,"t":"INDIVIDUAL","q":280269627,"pct":3.533,"d":"2025-10-05"},{"n":"Lê Minh Anh","p":null,"t":"INDIVIDUAL","q":214701370,"pct":2.706,"d":"2025-10-05"},{"n":"Nguyễn Thu Thủy","p":null,"t":"INDIVIDUAL","q":203349411,"pct":2.563,"d":"2026-07-31"},{"n":"Bùi Hải Quân","p":"Phó Chủ tịch Hội đồng Quản t