các nhãn hiệu nổi tiếng như Shrimp One, Saigon Pacific, Leader Fish, Uncle Hundred . Sản phẩm của Công ty chủ yếu phục vụ cho nhu cầu xuất khẩu sang các thị trường Mỹ, Nhật, Châu Âu còn lại là phục vụ cho nhu cầu trong nước. ICF quản lý vận hành Nhà máy chế biến các mặt hàng thủy sản đông lạnh với công suất thiết kế 6.500 tấn/năm. Bên cạnh đó, Công ty còn tham gia chế biến và xuất khẩu nông sản như khoai lang Nhật, đậu nành. Công ty được phép xuất khẩu sản phẩm thủy sản vào thị trường EU mà không phải qua kiểm tra. Ngày 20/05/2019, ICF chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2007-12-18","state":0.0,"foreign":0.02596705,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thị Kim Xuân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2348522,"pct":18.34,"d":"2026-03-06"},{"n":"Huỳnh Thị Minh Tú","p":null,"t":"INDIVIDUAL","q":2042200,"pct":15.95,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Thủy","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":971000,"pct":7.58,"d":"2026-03-06"},{"n":"Nguyễn Thị Kim Thu","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Giám đốc khối/Giám đốc Tài chính","t":"INDIVIDUAL","q":970000,"pct":7.57,"d":"2026-03-06"},{"n":"Trần Hữu Duyên","p":null,"t":"INDIVIDUAL","q":600570,"pct":4.69,"d":"2025-10-05"},{"n":"Nguyễn Phát Quang","p":null,"t":"INDIVIDUAL","q":540000,"pct":4.216,"d":"2026-03-06"},{"n":"Công ty TNHH MTV Chứng Khoán Ngân hàng Số Vikki","p":null,"t":"CORPORATE","q":459350,"pct":3.587,"d":"2015-06-15"},{"n":"Trịnh Bá Hoàng","p":null,"t":"INDIVIDUAL","q":296300,"pct":2.31,"d":"2025-10-05"},{"n":"Erik J.F.Smeys","p":null,"t":"INDIVIDUAL","q":123800,"pct":0.967,"d":"2015-09-14"},{"n":"Nguyễn Thị Ngọc Thảo","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.156,"d":"2025-10-05"},{"n":"Nguyễn Thị ThuThủy","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.039,"d":"2015-09-14"},{"n":"Đặng Việt Hùng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc