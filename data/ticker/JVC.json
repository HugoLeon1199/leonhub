ập từ các nước Nhật Bản, Hàn Quốc, Singapore. Ngày 21/06/2011, JVC chính thức giao dịch trên Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE)","sector":"Y tế","type":"CT","listed":"2011-06-21","state":0.0,"foreign":0.00742351,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty Cổ Phần Quản Lý Và Đầu Tư Dtn Việt Nam","p":null,"t":"CORPORATE","q":17000000,"pct":15.11,"d":"2026-07-07"},{"n":"Vietnam Equity Holding","p":null,"t":"CORPORATE","q":5555001,"pct":4.94,"d":"2025-10-05"},{"n":"Nguyễn Văn Hiếu","p":null,"t":"INDIVIDUAL","q":5500000,"pct":4.89,"d":"2025-10-05"},{"n":"Lê Văn Hướng","p":null,"t":"INDIVIDUAL","q":4806597,"pct":4.27,"d":"2025-10-05"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":4631000,"pct":4.12,"d":"2025-10-05"},{"n":"Balestrand Limited","p":null,"t":"CORPORATE","q":3646988,"pct":3.242,"d":"2015-06-15"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":1873652,"pct":1.67,"d":"2025-10-05"},{"n":"Hồ Bích Ngọc","p":null,"t":"INDIVIDUAL","q":181673,"pct":0.161,"d":"2015-09-14"},{"n":"Phạm Văn Thanh","p":null,"t":"INDIVIDUAL","q":132829,"pct":0.118,"d":"2015-09-14"},{"n":"Nguyễn Phương Hạnh","p":null,"t":"INDIVIDUAL","q":89657,"pct":0.08,"d":"2025-10-05"},{"n":"Đặng Trần Đạt","p":null,"t":"INDIVIDUAL","q":47450,"pct":0.042,"d":"2025-10-05"},{"n":"Đỗ Thị Ngọc Hoa","p":null,"t":"INDIVIDUAL","q":39000,"pct":0.034,"d":"2026-02-23"},{"n":"Nguyễn Thị Thuý Quỳnh","p":null,"t":"INDIVIDUAL","q":7100,"pct":0.006,"d":"2026-09-03"},{"n":"Nguyễn Thị Lụa","p":"Kế toán trưởng","t":"INDIVIDUAL","q":25400,"pct":0.002,"d":"2026-09-03"},{"n":"Nguyễn Văn Dương","p":null,"t":"INDIVIDUAL","q":889,"pct":0.001,"d":"2015-09-14"},{"n":"Vũ Khánh Din","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1500,"pct":0.001,"d":"2026-09-03"},{"n":"Nguyễn Hữu Thắng","p":null,"t":"INDIVIDUAL","q":416,"pct":0.0,"d":"2015-09-14"},{"n":"Nguyễn Hữu Điền","p":null,"t":"INDIVIDUAL","q":500,"pct":0.0,"d":"2015-09-14"},{"n":"N