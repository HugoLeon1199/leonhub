iền Trung và 13% thuộc khu vực miền Nam. Các dự án Điện Mặt trời hoạt động của GEC đa phần đều là những dự án đầu tiên đóng điện tại địa bàn có tỷ lệ bức xạ mặt trời tương đối tốt từ 4,6-5,3 kWh/m2 /ngày với số giờ nắng từ 1.700-2.544 giờ/năm. Ngày 19/09/2019, GEG chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-03-21","state":0.0,"foreign":0.44896761,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Jera Asia Vietnam Holdings Pte. Ltd.","p":null,"t":"CORPORATE","q":125756637,"pct":35.1,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư Thành Thành Công","p":null,"t":"CORPORATE","q":60161979,"pct":16.79,"d":"2025-10-05"},{"n":"DEG – Deutsche Investitions - Und Entwicklungsgesellschaft MBH","p":null,"t":"CORPORATE","q":56496000,"pct":13.372,"d":"2026-01-29"},{"n":"Công ty Cổ phần Thành Thành Công - Biên Hòa","p":null,"t":"CORPORATE","q":46444548,"pct":12.96,"d":"2026-04-02"},{"n":"Công ty Cổ Phần Xuất Nhập Khẩu Bến Tre","p":null,"t":"CORPORATE","q":22668931,"pct":6.33,"d":"2025-10-05"},{"n":"Công ty Cổ phần Khu Công Nghiệp Thành Thành Công","p":null,"t":"CORPORATE","q":13740838,"pct":3.83,"d":"2025-10-05"},{"n":"Công ty Cổ phần Hàng tiêu dùng Biên Hòa","p":null,"t":"CORPORATE","q":11844941,"pct":3.31,"d":"2026-04-02"},{"n":"CÔNG TY TNHH MTV THÀNH THÀNH CÔNG GIA LAI","p":null,"t":"CORPORATE","q":9343900,"pct":2.9,"d":"2022-09-23"},{"n":"Công ty Cổ phần Nông nghiệp AgriS Gia Lai","p":null,"t":"CORPORATE","q":9343900,"pct":2.9,"d":"2025-10-05"},{"n":"Huỳnh Bích Ngọc","p":null,"t":"INDIVIDUAL","q":1298401,"pct":0.307,"d":"2025-10-05"},{"n":"Đặng Huỳnh Ức My","p":null,"t":"INDIVIDUAL","q":977596,"pct":0.231,"d":"2025-10-05"},{"n":"Tân Xuân Hiến","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":710445,"pct":0.19,"d":"2026-07-30"},{"n":"Nguyễn Thái Hà","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":558940,"pct":0.15,"d":"2026-07-30"},{"n":"Đặng Hu