20",0.0],["2021",0.0],["2022",0.0],["2023",0.0],["2024",0.0],["2025",0.0]]}},"co":{"short":"Cotec Land","profile":"Công ty Cổ phần Đầu tư và Phát triển Nhà đất Cotec (CotecLand) là một trong những đơn vị trực thuộc Công ty Kỹ thuật Xây dựng và Vật liệu Xây dựng (COTEC) được thành lập năm 2004. Công ty hoạt động kinh doanh chính trong lĩnh vực đầu tư và kinh doanh bất động sản, dịch vụ quản lý sau dự án và xây lắp. Hoạt động xây lắp là một trong những hoạt động nền tảng, tuy nhiên mục tiêu phát triển của công ty là chuyên về lĩnh vực kinh doanh bất động sản. Từ năm 2009 công ty đã đẩy mạnh hoạt động kinh doanh bất động sản và gia tăng các dịch vụ phục vụ bất động sản. Công ty là chủ đầu tư các dự án như dự án khu dân cư Phú Xuân 1, Blue Sapphire Bình Phú.","sector":"Bất động sản","type":"CT","listed":"2010-08-09","state":0.0,"foreign":0.00533002,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"CÔNG TY CỔ PHẦN KỸ THUẬT XÂY DỰNG VÀ VẬT LIỆU XÂY DỰNG","p":null,"t":"CORPORATE","q":11590000,"pct":54.799,"d":"2025-10-05"},{"n":"Tama Global Investments Private Limited","p":null,"t":"CORPORATE","q":1661140,"pct":7.854,"d":"2015-06-15"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":1275390,"pct":6.03,"d":"2025-10-05"},{"n":"Hoàng Ngọc Ánh","p":null,"t":"INDIVIDUAL","q":829240,"pct":3.92,"d":"2025-10-05"},{"n":"Lưu Thị Thảo","p":null,"t":"INDIVIDUAL","q":431130,"pct":2.038,"d":"2015-09-14"},{"n":"Đào Đức Nghĩa","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":199000,"pct":0.941,"d":"2025-10-05"},{"n":"Công ty Cổ phần Kỹ Thuật Xây dựng An Pha (COTECANPHA)","p":null,"t":"CORPORATE","q":102070,"pct":0.483,"d":"2025-10-05"},{"n":"Nguyễn Thế Thanh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":33690,"pct":0.159,"d":"2025-10-05"},{"n":"Phan Văn Ngoan","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.019,"d":"2025-10-05"},{"n":"Phan Văn Tín","p":null,"t":"INDIVIDUAL","q":2800,"pct":0.015,"d":"2