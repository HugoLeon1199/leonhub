các lĩnh vực tổng thầu EPC, xây lắp, cơ khí chế tạo. Hơn 55 năm kinh nghiệm, Tổng Công ty với vai trò là tổng thầu EPC, xây lắp, đã và đang tham gia thực hiện nhiều dự án trọng điểm như các nhà máy thủy điện Hòa Bình, Sơn La, Trị An, các nhà máy nhiệt điện Uông Bí, Cà Mau, Vũng Áng, nhà máy lọc dầu Dung Quất…Tổng Công ty cũng sở hữu nhiều nhà máy cơ khí trên khắp cả nước với tổng năng lực sản xuất đạt 200.000 tấn/năm. Hiện nay, Tổng Công ty được biết đến là một đơn vị trong những tổng thầu EPC, nhà thầu xây lắp đứng đầu trong các công trình công nghiệp và dân dụng ở Việt Nam. LLM được giao dịch trên thị trường UPCOM từ tháng 08/2017.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2017-08-16","state":0.97875602,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bộ Xây Dựng","p":null,"t":"CORPORATE","q":78032404,"pct":97.88,"d":"2026-08-24"},{"n":"Nguyễn Thị Thu Phương","p":null,"t":"INDIVIDUAL","q":300000,"pct":0.376,"d":"2026-08-24"},{"n":"Lê Văn Tuấn","p":null,"t":"INDIVIDUAL","q":50800,"pct":0.07,"d":"2025-10-05"},{"n":"Nguyễn Văn Hùng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":31300,"pct":0.04,"d":"2026-08-24"},{"n":"Trần Đình Đại","p":null,"t":"INDIVIDUAL","q":22400,"pct":0.028,"d":"2025-10-05"},{"n":"Bùi Đức Kiên","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":20000,"pct":0.025,"d":"2026-08-24"},{"n":"Doãn Thị Lan","p":null,"t":"INDIVIDUAL","q":14000,"pct":0.02,"d":"2026-08-24"},{"n":"Nguyễn Mạnh Dũng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":12200,"pct":0.015,"d":"2026-08-24"},{"n":"Nguyễn Hữu Thành","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.013,"d":"2025-10-05"},{"n":"Tô Phi Sơn","p":"Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":10000,"pct":0.013,"d":"2026-08-24"},{"n":"Vũ Văn Định","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.013,"d":"2025-10-05"},{"n":"Nguyễn Văn Trường","p":null,"t":"INDIVIDUAL","q":4800,"pct