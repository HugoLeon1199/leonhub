hoảng 75% thị phần khoan tại Việt Nam. PVD chính thức niêm yết và giao dịch trên Sàn Chứng khoán Thành phố Hồ Chí Minh từ năm 2006.","sector":"Dầu khí","type":"CT","listed":"2006-12-05","state":0.50438469,"foreign":0.08643966,"rating":"O-PF","target":22000.0,"rating_as_of":"2026-08-21","source":"Vietcap"},"owners":[{"n":"Tập Đoàn Công Nghiệp – Năng Lượng Quốc Gia Việt Nam","p":null,"t":"CORPORATE","q":280496572,"pct":50.42,"d":"2026-08-12"},{"n":"CTBC Vietnam Equity Fund","p":null,"t":"CORPORATE","q":27500000,"pct":4.947,"d":"2025-10-05"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":12714349,"pct":3.65,"d":"2025-10-05"},{"n":"Ngân hàng Deutsche Aktiengesellschaft","p":null,"t":"CORPORATE","q":10044340,"pct":2.886,"d":"2015-06-15"},{"n":"VanEck Vietnam ETF","p":null,"t":"CORPORATE","q":6726537,"pct":1.933,"d":"2015-06-15"},{"n":"TGIT-Templeton Frontier Markets Fund","p":null,"t":"CORPORATE","q":5930050,"pct":1.704,"d":"2015-06-15"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":7369445,"pct":1.326,"d":"2026-04-16"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":6870000,"pct":1.236,"d":"2026-04-16"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":5611800,"pct":1.01,"d":"2026-04-16"},{"n":"FTIF - Templeton Frontier Markets Fund","p":null,"t":"CORPORATE","q":3324520,"pct":0.955,"d":"2015-06-15"},{"n":"Deutsche Asset Management (Asia) Limited","p":null,"t":"CORPORATE","q":3320287,"pct":0.954,"d":"2015-06-15"},{"n":"Hanoi Investments Holdings Limited","p":null,"t":"CORPORATE","q":3928900,"pct":0.707,"d":"2026-04-16"},{"n":"DC Developing Markets Strategies Public Limited Company","p":null,"t":"CORPORATE","q":1776000,"pct":0.32,"d":"2026-04-16"},{"n":"Grinling International Limited","p":null,"t":"CORPORATE","q":1500000,"pct":0.27,"d":"2025-10-05"},{"n":"Wareham Group Limited","p":null,"t":"CORPORATE","q":1375000,"pct":0.247,"d":"2026-04-16"},{"n":"Ngân hàng Thương mại Cổ phần Đại chúng Việt N