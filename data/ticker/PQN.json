3",9.274],["2025-Q4",10.997],["2026-Q1",11.32],["2026-Q2",12.437]],"y":[["2019",24.525],["2020",27.306],["2021",24.003],["2022",18.812],["2023",15.761],["2024",15.175],["2025",10.997]]}},"co":{"short":"DV Dầu khí Quảng Ngãi PTSC","profile":"Công ty Cổ phần Dịch vụ Dầu khí Quảng Ngãi PTSC (PQN), tiền thân là Chi nhánh Công ty Dịch vụ Dầu khí tại Quảng Ngãi, được thành lập năm 1997. Năm 2011, Công ty chuyển đổi mô hình kinh doanh hoạt động dưới dạng là Công ty Cổ phần. Lĩnh vực kinh doanh chính của Công ty là: Dịch vụ Cơ khí Dầu khí & Xây lắp; Dịch vụ Sửa chữa & Bảo dưỡng; Dịch vụ Cảng & Logistics; Dịch vụ Hàng hải... PTSC Quảng Ngãi đã thực hiện thành công một số dự án lớn như: Dự án đầu tư bổ sung 2 bể chứa và đường bơm hút dầu thô dung tích 130.000 m3 cho Nhà máy lọc dầu Dung Quất; Tổng thầu thiết kế, mua sắm và xây dựng Nhà máy nhiên liệu sinh học miền Trung công suất 100 triệu lít/năm; Tổng thầu kho chứa xăng dầu Dung Quất của PVOil. Hiện tại PTSC Quảng Ngãi đã và đang đầu tư phát triển mở rộng Xưởng cơ khí Dung Quất với diện tích 80.000 m 2 (Căn cứ gia công, chế tạo, lắp đặt,…) và quản lý an toàn, hiệu quả Bến số 1, số 2 – Cảng Dung Quất (Một trong 5 Cảng biển có khả năng tiếp nhận tàu lớn nhất Việt Nam). Ngày 04/10/2019, PQN chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2019-10-04","state":0.95193667,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Dịch vụ Kỹ thuật Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":28558100,"pct":95.2,"d":"2026-07-28"},{"n":"Ngân hàng TNHH MTV Việt Nam Hiện đại","p":null,"t":"CORPORATE","q":1000000,"pct":3.3,"d":"2026-07-28"},{"n":"Dương Hùng Văn","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.167,"d":"2025-10-05"},{"n":"Phạm Văn Hùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":20000,"pct":0.067,"d":"2025-10-05"},{"n":"Nguyễn Trần Toàn","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.017,"d":"2025-10-0