4",5.807],["2025",6.97]]}},"co":{"short":"Tập đoàn Masan","profile":"Công ty Cổ phần Tập đoàn Masan (MSN) có tiền thân là Công ty Cổ phần Hàng hải Ma San được thành lập vào năm 2004. MSN là công ty quản lý vốn đầu tư và tài sản, chủ yếu là các cổ phần của những công ty khác, hiện nay bao gồm cổ phần của Công ty Cổ phần Thực phẩm Ma San (Masan Food) và Ngân hàng Thương mại cổ phần Kỹ thương Việt Nam (Techcombank). MSN là nhà cung cấp vonfram và bismut lớn nhất bên ngoài Trung Quốc và nhà cung cấp đơn nhất về florit cấp axit lớn thứ 2 bên ngoài Trung Quốc. MSN là công ty sản xuất đạm động vật lớn nhất Việt Nam sở hữu thương hiệu Bio-zeem, dẫn đầu trong lĩnh vực thức ăn chăn nuôi. Công ty nắm giữ vị thế thống lĩnh trong hầu hết các thị trường, các ngành hàng tiêu dùng mà Công ty tham gia cạnh tranh. MSN được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh từ cuối năm 2009.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2009-11-05","state":0.0,"foreign":0.24117751,"rating":"BUY","target":101200.0,"rating_as_of":"2025-05-21","source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Masan","p":null,"t":"CORPORATE","q":446278464,"pct":29.35,"d":"2026-07-31"},{"n":"Công ty TNHH Một Thành Viên Xây Dựng Hoa Hướng Dương","p":null,"t":"CORPORATE","q":189081487,"pct":12.44,"d":"2026-07-31"},{"n":"Sk Investment Vina I Pte. Ltd.","p":null,"t":"CORPORATE","q":55497918,"pct":3.67,"d":"2025-10-05"},{"n":"Nguyễn Hoàng Yến","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":50898280,"pct":3.36,"d":"2026-07-31"},{"n":"Ardolis Investment Pte Ltd","p":null,"t":"CORPORATE","q":39558206,"pct":2.76,"d":"2025-10-05"},{"n":"Government Of Singapore","p":null,"t":"CORPORATE","q":31642924,"pct":2.21,"d":"2025-10-05"},{"n":"Madhur Maini","p":null,"t":"INDIVIDUAL","q":6597800,"pct":0.884,"d":"2015-09-14"},{"n":"Nguyễn Yến Linh","p":null,"t":"INDIVIDUAL","q":8496800,"pct":0.56,"d":"2026-07-31"},{"n":"Le Danny","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":8327455,"pct":0.543,"d":"2026