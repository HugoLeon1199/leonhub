9],["2026-Q2",26.553]],"y":[["2018",24.929],["2019",23.376],["2020",22.798],["2021",23.273],["2022",19.109],["2023",19.162],["2024",33.958],["2025",25.231]]}},"co":{"short":"Hàng Tiêu Dùng MaSan","profile":"Công ty Cổ phần Hàng Tiêu Dùng Masan (MCH) có tiền thân là Công ty Cổ phần Công nghiệp - Thương mại Masan, được thành lập vào năm 2000. Công ty sản xuất và kinh doanh các loại thực phẩm và đồ uống bao gồm nước mắm, nước tương, tương ớt, mì ăn liền, cháo ăn liền, cà phê hòa tan, ngũ cốc dinh dưỡng và đồ uống đóng chai với các thương hiệu mạnh như Omachi, Chinsu, Kokomi, Vinacafe, Wake-up, Tam Thái Tử, Nam Ngư và Wake-up 247. Công ty đã xây dựng một trong những hệ thống sản xuất và phân phối thực phẩm, đồ uống lớn nhất tại Việt Nam, với 14 nhà máy, 16 trung tâm phân phối và mạng lưới khoảng 500.000 điểm bán trên toàn quốc, bao phủ cả kênh truyền thống, hiện đại và thương mại điện tử. Ngày 25/12/2025, MCH chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-01-05","state":0.0,"foreign":0.15634133,"rating":"M-PF","target":181700.0,"rating_as_of":"2025-11-28","source":"Vietcap"},"owners":[{"n":"Công Ty Cổ Phần Masan Consumer Holdings","p":null,"t":"CORPORATE","q":740598412,"pct":69.37,"d":"2026-07-30"},{"n":"Trương Công Thắng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":6819234,"pct":0.522,"d":"2026-08-27"},{"n":"Nguyễn Hoàng Yến","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2076834,"pct":0.159,"d":"2026-07-31"},{"n":"Phạm Hồng Sơn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1091586,"pct":0.083,"d":"2026-07-31"},{"n":"Nguyễn Anh Nguyên","p":null,"t":"INDIVIDUAL","q":454834,"pct":0.063,"d":"2025-10-05"},{"n":"Lê Trung Thành","p":null,"t":"INDIVIDUAL","q":303962,"pct":0.06,"d":"2025-10-05"},{"n":"Huỳnh Việt Thăng","p":"Phó Tổng Giám đốc/Giám đốc Tài chính","t":"INDIVIDUAL","q":429072,"pct":0.033,"d":"2026-07-31"},{"n":"Nguyễn T