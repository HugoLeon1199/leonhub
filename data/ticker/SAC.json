ụ bốc xếp, giao nhận, vận chuyển hàng hóa tại cảng biển, là đơn vị đứng đầu trong việc cung cấp dịch vụ xếp dỡ hàng hóa tại các cảng biển khu vực Thành phố Hồ Chí Minh. Ngày 08/11/2016, SAC chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-11-08","state":0.05,"foreign":0.00028395,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Cảng Sài Gòn","p":null,"t":"CORPORATE","q":2082800,"pct":51.43,"d":"2025-11-24"},{"n":"Công ty Cổ phần Vật tư Nông sản","p":null,"t":"CORPORATE","q":202500,"pct":5.0,"d":"2025-10-05"},{"n":"Đỗ Thanh Bình","p":null,"t":"INDIVIDUAL","q":100000,"pct":2.53,"d":"2025-10-05"},{"n":"Phan Minh Trí","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":41500,"pct":1.02,"d":"2026-03-05"},{"n":"Đỗ Kim Lộc","p":null,"t":"INDIVIDUAL","q":10100,"pct":0.25,"d":"2025-10-05"},{"n":"Nguyễn Anh Thành","p":null,"t":"INDIVIDUAL","q":5100,"pct":0.13,"d":"2025-10-05"},{"n":"Trương Thu Hà","p":null,"t":"INDIVIDUAL","q":5300,"pct":0.13,"d":"2025-10-05"},{"n":"Nguyễn Quốc Hưng","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.07,"d":"2025-10-05"},{"n":"Nguyễn Thị Thúy Vinh","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.05,"d":"2025-10-05"},{"n":"Nguyễn Văn Lập","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.05,"d":"2025-10-05"},{"n":"Trần Thu Giang","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.025,"d":"2025-10-05"},{"n":"Lê Văn Hóa","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":500,"pct":0.012,"d":"2026-03-05"}],"rel":[{"c":"0313284649","n":"Công ty Cổ Phần Dịch Vụ Hàng Hải Tân Hưng Phúc","t":"affiliate","pct":30.0}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,000 VND","d":"2026-07-30","record":"2026-08-14","ex":"2026-08-13"},{"c":"AGME","t":"SAC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-10","record":"2026-04-22","ex":"2026-04-21"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 880 VND","d":"2025-06-06","record