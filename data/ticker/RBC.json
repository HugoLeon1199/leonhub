:{"q":[["2018-Q4",-1.203],["2019-Q4",-1.412],["2020-Q4",0.891],["2021-Q4",0.506],["2022-Q4",1.587],["2023-Q4",0.131],["2024-Q4",-0.716],["2025-Q4",-0.997],["2026-Q2",-0.997]],"y":[["2018",-1.203],["2019",-1.412],["2020",0.891],["2021",0.506],["2022",1.587],["2023",0.131],["2024",-0.716],["2025",-0.997]]}},"co":{"short":"Công Nghiệp và Xuất nhập khẩu Cao Su","profile":"Công ty Cổ phần Công Nghiệp và Xuất nhập khẩu Cao Su (RBC) có tiền thân là Công ty Công nghiệp và Xuất khẩu Cao su trực thuộc Tổng Công ty Cao su Việt Nam (Nay là Tập đoàn Công nghiệp Cao su Việt Nam) được thành lập vào năm 1984. Công ty chính thức hoạt động theo mô hình công ty cổ phần từ năm 2005. Công ty hoạt động trong lĩnh vực trồng, khai thác, chế biến sản phẩm từ cây cao su và các cây gỗ khác với các sản phẩm đồ gỗ nội ngoại thất, cao su kỹ thuật, cao su tự nhiên. RBC là đơn vị thành viên trực thuộc Tập đoàn Công nghiệp Cao Su Việt nam có chức năng sản xuất kinh doanh da ngành, nên RBC nhận được nhiều sự giúp đỡ từ Tập đoàn về vốn, nhân lực, khách hàng lâu năm, kênh phân phối. Năng suất gỗ tinh chế hàng năm đạt khoảng gần 10.000m3/năm. Rubico đã thiết lập một mạng lưới phân phối tại Thành phố Hồ Chí Minh và các tỉnh lân cận cũng như tích hợp vào thị trường EU. RBC chính thức giao dịch trên thị trường UPCOM từ tháng 02/2016.","sector":"Hóa chất","type":"CT","listed":"2016-02-18","state":0.69123829,"foreign":9.97e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Công nghiệp Cao su Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":6933333,"pct":69.12,"d":"2026-05-08"},{"n":"Công ty TNHH Một Thành Viên Tổng Công ty Cao Su Đồng Nai","p":null,"t":"CORPORATE","q":1336000,"pct":13.32,"d":"2026-03-05"},{"n":"Ngân hàng Thương mại Cổ phần Phương Đông","p":null,"t":"CORPORATE","q":333330,"pct":3.32,"d":"2026-03-05"},{"n":"Lê Thị Ngọc Lý","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.2,"d":"2026-08-24"},{"n":"Nguyễn Hồng Minh","p":"Chủ tịch Hội đồng Quản tr