ao của hãng SACMI, hoạt động theo công nghệ của Italia, sản lượng hàng năm đạt 7,5 triệu m2 sản phẩm. Sản phẩm của công ty áp dụng quy trình quản lý chất lượng ISO 9001:2000. Sản phẩm của Công ty được tiêu thụ phủ rộng khắp cả 3 miền: Bắc, Trung, Nam. Tuy nhiên, thị trường của công ty tập trung chính ở khu vực Miền Nam. Ngoài ra, thị trường xuất khẩu hiện tại của Công ty phải kể đến như Thái Lan, Srilanka, Mauritius, Pakistan, Yemen và Campuchia.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-29","state":0.3075,"foreign":0.00174875,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Mua bán nợ Việt Nam","p":null,"t":"CORPORATE","q":2000000,"pct":25.0,"d":"2026-08-05"},{"n":"Công ty Cổ phần Gạch men Thanh Thanh","p":null,"t":"CORPORATE","q":1715900,"pct":21.45,"d":"2026-08-05"},{"n":"Tổng Công ty Vật liệu Xây dựng số 1 - Công ty Cổ phần","p":null,"t":"CORPORATE","q":820000,"pct":10.25,"d":"2026-08-05"},{"n":"Nguyễn Quang Tài","p":null,"t":"INDIVIDUAL","q":305335,"pct":5.089,"d":"2015-09-14"},{"n":"Trần Thị Thanh Thuý","p":null,"t":"INDIVIDUAL","q":243000,"pct":4.05,"d":"2015-09-14"},{"n":"Nguyễn Thị Năm","p":null,"t":"INDIVIDUAL","q":50400,"pct":0.84,"d":"2015-09-14"},{"n":"Nguyễn Thị Hảo","p":null,"t":"INDIVIDUAL","q":22700,"pct":0.378,"d":"2015-09-14"},{"n":"Lê Trung Sâm","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.25,"d":"2015-09-14"},{"n":"Nguyễn Ngọc Dũng","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.2,"d":"2015-09-14"},{"n":"Võ Văn Tùng","p":null,"t":"INDIVIDUAL","q":5200,"pct":0.065,"d":"2025-10-05"},{"n":"Hà Thị Thanh Thuý","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.05,"d":"2015-09-14"},{"n":"Đào Thị Thoán","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.05,"d":"2015-09-14"},{"n":"Nguyễn Thanh Bình","p":null,"t":"INDIVIDUAL","q":400,"pct":0.005,"d":"2025-10-05"}],"rel":[{"c":"PJS1","n":"Công ty Cổ Phần Bao Bì Và Khoáng Sản Số 1","t":"affiliate","pct":36.0}],"rel_count":1,"events":[{"c":"AGME","t":"VTA - T