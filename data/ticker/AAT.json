ty Tiên Sơn Thanh Hoá - TNHH được thành lập năm 1995 với số vốn điều lệ là 550 triệu đồng. Năm 2004, công ty chuyển đổi mô hình kinh doanh thành công ty cổ phần. Lĩnh vực kinh doanh chính của Công ty là May xuất khẩu; kinh doanh khách sạn; kinh doanh nông sản; cho thuê kho, xưởng sản xuất...Công ty hiện đang sở hữu 6 nhà máy đang hoạt động với tổng giá trị đầu tư gần 1,000 tỷ đồng đặt trên địa bàn tỉnh Thanh Hóa. Tổng cộng các nhà máy của Công ty có 161 chuyền may, công suất trung bình khoảng 2.300.000 sản phẩm/tháng. Công ty có một lượng khách hàng lớn, thường xuyên ở cả trong và ngoài nước, chủ yếu đến từ Hàn Quốc, Đài Loan, Mỹ, Nhật Bản, ngoài ra công ty đang hướng mở rộng khách hàng đến các nước EU. AAT được giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 03/2021.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2021-03-24","state":0.0,"foreign":0.00223218,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trịnh Xuân Lâm","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":8330130,"pct":11.76,"d":"2026-07-20"},{"n":"Nguyễn Thị Hoa","p":null,"t":"INDIVIDUAL","q":3234396,"pct":4.57,"d":"2025-10-05"},{"n":"Trịnh Xuân Lượng","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1256533,"pct":1.77,"d":"2026-07-20"},{"n":"Lê Đăng Thuyết","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":617760,"pct":0.87,"d":"2026-02-27"},{"n":"Trịnh Văn Dương","p":null,"t":"INDIVIDUAL","q":568148,"pct":0.8,"d":"2026-07-20"},{"n":"Trịnh Xuân Dưỡng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":495060,"pct":0.7,"d":"2026-07-20"},{"n":"Tống Anh Linh","p":"Giám đốc Tài chính/Phó Giám đốc Tài chính","t":"INDIVIDUAL","q":432860,"pct":0.611,"d":"2026-02-27"},{"n":"Nguyễn Thị Dụ","p":null,"t":"INDIVIDUAL","q":123765,"pct":0.174,"d":"2026-07-20"},{"n":"Trịnh Kim Giang","p":null,"t":"INDIVIDUAL","q":61093,"pct":0.086,"d":"2026-02-27"},{"n":"Lê Quyền","p":null,"t":"INDIVIDUAL","q":12376,"pct":0.018,"d":"2026-02-2