 là Nhà Máy Sợi Nha Trang, được thành lập vào năm 1979. Công ty hoạt động trong lĩnh vực sản xuất kinh doanh sợi, dệt kim, nhuộm và may mặc. NTT chính thức hoạt động theo mô hình công ty cổ phần từ năm 2006. Công ty hiện đang quản lý vận hành 01 nhà máy dệt nhuộm với tổng công suất dệt kim 4.025 tấn/năm và tổng công suất nhuộm hoàn tất 4.025 tấn/năm, 02 Nhà may sợi với công suất hơn 12.000 tấn sợi/năm và 02 nhà máy may với 30 chuyền may và tổng sản lượng sản xuất từ 7,3 đến 9,3 triệu sản phẩm/năm. NTT được giao dịch trên thị trường UPCOM từ cuối năm 2017.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2017-12-27","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty Cổ Phần Vinatex Quốc Tế","p":null,"t":"CORPORATE","q":11502479,"pct":40.36,"d":"2026-07-28"},{"n":"Tổng Công ty Cổ phần Phong Phú","p":null,"t":"CORPORATE","q":6808945,"pct":23.89,"d":"2026-07-28"},{"n":"Công ty Cổ Phần Quốc Tế Phong Phú","p":null,"t":"CORPORATE","q":6325583,"pct":22.2,"d":"2026-07-28"},{"n":"Công ty TNHH Sinnika Việt Nam","p":null,"t":"CORPORATE","q":1052981,"pct":4.481,"d":"2026-02-27"},{"n":"Công ty Cổ Phần Sinnika Việt Nam","p":null,"t":"CORPORATE","q":1052981,"pct":4.48,"d":"2026-06-24"},{"n":"Nguyễn Thị Hồng Phương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":105000,"pct":0.45,"d":"2026-08-11"},{"n":"Trần Ngọc Nga","p":null,"t":"INDIVIDUAL","q":70000,"pct":0.38,"d":"2025-10-05"},{"n":"Nguyễn Hải Sơn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":63081,"pct":0.27,"d":"2026-08-11"},{"n":"Ngô Thị Mỹ Dung","p":null,"t":"INDIVIDUAL","q":60000,"pct":0.26,"d":"2025-10-05"},{"n":"Phạm Ngọc Tuấn","p":"Giám đốc điều hành","t":"INDIVIDUAL","q":35700,"pct":0.19,"d":"2025-10-05"},{"n":"Võ Đình Hùng","p":null,"t":"INDIVIDUAL","q":33121,"pct":0.18,"d":"2025-10-05"},{"n":"Phan Thị Cảnh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":26900,"pct":0.114,"d":"2026-08-11"},{"n":"Hồ Đặng N