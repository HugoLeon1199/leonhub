n số 1 tại Lào. Sở hữu hệ thống trạm trộn bê tông các loại (trạm trộn bê tông lạnh công suất từ 60-:-125 m 3 /h), cần trục tháp 12 tấn; cần trục tháp MD 900B 50 tấn; cần trục xích 20-:-70 tấn, thiết bị thi công cơ giới máy khoan đá Furakawa, máy đào xúc, ô tô tự đổ, xe vận chuyển bê tông...Ngày 06/09/2024, SD6 chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-25","state":0.64999979,"foreign":0.0028546,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Sông Đà","p":null,"t":"CORPORATE","q":22601540,"pct":65.0,"d":"2026-05-26"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":1656900,"pct":4.77,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Việt Á","p":null,"t":"CORPORATE","q":578000,"pct":1.662,"d":"2015-06-15"},{"n":"Công ty Cổ phần Sông Đà 7","p":null,"t":"CORPORATE","q":274832,"pct":0.79,"d":"2015-06-15"},{"n":"Công ty Cổ phần Lắp máy Sông Đà","p":null,"t":"CORPORATE","q":200000,"pct":0.575,"d":"2015-06-15"},{"n":"Công ty Cổ phần Sông Đà 3","p":null,"t":"CORPORATE","q":165920,"pct":0.477,"d":"2015-06-15"},{"n":"Nguyễn Văn Tùng","p":null,"t":"INDIVIDUAL","q":164095,"pct":0.47,"d":"2025-10-05"},{"n":"Đặng Quốc Bảo","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":89899,"pct":0.26,"d":"2026-01-22"},{"n":"Hồ Sỹ Hùng","p":null,"t":"INDIVIDUAL","q":56860,"pct":0.164,"d":"2025-10-05"},{"n":"Nguyễn Văn Ngạn","p":"Kế toán trưởng","t":"INDIVIDUAL","q":43838,"pct":0.13,"d":"2026-01-22"},{"n":"Nguyễn Văn Năm","p":null,"t":"INDIVIDUAL","q":41000,"pct":0.118,"d":"2025-10-05"},{"n":"Vũ Đức Lãm","p":null,"t":"INDIVIDUAL","q":35100,"pct":0.101,"d":"2025-10-05"},{"n":"Nguyễn Khắc Hà","p":null,"t":"INDIVIDUAL","q":8500,"pct":0.024,"d":"2022-05-11"},{"n":"Nguyễn Văn Thắng","p":null,"t":"INDIVIDUAL","q":8500,"pct":0.024,"d":"2015-09-14"},{"n":"Lê Văn Sinh","p":null,"t":"INDIVIDUAL","q":7410,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Văn Hùng","p":null,"