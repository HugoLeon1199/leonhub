ức hoạt động theo mô hình công ty cổ phần từ năm 2007. Công ty hiện có năng lực sản xuất 180.000 tấn phôi thép/năm và 150.000 tấn thép cán/năm. Địa bàn kinh doanh chính của Công ty là thành phố Hồ Chí Minh, Bà Rịa - Vũng Tàu, Nha Trang và Cần Thơ. VCA được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 12/2020.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2011-02-21","state":0.0,"foreign":0.00111112,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bùi Tuấn Anh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":9871875,"pct":65.0,"d":"2026-02-06"},{"n":"Công ty Cổ phần Thép Đà Nẵng","p":null,"t":"CORPORATE","q":1084629,"pct":7.14,"d":"2026-02-06"},{"n":"American LLC","p":null,"t":"CORPORATE","q":799000,"pct":5.26,"d":"2022-05-12"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":720000,"pct":4.741,"d":"2025-10-05"},{"n":"Lê Đức Thọ","p":null,"t":"INDIVIDUAL","q":6750,"pct":0.044,"d":"2015-09-14"},{"n":"Chu Sơn Thành","p":null,"t":"INDIVIDUAL","q":4050,"pct":0.027,"d":"2015-09-14"},{"n":"Lê Văn Tuấn","p":null,"t":"INDIVIDUAL","q":3375,"pct":0.022,"d":"2015-09-14"},{"n":"Vương Thành Đường","p":null,"t":"INDIVIDUAL","q":2587,"pct":0.017,"d":"2025-10-05"},{"n":"Nguyễn Quyết Chiến","p":null,"t":"INDIVIDUAL","q":2250,"pct":0.014,"d":"2026-02-06"},{"n":"Vũ Hồng Khanh","p":null,"t":"INDIVIDUAL","q":2137,"pct":0.014,"d":"2025-12-31"},{"n":"Nguyễn Thanh Hùng","p":null,"t":"INDIVIDUAL","q":1958,"pct":0.013,"d":"2025-10-05"},{"n":"Đặng Công An","p":null,"t":"INDIVIDUAL","q":1800,"pct":0.012,"d":"2015-09-14"},{"n":"Nguyễn Bạch Đường","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1462,"pct":0.01,"d":"2025-12-29"},{"n":"Trần Thanh Toàn","p":null,"t":"INDIVIDUAL","q":1575,"pct":0.01,"d":"2015-09-14"},{"n":"Hồ Duy Khải","p":null,"t":"INDIVIDUAL","q":337,"pct":0.002,"d":"2025-12-31"},{"n":"Lê Trọng Dung","p":null,"t":"INDIVIDUAL","q":2137,"pct":0.0,"d":"2025-10-05"}],"events":[