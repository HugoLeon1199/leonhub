c. Với diện tích quy mô là 5.000 m2 công ty đã đầu tư 02 dây chuyền sản xuất bột cá và mỡ cá được chế biến từ phụ phẩm cá (như đầu, xương, thịt vụn, nội tạng của cá ...). Ngày 05/11/2015, DAT chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2015-11-05","state":0.0,"foreign":7.042e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Đầu tư và Phát triển Đa Quốc Gia I.D.I","p":null,"t":"CORPORATE","q":54861340,"pct":79.25,"d":"2026-07-30"},{"n":"Công ty Cổ phần Tập đoàn Sao Mai","p":null,"t":"CORPORATE","q":2725569,"pct":3.94,"d":"2026-07-30"},{"n":"Lê Thanh Thuấn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2725569,"pct":3.94,"d":"2026-07-30"},{"n":"Lê Tuấn Anh","p":null,"t":"INDIVIDUAL","q":2725569,"pct":3.94,"d":"2026-07-30"},{"n":"Lê Văn Chung","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":218951,"pct":0.32,"d":"2026-07-30"},{"n":"Lê Văn Thủy","p":null,"t":"INDIVIDUAL","q":159534,"pct":0.23,"d":"2026-07-30"},{"n":"Lê Văn Thành","p":null,"t":"INDIVIDUAL","q":29252,"pct":0.042,"d":"2026-07-30"},{"n":"Lê Hoàng Cương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":906,"pct":0.001,"d":"2026-07-30"},{"n":"Lê Ngọc Xuyến","p":null,"t":"INDIVIDUAL","q":906,"pct":0.001,"d":"2026-07-30"},{"n":"Lê Văn Lâm","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":906,"pct":0.001,"d":"2026-07-30"},{"n":"Nguyễn Gia Thuần","p":"Kế toán trưởng","t":"INDIVIDUAL","q":726,"pct":0.001,"d":"2026-07-30"},{"n":"Trần Bảo Đông","p":"Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":270,"pct":0.0,"d":"2026-07-30"},{"n":"Trần Thụy Thanh Thảo","p":"Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":270,"pct":0.0,"d":"2026-07-30"}],"rel":[{"c":"ASTAR","n":"Công ty Cổ phần Tư vấn & Đầu tư Tài chính","t":"affiliate","pct":5.4}],"rel_count":1,"events":[{"c":"AGME","t":"DAT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-06","record":"2026-03-23","ex":"2026-0