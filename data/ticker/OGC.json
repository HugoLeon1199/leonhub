n Văn Trỗi, Thủ Thiêm (TP Hồ Chí Minh), Hạ Long (Quảng Ninh)...Ngày 04/05/2010, OCG chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Dịch vụ tài chính","type":"CT","listed":"2010-05-04","state":0.0,"foreign":0.00273505,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Thương mại Phát triển nhà và đô thị Việt Nam","p":null,"t":"CORPORATE","q":51724860,"pct":17.24,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu Tư Bất Động Sản Thương Mại Hùng Lĩnh","p":null,"t":"CORPORATE","q":48263040,"pct":16.09,"d":"2025-10-05"},{"n":"CÔNG TY CỔ PHẦN XÂY DỰNG SÔNG HỒNG BẮC VIỆT","p":null,"t":"CORPORATE","q":27058490,"pct":9.02,"d":"2025-10-05"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":14652460,"pct":4.88,"d":"2025-10-05"},{"n":"Công Ty Cổ Phần Đầu Tư Và Xây Dựng Sông Đà","p":null,"t":"CORPORATE","q":14618311,"pct":4.873,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư và Thương mại VNECO Hà Nội","p":null,"t":"CORPORATE","q":14499312,"pct":4.833,"d":"2015-06-15"},{"n":"Công ty Cổ phần Thương mại và Kho vận Thành Đông","p":null,"t":"CORPORATE","q":14157740,"pct":4.719,"d":"2015-06-15"},{"n":"Công ty Cổ phần Quản lý quỹ đầu tư FPT","p":null,"t":"CORPORATE","q":13333333,"pct":4.444,"d":"2015-06-15"},{"n":"Ngân hàng Thương mại Cổ phần Đại chúng Việt Nam","p":null,"t":"CORPORATE","q":12000000,"pct":4.0,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư và Xây dựng Bảo Minh","p":null,"t":"CORPORATE","q":9606000,"pct":3.202,"d":"2015-06-15"},{"n":"Công ty Cổ phần Bảo Linh","p":null,"t":"CORPORATE","q":9250956,"pct":3.084,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư và Tư vấn tài chính Liên Việt","p":null,"t":"CORPORATE","q":8912903,"pct":2.971,"d":"2015-06-15"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":8291574,"pct":2.764,"d":"2015-06-15"},{"n":"Công Ty TNHH Vnt","p":null,"t":"CORPORATE","q":6270000,"pct":2.09,"d":"2015-06-15"},{"n":"Hà Văn Thắm","p":null,"t"