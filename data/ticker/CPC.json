anh thuốc bảo vệ thực vật. CPC chính thức hoạt động theo mô hình công ty cổ phần từ năm 2002. Hiện nay tổng công suất các dây chuyền sản xuất thuốc bảo vệ thực vật của công ty theo thiết kế là 13.000 tấn/năm. CPC hoạt động kinh doanh chủ yếu tại Đồng Bằng Sông Cửu Long, các tỉnh miền Trung và Tây Nguyên. Đến nay, CPC đã có hơn 80 đại lý cấp I và hơn 2.000 đại lý cấp II. CPC được niêm yết trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2010.","sector":"Hóa chất","type":"CT","listed":"2010-01-18","state":0.0,"foreign":0.02698365,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Thương Mại-dịch Vụ Thanh Sơn Hóa Nông","p":null,"t":"CORPORATE","q":875220,"pct":20.33,"d":"2026-03-04"},{"n":"Võ Thanh Tùng","p":null,"t":"INDIVIDUAL","q":575000,"pct":13.36,"d":"2026-03-04"},{"n":"Võ Viết Thanh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":360543,"pct":8.37,"d":"2026-03-04"},{"n":"Lê Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":216544,"pct":5.03,"d":"2025-10-05"},{"n":"Phan Văn Mưa","p":null,"t":"INDIVIDUAL","q":202230,"pct":4.69,"d":"2025-10-05"},{"n":"Nguyễn Văn Trung","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":93262,"pct":2.16,"d":"2026-03-04"},{"n":"Cao Thị Kim Tuyến","p":null,"t":"INDIVIDUAL","q":59658,"pct":1.38,"d":"2026-03-04"},{"n":"Phạm Quang Nghiêm","p":null,"t":"INDIVIDUAL","q":54691,"pct":1.34,"d":"2015-09-14"},{"n":"Nguyễn Thị Lến","p":null,"t":"INDIVIDUAL","q":56175,"pct":1.3,"d":"2025-10-05"},{"n":"AFC Umbrella Fund","p":null,"t":"CORPORATE","q":50000,"pct":1.162,"d":"2015-06-15"},{"n":"Đỗ Văn Thành","p":null,"t":"INDIVIDUAL","q":46821,"pct":1.147,"d":"2015-09-14"},{"n":"Nguyễn Ngọc Minh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":46333,"pct":1.07,"d":"2026-03-04"},{"n":"Quách Thị Thúy","p":"Kế toán trưởng","t":"INDIVIDUAL","q":37876,"pct":0.88,"d":"2026-03-04"},{"n":"Dương Minh Thành","p":null,"t":"INDIVIDUAL","q":21200,"pct":0.49,"d":"2025-10-0