- sở hữu - kinh doanh (BOO). Các công trình tiêu biểu khẳng định năng lực đầu tư, quản lý và vận hành dự án của CII có thể kể đến là dự án cầu đường Bình Triệu, dự án cầu Sài Gòn 2, dự án mở rộng Xa lộ Hà Nội, dự án liên tỉnh lộ 25B. CII được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh từ năm 2006.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-05-18","state":0.04079867,"foreign":0.03528926,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Đầu tư Tài chính Nhà nước Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":27416105,"pct":4.08,"d":"2026-08-10"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":9263000,"pct":3.88,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán Thiên Việt","p":null,"t":"CORPORATE","q":6425000,"pct":3.024,"d":"2015-06-15"},{"n":"Viac Limited Partnership","p":null,"t":"CORPORATE","q":7194821,"pct":3.01,"d":"2025-10-05"},{"n":"Vietnam Infrastructure Strategic Ltd","p":null,"t":"CORPORATE","q":6226585,"pct":2.931,"d":"2015-06-15"},{"n":"Master Fund Holdings (Cayman) Ltd.","p":null,"t":"CORPORATE","q":6146708,"pct":2.5,"d":"2025-10-05"},{"n":"Peconic Holdings (Cayman) Ltd.","p":null,"t":"CORPORATE","q":4465055,"pct":1.81,"d":"2025-10-05"},{"n":"AIT PTE. LTD","p":null,"t":"CORPORATE","q":3822650,"pct":1.799,"d":"2015-06-15"},{"n":"Công ty TNHH Lê Thành Cường","p":null,"t":"CORPORATE","q":4049840,"pct":1.696,"d":"2025-10-05"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":4004700,"pct":1.676,"d":"2025-10-05"},{"n":"VIP Infrastructure Holdings Pte. Ltd.","p":null,"t":"CORPORATE","q":4000000,"pct":1.61,"d":"2025-10-05"},{"n":"VietNam Infrastructure Holding Limited","p":null,"t":"CORPORATE","q":3290176,"pct":1.549,"d":"2015-06-15"},{"n":"Citgroup Global Markets Limited","p":null,"t":"CORPORATE","q":2748290,"pct":1.294,"d":"2015-06-15"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":2533515,"pct":