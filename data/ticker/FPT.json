"2018",14.359],["2019",16.814],["2020",14.69],["2021",13.044],["2022",18.004],["2023",19.217],["2024",20.737],["2025",16.952]]}},"co":{"short":"FPT Corp","profile":"Công ty Cổ phần FPT (FPT) có tiền thân là Công ty Công nghệ Thực phẩm được thành lập năm 1988. Công ty hoạt động chính trong lĩnh vực phần mềm, công nghệ thông tin, tích hợp hệ thống, viễn thông, và giáo dục đào tạo. FPT chính thức hoạt động theo mô hình công ty cổ phần từ năm 2002. FPT là tập đoàn công nghệ và dịch vụ CNTT có hiện diện tại hơn 30 quốc gia và vùng lãnh thổ trên 4 châu lục. Doanh nghiệp tập trung vào các mảng công nghệ chiến lược như AI, điện toán đám mây, bán dẫn, an ninh mạng và dữ liệu, đồng thời vận hành trung tâm dữ liệu quy mô 10.000 m² cùng các nhà máy AI tại Việt Nam và Nhật Bản. FPT cũng tham gia nhiều dự án chuyển đổi số quy mô lớn cho khối Chính phủ, bộ ngành, địa phương và khách hàng toàn cầu. FPT được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 12/2006.","sector":"Công nghệ Thông tin","type":"CT","listed":"2006-12-13","state":0.05634028,"foreign":0.27707437,"rating":"BUY","target":90300.0,"rating_as_of":"2026-06-08","source":"Vietcap"},"owners":[{"n":"Trương Gia Bình","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":117347966,"pct":6.89,"d":"2026-08-03"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":96585637,"pct":5.67,"d":"2026-08-03"},{"n":"Công ty TNHH QT","p":null,"t":"CORPORATE","q":54303923,"pct":3.69,"d":"2025-10-05"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":9604598,"pct":2.416,"d":"2015-06-15"},{"n":"Vinacapital Vietnam Opportunity Fund Ltd.","p":null,"t":"CORPORATE","q":22791922,"pct":1.55,"d":"2025-10-05"},{"n":"Bùi Quang Ngọc","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":25255715,"pct":1.48,"d":"2026-08-03"},{"n":"Trương Thị Thanh Thanh","p":null,"t":"INDIVIDUAL","q":25095835,"pct":1.47,"d":"2026-08-03"},{"n":"Hoàng Minh C