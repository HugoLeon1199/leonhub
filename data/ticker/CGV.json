lập vào năm 1993. Công ty hoạt động chính trong lĩnh vực gia công và sản xuất các sản phẩm sành sứ, thủy tinh, và vật liệu xây dựng. CGV chính thức hoạt động theo hình thức công ty cổ phần từ năm 2006. Bên cạnh đó, Công ty còn cho thuê mặt bằng trên các địa bàn các tỉnh phía Bắc như Hà Nội, Hải Dương, Hưng Yên và các tỉnh thành ở miền Nam bao gồm Bình Dương hay Bà Rịa Vũng Tàu. Hiện nay, CGV tập trung vào sản xuất vật liệu xây dựng cách điện. CGV được giao dịch trên thị trường UPCOM từ tháng 06/2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-06-21","state":0.0,"foreign":0.00047474,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Lê Dũng","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1432879,"pct":15.08,"d":"2026-08-12"},{"n":"Lưu Quang Hưng","p":null,"t":"INDIVIDUAL","q":1145700,"pct":12.06,"d":"2025-10-05"},{"n":"Công ty Cổ phần Hà Quang","p":null,"t":"CORPORATE","q":674636,"pct":7.1,"d":"2025-10-05"},{"n":"Tổng Công ty Cổ phần Bia - Rượu - Nước giải khát Hà Nội","p":null,"t":"CORPORATE","q":570000,"pct":6.0,"d":"2025-10-05"},{"n":"Lê Quang Tuấn","p":null,"t":"INDIVIDUAL","q":528169,"pct":5.56,"d":"2020-05-06"},{"n":"Phan Ngọc Anh","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":478036,"pct":5.03,"d":"2026-08-12"},{"n":"Nguyễn Miên Tiến","p":null,"t":"INDIVIDUAL","q":465000,"pct":4.89,"d":"2025-10-05"},{"n":"Huỳnh Thị Kim Hoa","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":436430,"pct":4.59,"d":"2026-08-12"},{"n":"Trần Huỳnh Quang","p":"Chủ tịch Hội đồng Quản trị/Giám đốc điều hành/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":327526,"pct":3.45,"d":"2026-08-12"},{"n":"Phan Thanh Liêm","p":"Thành viên Hội đồng Quản trị/Giám đốc/Giám đốc điều hành","t":"INDIVIDUAL","q":131250,"pct":1.38,"d":"2026-08-12"},{"n":"Nguyễn Ngọc Huy","p":null,"t":"INDIVIDUAL","q":127789,"pct":1.35,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Cường","p":null,"t":"INDIVIDUAL","q":86414,"pct":0.91,"d":"202