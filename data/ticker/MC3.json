n 303 Thanh Sơn - Phú Thọ và Xí nghiệp Địa chất Khoáng sản 307 Kim Bôi - Hòa Bình. Công ty hoạt động chính trong lĩnh vực khảo sát, thăm dò, khai thác và chế biến khoáng sản. MC3 chính thức hoạt động theo hình thức công ty cổ phần từ năm 2008. Công ty hiện đang khai thác chế biến tinh quặng sắt tại Mỏ sắt Kíp Tước, xã Hợp Thành, Cam Đường, thành phố Lào Cai với công suất thiết kế 100.000 tấn tinh quặng/năm và mỏ sắt Làng Vinh-Làng Cọ, huyện Văn Bàn, tỉnh Lào Cai với sản lượng 220.000 tấm quặng tinh/năm.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2017-03-13","state":0.51,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần","p":null,"t":"CORPORATE","q":1785000,"pct":51.0,"d":"2025-11-19"},{"n":"Phạm Ngọc Sơn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":194444,"pct":5.56,"d":"2022-05-16"},{"n":"Nguyễn Cao Khương","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":117440,"pct":3.36,"d":"2022-05-16"},{"n":"Hoàng Tuấn Anh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":22230,"pct":0.64,"d":"2022-05-12"},{"n":"Nguyễn Văn Thanh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":20410,"pct":0.58,"d":"2022-05-12"},{"n":"Mai Văn Thành","p":"Thành viên Ban kiểm soát/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":20040,"pct":0.57,"d":"2022-05-12"},{"n":"Trần Văn Thông","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.29,"d":"2018-07-18"},{"n":"Đồng Quang Huy","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2000,"pct":0.06,"d":"2022-03-28"}],"events":[{"c":"DDIND","t":"Trần Trung Thành - Đăng kí Bán 22,280 MC3","d":"2022-06-28","record":null,"ex":null},{"c":"SUSP","t":"MC3 - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCoM","d":"2022-06-17","record":null,"ex":null},{"c":"AGME","t":"MC3 - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-14","record":"2022-03-18","ex":"2022-03-17"},{"c":"DDIND","t":"Phạm Ngọc Sơn -