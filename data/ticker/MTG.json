24],["2020",0.0],["2021",10.12],["2022",-2.374],["2023",4.821],["2024",9.263],["2025",0.58]]}},"co":{"short":"MTGAS","profile":"Công ty Cổ phần MT Gas (MTG) tiền thân là Công ty TNHH MT GAS thành lập năm 2001. Năm 2003, công ty chuyển sang hoạt động theo mô hình cổ phần. Hoạt động kinh doanh chính của công ty là phân phối khí đốt hóa lỏng, cho thuê kho bãi, đầu tư xây dựng. Thị trường chính của công ty là khu vực Miền Tây, khu vực Thành phố Hồ Chí Minh và khu vực Miền Đông - Nam Bộ. Khách hàng chính là những công ty sản xuất - kinh doanh nằm trong các khu công nghiệp lớn như: Công ty Cổ phần Đồng tâm Dotalia, Công ty Cổ phần Đồng tâm, Công ty Thép TVP, Công ty TNHH Kinh Show, doanh nghiệp tư nhan Hoàng Việt, Công ty Cổ phần kinh doanh Khí Miền Nam. Ngoài ra công ty còn đầu tư vào lĩnh vực bất động sản. MTG được giao dịch tại thị trường UPCoM từ năm 2015.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2009-01-15","state":0.0,"foreign":0.00853923,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn Dầu khí An Pha","p":null,"t":"CORPORATE","q":4256345,"pct":40.72,"d":"2026-08-17"},{"n":"Nguyễn Anh Tú","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3000000,"pct":28.7,"d":"2026-08-17"},{"n":"Trương Hữu Phước","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1603000,"pct":15.34,"d":"2026-08-17"},{"n":"Công ty Cổ phần Chứng khoán Rồng Việt","p":null,"t":"CORPORATE","q":573110,"pct":4.776,"d":"2015-06-15"},{"n":"Trần Thị Dịu Hòa","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.067,"d":"2015-09-14"},{"n":"Nguyễn Thị Lan Phương","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.008,"d":"2015-09-14"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 500 VND","d":"2026-05-05","record":"2026-05-29","ex":"2026-05-28"},{"c":"AGME","t":"MTG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-11","record":"2026-03-27","ex":"2026-03-26"},{"c":"DDIND","t":"Trương Hữu Phước - Đăng kí