79. KHW chính thức hoạt động động theo mô hình công ty cổ phần từ năm 2013. Công ty hoạt động chính trong lĩnh vực khai thác, xử lý cung cấp nước sạch, thoát nước và xử lý nước thải. KHW hiện đang quản lý vận hành Nhà máy nước Võ Cạnh và Nhà máy nước Xuân Phong có tổng công suất 113.000m3/ngày đêm. KHW được giao dịch trên thị trường UPCOM từ tháng 02/2017.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-02-20","state":0.51000116,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Khánh Hòa","p":null,"t":"CORPORATE","q":14586000,"pct":51.0,"d":"2026-08-25"},{"n":"Công ty TNHH Nước Sạch Ree","p":null,"t":"CORPORATE","q":12550560,"pct":43.88,"d":"2026-08-25"},{"n":"Nguyễn Văn Quân","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":34820,"pct":0.097,"d":"2026-08-25"},{"n":"Vũ Văn Bình","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":31933,"pct":0.089,"d":"2026-08-25"},{"n":"Nguyễn Văn Đàm","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":27946,"pct":0.078,"d":"2026-08-25"},{"n":"Võ Thị Khánh Hoà","p":null,"t":"INDIVIDUAL","q":15647,"pct":0.055,"d":"2026-06-05"},{"n":"Nguyễn Đình Hà","p":null,"t":"INDIVIDUAL","q":18562,"pct":0.052,"d":"2026-08-25"},{"n":"Hoàng Thị Hương Giang","p":"Kế toán trưởng","t":"INDIVIDUAL","q":16396,"pct":0.046,"d":"2026-08-25"},{"n":"Hoàng Long","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":7975,"pct":0.022,"d":"2026-08-25"},{"n":"Nguyễn Thị Thùy Ninh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":7700,"pct":0.022,"d":"2026-08-25"},{"n":"Nguyễn Hồng Sơn","p":null,"t":"INDIVIDUAL","q":2970,"pct":0.01,"d":"2026-08-25"},{"n":"Nguyễn Thanh Hằng","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3750,"pct":0.01,"d":"2026-08-25"},{"n":"Trần Thị Thu Hồng","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3750,"pct":0.01,"d":"2026-08-25"}],"rel":[