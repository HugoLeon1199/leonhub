uê...Ngày 27/04/2018, TH1 chính thức giao dịch trên thị trường UPCOM.","sector":"Bán lẻ","type":"CT","listed":"2009-11-11","state":0.0,"foreign":0.00014883,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đinh Đức Tùng","p":null,"t":"INDIVIDUAL","q":2806520,"pct":20.73,"d":"2026-03-06"},{"n":"Nguyễn Vĩnh Huy","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2150000,"pct":15.88,"d":"2026-08-20"},{"n":"Hoàng Trí Cường","p":null,"t":"INDIVIDUAL","q":757000,"pct":5.59,"d":"2025-10-05"},{"n":"VOF Investment Limited","p":null,"t":"CORPORATE","q":571666,"pct":4.539,"d":"2015-06-15"},{"n":"Công ty cổ phần Đầu tư và Thương mại Xuất nhập khẩu HFC Việt Nam","p":null,"t":"CORPORATE","q":303526,"pct":2.24,"d":"2025-10-05"},{"n":"Hoàng Tuấn Khải","p":null,"t":"INDIVIDUAL","q":84304,"pct":0.62,"d":"2025-10-05"},{"n":"Lê Thái Hà","p":null,"t":"INDIVIDUAL","q":71554,"pct":0.568,"d":"2015-09-14"},{"n":"Phan Thu Anh","p":null,"t":"INDIVIDUAL","q":56407,"pct":0.448,"d":"2015-09-14"},{"n":"Nguyễn Văn Khang","p":null,"t":"INDIVIDUAL","q":50853,"pct":0.404,"d":"2015-09-14"},{"n":"Nguyễn Anh Tuấn","p":null,"t":"INDIVIDUAL","q":45170,"pct":0.359,"d":"2015-09-14"},{"n":"Phạm Uyên Nguyên","p":null,"t":"INDIVIDUAL","q":43000,"pct":0.341,"d":"2025-10-05"},{"n":"Phạm Minh Sơn","p":null,"t":"INDIVIDUAL","q":30581,"pct":0.23,"d":"2025-10-05"},{"n":"Lê Xuân Chất","p":null,"t":"INDIVIDUAL","q":27405,"pct":0.218,"d":"2015-09-14"},{"n":"Phạm Thị Thảo","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":15400,"pct":0.114,"d":"2026-08-20"},{"n":"Lê Công Thuận","p":null,"t":"INDIVIDUAL","q":12639,"pct":0.1,"d":"2015-09-14"},{"n":"Trịnh Thanh Hà","p":null,"t":"INDIVIDUAL","q":5026,"pct":0.04,"d":"2015-09-14"},{"n":"Hoàng Quang Tú","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.008,"d":"2015-09-14"},{"n":"Công ty Cổ phần Chứng khoán Bảo Việt","p":null,"t":"CORPORATE","q":636,"pct":0.005,"d":"2015-06-15"}],"rel":[{"c":"0109763507","n":"Công ty Cổ phần Đầu Tư Và Kinh Doanh