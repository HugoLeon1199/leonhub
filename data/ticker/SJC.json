 thuộc Công ty Sông Đà 1 được thành lập năm 2001. Công ty được cổ phần hóa năm 2003. Vốn điều lệ hiện nay là 72 tỷ đồng. Hoạt động chính của công ty là xây dựng các công trình dân dụng và công nghiệp, kinh doanh bất động sản. Bên cạnh việc là thành viên của Tổng Công ty Sông Đà, công ty đã tạo dựng được uy tín, có mối quan hệ chặt chẽ và gắn bó lâu dài với đối tác quan trọng trong việc cung cấp nguyên vật liệu đầu vào. Đây là lợi thế của công ty trong việc thực hiện các dự án xây dựng.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2007-11-21","state":0.19919993,"foreign":0.00282062,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Hà Phương","p":null,"t":"INDIVIDUAL","q":901520,"pct":12.99,"d":"2025-10-05"},{"n":"Nguyễn Thanh Hải","p":null,"t":"INDIVIDUAL","q":722692,"pct":10.42,"d":"2025-10-05"},{"n":"Nguyễn Đình Linh","p":null,"t":"INDIVIDUAL","q":662435,"pct":9.55,"d":"2025-10-05"},{"n":"Đào Thị Hồi","p":null,"t":"INDIVIDUAL","q":345962,"pct":4.99,"d":"2025-10-05"},{"n":"Nguyễn Bích Hạnh","p":null,"t":"INDIVIDUAL","q":247744,"pct":3.57,"d":"2025-10-05"},{"n":"Ngô Thị Mười","p":null,"t":"INDIVIDUAL","q":247844,"pct":3.57,"d":"2025-10-05"},{"n":"Phạm Văn Nam","p":null,"t":"INDIVIDUAL","q":247844,"pct":3.57,"d":"2025-10-05"},{"n":"Nguyễn Thị Thu Hiền","p":null,"t":"INDIVIDUAL","q":168058,"pct":2.42,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng Khoán VPS","p":null,"t":"CORPORATE","q":129930,"pct":1.798,"d":"2015-06-15"},{"n":"Đầu Tư Nam Nhật Khang","p":null,"t":"CORPORATE","q":10000,"pct":0.14,"d":"2025-10-05"},{"n":"Bùi Đức Quang","p":null,"t":"INDIVIDUAL","q":8325,"pct":0.12,"d":"2015-09-14"},{"n":"Trần Thọ Phong","p":null,"t":"INDIVIDUAL","q":1676,"pct":0.02,"d":"2025-10-05"},{"n":"VŨ THỊ THÚY","p":"Chủ tịch Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":22,"pct":0.0,"d":"2025-10-05"}],"events":[{"c":"SUSP","t":"SJC - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2026-02-06","re