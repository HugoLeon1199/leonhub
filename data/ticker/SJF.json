 dịch trên thị trường UPCOM.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2017-07-05","state":0.0,"foreign":0.00332542,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đỗ Cần","p":null,"t":"INDIVIDUAL","q":7070080,"pct":8.93,"d":"2025-10-05"},{"n":"Đỗ Ngọc Anh Thư","p":null,"t":"INDIVIDUAL","q":4114980,"pct":5.19,"d":"2025-12-29"},{"n":"Công ty Cổ phần Đầu tư TONKIN","p":null,"t":"CORPORATE","q":3931356,"pct":4.96,"d":"2025-10-05"},{"n":"Nguyễn Trí Thiện","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3871100,"pct":4.89,"d":"2026-03-02"},{"n":"Nguyễn Thị Hồng Ngọc","p":null,"t":"INDIVIDUAL","q":3856600,"pct":4.87,"d":"2025-10-05"},{"n":"Bùi Thị Hạnh Tâm","p":null,"t":"INDIVIDUAL","q":2975000,"pct":4.507,"d":"2025-10-05"},{"n":"Nguyễn Thị Ban","p":null,"t":"INDIVIDUAL","q":2875000,"pct":4.356,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư HAFA","p":null,"t":"CORPORATE","q":3227750,"pct":4.08,"d":"2025-10-05"},{"n":"Đỗ Ngọc Kim Ngân","p":null,"t":"INDIVIDUAL","q":2921980,"pct":3.69,"d":"2025-12-29"},{"n":"Nguyễn Tấn Đạt","p":null,"t":"INDIVIDUAL","q":2668000,"pct":3.37,"d":"2025-10-05"},{"n":"Nguyễn Xuân Nam","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1510000,"pct":1.91,"d":"2026-03-02"},{"n":"Nguyễn Trọng Nghĩa","p":null,"t":"INDIVIDUAL","q":1200000,"pct":1.52,"d":"2025-10-05"},{"n":"Nguyễn Huy Quảng","p":null,"t":"INDIVIDUAL","q":600000,"pct":0.76,"d":"2025-10-05"},{"n":"Nguyễn Thị Minh","p":null,"t":"INDIVIDUAL","q":120000,"pct":0.15,"d":"2026-06-19"},{"n":"Nguyễn Công Khải","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":59100,"pct":0.075,"d":"2026-03-02"},{"n":"Hoàng Đình Hảo","p":null,"t":"INDIVIDUAL","q":10500,"pct":0.001,"d":"2026-03-02"}],"rel":[{"c":"11032","n":"Công ty Cổ Phần Bwg Mai Châu","t":"subsidiary","pct":96.54},{"c":"11033","n":"Công ty Cổ phần Việt Nga Hòa Bình","t":"subsidiary","pct":95.0},{"c":"0109026415","n":"Công ty Cổ Phần Sunstar Ecotech Việt Nam","t":"s