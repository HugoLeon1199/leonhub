 đá Quartz (Thạch anh) và từ quặng than. Sản phẩm của công ty được cung cấp làm nguyên liệu đầu vào cho ngành vật liệu xây dựng, giấy, dược phẩm, mỹ phẩm, phục vụ cho ngành công nghiệp sản xuất gốm sứ, kính thủy tinh... trong nước và xuất khẩu sang Nhật Bản và Hàn Quốc. Hiện nay Công ty đang được phép khai thác 5 mỏ quặng tại tỉnh Hòa Bình và Sơn La: mỏ Talc và đá Đôlômit - Tân Minh, Hòa Bình; mỏ quặng đá Canxit (CaCO3) - Tân Lạc, Hòa Bình; mỏ quặng than đá - Lạc Sỹ, Hòa Bình; mỏ đá Quartz và đá Bazan - Tiến Sơn, Hòa Bình; mỏ Talc - Mộc Châu, Sơn La.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2010-05-19","state":0.0,"foreign":0.00222524,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tư vấn - Đầu tư Xây dựng Ba Đình","p":null,"t":"CORPORATE","q":2100000,"pct":7.22,"d":"2025-10-05"},{"n":"Lê Hải Đoàn","p":null,"t":"INDIVIDUAL","q":1420000,"pct":4.88,"d":"2021-02-25"},{"n":"Phạm Thị Hinh","p":null,"t":"INDIVIDUAL","q":1180000,"pct":4.06,"d":"2016-01-19"},{"n":"Lương Xuân Quân","p":null,"t":"INDIVIDUAL","q":600000,"pct":2.06,"d":"2016-06-03"},{"n":"Phạm Thị Linh","p":null,"t":"INDIVIDUAL","q":500000,"pct":1.72,"d":"2016-07-20"},{"n":"Đoàn Quốc Tuấn","p":null,"t":"INDIVIDUAL","q":50600,"pct":0.193,"d":"2015-09-14"},{"n":"Bùi Thị Thoa","p":null,"t":"INDIVIDUAL","q":16200,"pct":0.062,"d":"2015-09-14"},{"n":"Lê Hữu Lộc","p":null,"t":"INDIVIDUAL","q":12500,"pct":0.04,"d":"2016-07-12"},{"n":"Đỗ Phan Thắng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.038,"d":"2015-09-14"},{"n":"Phùng Thị Kim Anh","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.03,"d":"2016-07-12"},{"n":"Trần Anh Tú","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.03,"d":"2016-07-12"},{"n":"Nguyễn Thị Tâm","p":null,"t":"INDIVIDUAL","q":669,"pct":0.003,"d":"2015-09-14"}],"events":[{"c":"SUSP","t":"KHB - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2022-08-10","record":null,"ex":null},{"c":"AGME","t":"KHB - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-0