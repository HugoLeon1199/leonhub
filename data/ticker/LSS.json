h.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2008-01-09","state":0.0,"foreign":0.00576098,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Hiệp Hội Mía Đường Lam Sơn","p":null,"t":"CORPORATE","q":19805373,"pct":22.0,"d":"2026-08-26"},{"n":"Công ty Cổ Phần Thương Mại Và Đầu Tư Thăng Long Hà Nội","p":null,"t":"CORPORATE","q":9435559,"pct":10.48,"d":"2026-08-26"},{"n":"Lê Trung Thành","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5106111,"pct":5.67,"d":"2026-08-26"},{"n":"Lê Văn Tân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4547183,"pct":5.05,"d":"2026-08-26"},{"n":"Lê Thị Lộc","p":null,"t":"INDIVIDUAL","q":2058027,"pct":2.29,"d":"2026-08-26"},{"n":"Lê Thanh Tùng","p":null,"t":"INDIVIDUAL","q":769778,"pct":0.86,"d":"2026-08-26"},{"n":"Phùng Thị Tâm","p":null,"t":"INDIVIDUAL","q":321578,"pct":0.36,"d":"2026-08-26"},{"n":"Lê Văn Quang","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":85856,"pct":0.1,"d":"2026-08-26"},{"n":"Lê Văn Thanh","p":null,"t":"INDIVIDUAL","q":70312,"pct":0.1,"d":"2015-09-14"},{"n":"Hà Đức Chính","p":null,"t":"INDIVIDUAL","q":54992,"pct":0.079,"d":"2015-09-14"},{"n":"Trần Quốc Vinh","p":null,"t":"INDIVIDUAL","q":38873,"pct":0.056,"d":"2015-09-14"},{"n":"Lê Khắc Chung","p":null,"t":"INDIVIDUAL","q":38675,"pct":0.055,"d":"2015-09-14"},{"n":"Bùi Xuân Sinh","p":null,"t":"INDIVIDUAL","q":33570,"pct":0.048,"d":"2015-09-14"},{"n":"Vũ Trung Thịnh","p":null,"t":"INDIVIDUAL","q":26370,"pct":0.038,"d":"2015-09-14"},{"n":"Lê Văn Vinh","p":null,"t":"INDIVIDUAL","q":25723,"pct":0.03,"d":"2026-08-26"},{"n":"Nguyễn Xuân Lam","p":null,"t":"INDIVIDUAL","q":12414,"pct":0.014,"d":"2026-02-13"},{"n":"Phạm Văn Ngọc","p":null,"t":"INDIVIDUAL","q":8250,"pct":0.012,"d":"2015-09-14"},{"n":"Bùi Thị Thu Nga","p":null,"t":"INDIVIDUAL","q":4176,"pct":0.01,"d":"2026-08-26"},{"n":"Nguyễn Duy Thành","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6059,"pct":0.01,"d":"2026-08-26"},{"n":"Phùng Thanh Hải","p":"Thành vi