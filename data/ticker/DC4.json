hoạt động chính trong lĩnh vực thi công xây lắp các công trình dân dụng, công nghiệp, và cơ sở hạ tầng đô thị. Ngoài ra còn có hoạt động khai khoáng và sản xuất vật liệu xây dựng. Công ty là một trong những doanh nghiệp hàng đầu trong lĩnh vực xây dựng nhà cao tầng tại Bà Rịa – Vũng Tàu và là một trong những đơn vị mạnh ở khu vực Đông Nam Bộ. Một số công trình DC4 thực hiện thi công có thể kể đến Dự án Khu biệt thự du lịch sinh thái biển Lăng Cô Spa & Resort (Thừa Thiên Huế), Khu dân cư An Sương (thành phố Hồ Chí Minh), Chí Linh Center, Khu du lịch Hải Minh, Chung cư Gateway (Bà Rịa - Vũng Tàu),... DC4 được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-11-03","state":0.0,"foreign":0.00785605,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Đầu tư Phát triển Xây dựng","p":null,"t":"CORPORATE","q":27367595,"pct":25.327,"d":"2026-08-26"},{"n":"Lê Đình Thắng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":17320270,"pct":16.029,"d":"2026-08-26"},{"n":"Công ty Cổ phần Phát triển và Kinh doanh Nhà","p":null,"t":"CORPORATE","q":8385300,"pct":7.76,"d":"2026-08-26"},{"n":"Công ty TNHH Backathome.com","p":null,"t":"CORPORATE","q":1501500,"pct":4.69,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Huệ","p":null,"t":"INDIVIDUAL","q":55100,"pct":4.59,"d":"2025-10-22"},{"n":"Nguyễn Vũ Quang","p":null,"t":"INDIVIDUAL","q":225940,"pct":4.304,"d":"2015-09-14"},{"n":"Khương Mạnh Tân","p":null,"t":"INDIVIDUAL","q":192254,"pct":3.662,"d":"2015-09-14"},{"n":"Phạm Thị Thúy","p":null,"t":"INDIVIDUAL","q":2173000,"pct":2.01,"d":"2026-08-17"},{"n":"Hoàng Thanh Minh","p":null,"t":"INDIVIDUAL","q":82303,"pct":1.568,"d":"2015-09-14"},{"n":"Trần Gia Phúc","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1679150,"pct":1.554,"d":"2026-08-11"},{"n":"Phạm Thị Thủy","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.952,"d":"2015-09-14"},{"n