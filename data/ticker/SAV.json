 khu du lịch sinh thái Đà Lạt. Ngày 09/05/2002, SAV chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2002-05-09","state":0.0,"foreign":0.4975537,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"E-land Asia Holdings Pte., Ltd","p":null,"t":"CORPORATE","q":13334365,"pct":48.78,"d":"2026-07-28"},{"n":"Đặng Bình Minh","p":null,"t":"INDIVIDUAL","q":1058280,"pct":4.908,"d":"2025-10-05"},{"n":"Nguyễn Thanh Sơn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1310400,"pct":4.79,"d":"2026-07-28"},{"n":"Nguyễn Thanh Anh","p":null,"t":"INDIVIDUAL","q":1176848,"pct":4.75,"d":"2025-10-05"},{"n":"Pxp Vietnam Fund Limited","p":null,"t":"CORPORATE","q":471650,"pct":4.734,"d":"2015-06-15"},{"n":"Công ty Cổ phần Quản lý quỹ đầu tư Chứng khoán An Phúc","p":null,"t":"CORPORATE","q":458920,"pct":4.606,"d":"2015-06-15"},{"n":"Quỹ tầm nhìn SSI","p":null,"t":"CORPORATE","q":425270,"pct":4.268,"d":"2015-06-15"},{"n":"Công ty Cổ phần DANA Ford","p":null,"t":"CORPORATE","q":345184,"pct":3.465,"d":"2015-06-15"},{"n":"Nguyễn Thị Khánh Linh","p":null,"t":"INDIVIDUAL","q":516500,"pct":2.604,"d":"2025-10-05"},{"n":"Nguyễn Thanh Hải","p":null,"t":"INDIVIDUAL","q":572457,"pct":2.14,"d":"2026-07-20"},{"n":"Bùi Ngọc Quới","p":null,"t":"INDIVIDUAL","q":88145,"pct":0.921,"d":"2015-09-14"},{"n":"Jung Sung Kwan","p":null,"t":"INDIVIDUAL","q":121640,"pct":0.564,"d":"2025-10-05"},{"n":"Công ty TNHH Sao Ánh Mai","p":null,"t":"CORPORATE","q":42100,"pct":0.423,"d":"2015-06-15"},{"n":"Lê Toàn","p":null,"t":"INDIVIDUAL","q":28670,"pct":0.3,"d":"2015-09-14"},{"n":"Lê Minh Trang","p":null,"t":"INDIVIDUAL","q":27160,"pct":0.284,"d":"2015-09-14"},{"n":"Phạm Ngọc Sinh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":72872,"pct":0.27,"d":"2026-07-28"},{"n":"Trần Văn Trí","p":null,"t":"INDIVIDUAL","q":18750,"pct":0.196,"d":"2015-09-14"},{"n":"Ngô Văn Ích","p":null,"t":"INDIVIDUAL","q":12