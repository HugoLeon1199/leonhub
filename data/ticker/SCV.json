ôn gạo. Muối là mặt hàng chủ chốt của Công ty. Hoạt động thu mua muối từ các chủ hộ kinh doanh muối đạt khoảng 9.000 đến 10.000 tấn/năm. Muối của Công ty được xuất khẩu sang các thị trường lớn như Hoa Kỳ (2.000 tấn/năm), Anh, Trung Quốc, Nhật Bản (800 tấn/năm).","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2021-05-19","state":0.65,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"events":[{"c":"SUSP","t":"SCV - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2022-11-18","record":null,"ex":null},{"c":"AGME","t":"SCV - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-04-26","record":"2022-04-29","ex":"2022-04-28"},{"c":"NLIS","t":"SCV - Chính thức giao dịch trên UPCoM","d":"2021-05-13","record":null,"ex":null}],"st":{"bsa15":{"label":"Hàng tồn kho, ròng","section":"balance","y":[["2018",14.536],["2019",9.83],["2020",17.31],["2021",14.674]],"published":"2022-03-31"},"bsa2":{"label":"Tiền và tương đương tiền","section":"balance","y":[["2018",4.323],["2019",2.392],["2020",3.191],["2021",8.763]],"published":"2022-03-31"},"bsa53":{"label":"TỔNG CỘNG TÀI SẢN","section":"balance","y":[["2018",90.654],["2019",81.552],["2020",61.87],["2021",89.292]],"published":"2022-03-31"},"bsa54":{"label":"NỢ PHẢI TRẢ","section":"balance","y":[["2018",57.762],["2019",54.228],["2020",38.797],["2021",64.643]],"published":"2022-03-31"},"bsa6":{"label":"Đầu tư ngắn hạn","section":"balance","y":[["2018",0.0],["2019",0.0],["2020",0.0],["2021",0.0]],"published":"2022-03-31"},"bsa78":{"label":"Vốn chủ sở hữu","section":"balance","y":[["2018",32.892],["2019",27.324],["2020",23.073],["2021",24.649]],"published":"2022-03-31"},"cfa18":{"label":"Lưu chuyển tiền tệ ròng từ các hoạt động sản xuất kinh doanh","section":"cashflow","y":[["2018",-10.568],["2019",-2.288],["2020",-8.762],["2021",15.716]],"published":"2022-03-31"},"cfa26":{"label":"Lưu chuyển tiền thuần từ hoạt động đầu tư","section":"cashflow","y":[["2018",4.968],["2019",3.294],["2020",10.908],["2021",-8.7