5],["2025-Q4",22.341],["2026-Q2",20.415]],"y":[["2019",35.437],["2020",40.445],["2021",25.808],["2022",16.178],["2023",18.67],["2024",25.415],["2025",22.341]]}},"co":{"short":"Trường Sơn 532","profile":"Công ty Cổ phần Trường Sơn 532 (TS3) có tiền thân là Xí nghiệp Cung ứng Vật tư - Vận tải 532, được thành lập vào năm 1989. Công ty hoạt động trong lĩnh vực xây dựng các công trình giao thông, thủy lợi và các công trình dân dụng khác. Công ty đã thi công xây dựng các công trình tiêu biểu như Thi công thảm bê tông công trình Cầu Rồng, Kè bờ tây sông Hàn tại Đà Nẵng, Đập thủy lợi EAHRE tại Gia Lai, Đường cao tốc Đà Nẵng - Quảng Ngãi. Bên cạnh đó, Công ty còn sản xuất nguyên vật liệu đá xây dựng tại 02 trạm trộn bê tông với tổng công suất 200 tấn/h. TS3 được giao dịch trên thị trường UPCOM từ tháng 01/2018.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2018-01-19","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Xây Dựng Trường Sơn","p":null,"t":"CORPORATE","q":2639224,"pct":68.52,"d":"2026-08-06"},{"n":"Cao Thị Thu Thủy","p":null,"t":"INDIVIDUAL","q":426800,"pct":11.08,"d":"2026-08-04"},{"n":"Ngô Văn Hoàn","p":null,"t":"INDIVIDUAL","q":36100,"pct":0.94,"d":"2025-10-05"},{"n":"Phạm Phú Đại","p":null,"t":"INDIVIDUAL","q":16110,"pct":0.42,"d":"2025-10-05"},{"n":"Vũ Đức Dũng","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":13000,"pct":0.34,"d":"2026-08-06"},{"n":"Phạm Văn Sơn","p":null,"t":"INDIVIDUAL","q":9100,"pct":0.24,"d":"2025-10-05"},{"n":"Trần Văn Hùng","p":"Phó Giám đốc","t":"INDIVIDUAL","q":9100,"pct":0.24,"d":"2026-08-06"},{"n":"Trần Văn Hiếu","p":null,"t":"INDIVIDUAL","q":7600,"pct":0.19,"d":"2025-10-05"},{"n":"Lê Minh Hoàng","p":null,"t":"INDIVIDUAL","q":5500,"pct":0.14,"d":"2025-10-05"},{"n":"Hoàng Việt Dũng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.13,"d":"2025-10-05"},{"n":"Trần Đức Tú","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5000,"pct":0.13,"d"