nh công ty cổ phần từ tháng 11/2015. VSM đang khai thác cho thuê 4 kho bãi với tổng diện tích 46.000m2 and a capacity of 3.000 Teus. Ngoài ra, Công ty còn làm đại lý cho các hãng tàu lớn của thế giới như Evergreen Việt Nam, “K” Line Việt Nam… và có quan hệ hợp đồng với nhiều hãng tàu khác có mặt tại Việt Nam. VSM được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2017.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2017-07-17","state":0.0,"foreign":0.01422759,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Container Việt Nam","p":null,"t":"CORPORATE","q":1982500,"pct":65.0,"d":"2025-11-17"},{"n":"Công ty Cổ phần Đầu Tư Sao Á D.C","p":null,"t":"CORPORATE","q":133300,"pct":4.37,"d":"2025-10-05"},{"n":"Ngô Quốc Vũ","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":64080,"pct":1.273,"d":"2026-08-20"},{"n":"Hoàng Thị Hà","p":null,"t":"INDIVIDUAL","q":26200,"pct":0.86,"d":"2025-10-05"},{"n":"Đặng Trần Gia Thoại","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":41580,"pct":0.826,"d":"2026-08-20"},{"n":"Nguyễn Văn Thương","p":null,"t":"INDIVIDUAL","q":25520,"pct":0.761,"d":"2025-10-05"},{"n":"Bùi Ngọc Xuân","p":null,"t":"INDIVIDUAL","q":19200,"pct":0.63,"d":"2025-10-05"},{"n":"Trần Xuân Bạo","p":null,"t":"INDIVIDUAL","q":9000,"pct":0.295,"d":"2025-10-05"},{"n":"Hồ Khả Quốc","p":"Phó Giám đốc","t":"INDIVIDUAL","q":11880,"pct":0.24,"d":"2026-08-20"},{"n":"Nguyễn Trinh Thục","p":"Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":9900,"pct":0.2,"d":"2026-08-20"},{"n":"Trần Thị Phước","p":"Kế toán trưởng/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":9900,"pct":0.197,"d":"2026-08-20"},{"n":"Lê Thế Trung","p":null,"t":"INDIVIDUAL","q":6600,"pct":0.131,"d":"2026-04-02"},{"n":"Trương Lý Thế Anh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":3300,"pct":0.066,"d":"2026-08-20"}],"rel":[{"c":"VICONSHIPQN","n":"Công ty CP Container Qui Nhơn","t":"s