0/11/2003. Công ty hoạt động chính trong lĩnh vực sản xuất và kinh doanh điện. Hiện công ty đang quản lý và vận hành nhà máy Thủy điện Đrây H’Linh 2 tại Đăk Lăk, sản xuất điện thương phẩm để cung cấp trực tiếp và duy nhất cho Tổng Công ty Điện lực miền Trung (CPC). Địa bàn kinh doanh của công ty bao gồm hai tỉnh Đăk Nông và Đăk Lăk. DRL chính thức được giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2012.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2012-04-11","state":0.30421053,"foreign":0.02749789,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công Ty Điện Lực Miền Trung","p":null,"t":"CORPORATE","q":2890000,"pct":30.42,"d":"2026-09-03"},{"n":"Trần Thừa Hàng","p":null,"t":"INDIVIDUAL","q":200900,"pct":2.115,"d":"2015-09-14"},{"n":"Nguyễn Xuân Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":40090,"pct":0.42,"d":"2026-09-03"},{"n":"Phạm Thị Bích Nhung","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.42,"d":"2026-09-03"},{"n":"Nguyễn Thành Vinh","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.316,"d":"2015-09-14"},{"n":"Tăng Tấn Ngân","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.211,"d":"2015-09-14"},{"n":"Trần Kỳ Hải","p":null,"t":"INDIVIDUAL","q":13100,"pct":0.14,"d":"2026-01-28"},{"n":"Trần Cao Hớn","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.126,"d":"2015-09-14"},{"n":"Nguyễn Thành","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":10000,"pct":0.11,"d":"2026-09-03"},{"n":"Hoàng Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":9000,"pct":0.09,"d":"2026-01-28"},{"n":"Võ Đình Thanh Tuấn","p":"Phó Giám đốc","t":"INDIVIDUAL","q":650,"pct":0.01,"d":"2026-09-03"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 3 2025 - 1,500 VND","d":"2026-07-10","record":"2026-07-23","ex":"2026-07-22"},{"c":"AGME","t":"DRL - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-06","record":"2026-05-25","ex":"2026-05-22"},{"c":"DDIND","t":"Nguyễn Xuân Dũng - Đăng kí Bán 31,500 DRL",