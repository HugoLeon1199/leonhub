ch nhà xưởng 16.556 m2. Các nhà máy đều nằm tại trung tâm vùng nguyên liệu nên SJ1 chủ động được nguồn nguyên liệu chất lượng cao và đạt tiêu chuẩn xuất khẩu. Thị trường xuất khẩu là thị trường chính đối với công ty. Sản phẩm của công ty hiện đã được xuất khẩu sang các thị trường Châu Âu, Nhật Bản, Hàn Quốc, Mỹ, Úc, UAE… Ngày 08/06/2009, SJ1 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2006-12-29","state":0.05399831,"foreign":0.00043986,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Phát triển Hùng Hậu","p":null,"t":"CORPORATE","q":24089632,"pct":55.41,"d":"2026-06-12"},{"n":"Trường Đại Học Văn Hiến","p":null,"t":"CORPORATE","q":3782782,"pct":8.7,"d":"2026-06-12"},{"n":"Công ty TNHH Khởi Nghiệp Heritage","p":null,"t":"CORPORATE","q":2570663,"pct":5.913,"d":"2026-06-12"},{"n":"Tổng Công ty Thủy sản Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":2347453,"pct":5.4,"d":"2026-06-12"},{"n":"Nguyễn Thị Ngọc Châu","p":null,"t":"INDIVIDUAL","q":279450,"pct":3.609,"d":"2015-09-14"},{"n":"Đặng Đức Thành","p":null,"t":"INDIVIDUAL","q":201220,"pct":2.598,"d":"2015-09-14"},{"n":"Nguyễn Thị Kim Mị","p":null,"t":"INDIVIDUAL","q":1034788,"pct":2.38,"d":"2026-08-28"},{"n":"Nguyễn Thị Thanh Thúy","p":null,"t":"INDIVIDUAL","q":100000,"pct":1.291,"d":"2015-09-14"},{"n":"Vũ Quang Chính","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":319653,"pct":0.74,"d":"2026-08-28"},{"n":"Huỳnh Thanh","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":294124,"pct":0.677,"d":"2026-08-28"},{"n":"Trần Thị Hà","p":null,"t":"INDIVIDUAL","q":11000,"pct":0.142,"d":"2015-09-14"},{"n":"Nguyễn Thanh Hà","p":null,"t":"INDIVIDUAL","q":7770,"pct":0.1,"d":"2015-09-14"},{"n":"Nguyễn Tấn Phúc","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.085,"d":"2026-08-28"},{"n":"Nguyễn Ngọc Trung","p":null,"t":"INDIVIDUAL","q":3950,"pct":0.051,"d":"2015-09-14"},{"n":"Trần Xuân Hương"