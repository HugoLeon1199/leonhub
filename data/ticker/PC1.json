khai nhiều dự án EPC với vai trò nhà tổng thầu và nhà phụ thầu như (i) EPC - đường điện 110KV Bắc Giang - Quảng Châu, (ii) EPC - đường điện 500KV Nhà Bè - Metro City. Ngày 16/11/2016, công ty chính thức được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-11-16","state":0.0,"foreign":0.08326859,"rating":"O-PF","target":24700.0,"rating_as_of":"2026-07-21","source":"Vietcap"},"owners":[{"n":"Trịnh Văn Tuấn","p":null,"t":"INDIVIDUAL","q":87942639,"pct":21.382,"d":"2026-08-12"},{"n":"Công ty TNHH MTV Quản Lý Quỹ Ngân Hàng Thương Mại Cổ phần Công Thương Việt Nam","p":null,"t":"CORPORATE","q":31000000,"pct":7.54,"d":"2026-07-15"},{"n":"Công ty TNHH Thương mại Đầu tư CII","p":null,"t":"CORPORATE","q":29630000,"pct":7.2,"d":"2026-09-03"},{"n":"Công ty Cổ phần Đầu tư Hạ tầng Kỹ thuật Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":23008100,"pct":5.59,"d":"2026-08-18"},{"n":"Công ty Cổ phần Chứng khoán VIX","p":null,"t":"CORPORATE","q":17700000,"pct":4.95,"d":"2025-10-05"},{"n":"Phan Ngọc Hiếu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":9200000,"pct":2.24,"d":"2026-08-12"},{"n":"Võ Hồng Quang","p":null,"t":"INDIVIDUAL","q":7747613,"pct":1.884,"d":"2026-08-12"},{"n":"Lê Thị Thoi","p":null,"t":"INDIVIDUAL","q":7737688,"pct":1.881,"d":"2026-08-12"},{"n":"Trịnh Khánh Linh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4000000,"pct":0.973,"d":"2026-08-18"},{"n":"Nguyễn Minh Đệ","p":null,"t":"INDIVIDUAL","q":3795538,"pct":0.923,"d":"2026-08-12"},{"n":"Nguyễn Nhật Tân","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1857106,"pct":0.452,"d":"2026-08-12"},{"n":"Quỹ Đầu tư Lợi Thế Cạnh Tranh Bền Vững SSI","p":null,"t":"CORPORATE","q":601042,"pct":0.377,"d":"2020-07-14"},{"n":"Vũ Ánh Dương","p":null,"t":"INDIVIDUAL","q":1187220,"pct":0.289,"d":"2026-08-12"},{"n":"Đặng Quốc Tưởng","p":null,"t":"INDIVIDUAL","q":818709,"pct":0.199,"d":"2026-08-18"},{"n":"Trần Thị Minh Việt","p":null,"t":"