t khẩu. Ngày 15/02/2012, AMC chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2012-02-15","state":0.40000094,"foreign":0.02222227,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty TNHH Một Thành Viên Tổng Công Ty Hợp Tác Kinh Tế","p":null,"t":"CORPORATE","q":1140000,"pct":40.0,"d":"2026-01-12"},{"n":"Hoàng Trọng Diên","p":null,"t":"INDIVIDUAL","q":465000,"pct":16.3,"d":"2025-10-05"},{"n":"Lê Xuân Nghĩa","p":null,"t":"INDIVIDUAL","q":125600,"pct":4.41,"d":"2025-10-05"},{"n":"Nguyễn Thị Ngân","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":96100,"pct":3.37,"d":"2025-10-05"},{"n":"Lê Đình Danh","p":null,"t":"INDIVIDUAL","q":61000,"pct":2.14,"d":"2025-10-05"},{"n":"Lê Văn Chiến","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":29000,"pct":1.0,"d":"2025-10-05"},{"n":"Lê Mạnh Hùng","p":null,"t":"INDIVIDUAL","q":13200,"pct":0.463,"d":"2025-10-05"},{"n":"Nguyễn Thành Hưng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":15000,"pct":0.35,"d":"2026-08-24"},{"n":"Đinh Xuân Tự","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.28,"d":"2025-10-05"},{"n":"Lê Đình Hùng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.18,"d":"2025-10-05"},{"n":"Nguyễn Trung Thành","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.175,"d":"2025-10-05"},{"n":"Nguyễn Văn Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":7500,"pct":0.17,"d":"2026-08-24"},{"n":"Hồ Thị Thủy Cương","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.035,"d":"2025-10-05"},{"n":"Nguyễn Văn Chương","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.035,"d":"2025-10-05"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 900 VND","d":"2026-06-16","record":"2026-07-03","ex":"2026-07-02"},{"c":"AGME","t":"AMC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-04","record":"2026-03-25","ex":"2026-03-24"},{"c":"AIS","t":"AMC - Niêm yết bổ sung 1.424.990 cổ phiếu","d":"2026-01-27","record":null,"ex":nu