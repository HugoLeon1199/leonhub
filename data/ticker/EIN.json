ịch Điện lực và Khách sạn Du lịch Điện lực Vũng Tàu. Bên cạnh đó, Công ty còn cung cấp dịch vụ lữ hành và kinh doanh thương mại xuất nhập khẩu. Năm 2017, EIN chính thức được giao dịch trên thị trường UPCOM.","sector":"Du lịch và Giải trí","type":"CT","listed":"2017-03-16","state":0.0,"foreign":0.0003462,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Công Nghệ Và Thiết Bị Điện Hà Nội","p":null,"t":"CORPORATE","q":15000000,"pct":33.034,"d":"2026-08-19"},{"n":"Công ty Cổ phần Giải pháp Đầu tư Thái Sơn","p":null,"t":"CORPORATE","q":9121764,"pct":20.29,"d":"2026-01-05"}],"rel":[{"c":"0312347663","n":"Công ty Cổ phần Thương Mại Dịch Vụ Xuất Nhập Khẩu Và Du Lịch Cuộc Sống Việt","t":"subsidiary","pct":100.0}],"rel_count":1,"events":[{"c":"AGME","t":"EIN - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-05","record":"2026-05-26","ex":"2026-05-25"},{"c":"AGME","t":"EIN - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-16","record":"2025-05-09","ex":"2025-05-08"},{"c":"AGME","t":"EIN - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-05-14","record":"2024-05-28","ex":"2024-05-27"},{"c":"AGME","t":"EIN - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-05-10","record":"2023-05-30","ex":"2023-05-29"},{"c":"DDINS","t":"Công ty Cổ phần Giải pháp Đầu tư Thái Sơn - Đăng kí Bán EIN","d":"2022-10-27","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Giải pháp Đầu tư Thái Sơn - Đăng kí Mua EIN","d":"2022-10-27","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ","d":"2022-07-08","record":null,"ex":null},{"c":"AGME","t":"EIN - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-05-16","record":"2022-05-30","ex":"2022-05-27"},{"c":"ISS","t":"Phát hành cổ phiếu - Quyền mua CP cho Cổ đông hiện hữu tỉ lệ 150.0%","d":"2021-04-23","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Duy Tân - Đăng kí Mua EIN","d":"2021-03-16","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Duy Tân - Đăng kí Bán EIN","d":"2021-03-16","record":null,"e