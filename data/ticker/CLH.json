ỏ đá vôi và đất sét và (ii) giao thông vận tải công nghiệp (vận tải hàng hóa). Sản phẩm của công ty chủ yếu được tiêu thụ ở miền Bắc, đặc biệt là các tỉnh Lạng Sơn, Thái Nguyên, Bắc Kạn, Cao Bằng, Công ty đã tham gia phục vụ nhiều dự án có quy mô lớn bao gồm Dự án Nhà máy nhiệt điện Na Dương, Nhà máy Xi măng Quán Triều, Nhà máy Xi măng Tân Quang. CLH được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2016.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-06-07","state":0.51383,"foreign":0.058625,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Công nghiệp mỏ Việt Bắc TKV - Công ty Cổ phần","p":null,"t":"CORPORATE","q":6165960,"pct":51.383,"d":"2026-07-30"},{"n":"Nguyễn Thị Thanh Hà","p":null,"t":"INDIVIDUAL","q":220740,"pct":1.84,"d":"2026-07-30"},{"n":"Lê Quang Bình","p":null,"t":"INDIVIDUAL","q":62400,"pct":0.52,"d":"2026-07-30"},{"n":"Bùi Minh Tuấn","p":null,"t":"INDIVIDUAL","q":50400,"pct":0.42,"d":"2026-07-30"},{"n":"Nguyễn Xuân Hậu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":28720,"pct":0.24,"d":"2026-07-30"},{"n":"Nguyễn Thanh Trường","p":"Phó Giám đốc","t":"INDIVIDUAL","q":10800,"pct":0.09,"d":"2026-07-30"},{"n":"Phạm Trung Hợp","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":8880,"pct":0.074,"d":"2026-07-30"},{"n":"Trần Quang Khải","p":"Thành viên Hội đồng Quản trị/Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":4920,"pct":0.04,"d":"2026-07-30"},{"n":"Lê Xuân Tình","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3800,"pct":0.032,"d":"2026-07-30"},{"n":"Nguyễn Sóng Gió","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1800,"pct":0.015,"d":"2026-07-30"},{"n":"Tống Thanh Sơn","p":null,"t":"INDIVIDUAL","q":360,"pct":0.003,"d":"2025-10-05"},{"n":"Phạm Mạnh Tiến","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":20,"pct":0.0,"d":"2026-07-30"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 20