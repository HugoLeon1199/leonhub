trên vốn chủ sở hữu (ROE) ở mức 9.48%, tăng 0.55%. BAB được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ tháng 03/2021.","sector":"Ngân hàng","type":"NH","listed":"2017-12-28","state":0.0,"foreign":0.00011645,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Thái Hương","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":46637001,"pct":4.35,"d":"2026-07-31"},{"n":"Nguyễn Trọng Trung","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":38426491,"pct":3.584,"d":"2026-07-31"},{"n":"Trần Thị Thoảng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":33317322,"pct":3.108,"d":"2026-07-31"},{"n":"Nguyễn Văn Danh","p":null,"t":"INDIVIDUAL","q":31725075,"pct":2.959,"d":"2026-07-31"},{"n":"Hoàng Ngọc Hòa","p":null,"t":"INDIVIDUAL","q":27147144,"pct":2.532,"d":"2026-07-31"},{"n":"Nguyễn Đình Sơn","p":null,"t":"INDIVIDUAL","q":27150636,"pct":2.532,"d":"2026-04-23"},{"n":"Nguyễn Tất Huy","p":null,"t":"INDIVIDUAL","q":24043146,"pct":2.243,"d":"2026-04-23"},{"n":"Nguyễn Hữu Nguyên","p":null,"t":"INDIVIDUAL","q":21628946,"pct":2.017,"d":"2026-04-23"},{"n":"Nguyễn Thị Hồng","p":null,"t":"INDIVIDUAL","q":18513385,"pct":1.727,"d":"2026-04-23"},{"n":"Nguyễn Hồng Tiến","p":null,"t":"INDIVIDUAL","q":18158732,"pct":1.694,"d":"2026-07-31"},{"n":"Trần Thị Lý","p":null,"t":"INDIVIDUAL","q":16661320,"pct":1.554,"d":"2026-04-23"},{"n":"Cao Hoài Đức","p":null,"t":"INDIVIDUAL","q":16575119,"pct":1.546,"d":"2026-04-23"},{"n":"Nguyễn Duy Hưng","p":null,"t":"INDIVIDUAL","q":16434673,"pct":1.533,"d":"2026-04-23"},{"n":"Thái Doãn Năm","p":null,"t":"INDIVIDUAL","q":16093404,"pct":1.501,"d":"2026-04-23"},{"n":"Đào Đình Phát","p":null,"t":"INDIVIDUAL","q":15445109,"pct":1.441,"d":"2026-07-31"},{"n":"Thái Thị Nhung","p":null,"t":"INDIVIDUAL","q":15272648,"pct":1.425,"d":"2026-04-23"},{"n":"Thái Đình Bảy","p":null,"t":"INDIVIDUAL","q":15168717,"pct":1.415,"d":"2026-04-23"},{"n":"Thái Thị Hoa","p":null,"t":"INDIVIDUAL","q":14810798,"p