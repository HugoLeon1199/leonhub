hất. MWG đồng thời phát triển các mô hình bán lẻ chuyên biệt như TopZone – chuỗi APR/AAR của Apple tại Việt Nam – cùng hệ sinh thái dịch vụ hậu mãi và giải pháp công nghệ nội bộ. Doanh nghiệp được ghi nhận trong nhiều bảng xếp hạng khu vực và quốc tế liên quan đến quy mô hoạt động, quản trị doanh nghiệp, phát triển bền vững và thương hiệu. MWG niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 07/2014.","sector":"Bán lẻ","type":"CT","listed":"2014-07-14","state":0.0,"foreign":0.49,"rating":"BUY","target":140000.0,"rating_as_of":"2026-08-17","source":"Vietcap"},"owners":[{"n":"Công ty TNHH Tư Vấn Đầu Tư Thế Giới Bán Lẻ","p":null,"t":"CORPORATE","q":153425288,"pct":10.439,"d":"2026-08-03"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":29262420,"pct":4.964,"d":"2026-05-07"},{"n":"Arisaig Asia Fund Limited","p":null,"t":"CORPORATE","q":50461588,"pct":3.45,"d":"2025-10-05"},{"n":"Nguyễn Đức Tài","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":33439892,"pct":2.264,"d":"2026-08-17"},{"n":"Đinh Anh Huân","p":null,"t":"INDIVIDUAL","q":3108121,"pct":2.225,"d":"2015-09-14"},{"n":"Công ty TNHH Tư Vấn Đầu Tư Trần Huy","p":null,"t":"CORPORATE","q":32269518,"pct":2.2,"d":"2025-10-05"},{"n":"Arisaig Global Emerging Markets Fund Pte. Ltd","p":null,"t":"CORPORATE","q":15712600,"pct":1.074,"d":"2025-10-05"},{"n":"Hanoi Investments Holdings Limited","p":null,"t":"CORPORATE","q":14344500,"pct":0.977,"d":"2026-05-07"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":11614100,"pct":0.791,"d":"2026-05-07"},{"n":"Trần Huy Thanh Tùng","p":null,"t":"INDIVIDUAL","q":11130544,"pct":0.753,"d":"2025-10-05"},{"n":"Vietnam Holding Ltd","p":null,"t":"CORPORATE","q":2332948,"pct":0.515,"d":"2020-07-14"},{"n":"Robert Alan Willett","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":6922424,"pct":0.471,"d":"2026-08-03"},{"n":"Mercer Qif Fund Public Limited Company","p":null,"t":"CORPORATE","q":6779096,"pct":0.464,"d":"2025-10-