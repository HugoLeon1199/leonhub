ện Phả Lại (PPC) có tiền thân là Nhà máy Nhiệt điện Phả Lại được thành lập vào năm 1982. Công ty hoạt động chính trong lĩnh vực sản xuất và kinh doanh điện năng. Từ năm 2006, PPC chuyển sang hoạt động theo mô hình cổ phần. Công ty hiện đang quản lý vận hành 02 Nhà máy nhiệt điện, gồm 06 tổ máy có tổng công suất phát điện là 1.040 MW. Mổi năm, PPC sản xuất và cung cấp cho hệ thống điện lưới quốc gia khoảng 6 tỷ KWh. PPC được giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 01/2007.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2007-01-26","state":0.51022921,"foreign":0.04414335,"rating":"O-PF","target":11000.0,"rating_as_of":"2025-12-10","source":"Vietcap"},"owners":[{"n":"Tổng Công ty Phát điện 2 - Công ty Cổ phần","p":null,"t":"CORPORATE","q":166391896,"pct":51.0,"d":"2026-08-19"},{"n":"Công ty TNHH Năng Lượng Ree","p":null,"t":"CORPORATE","q":64494960,"pct":20.11,"d":"2026-02-06"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":16024630,"pct":4.99,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán OCBS","p":null,"t":"CORPORATE","q":323406,"pct":0.099,"d":"2015-06-15"},{"n":"Quỹ Đầu tư Cổ phiếu Techcom","p":null,"t":"CORPORATE","q":179880,"pct":0.056,"d":"2020-07-14"},{"n":"Nguyễn Khắc Sơn","p":null,"t":"INDIVIDUAL","q":107310,"pct":0.034,"d":"2015-09-14"},{"n":"Phạm Kim Lâm","p":null,"t":"INDIVIDUAL","q":105840,"pct":0.033,"d":"2025-10-05"},{"n":"Phạm Văn Thư","p":null,"t":"INDIVIDUAL","q":90050,"pct":0.028,"d":"2025-10-05"},{"n":"Nguyễn Văn Tuấn","p":null,"t":"INDIVIDUAL","q":75810,"pct":0.023,"d":"2025-10-05"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":62730,"pct":0.02,"d":"2025-10-05"},{"n":"Vũ Xuân Cường","p":null,"t":"INDIVIDUAL","q":30350,"pct":0.01,"d":"2015-09-14"},{"n":"Công ty TNHH Quản lý Quỹ Bảo Việt","p":null,"t":"CORPORATE","q":21700,"pct":0.007,"d":"2015-06-15"},{"n":"Đinh Thị Thảo","p":null,"t":"INDIVIDUAL","q":21705