g số 5 được thành lập năm 1973. Công ty được cổ phần hóa năm 2004. Vốn điều lệ hiện nay là 50 tỷ đồng. Là thành viên của Tổng Công ty Vinaconex, công ty hoạt động chủ yếu trong lĩnh vực xây dựng các công trình dân dụng, công nghiệp, thuỷ lợi và kinh doanh bất động sản. Qua nhiều năm hoạt động trong lĩnh vực xây lắp, công ty đã trở thành đối tác tin cậy và tín nhiệm của các nhà thầu trong và ngoài nước như Tập đoàn Sumitomo, Tập đoàn Taisei, nhà thầu HISG. Công ty chủ yếu hoạt động ở trong nước và dự định sẽ triển khai các dự án tại Lào và các nước khu vực Đông Nam Á.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-01-16","state":0.0,"foreign":0.012708,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ngô Hải An","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1006159,"pct":20.12,"d":"2025-10-05"},{"n":"Hồ Trung Đông","p":null,"t":"INDIVIDUAL","q":454900,"pct":9.1,"d":"2025-10-05"},{"n":"Phạm Thị Quỳnh Hương","p":null,"t":"INDIVIDUAL","q":250000,"pct":5.0,"d":"2025-10-05"},{"n":"Triệu Hồng Tuyến","p":null,"t":"INDIVIDUAL","q":53800,"pct":1.08,"d":"2025-10-05"},{"n":"Trần Duy Báu","p":null,"t":"INDIVIDUAL","q":43750,"pct":0.875,"d":"2015-09-14"},{"n":"Mai Văn Dinh","p":null,"t":"INDIVIDUAL","q":26619,"pct":0.532,"d":"2015-09-14"},{"n":"CÔNG TY TNHH BẤT ĐỘNG SẢN MEDIA MARKET","p":null,"t":"CORPORATE","q":20600,"pct":0.41,"d":"2025-10-05"},{"n":"Trần Thọ","p":null,"t":"INDIVIDUAL","q":18006,"pct":0.36,"d":"2015-09-14"},{"n":"Trần Đức Cung","p":null,"t":"INDIVIDUAL","q":11050,"pct":0.221,"d":"2015-09-14"},{"n":"Trịnh Viết Kiệm","p":null,"t":"INDIVIDUAL","q":8500,"pct":0.17,"d":"2015-09-14"},{"n":"Lê Thị Thể","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.14,"d":"2015-09-14"},{"n":"Mai Văn Sơn","p":null,"t":"INDIVIDUAL","q":5500,"pct":0.11,"d":"2025-10-05"},{"n":"Lê Thanh Giêng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.1,"d":"2015-09-14"},{"n":"Tống Văn Minh","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.04,"d":"2015-09-14"},