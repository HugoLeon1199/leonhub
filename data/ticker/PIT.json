âu Âu. Sở hữu Nhà máy Sơn Petrolimex có công suất trên 16 triệu lít/năm, được xây dựng tại KCN Việt Nam - Singapore II (VSIP II), tỉnh Bình Dương trên diện tích đất 1,2ha, cam kết cho ra đời những dòng sản phẩm sơn chất lượng cao, an toàn sinh thái, thân thiện với môi trường (ecodigital). Ngày 24/01/2008, PIT chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bán lẻ","type":"CT","listed":"2008-01-24","state":0.52670763,"foreign":0.00499929,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV - Tổng Công ty Xây Lắp Và Thương Mại Petrolimex","p":null,"t":"CORPORATE","q":8005611,"pct":52.67,"d":"2026-08-28"},{"n":"Công ty TNHH Giải Pháp Công Nghệ Logigo","p":null,"t":"CORPORATE","q":1508100,"pct":10.61,"d":"2025-10-05"},{"n":"Quỹ Đầu Tư Chứng Khoán Bảo Việt","p":null,"t":"CORPORATE","q":518000,"pct":3.408,"d":"2015-06-15"},{"n":"Lê Thúy Đào","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":381500,"pct":2.51,"d":"2026-03-11"},{"n":"Hà Huy Thắng","p":null,"t":"INDIVIDUAL","q":327455,"pct":2.11,"d":"2025-10-05"},{"n":"Trần Minh Huỳnh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":199217,"pct":1.4,"d":"2026-06-04"},{"n":"Mai Văn Bình","p":null,"t":"INDIVIDUAL","q":134724,"pct":0.89,"d":"2025-10-05"},{"n":"Phạm Văn Nam","p":null,"t":"INDIVIDUAL","q":39639,"pct":0.279,"d":"2015-09-14"},{"n":"Công ty Cổ phần Thuận Phú","p":null,"t":"CORPORATE","q":33000,"pct":0.217,"d":"2015-06-15"},{"n":"Văn Tuấn Anh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6463,"pct":0.043,"d":"2026-03-11"},{"n":"Trần Thị Hồng Nga","p":null,"t":"INDIVIDUAL","q":5250,"pct":0.034,"d":"2025-10-05"},{"n":"Trần Thị Lan","p":null,"t":"INDIVIDUAL","q":4006,"pct":0.026,"d":"2025-10-05"},{"n":"Mai Viết Sinh","p":null,"t":"INDIVIDUAL","q":2304,"pct":0.016,"d":"2015-09-14"},{"n":"Trần Viết Bính","p":null,"t":"INDIVIDUAL","q":2200,"pct":0.015,"