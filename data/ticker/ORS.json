,15.115],["2020",14.033],["2021",17.596],["2022",21.556],["2023",17.597],["2024",13.091],["2025",7.191]]}},"co":{"short":"Chứng khoán Tiên Phong","profile":"Công ty Cổ phần Chứng khoán Tiên Phong (ORS) có tiền thân là Công ty Cổ phần Chứng khoán Phương Đông được thành năm 2006. Công ty hoạt động chủ yếu trong lĩnh vực môi giới chứng khoán, tự doanh chứng khoán, tư vấn đầu tư và lưu ký chứng khoán. Trong đó hoạt động môi giới chứng khoán là một trong những nghiệp vụ chủ lực của Công ty. Công ty có thị trường phân phối rộng khắp cả nước. Năm 2025, Doanh thu nghiệp vụ môi giới chứng khoán có giá trị bằng 60,54 tỷ đồng, giảm 1.27% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 18.79%. Lợi nhuận trước thuế có giá trị bằng 14,.51 tỷ đồng. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 2.05%, giảm 9.69%. ORS chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ Ngày 04/11/2021.","sector":"Dịch vụ tài chính","type":"CK","listed":"2010-07-12","state":0.0,"foreign":0.00124652,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ngân hàng Thương mại Cổ phần Tiên Phong","p":null,"t":"CORPORATE","q":318204761,"pct":51.0,"d":"2026-08-12"},{"n":"Nguyễn Thị Vân Anh","p":null,"t":"INDIVIDUAL","q":15137550,"pct":5.05,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu Tư Tp Việt Nam","p":null,"t":"CORPORATE","q":12595296,"pct":2.019,"d":"2026-02-05"},{"n":"Trần Thị Hải Yến","p":null,"t":"INDIVIDUAL","q":375000,"pct":1.562,"d":"2015-09-14"},{"n":"Nguyễn Thị Thanh Hà","p":null,"t":"INDIVIDUAL","q":41000,"pct":0.171,"d":"2021-11-15"},{"n":"Vũ Hồng Hạnh","p":null,"t":"INDIVIDUAL","q":20300,"pct":0.085,"d":"2015-09-14"},{"n":"Nguyễn Thị Khánh Hòa","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.05,"d":"2025-10-05"},{"n":"Tạ Quang Lương","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.03,"d":"2025-10-05"},{"n":"Nguyễn Trát Minh Phương","p":null,"t":"INDIVIDUAL","q":56000,"pct":0.017,"d":"2025-10-05"},{"n":"Trương Thị Hoàng Lan","p":null,"t":"I