7.624],["2021",5.544],["2022",9.3],["2023",4.749],["2024",7.291],["2025",39.427]]}},"co":{"short":"Thương mại và Dịch vụ LVA","profile":"Công ty Cổ phần Thương mại và Dịch vụ LVA (LBE) được thành lập trên cơ sở cổ phần hóa Công ty Sách và Thiết bị Trường học Long An năm 2004. Lĩnh vực kinh doanh chính của công ty là sản xuất, cung ứng mỹ phẩm, dụng cụ y tế, và vật phẩm. Từ năm 2024, LBE chính thức đẩy mạnh sang lĩnh vực cung ứng mỹ phẩm ra thị trường.. Các sản phẩm của công ty chủ yếu được nhập khẩu từ Hàn Quốc, bảo đảm tiêu chuẩn về chất lượng và nguồn gốc xuất xứ. Công ty chú trọng duy trì quy trình kiểm soát chất lượng nhằm đáp ứng yêu cầu của thị trường trong nước. Ngày 22/02/2008, LBE chính thức giao dịch trên Sở Giao dịch chứng khoán Hà Nội (HNX).","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2008-02-22","state":0.0,"foreign":0.02960349,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":252000,"pct":22.909,"d":"2015-06-15"},{"n":"Dương Vinh Quang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":600000,"pct":19.35,"d":"2026-04-17"},{"n":"Đường Quang Huấn","p":null,"t":"INDIVIDUAL","q":575066,"pct":18.55,"d":"2026-02-23"},{"n":"Lê Vân Anh","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":522685,"pct":10.88,"d":"2026-08-19"},{"n":"Nguyễn Thị Mai Lan","p":null,"t":"INDIVIDUAL","q":119400,"pct":10.85,"d":"2023-03-06"},{"n":"Đào Thị Kim Oanh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":226100,"pct":7.294,"d":"2026-03-05"},{"n":"Trương Thanh Minh","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":222827,"pct":7.188,"d":"2026-03-05"},{"n":"Nguyễn Hoàng Yến Nhi","p":null,"t":"INDIVIDUAL","q":212000,"pct":6.839,"d":"2025-12-30"},{"n":"Nguyễn Thanh Thảo","p":null,"t":"INDIVIDUAL","q":154000,"pct":4.97,"d":"2026-02-23"},{"n":"Nguyễn Nhật Minh Triều","p":null,"t":"