n phối bao bì PP lớn nhất cho các công ty xuất nhập khẩu gạo tại cảng Sài Gòn. Công suất sản xuất hàng năm bình quân 8.000 tấn thành phẩm mỗi năm. Ngày 28/11/2007, TPC chính thức giao dịch trên Sở Giao dịch Chứng khoán Thàng phố Hồ Chí Minh (HOSE).","sector":"Hóa chất","type":"CT","listed":"2007-11-28","state":0.0,"foreign":0.0230245,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Thị Mỹ Hạnh","p":null,"t":"INDIVIDUAL","q":3382590,"pct":13.85,"d":"2026-08-18"},{"n":"Phạm Trung Cang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3223220,"pct":13.19,"d":"2026-08-19"},{"n":"Lương Phú Minh","p":null,"t":"INDIVIDUAL","q":1960600,"pct":11.66,"d":"2026-06-19"},{"n":"Trần Thị Hoa","p":null,"t":"INDIVIDUAL","q":1557900,"pct":9.26,"d":"2026-06-23"},{"n":"Công ty TNHH Đại Hưng","p":null,"t":"CORPORATE","q":727800,"pct":4.33,"d":"2026-06-19"},{"n":"Mekong Enterprise Fund","p":null,"t":"CORPORATE","q":973040,"pct":3.983,"d":"2015-06-15"},{"n":"Đỗ Thị Quế Thanh","p":null,"t":"INDIVIDUAL","q":960000,"pct":3.93,"d":"2026-08-19"},{"n":"Phạm Đỗ Diễm Hương","p":null,"t":"INDIVIDUAL","q":896700,"pct":3.67,"d":"2026-08-19"},{"n":"Phạm Đỗ Quế Hương","p":null,"t":"INDIVIDUAL","q":720000,"pct":2.95,"d":"2026-08-19"},{"n":"Tôn Thị Hồng Minh","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":704000,"pct":2.88,"d":"2026-08-19"},{"n":"Công ty TNHH Quế Trân","p":null,"t":"CORPORATE","q":352936,"pct":2.1,"d":"2026-06-17"},{"n":"Nguyễn Thị Thanh Loan","p":null,"t":"INDIVIDUAL","q":177160,"pct":0.73,"d":"2025-10-05"},{"n":"Phạm Văn Mẹo","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":55000,"pct":0.23,"d":"2026-08-19"},{"n":"Trần Ngọc Thanh Hùng","p":null,"t":"INDIVIDUAL","q":48000,"pct":0.226,"d":"2015-09-14"},{"n":"Lê Thị Mỹ Ngọc","p":null,"t":"INDIVIDUAL","q":39276,"pct":0.185,"d":"2015-09-14"},{"n":"Nguyễn Văn Hòa","p":null,"t":"INDIVIDUAL","q":24000,"pct":0.113,"d":"2015-09-14"},{"n":"Lâm Nguyễn Q