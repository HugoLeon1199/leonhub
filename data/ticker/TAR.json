n tại, TAR đang là đơn vị quảng lý quỹ đất trồng lúa sạch lớn nhất Việt Nam, năng suất lúa bình quân đạt mức 9 tấn/ha/vụ. Công ty đã xây dựng mạng lưới phân phối sản phẩm trên toàn thế giới.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2019-02-20","state":0.0,"foreign":0.0001906,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phạm Thái Bình","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":11000000,"pct":14.0,"d":"2026-08-03"},{"n":"Nguyễn Lê Bảo Trang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1128300,"pct":1.44,"d":"2026-07-17"},{"n":"Lư Lệ Trân","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":726,"pct":0.001,"d":"2026-02-25"},{"n":"Phạm Tam Tiến","p":null,"t":"INDIVIDUAL","q":726,"pct":0.001,"d":"2025-10-05"}],"rel":[{"c":"TRUAKIGIA","n":"Công ty Cổ phần Nông Nghiệp Công Nghệ Cao Trung An Kiên Giang","t":"subsidiary","pct":67.14},{"c":"NOVATECHTH","n":"Công ty TNHH Novatech Trung Hưng","t":"affiliate","pct":40.0},{"c":"GAOVD","n":"Công ty TNHH Sản Xuất Chế Biến Kinh Doanh Xuất Khẩu Gạo Việt Đức","t":"affiliate","pct":39.0}],"rel_count":3,"events":[{"c":"AGME","t":"TAR - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-05","record":"2026-05-25","ex":"2026-05-22"},{"c":"OTHE","t":"TAR - Thay đổi địa chỉ","d":"2025-08-14","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Lê Bảo Trang - Đăng kí Mua 1,200,000 TAR","d":"2025-08-12","record":null,"ex":null},{"c":"AGME","t":"TAR - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-05-05","record":"2025-05-23","ex":"2025-05-22"},{"c":"MOVE","t":"TAR - Chuyển sàn từ HNX sang UPCoM","d":"2024-05-27","record":null,"ex":null},{"c":"AGME","t":"TAR - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-05-07","record":"2024-05-24","ex":"2024-05-23"},{"c":"SUSP","t":"TAR - Hủy niêm yết cổ phiếu trên sàn HNX","d":"2024-04-25","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 10.0%","d":"2023-07-05","record":null,"ex":null