 (TOW) được thành lập trên cơ sở sáp nhập trên cơ sở hợp nhất Công ty Cổ phần Cấp nước Trà Nóc và Công ty Cổ phần Cấp nước Ô Môn vào năm 2017. Công ty hoạt động chính trong lĩnh vực sản xuất và kinh doanh nước sạch. TOW trở thành công ty đại chúng từ tháng 10/2017. Công ty hiện đang quản lý vận hành 04 nhà máy nước sạch với tổng công suất thiết kế 25.660 m3/ngày. TOW cung cấp nước sạch cho Khu công nghiệp Trà Nóc 1 và 2, địa bàn quận Ô Môn, các phường Trà Nóc và Thới An Đông thuộc quận Bình Thủy, quận Ô Môn, huyện Thới Lai và huyện Cờ Đỏ. Ngày 25/01/2019, TOW chính thức được giao dịch trên thị trường UPCoM.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2019-01-25","state":0.0,"foreign":0.0996597,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Cấp thoát nước Cần Thơ","p":null,"t":"CORPORATE","q":5219524,"pct":65.42,"d":"2026-08-11"},{"n":"Hồ Thị Quý Mão","p":null,"t":"INDIVIDUAL","q":406258,"pct":5.092,"d":"2026-08-11"},{"n":"Lâm Nguyệt Thanh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":187200,"pct":2.35,"d":"2026-08-11"},{"n":"Nguyễn Thị Nguyệt Quế","p":null,"t":"INDIVIDUAL","q":55466,"pct":0.695,"d":"2026-08-11"},{"n":"Hoàng Văn Khiêm","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":54280,"pct":0.68,"d":"2026-08-11"},{"n":"Huỳnh Minh Trung","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":39561,"pct":0.5,"d":"2026-08-11"},{"n":"Lê Thị Thanh Phượng","p":"Kế toán trưởng","t":"INDIVIDUAL","q":37307,"pct":0.468,"d":"2026-08-11"},{"n":"Trịnh Công Đoàn","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":21537,"pct":0.27,"d":"2026-08-11"},{"n":"Thái Minh Lực","p":"Phó Giám đốc","t":"INDIVIDUAL","q":11766,"pct":0.147,"d":"2026-08-11"},{"n":"Võ Anh Tuấn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":8181,"pct":0.103,"d":"2026-08-11"},{"n":"Trần Minh Nhựt","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1860,"pc