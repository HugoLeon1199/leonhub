iêng), mua bán vật tư nông nghiệp (phân bón, thuốc bảo vệ thực vật), kinh doanh bất động sản và đầu tư khu công nghiệp. CPA được giao dịch trên thị trường UPCOM từ cuối năm 2019.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2019-12-30","state":0.20187058,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thị Thúy Hằng","p":null,"t":"INDIVIDUAL","q":5883370,"pct":24.9,"d":"2025-10-05"},{"n":"Nguyễn Trần Xuân Mai","p":null,"t":"INDIVIDUAL","q":5883370,"pct":24.9,"d":"2025-10-05"},{"n":"Ủy Ban Nhân Dân Tỉnh Đắk Lắk","p":null,"t":"CORPORATE","q":4769796,"pct":20.19,"d":"2025-10-10"},{"n":"Trương Quang Tuấn","p":null,"t":"INDIVIDUAL","q":53701,"pct":0.39,"d":"2025-10-05"},{"n":"Phan Viết Lâm","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":39251,"pct":0.29,"d":"2025-10-05"},{"n":"Dương Kim Nhung","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":32686,"pct":0.138,"d":"2026-02-27"},{"n":"Phan Khắc Lăng","p":null,"t":"INDIVIDUAL","q":7686,"pct":0.06,"d":"2025-10-05"},{"n":"Lê Văn Khuân","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":11426,"pct":0.048,"d":"2026-02-27"},{"n":"Hồ Sỹ Trung","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2037,"pct":0.009,"d":"2026-02-27"}],"events":[{"c":"AGME","t":"CPA - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-21","record":"2026-05-08","ex":"2026-05-07"},{"c":"AGME","t":"CPA - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-28","record":"2025-04-14","ex":"2025-04-11"},{"c":"AGME","t":"CPA - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-13","record":"2024-03-29","ex":"2024-03-28"},{"c":"EGME","t":"CPA - Tổ chức ĐHĐCĐ bất thường 2023","d":"2023-10-26","record":"2023-11-10","ex":"2023-11-09"},{"c":"AGME","t":"CPA - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-03-14","record":"2023-03-24","ex":"2023-03-23"},{"c":"DDINS","t":"Công ty Cổ phần Thực phẩm Dinh dưỡng NutiFood - Đăng kí Bán 18,267,808 CPA","d":"2023-0