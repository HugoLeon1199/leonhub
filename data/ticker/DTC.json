ức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-25","state":0.26988,"foreign":0.0144789,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Viglacera Hạ Long","p":null,"t":"CORPORATE","q":4000000,"pct":40.0,"d":"2026-08-24"},{"n":"Đào Bá Dong","p":null,"t":"INDIVIDUAL","q":899402,"pct":8.994,"d":"2026-08-24"},{"n":"Nguyễn Xuân Sơn","p":null,"t":"INDIVIDUAL","q":897000,"pct":8.97,"d":"2026-08-24"},{"n":"Phạm Thị Thu","p":null,"t":"INDIVIDUAL","q":897100,"pct":8.97,"d":"2026-08-24"},{"n":"Vũ Đức Tỵ","p":null,"t":"INDIVIDUAL","q":515040,"pct":5.15,"d":"2026-08-24"},{"n":"Trần Hồng Quang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":450000,"pct":4.5,"d":"2026-08-24"},{"n":"Ngô Thanh Tùng","p":null,"t":"INDIVIDUAL","q":156000,"pct":1.56,"d":"2026-05-06"},{"n":"Nguyễn Văn Sinh","p":null,"t":"INDIVIDUAL","q":38510,"pct":0.963,"d":"2015-09-14"},{"n":"Phạm Phùng Dương","p":null,"t":"INDIVIDUAL","q":60000,"pct":0.6,"d":"2026-05-06"},{"n":"Phan Thị Tới","p":null,"t":"INDIVIDUAL","q":14280,"pct":0.357,"d":"2015-09-14"},{"n":"Trần Duy Hưng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":30000,"pct":0.3,"d":"2026-08-24"},{"n":"Nguyễn Thị Bích Hạnh","p":null,"t":"INDIVIDUAL","q":11800,"pct":0.295,"d":"2015-09-14"},{"n":"Nguyễn Thanh Sơn","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":13880,"pct":0.139,"d":"2026-08-24"},{"n":"Luyện Công Minh","p":null,"t":"INDIVIDUAL","q":4460,"pct":0.112,"d":"2015-09-14"},{"n":"Vương Văn Sáng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.1,"d":"2025-10-05"},{"n":"Lưu Văn Hưng","p":null,"t":"INDIVIDUAL","q":1800,"pct":0.045,"d":"2015-09-14"},{"n":"Vũ Thị Lê","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.025,"d":"2015-09-14"},{"n":"Phạm Văn Hùng","p":null,"t":"INDIVIDUAL","q":930,"pct":0.023,"d":"2015-09-14"},{"n":"Nguyễn Hữu Dũng","p":null,"t":"INDIVIDUAL","q":520,"pct":0.013,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"D