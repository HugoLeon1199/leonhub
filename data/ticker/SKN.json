20",0.0],["2021",3.014],["2022",4.902],["2023",4.565],["2024",7.249],["2025",7.423]]}},"co":{"short":"NGK Sanna Khánh Hòa","profile":"Công ty Cổ phần Nước giải khát Sanna Khánh Hòa (SKN) có tiền thân là Nhà máy Nước khoáng Thiên nhiên Yến sào Khánh Hòa được thành lập vào năm 2007. Công ty hoạt động trong lĩnh vực sản xuất và kinh doanh nước giải khát, nước khoáng và các sản phẩm khác mang thương hiệu Sanna. SKN chính thức hoạt động theo mô hình công ty cổ phần từ năm 2017. Công ty đã phát triển được hệ thống phân phối bán hàng với hơn 1.000 nhà phân phối và đại lý tại 63 tỉnh thành trong cả nước. SKN được giao dịch trên thị trường UPCOM từ tháng 10/2018.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2018-10-10","state":0.51,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Nhà nước MTV Yến Sào Khánh Hòa","p":null,"t":"CORPORATE","q":2550000,"pct":51.0,"d":"2026-03-06"},{"n":"Công Ty Cổ Phần Nhựa Ninh Thuận","p":null,"t":"CORPORATE","q":622455,"pct":12.45,"d":"2026-03-06"},{"n":"Công ty TNHH Sản Xuất - Thương Mại - Dịch Vụ Minh Thông","p":null,"t":"CORPORATE","q":350000,"pct":7.0,"d":"2026-03-06"},{"n":"Lê Thị Hồng Vân","p":null,"t":"INDIVIDUAL","q":101768,"pct":2.04,"d":"2025-10-05"},{"n":"Hoàng Kim Nam","p":null,"t":"INDIVIDUAL","q":44545,"pct":0.89,"d":"2025-10-05"},{"n":"Công ty Cổ phần Dịch vụ Văn hóa và Quảng Cáo Khánh Hòa","p":null,"t":"CORPORATE","q":35000,"pct":0.7,"d":"2025-10-05"},{"n":"Nguyễn Văn Hùng","p":null,"t":"INDIVIDUAL","q":19562,"pct":0.39,"d":"2026-03-06"},{"n":"Nguyễn Khoa Bảo","p":null,"t":"INDIVIDUAL","q":9712,"pct":0.192,"d":"2025-10-05"},{"n":"Nguyễn Khoa Bảo","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":9712,"pct":0.192,"d":"2021-09-07"},{"n":"Nguyễn Thanh Hải","p":null,"t":"INDIVIDUAL","q":8560,"pct":0.17,"d":"2025-10-05"},{"n":"Nguyễn Thị Hạnh Quyên","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.16,"d":"2026-03-06"},{"n":"Nguyễn Văn Lành","p":null,"t":"INDIVIDUAL