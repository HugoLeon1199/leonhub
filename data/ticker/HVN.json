t Nam (HVN) có tiền thân là Cục Hàng không dân dụng, được thành lập vào tháng 01/1956. Hoạt động sản xuất chính của Tổng Công ty là cung cấp dịch vụ vận tải hàng không. Vietnam Airlines chính thức hoạt động theo mô hình công ty cổ phần từ năm 2015. HVN là một trong các doanh nghiệp hàng không có quy mô khai thác lớn tại Việt Nam, sở hữu đội bay hơn 100 tàu bay và mạng bay phủ rộng tại thị trường nội địa cùng nhiều tuyến quốc tế trọng điểm như Đông Bắc Á, châu Âu và Úc. Năm 2025, doanh nghiệp vận chuyển khoảng 25,6 triệu lượt khách và hơn 344 nghìn tấn hàng hóa, với hệ số sử dụng ghế duy trì quanh 82%. HVN được Niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 04/2019.","sector":"Du lịch và Giải trí","type":"CT","listed":"2017-01-03","state":0.86418029,"foreign":0.08542651,"rating":"O-PF","target":37100.0,"rating_as_of":"2025-07-22","source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":1466527123,"pct":47.13,"d":"2026-05-11"},{"n":"Bộ Tài Chính","p":null,"t":"CORPORATE","q":1222368291,"pct":39.29,"d":"2026-05-11"},{"n":"Ana Holdings Inc.","p":null,"t":"CORPORATE","q":175014530,"pct":5.62,"d":"2026-06-11"},{"n":"Ngân hàng Thương mại Cổ phần Ngoại thương Việt Nam","p":null,"t":"CORPORATE","q":23153852,"pct":1.044,"d":"2025-10-05"},{"n":"Công Đoàn Tổng Công ty Hàng Không Việt Nam","p":null,"t":"CORPORATE","q":1814592,"pct":0.058,"d":"2025-10-05"},{"n":"Quỹ Đầu tư Cổ phiếu Manulife","p":null,"t":"CORPORATE","q":39001,"pct":0.003,"d":"2020-07-14"},{"n":"LÊ HỒNG HÀ","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":27469,"pct":0.001,"d":"2025-10-05"},{"n":"Lê Trường Giang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":26764,"pct":0.001,"d":"2025-10-05"},{"n":"Nguyễn Chiến Thắng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":20168,"pct":0.001,"d":"2025-10-05"},{"n":"Nguyễn Thế Bảo","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":38068,"pct":0.001,"d