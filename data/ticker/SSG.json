],["2022",93.721],["2023",8.722],["2024",-1.485],["2025",-2.739]]}},"co":{"short":"Vận tải Biển Hải Âu","profile":"Công ty Cổ phần Vận tải Biển Hải Âu (SSG) được thành lập vào năm 2000. Hoạt động kinh doanh chính của Công ty là kinh doanh vận tải hàng khô. Hiện nay công ty sở hữu 01 tàu có trọng tải trên 13.316 tấn, tuổi tàu bình quân 12 tuổi. Hiện nay ở Việt Nam có hơn 370 doanh nghiệp đăng ký kinh doanh hoạt động trong lĩnh vực dịch vụ hàng hải và khoảng hơn 500 doanh nghiệp cung cấp dịch vụ đại lý vận tải và giao nhận hàng hóa trong đó có khoảng 20 công ty liên doanh với nước ngoài. Công ty có cổ đông chiến lược có tiềm lực tài chính mạnh đó là Tổng Công ty Hàng Hải Việt Nam, Tập đoàn Bảo Việt... được hỗ trợ về vốn, chiến lược kinh doanh và khách hàng. Việt Nam là một trong những nước có bờ biển dài, có nhiều cảng nước sâu so với các nước trong khu vực và có khả năng là nước trung chuyển hàng hóa cho các nước Lào, Campuchia... là những nước không có bờ biển, hoặc cảng biển không phát triển. Ngày 03/06/2015, SSG chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2011-01-05","state":0.0,"foreign":0.0005,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bùi Việt Hoài","p":null,"t":"INDIVIDUAL","q":1323000,"pct":26.56,"d":"2015-09-14"},{"n":"Trương Quang Long Triều","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1218310,"pct":24.37,"d":"2026-08-14"},{"n":"Bùi Tuấn Anh","p":null,"t":"INDIVIDUAL","q":823000,"pct":16.52,"d":"2025-10-05"},{"n":"Nguyễn Thị Hoàng Oanh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":538150,"pct":15.0,"d":"2026-08-14"},{"n":"Trương Quang Anh Nguyên","p":null,"t":"INDIVIDUAL","q":500000,"pct":10.04,"d":"2026-08-14"},{"n":"Tổng công ty Bảo Việt Nhân thọ","p":null,"t":"CORPORATE","q":441000,"pct":8.82,"d":"2025-10-05"},{"n":"Công ty Cổ phần Quản lý Quỹ Tín Phát","p":null,"t":"CORPORATE","q":440900,"pct":8.818,"d":"2020-05-07"},{"n":"Nguyễn Hữ