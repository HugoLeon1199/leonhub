21",10.515],["2022",10.447],["2023",13.173],["2024",9.544],["2025",7.348]]}},"co":{"short":"Thương mại Hóc Môn","profile":"Công ty Cổ phần Thương mại Hóc Môn (HTC), tiền thân là Xí nghiệp Đại lý Cung ứng Vật tư Tổng hợp Huyện Hóc Môn được thành lập năm 1979. Năm 2001 công ty chuyển sang hoạt động theo mô hình công ty cổ phần. Hoạt động kinh doanh chính của công ty là kinh doanh xăng dầu với mạng lưới bán lẻ gồm 13 cửa hàng xăng dầu trực thuộc và 16 đại lý bán lẻ xăng dầu. Công ty đang quản lý và kinh doanh Chợ đầu mối nông sản Thực phẩm Hóc Môn là 1 trong 3 chợ đầu mối của thành phố. Ngoài ra, Công ty quản lý và khai thác lò giết mổ gia súc trung tâm với diện tích 6.500 m2, với quy trình giết mổ treo công suất 1.000 con/ngày đảm bảo đúng quy trình và vệ sinh an toàn thực phẩm. Ngày 07/05/2010, HTC chính thức giao dịch trên Sở giao dịch chứng khoán Hà Nội (HNX)","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2010-05-07","state":0.23857283,"foreign":0.00048182,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Bến Thành - TNHH MTV","p":null,"t":"CORPORATE","q":3936450,"pct":23.86,"d":"2026-08-27"},{"n":"Công ty TNHH Đầu Tư Và Thương Mại Thiên Hải","p":null,"t":"CORPORATE","q":2805100,"pct":17.0,"d":"2026-08-27"},{"n":"Lê Văn Mỵ","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1683090,"pct":10.2,"d":"2026-08-27"},{"n":"Công ty Xăng Dầu Khu Vực II","p":null,"t":"CORPORATE","q":1575000,"pct":9.55,"d":"2026-08-27"},{"n":"Lê Anh Phương","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":436065,"pct":2.64,"d":"2026-08-27"},{"n":"Lê Thụy Mỵ Châu","p":null,"t":"INDIVIDUAL","q":300000,"pct":1.82,"d":"2026-08-27"},{"n":"Phan Bạch Ngọc","p":null,"t":"INDIVIDUAL","q":187500,"pct":1.14,"d":"2026-08-27"},{"n":"Lê Phan Trung Hiếu","p":null,"t":"INDIVIDUAL","q":180000,"pct":1.09,"d":"2026-08-27"},{"n":"Nguyễn Ngọc Thảo","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":155355,"pct":0.94,"d":"2026-08