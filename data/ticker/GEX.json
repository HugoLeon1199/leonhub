hần Tập đoàn Gelex (GEX) là doanh nghiệp hàng đầu của Việt Nam trong lĩnh vực chế tạo Thiết bị đo điện. Các hoạt động chính của Gelex bao gồm: (i) sản xuất thiết bị điện, (ii) xây dựng và lắp đặt máy biến áp điện áp cao, (iii) kinh doanh bất động sản. Năm 2010 Gelex được cổ phần hóa và chính thức hoạt động theo mô hình công ty cổ phần. Gelex sở hữu các thương hiệu có uy tín như GELEX, CADIVI, THIBIDI, HEM, VIHEM, VINAKIP. Gelex đã xây dựng được một mạng lưới khách hàng rộng lớn bao gồm các tập đoàn lớn như: EVN, PetroVietnam, Vinacomin, Vicem, VNSteel, Vinaconex. GEX chính thức được giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ Ngày 18/01/2018.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2015-10-26","state":0.0,"foreign":0.06356306,"rating":"BUY","target":40500.0,"rating_as_of":"2026-07-06","source":"Vietcap"},"owners":[{"n":"Nguyễn Văn Tuấn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":309183198,"pct":23.63,"d":"2026-08-03"},{"n":"Đào Thị Lơ","p":null,"t":"INDIVIDUAL","q":57228596,"pct":4.374,"d":"2026-08-03"},{"n":"Công ty Cổ phần Chứng khoán VIX","p":null,"t":"CORPORATE","q":30000000,"pct":3.52,"d":"2025-10-05"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":16082385,"pct":1.889,"d":"2025-10-05"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":12531883,"pct":1.472,"d":"2025-10-05"},{"n":"Wareham Group Limited","p":null,"t":"CORPORATE","q":9473100,"pct":1.113,"d":"2025-10-05"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":6300000,"pct":0.74,"d":"2025-10-05"},{"n":"Grinling International Limited","p":null,"t":"CORPORATE","q":4270000,"pct":0.502,"d":"2025-10-05"},{"n":"Lương Thanh Tùng","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3873240,"pct":0.3,"d":"2026-08-03"},{"n":"Nguyễn Trọng Hiền","p":null,"t":"INDIVIDUAL","q":2671200,"pct":0.3,"d":"2026-08-03"},{"n":"Võ Anh Linh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1600000,"pct":0.2,"d":"2021-