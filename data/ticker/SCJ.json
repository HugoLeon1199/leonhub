0% clinker và 90% sản lượng xi măng được tiêu thụ tại thị trường Hà Nội. Ngày 27/05/2019, SCJ chính thức được giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2007-09-19","state":0.0,"foreign":0.00115403,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Sỹ Tiệp","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":44180951,"pct":76.386,"d":"2026-02-27"},{"n":"Công ty Cổ Phần Xi Măng Hoàng Long","p":null,"t":"CORPORATE","q":4806647,"pct":8.3,"d":"2026-02-27"},{"n":"Dương Thị Minh","p":null,"t":"INDIVIDUAL","q":1500000,"pct":7.686,"d":"2015-09-14"},{"n":"Phạm Tiến Hiếu","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":797200,"pct":1.378,"d":"2026-02-27"},{"n":"Hoàng Thị Long","p":null,"t":"INDIVIDUAL","q":731330,"pct":1.264,"d":"2026-02-27"},{"n":"Công ty Cổ phần Chứng Khoán VPS","p":null,"t":"CORPORATE","q":129930,"pct":0.666,"d":"2015-06-15"},{"n":"Nguyễn Hữu Năng","p":null,"t":"INDIVIDUAL","q":62813,"pct":0.322,"d":"2015-09-14"},{"n":"Nguyễn Hữu Dương","p":null,"t":"INDIVIDUAL","q":59163,"pct":0.303,"d":"2015-09-14"},{"n":"Nguyễn Duy Quý","p":null,"t":"INDIVIDUAL","q":50886,"pct":0.261,"d":"2015-09-14"},{"n":"Ngô Thành Đồng","p":null,"t":"INDIVIDUAL","q":39213,"pct":0.201,"d":"2015-09-14"},{"n":"Nguyễn Đình Hoàn","p":null,"t":"INDIVIDUAL","q":29084,"pct":0.149,"d":"2015-09-14"},{"n":"Phan Quỳnh Anh","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.005,"d":"2015-09-14"},{"n":"Nguyễn Hữu Hưng","p":null,"t":"INDIVIDUAL","q":800,"pct":0.004,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"SCJ - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-03","record":"2026-03-19","ex":"2026-03-18"},{"c":"AGME","t":"SCJ - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-28","record":"2025-03-18","ex":"2025-03-17"},{"c":"AGME","t":"SCJ - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-02-29","record":"2024-03-14","ex":"2024-03-13"},{"c":"AGME","t":"SCJ - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-03-14","record":"2023-03