a Trang, Công trình Phổ Yên - Thái Nguyên, Công trình 389 Đê La Thành... Ngày 28/12/2007, VC7 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2007-12-28","state":0.0,"foreign":0.00057278,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Hoàng Trọng Đức","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":38638236,"pct":40.21,"d":"2026-06-30"},{"n":"Nguyễn Ngọc Tài","p":null,"t":"INDIVIDUAL","q":8894412,"pct":9.256,"d":"2025-10-05"},{"n":"Nguyễn Đức Hùng","p":"Phó Tổng Giám đốc/Giám đốc Tài chính","t":"INDIVIDUAL","q":6443156,"pct":6.705,"d":"2026-06-30"},{"n":"Vương Thị Minh Huế","p":null,"t":"INDIVIDUAL","q":1602717,"pct":6.67,"d":"2025-10-05"},{"n":"Lê Anh Tuấn","p":null,"t":"INDIVIDUAL","q":1309919,"pct":5.45,"d":"2025-10-05"},{"n":"Nguyễn Thị Hoài Thu","p":null,"t":"INDIVIDUAL","q":2363088,"pct":4.92,"d":"2025-10-05"},{"n":"Nguyễn Trọng Tấn","p":null,"t":"INDIVIDUAL","q":528812,"pct":4.81,"d":"2025-10-05"},{"n":"Nguyễn Tự Lực","p":null,"t":"INDIVIDUAL","q":574894,"pct":2.39,"d":"2025-10-05"},{"n":"Nguyễn Văn Thanh","p":null,"t":"INDIVIDUAL","q":502403,"pct":2.09,"d":"2025-10-05"},{"n":"Nguyễn Thị Thúy Hồng","p":null,"t":"INDIVIDUAL","q":61000,"pct":0.813,"d":"2025-10-05"},{"n":"Nguyễn Xuân Thu","p":null,"t":"INDIVIDUAL","q":66866,"pct":0.61,"d":"2025-10-05"},{"n":"Nguyễn Đình Thiết","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.38,"d":"2025-10-05"},{"n":"Nguyễn Văn Khắc","p":null,"t":"INDIVIDUAL","q":19342,"pct":0.258,"d":"2015-09-14"},{"n":"Nguyễn Tuấn Dũng","p":null,"t":"INDIVIDUAL","q":22515,"pct":0.2,"d":"2025-10-05"},{"n":"Hà Anh Tuấn","p":null,"t":"INDIVIDUAL","q":12741,"pct":0.12,"d":"2025-10-05"},{"n":"Đỗ Công Hiển","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.093,"d":"2025-10-05"},{"n":"Nguyễn Đức Toàn","p":null,"t":"INDIVIDUAL","q":21184,"pct":0.088,"d":"2025-10-05"},{"n":"Vũ Viết Độ","p":null,"t":"INDIVIDUAL","q":3200,"pct":0.043,"d":"2025-10-05"},{