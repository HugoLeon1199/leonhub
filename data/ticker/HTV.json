 thuật tốt và đáp ứng nhu cầu vận chuyển của khách hàng. Ngày 07/12/2005, HTV chính thức giao dịch trên sàn giao dịch chứng khoán thành phố Hồ Chí Minh (HOSE).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-01-05","state":0.50079067,"foreign":0.05814736,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Xi măng Việt Nam","p":null,"t":"CORPORATE","q":6562361,"pct":50.08,"d":"2026-03-11"},{"n":"Công ty Cổ phần Xi măng VICEM Hà Tiên","p":null,"t":"CORPORATE","q":1440000,"pct":14.286,"d":"2015-06-15"},{"n":"Nguyễn Quốc Huy","p":null,"t":"INDIVIDUAL","q":1311000,"pct":10.0,"d":"2025-10-05"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":600000,"pct":5.952,"d":"2015-06-15"},{"n":"Tập đoàn Vận tải Quốc tế Halfdan Grieg (Na Uy)","p":null,"t":"CORPORATE","q":504000,"pct":5.0,"d":"2015-06-15"},{"n":"Peter Eric Dennis","p":null,"t":"INDIVIDUAL","q":641364,"pct":4.89,"d":"2025-10-05"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":607500,"pct":4.64,"d":"2025-10-05"},{"n":"Đào Thị Thới","p":null,"t":"INDIVIDUAL","q":600000,"pct":4.58,"d":"2025-10-05"},{"n":"Quách Đình Dương","p":null,"t":"INDIVIDUAL","q":403590,"pct":4.004,"d":"2015-09-14"},{"n":"Nguyễn Thị Hồng Nhung","p":null,"t":"INDIVIDUAL","q":390000,"pct":2.97,"d":"2025-10-05"},{"n":"Công ty Cổ phần Cơ điện Lạnh","p":null,"t":"CORPORATE","q":260000,"pct":2.579,"d":"2015-06-15"},{"n":"Công đoàn Công ty Cổ phần Xi măng Hà Tiên 1","p":null,"t":"CORPORATE","q":56040,"pct":0.556,"d":"2015-06-15"},{"n":"Đỗ Văn Huân","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2600,"pct":0.02,"d":"2026-03-11"}],"rel":[{"c":"12385","n":"Công ty TNHH Đầu Tư Phát Triển Bất Động Sản Trường Thọ Thủ Đức","t":"subsidiary","pct":65.0}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,500 VND","d":"2026-08-20","record":"2026-08-28","ex":"2026-08-27"},{"c":"AGME","t":"HTV - Tổ chức ĐHĐCĐ thường