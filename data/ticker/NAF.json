ds Group đã và đang hợp tác làm việc với bà con nông dân, các hợp tác xã và các đối tác ở cả ba khu vực Bắc, Trung, Nam và một số đối tác lớn tại Lào, Campuchia. Ngày 07/10/2015, NAF chính thức giao dịch trên Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2015-10-07","state":0.0,"foreign":0.08622231,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Mạnh Hùng","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":26467939,"pct":43.26,"d":"2026-08-04"},{"n":"Lê Tuấn Anh","p":null,"t":"INDIVIDUAL","q":814563,"pct":1.33,"d":"2026-03-16"},{"n":"Nguyễn Mạnh Cường","p":"Trưởng phòng","t":"INDIVIDUAL","q":622534,"pct":1.02,"d":"2026-08-04"},{"n":"Nguyễn Khánh Linh","p":null,"t":"INDIVIDUAL","q":500000,"pct":0.82,"d":"2026-03-16"},{"n":"Đặng Thị Khánh Chi","p":null,"t":"INDIVIDUAL","q":500000,"pct":0.82,"d":"2026-03-16"},{"n":"Phạm Duy Thái","p":null,"t":"INDIVIDUAL","q":494276,"pct":0.79,"d":"2025-10-05"},{"n":"Điền Thị Lan Phương","p":null,"t":"INDIVIDUAL","q":442000,"pct":0.79,"d":"2025-10-05"},{"n":"Lê Tuấn","p":null,"t":"INDIVIDUAL","q":407860,"pct":0.62,"d":"2025-10-05"},{"n":"Nguyễn Tiến Chinh","p":null,"t":"INDIVIDUAL","q":332345,"pct":0.49,"d":"2026-02-06"},{"n":"Nguyễn Thị Trang","p":null,"t":"INDIVIDUAL","q":191784,"pct":0.29,"d":"2025-10-05"},{"n":"Ngô Sỹ Mạnh","p":null,"t":"INDIVIDUAL","q":164991,"pct":0.26,"d":"2025-10-05"},{"n":"Hồ Hải Quân","p":null,"t":"INDIVIDUAL","q":97174,"pct":0.15,"d":"2025-10-05"},{"n":"Đặng Thị Thắm","p":null,"t":"INDIVIDUAL","q":39640,"pct":0.06,"d":"2026-08-04"},{"n":"Nguyễn Quốc Huân (Johan Nyvene)","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":25000,"pct":0.04,"d":"2026-08-04"},{"n":"Nguyễn Thị Phương Hồng","p":null,"t":"INDIVIDUAL","q":23632,"pct":0.04,"d":"2025-10-05"}],"rel":[{"c":"5500538998","n":"Công ty CP Nafoods Tây Bắc","t":"subsidiary","pct":99.9},{"c":"2900422657","n":"Công ty Cổ Ph