hơ; 4 kho hàng trực thuộc. PSD đã chính thức trở thành nhà phân phối máy tính xách tay thương hiệu Asus từ năm 2018. Ngày 28/06/2013, PSD chính thức giao dịch trên sàn giao dịch chứng khoán Hà Nội (HNX).","sector":"Bán lẻ","type":"CT","listed":"2013-06-28","state":0.73801877,"foreign":0.00069198,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Dịch vụ Tổng hợp Dầu khí","p":null,"t":"CORPORATE","q":39873600,"pct":76.93,"d":"2026-08-05"},{"n":"Vũ Tiến Dương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1170200,"pct":2.17,"d":"2026-08-05"},{"n":"Phan Hải Âu","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":400000,"pct":0.74,"d":"2026-08-05"},{"n":"Nguyễn Mạnh Lân","p":"Phó Giám đốc","t":"INDIVIDUAL","q":387047,"pct":0.72,"d":"2026-08-05"},{"n":"Nguyễn Văn Nghĩa","p":"Giám đốc Tài chính/Kế toán trưởng","t":"INDIVIDUAL","q":150000,"pct":0.28,"d":"2026-08-05"},{"n":"Tôn Thất Anh Tuấn","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.235,"d":"2015-09-14"},{"n":"Bùi Vũ Quỳnh Như","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":100000,"pct":0.19,"d":"2026-08-05"},{"n":"Lê Minh Kha","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":100000,"pct":0.19,"d":"2026-08-05"},{"n":"Hồ Minh Trí","p":null,"t":"INDIVIDUAL","q":25400,"pct":0.119,"d":"2015-09-14"},{"n":"Trần Quang Huy","p":null,"t":"INDIVIDUAL","q":43800,"pct":0.08,"d":"2026-02-12"},{"n":"Sơn Chí Tân","p":null,"t":"INDIVIDUAL","q":6700,"pct":0.01,"d":"2026-04-17"},{"n":"Nguyễn Thị Linh","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.005,"d":"2025-10-05"}],"rel":[{"c":"3601414843","n":"Công Ty TNHH Một Thành Viên An Lạc Nhơn Trạch","t":"subsidiary","pct":100.0},{"c":"BMEREF","n":"Công ty Cổ Phần Điện Tử Điện Lạnh Bình Minh","t":"subsidiary","pct":92.5},{"c":"0107505589","n":"Công Ty Cổ Phần Đầu Tư Và Thương Mại Số Vietecom","t":"affiliate","pct":20.0},{"c":"GREENIME","n":"Công ty Cổ phần Dược Phẩm Sakae","t":"subsidiary","pct":0.0}],"rel_count":4,"eve