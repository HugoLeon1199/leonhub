],["2021",13.327],["2022",31.152],["2023",12.157],["2024",12.55],["2025",-0.107]]}},"co":{"short":"Thủy sản Minh Hải","profile":"<DIV style=\"FONT-FAMILY: Arial; FONT-SIZE: 10pt;\"> <P>Công ty Cổ phần&nbsp;Chế biến Thủy sản Xuất khẩu Minh Hải (JOS)&nbsp;được thành lập vào năm 1998.&nbsp;Công ty hoạt động chính trong lĩnh vực chế biến thủy sản xuất khẩu và tiêu thụ nội địa. JOS trở thành công ty đại chúng từ năm 2012. Công ty hiện&nbsp;đang quản lý vận hành dây chuyền chế biến thủy sản với công suất 9.000 tấn/năm. Sản phẩm của Công ty&nbsp;được xuất khẩu sang các thị&nbsp;trường&nbsp;chủ yếu như Hàn Quốc, EU, Mỹ, Nhật, Đài Loan, Singapore, Úc.. với các khách hàng truyền thống như Nichirei, Maruha, Hanwa, Mitsubishi, Kailis, Sinhin, Seamark, Sea Port,...JOS được giao dịch trên thị trường UPCOM từ tháng 07/2017. </P></DIV>","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-07-28","state":0.0,"foreign":0.00267054,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Tấn Dương","p":"Phó Giám đốc","t":"INDIVIDUAL","q":2840565,"pct":18.54,"d":"2025-10-27"},{"n":"Nguyễn Phú Dũng","p":"Phó Chủ tịch Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":2802317,"pct":18.29,"d":"2025-10-27"},{"n":"Huỳnh Hải Triều","p":null,"t":"INDIVIDUAL","q":1919115,"pct":12.52,"d":"2025-10-27"},{"n":"Lê Tú Trinh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":613100,"pct":4.001,"d":"2025-10-05"},{"n":"Trần Thị Hân","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":613000,"pct":4.001,"d":"2025-10-05"},{"n":"Hồ Thị Tú Như","p":null,"t":"INDIVIDUAL","q":353265,"pct":2.35,"d":"2025-10-05"}],"rel":[{"c":"KISIMEX","n":"Công ty Cổ Phần Thủy Sản Kiên Giang","t":"affiliate","pct":49.79}],"rel_count":1,"events":[{"c":"AGME","t":"JOS - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-06-16","record":"2025-06-25","ex":"2025-06-24"},{"c":"AGME","t":"JOS - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-05-22","record":"2024-06-04","ex":"2024-06-03"},{"c":"DDRP","t":