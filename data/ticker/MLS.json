anh nghiệp chăn nuôi lợn lớn nhất tỉnh Hà Tĩnh với phương thức sản xuất liên kết với các hộ chăn nuôi trên địa bàn tỉnh. Công ty có công nghệ chăn nuôi được chuyển giao từ Thái Lan, với máy móc thiết bị nhập khẩu từ Tây Ban Nha và phần mềm quản lý Chăn nuôi Pig Chem 4 của Mỹ. MLS được giao dịch trên thị trường UPCOM từ tháng 06/2018.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2016-12-28","state":0.51275,"foreign":0.014625,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Khoáng sản và Thương mại Hà Tĩnh - Công ty Cổ phần","p":null,"t":"CORPORATE","q":2051000,"pct":51.28,"d":"2025-12-09"},{"n":"Lê Văn Nhị","p":null,"t":"INDIVIDUAL","q":24700,"pct":0.62,"d":"2025-10-05"},{"n":"Nguyễn Đình Sơn","p":null,"t":"INDIVIDUAL","q":6800,"pct":0.17,"d":"2025-10-05"},{"n":"Phan Thanh Nam","p":null,"t":"INDIVIDUAL","q":6400,"pct":0.16,"d":"2025-10-05"},{"n":"Võ Văn Lưu","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3800,"pct":0.095,"d":"2026-03-04"},{"n":"Nguyễn Đình Lục","p":"Thành viên Ban kiểm soát/Phó Giám đốc Sản xuất","t":"INDIVIDUAL","q":700,"pct":0.017,"d":"2026-08-24"}],"events":[{"c":"AGME","t":"MLS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-05","record":"2026-05-19","ex":"2026-05-18"},{"c":"AGME","t":"MLS - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-07","record":"2025-03-26","ex":"2025-03-25"},{"c":"AGME","t":"MLS - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-12","record":"2024-03-27","ex":"2024-03-26"},{"c":"AGME","t":"MLS - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-03-14","record":"2023-03-30","ex":"2023-03-29"},{"c":"AGME","t":"MLS - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-25","record":"2022-04-08","ex":"2022-04-07"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2020 - 2,710 VND","d":"2021-10-14","record":"2021-10-21","ex":"2021-10-20"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2020 - 4,000 VND","d":"2021-05-20","record":"2021-06-16","ex":"2021-06-15"},{"c":"AGME","t":"MLS - Tổ 