khai khắp nơi, tại Việt Nam, các quốc gia lân cận cũng như tại các Châu lục khác. Ngày 24/06/2008, ONE chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Công nghệ Thông tin","type":"CT","listed":"2008-06-24","state":0.0,"foreign":0.03898793,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Hải Đoàn","p":null,"t":"INDIVIDUAL","q":495643,"pct":6.28,"d":"2025-12-22"},{"n":"Đặng Anh Phương","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":468023,"pct":5.88,"d":"2026-02-04"},{"n":"Đỗ Thanh Hải","p":null,"t":"INDIVIDUAL","q":392300,"pct":4.97,"d":"2026-02-13"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":391900,"pct":4.96,"d":"2025-10-05"},{"n":"Nguyễn Duy Nguyên","p":null,"t":"INDIVIDUAL","q":380000,"pct":4.81,"d":"2026-03-17"},{"n":"Đinh Ngọc Lân","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":382400,"pct":4.8,"d":"2026-07-09"},{"n":"Cao Tiến Trung","p":null,"t":"INDIVIDUAL","q":374068,"pct":4.7,"d":"2025-10-05"},{"n":"Đặng Lê Hưng","p":null,"t":"INDIVIDUAL","q":261500,"pct":3.29,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Nam","p":null,"t":"INDIVIDUAL","q":210318,"pct":2.64,"d":"2025-10-05"},{"n":"Nguyễn Tiến Thịnh","p":null,"t":"INDIVIDUAL","q":210026,"pct":2.64,"d":"2025-10-05"},{"n":"Đỗ Quỳnh Lan","p":null,"t":"INDIVIDUAL","q":194656,"pct":2.47,"d":"2026-01-12"},{"n":"Nguyễn Hà Thanh","p":null,"t":"INDIVIDUAL","q":189286,"pct":2.38,"d":"2026-07-02"},{"n":"Phạm Thế Hùng","p":null,"t":"INDIVIDUAL","q":180004,"pct":2.28,"d":"2026-01-12"},{"n":"Đinh Quang Thái","p":null,"t":"INDIVIDUAL","q":170350,"pct":2.14,"d":"2026-07-02"},{"n":"Hoàng Hà","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":128903,"pct":1.62,"d":"2026-07-02"},{"n":"Từ Long","p":null,"t":"INDIVIDUAL","q":47500,"pct":0.964,"d":"2015-09-14"},{"n":"Lê Việt Thắng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":68370,"pct":0.86,"d":"2026-03-05"},{"n":"Nguyễn Thị Minh Nguyệt","p":"Kế toá