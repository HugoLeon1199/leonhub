i,…Công ty là nhà cung cấp nguyên liệu hàng đầu của nhiều nhà máy thép lớn như Hòa Phát, Gang thép Thái Nguyên, DONGBU, SAMINA,.. và là đối tác cung cấp than cho các nhà máy nhiệt điện của EVN và PVN. Công ty đã mở rộng thị trường nhập khẩu than cốc, quặng sang Nhật Bản, Thụy Sỹ, Singapore với một số đối tác như: Công ty Daichu Corporation, Công ty Glencore International AG, Công ty Noble Resources International PTE LTD... Cổ phiếu VPG được giao dịch tại Sở Giao dịch Chứng khoán thành phố Hồ Chí Minh (HOSE) từ năm 2018","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2018-01-18","state":0.0,"foreign":0.00334853,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Văn Bình","p":null,"t":"INDIVIDUAL","q":22800880,"pct":25.79,"d":"2026-02-24"},{"n":"Lê Thị Thanh Lệ","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":4002075,"pct":4.53,"d":"2026-02-24"},{"n":"Nguyễn Văn Đức","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":2977157,"pct":3.37,"d":"2026-02-24"},{"n":"Mai Quang Hợp","p":null,"t":"INDIVIDUAL","q":264500,"pct":1.0,"d":"2025-10-05"},{"n":"Ngô Thị Minh Lụa","p":"Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":256443,"pct":0.29,"d":"2026-02-24"},{"n":"Lê Đình Điều","p":null,"t":"INDIVIDUAL","q":110901,"pct":0.13,"d":"2026-02-24"},{"n":"Lương Việt Liên","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.05,"d":"2025-10-05"},{"n":"Nguyễn Thị Giáng Hương","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.05,"d":"2025-10-05"},{"n":"Nguyễn Thị Mai Hoa","p":null,"t":"INDIVIDUAL","q":2961,"pct":0.003,"d":"2026-02-24"}],"rel":[{"c":"2645039","n":"Công ty TNHH XNK Việt Phát","t":"subsidiary","pct":100.0},{"c":"0202177384","n":"Công ty Cổ Phần Đầu Tư Xây Dựng Newland","t":"subsidiary","pct":90.0}],"rel_count":2,"events":[{"c":"AGME","t":"VPG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-13","record":"2026-03-23","ex":"2026-03-20"},{"c":"EGME","t":"VPG - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-06