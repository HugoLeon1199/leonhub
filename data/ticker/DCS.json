],["2021-Q4",-0.204],["2022-Q1",-0.204],["2022-Q2",0.258],["2024-Q4",-0.015],["2025-Q4",43.49],["2026-Q1",13.712]],"y":[["2018",-1.475],["2019",-2.705],["2020",-1.104],["2021",-0.204],["2022",0.0],["2023",0.0],["2024",-0.015],["2025",43.49]]}},"co":{"short":"Tập đoàn EDX","profile":"Công ty Cổ phần Tập đoàn EDX (DCS) được thành lập vào năm 2000. Hoạt động chính của Công ty bao gồm: Sản xuất, kinh doanh đồ gỗ nội thất, kinh doanh mủ cao su và kinh doanh bất động sản. Một số công trình lớn mà DSC thực hiện cung ứng sản phẩm có thể kể đến CIPUTRA – Nam Thăng Long, công trình số 5 Nguyễn Chí Thanh, khu biệt thự Nam Thăng Long, khu biệt thự Linh Đàm, khu biệt thự Định Công,... Ngoài việc được phân phối trong nước, các sản phẩm đồ gỗ của công ty còn xuất khẩu sản phẩm đi các nước như Nhật, Mỹ, Đức, Đài Loan,... Hiện tại, DSC đang sở hữu và vận hành Chung cư căn hộ cao cấp Phú Thượng với tổng diện tích xây dựng là 31.878 m2, tại phường Phú thượng, Tây Hồ, Hà Nội. Ngày 31/05/2019, DCS chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2007-12-17","state":0.0,"foreign":0.00556716,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Đình Hùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2653200,"pct":4.4,"d":"2026-03-04"},{"n":"Nguyễn Kim Tuấn","p":null,"t":"INDIVIDUAL","q":2487500,"pct":4.12,"d":"2025-10-05"},{"n":"Trần Thị Ánh Nguyệt","p":null,"t":"INDIVIDUAL","q":2018669,"pct":3.34,"d":"2025-10-05"},{"n":"Trần Đình Sơn","p":null,"t":"INDIVIDUAL","q":1838000,"pct":3.048,"d":"2015-09-14"},{"n":"Đường Đức Hóa","p":null,"t":"INDIVIDUAL","q":1027991,"pct":1.7,"d":"2025-10-05"},{"n":"Hà Thanh Hải","p":null,"t":"INDIVIDUAL","q":1000000,"pct":1.658,"d":"2015-09-14"},{"n":"Công ty Cổ phần DC Phú Hà","p":null,"t":"CORPORATE","q":500000,"pct":0.829,"d":"2015-06-15"},{"n":"Công ty Cổ phần Quản Lý Quỹ Sài Gòn","p":null,"t":"CORPORATE","q":102000,"pct":0.169,"d":"2015-06-15"},{"n":"Công ty