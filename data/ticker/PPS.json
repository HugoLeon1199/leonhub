g ty Đạm Phú Mỹ. Công ty đã ký được 2 hợp đồng có giá trị lớn gồm: Hợp đồng thực hiện công tác sửa chữa bảo dưỡng thường xuyên của nhà máy nhiệt điện Cà Mau 1&2 và hợp đồng với nhà máy điện Nhơn Trạch 1. Công ty ký hợp đồng dài hạn với nhà thầu phụ OEM và hoạt động với vai trò là tổng thầu, OEM là nhà thầu uy tín trên thế giới. Ngày 07/01/2011, PPS chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2011-01-07","state":0.51,"foreign":0.28701667,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Điện lực Dầu khí Việt Nam - CTCP","p":null,"t":"CORPORATE","q":7650000,"pct":51.0,"d":"2026-08-12"},{"n":"Công ty YTL Power Services SDN.BHD.","p":null,"t":"CORPORATE","q":2700000,"pct":18.0,"d":"2025-12-30"},{"n":"Công ty Cổ phần Megram","p":null,"t":"CORPORATE","q":2181904,"pct":14.546,"d":"2015-06-15"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":1350600,"pct":9.0,"d":"2025-12-30"},{"n":"Công ty TNHH Phát Triển Công Nghệ","p":null,"t":"CORPORATE","q":330000,"pct":2.2,"d":"2015-06-15"},{"n":"Nguyễn Xuân Bính","p":null,"t":"INDIVIDUAL","q":9200,"pct":0.061,"d":"2015-09-14"},{"n":"Nguyễn Anh Tuấn","p":null,"t":"INDIVIDUAL","q":4603,"pct":0.031,"d":"2015-09-14"},{"n":"Phí Anh Đức","p":null,"t":"INDIVIDUAL","q":2900,"pct":0.019,"d":"2015-09-14"},{"n":"Tô Ngọc Tuyết","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.013,"d":"2015-09-14"},{"n":"Lê Văn Tu","p":"Phó Giám đốc","t":"INDIVIDUAL","q":1667,"pct":0.011,"d":"2026-08-12"}],"events":[{"c":"AGME","t":"PPS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-03","record":"2026-03-18","ex":"2026-03-17"},{"c":"EGME","t":"PPS - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-11-20","record":"2025-12-02","ex":"2025-12-01"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 980 VND","d":"2025-10-01","record":"2025-10-08","ex":"2025-10-07"},{"c":"AGME","t":"PPS - Tổ chức ĐHĐCĐ thường niên 2025","d":"202