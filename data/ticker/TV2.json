năm hoạt động trong lĩnh vực khảo sát thiết kế và giám sát xây dựng các công trình nguồn và lưới điện. Nhắc đến TV2, Công ty gắn liền với hàng chục công trình nguồn điện và hàng trăm công trình lưới điện đã được đưa vào vận hành. Các công trình tiêu biểu như: Thủy điện Trị An, Thác Mơ, Cà Mau, Nhơn Trạch, Sơn Mỹ, Đường dây 500kV Phú Mỹ - Nhà Bè - Phú Lâm, 500kV Bắc Nam mạch 1 & 2...Ngày 06/06/2019, TV2 chính thức giao dịch trên Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2009-10-13","state":0.51326855,"foreign":0.06652624,"rating":"O-PF","target":33000.0,"rating_as_of":"2026-07-13","source":"Vietcap"},"owners":[{"n":"Tập đoàn Điện lực Việt Nam","p":null,"t":"CORPORATE","q":34659056,"pct":51.33,"d":"2025-10-05"},{"n":"Trần Thị Lam Phương","p":null,"t":"INDIVIDUAL","q":755248,"pct":1.12,"d":"2026-06-04"},{"n":"Hoàng Thụy Hoài Yến","p":"Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":490776,"pct":0.73,"d":"2026-07-17"},{"n":"Công Đoàn Công ty Cổ Phần Tư Vấn Xây Dựng Điện 2","p":null,"t":"CORPORATE","q":442943,"pct":0.66,"d":"2026-08-04"},{"n":"Nguyễn Thị Hương Giang","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":400193,"pct":0.59,"d":"2026-08-04"},{"n":"Phạm Liên Hải","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":252639,"pct":0.37,"d":"2026-08-04"},{"n":"Nguyễn Chơn Hùng","p":null,"t":"INDIVIDUAL","q":223985,"pct":0.33,"d":"2026-07-01"},{"n":"Nguyễn Mạnh Hùng","p":null,"t":"INDIVIDUAL","q":13200,"pct":0.3,"d":"2015-09-14"},{"n":"Nguyễn Tài Anh","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.182,"d":"2015-09-14"},{"n":"Nguyễn Văn Hậu","p":null,"t":"INDIVIDUAL","q":6200,"pct":0.141,"d":"2015-09-14"},{"n":"Nguyễn Hải Phú","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":63210,"pct":0.09,"d":"2026-08-04"},{"n":"Nguyễn Quốc Long","p":null,"t":"INDIVIDUAL","q":3800,"pct":0.086,"d":"2015-09-14"},{"n":"Nguyễn Trọng Nam","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":57061,"pct":0.08,"d":"2026-08-04"},{"n":"Ho