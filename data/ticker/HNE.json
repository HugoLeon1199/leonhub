iền thân là công ty điện tử hà nội, được thành lập vào năm 1984. Năm 2017, Công ty chính thức hoạt động là Công ty Cổ phần. Vốn điều lệ hiện tại là 1.926 tỷ đồng. Lĩnh vực kinh doanh chủ yếu của Công ty là: Kinh doanh bất động sản; Sản xuất máy vi tính và thiết bị ngoại vi của máy vi tính; Sản xuất linh kiện điện tử... Công ty là nhà phân phối chính thức của Samsung và AOC tại Việt Nam. Với kinh nghiệm hơn 35 năm xây dựng và phát triển, HNE đã trở thành một thương hiệu uy tín hàng đầu trong lĩnh vực công nghệ và đầu tư cơ sở hạ tầng tại Việt Nam. HNE đang đầu tư xây dựng các dự án mới, tiêu biểu là Dự án Khu công viên công nghệ phần mềm tại Tuần Châu - Quảng Ninh, Dự án Tổ hợp khách sạn- Trung tâm thương mại 5 sao tại La Habana, Cuba…","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2020-02-13","state":0.97930633,"foreign":1.817e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Thành Phố Hà Nội","p":null,"t":"CORPORATE","q":188614400,"pct":97.93,"d":"2026-06-08"},{"n":"Nguyễn Minh Trang","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":14200,"pct":0.007,"d":"2022-03-01"},{"n":"BÙI THỊ HẢI YẾN","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":6200,"pct":0.003,"d":"2022-03-01"},{"n":"Đặng Quỳnh Trang","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":5000,"pct":0.003,"d":"2022-03-01"},{"n":"Nguyễn Đình Vinh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3600,"pct":0.002,"d":"2022-03-01"}],"events":[{"c":"SUSP","t":"HNE - Hủy đăng ký giao dịch trên sàn UPCoM","d":"2022-03-22","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2020 - 61 VND","d":"2021-10-14","record":"2021-10-22","ex":"2021-10-21"},{"c":"AGME","t":"HNE - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-05-12","record":"2021-05-31","ex":"2021-05-28"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2019 - 196 VND","d":"2020-09-29","record":"2020-10-05","ex":"2020-10-