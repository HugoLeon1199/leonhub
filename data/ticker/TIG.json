i với các dự án tương tự. Với gần 15 năm kinh nghiệm hoạt động trong lĩnh vực đầu tư bất động sản, hiện TIG đang quản lý, sở hữu và hợp tác đầu tư nhiều dự án bất động sản với quỹ đất hàng trăm héc - ta có vị trí đẹp ở Thủ đô Hà Nội và các địa phương... Ngày 08/10/2010, TIG chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2010-10-08","state":0.0,"foreign":0.10472742,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Phúc Long","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":38110093,"pct":19.68,"d":"2026-08-24"},{"n":"Park Jin Ku","p":null,"t":"INDIVIDUAL","q":17670294,"pct":9.13,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư Xây dựng và Quản lý Kinh doanh Bất động sản Thăng Long","p":null,"t":"CORPORATE","q":4000000,"pct":7.188,"d":"2015-06-15"},{"n":"Công ty Cổ Phần Đầu Tư Tòa Nhà Công Nghệ Xanh Tig - Hde","p":null,"t":"CORPORATE","q":3300000,"pct":5.93,"d":"2015-06-15"},{"n":"Công ty Cổ Phần Đầu Tư Hde Holdings","p":null,"t":"CORPORATE","q":3000000,"pct":5.391,"d":"2015-06-15"},{"n":"Nguyễn Văn Nghĩa","p":null,"t":"INDIVIDUAL","q":9468033,"pct":4.89,"d":"2025-12-30"},{"n":"Hồ Thanh Hương","p":null,"t":"INDIVIDUAL","q":3380248,"pct":1.75,"d":"2026-08-24"},{"n":"Công ty Cổ phần Chứng khoán Đầu tư Tài chính Việt Nam","p":null,"t":"CORPORATE","q":2900000,"pct":1.65,"d":"2025-10-05"},{"n":"Phạm Thị Hồng Nhung","p":null,"t":"INDIVIDUAL","q":800000,"pct":0.413,"d":"2025-10-05"},{"n":"Nguyễn Xuân Biểu","p":null,"t":"INDIVIDUAL","q":150000,"pct":0.27,"d":"2015-09-14"},{"n":"Phạm Quang Tiến","p":null,"t":"INDIVIDUAL","q":150000,"pct":0.27,"d":"2015-09-14"},{"n":"Hồ Ngọc Hải","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":446763,"pct":0.23,"d":"2026-08-24"},{"n":"Nguyễn Thị Minh Châu","p":null,"t":"INDIVIDUAL","q":404185,"pct":0.21,"d":"2026-08-24"},{"n":"Nguyễn Văn Thương","p":null,"t":"INDIVIDUAL","q":404185,"pct":0.21,"d":"2026-08-24"},{"n":