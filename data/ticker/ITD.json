n cung cấp, lắp đặt thiết bị, phần mềm hệ thống trạm thu phí giao thông và lắp đặt hệ thống camera quan sát tại khu vực miền Bắc và miền Nam. Hiện nay, công ty là một trong những công ty hàng đầu trong lĩnh vực cung cấp giải pháp thu phí, hiện đang chiếm hơn 70% thị phần trên cả nước. Công ty đã cung cấp dịch vụ cho những khách hàng lớn như Tổng cục hải quan, Tổng cục thuế - Bộ Tài chính, Ngân hàng TMCP Công thương Việt Nam.","sector":"Công nghệ Thông tin","type":"CT","listed":"2011-12-20","state":0.0,"foreign":0.0455321,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Mai Hoài An","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2171682,"pct":8.3,"d":"2026-07-28"},{"n":"Công ty Cổ Phần Đầu Tư Tánh Linh","p":null,"t":"CORPORATE","q":2031933,"pct":7.76,"d":"2026-06-23"},{"n":"Doãn Thị Bích Ngọc","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1750655,"pct":6.689,"d":"2026-07-10"},{"n":"Nguyễn Đức Thắng","p":null,"t":"INDIVIDUAL","q":1346240,"pct":6.33,"d":"2022-07-28"},{"n":"Mai Minh Tân","p":null,"t":"INDIVIDUAL","q":1367000,"pct":5.22,"d":"2026-07-27"},{"n":"Vietnam Investment Limited","p":null,"t":"CORPORATE","q":625681,"pct":4.899,"d":"2015-06-15"},{"n":"Mai Anh Tuấn","p":null,"t":"INDIVIDUAL","q":618890,"pct":4.214,"d":"2015-09-14"},{"n":"Công ty TNHH Thương Mại Dịch Vụ Kiều Phong","p":null,"t":"CORPORATE","q":999723,"pct":4.09,"d":"2025-10-05"},{"n":"Văn Thu Thủy","p":null,"t":"INDIVIDUAL","q":510730,"pct":3.478,"d":"2015-09-14"},{"n":"Nguyễn Khắc Dụng","p":null,"t":"INDIVIDUAL","q":342681,"pct":2.334,"d":"2015-09-14"},{"n":"Mai Thị Quỳnh Trang","p":null,"t":"INDIVIDUAL","q":504344,"pct":1.927,"d":"2026-02-24"},{"n":"Trần Thanh Nguyên","p":null,"t":"INDIVIDUAL","q":267928,"pct":1.824,"d":"2015-09-14"},{"n":"Nguyễn Vĩnh Thuận","p":null,"t":"INDIVIDUAL","q":270486,"pct":1.11,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Trung","p":null,"t":"INDIVIDUAL","q":284868,"pct":1.09,"d":"2026-07-10"},{"n":"Lâm Thiếu Quân","p":null,"t"