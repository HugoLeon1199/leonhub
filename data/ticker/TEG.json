ịch vụ Nghĩa An - Quảng Ngãi, Dự án Khu đô thị mới An Thịnh 3 và Dự án xây dựng khu nghỉ dưỡng cao cấp Casa Marina Resort. Trong lĩnh vực năng lượng, TEG đã đầu tư và đưa vào vận hành 3 nhà máy điện mặt trời thông qua công ty con, với tổng công suất 357 MWp. TEG được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 12/2017.","sector":"Bất động sản","type":"CT","listed":"2015-12-22","state":0.0,"foreign":0.05170946,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập Đoàn Trường Thành Việt Nam","p":null,"t":"CORPORATE","q":28712094,"pct":23.76,"d":"2026-08-21"},{"n":"Công ty Cổ Phần Đầu Tư Mernus","p":null,"t":"CORPORATE","q":10921062,"pct":9.04,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh Hà","p":null,"t":"INDIVIDUAL","q":8725700,"pct":7.22,"d":"2025-10-05"},{"n":"Sermsang Power Corporation Public Company Limited","p":null,"t":"CORPORATE","q":6041111,"pct":5.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán Sài Gòn - Hà Nội","p":null,"t":"CORPORATE","q":1200000,"pct":3.71,"d":"2025-10-05"},{"n":"Lê Đình Ngọc","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3230702,"pct":2.67,"d":"2025-10-05"},{"n":"Mạc Quang Huy","p":"Thành viên Hội đồng Quản trị/Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":1976065,"pct":1.64,"d":"2025-10-05"},{"n":"Hà Ngọc Minh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":858300,"pct":0.71,"d":"2025-10-05"},{"n":"Nguyễn Diệu Huyền","p":null,"t":"INDIVIDUAL","q":65500,"pct":0.54,"d":"2025-10-05"},{"n":"Hoàng Mạnh Huy","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":474264,"pct":0.39,"d":"2026-07-27"},{"n":"Hoàng Đình Lợi","p":null,"t":"INDIVIDUAL","q":416338,"pct":0.345,"d":"2025-10-05"},{"n":"Đào Xuân Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":229251,"pct":0.19,"d":"2026-07-27"},{"n":"Nguyễn Quang Vinh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":55944,"pct":0.046,"d":"2025-10-05"},{"n":"Đào Xuân Đức","p":"Trưởng Ban kiểm soát","t":"