à ngày càng có xu hướng tăng lên. Công ty hiện có Hệ thống Cáp treo được đầu tư theo công nghệ Châu Âu với 46 cabin chở khách (8 người lớn/cabin), tổng công suất thiết kế 2.400 người/giờ. Năm 2016, TCT niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Du lịch và Giải trí","type":"CT","listed":"2006-12-06","state":0.51001564,"foreign":0.10164138,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Du Lịch - Thương Mại Tây Ninh","p":null,"t":"CORPORATE","q":6522080,"pct":51.0,"d":"2026-07-15"},{"n":"Công ty Bảo Hiểm Nhân Thọ Tây Ninh","p":null,"t":"CORPORATE","q":1200000,"pct":9.384,"d":"2026-07-15"},{"n":"Tập đoàn Bảo Việt","p":null,"t":"CORPORATE","q":845960,"pct":6.62,"d":"2026-07-15"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":590600,"pct":4.62,"d":"2025-10-05"},{"n":"Nguyễn Thái Bình","p":null,"t":"INDIVIDUAL","q":543500,"pct":4.25,"d":"2015-09-14"},{"n":"Lê Hữu Phước","p":null,"t":"INDIVIDUAL","q":271760,"pct":2.125,"d":"2015-09-14"},{"n":"Lê Thanh Sơn","p":null,"t":"INDIVIDUAL","q":2400,"pct":0.019,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"TCT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-08","record":"2026-05-26","ex":"2026-05-25"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 500 VND","d":"2025-10-10","record":"2025-10-21","ex":"2025-10-20"},{"c":"OTHE","t":"TCT - Thay đổi địa chỉ","d":"2025-08-21","record":null,"ex":null},{"c":"AGME","t":"TCT - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-22","record":"2025-05-06","ex":"2025-05-05"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 - 500 VND","d":"2024-10-02","record":"2024-10-10","ex":"2024-10-09"},{"c":"AGME","t":"TCT - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-05-10","record":"2024-05-22","ex":"2024-05-21"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2022 - 500 VND","d":"2023-08-18","record":"2023-08-25","ex":"2023-08-24"},{"c":"AGME","t":"TCT - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-05-16"