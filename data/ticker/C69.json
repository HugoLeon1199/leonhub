dựng tại Thôn Đồng Vải - Quảng Ninh, sản lượng khai thác đạt 3.500m3/tháng. Ngày 21/04/2017, C69 chính thức giao dịch tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-04-21","state":0.0,"foreign":0.00784887,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Tuấn Nghĩa","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":5170342,"pct":8.366,"d":"2026-08-05"},{"n":"Lê Thị Thùy Linh","p":null,"t":"INDIVIDUAL","q":3582801,"pct":5.8,"d":"2026-08-05"},{"n":"Lưu Bảo Trung","p":null,"t":"INDIVIDUAL","q":2991900,"pct":4.99,"d":"2025-10-05"},{"n":"Vũ Hồng Quân","p":null,"t":"INDIVIDUAL","q":2899500,"pct":4.83,"d":"2025-10-05"},{"n":"Vũ Thị Thu Chung","p":null,"t":"INDIVIDUAL","q":2853300,"pct":4.76,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu Tư Và Thương Mại Nam Phương","p":null,"t":"CORPORATE","q":2800000,"pct":4.53,"d":"2026-02-12"},{"n":"Phạm Anh Đức","p":null,"t":"INDIVIDUAL","q":2650000,"pct":4.42,"d":"2025-10-05"},{"n":"Lê Minh Tân","p":null,"t":"INDIVIDUAL","q":2060000,"pct":3.33,"d":"2026-02-12"},{"n":"Vương Quốc Thắng","p":null,"t":"INDIVIDUAL","q":1100000,"pct":1.83,"d":"2025-10-05"},{"n":"Đào Thị Đầm","p":null,"t":"INDIVIDUAL","q":1050000,"pct":1.75,"d":"2025-10-05"},{"n":"Tiêu Thị Bạch Dương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1030000,"pct":1.667,"d":"2026-08-05"},{"n":"Phạm Tiến Quỳnh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":940081,"pct":1.52,"d":"2026-08-05"},{"n":"Phạm Văn Tùng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":600000,"pct":0.971,"d":"2026-08-05"},{"n":"Vương Anh Tuấn","p":null,"t":"INDIVIDUAL","q":555200,"pct":0.93,"d":"2025-10-05"},{"n":"Phạm Thị Thế","p":null,"t":"INDIVIDUAL","q":528287,"pct":0.855,"d":"2026-08-05"},{"n":"Lê Anh Luân","p":null,"t":"INDIVIDUAL","q":489250,"pct":0.792,"d":"2025-10-05"},{"n":"Trần Xuân Bản","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":306798,"pct":0.5,"d":"2026