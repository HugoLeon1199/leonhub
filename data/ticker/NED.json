ông trình thủy điện như Công ty Cổ phần Đầu tư phát triển đô thị và công nghiệp Sông Đà, Công ty Cổ phần Sông Đà 10, Công ty Cổ phần Sông Đà 5 và Công ty Cổ phần Thủy điện Nậm Chiến. NED được giao dịch trên thị trường UPCOM từ tháng 08/2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-08-18","state":0.72023652,"foreign":0.00084691,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Văn Ngư","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":13937850,"pct":34.41,"d":"2026-02-25"},{"n":"Đầu Tư Phát Triển An Khánh Hưng","p":null,"t":"CORPORATE","q":6317000,"pct":15.6,"d":"2025-10-05"},{"n":"Nguyễn Văn Mạnh","p":null,"t":"INDIVIDUAL","q":1558260,"pct":3.85,"d":"2025-10-05"},{"n":"Ngô Vĩnh Khương","p":null,"t":"INDIVIDUAL","q":9000,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Đức Dân","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.01,"d":"2025-10-05"}],"rel":[{"c":"NEEDCOBUILD","n":"Công ty TNHH MTV Xây lắp và Khai thác Vật liệu Xây dựng Tây Bắc","t":"subsidiary","pct":100.0},{"c":"11016","n":"Công ty Cổ Phần Thủy Điện Nậm Công Sơn La","t":"subsidiary","pct":99.91},{"c":"11017","n":"CÔNG TY CỔ PHẦN HNC NINH BÌNH","t":"affiliate","pct":46.67}],"rel_count":3,"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 6.0%","d":"2026-03-09","record":null,"ex":null},{"c":"AGME","t":"NED - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-01-20","record":"2026-02-02","ex":"2026-01-30"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2022 - 500 VND","d":"2025-04-29","record":"2025-05-15","ex":"2025-05-14"},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 14.0%","d":"2025-04-27","record":null,"ex":null},{"c":"AGME","t":"NED - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-12","record":"2025-03-28","ex":"2025-03-27"},{"c":"DDIND","t":"Lưu Văn Hổ - Đăng kí Bán 2,020,700 NED","d":"2024-11-11","record":null,"ex":null},{"c":"DDIND","t":"Trần Văn Phúc - Đăng kí Bán 2,023,117 NED","d":"2024-11-11","record":n