],["2024",8.24],["2025",9.516]]}},"co":{"short":"Tập đoàn Gemadept","profile":"Công ty Cổ phần Tập đoàn Gemadept (GMD) có tiền thân là Công ty Cổ phần Đại lý Liên hiệp Vận chuyển, được thành lập vào năm 1990. Công ty hoạt động chính trong lĩnh vực khai thác cảng và logistics. GMD chính thức hoạt động theo mô hình công ty cổ phần từ năm 1993. Công ty sở hữu hệ thống Cảng và hạ tầng Logistics trải dài từ Bắc vào Nam và vươn sang các quốc gia lân cận như Singapore, Hong Kong, Trung Quốc, Campuchia... GMD là một trong số ít các công ty logistics Việt Nam có thể cung cấp dịch vụ logistics trọn gói nhờ sở hữu hệ thống dịch vụ khép kín, từ cảng biển, kho hàng và các phương tiện vận tải nằm tại các vị trí kinh tế trọng điểm trên cả ba miền Bắc, Trung, Nam. GMD được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2002.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2002-04-22","state":0.0,"foreign":0.39342275,"rating":"BUY","target":95800.0,"rating_as_of":"2026-08-24","source":"Vietcap"},"owners":[{"n":"Quỹ ETF DCVFMVN DIAMOND","p":null,"t":"CORPORATE","q":22466866,"pct":5.43,"d":"2025-10-05"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":10073933,"pct":2.24,"d":"2025-10-05"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":2282056,"pct":1.965,"d":"2015-06-15"},{"n":"Ngân hàng Deutsche Aktiengesellschaft","p":null,"t":"CORPORATE","q":2282056,"pct":1.965,"d":"2015-06-15"},{"n":"Tmam Vietnam Equity Mother Fund","p":null,"t":"CORPORATE","q":7881200,"pct":1.88,"d":"2025-10-05"},{"n":"Trần Doãn Phi Anh","p":null,"t":"INDIVIDUAL","q":7703000,"pct":1.81,"d":"2026-02-03"},{"n":"Nguyễn Thị Hồng","p":null,"t":"INDIVIDUAL","q":7446020,"pct":1.75,"d":"2026-02-03"},{"n":"VOF Investment Limited","p":null,"t":"CORPORATE","q":6647400,"pct":1.536,"d":"2026-08-24"},{"n":"Đỗ Văn Nhân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3515564,"pct":0.81,"d":"2026-08-05"},{"n":"Vietnam Investment 