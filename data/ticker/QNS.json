1",14.414],["2022",14.513],["2023",19.596],["2024",18.724],["2025",14.568]]}},"co":{"short":"Đường Quảng Ngãi","profile":"Công ty Cổ phần Đường Quảng Ngãi (QNS), tiền thân là Công ty Đường Quảng Ngãi, được cổ phần hóa vào năm 2005. Công ty chuyên chế biến đường, mật, thực phẩm, đồ uống; sản xuất và kinh doanh nước khoáng và kinh doanh thương mại, dịch vụ tổng hợp và hoạt động xuất nhập khẩu. Công ty là doanh nghiệp dẫn đầu trong phân khúc sữa đậu nành với thị phần là 88,6%. Mỗi năm Công ty tạo ra hơn 1 triệu sản phẩm sữa đậu nành phục vụ cho người tiêu dùng trong nước. Nhà máy sữa đậu nành Vinasoy có tổng công suất là 390 triệu lít/năm. Ngoài ra, nhà máy Bia Dung Quất của Công ty có công suất lên đến 100 triệu lít/năm và nhà máy đường An Khê có công suất 10.000 tấn/năm. Công ty có hệ thống phân phối sản phẩm rộng khắp cả nước và xuất khẩu các mặt hàng bánh kẹo, bia và nước khoáng ra nước ngoài. QNS chính thức được giao dịch trên thị trường UPCOM từ Ngày 20/12/2016.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2016-12-20","state":0.0,"foreign":0.08955786,"rating":"O-PF","target":53400.0,"rating_as_of":"2024-08-30","source":"Vietcap"},"owners":[{"n":"Công Ty TNHH Một Thành Viên Thương Mại Thành Phát","p":null,"t":"CORPORATE","q":55534605,"pct":15.11,"d":"2026-07-30"},{"n":"Võ Thành Đàng","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":37267746,"pct":10.14,"d":"2026-08-21"},{"n":"Vinacapital Vietnam Opportunity Fund Ltd.","p":null,"t":"CORPORATE","q":23338324,"pct":6.538,"d":"2025-10-05"},{"n":"Công ty Cổ phần Thực Phẩm Dinh Dưỡng Nutifood Bình Dương","p":null,"t":"CORPORATE","q":16502529,"pct":4.49,"d":"2026-08-26"},{"n":"Foremost Worldwide Limited","p":null,"t":"CORPORATE","q":13937632,"pct":3.928,"d":"2025-10-05"},{"n":"Công ty Cổ phần Thực phẩm Dinh dưỡng NutiFood","p":null,"t":"CORPORATE","q":13382016,"pct":3.64,"d":"2026-08-26"},{"n":"Võ Thị Cẩm Nhung","p":null,"t":"INDIVIDUAL","q":10667282,"pct":2.901,"d":"2026-08-10"},{"n":"Ngu