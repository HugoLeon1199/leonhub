ác mặt hàng nước giải khát và các sản phẩm chăm sóc gia đình và cá nhân thông qua các mạng lưới các công ty con và công ty liên kết. TSC được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2007.","sector":"Hóa chất","type":"CT","listed":"2007-10-04","state":0.0,"foreign":0.00139022,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn F.I.T","p":null,"t":"CORPORATE","q":80857223,"pct":41.07,"d":"2026-08-07"},{"n":"Nguyễn Văn Sang","p":null,"t":"INDIVIDUAL","q":9840000,"pct":3.86,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Bích","p":null,"t":"INDIVIDUAL","q":1700000,"pct":1.151,"d":"2015-09-14"},{"n":"Trương Tấn Lộc","p":null,"t":"INDIVIDUAL","q":562980,"pct":0.381,"d":"2015-09-14"},{"n":"Nguyễn Văn Ba","p":null,"t":"INDIVIDUAL","q":175000,"pct":0.119,"d":"2015-09-14"},{"n":"Phạm Văn Tuấn","p":null,"t":"INDIVIDUAL","q":105000,"pct":0.071,"d":"2015-09-14"},{"n":"Lê Văn Phước","p":null,"t":"INDIVIDUAL","q":58780,"pct":0.04,"d":"2015-09-14"},{"n":"Hoàng Minh Tâm","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.007,"d":"2026-08-07"},{"n":"Nguyễn Trí Dũng","p":null,"t":"INDIVIDUAL","q":11000,"pct":0.007,"d":"2015-09-14"},{"n":"Trần Văn Thuộc","p":null,"t":"INDIVIDUAL","q":10630,"pct":0.007,"d":"2015-09-14"},{"n":"Bàng Minh Trang","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.005,"d":"2025-10-05"},{"n":"Đỗ Văn Thành","p":null,"t":"INDIVIDUAL","q":200,"pct":0.0,"d":"2015-09-14"}],"rel":[{"c":"NONGTIN","n":"Công Ty Cổ Phần Giống Cây Trồng Nông Tín","t":"subsidiary","pct":77.67},{"c":"FITC","n":"Công ty Cổ phần Fit Consumer","t":"subsidiary","pct":76.95},{"c":"TSCS","n":"Công ty CP Hạt Giống Tsc","t":"subsidiary","pct":57.63},{"c":"WESTFOOD","n":"Công Ty Cổ Phần Chế Biến Thực Phẩm Xuất Khẩu Miền Tây","t":"subsidiary","pct":45.11}],"rel_count":4,"events":[{"c":"OTHE","t":"TSC - Thay đổi địa chỉ","d":"2026-05-05","record":null,"ex":null},{"c":"AGME","t":"TSC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2