8MW, 02 nhà máy nhiệt điện than với tổng công suất 2.240MW và 09 nhà máy thủy điện với tổng công suất 1.333MW. GE2 được giao dịch trên thị trường UPCOM từ tháng 05/2021.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2021-05-07","state":0.51,"foreign":7.188e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"rel":[{"c":"2040156","n":"Công ty TNHH MTV Thủy điện Trung Sơn","t":"subsidiary","pct":100.0},{"c":"AVC","n":"Công ty Cổ phần Thủy điện A Vương","t":"subsidiary","pct":87.45},{"c":"SBH","n":"Công ty Cổ phần Thủy điện Sông Ba Hạ","t":"subsidiary","pct":61.78},{"c":"TMP","n":"Công ty Cổ phần Thủy điện Thác Mơ","t":"subsidiary","pct":51.92},{"c":"HND","n":"Công ty Cổ phần Nhiệt điện Hải Phòng","t":"subsidiary","pct":51.0},{"c":"PPC","n":"Công ty Cổ phần Nhiệt điện Phả Lại","t":"subsidiary","pct":51.0},{"c":"TMPROI","n":"Công ty Cổ Phần Đầu Tư Khai Thác Hồ Thủy Điện Thác Mơ","t":"affiliate","pct":18.17},{"c":"THUANBINHWIND","n":"Công ty Cổ Phần Phong Điện Thuận Bình","t":"affiliate","pct":10.38}],"rel_count":8,"events":[{"c":"AGME","t":"GE2 - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-25","record":"2026-05-08","ex":"2026-05-07"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2022 - 500 VND","d":"2022-12-09","record":"2022-12-26","ex":"2022-12-23"},{"c":"EGME","t":"GE2 - Tổ chức ĐHĐCĐ bất thường 2022","d":"2022-12-08","record":"2022-12-20","ex":"2022-12-19"},{"c":"SUSP","t":"GE2 - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2022-12-02","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2021 - 900 VND","d":"2022-08-11","record":"2022-08-31","ex":"2022-08-30"},{"c":"EGME","t":"GE2 - Tổ chức ĐHĐCĐ bất thường 2022","d":"2022-07-22","record":"2022-08-08","ex":"2022-08-05"},{"c":"AGME","t":"GE2 - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-04-29","record":"2022-05-18","ex":"2022-05-17"},{"c":"NLIS","t":"GE2 - Chính thức giao dịch trên UPCoM","d":"2021-04-29","record":null,"ex":null}],"st":{"bsa15":{"la