["2019",0.457],["2020",0.0],["2021",1.438],["2022",-1.609],["2023",0.647],["2024",-1.067],["2025",-1.11]]}},"co":{"short":"Trục vớt Cứu hộ Việt Nam","profile":"Công ty Cổ phần Trục vớt Cứu hộ Việt Nam (SAL) có tiền thân là Xí nghiệp Liên hiệp Trục vớt Cứu hộ trực thuộc Bộ Giao thông Vận tải, được thành lập vào năm 1982. Công ty hoạt động chính trong lĩnh vực dịch vụ hàng hải, trục vớt kỹ thuật ngầm, đóng mới, sửa chữa tàu, sà lan. SAL chính thức hoạt động theo mô hình công ty cổ phần từ năm 2015. Công ty hiện đang sở hữu đội tàu kéo, cung ứng và xử lý neo có tổng công suất khoảng gần 20.000 HP. SAL được giao dịch trên thị trường UPCOM từ tháng 10/2017.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2017-10-20","state":0.49,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Bảo Đảm An Toàn Hàng Hải Miền Nam","p":null,"t":"CORPORATE","q":4071900,"pct":49.0,"d":"2026-08-07"},{"n":"Công ty Cổ Phần Hàng Hải-dầu Khí Hải Âu","p":null,"t":"CORPORATE","q":1242000,"pct":14.95,"d":"2026-08-07"},{"n":"Công Ty Cổ Phần Hàng Hải Dầu Khí Hải Dương","p":null,"t":"CORPORATE","q":1077070,"pct":12.96,"d":"2026-08-07"},{"n":"Công Ty Trách Nhiệm Hữu Hạn Hàng Hải Sao Mai","p":null,"t":"CORPORATE","q":757082,"pct":9.11,"d":"2026-08-07"},{"n":"Trần Hữu Thọ","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":419048,"pct":5.04,"d":"2026-07-10"},{"n":"Nguyễn Văn Bê","p":null,"t":"INDIVIDUAL","q":206200,"pct":2.48,"d":"2025-10-05"},{"n":"Nguyễn Văn Trang","p":null,"t":"INDIVIDUAL","q":7300,"pct":0.09,"d":"2025-10-05"},{"n":"Nguyễn Trọng Hiếu","p":null,"t":"INDIVIDUAL","q":5300,"pct":0.064,"d":"2025-10-05"},{"n":"Lê Thị Mỹ Hạnh","p":null,"t":"INDIVIDUAL","q":3100,"pct":0.037,"d":"2025-10-05"},{"n":"Bùi Đức Cường","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1700,"pct":0.02,"d":"2026-08-07"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 768 VND","d":"2026-08-22","recor