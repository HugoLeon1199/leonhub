 tỷ đồng, giảm 13.95% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 168.12%, tăng 6.62%. Lợi nhuận trước thuế có giá trị bằng 510,69 tỷ đồng, giảm 22.99%. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 9.29%, giảm 5.32%. FTS được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ đầu năm 2017.","sector":"Dịch vụ tài chính","type":"CK","listed":"2017-01-13","state":0.0,"foreign":0.24551843,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"SBI Financial Services Company Limited","p":null,"t":"CORPORATE","q":88820459,"pct":23.3,"d":"2026-07-30"},{"n":"Công ty Cổ phần FPT","p":null,"t":"CORPORATE","q":38413103,"pct":17.58,"d":"2025-10-05"},{"n":"Phạm Thanh Hào","p":null,"t":"INDIVIDUAL","q":7187400,"pct":4.87,"d":"2025-10-05"},{"n":"Nguyễn Thị Thúy","p":null,"t":"INDIVIDUAL","q":6548077,"pct":3.052,"d":"2025-10-05"},{"n":"Nguyễn Thị Minh","p":null,"t":"INDIVIDUAL","q":4095682,"pct":1.909,"d":"2025-10-05"},{"n":"Nguyễn Điệp Tùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":6023342,"pct":1.58,"d":"2026-07-30"},{"n":"Công ty TNHH Đầu Tư FPT","p":null,"t":"CORPORATE","q":2910083,"pct":1.49,"d":"2025-10-05"},{"n":"ĐỖ SƠN GIANG","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":884378,"pct":0.23,"d":"2026-07-30"},{"n":"Nguyễn Thị Thu Hương","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":784655,"pct":0.21,"d":"2026-07-30"},{"n":"Nguyễn Văn Dũng","p":null,"t":"INDIVIDUAL","q":633355,"pct":0.17,"d":"2026-07-30"},{"n":"Nguyễn Khắc Thành","p":null,"t":"INDIVIDUAL","q":275126,"pct":0.14,"d":"2025-10-05"},{"n":"Nguyễn Thế Phương","p":null,"t":"INDIVIDUAL","q":195361,"pct":0.1,"d":"2025-10-05"},{"n":"Trịnh Thanh Hằng","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":372420,"pct":0.1,"d":"2026-07-30"},{"n":"Nguyễn Thị Hạnh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":341055,"pct":0.09,"d":"2026-07-30"},{"n":"Nguyễn Thị Sơn","p":"Kế toán