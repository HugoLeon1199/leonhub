thi công các công trình ngầm, giao thông và công trình công nghiệp. SJG được giao dịch trên thị trường UPCOM từ tháng 02/2018.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2018-02-12","state":0.99790674,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":448596112,"pct":99.79,"d":"2026-07-27"},{"n":"Trần Văn Tuấn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":12600,"pct":0.003,"d":"2026-07-27"},{"n":"Vũ Đức Quang","p":null,"t":"INDIVIDUAL","q":7500,"pct":0.002,"d":"2021-01-29"},{"n":"Vũ Đức Quang","p":"Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":2500,"pct":0.001,"d":"2026-07-27"},{"n":"Nguyễn Văn Thự","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.0,"d":"2026-07-27"},{"n":"Phạm Đức Thành","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1500,"pct":0.0,"d":"2026-07-27"},{"n":"Trần Anh Đức","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2000,"pct":0.0,"d":"2026-07-27"},{"n":"Trần Thị Thu Phương","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.0,"d":"2026-07-27"}],"rel":[{"c":"10820","n":"Công Ty TNHH Một Thành Viên Hạ Tầng Sông Đà","t":"subsidiary","pct":100.0},{"c":"NCHC","n":"Công ty Cp Thuỷ Điện Nậm Chiến","t":"subsidiary","pct":74.41},{"c":"SD4","n":"Công ty Cổ phần Sông Đà 4","t":"subsidiary","pct":65.0},{"c":"SD6","n":"Công ty Cổ phần Sông Đà 6","t":"subsidiary","pct":65.0},{"c":"SD5","n":"Công ty Cổ phần Sông Đà 5","t":"subsidiary","pct":64.16},{"c":"SDT","n":"Công ty Cổ phần Sông Đà 10","t":"subsidiary","pct":62.27},{"c":"SD9","n":"Công ty Cổ phần Sông Đà 9","t":"subsidiary","pct":58.5},{"c":"SDC","n":"Công ty Cổ phần Tư vấn Sông Đà","t":"subsidiary","pct":51.006},{"c":"SD3","n":"Công ty Cổ phần Sông Đà 3","t":"subsidiary","pct":51.002},{"c":"SESAN3A","n":"Công ty Cổ Phần Đầu Tư Và Phát Triển Điện Sê San 3a","t":"subsidiary","pct":51.0},{"c":"SDX","n":"Công ty C