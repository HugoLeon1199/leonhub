 kiện thuận lợi để duy trì và phát triển mảng kinh doanh sách truyền thống bằng việc đẩy mạnh bán lẻ tại các siêu thị, mở rộng và tìm kiếm thêm thị trường bán buôn vào các trường học. VNB được giao dịch trên thị trường UPCOM từ tháng 07/2016.","sector":"Truyền thông","type":"CT","listed":"2016-07-15","state":0.1,"foreign":0.01064056,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Vingroup - Công ty CP","p":null,"t":"CORPORATE","q":44364274,"pct":65.33,"d":"2026-02-11"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":6790996,"pct":10.0,"d":"2026-02-11"},{"n":"Nguyễn Thị Lan Anh","p":null,"t":"INDIVIDUAL","q":3100,"pct":0.005,"d":"2026-08-05"},{"n":"Nguyễn Trọng Tuấn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3700,"pct":0.005,"d":"2026-08-05"},{"n":"Phạm Thị Là","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":2000,"pct":0.003,"d":"2026-08-05"}],"rel":[{"c":"INSAVINA","n":"Công ty Cổ Phần In Sách Việt Nam","t":"affiliate","pct":27.76}],"rel_count":1,"events":[{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-10","record":"2026-04-24","ex":"2026-04-23"},{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-12","record":"2025-03-27","ex":"2025-03-26"},{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-02-29","record":"2024-03-15","ex":"2024-03-14"},{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-04-07","record":"2023-04-24","ex":"2023-04-21"},{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-04-01","record":"2022-04-15","ex":"2022-04-14"},{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-04-23","record":"2021-05-10","ex":"2021-05-07"},{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2020","d":"2020-05-28","record":"2020-06-10","ex":"2020-06-09"},{"c":"AGME","t":"VNB - Tổ chức ĐHĐCĐ thường niên 2019","d":"2019-05-04","record":"2019-05-24","ex":