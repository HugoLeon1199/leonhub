phiếu của công ty niêm yết và giao dịch tại HOSE. Hoạt động kinh doanh chính là Chế biến và xuất khẩu các sản phẩm từ tôm chiếm hơn 96 % doanh thu. Các sản phẩm chính của công ty là Tôm tươi, Tôm Nobashi, Tôm tẩm bột, tôm hấp trong đó tôm tươi chiếm tỉ trọng lớn nhất, 37,02%, sau đó là tôm Nobashi 27,13%, với thị trường tiêu thụ truyền thống là Nhật và Mỹ. Hiện FMC đang mở rộng và khôi phục lại các thị trường EU, Nga và Hàn Quốc.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2006-12-07","state":0.0253254,"foreign":0.30893944,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn PAN","p":null,"t":"CORPORATE","q":24684678,"pct":37.75,"d":"2026-08-05"},{"n":"Công ty Cổ phần Chăn Nuôi C.p. Việt Nam","p":null,"t":"CORPORATE","q":16281833,"pct":24.9,"d":"2026-08-06"},{"n":"Công ty Cổ phần Xuất nhập khẩu Thủy sản Bến Tre","p":null,"t":"CORPORATE","q":8089000,"pct":12.37,"d":"2026-08-05"},{"n":"Công ty TNHH MTV Tư vấn đầu tư An Khánh","p":null,"t":"CORPORATE","q":563480,"pct":2.817,"d":"2015-06-15"},{"n":"Văn phòng Thành ủy Sóc Trăng","p":null,"t":"CORPORATE","q":1656000,"pct":2.53,"d":"2025-10-05"},{"n":"Văn Anh Kiệt","p":null,"t":"INDIVIDUAL","q":437525,"pct":2.188,"d":"2015-09-14"},{"n":"Hồ Quốc Lực","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":710000,"pct":1.09,"d":"2026-08-20"},{"n":"Quách Hoàng Phong","p":null,"t":"INDIVIDUAL","q":209030,"pct":1.045,"d":"2015-09-14"},{"n":"Đoàn Thị Hồng Thúy","p":null,"t":"INDIVIDUAL","q":144000,"pct":0.72,"d":"2015-09-14"},{"n":"Ban Chấp Hành Công Đoàn Cơ Sở Ctcp Thực Phẩm Sao Ta","p":null,"t":"CORPORATE","q":450000,"pct":0.69,"d":"2026-08-20"},{"n":"Phạm Hoàng Việt","p":null,"t":"INDIVIDUAL","q":308068,"pct":0.47,"d":"2026-08-20"},{"n":"Đinh Văn Thới","p":null,"t":"INDIVIDUAL","q":144572,"pct":0.22,"d":"2025-10-05"},{"n":"Hà Việt Thắng","p":null,"t":"INDIVIDUAL","q":48750,"pct":0.12,"d":"2019-01-28"},{"n":"Mã Ích Hưng","p":"Thành viên Hội đồng Quản trị/Tổng Giá