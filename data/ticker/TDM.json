iết bị, công nghệ ngành nước. Công ty hiện quản lý vận hành Nhà máy nước Dĩ An với tổng công suất 200.000m3/ngày đêm và nhà máy nước Bàu Bàng với công suất 6 0.000 m3/ngày đêm. TDM chính thức được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ ngày 24/10/2018.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2016-04-01","state":0.0,"foreign":0.00603382,"rating":"M-PF","target":57700.0,"rating_as_of":"2026-08-14","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Chứng khoán Vietcap","p":null,"t":"CORPORATE","q":17061000,"pct":13.96,"d":"2026-08-13"},{"n":"Công ty TNHH Sản Xuất Và Thương Mại Quỳnh Phúc","p":null,"t":"CORPORATE","q":8557998,"pct":7.003,"d":"2026-08-17"},{"n":"Công Ty TNHH Thương Mại N.T.P","p":null,"t":"CORPORATE","q":7700000,"pct":6.301,"d":"2026-08-14"},{"n":"Phạm Văn Chiến","p":null,"t":"INDIVIDUAL","q":5500000,"pct":5.0,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Nhựa Thiếu Niên Tiền Phong Phía Nam","p":null,"t":"CORPORATE","q":4492900,"pct":4.49,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Tân Thanh","p":null,"t":"CORPORATE","q":4730000,"pct":3.87,"d":"2026-08-17"},{"n":"Trần Thế Hưng","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":2899142,"pct":2.372,"d":"2026-08-24"},{"n":"Công ty Tnhh Một Thành Viên Thương Mại Dịch Vụ Kỹ Thuật D&B","p":null,"t":"CORPORATE","q":1540000,"pct":1.4,"d":"2025-10-05"},{"n":"Nguyễn Văn Thiền","p":null,"t":"INDIVIDUAL","q":1641907,"pct":1.344,"d":"2026-08-05"},{"n":"Nguyễn Thị Diên","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1390400,"pct":1.138,"d":"2026-08-10"},{"n":"Nguyễn Thanh Phong","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1210000,"pct":0.99,"d":"2026-08-14"},{"n":"Nguyễn Đỗ Ngọc Bảo","p":null,"t":"INDIVIDUAL","q":1100000,"pct":0.9,"d":"2026-08-14"},{"n":"Quỹ Đầu tư Lợi Thế Cạnh Tranh Bền Vững SSI","p":null,"t":"CORPORATE","q":741920,"pct":0.775,"d":"2020-07-14"},{"n":"Đặng Thị Mười","p":null,"t":"INDIVIDUAL","q":913110,"pct":0.747,"d":"2026-08-11"},{"n":"Dương Hoàn