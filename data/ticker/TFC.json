châu Âu với tổng giá trị nhập khẩu xấp xỉ 300 tỷ đồng 1 năm. TFC hiện đang vận hành 3 dây chuyền sản xuất và hệ thống kho có năng suất khoảng 16 tấn thành phẩm/ngày. Hiện nay, Công ty có khoảng 178 loại sản phẩm khác nhau. TFC được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ cuối năm 2015.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2015-12-03","state":0.0,"foreign":0.33847677,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"David Hồ","p":null,"t":"INDIVIDUAL","q":3860000,"pct":22.94,"d":"2026-08-06"},{"n":"Nguyễn Minh Nguyệt","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3706100,"pct":22.02,"d":"2026-08-06"},{"n":"Hồ Văn Trung","p":null,"t":"INDIVIDUAL","q":2687400,"pct":15.97,"d":"2026-08-06"},{"n":"Đỗ Thành Trung","p":null,"t":"INDIVIDUAL","q":1169400,"pct":6.95,"d":"2025-10-05"},{"n":"Susan Ho","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1000000,"pct":5.94,"d":"2026-08-06"},{"n":"Huỳnh Khánh Hiếu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":700000,"pct":4.16,"d":"2026-08-06"},{"n":"Nguyễn Minh Tâm","p":null,"t":"INDIVIDUAL","q":525000,"pct":3.119,"d":"2026-08-06"},{"n":"Vũ Thị Minh Chiến","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":244000,"pct":1.45,"d":"2026-08-06"},{"n":"Trương Văn Quang","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":33550,"pct":0.199,"d":"2026-08-06"},{"n":"Lê Thị Tường Hạnh","p":null,"t":"INDIVIDUAL","q":21650,"pct":0.129,"d":"2025-10-05"},{"n":"Tô Lệ Minh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":750,"pct":0.004,"d":"2026-08-06"}],"rel":[{"c":"12135","n":"Công ty TNHH Sản Xuất Thương Mại Dịch Vụ Thực Phẩm Dasumy","t":"subsidiary","pct":75.0},{"c":"12136","n":"Công ty TNHH Thực Phẩm Dary","t":"affiliate","pct":45.0}],"rel_count":2,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 2,200 VND","d":"2026-08-24","record":"2026-09-07","ex":"2026-09-04"},{"c":"AGM