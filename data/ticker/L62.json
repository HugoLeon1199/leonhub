 ngoài, với giá trị xuất khẩu: 2.192.185 USD.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2008-04-21","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Vũ Kế Chương","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1479162,"pct":17.825,"d":"2026-08-11"},{"n":"Nguyễn Văn Kỳ","p":null,"t":"INDIVIDUAL","q":1190370,"pct":14.345,"d":"2026-08-11"},{"n":"Hoàng Sỹ Khang","p":null,"t":"INDIVIDUAL","q":698529,"pct":8.42,"d":"2026-06-19"},{"n":"Vũ Khắc Nhiềm","p":null,"t":"INDIVIDUAL","q":698529,"pct":8.42,"d":"2026-08-11"},{"n":"Trần Xuân Trường","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":654983,"pct":7.893,"d":"2026-08-11"},{"n":"Hoàng Trung Kiên","p":null,"t":"INDIVIDUAL","q":519835,"pct":6.26,"d":"2026-03-10"},{"n":"Bùi Ngọc Tiến","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":252547,"pct":3.04,"d":"2026-08-11"},{"n":"Nguyễn Hữu Hóa","p":null,"t":"INDIVIDUAL","q":104144,"pct":1.255,"d":"2025-10-05"},{"n":"Lê Cao Bằng","p":null,"t":"INDIVIDUAL","q":54000,"pct":0.94,"d":"2015-09-14"},{"n":"Nguyễn Quang Thi","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":30000,"pct":0.362,"d":"2026-08-11"},{"n":"Nguyễn Đức Cường","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.241,"d":"2025-10-05"},{"n":"Trương Đức Thành","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.181,"d":"2025-10-05"},{"n":"Lê Thị Minh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":14297,"pct":0.172,"d":"2026-08-11"},{"n":"Vũ Xuân Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":11865,"pct":0.143,"d":"2026-08-11"},{"n":"Đỗ Tiến Thành","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.12,"d":"2025-10-05"},{"n":"Vũ Thị Ngà","p":"Kế toán trưởng","t":"INDIVIDUAL","q":5000,"pct":0.06,"d":"2026-08-11"},{"n":"Nguyễn Thị Dung","p":null,"t":"INDIVIDUAL","q":2365,"pct":0.028,"d":"2025-10-05"},{"n":"Đỗ Trường Giang","p":null,"t":"INDIVIDUAL","q":1350,"pct":0.024,"d":"2015-09-1