 Công ty còn cung cấp nhiều dịch vụ khác liên quan đến hoạt động du lịch cho các đối tác như: Công ty Du lịch Hữu nghị, Sun Travel, ASIAN Sun Tour, Vina Tour, Viettour, Trung tâm Lữ hành Quốc tế Thắng Lợi... PDC chính thức được giao dịch trên Thị trường UPCoM từ ngày 08/08/2022.","sector":"Du lịch và Giải trí","type":"CT","listed":"2009-09-29","state":0.098,"foreign":0.00084667,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Kim Giang","p":null,"t":"INDIVIDUAL","q":3049456,"pct":20.33,"d":"2026-08-20"},{"n":"Lê Thanh Thản","p":null,"t":"INDIVIDUAL","q":3000000,"pct":20.0,"d":"2026-08-20"},{"n":"Đỗ Trung Kiên","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2850000,"pct":19.0,"d":"2026-08-20"},{"n":"Phạm Thị Thu Thủy","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1659000,"pct":11.06,"d":"2026-08-20"},{"n":"Tổng Công ty Cổ phần Bia - Rượu - Nước Giải khát Sài Gòn","p":null,"t":"CORPORATE","q":1470000,"pct":9.8,"d":"2026-08-20"},{"n":"Lê Thị Hoàng Yến","p":null,"t":"INDIVIDUAL","q":1406000,"pct":9.373,"d":"2026-08-20"},{"n":"Công ty Cổ Phần Đầu Tư Và Kinh Doanh Tài Sản Việt Nam","p":null,"t":"CORPORATE","q":876883,"pct":5.846,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán Dầu khí","p":null,"t":"CORPORATE","q":510846,"pct":3.406,"d":"2015-06-15"},{"n":"Nguyễn Đình Nguyên","p":null,"t":"INDIVIDUAL","q":3800,"pct":0.025,"d":"2015-09-14"},{"n":"Nguyễn Thị Hồng Thanh","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.017,"d":"2015-09-14"},{"n":"Lê Thị Mai Hoa","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.013,"d":"2015-09-14"},{"n":"Lê Thị Thu Hương","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":1900,"pct":0.013,"d":"2026-08-20"},{"n":"Hoàng Trung Hưng","p":null,"t":"INDIVIDUAL","q":1600,"pct":0.011,"d":"2015-09-14"},{"n":"Lê Thị Hồng Gấm","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.007,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"PDC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-11","record":"2026-03-31","ex":"2026-03-30