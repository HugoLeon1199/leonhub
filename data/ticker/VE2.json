àn thành xây dựng nhiều dự án lớn như: Xây lắp hoàn thành 500 kV 1 mạch Bắc - Nam : 25,8 Km; 500kV 2 mạch Quảng Ninh – Thường Tín: 4,5 Km; Cải tạo, mở rộng nhiều trạm biến áp như: Hưng Đông, Thạch Linh; Xây dựng hoàn thành 173.036 m2 vỉa hè, đường đi, bãi đậu xe...","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-07-26","state":3.474e-05,"foreign":0.00718891,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phan Thúy Phương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":422200,"pct":20.12,"d":"2026-03-09"},{"n":"Chung Việt Hà","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":400000,"pct":19.07,"d":"2026-03-09"},{"n":"Khuất Văn Đăng","p":null,"t":"INDIVIDUAL","q":279000,"pct":13.3,"d":"2025-10-05"},{"n":"Lê Minh Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":250000,"pct":11.92,"d":"2026-03-09"},{"n":"Mạnh Thị Bích Thuỷ","p":null,"t":"INDIVIDUAL","q":127000,"pct":6.05,"d":"2026-03-09"},{"n":"Nguyễn Đậu Thảo","p":null,"t":"INDIVIDUAL","q":127542,"pct":5.908,"d":"2025-10-05"},{"n":"Lê Thị Hoa","p":null,"t":"INDIVIDUAL","q":107681,"pct":5.13,"d":"2025-10-05"},{"n":"Lê Thị Thu Phượng","p":null,"t":"INDIVIDUAL","q":46400,"pct":2.21,"d":"2025-10-05"},{"n":"Lê Thị Thúy Xoan","p":null,"t":"INDIVIDUAL","q":33821,"pct":1.61,"d":"2025-10-05"},{"n":"Trần Thái Hưng","p":null,"t":"INDIVIDUAL","q":33510,"pct":1.597,"d":"2015-09-14"},{"n":"Nguyễn Đẩu Hào","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":25137,"pct":1.2,"d":"2026-03-09"},{"n":"Nguyễn Đình Thanh","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.953,"d":"2015-09-14"},{"n":"Trần Vĩnh Phuơng","p":null,"t":"INDIVIDUAL","q":19200,"pct":0.915,"d":"2015-09-14"},{"n":"Phạm Văn Tạo","p":null,"t":"INDIVIDUAL","q":11798,"pct":0.562,"d":"2015-09-14"},{"n":"Trần Đình Quý","p":null,"t":"INDIVIDUAL","q":11600,"pct":0.553,"d":"2015-09-14"},{"n":"MẠNH XUÂN KỲ","p":null,"t":"INDIVIDUAL","q":11600,"pct":0.537,"d":"2025-10-05"},{"n":"Nguyễn Huy Hoài","p":null,"t":"INDIVIDUA