447],["2019",2.835],["2020",0.0],["2021",2.19],["2022",2.671],["2023",1.613],["2024",3.508],["2025",3.628]]}},"co":{"short":"Môi trường Đô thị Quảng Nam","profile":"Công ty Cổ phần Môi trường Đô thị Quảng Nam (QNU) có tiền thân là Công ty Môi trường Đô thị Tam Kỳ, được thành lập vào năm 1997. QNU chính thức hoạt động theo mô hình công ty cổ phần từ năm 2016. Công ty hoạt động chính trong lĩnh vực cung cấp dịch vụ vệ sinh môi trường và cung cấp nước sạch trên địa bàn tỉnh Quảng Nam. QNU thực hiện công tác thu gom, vận chuyển và xử lý rác thải thải trên địa bàn tỉnh Quảng Nam và cung cấp nước sạch cho các huyện như Đại Lộc, Tiên Phước, Hiệp Phước, Nam Trà My. QNU được giao dịch trên thị trường UPCOM từ đầu năm 2017.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2017-02-28","state":0.61514691,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Quảng Nam","p":null,"t":"CORPORATE","q":4182999,"pct":61.51,"d":"2026-08-21"},{"n":"Chung Thành Đông","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":700000,"pct":10.29,"d":"2026-08-21"},{"n":"Công Ty TNHH Trường Gia An","p":null,"t":"CORPORATE","q":505000,"pct":7.43,"d":"2026-08-21"},{"n":"Phạm Nam Thái","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":256000,"pct":3.76,"d":"2026-08-21"},{"n":"Trần Đình Được","p":"Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":105100,"pct":1.55,"d":"2026-08-21"},{"n":"Đoàn Kim Thịnh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":104300,"pct":1.53,"d":"2026-08-21"},{"n":"Nguyễn Thanh Thảo","p":null,"t":"INDIVIDUAL","q":56000,"pct":0.82,"d":"2026-08-21"},{"n":"Nguyễn Thanh Dũng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":56000,"pct":0.8,"d":"2026-08-21"},{"n":"Nguyễn Thị Trúc Uyên","p":null,"t":"INDIVIDUAL","q":21300,"pct":0.31,"d":"2026-08-21"},{"n":"Đỗ Xuân Thiện","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1140