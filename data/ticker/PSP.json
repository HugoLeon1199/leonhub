0.000 teus. PSP được niêm yết trên Thị trường Upcom từ năm 2009.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2009-11-10","state":0.51,"foreign":7.5e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Dịch vụ Kỹ thuật Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":20400000,"pct":51.0,"d":"2026-08-17"},{"n":"Công ty Cổ Phần Hàng Hải Vsico","p":null,"t":"CORPORATE","q":8840200,"pct":22.1,"d":"2026-08-17"},{"n":"Công ty Cổ phần Hải Minh","p":null,"t":"CORPORATE","q":1414600,"pct":3.53,"d":"2025-10-05"},{"n":"Công ty TNHH Đất Vàng Mới","p":null,"t":"CORPORATE","q":24000,"pct":0.073,"d":"2015-06-15"},{"n":"Lưu Quốc Phương","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.012,"d":"2015-09-14"},{"n":"Nguyễn Hải Bằng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4000,"pct":0.01,"d":"2026-08-17"},{"n":"Đỗ Huy Thế","p":null,"t":"INDIVIDUAL","q":2400,"pct":0.007,"d":"2015-09-14"},{"n":"Nguyễn Chí Trung","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":2400,"pct":0.006,"d":"2026-08-17"},{"n":"Lê Thanh Tú","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.005,"d":"2026-08-17"},{"n":"Nguyễn Thị Kim Yến","p":null,"t":"INDIVIDUAL","q":500,"pct":0.002,"d":"2015-09-14"}],"rel":[{"c":"0201093188","n":"Công ty Cổ Phần Đầu Tư Xây Lắp Dầu Khí Duyên Hải","t":"affiliate","pct":20.57}],"rel_count":1,"events":[{"c":"AGME","t":"PSP - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-29","record":"2026-05-12","ex":"2026-05-11"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 300 VND","d":"2025-08-21","record":"2025-09-04","ex":"2025-09-03"},{"c":"EGME","t":"PSP - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-08-21","record":"2025-09-04","ex":"2025-09-03"},{"c":"DDINS","t":"Công ty Cổ phần Hải Minh - Đăng kí Bán PSP","d":"2025-07-21","record":null,"ex":null},{"c":"AGME","t":"PSP - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-28","record":"2025-04-08","ex":"2025-04-04"},{"c":"DIV","t":"Trả c