p khẩu từ Châu Âu và Mỹ. Công ty có hoạt động kinh doanh cơ khí, xây lắp rộng khắp cả nước và tại nhiều quốc gia Châu Âu, Châu Á. SBG chính thức được giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ ngày 01/12/2023.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2023-12-01","state":0.0,"foreign":0.00951543,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Siba Holdings","p":null,"t":"CORPORATE","q":22288100,"pct":44.58,"d":"2026-07-03"},{"n":"Nguyễn Văn Đức","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2778540,"pct":4.63,"d":"2026-08-17"},{"n":"Phan Hồng Vân","p":null,"t":"INDIVIDUAL","q":760000,"pct":3.04,"d":"2025-10-05"},{"n":"Trương Mạnh Linh","p":null,"t":"INDIVIDUAL","q":129360,"pct":0.216,"d":"2026-08-27"},{"n":"Nguyễn Văn Phú","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":114480,"pct":0.191,"d":"2026-08-27"},{"n":"Phan Lê Hoàng Trung","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":55440,"pct":0.092,"d":"2026-08-27"},{"n":"Lê Thị Xuân Đức","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.04,"d":"2025-10-05"},{"n":"Nguyễn Tấn Hưng","p":null,"t":"INDIVIDUAL","q":11424,"pct":0.019,"d":"2026-08-27"},{"n":"Trần Ngọc Long","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":5040,"pct":0.008,"d":"2026-08-27"}],"rel":[{"c":"1900665908","n":"Công Ty TNHH Một Thành Viên Năng Lượng Sạch Vmeco Bạc Liêu","t":"subsidiary","pct":100.0},{"c":"0319054698","n":"Công ty Cổ Phần Thực Phẩm Ocoba","t":"subsidiary","pct":99.9}],"rel_count":2,"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành cho CBCNV tỉ lệ 1.7%","d":"2026-08-12","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành cho CBCNV tỉ lệ 1.7%","d":"2026-08-12","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 33.3%","d":"2026-07-24","record":null,"ex":null},{"c":"AIS","t":"SBG - Niêm yết bổ sung 9.999.954 cổ 