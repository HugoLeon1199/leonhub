ồng, tăng 26.4% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 186.48%, tăng 53.97%. Lợi nhuận trước thuế có giá trị bằng 116,76 tỷ đồng. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 4.44%, tăng 4.43%. PHS chính thức giao dịch trên thị trường UPCOM từ tháng 07/2019.","sector":"Dịch vụ tài chính","type":"CK","listed":"2019-07-31","state":0.0,"foreign":0.85851743,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phu Hung Far East Holding Corporation","p":null,"t":"CORPORATE","q":92004600,"pct":46.0,"d":"2026-08-21"},{"n":"New Beam International Inc","p":null,"t":"CORPORATE","q":41676745,"pct":20.837,"d":"2026-08-21"},{"n":"An Thinh Development Limited","p":null,"t":"CORPORATE","q":16283155,"pct":18.09,"d":"2025-12-30"},{"n":"Công ty TNHH Tư vấn Đầu tư Quang Huy","p":null,"t":"CORPORATE","q":4691067,"pct":13.501,"d":"2015-06-15"},{"n":"Công ty Cổ phần CX Technology (Vietnam)","p":null,"t":"CORPORATE","q":2325000,"pct":6.692,"d":"2015-06-15"},{"n":"Cat Tinh Development Limited","p":null,"t":"CORPORATE","q":9958177,"pct":4.98,"d":"2025-10-05"},{"n":"Công ty TNHH Tư vấn Đầu tư Phú Lập","p":null,"t":"CORPORATE","q":1500000,"pct":4.317,"d":"2015-06-15"},{"n":"Công ty TNHH Tư Vấn Đầu Tư Vũ Thái","p":null,"t":"CORPORATE","q":7473415,"pct":3.737,"d":"2026-08-21"},{"n":"Nguyễn Hồng Mai","p":null,"t":"INDIVIDUAL","q":793166,"pct":2.283,"d":"2015-09-14"},{"n":"Công ty TNHH Một Thành Viên Thương Mại Dịch Vụ Cuộc Sống Mới","p":null,"t":"CORPORATE","q":3136847,"pct":1.568,"d":"2025-10-05"},{"n":"Công ty Cổ phần Âu Lạc","p":null,"t":"CORPORATE","q":500000,"pct":1.439,"d":"2015-06-15"},{"n":"Trần Thị Quỳnh Mai","p":null,"t":"INDIVIDUAL","q":500000,"pct":1.439,"d":"2015-09-14"},{"n":"Freshfields Capital Corporation","p":null,"t":"CORPORATE","q":1290486,"pct":0.65,"d":"2026-08-21"},{"n":"Nguyễn Hùng Mạnh","p":null,"t":"INDIVIDUAL","q":258177,"pct":0.13,"d":"2026-08-21"},{"n":"Nguyễn Thành Chung","p":null,"t":"INDIVIDUAL","q":25000,"pct":0.072,"d":