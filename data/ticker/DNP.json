ợc niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2009.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-11-28","state":0.0,"foreign":0.00151936,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty TNHH Tasco Investment","p":null,"t":"CORPORATE","q":80683437,"pct":57.2,"d":"2026-08-04"},{"n":"Công Ty Cổ Phần Vii","p":null,"t":"CORPORATE","q":9763284,"pct":6.93,"d":"2025-12-29"},{"n":"Hoàng Anh Tuấn","p":null,"t":"INDIVIDUAL","q":6038524,"pct":4.28,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Capella Group","p":null,"t":"CORPORATE","q":4948806,"pct":4.162,"d":"2025-10-05"},{"n":"Nguyễn Tiến Hòa","p":null,"t":"INDIVIDUAL","q":515202,"pct":3.814,"d":"2015-09-14"},{"n":"Phan Thị Tuyết Lan","p":null,"t":"INDIVIDUAL","q":465300,"pct":3.445,"d":"2015-09-14"},{"n":"Vũ Đình Độ","p":null,"t":"INDIVIDUAL","q":4620000,"pct":3.28,"d":"2026-01-08"},{"n":"Công ty Cổ Phần Đầu Tư Vsd","p":null,"t":"CORPORATE","q":2100000,"pct":1.92,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán Quốc Gia","p":null,"t":"CORPORATE","q":1318698,"pct":1.11,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư Châu Á Thống Nhất","p":null,"t":"CORPORATE","q":1000000,"pct":0.92,"d":"2025-10-05"},{"n":"Hồ Xuân Hạnh","p":null,"t":"INDIVIDUAL","q":46090,"pct":0.341,"d":"2015-09-14"},{"n":"Nguyễn Văn Chinh","p":null,"t":"INDIVIDUAL","q":44061,"pct":0.326,"d":"2015-09-14"},{"n":"Tống Đức Vinh","p":null,"t":"INDIVIDUAL","q":37020,"pct":0.274,"d":"2015-09-14"},{"n":"Lưu Xuân Tuệ","p":null,"t":"INDIVIDUAL","q":18050,"pct":0.134,"d":"2015-09-14"},{"n":"Lê Thị Mơ","p":null,"t":"INDIVIDUAL","q":17300,"pct":0.128,"d":"2015-09-14"},{"n":"Vũ Thị Thục Hiền","p":null,"t":"INDIVIDUAL","q":6760,"pct":0.05,"d":"2015-09-14"},{"n":"Trần Thái Sơn","p":null,"t":"INDIVIDUAL","q":24918,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Xuân Nam","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.015,"d":"2015-09-14"},{"n":"Phạm Đình Lâm","p":null,"t":"INDIVIDUAL","q":1105,"pct":0.008,"d":"2015-0