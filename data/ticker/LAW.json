cung cấp nước sạch song song với việc sản xuất nước uống đóng chai để phục vụ cho tỉnh Long An. LAW được giao dịch trên thị trường UPCOM từ tháng 12/2015.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2015-12-21","state":0.6,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Long An","p":null,"t":"CORPORATE","q":7320000,"pct":60.0,"d":"2026-07-29"},{"n":"Công ty Cổ phần - Tổng công ty Nước - Môi trường Bình Dương","p":null,"t":"CORPORATE","q":4643740,"pct":38.06,"d":"2026-05-25"},{"n":"Cao Duy Thanh","p":"Trưởng Ban kiểm soát/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":5200,"pct":0.042,"d":"2026-07-29"},{"n":"Nguyễn Bảo Tùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1100,"pct":0.01,"d":"2026-07-29"},{"n":"Trương Thị Lệ Khanh","p":"Thành viên Ban kiểm soát/Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1000,"pct":0.008,"d":"2026-07-29"},{"n":"Lưu Văn Cần","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":700,"pct":0.005,"d":"2026-07-29"},{"n":"Nguyễn Quốc Phong","p":"Kế toán trưởng","t":"INDIVIDUAL","q":300,"pct":0.002,"d":"2026-07-29"}],"rel":[{"c":"DNPW","n":"Công ty Cổ phần Đầu tư Ngành nước DNP","t":"affiliate","pct":0.0}],"rel_count":1,"events":[{"c":"AGME","t":"LAW - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-19","record":"2026-03-31","ex":"2026-03-30"},{"c":"AGME","t":"LAW - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-06","record":"2025-03-20","ex":"2025-03-19"},{"c":"AGME","t":"LAW - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-12","record":"2024-03-28","ex":"2024-03-27"},{"c":"EGME","t":"LAW - Tổ chức ĐHĐCĐ bất thường 2023","d":"2023-10-03","record":"2023-10-18","ex":"2023-10-17"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2022 - 607 VND","d":"2023-10-03","record":"2023-10-18","ex":"2023-10-17"},{"c":"EGME","t":"LAW - Tổ chức ĐHĐCĐ bất thường 2023","d":"2023-07-24","record":"2023-08-04","e