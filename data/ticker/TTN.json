 lĩnh vực dịch vụ viễn thông, công nghệ thông tin, tích hợp hệ thống và dịch vụ cơ điện (M&E). TTN được biết đến là nhà cung cấp dịch vụ viễn thông trọn gói trong các khu công nghiệp, khu dân cư, khu đô thị dịch vụ của BECAMEX IDC và VSIP đầu tư. Bên cạnh đó, TTN đã đầu tư xây dựng một trong những trung tâm dữ liệu lớn của Việt Nam theo tiêu chuẩn Tier-3. Công ty cũng tham gia cung cấp dịch vụ cơ điện. TTN được giao dịch trên thị trường UPCOM từ tháng 04/2017.","sector":"Viễn thông","type":"CT","listed":"2017-04-19","state":0.54031992,"foreign":0.00348077,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Đầu tư và Phát triển Công nghiệp Becamex - CTCP","p":null,"t":"CORPORATE","q":17844600,"pct":48.59,"d":"2026-07-29"},{"n":"Quỹ Đầu tư Cổ phiếu Tăng trưởng Chiến lược VinaCapital","p":null,"t":"CORPORATE","q":2227310,"pct":6.06,"d":"2026-07-29"},{"n":"Tập Đoàn Bưu Chính Viễn Thông Việt Nam","p":null,"t":"CORPORATE","q":2000000,"pct":5.45,"d":"2026-07-29"},{"n":"Công ty Cổ phần Phát triển Hạ tầng Kỹ thuật","p":null,"t":"CORPORATE","q":1700000,"pct":4.63,"d":"2026-08-28"},{"n":"Quỹ Đầu tư Cổ phiếu Kinh tế hiện đại VinaCapital","p":null,"t":"CORPORATE","q":412610,"pct":1.123,"d":"2026-01-23"},{"n":"Quảng Văn Viết Cương","p":null,"t":"INDIVIDUAL","q":75000,"pct":0.2,"d":"2026-02-23"},{"n":"Nguyễn Thị Thùy Dương","p":null,"t":"INDIVIDUAL","q":20400,"pct":0.055,"d":"2026-02-23"},{"n":"Phạm Thị Lan Thảo","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.04,"d":"2026-02-23"},{"n":"Nguyễn Văn Phúc","p":"Kế toán trưởng","t":"INDIVIDUAL","q":10300,"pct":0.028,"d":"2026-08-28"},{"n":"Võ Thị Thanh Hương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":6040,"pct":0.02,"d":"2026-08-28"},{"n":"Lê Thị Xuân Diệu","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":500,"pct":0.001,"d":"2026-08-28"},{"n":"Nguyễn Bá Thước","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":500,"pct":0.001,"d":"2026-08-28"}],"rel":[{"c":"3702979423