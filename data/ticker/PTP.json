2019",5.875],["2020",0.0],["2021",3.533],["2022",4.596],["2023",1.32],["2024",2.628],["2025",6.366]]}},"co":{"short":"Viễn Thông và In Bưu điện","profile":"Công ty Cổ phần PTP (PTP) tiền thân là nhà in Chính Nghĩa của tư nhân thời kỳ Pháp thuộc, được ngành Bưu điện mua lại. Nhà in Chính Nghĩa thành lập ngày 1/5/1957 với tên gọi là Xưởng in trực thuộc phòng cung ứng vật tư Tổng cục Bưu điện. Lĩnh vực kinh doanh chủ yếu của Công ty là: In các loại ấn phẩm, sách, báo, tạp chí, tem nhãn, phong bì, danh bạ điện thoại, bưu cục thuộc chi ngành bưu chính viễn thông; Tạo mẫu, chế bản và tách mẫu điện tử thuộc ngành in; Sản xuất các loại thẻ viễn thông, thẻ thông minh...Ngày 15/12/2009, PTP chính thức giao dịch trên thị trường UPCOM.","sector":"Viễn thông","type":"CT","listed":"2009-12-10","state":0.51,"foreign":0.00075,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập Đoàn Bưu Chính Viễn Thông Việt Nam","p":null,"t":"CORPORATE","q":3332000,"pct":49.0,"d":"2025-10-05"},{"n":"Nguyễn Hồng Lâm","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1023980,"pct":15.349,"d":"2025-10-05"},{"n":"Nguyễn Minh Phương","p":null,"t":"INDIVIDUAL","q":334000,"pct":5.01,"d":"2026-07-20"},{"n":"Đỗ Vân Anh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":164200,"pct":2.461,"d":"2025-10-05"},{"n":"Ngô Mạnh Hùng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":43700,"pct":0.655,"d":"2025-10-05"},{"n":"An Văn Tâm","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.294,"d":"2025-10-05"},{"n":"Huỳnh Quang Vinh","p":null,"t":"INDIVIDUAL","q":15468,"pct":0.227,"d":"2015-09-14"},{"n":"Nguyễn Triệu Long","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.15,"d":"2025-10-05"},{"n":"Phạm Thị Tần","p":null,"t":"INDIVIDUAL","q":6066,"pct":0.089,"d":"2015-09-14"},{"n":"Nguyễn Trọng Thấn","p":null,"t":"INDIVIDUAL","q":4586,"pct":0.067,"d":"2015-09-14"},{"n":"Hà Đình Hùng","p":null,"t":"INDIVIDUAL","q":4466,"pct":0.066,"d":"2015-09-14"},{"n":"Đỗ Văn Tấn","p