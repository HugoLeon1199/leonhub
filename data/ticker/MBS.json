 1.415,01 tỷ đồng, tăng 52.05%. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 15.18%, tăng 2.73%. MBS được niêm yết trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2016.","sector":"Dịch vụ tài chính","type":"CK","listed":"2016-03-28","state":0.0,"foreign":0.00301948,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ngân hàng Thương mại Cổ phần Quân đội","p":null,"t":"CORPORATE","q":664658254,"pct":66.404,"d":"2026-07-30"},{"n":"Lê Viết Hải","p":null,"t":"INDIVIDUAL","q":2507125,"pct":0.254,"d":"2026-07-30"},{"n":"Nguyễn Minh Hằng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1181971,"pct":0.12,"d":"2026-07-30"},{"n":"Lê Văn Tuấn","p":null,"t":"INDIVIDUAL","q":1049149,"pct":0.105,"d":"2026-07-30"},{"n":"Phan Phương Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":792441,"pct":0.079,"d":"2026-07-30"},{"n":"Lê Thành Nam","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":631981,"pct":0.063,"d":"2026-07-30"},{"n":"Công Đoàn Cơ Sở Thành Viên Ctcp Chứng Khoán Mb","p":null,"t":"CORPORATE","q":596009,"pct":0.06,"d":"2026-08-17"},{"n":"Trần Thị Thanh Huyền","p":"Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":365350,"pct":0.04,"d":"2026-07-30"},{"n":"Phạm Thị Kim Ngân","p":"Phó Tổng Giám đốc/Giám đốc Tài chính","t":"INDIVIDUAL","q":325650,"pct":0.033,"d":"2026-07-30"},{"n":"Phùng Thị Thanh Hà","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":316818,"pct":0.032,"d":"2026-07-30"},{"n":"Phạm Xuân Thanh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":300150,"pct":0.03,"d":"2026-07-30"},{"n":"Vũ Thị Hương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":232789,"pct":0.023,"d":"2026-07-30"},{"n":"Phạm Thị Hoa","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":172956,"pct":0.017,"d":"2026-07-30"},{"n":"Phạm Thế Anh","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":163650,"pct":0.016,"d":"2026-07-30"},{"n":"Lê Thu Trang","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":147150,"