dệt sợi với tổng công suất 16.560 tấn sợi/năm và 2.040 tấn khăn/năm. Bên cạnh đó, Công ty còn tham gia đầu tư phát triển và kinh doanh bất động sản nhà ở và hạ tầng khu công nghiệp với các dự án Tòa Nhà Dam San - Quang Trung tại Phường Quang Trung - Thành phố Thái Bình, Khu đô thị Phú Xuân - Damsan tại Thành phố Thái Bình và Cụm công nghiệp An Ninh tại xã An Ninh, huyện Tiền Hải, tỉnh Thái Bình. ADS được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 06/2016.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2016-06-29","state":0.0,"foreign":0.00140202,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Vũ Huy Đông","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":9206284,"pct":12.051,"d":"2026-08-19"},{"n":"Công ty TNHH Thương mại và Đầu tư Xây dựng ACC","p":null,"t":"CORPORATE","q":1513500,"pct":5.93,"d":"2020-08-13"},{"n":"Công ty Cổ phần Đầu Tư Xây Dựng Và Thương Mại Đức Tuấn","p":null,"t":"CORPORATE","q":4070100,"pct":5.33,"d":"2025-10-05"},{"n":"Đỗ Đức Khang","p":null,"t":"INDIVIDUAL","q":4058174,"pct":5.312,"d":"2026-08-27"},{"n":"Đỗ Văn Khôi","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3969500,"pct":5.196,"d":"2026-08-27"},{"n":"Hoàng Kim Thu","p":null,"t":"INDIVIDUAL","q":3703129,"pct":4.85,"d":"2025-10-05"},{"n":"Nguyễn Lê Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3612043,"pct":4.728,"d":"2026-08-27"},{"n":"Công ty Cổ phần Xây dựng Đức Dũng Thái Bình","p":null,"t":"CORPORATE","q":1730500,"pct":2.27,"d":"2026-08-26"},{"n":"Công ty TNHH Golf Long Hưng","p":null,"t":"CORPORATE","q":1638865,"pct":2.15,"d":"2026-08-27"},{"n":"Vũ Huy Đức","p":null,"t":"INDIVIDUAL","q":1539489,"pct":2.015,"d":"2026-08-27"},{"n":"Lương Thị Dung","p":null,"t":"INDIVIDUAL","q":1422291,"pct":1.86,"d":"2026-08-27"},{"n":"Vương Quốc Dương","p":"Phó Giám đốc Điều hành/Phó Tổng Giám đốc Sản xuất","t":"INDIVIDUAL","q":1145834,"pct":1.5,"d":"2026-08-27"},{"n":"Lê Văn Tuấn