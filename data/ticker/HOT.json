hế giới. Với gần 1.500 di tích, danh thắng, Hội An còn là nơi hội tụ của nhiều nên văn hóa đa dạng và đặc sắc như nền văn hóa Sa Huỳnh, làng nghề truyền thống tiêu biểu như Gốm Thanh hà, Làng rau Trà Quế và nhiều bãi biển đẹp, thơ mộng...Ngày 12/05/2023, HOT chính thức giao dịch trên thị trường UPCOM.","sector":"Du lịch và Giải trí","type":"CT","listed":"2011-07-21","state":0.56502975,"foreign":0.000165,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Văn Phòng Tỉnh Ủy Quảng Nam","p":null,"t":"CORPORATE","q":4520238,"pct":56.5,"d":"2026-03-03"},{"n":"Công ty Cổ phần Tập đoàn Đầu tư I.P.A","p":null,"t":"CORPORATE","q":1600475,"pct":20.01,"d":"2026-06-02"},{"n":"Lê Tiến Dũng","p":null,"t":"INDIVIDUAL","q":311484,"pct":3.9,"d":"2025-10-05"},{"n":"Phan Hồng Quân","p":null,"t":"INDIVIDUAL","q":36800,"pct":0.46,"d":"2015-09-14"},{"n":"Huỳnh Văn Tỵ","p":null,"t":"INDIVIDUAL","q":6816,"pct":0.085,"d":"2015-09-14"},{"n":"Lê Thị Thu Thủy","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":4136,"pct":0.052,"d":"2026-03-03"},{"n":"Đinh Thị Thúy Lan","p":null,"t":"INDIVIDUAL","q":3385,"pct":0.04,"d":"2026-03-03"},{"n":"Trần Đình Phong","p":null,"t":"INDIVIDUAL","q":1120,"pct":0.014,"d":"2015-09-14"},{"n":"Trình Thị Kim Quy","p":null,"t":"INDIVIDUAL","q":500,"pct":0.006,"d":"2025-10-05"},{"n":"Nguyễn Thị Thu Quanh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":401,"pct":0.005,"d":"2026-03-03"},{"n":"Phan Minh Ánh","p":null,"t":"INDIVIDUAL","q":100,"pct":0.001,"d":"2015-09-14"}],"rel":[{"c":"11064","n":"Công ty TNHH MTV Lữ Hành Hội An","t":"subsidiary","pct":100.0}],"rel_count":1,"events":[{"c":"AGME","t":"HOT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-04","record":"2026-03-18","ex":"2026-03-17"},{"c":"OTHE","t":"HOT - Thay đổi địa chỉ","d":"2025-09-15","record":null,"ex":null},{"c":"AGME","t":"HOT - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-06","record":"2025-03-25","ex":"2025-03-24"},{"