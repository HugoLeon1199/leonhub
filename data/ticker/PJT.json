ăm đã giúp Tổng Công ty bán một khối lượng lớn xăng dầu ra thị trường. Đội tàu của Công ty có 17 chiếc, tổng trọng tải 12,526 tấn, trong đó: Tàu biển: 05 chiếc, tổng trọng tải: 4,811 tấn, tàu sông: 12 chiếc, tổng trọng tải: 7,715 tấn. Ngày 28/12/2006, PJT chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-12-28","state":0.51224933,"foreign":0.00648718,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Vận Tải Thủy Petrolimex","p":null,"t":"CORPORATE","q":12746189,"pct":51.22,"d":"2026-07-30"},{"n":"Ngô Anh Dũng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2688923,"pct":10.8,"d":"2026-07-30"},{"n":"Phan Văn Kỳ","p":null,"t":"INDIVIDUAL","q":1255692,"pct":5.05,"d":"2026-07-30"},{"n":"Phạm Ngọc Sinh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":588829,"pct":2.28,"d":"2026-07-30"},{"n":"Đặng Thị Xuân Hương","p":null,"t":"INDIVIDUAL","q":114426,"pct":0.46,"d":"2026-03-11"},{"n":"Phan Anh Đức","p":null,"t":"INDIVIDUAL","q":112984,"pct":0.45,"d":"2026-07-30"},{"n":"Đàm Trọng Nghĩa","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":83413,"pct":0.34,"d":"2026-07-30"},{"n":"Đỗ Văn Long","p":null,"t":"INDIVIDUAL","q":76437,"pct":0.33,"d":"2025-10-05"},{"n":"Trương Thị Yến Nga","p":"Thư ký Hội đồng Quản Trị","t":"INDIVIDUAL","q":54000,"pct":0.22,"d":"2026-07-30"},{"n":"Nguyễn Quang Hiếu","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.185,"d":"2015-09-14"},{"n":"Phan Công Trung","p":null,"t":"INDIVIDUAL","q":43200,"pct":0.17,"d":"2026-07-30"},{"n":"Nguyễn Thị Hiền","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":40390,"pct":0.16,"d":"2026-07-30"},{"n":"Đinh Kim Oanh","p":null,"t":"INDIVIDUAL","q":37435,"pct":0.16,"d":"2025-10-05"},{"n":"Nguyễn Duy Hải","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":29627,"pct":0.12,"d":"2026-07-30"},{"n":"Phạm Văn Toản","p":"Phó Tổng Giám đốc","t":"I