ng bộ, được nhập khẩu trực tiếp với công nghệ tiên tiến nhất, đảm bảo chất lượng sản phẩm tối ưu. Ngày 27/01/2015, PBP hính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2015-01-27","state":0.51029458,"foreign":0.00818937,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần - Tổng Công ty Phân bón Dầu Khí Cà Mau","p":null,"t":"CORPORATE","q":2449167,"pct":51.03,"d":"2026-05-29"},{"n":"Dương Văn Cọp","p":null,"t":"INDIVIDUAL","q":352800,"pct":7.35,"d":"2026-05-29"},{"n":"Nguyễn Thị Liên","p":null,"t":"INDIVIDUAL","q":255069,"pct":5.31,"d":"2025-10-05"},{"n":"Lê Ngọc Dung","p":null,"t":"INDIVIDUAL","q":244600,"pct":5.1,"d":"2026-05-29"},{"n":"Nguyễn Hữu Kiệm","p":null,"t":"INDIVIDUAL","q":238066,"pct":4.96,"d":"2025-10-05"},{"n":"Phạm Duy Khánh","p":null,"t":"INDIVIDUAL","q":210000,"pct":4.38,"d":"2025-10-05"},{"n":"Cao Khải Hoàn","p":null,"t":"INDIVIDUAL","q":173495,"pct":3.61,"d":"2025-10-05"},{"n":"Lê Quốc Dũng","p":null,"t":"INDIVIDUAL","q":70000,"pct":1.458,"d":"2025-10-05"},{"n":"Nguyễn Đức Hạnh","p":null,"t":"INDIVIDUAL","q":8800,"pct":0.27,"d":"2025-10-05"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 8.5%","d":"2026-08-12","record":null,"ex":null},{"c":"DDIND","t":"Lê Ngọc Dung - Đăng kí Mua PBP","d":"2026-04-03","record":null,"ex":null},{"c":"AGME","t":"PBP - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-09","record":"2026-03-25","ex":"2026-03-24"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 850 VND","d":"2025-10-16","record":"2025-10-27","ex":"2025-10-24"},{"c":"AGME","t":"PBP - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-14","record":"2025-04-24","ex":"2025-04-23"},{"c":"DDINS","t":"Doanh Nghiệp Tư Nhân Phương Ngọc - Đăng kí Bán PBP","d":"2024-12-17","record":null,"ex":null},{"c":"DDIND","t":"Dương Văn Cọp - Đăng kí Mua PBP","d":"2024-12-17","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tứ