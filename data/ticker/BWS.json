["2025",20.853]]}},"co":{"short":"Cấp Nước Bà Rịa Vũng Tàu","profile":"Công ty Cổ phần Cấp Nước Bà Rịa - Vũng Tàu (BWS) có tiền thân là Xí nghiệp Cấp thoát nước Vũng Tàu - Bà Rịa, được thành lập vào năm 1982. Công ty hoạt động chính trong lĩnh vực khai thác, sản xuất và cung cấp nước sạch. BWS chính thức hoạt động theo mô hình công ty cổ phần từ năm 2007. Công ty hiện đang quản lý vận hành hệ thống sản xuất cấp nước với tổng công suất 240.000 m3/ngày trên địa bàn tỉnh Bà Rịa - Vũng Tàu. BWS được giao dịch trên thị trường UPCOM từ cuối năm 2017.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-11-28","state":0.42080279,"foreign":0.0059594,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Bà Rịa - Vũng Tàu","p":null,"t":"CORPORATE","q":36250503,"pct":36.25,"d":"2026-06-02"},{"n":"Tỉnh Ủy Tỉnh Bà Rịa - Vũng Tàu","p":null,"t":"CORPORATE","q":10512642,"pct":10.51,"d":"2026-06-02"},{"n":"Công ty Cổ phần Cấp Nước Phú Mỹ","p":null,"t":"CORPORATE","q":5067780,"pct":5.07,"d":"2026-08-07"},{"n":"Lê Thị Thanh Thủy","p":null,"t":"INDIVIDUAL","q":1632790,"pct":1.63,"d":"2026-08-07"},{"n":"Công ty Tnhh Một Thành Viên Thương Mại Dịch Vụ Kỹ Thuật D&B","p":null,"t":"CORPORATE","q":1250100,"pct":1.25,"d":"2026-08-07"},{"n":"Võ Văn Bình","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1250100,"pct":1.25,"d":"2026-08-07"},{"n":"Đinh Chí Đức","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":661571,"pct":0.662,"d":"2026-08-07"},{"n":"Đinh Thị Khánh Linh","p":null,"t":"INDIVIDUAL","q":643088,"pct":0.643,"d":"2026-02-06"},{"n":"Nguyễn Lương Điền","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":631841,"pct":0.63,"d":"2026-08-07"},{"n":"Nguyễn Tiến Lạng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":608738,"pct":0.61,"d":"2026-08-07"},{"n":"Nguyễn Thị Kim Chi","p":null,"t":"INDIVIDUAL","q":530166,"pct":0.53,"d":"2026-08-07"},{"n":"Nguyễn Cảnh Tùng","p":"T