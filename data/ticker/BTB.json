",2.349],["2022",4.815],["2023",3.315],["2024",1.52],["2025",1.013]]}},"co":{"short":"Bia Hà Nội - Thái Bình","profile":"Công ty Cổ phần Bia Hà Nội - Thái Bình (BTB) có tiền thân là Công ty Bia Thái Bình, được thành lập vào ngày 29/08/2002 được thành lập trên cơ sở hợp nhất giữa Công ty Bia-Rượu-Ong Thái Bình và Nhà máy Bia Thái Bình. Hoạt động chủ yếu của Công ty là sản xuất kinh doanh bia chai 450ml Hà Nội và bia hơi Thái Bình. BTB chính thức hoạt động theo mô hình công ty cổ phần từ năm 2005. Công ty đang quản lý và vận hành Nhà máy Bia Hà Nội-Thái Bình với công suất 50 triệu lít/năm. Các sản phẩm bia của Công ty được sản xuất theo quy trình kiểm soát chất lượng tiêu chuẩn quốc tế ISO 9001.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-01-12","state":0.66309324,"foreign":0.00014302,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Bia - Rượu - Nước giải khát Hà Nội","p":null,"t":"CORPORATE","q":5100000,"pct":66.309,"d":"2026-08-13"},{"n":"Đinh Văn Thuận","p":null,"t":"INDIVIDUAL","q":500000,"pct":6.5,"d":"2025-10-05"},{"n":"Vũ Thanh Liêm","p":null,"t":"INDIVIDUAL","q":53800,"pct":0.7,"d":"2025-10-05"},{"n":"Hoàng Trọng Thư","p":null,"t":"INDIVIDUAL","q":25047,"pct":0.33,"d":"2025-10-05"},{"n":"Phạm Trung Kiên","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":23300,"pct":0.303,"d":"2026-08-13"},{"n":"Phạm Trung Kiên","p":null,"t":"INDIVIDUAL","q":23200,"pct":0.3,"d":"2021-09-09"},{"n":"Nguyễn Hữu Cường","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":12800,"pct":0.166,"d":"2026-08-13"},{"n":"Đỗ Duyên Ninh","p":null,"t":"INDIVIDUAL","q":13000,"pct":0.16,"d":"2025-10-05"},{"n":"Phạm Xuân Hạnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5108,"pct":0.066,"d":"2026-08-13"},{"n":"Nguyễn Minh Thế","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.065,"d":"2025-10-05"},{"n":"Bùi Quang Vượng","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":4274,"pct":0.056,"d":"2026-