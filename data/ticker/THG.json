thân là Công ty Xây dựng Thủy lợi Tiền Giang được thành lập vào năm 2003. Hoạt động kinh doanh của Công ty bao gồm thi công xây dựng, kinh doanh bất động sản, sản xuất kinh doanh vật liệu xây dựng, xí nghiệp cơ khí sửa chữa. Doanh thu chính của Công ty đến từ hoạt động thi công công trình và hoạt động kinh doanh bê tông thương phẩm và sản phẩm bê tông đúc sẵn.THG được niêm yết trên Sở Giao dịch Chứng khoán Hồ Chí Minh (HOSE) từ tháng 07/2011.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2011-07-28","state":0.0,"foreign":0.04269297,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thanh Nghĩa","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1716657,"pct":4.88,"d":"2026-08-24"},{"n":"Nguyễn Chí Tâm","p":null,"t":"INDIVIDUAL","q":472827,"pct":4.728,"d":"2015-09-14"},{"n":"Trần Hoàng Huân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1637554,"pct":4.66,"d":"2026-08-24"},{"n":"Vũ Huy Giáp","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1583203,"pct":4.5,"d":"2026-08-24"},{"n":"Công ty Cổ phần Chứng khoán BIDV","p":null,"t":"CORPORATE","q":395270,"pct":3.953,"d":"2015-06-15"},{"n":"Nguyễn Thị Hường","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1278111,"pct":3.63,"d":"2026-08-24"},{"n":"Lê Văn Điệp","p":null,"t":"INDIVIDUAL","q":292790,"pct":2.928,"d":"2015-09-14"},{"n":"Công ty CP Đầu Tư Xây Dựng Gia Thắng","p":null,"t":"CORPORATE","q":888722,"pct":2.53,"d":"2026-08-24"},{"n":"Nguyễn Hoài Bắc","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":801695,"pct":2.28,"d":"2026-08-24"},{"n":"Ban Chấp Hành Công Đoàn Cơ Sở Công ty Cổ Phần Đầu Tư Và Xây Dựng Tiền Giang","p":null,"t":"CORPORATE","q":703965,"pct":2.0,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Đầu Tư Gia Thy","p":null,"t":"CORPORATE","q":566426,"pct":1.61,"d":"2026-08-24"},{"n":"Lê Quang Tiên","p":null,"t":"INDIVIDUAL","q":127000,"pct":1.27,"d":"2015-09-14"},{"n":"Nguyễn Hữu Hiệp","p":"Phó Tổng Giám đốc","t