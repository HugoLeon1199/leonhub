g gia dụng và hàng may mặc.Công ty hiện đang quản lý và vận hành 52 dây chuyền may của Nhà máy may Bình Thạnh, Nhà Máy may Thạnh Mỹ, Nhà máy tại Huế. Đối với mặt hàng gia dụng, GIL có Nhà máy sản xuất thiết bị chiếu sáng và chao đèn với công suất 8.000 sản phẩm/ngày và 3.000 sản phẩm đèn/ngày. Thị trường xuất khẩu chủ yếu của công ty là Châu Âu và Mỹ.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2002-01-02","state":0.0,"foreign":0.01243999,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Hùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":9049264,"pct":8.91,"d":"2026-08-05"},{"n":"Công ty Cổ phần Xuất nhập khẩu Thủy sản Bến Tre","p":null,"t":"CORPORATE","q":1048300,"pct":7.528,"d":"2015-06-15"},{"n":"Lê Anh Thư","p":null,"t":"INDIVIDUAL","q":4938217,"pct":7.06,"d":"2025-10-05"},{"n":"Pxp Vietnam Fund Limited","p":null,"t":"CORPORATE","q":687500,"pct":4.937,"d":"2015-06-15"},{"n":"Nguyễn Phương Đông","p":null,"t":"INDIVIDUAL","q":3211504,"pct":4.65,"d":"2025-10-05"},{"n":"Đoàn Thị Hồng Thúy","p":null,"t":"INDIVIDUAL","q":626170,"pct":4.497,"d":"2015-09-14"},{"n":"Nguyễn Minh Châu","p":null,"t":"INDIVIDUAL","q":617380,"pct":4.434,"d":"2015-09-14"},{"n":"Công ty Tài Chính TNHH MTV Bưu Điện","p":null,"t":"CORPORATE","q":604060,"pct":4.338,"d":"2015-06-15"},{"n":"Nguyễn Hữu Phúc","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2913413,"pct":2.868,"d":"2026-08-05"},{"n":"Công ty CP May Hàng Gia Dụng Gilimex-ppj","p":null,"t":"CORPORATE","q":2847517,"pct":2.8,"d":"2026-02-09"},{"n":"Vietnam Emerging Equity Fund Limited","p":null,"t":"CORPORATE","q":277615,"pct":1.994,"d":"2015-06-15"},{"n":"Phan Quang Đài","p":null,"t":"INDIVIDUAL","q":204292,"pct":1.467,"d":"2015-09-14"},{"n":"Tổng Công ty Bến Thành - TNHH MTV","p":null,"t":"CORPORATE","q":190856,"pct":1.371,"d":"2015-06-15"},{"n":"Nguyễn Việt Cường","p":null,"t":"INDIVIDUAL","q":1170000,"pct":1.15,"d":"2026-02-09"},{"n":"LION Capital Việt Nam Fund","p":nu