 dục, công ty có lợi thế về cả nguồn vào và nguồn ra đều ổn định, kế thừa được thương hiệu và mạng lưới đại lý. Hiện tại, sản phẩm chính của công ty là sách tham khảo đấu thầu của Nhà xuất bản Giáo dục. DAE chính thức được niêm yết trên HNX từ năm 2006.","sector":"Truyền thông","type":"CT","listed":"2006-12-28","state":0.29412128,"foreign":0.00463893,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Nhà Xuất Bản Giáo Dục Việt Nam","p":null,"t":"CORPORATE","q":566377,"pct":29.41,"d":"2025-10-16"},{"n":"Công ty Cổ phần Đầu tư và Phát triển Giáo dục Đà Nẵng","p":null,"t":"CORPORATE","q":307500,"pct":15.97,"d":"2025-10-16"},{"n":"Mekong Portfolio Investments Limited","p":null,"t":"CORPORATE","q":207600,"pct":13.852,"d":"2015-06-15"},{"n":"Hồ Văn Lĩnh","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":234640,"pct":12.18,"d":"2026-08-11"},{"n":"Lý Xuân Hoàn","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":212025,"pct":11.01,"d":"2026-08-11"},{"n":"Dương Khánh Vinh","p":null,"t":"INDIVIDUAL","q":116300,"pct":6.04,"d":"2025-10-05"},{"n":"Yu Jen Chieh","p":null,"t":"INDIVIDUAL","q":74900,"pct":5.0,"d":"2025-10-05"},{"n":"Nguyễn Lệ Thủy","p":null,"t":"INDIVIDUAL","q":67900,"pct":4.531,"d":"2015-09-14"},{"n":"Nguyễn Hữu Hiếu","p":null,"t":"INDIVIDUAL","q":63700,"pct":4.25,"d":"2025-10-05"},{"n":"Phạm Nhiêu","p":null,"t":"INDIVIDUAL","q":11769,"pct":0.78,"d":"2025-10-05"},{"n":"Nguyễn Thế Dũng","p":null,"t":"INDIVIDUAL","q":11538,"pct":0.77,"d":"2025-10-05"},{"n":"Nguyễn Việt Hùng","p":null,"t":"INDIVIDUAL","q":10500,"pct":0.701,"d":"2015-09-14"},{"n":"Ông Thị Kỹ Thuật","p":null,"t":"INDIVIDUAL","q":10280,"pct":0.54,"d":"2026-08-12"},{"n":"Trần Trọng Hiếu","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":5425,"pct":0.28,"d":"2026-08-11"},{"n":"Phan Thị Hàn Phong","p":"Trưởng phòng","t":"INDIVIDUAL","q":5329,"pct":0.277,"d":"2025-10-05"},{"n":"Nguyễn Vũ