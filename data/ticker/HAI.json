",0.102],["2023",-1.132],["2024",0.895]]}},"co":{"short":"Nông Dược HAI","profile":"Công ty Cổ phần Nông dược HAI (HAI) có tiền thân là Công ty Vật tư bảo vệ thực vật phía Nam, được thành lập vào năm 1986. Công ty hoạt động trong lĩnh vực sản xuất, kinh doanh phân phối các sản phẩm thuốc trừ cỏ, thuốc trừ sâu, thuốc trừ bệnh, phân bón lá và hạt giống. HAI chính thức hoạt động theo mô hình công ty cổ phần từ năm 2005. Công ty đang quản lý vận hành Nhà máy sản xuất Nông Dược HAI tại Long An với tổng công suất sản xuất – phối liệu đạt 5.000 tấn/năm, tổng công suất chiết rót – đóng gói đạt 8.000 tấn/năm. Nông dược H.A.I hiện là nhà phân phối độc quyền các sản phẩm cho nhiều công ty đa quốc gia hàng đầu thế giới về nghiên cứu sản xuất hoá chất như Dow AgroSciences, DuPont, Monsanto của Hoa Kỳ, công ty BASF của Đức, các công ty Sumitomo Chemicals, Nissan, Mitsui, Ishihara của Nhật Bản, và của một số quốc gia khác.","sector":"Hóa chất","type":"CT","listed":"2006-12-27","state":0.0,"foreign":0.01177611,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn FLC","p":null,"t":"CORPORATE","q":15097400,"pct":8.26,"d":"2025-10-05"},{"n":"Phạm Văn Nùng","p":null,"t":"INDIVIDUAL","q":5855715,"pct":4.99,"d":"2025-10-05"},{"n":"Quỹ tầm nhìn SSI","p":null,"t":"CORPORATE","q":807176,"pct":0.688,"d":"2015-06-15"},{"n":"Nguyễn Hồng Phong","p":null,"t":"INDIVIDUAL","q":500000,"pct":0.426,"d":"2015-09-14"},{"n":"Công ty cổ phần Hóc Môn","p":null,"t":"CORPORATE","q":250000,"pct":0.213,"d":"2015-06-15"},{"n":"Trần Văn Phát","p":null,"t":"INDIVIDUAL","q":197908,"pct":0.169,"d":"2015-09-14"},{"n":"Nguyễn Chí Linh","p":null,"t":"INDIVIDUAL","q":139320,"pct":0.119,"d":"2015-09-14"},{"n":"Quách Thành Đồng","p":null,"t":"INDIVIDUAL","q":213400,"pct":0.117,"d":"2025-12-09"},{"n":"Trần Quang Huy","p":null,"t":"INDIVIDUAL","q":200000,"pct":0.11,"d":"2025-10-05"},{"n":"Nguyễn Thị Lệ Hằng","p":null,"t":"INDIVIDUAL","q":119000,"pct":0.101,"d":"2015-