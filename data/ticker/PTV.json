",-0.429],["2025-Q4",-0.805],["2026-Q1",-0.955],["2026-Q2",-0.637]],"y":[["2019",-0.648],["2020",-0.58],["2021",-1.992],["2022",-0.834],["2023",-0.652],["2024",-0.647],["2025",-0.805]]}},"co":{"short":"Thương mại dầu khí","profile":"Công ty cổ phần Thương Mại Dầu Khí (PTV), tiền thân là Công ty Nhập khẩu Thiết bị và Dịch vụ Dầu Khí, được thành lập từ năm 1981. Năm 2008, Công ty chuyển đổi mô hình kinh doanh hoạt động là Công ty Cổ phần. Với hơn 35 năm kinh nghiệm trong lĩnh vực nhập khẩu, cung ứng thiết bị cho ngành dầu khí, Công ty đã và đang là đơn vị cung cấp thiết bị cho nhiều khách hàng là các công ty lớn trong ngành như VIETSOVPETRO, PVOIL, PTSC, PV GAS…Bên cạnh đó, Công ty cũng đã và đang triển khai chiến lược đa dạng hóa ngành nghề kinh doanh và mở rộng phân khúc thị trường ở cả lĩnh vực upstream và downstream bằng việc tham gia vào lĩnh vực thương mại đầu tư và cung cấp các sản phẩm phần mềm quản lý cho các công ty trong ngành dầu khí. Công ty hiện đang quản lý và vận hành Kho cảng xăng dầu Petechim - Nhà Bè. Nhà kho có sức chứa 200.000m3 xăng dầu trong khi bến cảng có thể tiếp nhận các tàu có trọng tải lên đến 25.000 tấn. Ngày 05/11/2019, PTV chính thức giao dịch trên thị trường UPCOM.","sector":"Dầu khí","type":"CT","listed":"2019-11-05","state":0.29,"foreign":5e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Dầu Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":5800000,"pct":29.0,"d":"2026-08-17"},{"n":"Công ty Cổ phần Đầu tư và Xây dựng Tràng An","p":null,"t":"CORPORATE","q":4620000,"pct":23.1,"d":"2026-08-17"},{"n":"Dương Công Ái","p":null,"t":"INDIVIDUAL","q":3380000,"pct":16.9,"d":"2026-03-04"},{"n":"Công ty TNHH Petunia","p":null,"t":"CORPORATE","q":999300,"pct":4.997,"d":"2026-01-12"},{"n":"Công ty TNHH Đầu Tư Blue Sky Việt Nam","p":null,"t":"CORPORATE","q":995300,"pct":4.977,"d":"2026-01-12"},{"n":"Nguyễn Ngọc Anh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":2000,"pct":0.01,"d":"2026-08-17"