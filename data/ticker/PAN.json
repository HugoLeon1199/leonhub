ng ty nắm giữ cổ phần chi phối tại những công ty có các uy tín trong lĩnh vực nông nghiệp, thủy sản, thực phẩm và phân phối. Thông qua các công ty con và công ty liên kết, PAN cung cấp các sản phẩm về nông nghiệp và thực phẩm như giống cây trồng, thủy hải sản, thực phẩm tiện lợi, thực phẩm hàng ngày, các sản phẩm nông dược, khử trùng, và kiểm soát dịch hại. Cổ phiếu của Công ty (PAN) được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2006-12-22","state":0.0,"foreign":0.2162794,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Chứng khoán SSI","p":null,"t":"CORPORATE","q":31954431,"pct":12.75,"d":"2026-08-13"},{"n":"Công ty TNHH Đầu tư NDH","p":null,"t":"CORPORATE","q":28594712,"pct":11.41,"d":"2026-08-13"},{"n":"The Asian Entrepreneur Legacy (TAEL)","p":null,"t":"CORPORATE","q":8073000,"pct":9.71,"d":"2015-06-15"},{"n":"Công ty Cổ phần PAN Farm","p":null,"t":"CORPORATE","q":15390932,"pct":7.11,"d":"2021-05-12"},{"n":"Công ty Cổ phần Đầu tư Đường Mặt Trời","p":null,"t":"CORPORATE","q":10455500,"pct":5.005,"d":"2026-06-05"},{"n":"Công ty Cổ phần CSC Việt Nam","p":null,"t":"CORPORATE","q":12498842,"pct":4.99,"d":"2026-08-13"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":9378745,"pct":4.49,"d":"2025-10-05"},{"n":"Công ty TNHH Bất Động Sản Sài Gòn Đan Linh","p":null,"t":"CORPORATE","q":6943752,"pct":2.77,"d":"2026-08-13"},{"n":"Công ty TNHH Nguyễn Sài Gòn","p":null,"t":"CORPORATE","q":4404007,"pct":1.76,"d":"2026-08-13"},{"n":"Bùi Thanh Vân","p":null,"t":"INDIVIDUAL","q":675000,"pct":0.812,"d":"2015-09-14"},{"n":"Quỹ tầm nhìn SSI","p":null,"t":"CORPORATE","q":526220,"pct":0.633,"d":"2015-06-15"},{"n":"Nguyễn Duy Hưng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1471200,"pct":0.59,"d":"2026-08-13"},{"n":"Nguyễn Thị Trà My","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1164319,"pct