n thân là Công ty cổ phần xi măng Sông Đà, thành lập năm 1993. Năm 2002, Công ty chính thức chuyển đổi thành Công ty Cổ phần. Công ty chủ yếu hoạt trọng trong lĩnh vực sản xuất kinh doanh vật liệu xây dựng, khai thác và tận thu khoáng sản... Trong đó, sản phẩm chính của Công ty hiện nay bao gồm: - Xi măng bao PCB 30 và xi măng rời - và dịch vụ vận chuyển chủ yếu phục vụ khách hàng trong quá trình tiêu thụ sản phẩm. Hiện tại doanh thu của công ty chủ yếu đến từ hoạt động sản xuất và cung cấp xi măng (chiếm khoảng 90%), trong đó chủ yếu là cung ứng cho Tổng công ty Sông Đà và các đơn vị thành viên trực thuộc tổng công ty. Ngày 06/08/2014, SCC chính thức giao dịch trên thị trường thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-20","state":0.00657946,"foreign":0.00468792,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đỗ Văn Trường","p":null,"t":"INDIVIDUAL","q":1917300,"pct":39.25,"d":"2026-08-04"},{"n":"Công ty Cổ Phần Đầu Tư Thương Mại Hưng Long Tỉnh Điện Biên","p":null,"t":"CORPORATE","q":1082500,"pct":22.16,"d":"2026-08-04"},{"n":"Nguyễn Đức Thuận","p":null,"t":"INDIVIDUAL","q":900000,"pct":18.779,"d":"2026-08-04"},{"n":"Trần Thị Kim Thoa","p":null,"t":"INDIVIDUAL","q":91100,"pct":4.826,"d":"2015-09-14"},{"n":"Trần Đức Minh","p":null,"t":"INDIVIDUAL","q":60700,"pct":3.216,"d":"2015-09-14"},{"n":"Nguyễn Tự Hào","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":44000,"pct":0.918,"d":"2026-08-04"},{"n":"Trương Văn Hiển","p":null,"t":"INDIVIDUAL","q":13800,"pct":0.696,"d":"2025-10-05"},{"n":"Phạm Văn Cung","p":null,"t":"INDIVIDUAL","q":10400,"pct":0.551,"d":"2015-09-14"},{"n":"Nguyễn Công Thưởng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.53,"d":"2015-09-14"},{"n":"Phạm Trọng Quý","p":null,"t":"INDIVIDUAL","q":6030,"pct":0.319,"d":"2015-09-14"},{"n":"Nguyễn Văn Xuyên","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.265,"d":"2015-09-14"},{"n":"Bùi Minh Lượng","p":null,"t":"INDIVIDUAL","q":4700,"pct":