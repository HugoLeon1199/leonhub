,["2020",0.0],["2021",9.155],["2022",14.58],["2023",12.813],["2024",11.787],["2025",13.393]]}},"co":{"short":"Cấp nước Trung An","profile":"Công ty Cổ phần Cấp nước Trung An (TAW), tiền thân là Xí nghiệp Cấp nước Trung An, được thành lập năm 2005. Công ty hoạt động chính trong lĩnh vực khai thác, xử lý và cung cấp nước sạch. TAW chính thức hoạt động theo mô hình công ty cổ phần từ năm 2015. Công ty chủ yếu cung cấp nước sạch trên địa bàn quận Gò Vấp, quận 12 và huyện Hóc Môn, thành phố Hồ Chí Minh. TAW được giao dịch trên thị trường UPCOM từ tháng 07/2016.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2016-07-29","state":0.65,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cấp nước Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":3250000,"pct":65.0,"d":"2026-08-24"},{"n":"Hồ Lê Minh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":726710,"pct":14.53,"d":"2026-08-24"},{"n":"Công Ty TNHH Thương Mại N.T.P","p":null,"t":"CORPORATE","q":517500,"pct":10.35,"d":"2026-08-24"},{"n":"Võ Thị Hồng Hà","p":null,"t":"INDIVIDUAL","q":7100,"pct":0.142,"d":"2026-03-04"},{"n":"Nguyễn Minh Hải","p":"Phó Giám đốc","t":"INDIVIDUAL","q":3700,"pct":0.07,"d":"2026-08-24"},{"n":"Phan Kim Phượng","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":3500,"pct":0.07,"d":"2026-08-24"},{"n":"Võ Khánh Toàn","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":2100,"pct":0.042,"d":"2025-10-05"},{"n":"Trần Đức Hùng","p":"Kế toán trưởng","t":"INDIVIDUAL","q":900,"pct":0.02,"d":"2026-08-24"},{"n":"Nguyễn Thị Thanh Phương","p":null,"t":"INDIVIDUAL","q":800,"pct":0.016,"d":"2025-10-05"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 3 2023 - 215 VND","d":"2026-05-15","record":"2026-06-05","ex":"2026-06-04"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,300 VND","d":"2026-05-15","record":"2026-06-05","ex":"2026-06-04"},{"c":"AGME","t":"TAW - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-27","reco