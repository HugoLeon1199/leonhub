 Hùng, Toà nhà Attalanta - 49 Hàng Chuối…","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-07-23","state":0.38284,"foreign":2e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Đầu Tư Kinh Doanh Phát Triển Nhà Tcl Hà Nội","p":null,"t":"CORPORATE","q":849975,"pct":17.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Hà Châu","p":null,"t":"CORPORATE","q":560087,"pct":11.202,"d":"2015-06-15"},{"n":"Công ty TNHH Sunshine Financial Holdings","p":null,"t":"CORPORATE","q":850000,"pct":10.93,"d":"2025-10-05"},{"n":"Công ty TNHH Shizuoka Elite Fund","p":null,"t":"CORPORATE","q":760000,"pct":9.77,"d":"2025-10-05"},{"n":"Công ty TNHH West Hampton Investments","p":null,"t":"CORPORATE","q":760000,"pct":9.77,"d":"2025-10-05"},{"n":"Công ty TNHH FinanceSM Việt Nam","p":null,"t":"CORPORATE","q":625500,"pct":8.04,"d":"2025-10-05"},{"n":"Công ty TNHH SD-ONE Việt Nam","p":null,"t":"CORPORATE","q":426500,"pct":5.48,"d":"2025-10-05"},{"n":"Công ty Cổ phần Quản lý Kinh doanh Nhà và Đô thị Sông Đà 1","p":null,"t":"CORPORATE","q":419900,"pct":5.4,"d":"2025-10-05"},{"n":"Công ty Cổ phần Sông Đà 1.02 Hà Nội","p":null,"t":"CORPORATE","q":418303,"pct":5.38,"d":"2025-10-05"},{"n":"Công ty Cổ phần Sông Đà 9","p":null,"t":"CORPORATE","q":245000,"pct":4.9,"d":"2015-06-15"},{"n":"Nguyễn Xuân Dũng","p":null,"t":"INDIVIDUAL","q":300000,"pct":3.86,"d":"2025-10-05"},{"n":"Zhen Lan Ying","p":null,"t":"INDIVIDUAL","q":189700,"pct":3.794,"d":"2015-09-14"},{"n":"Lại Việt Cường","p":null,"t":"INDIVIDUAL","q":71500,"pct":1.43,"d":"2015-09-14"},{"n":"Nguyễn Duy Kiên","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.8,"d":"2015-09-14"},{"n":"Nguyễn Đức Ngọ","p":null,"t":"INDIVIDUAL","q":26000,"pct":0.52,"d":"2015-09-14"},{"n":"Đào Trung Dũng","p":null,"t":"INDIVIDUAL","q":13000,"pct":0.26,"d":"2015-09-14"},{"n":"Trần Ngọc Huy","p":null,"t":"INDIVIDUAL","q":11120,"pct":0.222,"d":"2015-09-14"},{"n":"Đặng Hoàng Long","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.2,