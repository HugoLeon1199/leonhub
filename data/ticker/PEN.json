ai 5, nhà máy thủy điện Sông Bung 2, nhà máy thủy điện Xekaman 1, v.v... Ngày 25/09/2014, PEN chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2014-09-25","state":0.3,"foreign":0.0002,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV - Tổng Công ty Xây Lắp Và Thương Mại Petrolimex","p":null,"t":"CORPORATE","q":1500000,"pct":30.0,"d":"2025-10-16"},{"n":"Ngân hàng Thương mại Cổ phần Thịnh vượng và Phát triển","p":null,"t":"CORPORATE","q":260000,"pct":5.2,"d":"2015-06-15"},{"n":"Nguyễn Thị Phượng","p":"Phó Giám đốc","t":"INDIVIDUAL","q":249120,"pct":4.98,"d":"2025-12-24"},{"n":"Vũ Lộc","p":null,"t":"INDIVIDUAL","q":239760,"pct":4.79,"d":"2025-10-05"},{"n":"Nguyễn Hồng Kỳ","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":214360,"pct":4.287,"d":"2025-10-05"},{"n":"Hà Thị Xuân Anh","p":null,"t":"INDIVIDUAL","q":210000,"pct":4.2,"d":"2025-10-05"},{"n":"Cung Quang Hà","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":198740,"pct":3.974,"d":"2025-10-05"},{"n":"Lê Huy Thủy","p":null,"t":"INDIVIDUAL","q":139760,"pct":2.8,"d":"2026-04-28"},{"n":"Đặng Đình Thắng","p":null,"t":"INDIVIDUAL","q":119630,"pct":2.393,"d":"2015-09-14"},{"n":"ĐINH MINH THẮNG","p":null,"t":"INDIVIDUAL","q":92500,"pct":1.85,"d":"2025-10-05"},{"n":"Trần Ngọc Hải","p":null,"t":"INDIVIDUAL","q":79660,"pct":1.59,"d":"2025-10-05"},{"n":"Lê Trung Dũng","p":null,"t":"INDIVIDUAL","q":72020,"pct":1.44,"d":"2015-09-14"},{"n":"Công ty Cổ phần Xăng dầu Sông Châu","p":null,"t":"CORPORATE","q":50000,"pct":1.0,"d":"2015-06-15"},{"n":"Lý Trý Thắng","p":null,"t":"INDIVIDUAL","q":28040,"pct":0.56,"d":"2025-10-05"},{"n":"Hoàng Trần Như Quỳnh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":27610,"pct":0.55,"d":"2025-10-05"},{"n":"Nguyễn Sum","p":null,"t":"INDIVIDUAL","q":18420,"pct":0.37,"d":"2025-10-05"},{"n":"Dương Minh Trí","p":"Phó Giám đốc","t":"INDIVIDUAL","q":11860,"pct":0.24,"d":"2025-10-05"