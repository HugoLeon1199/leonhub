2020",0.0],["2021",1.073],["2022",0.913],["2023",1.023],["2024",0.839],["2025",0.391]]}},"co":{"short":"In Tổng hợp Bình Dương","profile":"Công ty Cổ phần In Tổng hợp Bình Dương (IBD) có tiền thân là Xí nghiệp In Sông Bé được thành lập vào năm 1988. Công ty hoạt động chủ yếu trong lĩnh vực in ấn, in tổng hợp và in bao bì. IBD chính thức hoạt động theo mô hình công ty cổ phần từ tháng 01/2019. Sản phẩm chủ yếu của Công ty là in offset trên chất liệu giấy, biểu mẫu, sách, tạp chí, bao bì hộp giấy, và đặc biệt in các chứng từ có giá như hóa đơn giá trị gia tăng, vé cầu đường, vé số các loại. Một số khách hàng nổi bật của IBD là Bibica, Richy, First, Trung Nguyên, các công ty xổ số kiến thiết khu vực miền Trung. IBD được giao dịch trên thị trường UPCOM từ cuối tháng 05/2019.","sector":"Truyền thông","type":"CT","listed":"2019-05-24","state":0.79158889,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Xổ Số Kiến Thiết Bình Dương","p":null,"t":"CORPORATE","q":2610000,"pct":29.0,"d":"2025-10-05"},{"n":"Hách Thanh Toàn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1780710,"pct":19.79,"d":"2025-10-05"},{"n":"Nguyễn Thị Như Hoa","p":null,"t":"INDIVIDUAL","q":1379059,"pct":15.32,"d":"2025-10-05"},{"n":"Nguyễn Thị Thùy Dương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":311891,"pct":3.47,"d":"2026-03-04"},{"n":"Trần Thị Hương Xuân","p":null,"t":"INDIVIDUAL","q":282080,"pct":3.13,"d":"2025-10-05"},{"n":"NGUYỄN CÔNG LUẬN","p":null,"t":"INDIVIDUAL","q":179021,"pct":1.99,"d":"2025-10-05"},{"n":"Nguyễn Hoàng Thắng","p":null,"t":"INDIVIDUAL","q":100600,"pct":1.12,"d":"2025-10-05"},{"n":"Nguyễn Minh Hiếu","p":null,"t":"INDIVIDUAL","q":100600,"pct":1.12,"d":"2025-10-05"},{"n":"ĐẶNG HOÀNG ÂN","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":81500,"pct":0.91,"d":"2025-10-05"},{"n":"Lê Thị Hồng Thu","p":null,"t":"INDIVIDUAL","q":6100,"pct":0.07,"d":"2025-10-05"},{"n":"Lê Thị Đào","p":null,