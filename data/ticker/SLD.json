4",0.11],["2026-Q1",0.786],["2026-Q2",0.13]],"y":[["2025",0.11]]},"roic":{"q":[["2025-Q3",-1.738],["2025-Q4",-1.059],["2026-Q1",-1.043],["2026-Q2",-1.06]],"y":[["2025",-1.059]]}},"co":{"short":"Địa Ốc Sacom","profile":"Công ty Cổ phần Địa ốc Sacom (SLD) được thành lập vào năm 2008. Công ty hoạt động chính trong lĩnh vực kinh doanh bất động sản, bao gồm chủ yếu là các dự án nhà ở chung cư và trung tâm thương mại. Ngoài ra, SLD còn tham gia phân phối các dự án bất động sản với vai trò là nhà đầu tư thứ cấp. SLD đã và đang đầu tư phát triển các dự án Samland Airport, Dự án Samland Riverside (1 block), dự án Samland Tân Vạn (3 block), dự án KDC Samland Nhơn Trạch, dự án KDC Nhơn Trạch, và dự án trung tâm thương mại - Dịch vụ - Văn phòng và Căn hộ chung cư SG - HN (1 Block). Bên cạnh đó, SLD tham gia phân phối các dự án Samland Giai Việt - Block B2 và Dự án Hoàng Anh Riverview với tư cách là nhà đầu tư thứ cấp. Ngày 15/08/2025, SLD chính thức giao dịch trên thị trường UPCOM.","sector":"Bất động sản","type":"CT","listed":"2025-08-15","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần SAM Holdings","p":null,"t":"CORPORATE","q":67345246,"pct":85.71,"d":"2026-07-02"},{"n":"Huỳnh Đức Thanh","p":null,"t":"INDIVIDUAL","q":4399369,"pct":5.6,"d":"2026-07-02"},{"n":"Nguyễn Thu Hằng","p":"Chủ tịch Hội đồng Quản trị/Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":111,"pct":0.0,"d":"2026-02-12"}],"events":[{"c":"EGME","t":"SLD - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-07-09","record":"2026-07-27","ex":"2026-07-24"},{"c":"AGME","t":"SLD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-05","record":"2026-03-24","ex":"2026-03-23"},{"c":"DDIND","t":"Huỳnh Đức Thanh - Đăng kí Mua SLD","d":"2025-09-24","record":null,"ex":null},{"c":"NLIS","t":"SLD - Chính thức đăng ký giao dịch trên UPCOM","d":"2025-08-08","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 1.3%","d":"2021-