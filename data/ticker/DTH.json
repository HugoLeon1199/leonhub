 công ty là sản xuất kinh doanh thuốc đông dược, tân dược, thực phẩm chức năng. Một số sản phẩm chính của công ty hiện nay như: Hyđan, thuốc bổ BIOFIL, khoáng chất và Vitamin các loại. Công ty có 02 nhà máy sản xuất đạt tiêu chuẩn WHO – GMP là Nhà máy sản xuất thuốc Đông Dược (khu Công nghiệp Tây Bắc Ga – TP Thanh Hóa) và Nhà máy sản xuất thuốc Tân Dược. Các sản phẩm của DTH có mặt trong hệ thống bệnh viện đa khoa trên 64 tỉnh thành và các trung tâm Y tế như: Viện Mắt Trung Ương, Bệnh viện Nhi Trung Ương, Bệnh viện Bạch Mai... DTH chính thức được giao dịch tại Thị trường UPCoM từ ngày 18/04/2022.","sector":"Y tế","type":"CT","listed":"2022-04-18","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Metz Usa Việt Nam","p":null,"t":"CORPORATE","q":6224514,"pct":83.36,"d":"2026-03-03"},{"n":"Lê Xuân Thủy","p":"Kế toán trưởng","t":"INDIVIDUAL","q":45585,"pct":0.61,"d":"2026-08-19"},{"n":"ĐOÀN QUANG HƯNG","p":null,"t":"INDIVIDUAL","q":40600,"pct":0.54,"d":"2025-10-05"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 400 VND","d":"2026-05-15","record":"2026-05-25","ex":"2026-05-22"},{"c":"AGME","t":"DTH - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-17","record":"2026-03-20","ex":"2026-03-19"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 400 VND","d":"2025-05-27","record":"2025-06-05","ex":"2025-06-04"},{"c":"AGME","t":"DTH - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-06","record":"2025-03-19","ex":"2025-03-18"},{"c":"DDINS","t":"Công ty Cổ Phần Metz Usa Việt Nam - Đăng kí Mua 6,320,000 DTH","d":"2024-08-19","record":null,"ex":null},{"c":"DDIND","t":"Trần Thanh Minh - Đăng kí Bán 1,711,428 DTH","d":"2024-08-06","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 - 300 VND","d":"2024-08-05","record":"2024-08-15","ex":"2024-08-14"},{"c":"DDRP","t":"Trần Thị Huyền Trang - Đăng kí Bán 2,128,043 DTH","d":"2024-08-02","record":null,"ex":null},{"