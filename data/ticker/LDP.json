ứng thuốc trong nước. Sở hữu vùng nguyên liệu Actiso và các loại dược liệu quý khác đạt chuẩn quốc tế GACP-WHO. Hệ thống sản xuất của LDP đảm bảo dây chuyền một chiều từ khâu nguyên liệu, phụ liệu, diện tích nhà xưởng và kho hơn 10.000 m2 tại Lâm Đồng. Công suất đạt khoảng 800 tấn trà dược thảo, 180 tấn cao mềm, 180 tấn cao khô một năm...Ngày 20/07/2010, LDP chính thức giao dịch trên Sở giao dịch Chứng khoán Hà Nội (HNX).","sector":"Y tế","type":"CT","listed":"2010-07-20","state":0.0,"foreign":0.00140414,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Louis Holdings","p":null,"t":"CORPORATE","q":6480725,"pct":51.017,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Apc Holdings","p":null,"t":"CORPORATE","q":5390000,"pct":28.78,"d":"2025-10-30"},{"n":"Nguyễn Thị Hồng Giang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":374251,"pct":2.8,"d":"2026-08-12"},{"n":"Nguyễn Minh Nguyệt","p":null,"t":"INDIVIDUAL","q":285000,"pct":2.24,"d":"2025-10-05"},{"n":"Đặng Thuỳ Linh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":241857,"pct":1.29,"d":"2026-07-07"},{"n":"Lê Tiến Thịnh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":100000,"pct":0.75,"d":"2026-08-12"},{"n":"Lê Thị Hồng Phước","p":null,"t":"INDIVIDUAL","q":5220,"pct":0.154,"d":"2015-09-14"},{"n":"Phạm Thị Hồng Hương","p":null,"t":"INDIVIDUAL","q":4351,"pct":0.128,"d":"2015-09-14"},{"n":"Phạm Văn Khoa","p":null,"t":"INDIVIDUAL","q":3187,"pct":0.094,"d":"2015-09-14"},{"n":"Lê Thị Song Thu","p":null,"t":"INDIVIDUAL","q":1360,"pct":0.04,"d":"2015-09-14"},{"n":"Lê Thị Phương Thảo","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.01,"d":"2025-10-05"},{"n":"Phạm Thị Huyền Trang","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":100,"pct":0.001,"d":"2026-08-12"},{"n":"Trương Thị Ngọc Hiền","p":"Kế toán trưởng","t":"INDIVIDUAL","q":92,"pct":0.001,"d":"2026-08-12"}],"rel":[{"c":"5801479136","