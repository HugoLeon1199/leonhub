 loại đầu máy, toa xe và sản xuất phụ tùng cơ khí ngành đường sắt. Công ty chính thức hoạt động theo mô hình công ty cổ phần từ năm 2016. Công ty đã không ngừng phát triển cơ sở vật chất, trang thiết bị và nguồn nhân lực để trở thành một doanh nghiệp lớn tại khu vực phía Nam.","sector":"Du lịch và Giải trí","type":"CT","listed":"2017-05-11","state":0.86852308,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đường sắt Việt Nam","p":null,"t":"CORPORATE","q":5645400,"pct":86.85,"d":"2025-10-05"},{"n":"Nguyễn Chiến Thắng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":651700,"pct":10.03,"d":"2022-05-12"},{"n":"Phạm Hồng Phi","p":null,"t":"INDIVIDUAL","q":73000,"pct":1.12,"d":"2017-06-08"},{"n":"Nguyễn Văn Khiên","p":"Giám đốc","t":"INDIVIDUAL","q":50000,"pct":0.77,"d":"2022-02-16"},{"n":"Trần Văn Mạnh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":41500,"pct":0.64,"d":"2019-07-01"},{"n":"Nguyễn Nhất Thắng","p":"Phó Giám đốc","t":"INDIVIDUAL","q":21500,"pct":0.33,"d":"2019-07-01"},{"n":"Nguyễn Minh Quang","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":3200,"pct":0.05,"d":"2019-07-01"},{"n":"Nguyễn Tấn Nè","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3200,"pct":0.05,"d":"2022-05-12"},{"n":"Phạm Đức Vinh","p":"Chủ tịch Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":2800,"pct":0.04,"d":"2022-05-12"},{"n":"Nguyễn Hữu Hoán","p":"Thành viên Hội đồng Quản trị/Giám đốc/Phó Giám đốc","t":"INDIVIDUAL","q":1500,"pct":0.02,"d":"2022-05-12"},{"n":"Trịnh Quang Lai","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1500,"pct":0.02,"d":"2019-07-01"},{"n":"Trịnh Thanh Liệu","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":900,"pct":0.01,"d":"2019-07-01"}],"events":[{"c":"SUSP","t":"DAR - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCoM","d":"2022-06-15","record":null,"ex":null},{"c":"AGME","t":"DAR - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-17","record":"2022-04-06","ex":"2022-04-05"},{"c":"DIV","t