98],["2021-Q4",0.114],["2022-Q1",-10.598],["2022-Q4",-0.173],["2023-Q4",-0.429],["2024-Q4",-1.676],["2025-Q4",-0.407],["2026-Q2",-0.407]],"y":[["2018",15.151],["2019",-5.052],["2020",-10.598],["2021",0.114],["2022",-0.173],["2023",-0.429],["2024",-1.676],["2025",-0.407]]}},"co":{"short":"Sản xuất - XNK Dệt may","profile":"Công ty Cổ phần Sản xuất - Xuất nhập khẩu Dệt may được thành lập năm 2000 trực thuộc Tổng Công ty Dệt may Việt Nam. Năm 2007 Công ty chuyển sang hoạt động theo mô hình công ty cổ phần với vốn điều lệ 35 tỷ đồng. Hoạt động kinh doanh chính của Công ty là sản xuất gia công các mặt hàng quần áo dệt may, xuất khẩu các mặt hàng khăn bông, thủ công mỹ nghệ từ các cơ sở may trong nước; nhập khẩu một số mặt hàng phục vụ cho ngành công ngiệp trong nước. Công ty không tập trung vào sản xuất hàng may mặc mà thực hiện các hợp đồng gia công và FOB qua trung gian là các đơn vị dệt may thành viên mà Công ty có góp vốn. Thị trường xuất khẩu chủ yếu là Mỹ và Đài Loan.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2010-12-17","state":0.83571429,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Dệt May Việt Nam","p":null,"t":"CORPORATE","q":2925000,"pct":68.345,"d":"2026-08-06"},{"n":"Tổng công ty May Hưng Yên - Công ty Cổ phần","p":null,"t":"CORPORATE","q":233434,"pct":5.454,"d":"2026-08-06"},{"n":"Nguyễn Thành Quế","p":null,"t":"INDIVIDUAL","q":37900,"pct":0.886,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh Ngà","p":null,"t":"INDIVIDUAL","q":7600,"pct":0.178,"d":"2015-09-14"},{"n":"Nguyễn Thị Kim Lý","p":null,"t":"INDIVIDUAL","q":4900,"pct":0.114,"d":"2015-09-14"},{"n":"Mai Thị Thùy Trâm","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.093,"d":"2026-05-19"},{"n":"Bùi Trung Dũng","p":null,"t":"INDIVIDUAL","q":6800,"pct":0.05,"d":"2025-10-05"},{"n":"Hoàng Thúy Anh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1300,"pct":0.03,"d":"2026-08-06"},{"n":"Trần Thị Thu Thảo","p":null,"t":