dự án FDI lớn và trọng điểm quốc gia như: Nhà máy gang thép Formosa (Hà Tĩnh), Tổ hợp khu công nghệ cao Samsung (Thái Nguyên), Nhà máy sản xuất, lắp ráp sản phẩm điển tử công nghệ cao LG (Hải Phòng), Nhà máy lọc hóa dầu Nghi Sơn...với tư cách là nhà thầu chủ đạo các hạng mục nền móng. FECON chính thức niêm yết và giao dịch trên sàn giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 7 năm 2012.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2012-07-24","state":0.0,"foreign":0.30689417,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Raito Kogyo","p":null,"t":"CORPORATE","q":40167682,"pct":25.51,"d":"2025-10-05"},{"n":"Evli Emerging Frontier Fund","p":null,"t":"CORPORATE","q":6188500,"pct":4.93,"d":"2025-10-05"},{"n":"Công ty Cổ phần Quản lý quỹ HD","p":null,"t":"CORPORATE","q":7742800,"pct":4.92,"d":"2026-02-09"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":5209487,"pct":4.2,"d":"2025-10-05"},{"n":"Phạm Việt Khoa","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5000100,"pct":3.176,"d":"2026-08-04"},{"n":"Công ty Cổ phần Chứng khoán MB","p":null,"t":"CORPORATE","q":1175980,"pct":2.572,"d":"2015-06-15"},{"n":"Lumen Vietnam Fund","p":null,"t":"CORPORATE","q":1010160,"pct":2.209,"d":"2015-06-15"},{"n":"Intereffekt Investment Funds N.V","p":null,"t":"CORPORATE","q":900000,"pct":1.968,"d":"2015-06-15"},{"n":"Công ty TNHH Chứng khoán Ngân hàng Thương mại Cổ phần Ngoại thương Việt Nam","p":null,"t":"CORPORATE","q":1009016,"pct":1.86,"d":"2025-10-05"},{"n":"Lotus - Mekong River Equity Fund","p":null,"t":"CORPORATE","q":818992,"pct":1.791,"d":"2015-06-15"},{"n":"Công ty Tài chính Tổng hợp Cổ phần Điện Lực","p":null,"t":"CORPORATE","q":523990,"pct":1.146,"d":"2015-06-15"},{"n":"Hà Thế Phương","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1112700,"pct":0.887,"d":"2021-10-25"},{"n":"Phạm Quốc Hùng","p":null,"t":"INDIVIDUAL","q":270957,"pct":0.172,"d":"2026-01-20"},{"n":"Phùng Tiến Trung","