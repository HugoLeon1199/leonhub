M từ tháng 09/2017.","sector":"Bán lẻ","type":"CT","listed":"2017-09-21","state":0.83306331,"foreign":3.93e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Lương thực Miền Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":21184800,"pct":83.31,"d":"2026-03-02"},{"n":"Bạch Ngọc Văn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":268000,"pct":1.05,"d":"2026-03-02"},{"n":"Dương Thị Thanh Nguyệt","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":101500,"pct":0.399,"d":"2026-03-02"},{"n":"Nguyễn Thanh Sơn","p":null,"t":"INDIVIDUAL","q":51500,"pct":0.2,"d":"2025-10-05"},{"n":"Đoàn Huỳnh Dũng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.039,"d":"2025-10-05"},{"n":"Nguyễn Trường Giang","p":null,"t":"INDIVIDUAL","q":8600,"pct":0.034,"d":"2025-10-05"},{"n":"Trần Tú Khanh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":8600,"pct":0.03,"d":"2026-03-02"},{"n":"Mai Thành Công","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5000,"pct":0.019,"d":"2026-03-02"},{"n":"Trần Thị Điệp","p":"Kế toán trưởng","t":"INDIVIDUAL","q":4500,"pct":0.018,"d":"2026-03-02"},{"n":"Nguyễn Mai Thái Sơn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2800,"pct":0.01,"d":"2026-03-02"},{"n":"Trần Thị Mai Trinh","p":null,"t":"INDIVIDUAL","q":1500,"pct":0.01,"d":"2026-05-13"},{"n":"Đặng Quốc Việt","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.01,"d":"2025-10-05"},{"n":"Vũ Thị Minh Hiền","p":null,"t":"INDIVIDUAL","q":2100,"pct":0.008,"d":"2025-10-05"},{"n":"Lê Văn Vàng","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":620,"pct":0.002,"d":"2026-05-19"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 420 VND","d":"2026-05-18","record":"2026-05-25","ex":"2026-05-22"},{"c":"AGME","t":"KGM - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-27","record":"2026-03-19","ex":"2026-03-18"},{"c":"OTHE","t":"KGM - Thay đổi địa chỉ","d":"2026-01-08","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức 