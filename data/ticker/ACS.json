ông ty cung cấp dịch vụ thiết kế bằng công cụ BIM, khảo sát, quản lý xây dựng, lập bản vẽ chi tiết thi công, tính toán khối lượng và các loại thủ tục khác. Công ty đã tham gia thi công nhiều công trình như công trình cải tạo UBND thành phố Hồ Chí Minh, Trung tâm Thương mại Bình Điền, Cục Sáng Chế và Trung tâm thương mại Pleiku. ACS được giao dịch trên thị trường UPCOM từ tháng 07/2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-07-13","state":0.0,"foreign":0.00111111,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Quang Khanh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":710930,"pct":13.17,"d":"2026-08-12"},{"n":"Đinh Viết Duy","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":618744,"pct":11.46,"d":"2026-08-12"},{"n":"Công ty TNHH Phúc Phú An","p":null,"t":"CORPORATE","q":400000,"pct":10.0,"d":"2025-10-05"},{"n":"Lê Đức Nguyên","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":497508,"pct":9.2,"d":"2026-08-12"},{"n":"Công ty Cổ phần Bê tông Ngoại Thương","p":null,"t":"CORPORATE","q":422416,"pct":7.82,"d":"2026-08-12"},{"n":"Hứa Đan Thanh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":290000,"pct":5.4,"d":"2026-08-12"},{"n":"Lê Đức Long","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":202000,"pct":5.05,"d":"2026-08-12"},{"n":"Công ty Cổ phần Đầu tư Xây dựng Ngoại Thương","p":null,"t":"CORPORATE","q":221160,"pct":4.1,"d":"2026-08-12"},{"n":"Đặng Lê Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":211000,"pct":3.907,"d":"2026-08-12"}],"rel":[{"c":"EVERGREEN","n":"Công ty Cổ Phần Xây Dựng E-cons","t":"subsidiary","pct":70.0},{"c":"ACSCFUJI","n":"Công ty TNHH Tư Vấn Xây Dựng Acsc & Fujinami","t":"subsidiary","pct":51.0}],"rel_count":2,"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 66.7%","d":"2026-06-26","record":null,"ex":null},{"c":"AGME","t":"ACS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-14","record":"2026-04-29","ex":"2026-04-28"},{"c":"IS