 Ngày 15/02/2012, HHS chính thức niêm yết cổ phiếu trên Sở giao dịch Thành phố Hồ Chí Minh (HOSE).","sector":"Ô tô và phụ tùng","type":"CT","listed":"2012-02-15","state":0.0,"foreign":0.00271017,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Đầu tư Dịch vụ Tài chính Hoàng Huy","p":null,"t":"CORPORATE","q":251905777,"pct":58.31,"d":"2026-08-13"},{"n":"The Ton Poh Fund","p":null,"t":"CORPORATE","q":5417000,"pct":4.88,"d":"2015-06-15"},{"n":"Nguyễn Phương Đông","p":null,"t":"INDIVIDUAL","q":19828600,"pct":4.59,"d":"2025-10-05"},{"n":"Đinh Quang Chiến","p":null,"t":"INDIVIDUAL","q":19172900,"pct":4.44,"d":"2026-06-08"},{"n":"Công ty Cổ phần Phát triển Đô thị Từ Liêm","p":null,"t":"CORPORATE","q":2700000,"pct":0.63,"d":"2026-06-08"},{"n":"Nguyễn Trọng Cường","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":3283,"pct":0.001,"d":"2026-08-13"},{"n":"Phùng Thị Thu Hương","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":3283,"pct":0.001,"d":"2026-08-13"},{"n":"Bùi Thị Trà","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":323,"pct":0.0,"d":"2026-08-13"},{"n":"Hồ Thị Xuân Hòa","p":"Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":1636,"pct":0.0,"d":"2026-08-13"}],"rel":[{"c":"2647055","n":"Công ty Cổ phần HHS Capital","t":"subsidiary","pct":99.996},{"c":"HGSEDECO","n":"Công ty Cổ Phần Phát Triển Dịch Vụ Hoàng Giang","t":"subsidiary","pct":99.79},{"c":"PRUKSAVN","n":"Công Ty Trách Nhiệm Hữu Hạn Pruksa Việt Nam","t":"subsidiary","pct":90.17},{"c":"TGSEDECO","n":"Công ty Cổ Phần Phát Triển Dịch Vụ Trường Giang","t":"affiliate","pct":48.5},{"c":"TNSERINCO","n":"Công ty Cổ Phần Đầu Tư Dịch Vụ Thành Nam","t":"affiliate","pct":48.0},{"c":"CRV","n":"Công ty Cổ phần Tập đoàn Bất động sản CRV","t":"affiliate","pct":35.26}],"rel_count":6,"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Quyền mua CP cho Cổ đông hiện hữu tỉ lệ 60.0%","d":"2026-08-27","record":null,"ex":null},{"c":"DDIND","t":"Đinh Quang Chiến - Đăng kí 