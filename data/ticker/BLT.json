["2021",3.774],["2022",7.757],["2023",8.426],["2024",2.806],["2025",4.16]]}},"co":{"short":"Lương Thực Bình Định","profile":"Công ty Cổ phần Lương Thực Bình Định (BLT) có tiền thân Sở Lương thực Nghĩa Bình, được thành lập vào năm 1975. Công ty hoạt động trong lĩnh vực chế biến, kinh doanh, xuất khẩu các mặt hàng lương thực, nông sản với sản phẩm chính là gạo và sắn lát. BLT chính thức hoạt động theo mô hình công ty cổ phần từ tháng 01/2008. Công ty quản lý vận hành 05 nhà máy chế biến gạo với tổng công suất 70 tấn/giờ và 06 cụm kho 50.000m2, với năng lực chế biến xuất khẩu hàng năm đạt hơn 120.000 tấn gạo, 100.000 tấn sắn lát và các loại nông sản khác. BLT được giao dịch trên thị trường UPCOM từ tháng 07/2017.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-07-10","state":0.51,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Lương thực Miền Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":2040000,"pct":51.0,"d":"2025-10-05"},{"n":"Nguyễn Phan Quang","p":null,"t":"INDIVIDUAL","q":117400,"pct":2.935,"d":"2025-10-05"},{"n":"Đặng Thi Vân Đào","p":null,"t":"INDIVIDUAL","q":46200,"pct":1.155,"d":"2026-03-03"},{"n":"Phạm Văn Nam","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":33200,"pct":0.83,"d":"2026-03-03"},{"n":"Trần Quang Vinh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":32000,"pct":0.8,"d":"2026-03-03"},{"n":"Võ Hoàng Yến","p":"Phó Tổng Giám đốc/Kế toán trưởng","t":"INDIVIDUAL","q":24800,"pct":0.62,"d":"2026-03-03"},{"n":"Hà Thanh Đính","p":null,"t":"INDIVIDUAL","q":21000,"pct":0.53,"d":"2025-10-05"},{"n":"Trần Anh Vương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":17920,"pct":0.448,"d":"2026-03-03"},{"n":"Trần Thị Thu Nguyệt","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":9460,"pct":0.237,"d":"2026-03-03"},{"n":"Nguyễn Ngọc Thái","p":null,"t":"INDIVIDUAL","q":8480,"pct":0.21,"d":"2025-10-05"},{"n":"Tô Thị Mỹ Hòa","p":null,"t":"INDIVIDUAL","q":