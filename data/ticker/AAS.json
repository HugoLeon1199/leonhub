ứng khoán SACOMBANK. Năm 2025, Doanh thu nghiệp vụ môi giới chứng khoán có giá trị bằng 16,93 tỷ đồng, tăng 96.2% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 4.11%, tăng 2.16%. Lợi nhuận trước thuế có giá trị bằng 207,26 tỷ đồng. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 6.15%, tăng 3.15%. AAS được giao dịch trên thị trường UPCOM từ cuối tháng 07/2020.","sector":"Dịch vụ tài chính","type":"CK","listed":"2020-07-23","state":0.0,"foreign":0.00086616,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ngô Thị Thùy Linh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4774794,"pct":2.076,"d":"2026-08-24"},{"n":"Nguyễn Thị Lan","p":null,"t":"INDIVIDUAL","q":900000,"pct":0.391,"d":"2026-08-24"},{"n":"Công ty Cổ phần Tập đoàn Khách sạn Đông Á","p":null,"t":"CORPORATE","q":900000,"pct":0.39,"d":"2026-08-24"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 15.0%","d":"2026-04-02","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Quyền mua CP cho Cổ đông hiện hữu tỉ lệ 100.0%","d":"2026-04-02","record":null,"ex":null},{"c":"AGME","t":"AAS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-01-09","record":"2026-01-28","ex":"2026-01-27"},{"c":"OTHE","t":"AAS - Thay đổi địa chỉ","d":"2025-12-30","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Tập đoàn Khách sạn Đông Á - Đăng kí Mua 5,000,000 AAS","d":"2025-05-20","record":null,"ex":null},{"c":"AGME","t":"AAS - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-01-10","record":"2025-02-03","ex":"2025-01-24"},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 4.0%","d":"2024-09-13","record":null,"ex":null},{"c":"DDIND","t":"Lê Quang Chung - Đăng kí Bán 575,000 AAS","d":"2024-09-12","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Quyền mua CP cho Cổ đông hiện hữu tỉ lệ 100.0%","d":"2024-03-27","record":null,"ex":null},{"c":"AGME","t":"AAS - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-01-22","record":"2024-02-07","ex"