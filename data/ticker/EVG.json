àm việc của Nhà máy điện tử Samsung tại tỉnh Thái Nguyên; Tòa nhà Lotte Center Hà Nội tại đường Đào Tấn, quận Ba Đình, Hà Nội; Nhà ga Quốc tế T2 Sân bay Nội Bài, Hà Nội; Trụ sở làm việc của Vietcombank tại Tòa nhà Vietcombank Tower tại số 5 Công trường Mê Linh, Phường Bến Nghé, Quận 1, TP. HCM; Tòa nhà Sunsquare Lê Đức Thọ, Hà Nội. Bên cạnh đó, Công ty đã tham gia môi giới và phân phối sản phẩm cho rất các dự án như: Dự án Khu đô thị Lê Trọng Tấn-Geleximco, Dự án Khu đô thị Nam An Khánh-Sudico, Dự án Khu đô thị Xuân Phương-Viglacera, Dự án Times City, Dự án 19 Văn Phú Victoria…","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-06-08","state":0.0,"foreign":0.00381167,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Đình Vinh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":56669100,"pct":26.327,"d":"2026-08-05"},{"n":"Nguyễn Thúc Cẩn","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":16143750,"pct":7.5,"d":"2026-08-05"},{"n":"Công ty TNHH Dream House Asia","p":null,"t":"CORPORATE","q":11685000,"pct":5.43,"d":"2025-10-05"},{"n":"Lê Đình Tuấn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6514525,"pct":3.026,"d":"2026-08-05"},{"n":"Dương Thị Vân Anh","p":null,"t":"INDIVIDUAL","q":1575000,"pct":0.732,"d":"2025-10-05"},{"n":"Nguyễn Phương Ngân","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.083,"d":"2025-10-05"},{"n":"Bùi Nhật Tân","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.002,"d":"2025-10-05"},{"n":"Nguyễn Hà Nguyên","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1155,"pct":0.001,"d":"2026-08-05"},{"n":"Ngô Việt Hưng","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":50,"pct":0.0,"d":"2026-08-05"},{"n":"Vũ Minh Huệ","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1050,"pct":0.0,"d":"2026-08-05"}],"rel":[{"c":"0107514311","n":"Công ty CP Everland Phú Yên","t":"subsidiary","pct":91.25},{"c":"0110017006","n":"Công ty Cổ Phần Meta Tour","t":"subsidiar