n lên, Công ty Cổ phần Dược Thú y Cai Lậy đã phấn đấu và khẳng định được vị thế ngày càng vững mạnh trên thị trường. Trong lĩnh vực thuốc thú y và thuốc thủy sản, Công ty là đơn vị hàng đầu trong lĩnh vực thuốc thú y - thuốc thủy sản hiện tại so các đơn vị liên doanh nuớc ngoài, các đơn vị 100% vốn nước ngoài. Ngày 21/11/2008, MKV chính thức niêm yết và giao dịch triên Sàn Chứng khoán Hà Nội (HNX).","sector":"Y tế","type":"CT","listed":"2008-11-21","state":0.0,"foreign":0.02993197,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Tập Đoàn Mavin","p":null,"t":"CORPORATE","q":2858879,"pct":57.18,"d":"2025-10-05"},{"n":"Đào Mạnh Lương","p":null,"t":"INDIVIDUAL","q":974342,"pct":19.49,"d":"2026-03-04"},{"n":"Nguyễn Thị Ngọc","p":null,"t":"INDIVIDUAL","q":350000,"pct":13.02,"d":"2025-10-05"},{"n":"Hồ Phi Hải","p":null,"t":"INDIVIDUAL","q":75000,"pct":2.789,"d":"2015-09-14"},{"n":"Peter Eric Dennis","p":null,"t":"INDIVIDUAL","q":71300,"pct":2.651,"d":"2025-10-05"},{"n":"Trần Văn Sê","p":null,"t":"INDIVIDUAL","q":29000,"pct":1.078,"d":"2015-09-14"},{"n":"Trần Hoàng Sơn","p":null,"t":"INDIVIDUAL","q":21054,"pct":0.783,"d":"2015-09-14"},{"n":"Đặng Minh Tiến","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.558,"d":"2015-09-14"},{"n":"Vi Chí Thịnh","p":null,"t":"INDIVIDUAL","q":800,"pct":0.03,"d":"2015-09-14"},{"n":"Trương Trần Trúc","p":null,"t":"INDIVIDUAL","q":500,"pct":0.019,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"MKV - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-06","record":"2026-04-15","ex":"2026-04-14"},{"c":"OTHE","t":"MKV - Thay đổi địa chỉ","d":"2025-08-05","record":null,"ex":null},{"c":"DDRP","t":"Nguyễn Thị Thùy Dương - Đăng kí Bán 600,896 MKV","d":"2025-06-19","record":null,"ex":null},{"c":"AGME","t":"MKV - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-13","record":"2025-03-26","ex":"2025-03-25"},{"c":"AGME","t":"MKV - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-14","record":"2024-03-27","ex":"2024-03-26"},{"c"