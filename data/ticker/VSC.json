am (VSC) có tiền thân là Công ty Container Việt Nam, được thành lập vào năm 1985. Công ty được cổ phần hóa năm 2002. Công ty hoạt động chính trong lĩnh vực vận hành kinh doanh cảng, kho bãi. VSC hiện đang khai thác 02 cảng tại Hải Phòng là cảng Green Port và cảng VIP Green. Bên cạnh đó, Công ty hiện có 278.550 m2 kho bãi và kho CFS tại Hải Phòng, Đà Nẵng và thành phố Hồ Chí Minh. VSC được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2007.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2008-01-09","state":0.0,"foreign":0.02213875,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":8281000,"pct":6.21,"d":"2025-10-05"},{"n":"Đàm Văn Huy","p":null,"t":"INDIVIDUAL","q":7796900,"pct":5.84,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu Tư Sao Á D.C","p":null,"t":"CORPORATE","q":2734000,"pct":4.96,"d":"2025-10-05"},{"n":"Forum One-vcg Partners Vietnam Fund","p":null,"t":"CORPORATE","q":2036344,"pct":4.917,"d":"2025-10-05"},{"n":"Vietnam Holding Ltd","p":null,"t":"CORPORATE","q":2220618,"pct":4.87,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đại lý Vận tải SAFI","p":null,"t":"CORPORATE","q":5000000,"pct":4.53,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu tư TM","p":null,"t":"CORPORATE","q":2385000,"pct":4.33,"d":"2025-10-05"},{"n":"PXP Vietnam Emerging Equity Fund","p":null,"t":"CORPORATE","q":2333747,"pct":4.232,"d":"2025-10-05"},{"n":"Công Ty Cổ Phần Quản Lý Quỹ Leadvisors","p":null,"t":"CORPORATE","q":15350000,"pct":4.1,"d":"2026-07-29"},{"n":"Công ty Cổ phần Sao Á","p":null,"t":"CORPORATE","q":2010000,"pct":3.65,"d":"2022-05-26"},{"n":"DC Developing Markets Strategies Public Limited Company","p":null,"t":"CORPORATE","q":1695000,"pct":3.38,"d":"2025-10-05"},{"n":"Deutsche Asset Management (Asia) Limited","p":null,"t":"CORPORATE","q":1224160,"pct":2.956,"d":"2015-06-15"},{"n":"TGIT-Templeton Emerging Markets Small Cap Fund","p":null,"t":"CORPORATE","q":1605540,"pc