hàng nhập của Công ty tại Cảng Hải Phòng. Ngày 29/05/2017, TNI chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2017-05-29","state":0.0,"foreign":0.00206453,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Kim Phượng","p":null,"t":"INDIVIDUAL","q":2654700,"pct":5.05,"d":"2025-10-05"},{"n":"Nguyễn Huy Đức","p":null,"t":"INDIVIDUAL","q":2618800,"pct":4.99,"d":"2025-10-05"},{"n":"Nguyễn Thu Hương","p":null,"t":"INDIVIDUAL","q":2587210,"pct":4.928,"d":"2025-10-05"},{"n":"Nguyễn Xuân Long","p":null,"t":"INDIVIDUAL","q":2572600,"pct":4.9,"d":"2025-10-05"},{"n":"Lê Thị Thùy Linh","p":null,"t":"INDIVIDUAL","q":2567870,"pct":4.89,"d":"2025-10-05"},{"n":"Đỗ Thị Phương","p":null,"t":"INDIVIDUAL","q":1000000,"pct":4.761,"d":"2025-10-05"},{"n":"Nguyễn Thị Lý","p":null,"t":"INDIVIDUAL","q":976690,"pct":4.65,"d":"2025-10-05"},{"n":"Lê Thị Yến","p":null,"t":"INDIVIDUAL","q":792370,"pct":3.77,"d":"2025-10-05"},{"n":"Nguyễn Đình Chính","p":null,"t":"INDIVIDUAL","q":1920190,"pct":3.66,"d":"2026-05-12"},{"n":"Nguyễn Thị Thu Huyền","p":null,"t":"INDIVIDUAL","q":683600,"pct":3.26,"d":"2025-10-05"},{"n":"Phan Kim Thế Vũ","p":null,"t":"INDIVIDUAL","q":683180,"pct":3.25,"d":"2025-10-05"},{"n":"Bùi Văn Diến","p":null,"t":"INDIVIDUAL","q":1312600,"pct":2.5,"d":"2026-07-15"},{"n":"Nguyễn Hùng Cường","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":391490,"pct":0.746,"d":"2026-07-29"},{"n":"Vũ Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":227440,"pct":0.43,"d":"2025-10-05"},{"n":"Lê Xuân Long","p":null,"t":"INDIVIDUAL","q":18270,"pct":0.035,"d":"2025-10-05"},{"n":"Hà Thị Hải Vân","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.015,"d":"2025-10-05"},{"n":"Nguyễn Thị Hương","p":null,"t":"INDIVIDUAL","q":4900,"pct":0.009,"d":"2026-07-29"},{"n":"Trần Thị Phương Thúy","p":null,"t":"INDIVIDUAL","q":800,"pct":0.004,"d":"2025-10-05"},{"n":"Hà Thị An","p":null,"t":"INDIVIDUAL","q"