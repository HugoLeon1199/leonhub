. Công ty đã đầu tư phát triển một số dự án nhà ở tiêu biểu tại khu vực thành phố Hồ Chí Minh và Vũng Tàu như: Dự án The Star tại quận Bình Tân, dự án The Garden tại quận Tân Phú , dự án Skyline, Riverside, River City, cụm dự án Lacasa (River Panorama 1, River Panorama 2, Sky 89 và Signial tại quận 7, và The Sóng tại thành phố Vũng Tàu. AGG lần lượt được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ cuối năm 2019 và đầu năm 2020.","sector":"Bất động sản","type":"CT","listed":"2020-01-09","state":0.0,"foreign":0.00785707,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Bá Sáng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":42508891,"pct":26.15,"d":"2026-08-21"},{"n":"Nguyễn Hương Giang","p":"Giám đốc khối","t":"INDIVIDUAL","q":5527245,"pct":3.4,"d":"2026-08-21"},{"n":"Hanoi Investments Holdings Limited","p":null,"t":"CORPORATE","q":2585250,"pct":2.314,"d":"2025-10-05"},{"n":"Nguyễn Thành Châu","p":"Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":3600298,"pct":2.21,"d":"2026-08-21"},{"n":"DC Developing Markets Strategies Public Limited Company","p":null,"t":"CORPORATE","q":2214000,"pct":1.982,"d":"2025-10-05"},{"n":"Nguyễn Quỳnh Giang","p":"Giám đốc Kinh doanh nội địa","t":"INDIVIDUAL","q":2780380,"pct":1.71,"d":"2026-08-21"},{"n":"Nguyễn Mai Giang","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2443328,"pct":1.5,"d":"2026-08-21"},{"n":"Hồ Thị Nguyệt Anh","p":null,"t":"INDIVIDUAL","q":1508115,"pct":0.93,"d":"2026-08-21"},{"n":"Phạm Thị Trà My","p":null,"t":"INDIVIDUAL","q":628897,"pct":0.503,"d":"2025-10-05"},{"n":"Nguyễn Trung Tín","p":null,"t":"INDIVIDUAL","q":386760,"pct":0.47,"d":"2025-10-05"},{"n":"Samsung Vietnam Securities Master Investment Trust","p":null,"t":"CORPORATE","q":459000,"pct":0.411,"d":"2025-10-05"},{"n":"KITMC Worldwide Vietnam RSP Balanced Fund","p":null,"t":"CORPORATE","q":330000,"pct":0.4,"d":"2025-10-05"},{"n":"KB Vietnam Focus Balanced Fund"