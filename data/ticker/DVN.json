đơn vị đầu mối thực hiện các nhiệm vụ của Bộ Y tế để cung ứng thuốc trong các trường hợp khẩn cấp thiên tai, dịch bệnh. DVN được giao dịch trên thị trường UPCOM từ tháng 05/2017.","sector":"Y tế","type":"CT","listed":"2017-05-19","state":0.65,"foreign":0.00029536,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":154050000,"pct":65.0,"d":"2025-11-21"},{"n":"Công ty Cổ phần SAM Holdings","p":null,"t":"CORPORATE","q":11800000,"pct":4.8,"d":"2025-10-05"},{"n":"Quỹ Đầu tư Cơ Hội PVI","p":null,"t":"CORPORATE","q":6506818,"pct":2.75,"d":"2025-10-05"},{"n":"Nguyễn Văn Khái","p":null,"t":"INDIVIDUAL","q":1500,"pct":0.001,"d":"2025-10-05"}],"rel":[{"c":"CDP","n":"Công ty Cổ phần Dược phẩm Trung ương Codupha","t":"subsidiary","pct":66.35},{"c":"DP1","n":"Công ty Cổ phần Dược phẩm Trung ương CPC1","t":"subsidiary","pct":65.41},{"c":"TW3","n":"Công ty Cổ phần Dược Trung Ương 3","t":"subsidiary","pct":65.0},{"c":"VIMEDIMEX","n":"Công ty Cổ Phần Xuất Nhập Khẩu Y Tế Việt Nam","t":"affiliate","pct":41.15},{"c":"SANOFIVN","n":"CÔNG TY CỔ PHẦN DƯỢC PHẨM SANOFI-SYNTHELABO VIỆT NAM","t":"affiliate","pct":29.99},{"c":"UPH","n":"Công ty Cổ phần Dược phẩm TW25","t":"affiliate","pct":28.433},{"c":"DAN","n":"Công ty Cổ phần Dược Danapha","t":"affiliate","pct":26.45},{"c":"DANAPHANANO","n":"Công ty CP Dược Davina","t":"affiliate","pct":25.0},{"c":"DP3","n":"Công ty Cổ Phần Dược Phẩm Trung Ương 3","t":"affiliate","pct":22.07},{"c":"IMP","n":"Công ty Cổ phần Dược phẩm Imexpharm","t":"affiliate","pct":22.04}],"rel_count":10,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,000 VND","d":"2026-09-03","record":null,"ex":null},{"c":"AGME","t":"DVN - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-09","record":"2026-03-23","ex":"2026-03-20"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 1,000 VND","d":"2025-08-27","record":"2025-09-05","ex":"2025-09-