023-Q4",24.167],["2024-Q1",20.81],["2024-Q2",20.81]],"y":[["2018",22.293],["2019",22.946],["2020",18.476],["2021",13.439],["2022",21.717],["2023",24.167]]}},"co":{"short":"Dây cáp điện Việt Nam","profile":"Công ty Cổ phần Dây cáp điện Việt Nam (CAV), tiền thân là Công ty Dây Đồng, được thành lập năm 1975. Công ty chính thức đi vào hoạt động theo hình thức công ty cổ phần năm 2007. Hoạt động kinh doanh chính của Công ty là sản xuất, mua bán, xuất nhập khẩu dây cáp điện, sản phẩm khí cụ điện, vật liệu kỹ thuật điện. Công ty là nhà sản xuất dây cáp điện đứng số 1 thị phần tại Việt Nam, hiện chiếm khoảng 30% thị phần cả nước, trong đó chủ yếu là thị trường miền Nam. Khách hàng chủ yếu của công ty là các Công ty Điện lực, các nhà thầu xây lắp điện dân dụng, công nghiệp. Sản phẩm của CAV đã có mặt ở hơn 30 quốc gia trên thế giới.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2014-12-08","state":0.0,"foreign":0.0021,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Điện lực Gelex","p":null,"t":"CORPORATE","q":55453091,"pct":97.09,"d":"2026-05-11"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":461900,"pct":0.803,"d":"2025-10-05"},{"n":"KITMC Worldwide Vietnam Fund II","p":null,"t":"CORPORATE","q":326130,"pct":0.567,"d":"2025-10-05"},{"n":"KITMC Worldwide Vietnam RSP Balanced Fund","p":null,"t":"CORPORATE","q":299420,"pct":0.521,"d":"2025-10-05"},{"n":"Kitmc Vietnam Growth Fund","p":null,"t":"CORPORATE","q":272870,"pct":0.475,"d":"2025-10-05"},{"n":"Nguyễn Hoa Cương","p":null,"t":"INDIVIDUAL","q":130972,"pct":0.22,"d":"2018-02-27"},{"n":"LÊ QUANG ĐỊNH","p":null,"t":"INDIVIDUAL","q":115180,"pct":0.2,"d":"2024-04-24"},{"n":"Nguyễn Dung","p":null,"t":"INDIVIDUAL","q":51051,"pct":0.177,"d":"2015-09-14"},{"n":"Hoàng Nghĩa Đàn","p":null,"t":"INDIVIDUAL","q":46040,"pct":0.08,"d":"2018-02-27"},{"n":"Nguyễn Lộc","p":null,"t":"INDIVIDUAL","q":44234,"pct":0.076,"d":"2018-02-27"},{"n":"Công đoàn Công t