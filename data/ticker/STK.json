uất chính của công ty là sản xuất sợi tơ tổng hợp, dệt kim. Công ty hiện đang cung cấp các sản phẩm: sợi POY, sợi DTY và sợi FDY. Sản phẩm của công ty được xuất khẩu chủ yếu sang châu Âu (Thổ Nhĩ Kỳ) và châu Á. Công ty cũng là nhà cung cấp cho các doanh nghiệp dệt may như Nike, Adidas, Uniqlo và Puma. Công ty chính thức hoạt động theo mô hình công ty cổ phần từ năm 2004. Công ty được niêm yết trên Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh năm 2015.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2015-09-30","state":0.0,"foreign":0.17214179,"rating":"O-PF","target":25500.0,"rating_as_of":"2025-01-17","source":"Vietcap"},"owners":[{"n":"Đặng Mỹ Linh","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":30259557,"pct":21.59,"d":"2026-08-24"},{"n":"Công ty Cổ phần Hướng Việt Holdings","p":null,"t":"CORPORATE","q":28289321,"pct":20.19,"d":"2026-08-24"},{"n":"Đặng Triệu Hòa","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":20414468,"pct":14.57,"d":"2026-08-24"},{"n":"Vietnam Holding Ltd","p":null,"t":"CORPORATE","q":2977381,"pct":4.37,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Thực Phẩm Xanh","p":null,"t":"CORPORATE","q":995088,"pct":0.71,"d":"2026-08-24"},{"n":"Phan Như Bích","p":"Kế toán trưởng","t":"INDIVIDUAL","q":162400,"pct":0.12,"d":"2026-08-24"},{"n":"Nguyễn Phương Chi","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":116000,"pct":0.083,"d":"2026-08-24"},{"n":"Đinh Ngọc Hoa","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":17763,"pct":0.013,"d":"2026-08-24"},{"n":"Hoàng Nữ Mộng Tuyền","p":null,"t":"INDIVIDUAL","q":1376,"pct":0.002,"d":"2025-10-05"},{"n":"Võ Quang Long","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":7,"pct":0.0,"d":"2026-08-24"}],"rel":[{"c":"UNITEX","n":"Công ty TNHH Sợi, Dệt Nhuộm Unitex","t":"subsidiary","pct":100.0}],"rel_count":1,"events":[{"c":"AIS","t":"STK - Niêm yết bổ sung 14.011.890 cổ phiếu","d":"2026-08-27","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phi