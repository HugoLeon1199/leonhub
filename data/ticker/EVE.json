koil, và 15 triệu sản phẩm khăn với thương hiệu: Everon Home Decor. EVE được niêm yết trên Sở giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2010-12-17","state":0.0,"foreign":0.67532109,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lee Jae Eun","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":7567344,"pct":18.03,"d":"2026-07-30"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":5853900,"pct":13.95,"d":"2025-10-05"},{"n":"Nh Investment & Securities Co., Ltd.","p":null,"t":"CORPORATE","q":2982510,"pct":7.105,"d":"2025-10-05"},{"n":"Korea Investment Securities Co., Ltd","p":null,"t":"CORPORATE","q":2464477,"pct":5.998,"d":"2025-10-05"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":2093100,"pct":4.986,"d":"2025-10-05"},{"n":"Lee Bang Hyun","p":null,"t":"INDIVIDUAL","q":1776333,"pct":4.2,"d":"2026-07-30"},{"n":"Lee Jung Hyun","p":null,"t":"INDIVIDUAL","q":1656948,"pct":3.9,"d":"2026-07-30"},{"n":"Park Young Koung","p":null,"t":"INDIVIDUAL","q":1198168,"pct":2.854,"d":"2026-07-30"},{"n":"Công ty Cổ phần Quản lý quỹ đầu tư FPT","p":null,"t":"CORPORATE","q":760707,"pct":2.718,"d":"2015-06-15"},{"n":"Cho Yong Hwan","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":461760,"pct":1.1,"d":"2026-07-30"},{"n":"Lee Je Won","p":null,"t":"INDIVIDUAL","q":403891,"pct":0.962,"d":"2026-07-30"},{"n":"Park Soon O","p":null,"t":"INDIVIDUAL","q":237500,"pct":0.863,"d":"2015-09-14"},{"n":"Nguyễn Nam Thi","p":null,"t":"INDIVIDUAL","q":285120,"pct":0.68,"d":"2025-10-05"},{"n":"Trịnh Thị Hương Giang","p":null,"t":"INDIVIDUAL","q":285120,"pct":0.679,"d":"2026-07-30"},{"n":"Lee Hyun Joo","p":null,"t":"INDIVIDUAL","q":248972,"pct":0.593,"d":"2026-07-30"},{"n":"Song Chung Lan","p":null,"t":"INDIVIDUAL","q":207943,"pct":0.495,"d":"2026-07-30"},{"n":"Yu Sung Dae","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ t