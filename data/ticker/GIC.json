 2.000m2, khu vực sửa chữa có mái che rộng 400m2 phục vụ cho sửa chữa, bảo dưỡng container. Ngày 06/11/2020, GIC chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2020-11-06","state":0.0,"foreign":0.04881458,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Container Việt Nam","p":null,"t":"CORPORATE","q":16884000,"pct":66.34,"d":"2026-08-10"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":795710,"pct":5.97,"d":"2026-05-07"},{"n":"Nguyễn Thị Minh Lan","p":null,"t":"INDIVIDUAL","q":19200,"pct":0.16,"d":"2025-10-05"},{"n":"Nguyễn Thị Vân An","p":null,"t":"INDIVIDUAL","q":13200,"pct":0.11,"d":"2025-10-05"},{"n":"Nguyễn Việt Trung","p":null,"t":"INDIVIDUAL","q":13200,"pct":0.11,"d":"2025-10-05"},{"n":"Bùi Minh Hưng","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.1,"d":"2025-10-05"},{"n":"Cáp Trọng Cường","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.1,"d":"2021-02-26"},{"n":"Hoàng Tiến Lục","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.1,"d":"2025-10-05"},{"n":"Nghiêm Tuấn Anh","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.1,"d":"2025-10-05"},{"n":"Đồng Trung Hải","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":30240,"pct":0.1,"d":"2026-08-10"},{"n":"Trần Ngọc Toàn","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.02,"d":"2025-10-05"},{"n":"Đoàn Thị Phương Thảo","p":"Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":2400,"pct":0.02,"d":"2026-08-10"}],"events":[{"c":"AIS","t":"GIC - Niêm yết bổ sung 12.120.000 cổ phiếu","d":"2026-06-17","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 500 VND","d":"2026-06-12","record":"2026-06-22","ex":"2026-06-19"},{"c":"DDINS","t":"America Limited Liability Company - Đăng kí Bán GIC","d":"2026-05-06","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Container Việt Nam - Đăng kí Mua 8,040,000 GIC","d":"2026-04-17","record":null,"ex":null},{"c":"D