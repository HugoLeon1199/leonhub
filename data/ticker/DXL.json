2022",-2.272],["2023",-2.203],["2024",-3.3],["2025",-0.728]]}},"co":{"short":"Du lịch và Xuất nhập khẩu Lạng Sơn","profile":"Công ty Cổ phần Du lịch và Xuất nhập khẩu Lạng Sơn (DXL) tiền thân là Công ty Du lịch Lạng Sơn được thành lập năm 1989. Năm 2005, công ty được cổ phần hóa. Ngành nghề sản xuất kinh doanh chính của công ty là kinh doanh dịch vụ khách sạn, nhà hàng và sản xuất kinh doanh rượu Mẫu Sơn. Có lợi thế là hệ thống mạng lưới nhà hàng - khách sạn hoàn chỉnh nằm ở những vị trí đắc địa như khách sạn Hoa Sim có diện tích 3.000 m2 ở đường Nguyễn Thái Học, Xí nghiệp rượu Bắc Sơn diện tích nhà xưởng trên 600m2, nhà hàng Nam Kai, nhà nghỉ Mẫu Sơn và khách sạn Tân Thanh và nhiều hệ thống hang động tự nhiên...Ngày 28/06/2010, là ngày giao dịch đầu tiên trên thị trường UPCOM.","sector":"Du lịch và Giải trí","type":"CT","listed":"2010-06-28","state":0.37361732,"foreign":0.01863615,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thị Tú Oanh","p":null,"t":"INDIVIDUAL","q":1145000,"pct":28.93,"d":"2025-10-15"},{"n":"Lâm Bảo Kỳ","p":null,"t":"INDIVIDUAL","q":750000,"pct":25.356,"d":"2015-09-14"},{"n":"Nguyễn Chính Nghĩa","p":null,"t":"INDIVIDUAL","q":750000,"pct":25.356,"d":"2015-09-14"},{"n":"Nguyễn Kim Thảo","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":745301,"pct":18.83,"d":"2026-02-09"},{"n":"Nguyễn Văn Thanh","p":null,"t":"INDIVIDUAL","q":703193,"pct":17.76,"d":"2025-10-05"},{"n":"Đậu Trường Sinh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":590751,"pct":14.93,"d":"2026-02-09"},{"n":"Trần Việt Di","p":null,"t":"INDIVIDUAL","q":211815,"pct":7.161,"d":"2015-09-14"},{"n":"VŨ MỘNG NƯƠNG","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":162897,"pct":4.11,"d":"2025-10-05"},{"n":"Nguyễn Thị Xoan","p":null,"t":"INDIVIDUAL","q":146482,"pct":3.7,"d":"2025-10-05"},{"n":"Lý Bích Linh","p":null,"t":"INDIVIDUAL","q":104300,"pct":3.526,"d":"2015-09-14"},{"n":"Nguyễn Mai Thương",