 trà xanh vikoda, nước tăng lực... Sản phẩm của công ty được khai thác ngay tại nguồn mỏ ở độ sâu 220 mét, nhiệt độ tại vòi trên 72 độ C nằm ở giữa thảm bùn khoáng nguyên sinh rộng 30 ha, dưới chân núi Hòn Chuông. Sản phẩm được tiêu thị rộng khắp toàn quốc với 10 chi nhánh, trạm phân phối và trên 200 đại lý, đặc biệt là các thị trường lớn như thành phố Hồ Chí Minh, Khánh Hòa, Đà Nẵng, Đăk Lăk... Sản phẩm đa dạng, mẫu mã, hiện nay Công ty Cổ phần Nước Khoáng Khánh Hòa đã có hơn 10 sản phẩm với 22 chủng loại mẫu mã.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2010-04-12","state":0.04009337,"foreign":0.00055058,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Fit Consumer","p":null,"t":"CORPORATE","q":11941456,"pct":99.53,"d":"2026-03-20"},{"n":"Công ty Cổ phần Đầu tư Thương mại Hoa Sen Việt Nam","p":null,"t":"CORPORATE","q":287100,"pct":2.3,"d":"2025-10-05"},{"n":"Trần Văn Lợi","p":null,"t":"INDIVIDUAL","q":199400,"pct":1.595,"d":"2022-07-13"},{"n":"Nguyễn Ngọc Dũng","p":null,"t":"INDIVIDUAL","q":5940,"pct":0.275,"d":"2015-09-14"},{"n":"Phạm Đình Khương","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.139,"d":"2015-09-14"},{"n":"Đỗ Hữu Cường","p":null,"t":"INDIVIDUAL","q":2040,"pct":0.094,"d":"2015-09-14"},{"n":"Phạm Hoành","p":null,"t":"INDIVIDUAL","q":1800,"pct":0.083,"d":"2015-09-14"},{"n":"Trần Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":1320,"pct":0.061,"d":"2015-09-14"},{"n":"Phạm Hồng Thịnh","p":null,"t":"INDIVIDUAL","q":320,"pct":0.015,"d":"2015-09-14"}],"events":[{"c":"SUSP","t":"VKD - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2022-08-19","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Fit Consumer - Đăng kí Mua 2,100,000 VKD","d":"2022-06-27","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Đầu tư Thương mại Hoa Sen Việt Nam - Đăng kí Bán VKD","d":"2022-06-06","record":null,"ex":null},{"c":"AGME","t":"VKD - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-05-04","record":"2022-05-