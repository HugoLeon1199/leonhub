 kV Vinh-Bản Lã. Ngày 16/10/2012, VE4 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2012-10-16","state":0.0,"foreign":0.00046235,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Quang Đức","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2000000,"pct":66.05,"d":"2026-08-06"},{"n":"Tổng Công ty Cổ phần Xây dựng điện Việt Nam","p":null,"t":"CORPORATE","q":562602,"pct":18.58,"d":"2026-06-30"},{"n":"Công ty Cổ Phần Đầu Tư Spx","p":null,"t":"CORPORATE","q":101000,"pct":3.336,"d":"2026-06-30"},{"n":"Công ty Cổ phần Vinaconex 39","p":null,"t":"CORPORATE","q":77400,"pct":2.556,"d":"2026-03-19"},{"n":"Đinh Mã Lương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":51600,"pct":1.704,"d":"2026-08-06"},{"n":"Nguyễn Thế Hùng","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":9500,"pct":0.924,"d":"2026-08-06"},{"n":"Nguyễn Ngọc Ân","p":null,"t":"INDIVIDUAL","q":8582,"pct":0.835,"d":"2026-01-13"},{"n":"Nguyễn Năng Đồng","p":null,"t":"INDIVIDUAL","q":6820,"pct":0.663,"d":"2015-09-14"},{"n":"Lê Văn Huyên","p":null,"t":"INDIVIDUAL","q":5144,"pct":0.5,"d":"2015-09-14"},{"n":"Nguyễn Thế Tam","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":4500,"pct":0.438,"d":"2026-08-06"},{"n":"Nguyễn Huy Toàn","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.243,"d":"2015-09-14"},{"n":"Trần Thị Thúy Vân","p":null,"t":"INDIVIDUAL","q":2300,"pct":0.224,"d":"2015-09-14"},{"n":"Nguyễn Thị Thúy Hà","p":null,"t":"INDIVIDUAL","q":2027,"pct":0.197,"d":"2015-09-14"},{"n":"Nguyễn Văn Bốn","p":null,"t":"INDIVIDUAL","q":1446,"pct":0.14,"d":"2025-10-05"},{"n":"Trần Thị Thu Lan","p":null,"t":"INDIVIDUAL","q":18,"pct":0.002,"d":"2025-10-05"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 99.0%","d":"2026-06-11","record":null,"ex":null},{"c":"AGME","t":"VE4 - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-28","record":"2026-05-12","ex":"2026-05-11"},{"c":"AIS","t":"VE4 - Niêm 