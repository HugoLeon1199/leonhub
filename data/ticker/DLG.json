 tay 4 trạm thu phí BOT trên gần 150 Km đường Quốc lộ 14 với thời gian thu phí trên 20 năm. DLG được niêm yết và giao dịch tại Sở Giao dịch Chứng khoán thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-22","state":0.0,"foreign":0.05943513,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bùi Pháp","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":74226523,"pct":24.8,"d":"2026-08-26"},{"n":"Nguyễn Đăng Quang","p":null,"t":"INDIVIDUAL","q":11565700,"pct":3.86,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư Và Phát Triển Điện Năng Đức Long Gia Lai","p":null,"t":"CORPORATE","q":3624650,"pct":2.142,"d":"2015-06-15"},{"n":"Nguyễn Hải","p":null,"t":"INDIVIDUAL","q":2336200,"pct":0.78,"d":"2025-10-05"},{"n":"Vũ Thị Hải","p":null,"t":"INDIVIDUAL","q":1535479,"pct":0.513,"d":"2025-10-05"},{"n":"Nguyễn Tuyển","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1033318,"pct":0.35,"d":"2026-08-26"},{"n":"NGUYỄN ĐÌNH TRẠC","p":null,"t":"INDIVIDUAL","q":991222,"pct":0.33,"d":"2025-10-05"},{"n":"Lê Đức Kỳ","p":null,"t":"INDIVIDUAL","q":830000,"pct":0.28,"d":"2025-10-05"},{"n":"Trần Cao Châu","p":null,"t":"INDIVIDUAL","q":525000,"pct":0.18,"d":"2025-10-05"},{"n":"Phạm Trưng","p":null,"t":"INDIVIDUAL","q":242000,"pct":0.143,"d":"2015-09-14"},{"n":"Nguyễn Thị Hương","p":null,"t":"INDIVIDUAL","q":386844,"pct":0.129,"d":"2026-08-26"},{"n":"Nguyễn Tấn Phương","p":null,"t":"INDIVIDUAL","q":80000,"pct":0.047,"d":"2015-09-14"},{"n":"Trần Văn Phương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":68389,"pct":0.023,"d":"2026-08-26"},{"n":"Bùi Thị Anh","p":null,"t":"INDIVIDUAL","q":65202,"pct":0.02,"d":"2026-08-26"},{"n":"Nguyễn Xuân Hoan","p":null,"t":"INDIVIDUAL","q":16500,"pct":0.01,"d":"2015-09-14"},{"n":"Phạm Hùng","p":null,"t":"INDIVIDUAL","q":30642,"pct":0.01,"d":"2025-10-05"},{"n":"Đỗ Thanh","p":null,"t":"INDIVIDUAL","q":19950,"pct":0.01,"d":"2025-10-05"},{"n":"Nguyễn Tường Cọt","p":"Thành