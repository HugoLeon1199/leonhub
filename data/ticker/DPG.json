18.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-01-12","state":0.0,"foreign":0.18500413,"rating":"BUY","target":48900.0,"rating_as_of":"2026-06-11","source":"Vietcap"},"owners":[{"n":"Lương Minh Tuấn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":16069851,"pct":15.942,"d":"2026-08-03"},{"n":"Phạm Kim Châu","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":6687161,"pct":6.634,"d":"2026-08-03"},{"n":"Trần Anh Tuấn","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":5821972,"pct":5.78,"d":"2026-08-03"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":5010000,"pct":4.225,"d":"2026-04-23"},{"n":"Lương Thị Thanh","p":null,"t":"INDIVIDUAL","q":4543700,"pct":3.83,"d":"2026-08-03"},{"n":"Trần Thị Thúy Hằng","p":null,"t":"INDIVIDUAL","q":4511360,"pct":3.804,"d":"2026-07-29"},{"n":"Daiwa-ssiam Viet Nam Growth Fund Iii L.p","p":null,"t":"CORPORATE","q":4391760,"pct":3.7,"d":"2026-02-12"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":4035000,"pct":3.403,"d":"2026-04-23"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":3171800,"pct":2.675,"d":"2026-04-23"},{"n":"Công ty TNHH Manulife (Việt Nam) (Manulife)","p":null,"t":"CORPORATE","q":2869002,"pct":2.42,"d":"2026-02-12"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":2320000,"pct":2.3,"d":"2025-10-05"},{"n":"Lương Tuấn Minh","p":null,"t":"INDIVIDUAL","q":2340899,"pct":1.97,"d":"2026-08-03"},{"n":"Lương Xuân Mẫn","p":null,"t":"INDIVIDUAL","q":2258438,"pct":1.9,"d":"2026-08-03"},{"n":"Công ty Cổ phần Chứng khoán SSI","p":null,"t":"CORPORATE","q":2241947,"pct":1.89,"d":"2026-02-12"},{"n":"Tmam Vietnam Equity Mother Fund","p":null,"t":"CORPORATE","q":1652000,"pct":1.64,"d":"2025-10-05"},{"n":"Võ Thị Phương Lâm","p":null,"t":"INDIVIDUAL","q":1432390,"pct":1.21,"d":"2026-08-03"},{"n":"Tổng Công ty Cổ phần Tái bảo hiểm Quốc gia Việt Nam","p":null,"t":"CORPORATE","q":1366120,"pct":1.15,"d":"2026-02-12"},{"n":"Đặng Thị Xuân",