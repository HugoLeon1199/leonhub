9.806],["2019",6.838],["2020",0.0],["2021",4.845],["2022",3.412],["2023",5.266],["2024",5.731],["2025",2.502]]}},"co":{"short":"Bao bì PP","profile":"Công ty Cổ phần Bao bì PP (HPB) tiền thân là Nhà máy Bao bì PP Hải Phòng được thành lập năm 1993. Năm 2003 công ty chuyển sang hoạt động theo mô hình công ty cổ phần. Công ty có hơn 17 năm kinh nghiệm sản xuất kinh doanh trong lĩnh vực sản xuất bao bì các loại như bao phân lân, bao thức ăn, bao xi măng... với thương hiệu HAIPAC. Thị trường tiêu thụ của công ty trải rộng từ miền Bắc đến miền Nam. Mỗi năm công ty cung cấp cho thị trường phía Bắc khoảng 60.000.000 bao các loại, thị trường phía Nam 12 - 20 triệu bao xi măng các loại. Các khách hàng lớn của công ty bao gồm: Công ty Xi măng Chinfon Hải Phòng, Công ty Xi măng Lafarge tại Đồng Nai, Công ty Xi măng Hệ Dưỡng thuộc tập đoàn Lucky Đài Loan, Công ty phân lân Văn Điển, Công ty phân lân Ninh Bình, Công ty Đạm Hà Bắc... Ngày 29/04/2010, HPB chính thức giao dịch trên sàn giao dịch chứng khoán Hà Nội.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-04-29","state":0.0,"foreign":0.00075,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Mai Văn Bình","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":895420,"pct":24.5,"d":"2026-07-02"},{"n":"Trần Thị Thanh Hương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":484720,"pct":13.25,"d":"2026-07-02"},{"n":"Mai Thúc Định","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":406030,"pct":11.0,"d":"2026-07-02"},{"n":"Mai Hương","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":365440,"pct":9.99,"d":"2026-07-02"},{"n":"Bùi Tố Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":273900,"pct":7.5,"d":"2026-07-02"},{"n":"Nguyễn Thị Tuyết Trinh","p":null,"t":"INDIVIDUAL","q":190000,"pct":5.2,"d":"2026-07-02"},{"n":"Công ty Cổ phần Đầu tư An Tường","p":null,"t":"CORPORATE","q":181800,"pct":4.686,"d":"2015-0