, EU. HII được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 06/2017.","sector":"Hóa chất","type":"CT","listed":"2017-06-22","state":0.0,"foreign":0.0020229,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Nhựa An Phát Xanh","p":null,"t":"CORPORATE","q":33222058,"pct":45.1,"d":"2026-02-24"},{"n":"Lê Đức Long","p":null,"t":"INDIVIDUAL","q":523400,"pct":3.85,"d":"2025-10-05"},{"n":"Ngô Văn Thụ","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":32500,"pct":0.04,"d":"2026-08-07"},{"n":"Đỗ Như Quỳnh","p":null,"t":"INDIVIDUAL","q":2485,"pct":0.003,"d":"2026-02-24"}],"rel":[{"c":"ATBICSOLSING","n":"Công ty An Thành Bicsol Singapore Pte Ltd","t":"subsidiary","pct":100.0},{"c":"ATBICSOL","n":"Công ty Cổ phần An Thành Bicsol","t":"subsidiary","pct":99.65},{"c":"ANTIN","n":"Công ty Cổ phần Liên Vận An Tín","t":"subsidiary","pct":99.0},{"c":"0202084468","n":"Công ty Cổ Phần Sản Xuất Pbat An Phát","t":"affiliate","pct":39.83},{"c":"0801352476","n":"Công ty Cổ Phần Dịch Vụ Suất Ăn Công Nghiệp An Phát","t":"affiliate","pct":16.67}],"rel_count":5,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 300 VND","d":"2026-06-05","record":"2026-06-15","ex":"2026-06-12"},{"c":"AGME","t":"HII - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-06","record":"2026-03-26","ex":"2026-03-25"},{"c":"OTHE","t":"HII - Thay đổi địa chỉ","d":"2025-08-19","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 300 VND","d":"2025-05-21","record":"2025-05-28","ex":"2025-05-27"},{"c":"DDINS","t":"Công ty Cổ phần Nhựa An Phát Xanh - Đăng kí Bán 7,185,500 HII","d":"2025-03-31","record":null,"ex":null},{"c":"AGME","t":"HII - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-07","record":"2025-03-26","ex":"2025-03-25"},{"c":"AGME","t":"HII - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-20","record":"2024-04-03","ex":"2024-04-02"},{"c":"AGME","t":"HII - Tổ chức ĐHĐC