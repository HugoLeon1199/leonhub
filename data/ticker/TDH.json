án Khu nhà ở Bình An 2, Dự án Khu nhà ở Bình Chiểu, Dự án Trung tâm Thương mại - Dịch vụ, Căn hộ cao cấp & nhà ở Cantavil,... Năm 2006, TDH chính thức được niêm yết và giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bất động sản","type":"CT","listed":"2006-12-14","state":0.05998458,"foreign":0.00810213,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"KITMC Worldwide Vietnam RSP Balanced Fund","p":null,"t":"CORPORATE","q":2605838,"pct":6.21,"d":"2015-06-15"},{"n":"Deutsche Bank AG & Deutsche Asset Management (Asia) Ltd.","p":null,"t":"CORPORATE","q":2525025,"pct":6.017,"d":"2015-06-15"},{"n":"Công ty Đầu tư Tài chính Nhà nước Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":6757429,"pct":6.0,"d":"2025-10-05"},{"n":"Vietnam Equity Holding","p":null,"t":"CORPORATE","q":3730007,"pct":4.57,"d":"2025-10-05"},{"n":"Red River Holding","p":null,"t":"CORPORATE","q":1872985,"pct":4.463,"d":"2015-06-15"},{"n":"J.p. Morgan Securties Plc","p":null,"t":"CORPORATE","q":2300644,"pct":3.73,"d":"2025-10-05"},{"n":"PXP Vietnam Emerging Equity Fund","p":null,"t":"CORPORATE","q":3216242,"pct":3.426,"d":"2025-10-05"},{"n":"Citgroup Global Markets Limited","p":null,"t":"CORPORATE","q":1202300,"pct":2.865,"d":"2015-06-15"},{"n":"Citigroup Global Market Ltd & Citigroup Global Market Financial Products","p":null,"t":"CORPORATE","q":1191973,"pct":2.84,"d":"2015-06-15"},{"n":"Grinling International Limited","p":null,"t":"CORPORATE","q":1142562,"pct":2.723,"d":"2015-06-15"},{"n":"Yurie Vietnam Securities Investment Trust","p":null,"t":"CORPORATE","q":2492840,"pct":2.66,"d":"2025-10-05"},{"n":"Công ty Cổ phần DBA-Rhino","p":null,"t":"CORPORATE","q":1840005,"pct":2.59,"d":"2025-10-05"},{"n":"Lê Ngọc Xuân","p":"Phụ trách Công bố thông tin/Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1559500,"pct":1.38,"d":"2026-08-24"},{"n":"Lê Chí Hiếu","p":null,"t":"INDIVIDUAL","q":1501762,"pct":1.33,"d":"2025