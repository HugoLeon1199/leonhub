thực hiện toàn bộ mảng truyền thông - marketing của các công ty, tập đoàn lớn như Sunshine Group, KSFinance, Unicloud, SCG, Ngân hàng TMCP Kiên Long,... Công ty đã tổ chức nhiều show diễn, sự kiện giải trí, chương trình lớn như Chương trình truyền hình VTV \"Tết Ánh Dương\", Đêm nhạc \"Sunshine Concert 2018: Bản giao hưởng nghệ thuật và công nghệ\", sự kiện thay đổi nhận diện thương hiệu Kienlongbank, sự kiện ra mắt dòng sản phẩm bất động sản nghỉ dưỡng biển Sunshine Marina và nghỉ dưỡng nội đô Sunshine Premier,... Hiện tại, công ty đang xây dựng chiến lược định vị và triển khai truyền thông cho các dự án như Sunshine Heritage Mũi Né, Sunshine Capital Tây Thăng Long, KSFinance Hà Nội, KSFinance App,... Ngày 10/01/2022, ODE chính thức được giao dịch tại thị trường UPCoM.","sector":"Truyền thông","type":"CT","listed":"2022-01-10","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Thương Mại Dịch Vụ Bất Động Sản An Hưng","p":null,"t":"CORPORATE","q":940000,"pct":9.4,"d":"2026-06-15"},{"n":"Công ty Cổ Phần Sunshine Sky Villa","p":null,"t":"CORPORATE","q":500000,"pct":5.0,"d":"2026-01-16"},{"n":"Hoàng Thị Mỹ Bình","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":500000,"pct":5.0,"d":"2026-09-03"},{"n":"Nguyễn Đình Đức","p":null,"t":"INDIVIDUAL","q":425000,"pct":4.25,"d":"2025-10-05"},{"n":"Đinh Chí Hiếu","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":150000,"pct":1.5,"d":"2026-09-03"},{"n":"Trần Ngọc Minh","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.3,"d":"2025-10-05"},{"n":"Lê Thị Trà Mi","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":10000,"pct":0.1,"d":"2026-09-03"},{"n":"Nguyễn Thị Ngọc Minh","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":10000,"pct":0.1,"d":"2026-09-03"},{"n":"Hoàng Thị Thu Hà","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":5000,"pct":0.05,"d":"2026-09-03"},{"n":"Đỗ Lệ Thuỷ","p":null,"t":"INDIVIDUAL","q":5000,"p