 Vận tải Đường sắt (TRV), tiền thân là Công ty Cổ phần Vận tải Đường sắt Hà Nội hợp nhất với Công ty Cổ phần Vận tải Đường sắt Sài Gòn, được thành lập năm 2024. Công ty hoạt động chính trong lĩnh lực vận tải hành khách và hàng hoá bằng đường sắt. Hiện nay, TRV đang cung cấp dịch vụ vận tải hành khách trên các tuyến Tàu Thống nhất, Tàu khu đoạn trên tuyến Bắc- Nam, Tàu khu đoạn tuyến Hà Nội- Hải Phòng, Tuyến Hà Nội- Lào Cai,… Công ty cũng cung cấp dịch vụ vận chuyển hàng hoá đường sắt cho các tập đoàn công nghệ lớn bao gồm cả vận chuyển nguyên liệu đầu vào và sản phẩm đầu ra. Ngày 19/06/2025, TRV chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2025-06-19","state":0.87272496,"foreign":0.00033463,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đường sắt Việt Nam","p":null,"t":"CORPORATE","q":113776254,"pct":87.27,"d":"2026-08-07"},{"n":"Đỗ Văn Hoan","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":7962,"pct":0.006,"d":"2026-08-07"},{"n":"Đào Anh Tuấn","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":6075,"pct":0.005,"d":"2026-08-07"},{"n":"Lê Văn Chiến","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5390,"pct":0.004,"d":"2026-08-07"},{"n":"Nguyễn Hồng Linh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5453,"pct":0.004,"d":"2026-08-07"},{"n":"Dương Thị Hiền Vân","p":null,"t":"INDIVIDUAL","q":2566,"pct":0.002,"d":"2025-10-05"},{"n":"Mai Thế Mạnh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2909,"pct":0.002,"d":"2026-08-07"},{"n":"Lương Văn Chiến","p":"Kế toán trưởng","t":"INDIVIDUAL","q":54,"pct":0.0,"d":"2026-08-07"}],"events":[{"c":"AGME","t":"TRV - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-05","record":"2026-03-23","ex":"2026-03-20"},{"c":"NLIS","t":"TRV - Chính thức đăng ký giao dịch trên UPCOM","d":"2025-06-09","record":null,"ex":null}],"st":{"bsa15":{"label":"Hàng tồn kho, ròng","section":"balance","q":[["2025-Q1",190.168],["2025-Q2"