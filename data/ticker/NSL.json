0-Q4",14.929],["2021-Q4",14.441],["2022-Q4",15.994],["2023-Q4",14.279],["2024-Q4",12.777],["2025-Q4",5.315],["2026-Q1",4.87],["2026-Q2",7.298]],"y":[["2019",13.484],["2020",14.929],["2021",14.441],["2022",15.994],["2023",14.279],["2024",12.777],["2025",5.315]]}},"co":{"short":"Cấp nước Sơn La","profile":"Công ty Cổ phần Cấp nước Sơn La (NSL), tiền thân là Xí nghiệp Cấp nước Thị xã trực thuộc Sở Xây dựng Sơn La, được thành lập 1963. Năm 2005, NSL Chính thức hoạt động dưới hình thức Công ty Cổ phần. Lĩnh vực kinh doanh chính của công ty là: Sản xuất, cung cấp nước thương phẩm; Sản xuất nước tinh khiết mang thương hiệu SOWA. NSL hiện có 12 trạm bơm cấp 1, 27 trạm xử, 4 trạm bơm tăng áp, cung cấp cho địa bàn Thành phố Sơn La và 10 huyện thị trên địa bàn Tỉnh Sơn La. Hiện đang khai thác 35 nguồn nước trên địa bàn toàn tỉnh, trong đó có 12 nguồn nước mặc và 23 nguồn nước dưới đất. Tổng sản lượng nước thương phẩm duy trì ổn định tại mức trên 10 triệu m3 nước/năm và cung cấp cho gần 55.000 hộ gia đình trên địa bàn toàn tỉnh. Ngày 22/07/2019, NSL chính thức giao dịch trên thị trường UPCOM.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2019-07-22","state":0.85669077,"foreign":0.00427588,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Đầu Tư Và Kinh Doanh Nước Sạch Việt Nam","p":null,"t":"CORPORATE","q":8208528,"pct":65.669,"d":"2026-01-29"},{"n":"Ủy Ban Nhân Dân Tỉnh Sơn La","p":null,"t":"CORPORATE","q":2499997,"pct":20.0,"d":"2026-01-29"},{"n":"Lương Phương Thảo","p":null,"t":"INDIVIDUAL","q":138106,"pct":1.07,"d":"2026-01-29"},{"n":"Trần Quyết Chiến","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":22726,"pct":0.18,"d":"2026-01-29"},{"n":"Bùi Văn Đính","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":21618,"pct":0.17,"d":"2026-01-29"},{"n":"KIM NGỌC NHIỆM","p":null,"t":"INDIVIDUAL","q":17295,"pct":0.17,"d":"2025-10-