 lợi để tham gia đóng mới, sửa chữa, bảo dưỡng tàu và các phương tiện nổi cũng như gia công các cấu kiện cơ khí cho các đơn vị thành viên và các đối tác của Tổng Công ty. SCY được giao dịch trên thị trường UPCOM từ tháng 10/2017.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2017-10-25","state":0.97623328,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Công Nghiệp Tàu Thủy","p":null,"t":"CORPORATE","q":55823850,"pct":90.08,"d":"2025-10-05"},{"n":"Công ty Trách Nhiệm Hữu Hạn Một Thành Viên Đóng Tàu Bạch Đằng","p":null,"t":"CORPORATE","q":4672278,"pct":7.54,"d":"2025-10-05"},{"n":"Phan Đình Lượng","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":38902,"pct":0.063,"d":"2025-02-11"},{"n":"Quách Đình Nguyên","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":34903,"pct":0.056,"d":"2022-07-25"},{"n":"Phạm Mạnh Hà","p":null,"t":"INDIVIDUAL","q":33334,"pct":0.05,"d":"2017-10-20"},{"n":"Nguyễn Huy Phương","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":29264,"pct":0.047,"d":"2025-02-11"},{"n":"Đàm Quang Trung","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":26551,"pct":0.043,"d":"2025-05-05"},{"n":"Trương Trung Phúc","p":null,"t":"INDIVIDUAL","q":20167,"pct":0.033,"d":"2020-05-07"},{"n":"Hoàng Văn Tùng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":17445,"pct":0.028,"d":"2025-05-05"},{"n":"Phan Thị Hiên","p":null,"t":"INDIVIDUAL","q":13496,"pct":0.022,"d":"2025-02-11"},{"n":"Đặng Minh Thịnh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":11853,"pct":0.019,"d":"2025-02-11"},{"n":"Nguyễn Đức Triều","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5643,"pct":0.009,"d":"2025-02-11"},{"n":"Phùng Vũ Lợi","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":913,"pct":0.001,"d":"2025-02-11"},{"n":"Phạm Văn Trọng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":913,"pct":0.001,"d":"2025-02-11"}],"rel":[{"c":"0200767645","n":"Công 