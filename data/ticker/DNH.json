 máy Thủy điện Hàm Thuận - Đa Mi. Công ty hoạt động chính trong lĩnh vực sản xuất và kinh doanh điện năng. DNH chính thức hoạt động theo mô hình công ty cổ phần từ năm 2011. Công ty đang quản lý vận hành 4 nhà máy thủy điện với tổng công suất lắp đặt là 642,5 MW và sản lượng điện bình quân hàng năm khoảng 2,6 tỷ kWh. DNH được giao dịch trên thị trường UPCOM từ tháng 06/2017.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-06-19","state":0.99929711,"foreign":1.66e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Phát điện 1","p":null,"t":"CORPORATE","q":422103100,"pct":99.93,"d":"2025-10-05"},{"n":"Đỗ Minh Lộc","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7100,"pct":0.017,"d":"2025-10-05"},{"n":"Lê Văn Quang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":7600,"pct":0.002,"d":"2025-10-05"},{"n":"Phạm Thị Hồng Hà","p":null,"t":"INDIVIDUAL","q":9800,"pct":0.002,"d":"2025-10-05"},{"n":"Nguyễn Đình Chiến","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.0,"d":"2025-10-05"}],"rel":[{"c":"HSPCO","n":"Công ty Cổ Phần Thuỷ Điện Hạ Sông Pha","t":"subsidiary","pct":70.0},{"c":"THUANBINHWIND","n":"Công ty Cổ Phần Phong Điện Thuận Bình","t":"affiliate","pct":20.0}],"rel_count":2,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2025 - 600 VND","d":"2026-05-15","record":"2026-05-25","ex":"2026-05-22"},{"c":"AGME","t":"DNH - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-13","record":"2026-03-31","ex":"2026-03-30"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2025 - 1,400 VND","d":"2025-12-30","record":"2026-01-13","ex":"2026-01-12"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 3 2024 - 700 VND","d":"2025-06-10","record":"2025-06-16","ex":"2025-06-13"},{"c":"AGME","t":"DNH - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-20","record":"2025-04-01","ex":"2025-03-31"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2024 - 200 VND","d":"2025-01-23","record":