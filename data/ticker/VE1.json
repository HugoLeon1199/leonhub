 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-09-04","state":0.0,"foreign":0.238901,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Đỗ Huấn","p":null,"t":"CORPORATE","q":1280000,"pct":21.6,"d":"2026-08-07"},{"n":"Hao Dan","p":null,"t":"INDIVIDUAL","q":889300,"pct":14.82,"d":"2025-10-05"},{"n":"Lê Đình Chiến","p":null,"t":"INDIVIDUAL","q":781200,"pct":13.17,"d":"2025-10-05"},{"n":"Nguyễn Thị Miền","p":null,"t":"INDIVIDUAL","q":368700,"pct":6.22,"d":"2025-10-05"},{"n":"Xu Xiu Li","p":null,"t":"INDIVIDUAL","q":333100,"pct":5.55,"d":"2025-10-05"},{"n":"Zhang Hua","p":null,"t":"INDIVIDUAL","q":162500,"pct":5.544,"d":"2015-09-14"},{"n":"Xu Sheng","p":null,"t":"INDIVIDUAL","q":284800,"pct":4.8,"d":"2025-10-05"},{"n":"Nguyễn Duy Sửu","p":null,"t":"INDIVIDUAL","q":130000,"pct":4.435,"d":"2015-09-14"},{"n":"Đỗ Văn Huấn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":198600,"pct":3.34,"d":"2026-08-07"},{"n":"Nguyễn Thị Tiếp","p":null,"t":"INDIVIDUAL","q":140300,"pct":2.35,"d":"2026-01-23"},{"n":"Tổng Công ty Cổ phần Xây dựng điện Việt Nam","p":null,"t":"CORPORATE","q":70490,"pct":2.35,"d":"2015-06-15"},{"n":"Trần Hoàng Bính","p":null,"t":"INDIVIDUAL","q":57320,"pct":1.91,"d":"2025-10-05"},{"n":"Phạm Anh Tuấn","p":null,"t":"INDIVIDUAL","q":50000,"pct":1.71,"d":"2025-10-05"},{"n":"Hoàng Văn Thọ","p":null,"t":"INDIVIDUAL","q":46990,"pct":1.603,"d":"2015-09-14"},{"n":"Đỗ Như Hiệp","p":"Thành viên Hội đồng Quản trị/Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":83653,"pct":1.41,"d":"2026-08-07"},{"n":"Nguyễn Trường Thành","p":null,"t":"INDIVIDUAL","q":40020,"pct":1.365,"d":"2015-09-14"},{"n":"Đỗ Văn Đạt","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":54700,"pct":0.92,"d":"2026-08-07"},{"n":"Trần Đình Điệp","p":null,"t":"INDIVIDUAL","q":21360,"pct":0.729,"d":"2015-09-14"},{"n":"Nguyễn Thanh Tú","p":null,"t":"INDIVIDUAL","q":4120