CEM Vật liệu Xây dựng Đà Nẵng là đơn thành viên thuộc Tổng công ty xi măng Việt Nam với chức năng và nhiệm vụ chính là kinh doanh các loại xi măng của Tổng công ty trên thị trường Miền Trung và Tây Nguyên, là đơn vị chủ lực của Tổng công ty về kinh doanh xi măng tại khu vực Miền Trung và Tây Nguyên. Ngày 26/02/2008, DXV chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-02-26","state":0.65805051,"foreign":0.00512626,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Xi măng Việt Nam","p":null,"t":"CORPORATE","q":6514700,"pct":65.805,"d":"2025-10-05"},{"n":"Nguyễn Duy Diễn","p":null,"t":"INDIVIDUAL","q":1982200,"pct":20.022,"d":"2015-09-14"},{"n":"Công ty Cổ phần Đầu tư Tổng hợp Hà Nội - Chi nhánh Móng Cái","p":null,"t":"CORPORATE","q":230660,"pct":2.33,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư Phát triển Nhà Đà Nẵng","p":null,"t":"CORPORATE","q":143410,"pct":1.449,"d":"2015-06-15"},{"n":"Công ty Cổ phần Phát triển Hạ tầng Hà Nội","p":null,"t":"CORPORATE","q":120000,"pct":1.212,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư Tổng hợp Hà Nội - Trung tâm tư vấn xây dựng Hanic","p":null,"t":"CORPORATE","q":110700,"pct":1.118,"d":"2015-06-15"},{"n":"Công ty TNHH Xuất Nhập Khẩu Hàng Hoá Việt Nam","p":null,"t":"CORPORATE","q":86000,"pct":0.869,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư Tổng hợp Hà Nội","p":null,"t":"CORPORATE","q":85470,"pct":0.863,"d":"2015-06-15"},{"n":"Công ty Cổ phần TMDV Hải Phòng","p":null,"t":"CORPORATE","q":42100,"pct":0.425,"d":"2015-06-15"},{"n":"Nguyễn Văn Bình","p":null,"t":"INDIVIDUAL","q":400,"pct":0.004,"d":"2015-09-14"},{"n":"Võ Hồng Long","p":null,"t":"INDIVIDUAL","q":200,"pct":0.002,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"DXV - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-10","record":"2026-03-18","ex":"2026-03-17"},{"c":"AGME","t":"DXV - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-14","rec