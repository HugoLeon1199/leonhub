t":"Tấm lợp VLXD Đồng Nai","profile":"Công ty Tấm lợp Vật liệu xây dựng Đồng Nai (DCT) có tiền thân là hãng Eternit của Pháp hoạt động từ năm 1966. Từ năm 2000, Công ty chuyển sang hoạt động theo mô hình công ty cổ phần. Công ty hoạt động chính trong lĩnh vực sản xuất, kinh doanh các sản phẩm xi măng, tấm lợp, vật liệu xây dựng. Công ty hiện đang quản lý vận hành Nhà máy sản xuất tấm lợp với công suất thiết kế đạt hơn 6 triệu m2/năm, dây chuyền sản xuất gạch bê tông (gạch blok, gạch lát vỉa hè) với công suất 1.000.000 m2/năm và một dây chuyền sản xuất ngói màu với công suất 2.000.000 viên/năm. DCT được giao dịch trên thị trường UPCOM từ tháng 04/2016.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-04-07","state":0.12497833,"foreign":0.0038684,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Công Lý","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5720000,"pct":21.01,"d":"2026-08-10"},{"n":"Nguyễn Đoàn Mạnh","p":null,"t":"INDIVIDUAL","q":3714860,"pct":13.646,"d":"2025-10-05"},{"n":"Tổng Công ty Xi măng Việt Nam","p":null,"t":"CORPORATE","q":3402366,"pct":12.5,"d":"2026-08-10"},{"n":"Nguyễn Thị Mai Thảo","p":null,"t":"INDIVIDUAL","q":2800000,"pct":10.29,"d":"2026-03-10"},{"n":"Nguyễn Thị Thành","p":null,"t":"INDIVIDUAL","q":1768698,"pct":6.497,"d":"2025-10-05"},{"n":"Công ty Cổ phần Xuất nhập khẩu Thủy sản Bến Tre","p":null,"t":"CORPORATE","q":990890,"pct":3.64,"d":"2015-06-15"},{"n":"Đỗ Tài Thiện","p":null,"t":"INDIVIDUAL","q":588625,"pct":2.162,"d":"2015-09-14"},{"n":"Lê Trung Chính","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":268425,"pct":0.98,"d":"2026-08-10"},{"n":"Nguyễn Thị Thanh Tâm","p":null,"t":"INDIVIDUAL","q":159025,"pct":0.584,"d":"2015-09-14"},{"n":"Jiang Wen (Tường Văn)","p":null,"t":"INDIVIDUAL","q":61381,"pct":0.225,"d":"2015-09-14"},{"n":"Nguyễn Bá Truật","p":null,"t":"INDIVIDUAL","q":41660,"pct":0.153,"d":"2015-09-14"},{"n":"Dương Xuân Bình","p":null,"t":"INDIVIDUAL","q":29064,"pct":0.107