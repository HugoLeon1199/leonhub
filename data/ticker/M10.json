lĩnh vực sản xuất, kinh doanh và xuất khẩu các sản phẩm may mặc. M10 được cổ phần hóa và hoạt động theo mô hình công ty cổ phần từ năm 2005. M10 hiện đang quản lý vận hành 11 nhà máy may trải dọc từ Hà Nội tới Quảng Bình với tổng công suất trên 23 triệu sản phẩm/năm. Thị trường xuất khẩu chủ yếu của Tổng Công ty là Châu Âu, Nhật Bản, và Mỹ. M10 được giao dịch trên thị trường UPCOM từ tháng 01/2018.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2018-01-10","state":0.32211263,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Dệt May Việt Nam","p":null,"t":"CORPORATE","q":10227398,"pct":32.21,"d":"2026-08-06"},{"n":"Vũ Đức Giang","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1509296,"pct":4.753,"d":"2026-08-06"},{"n":"Nguyễn Thiên Lý","p":null,"t":"INDIVIDUAL","q":1104640,"pct":3.65,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh Huyền","p":null,"t":"INDIVIDUAL","q":986700,"pct":3.26,"d":"2025-10-05"},{"n":"Phạm Bích Hồng","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":912180,"pct":2.873,"d":"2026-08-06"},{"n":"Thân Đức Việt","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":672240,"pct":2.117,"d":"2026-08-06"},{"n":"Đỗ Hương Quỳnh","p":null,"t":"INDIVIDUAL","q":636579,"pct":2.105,"d":"2025-10-05"},{"n":"Bạch Thăng Long","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":377584,"pct":1.189,"d":"2026-08-06"},{"n":"Nguyễn Văn Thành","p":null,"t":"INDIVIDUAL","q":373606,"pct":1.176,"d":"2026-08-06"},{"n":"Trần Trọng Kim","p":null,"t":"INDIVIDUAL","q":283952,"pct":0.94,"d":"2025-10-05"},{"n":"Lê Văn Tiến","p":null,"t":"INDIVIDUAL","q":246720,"pct":0.777,"d":"2026-08-06"},{"n":"Nguyễn Ánh Dương","p":"Phó Tổng Giám đốc/Giám đốc khối/Giám đốc Chi nhánh","t":"INDIVIDUAL","q":211680,"pct":0.666,"d":"2026-08-06"},{"n":"Vũ Thị Như Quỳnh","p":null,"t":"INDIVIDUAL","q":184000,"pct":0.579,"d":"2026-08-06"},{"n