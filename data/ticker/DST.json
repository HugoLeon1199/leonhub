u học và 161 trường mầm non. Ngoài ra công ty còn cung cấp đồ dùng và thiết bị dạy học cho Công ty Cổ phần Sách Thiết bị Trường học thành phố Hồ Chí Minh, Sách giáo khoa cho Nhà xuất bản Giáo dục Hà Nội. Ngày 16/10/2007, DST chính thức được niêm yết tại Sở Giao dich Chứng khoán Hà Nội (HNX).","sector":"Truyền thông","type":"CT","listed":"2007-10-16","state":0.0,"foreign":0.00027399,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"CÔNG TY CỔ PHẦN THIÊN HOÀNG HOLDINGS","p":null,"t":"CORPORATE","q":6500000,"pct":20.17,"d":"2026-06-08"},{"n":"Đặng Hoàng Tuấn","p":null,"t":"INDIVIDUAL","q":1577000,"pct":4.89,"d":"2025-10-05"},{"n":"Cao Thị Xuân Thu","p":null,"t":"INDIVIDUAL","q":1376000,"pct":4.27,"d":"2025-10-05"},{"n":"Ngô Văn Hoàng Việt","p":null,"t":"INDIVIDUAL","q":338154,"pct":1.05,"d":"2026-07-22"},{"n":"Nguyễn Thị Mai Hương","p":null,"t":"INDIVIDUAL","q":187400,"pct":0.58,"d":"2026-07-22"},{"n":"Nguyễn Việt Đức","p":null,"t":"INDIVIDUAL","q":70800,"pct":0.431,"d":"2015-09-14"},{"n":"Nguyễn Lệ Thủy","p":null,"t":"INDIVIDUAL","q":45700,"pct":0.278,"d":"2015-09-14"},{"n":"Nguyễn Minh Hoàn","p":null,"t":"INDIVIDUAL","q":45000,"pct":0.274,"d":"2015-09-14"},{"n":"Lê Hải Đoàn","p":null,"t":"INDIVIDUAL","q":39600,"pct":0.241,"d":"2015-09-14"},{"n":"Phạm Anh Tuấn","p":null,"t":"INDIVIDUAL","q":16500,"pct":0.1,"d":"2015-09-14"},{"n":"Trần Văn Điệp","p":null,"t":"INDIVIDUAL","q":9400,"pct":0.057,"d":"2015-09-14"},{"n":"Trần Võ Hiếu","p":null,"t":"INDIVIDUAL","q":6700,"pct":0.041,"d":"2015-09-14"},{"n":"Dương Quang Ân","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.037,"d":"2015-09-14"},{"n":"Trần Bảo Anh","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.037,"d":"2015-09-14"},{"n":"Trần Trọng Thuỷ","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.037,"d":"2015-09-14"},{"n":"Bùi Ngọc Huấn","p":null,"t":"INDIVIDUAL","q":5300,"pct":0.032,"d":"2015-09-14"},{"n":"Trần Quốc Hưng","p":null,"t":"INDIVIDUAL","q":3700,"pct":0.023,"d":"2025-10-05"},{"n":"Nguyễn Thị T