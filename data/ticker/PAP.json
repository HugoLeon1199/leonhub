hủy. Ngành nghề kinh doanh chính của công ty là đầu tư xây dựng, kinh doanh khai thác Cảng Phước An và Khu dịch vụ hậu cần Cảng và kinh doanh xuất nhập khẩu vật tư thiết bị. Khu Cảng Phước An được đầu tư xây dựng cho tàu có trọng tải 60.000 DWT, gồm 10 bến với tổng chiều dài 3.050 m. Khu Dịch vụ hậu cần có công suất bến 2,2 triệu Teus/năm hàng Container và 4,0 triệu tấn/năm hàng tổng hợp. Đây được đánh giá là cảng có tuyến luồng tốt nhất hiện nay ở Việt Nam. Ngày 14/07/2021, PAP được giao dịch trên thị trường UPCoM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2021-07-14","state":0.09803922,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Hoành Sơn","p":null,"t":"CORPORATE","q":40197900,"pct":11.3,"d":"2026-05-25"},{"n":"Tập Đoàn Công Nghiệp – Năng Lượng Quốc Gia Việt Nam","p":null,"t":"CORPORATE","q":35000000,"pct":9.8,"d":"2026-07-27"},{"n":"Trần Phi Hùng","p":null,"t":"INDIVIDUAL","q":27000000,"pct":7.56,"d":"2026-03-17"},{"n":"Trương Công Nghĩa","p":null,"t":"INDIVIDUAL","q":17775600,"pct":4.98,"d":"2026-03-16"},{"n":"Bành Xuân Hoài","p":null,"t":"INDIVIDUAL","q":17500000,"pct":4.9,"d":"2026-03-16"},{"n":"Hà Văn Nam","p":null,"t":"INDIVIDUAL","q":17500000,"pct":4.9,"d":"2026-03-16"},{"n":"Phan Thế Anh","p":null,"t":"INDIVIDUAL","q":17500500,"pct":4.9,"d":"2026-03-16"},{"n":"Phạm Hồng Khánh","p":null,"t":"INDIVIDUAL","q":17500000,"pct":4.9,"d":"2026-03-16"},{"n":"Phạm Văn Khánh","p":null,"t":"INDIVIDUAL","q":17500000,"pct":4.9,"d":"2026-03-16"},{"n":"Trần Bảo Chung","p":null,"t":"INDIVIDUAL","q":17500000,"pct":4.9,"d":"2026-03-16"},{"n":"Trần Văn Nguyện","p":null,"t":"INDIVIDUAL","q":17500000,"pct":4.9,"d":"2026-03-16"},{"n":"Võ Thị Hồng Thắm","p":null,"t":"INDIVIDUAL","q":17503607,"pct":4.9,"d":"2026-03-16"},{"n":"Trần Nhân Tâm","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5208384,"pct":2.24,"d":"2026-07-27"},{"n":"Lê Đình Nghiệm","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL"