 triệu thuê bao truyền hình cáp trên cả nước. CAB cung cấp các gói dịch vụ truyền hình trả tiền đa dạng như Truyền hình cáp (CATV), internet trên mạng truyền hình cáp (VTVnet), IPTV (VTVplay), VOD (VTVcab ON)…Gói kênh CAB có trên nhiều hạ tầng của nhiều nhà cung cấp. CAB là đơn vị truyền hình trả tiền có số lượng chi nhánh, văn phòng đại diện, showroom lớn nhất Việt Nam do đó dễ tìm kiếm được lượng khách hàng mục tiêu trên thị trường.","sector":"Truyền thông","type":"CT","listed":"2019-09-06","state":0.98546754,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đài Truyền Hình Việt Nam","p":null,"t":"CORPORATE","q":45081076,"pct":98.55,"d":"2025-10-05"},{"n":"Tạ Sơn Đông","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3500,"pct":0.008,"d":"2022-08-08"},{"n":"Nguyễn Văn Ninh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3300,"pct":0.007,"d":"2024-08-08"},{"n":"Nguyễn Tuấn Anh","p":null,"t":"INDIVIDUAL","q":2900,"pct":0.006,"d":"2024-04-04"},{"n":"Bùi Huy Năm","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1500,"pct":0.003,"d":"2024-08-08"},{"n":"Nguyễn Thị Hoàng Phương","p":null,"t":"INDIVIDUAL","q":1400,"pct":0.003,"d":"2024-04-04"},{"n":"Nguyễn Thị Thu Hiền","p":"Thành viên Ban kiểm soát/Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":1600,"pct":0.003,"d":"2024-08-08"},{"n":"Nguyễn Trung Huấn","p":"Giám đốc Kinh doanh","t":"INDIVIDUAL","q":1500,"pct":0.003,"d":"2022-03-01"},{"n":"Hoàng Ngọc Huấn","p":"Người đại diện theo pháp luật","t":"INDIVIDUAL","q":1100,"pct":0.002,"d":"2024-04-04"},{"n":"Lê Thị Hồng Hạnh","p":null,"t":"INDIVIDUAL","q":1300,"pct":0.002,"d":"2019-07-18"},{"n":"Lê Trung Tấn","p":null,"t":"INDIVIDUAL","q":900,"pct":0.002,"d":"2024-08-08"},{"n":"Nguyễn Thị Hồng Nhung","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":1100,"pct":0.002,"d":"2024-08-08"},{"n":"Đinh Trung Dũng","p":null,"t":"INDIVIDUAL","q":200,"pct":0.0,"d":"2019-07-18"}],"rel":[{"c":"VTVCABINC","n":"Công ty TN