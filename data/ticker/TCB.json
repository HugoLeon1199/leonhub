ữu (ROE) ở mức 16.03%, tăng 0.42%. Ngày 04/06/2018, TCB chính thức giao dịch trên Sở giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Ngân hàng","type":"NH","listed":"2018-06-04","state":0.0,"foreign":0.20824015,"rating":"BUY","target":42600.0,"rating_as_of":"2026-08-12","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn Masan","p":null,"t":"CORPORATE","q":1048630998,"pct":14.798,"d":"2026-08-18"},{"n":"Công ty TNHH Mapleleaf","p":null,"t":"CORPORATE","q":174570774,"pct":4.956,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh Thủy","p":null,"t":"INDIVIDUAL","q":348260580,"pct":4.915,"d":"2026-08-18"},{"n":"Hồ Anh Minh","p":null,"t":"INDIVIDUAL","q":344689430,"pct":4.864,"d":"2026-08-18"},{"n":"Hồ Thủy Anh","p":null,"t":"INDIVIDUAL","q":344689430,"pct":4.864,"d":"2026-08-18"},{"n":"Vesta Vn Investments B.V.","p":null,"t":"CORPORATE","q":153519531,"pct":4.358,"d":"2025-10-05"},{"n":"Cog Investments I B.V.","p":null,"t":"CORPORATE","q":126207843,"pct":3.583,"d":"2025-10-05"},{"n":"Nguyễn Phương Hoa","p":null,"t":"INDIVIDUAL","q":151940400,"pct":2.151,"d":"2026-07-31"},{"n":"Hồ Minh Anh","p":null,"t":"INDIVIDUAL","q":144122296,"pct":2.04,"d":"2026-07-31"},{"n":"Nguyễn Hương Liên","p":null,"t":"INDIVIDUAL","q":139262976,"pct":1.971,"d":"2026-07-31"},{"n":"Morgan Stanley And Co. International Plc","p":null,"t":"CORPORATE","q":51163114,"pct":1.452,"d":"2025-10-05"},{"n":"Hồ Hùng Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":78619158,"pct":1.113,"d":"2026-07-31"},{"n":"Government Of Singapore","p":null,"t":"CORPORATE","q":35433036,"pct":1.006,"d":"2025-10-05"},{"n":"Nguyễn Thiều Quang","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":60512862,"pct":0.857,"d":"2026-07-31"},{"n":"Nguyễn Cảnh Sơn Tùng","p":null,"t":"INDIVIDUAL","q":42000000,"pct":0.596,"d":"2026-07-31"},{"n":"Nguyễn Cảnh Sơn","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":35909958,"pct":0.51,"d":"2026-07-31"},{"n":"Nguyễn Đăng Quang","p":"Phó Chủ tịch Hội đồng Qu