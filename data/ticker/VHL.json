an, Thái Lan, Malaysia, Nhật Bản. Công ty hiện quản lý vận hành 03 nhà máy gạch, trong đó Nhà máy gạch Tiêu Giao có tổng công suất thiết kế 180 triệu viên QTC/năm; Nhà máy gạch Cotto Giếng Đáy có tổng công suất 7,5 triệu m2 QTC/năm và nhà máy gạch Hoành Bồ với công suất 90 triệu viên QTC/năm. VHL được niêm yết trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2009.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-02-12","state":0.0,"foreign":0.01017156,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Viglacera - Công ty Cổ phần","p":null,"t":"CORPORATE","q":12619250,"pct":50.48,"d":"2026-05-15"},{"n":"Phạm Thị Thu","p":null,"t":"INDIVIDUAL","q":1235193,"pct":4.94,"d":"2025-10-05"},{"n":"Đinh Quang Huy","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":736101,"pct":2.94,"d":"2025-10-05"},{"n":"Nguyễn Hữu Gấm","p":null,"t":"INDIVIDUAL","q":139154,"pct":0.56,"d":"2025-10-05"},{"n":"Trần Hồng Quang","p":null,"t":"INDIVIDUAL","q":112353,"pct":0.45,"d":"2025-10-05"},{"n":"Ngô Thanh Tùng","p":null,"t":"INDIVIDUAL","q":30188,"pct":0.12,"d":"2025-10-05"},{"n":"Bùi Thị Thanh Nga","p":"Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":17968,"pct":0.072,"d":"2025-10-05"},{"n":"Trần Trung Kiên","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":15468,"pct":0.06,"d":"2025-10-05"},{"n":"Đinh Thị Thu Hằng","p":"Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":4220,"pct":0.016,"d":"2025-10-05"},{"n":"Trần Duy Hưng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3072,"pct":0.01,"d":"2025-10-05"},{"n":"Bùi Văn Quang","p":"Phó Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":45,"pct":0.0,"d":"2025-10-05"},{"n":"Nguyễn Anh Tuấn","p":null,"t":"INDIVIDUAL","q":12,"pct":0.0,"d":"2020-07-21"},{"n":"Trần Thành","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":52,"pct":0.0,"d":"2026-04-08"}],"rel":[{"c":"VGCHL","n":"Công ty Trách Nhiệm Hữu Hạn Một Thành Viên Thương Mại 