) kinh doanh hàng điện tử như điện thoại, laptop, sim và sản phẩm 3G. VTE trở thành công ty đại chúng từ năm 2008. Hiện nay, Công ty đang tập trung phát triển hai dòng điện thoại Aviosen và Aviomobile. Khách hàng chính của Công ty là các doanh nghiệp lớn trong ngành bưu chính viễn thông như VNPT, Viettel, Vinaphone và FPT. VTE được giao dịch trên thị trường UPCOM từ đầu tháng 06/2018.","sector":"Công nghệ Thông tin","type":"CT","listed":"2018-06-05","state":0.32,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập Đoàn Bưu Chính Viễn Thông Việt Nam","p":null,"t":"CORPORATE","q":4992000,"pct":32.0,"d":"2025-12-12"},{"n":"Ngô Thị Kiều Trang","p":null,"t":"INDIVIDUAL","q":2642860,"pct":16.94,"d":"2026-08-17"},{"n":"Nguyễn Thanh Hà","p":"Giám đốc khối/Giám đốc Tài chính","t":"INDIVIDUAL","q":1987336,"pct":12.74,"d":"2025-10-05"},{"n":"Ngô Phúc Lâm","p":null,"t":"INDIVIDUAL","q":1602536,"pct":10.27,"d":"2025-10-05"},{"n":"Nguyễn Thị Huệ","p":null,"t":"INDIVIDUAL","q":173640,"pct":1.11,"d":"2025-10-05"},{"n":"Ngô Hoàng Phương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":108160,"pct":0.69,"d":"2025-10-05"},{"n":"Trần Xuân Thái","p":null,"t":"INDIVIDUAL","q":20800,"pct":0.13,"d":"2025-10-05"},{"n":"Nguyễn Phương Linh","p":null,"t":"INDIVIDUAL","q":18720,"pct":0.12,"d":"2025-10-05"},{"n":"Phạm Văn Ninh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":10400,"pct":0.07,"d":"2025-10-05"},{"n":"Trần Quốc Việt","p":null,"t":"INDIVIDUAL","q":3744,"pct":0.024,"d":"2025-10-05"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 121 VND","d":"2026-07-16","record":"2026-07-27","ex":"2026-07-24"},{"c":"AGME","t":"VTE - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-09","record":"2026-02-27","ex":"2026-02-26"},{"c":"DDRP","t":"Hoàng Thị Thủy - Đăng kí Bán VTE","d":"2026-01-29","record":null,"ex":null},{"c":"DDRP","t":"Ngô Thị Kiều Trang - Đăng kí Mua VTE","d":"2026-01-28","record":null,"ex":null},{"c":"DDIND",