 132 nhà phân phối, 130.000 điểm bán trên kênh truyền thống, hơn 1.000 siêu thị, cửa hàng tiện lợi và hệ thống gần 50 cửa hàng giới thiệu sản phẩm.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2016-10-21","state":0.67770608,"foreign":0.04103474,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Thương Mại Sài Gòn - TNHH Một Thành Viên","p":null,"t":"CORPORATE","q":54829878,"pct":67.77,"d":"2026-08-25"},{"n":"Công ty Cổ phần Masan MEATLife","p":null,"t":"CORPORATE","q":20180026,"pct":24.94,"d":"2026-05-20"},{"n":"Quỹ Đầu tư Cổ phiếu Manulife","p":null,"t":"CORPORATE","q":109200,"pct":0.135,"d":"2026-08-17"},{"n":"Nguyễn Ngọc An","p":null,"t":"INDIVIDUAL","q":8600,"pct":0.011,"d":"2025-10-05"},{"n":"Đặng Thị Phương Ninh","p":null,"t":"INDIVIDUAL","q":5400,"pct":0.007,"d":"2025-10-05"},{"n":"Trương Hải Hưng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":4200,"pct":0.005,"d":"2026-08-25"},{"n":"Lâm Thị Ngọc Sương","p":null,"t":"INDIVIDUAL","q":2900,"pct":0.004,"d":"2025-10-05"},{"n":"Văn Đức Mười","p":null,"t":"INDIVIDUAL","q":3400,"pct":0.004,"d":"2025-10-05"},{"n":"Huỳnh Quang Giàu","p":null,"t":"INDIVIDUAL","q":200,"pct":0.0,"d":"2026-02-11"},{"n":"Phan Văn Dũng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":400,"pct":0.0,"d":"2026-08-25"},{"n":"Đỗ Thị Thu Thủy","p":"Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":200,"pct":0.0,"d":"2026-08-25"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 200 VND","d":"2026-08-05","record":"2026-08-25","ex":"2026-08-24"},{"c":"AGME","t":"VSN - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-09","record":"2026-03-27","ex":"2026-03-26"},{"c":"OTHE","t":"VSN - Thay đổi địa chỉ","d":"2025-08-28","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 500 VND","d":"2025-07-22","record":"2025-08-25","ex":"2025-08-22"},{"c":"AGME","t":"VSN - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-06","recor