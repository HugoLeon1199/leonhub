ĩnh vực kinh doanh cảng và kho bãi. Hiện tại, công ty đang vận hành và khai thác cảng Đà Nẵng - cảng biển lớn nhất khu vực miền Trung. Cảng Đà Nẵng sở hữu gần 1.700m cầu bến, cùng với các thiết bị xếp dỡ và kho bãi hiện đại, đảm bảo năng lực khai thác lên đến trên 12 triệu tấn/năm và hệ thống kho bãi có diện tích tổng cộng trên 20 hecta. Với vị trí thuận lợi trong việc giao thương hàng hải, Cảng Đà Nẵng hiện đang được quy hoạch cảng tổng hợp quốc gia (cảng loại I). CDN được niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX) từ Ngày 30/11/2016.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-11-30","state":0.75,"foreign":0.20350514,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Hàng hải Việt Nam - CTCP","p":null,"t":"CORPORATE","q":74250000,"pct":75.0,"d":"2026-05-11"},{"n":"Wan Hai Lines Pte Ltd","p":null,"t":"CORPORATE","q":20090000,"pct":20.29,"d":"2026-06-02"},{"n":"Lê Quảng Đức","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":78882,"pct":0.08,"d":"2026-06-02"},{"n":"Dương Đức Xuân","p":null,"t":"INDIVIDUAL","q":25182,"pct":0.025,"d":"2026-06-02"},{"n":"Hồ Thị Bích Nga","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":2000,"pct":0.002,"d":"2025-10-05"}],"rel":[{"c":"DANATUG","n":"Công ty Cổ Phần Tàu Lai Cảng Đà Nẵng","t":"affiliate","pct":36.0}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 800 VND","d":"2026-06-04","record":"2026-06-22","ex":"2026-06-19"},{"c":"AGME","t":"CDN - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-13","record":"2026-03-24","ex":"2026-03-23"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 1,200 VND","d":"2025-06-18","record":"2025-06-27","ex":"2025-06-26"},{"c":"DDIND","t":"Phan Bảo Lộc - Đăng kí Bán 5,032 CDN","d":"2025-02-20","record":null,"ex":null},{"c":"AGME","t":"CDN - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-10","record":"2025-02-25","ex":"2025-02-24"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 - 