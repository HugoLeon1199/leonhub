-0.063],["2021-Q3",-0.311],["2021-Q4",-0.393],["2022-Q1",-0.311],["2022-Q4",-0.544],["2023-Q4",-1.336],["2024-Q4",-0.719],["2026-Q2",-0.719]],"y":[["2018",-0.063],["2019",0.0],["2020",-0.311],["2021",-0.393],["2022",-0.544],["2023",-1.336],["2024",-0.719],["2025",0.0]]}},"co":{"short":"Điện nhẹ Viễn thông","profile":"Công ty Cổ phần Điện nhẹ Viễn thông (LTC) tiền thân là Trung tâm Kỹ thuật điện nhẹ Viễn thông thuộc Công ty Công trình Bưu điện - Tổng công ty Bưu chính Viễn thông Việt Nam được thành lập năm 1989. Công ty được cổ phần hóa năm 2001 và đổi tên thành Công ty Cổ phần Điện nhẹ Viễn thông. Lĩnh vực kinh doanh chủ yếu của Công ty là: Tư vấn, khảo sát các công trình điện nhẹ viễn thông, điện lạnh; Lắp đặt, bảo trì, bảo dưỡng, hỗ trợ vận hành các thiết bị điện nhẹ viễn thông, điện tử; Sản xuất kinh doanh phụ kiện xây lắp, vật tư thiết bị chuyên ngành điện nhẹ viễn thông tin học. Công ty là thành viên của Tập đoàn Bưu chính Viễn thông Việt Nam, LTC đã khẳng định vững chắc tên tuổi của mình trên thị trường cả nước sau hơn 30 năm xây dựng và trưởng thành với nhiều thành tích nổi bật. Những công trình kỹ thuật điện công ty đã khởi công trực tiếp xây dựng như: Thi công hệ thống điện nhẹ, BMS, Ga đốt - Khách sạn AMIANA; Tuyến đường Tân Sơn Nhất - Bình Lợi - Đường vành đai ngoài tại thành phố Hồ Chí Minh; Đường quốc lộ 3 mới Hà Nội - Thái Nguyên...Ngày 05/07/2019, LTC chính thức giao dịch trên thị trường UPCOM.","sector":"Công nghệ Thông tin","type":"CT","listed":"2006-12-14","state":0.15263846,"foreign":0.01859703,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập Đoàn Bưu Chính Viễn Thông Việt Nam","p":null,"t":"CORPORATE","q":700000,"pct":15.264,"d":"2015-06-15"},{"n":"Ngô Phương Anh","p":null,"t":"INDIVIDUAL","q":630400,"pct":13.75,"d":"2025-10-05"},{"n":"Bùi Trung Liễu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":500000,"pct":10.9,"d":"2026-08-03"},{"n":"Lương Quí Thăng","p":"Thành viên Hội đồng Quản trị","t":"INDI