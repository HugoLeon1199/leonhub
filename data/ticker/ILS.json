vực cung cấp dịch vụ logistics, cung ứng và quản lý lao động, kinh doanh cảng và kinh doanh vận tải đa phương thức. ILS sở hữu hệ thống kho, cảng và phương tiện vận chuyển có công suất rất lớn. Cảng ICD Mỹ Đình - 1 trong số các cảng cạn của ILS hiện là cảng cạn lớn nhất miền Bắc và là cảng duy nhất được chuyển cửa khẩu đối với hàng nhập khẩu về làm thủ tục Hải Quan tại Cảng. ILS là thành viên của Global Logistics Association (GLA) với hơn 1.500 đại lý rộng khắp trên 80 quốc gia và vùng lãnh thổ, đảm bảo cung cấp dịch vụ đến mọi nơi trên thế giới. ILS chính thức được giao dịch trên thị trường UPCOM từ tháng 03/2018.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2018-03-19","state":0.45,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Logistics Hàng không","p":null,"t":"CORPORATE","q":9720000,"pct":25.75,"d":"2026-08-25"},{"n":"Phùng Tiến Toàn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1620000,"pct":4.5,"d":"2026-08-25"},{"n":"Công ty Cổ phần Chứng khoán Phố Wall","p":null,"t":"CORPORATE","q":1025800,"pct":2.85,"d":"2025-10-05"},{"n":"Trần Quang Huy","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1006800,"pct":2.8,"d":"2026-08-25"},{"n":"Nguyễn Minh Hảo","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":688503,"pct":1.913,"d":"2026-08-25"},{"n":"Phùng Thúy Hoa","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":641700,"pct":1.782,"d":"2026-08-25"},{"n":"Ngô Thị Hoàng Yến","p":null,"t":"INDIVIDUAL","q":6789,"pct":0.019,"d":"2026-08-25"},{"n":"Lê Vĩnh Phúc","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.008,"d":"2025-10-05"}],"rel":[{"c":"INTERSERCOMD","n":"Công ty Cổ Phần Interserco Mỹ Đình","t":"subsidiary","pct":58.65},{"c":"0105619421","n":"Công ty Cổ Phần Cung Ứng Nhân Lực Và Thương Mại Quốc Tế","t":"subsidiary","pct":51.0},{"c":"SON","n":"Công ty Cổ phần Cung ứng Nhân lực Quốc tế và Thương mại","t":"subsidiary","pct":51.0},{"c":"SONTAYPORT","n":"