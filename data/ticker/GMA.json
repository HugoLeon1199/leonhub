26-Q1",5.45],["2026-Q2",5.451]],"y":[["2020",4.571],["2021",7.486],["2022",1.917],["2023",4.597],["2024",4.977],["2025",4.604]]}},"co":{"short":"G-Automobile","profile":"Công ty Cổ phần G-Automobile (GMA) được thành lập vào năm 2011. Công ty hoạt động chính trong lĩnh vực sản xuất, buôn bán, cho thuê các sản phẩm máy móc công trình, phụ kiện ngành xây dựng và kinh doanh ô tô. GMA trở thành công ty đại chúng từ tháng 06/2020. Công ty có xưởng sản xuất và dịch vụ tại địa chỉ Cụm Công nghiệp Ngọc Hồi, huyện Thanh Trì, Hà Nội với diện tích khoảng 2000 m2. Công ty hiện là đối tác và nhà cung cấp quen thuộc cho các đơn vị thi công Nền Móng công trình hàng đầu Việt Nam như Delta, FECON, JIKON, Fountech, Thái Minh, Quang Anh, Long Giang. Trong lĩnh vực kinh doanh ô tô, công ty đang là nhà phân phối của Mercedes-Benz, Ford và Mitsubishi. Ngày 01/12/2020, GMA chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Ô tô và phụ tùng","type":"CT","listed":"2020-12-01","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Chứng khoán EVS","p":null,"t":"CORPORATE","q":3999900,"pct":20.0,"d":"2026-08-25"},{"n":"Hoàng Việt Thắng","p":null,"t":"INDIVIDUAL","q":3051000,"pct":15.255,"d":"2026-01-26"},{"n":"Phùng Văn Hùng","p":null,"t":"INDIVIDUAL","q":1980000,"pct":9.9,"d":"2025-10-13"},{"n":"Công ty TNHH Đầu Tư G-holding","p":null,"t":"CORPORATE","q":1368000,"pct":6.84,"d":"2025-10-13"},{"n":"Công ty Cổ Phần Tập Đoàn Gami","p":null,"t":"CORPORATE","q":1296000,"pct":6.48,"d":"2025-10-13"},{"n":"Trần Thanh Huyền","p":null,"t":"INDIVIDUAL","q":985000,"pct":4.925,"d":"2026-01-26"},{"n":"Tống Thị Thu Huyền","p":null,"t":"INDIVIDUAL","q":985000,"pct":4.92,"d":"2025-10-05"},{"n":"Đỗ Thị Xuân","p":"Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":352800,"pct":1.764,"d":"2026-08-25"},{"n":"Nguyễn Thị Thanh Thủy","p":"Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":350400,"pct":1.752,"d"