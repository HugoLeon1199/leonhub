n từ năm 2004. Công ty có 01 nhà máy chế bản, 02 nhà máy bao bì và 01 chi nhánh tại Hà Nội. Sản phẩm chủ yếu của TTP là bao bì nhựa phức hợp gia công cho các đơn vị sản xuất khác, trong đó bao bì thực phẩm và hàng tiêu dùng chiếm 80%. Ngoài ra, Công ty triển khai in gia công cho một số đơn vị khác. TPP đã xây dựng và duy trì được mối quan hệ khách hàng lớn như Unilever Việt Nam, Ajinomoto, Vedan, Miwon, Acecook, Trung Nguyên, Kinh Đô, Bayer Vietnam, Vinamilk.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-12-05","state":0.0,"foreign":0.8821,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đoàn Thu Nhạn","p":null,"t":"INDIVIDUAL","q":104863,"pct":0.776,"d":"2015-09-14"},{"n":"Lê Thị Ngọc Trâm","p":null,"t":"INDIVIDUAL","q":100535,"pct":0.744,"d":"2015-09-14"},{"n":"Nguyễn Thị Hữu Thuỷ","p":null,"t":"INDIVIDUAL","q":100535,"pct":0.744,"d":"2015-09-14"},{"n":"Bùi Quang Thịnh","p":null,"t":"INDIVIDUAL","q":64549,"pct":0.478,"d":"2015-09-14"},{"n":"Huỳnh Thanh Kháng","p":null,"t":"INDIVIDUAL","q":32930,"pct":0.244,"d":"2015-09-14"},{"n":"Trương Thị Thanh Huyền","p":null,"t":"INDIVIDUAL","q":32163,"pct":0.238,"d":"2015-09-14"},{"n":"Chế Anh Tuấn","p":null,"t":"INDIVIDUAL","q":32082,"pct":0.237,"d":"2015-09-14"},{"n":"Nguyễn Đình Khánh","p":null,"t":"INDIVIDUAL","q":13539,"pct":0.1,"d":"2015-09-14"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":9,"pct":0.0,"d":"2015-06-15"}],"events":[{"c":"SUSP","t":"TTP - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2024-12-13","record":null,"ex":null},{"c":"EGME","t":"TTP - Tổ chức ĐHĐCĐ bất thường 2025","d":"2024-12-11","record":"2024-12-20","ex":"2024-12-19"},{"c":"EGME","t":"TTP - Tổ chức ĐHĐCĐ bất thường 2024","d":"2024-08-15","record":"2024-08-22","ex":"2024-08-21"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 - 35,000 VND","d":"2024-05-17","record":"2024-05-24","ex":"2024-05-23"},{"c":"AGME","t":"TTP - Tổ chức