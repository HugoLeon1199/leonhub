["2024",8.251],["2025",3.938]]}},"co":{"short":"Vận tải Dầu khí Đông Dương","profile":"Công ty Cổ phần Vận tải Dầu khí Đông Dương (PTT) được thành lập năm 2007 với vốn điều lệ 100 tỷ đồng. Công ty hoạt động chủ yếu trong lĩnh vực vận tải với phương tiện thân thiện với môi trường. Ngoài ra Công ty còn kinh doanh trong lĩnh vực thương mại (buôn bán xăng dầu, khí hóa lỏng...) nhằm tận dụng lợi thế là đơn vị trực thuộc Tập đoàn Dầu khí Việt Nam. Hiện tại công ty đang sở hữu 315 phương tiện kinh doanh vận tải bao gồm 285 xe Huyndai 05 chỗ, 18 xe văn phòng và 12 xe bồn LPG. Ngoài ra, thương hiệu Taxi Dầu khí đã có mặt tại địa bàn Hà Nội và đang dần dần mở rộng thị trường.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-04-29","state":0.5408238,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Vận tải Dầu khí","p":null,"t":"CORPORATE","q":8919900,"pct":54.08,"d":"2026-08-12"},{"n":"Nguyễn Hồng Hiệp","p":null,"t":"INDIVIDUAL","q":3443180,"pct":20.88,"d":"2025-10-23"},{"n":"Công ty TNHH Vận Tải Biển Châu Á Thái Bình Dương","p":null,"t":"CORPORATE","q":3402040,"pct":20.63,"d":"2025-10-23"},{"n":"Nguyễn Quốc Phương","p":null,"t":"INDIVIDUAL","q":5490,"pct":0.055,"d":"2015-09-14"},{"n":"Nguyễn Chí Dũng","p":null,"t":"INDIVIDUAL","q":2130,"pct":0.021,"d":"2015-09-14"},{"n":"Dương Thu Hường","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.02,"d":"2015-09-14"},{"n":"Vương Dũng Hoàng","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.02,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"PTT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-12","record":"2026-02-27","ex":"2026-02-26"},{"c":"OTHE","t":"PTT - Thay đổi địa chỉ","d":"2025-09-10","record":null,"ex":null},{"c":"AGME","t":"PTT - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-26","record":"2025-03-11","ex":"2025-03-10"},{"c":"EGME","t":"PTT - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-01-20","record":"2025-02-03","ex":"2025-01-24"},{"c":"AIS","t":"PTT - Đăng ký 