 không nguy hại trên địa bàn quận Đồ Sơn và một phần của huyện Kiến Thụy cũng như đảm bảo vệ sinh môi trường, mỹ quan đô thị tuyến đường Phạm Văn Đồng, quận Đồ Sơn. Bên cạnh đó, Công ty cũng tham gia đầu tư phát triển các công trình dịch vụ công ích trên địa bàn thành phố Hải Phòng. CDH được giao dịch trên thị trường UPCOM từ tháng 06/2016.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-06-23","state":0.575217,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Thành Phố Hải Phòng","p":null,"t":"CORPORATE","q":1150434,"pct":57.52,"d":"2025-10-05"},{"n":"Nguyễn Văn Hiền","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":152367,"pct":7.618,"d":"2025-10-05"},{"n":"Nguyễn Thị Minh Phương","p":null,"t":"INDIVIDUAL","q":105028,"pct":5.25,"d":"2025-10-05"},{"n":"Công ty TNHH Bình Khánh","p":null,"t":"CORPORATE","q":100000,"pct":5.0,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Xây Dựng Thái Hoà","p":null,"t":"CORPORATE","q":20000,"pct":1.0,"d":"2025-10-05"},{"n":"Nguyễn Thị Luân","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.35,"d":"2025-10-05"},{"n":"Hoàng Đăng Hưng","p":null,"t":"INDIVIDUAL","q":4557,"pct":0.228,"d":"2025-10-05"},{"n":"Cần Ngọc Đức","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":3000,"pct":0.15,"d":"2025-10-05"},{"n":"Đinh Văn Nam","p":null,"t":"INDIVIDUAL","q":2628,"pct":0.131,"d":"2025-10-05"},{"n":"Lưu Thị Hòa","p":null,"t":"INDIVIDUAL","q":2428,"pct":0.121,"d":"2025-10-05"},{"n":"Trần Văn Linh","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.06,"d":"2025-10-05"},{"n":"Phạm Minh Tuyên","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7828,"pct":0.004,"d":"2025-10-05"},{"n":"Bùi Thị Anh Đào","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":3128,"pct":0.002,"d":"2025-10-05"},{"n":"NGUYỄN QUANG KHẢI","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2828,"pct":0.001,"d":"2025-10-05"},{"n":"Phạm Song Toàn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2628,"