iệt thự sinh thái Cam Ranh. Ngày 22/09/2010, PTL chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bất động sản","type":"CT","listed":"2010-09-22","state":0.0,"foreign":0.00047833,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đỗ Thị Hiền","p":null,"t":"INDIVIDUAL","q":23964820,"pct":23.96,"d":"2025-10-05"},{"n":"Nguyễn Văn Vinh","p":null,"t":"INDIVIDUAL","q":20083840,"pct":20.08,"d":"2025-10-05"},{"n":"Lê Thị Tư","p":null,"t":"INDIVIDUAL","q":8516000,"pct":8.52,"d":"2025-10-05"},{"n":"Lê Văn Thắng","p":null,"t":"INDIVIDUAL","q":8515000,"pct":8.52,"d":"2025-10-05"},{"n":"Trần Thị Hường","p":null,"t":"INDIVIDUAL","q":7024470,"pct":7.02,"d":"2025-10-05"},{"n":"Công ty Cổ phần Dịch vụ và Đầu tư Bất Động Sản Ngôi Sao Phương Nam","p":null,"t":"CORPORATE","q":5286000,"pct":5.29,"d":"2025-10-05"},{"n":"Lâm Hoàng Khanh","p":null,"t":"INDIVIDUAL","q":4665000,"pct":4.718,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư Hạ tầng Kỹ thuật Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":1500000,"pct":1.5,"d":"2025-10-05"},{"n":"Công ty Cổ phần Thương Mại & Dịch Vụ Dầu Khí Việt Nam","p":null,"t":"CORPORATE","q":551600,"pct":0.55,"d":"2025-10-05"},{"n":"Lê Vũ Hoàng","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.101,"d":"2015-09-14"},{"n":"Lê Vũ Hùng","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.101,"d":"2015-09-14"},{"n":"Nguyễn Tấn Thụ","p":null,"t":"INDIVIDUAL","q":31700,"pct":0.032,"d":"2025-10-05"},{"n":"Bùi Minh Chính","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.03,"d":"2025-10-05"},{"n":"Nguyễn Thị Trường An","p":null,"t":"INDIVIDUAL","q":15680,"pct":0.016,"d":"2025-10-05"},{"n":"Phạm Minh Quốc","p":null,"t":"INDIVIDUAL","q":9800,"pct":0.01,"d":"2025-10-05"}],"rel":[{"c":"0317111580","n":"Công ty Cổ phần Victory Consulting","t":"subsidiary","pct":99.99},{"c":"0317111598","n":"Công ty Cổ phần Đầu Tư Bất Động Sản Tiến Phát Đạt","t":"subsidiary","pct":99.99},{"c":"0317111414","n":"Công ty Cổ phầ