 vụ liên quan tại núi Bà Đen. TTT được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2017.","sector":"Du lịch và Giải trí","type":"CT","listed":"2017-06-02","state":0.0,"foreign":0.02104936,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Địa Cầu","p":null,"t":"CORPORATE","q":1119701,"pct":24.5,"d":"2025-10-05"},{"n":"Công ty TNHH Olympia","p":null,"t":"CORPORATE","q":1096850,"pct":24.0,"d":"2025-10-05"},{"n":"Công ty TNHH Tư Vấn Xây Dựng Ánh Dương","p":null,"t":"CORPORATE","q":1096850,"pct":24.0,"d":"2025-10-05"},{"n":"Nguyễn Thị Hạnh","p":null,"t":"INDIVIDUAL","q":380829,"pct":8.0,"d":"2025-10-05"},{"n":"Công ty Tài Chính TNHH MTV Bưu Điện","p":null,"t":"CORPORATE","q":30000,"pct":1.0,"d":"2025-10-05"},{"n":"Phạm Văn Hải","p":null,"t":"INDIVIDUAL","q":3300,"pct":0.07,"d":"2025-10-05"},{"n":"Trần Thị Phượng","p":"Kế toán trưởng","t":"INDIVIDUAL","q":200,"pct":0.004,"d":"2026-08-13"}],"rel":[{"c":"TCT","n":"Công ty Cổ phần Cáp treo Núi Bà Tây Ninh","t":"subsidiary","pct":51.0}],"rel_count":1,"events":[{"c":"AGME","t":"TTT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-07","record":"2026-05-26","ex":"2026-05-25"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 2,000 VND","d":"2025-10-10","record":"2025-10-29","ex":"2025-10-28"},{"c":"OTHE","t":"TTT - Thay đổi địa chỉ","d":"2025-08-20","record":null,"ex":null},{"c":"AGME","t":"TTT - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-17","record":"2025-05-05","ex":"2025-04-29"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 - 2,000 VND","d":"2024-10-02","record":"2024-10-22","ex":"2024-10-21"},{"c":"AGME","t":"TTT - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-05-03","record":"2024-05-21","ex":"2024-05-20"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2022 - 2,000 VND","d":"2023-09-05","record":"2023-09-15","ex":"2023-09-14"},{"c":"AGME","t":"TTT - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-05-16","record":"2023-05-23","ex":"2023-0