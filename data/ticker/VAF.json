ông ty là sản xuất kinh doanh phân lân nung chảy và các loại phân NPK. Bề dày kinh nghiệm hoạt động trên 50 năm giúp VAF khẳng định thương hiệu nổi tiếng trên thị trường trong và ngoài nước. Ngoài ra, VAF còn kinh doanh một số hoạt động phụ trợ như xây dựng các công trình, sản xuất máy móc, thiết bị phục vụ sản xuất phân bón giúp tăng hiệu quả nguồn doanh thu cũng như việc triển khai thêm những hướng kinh doanh mới. Ngày 13/05/2026, VAF chính thức giao dịch trên thị trường UPCOM.","sector":"Hóa chất","type":"CT","listed":"2015-06-23","state":0.6705603,"foreign":0.00016578,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Hóa chất Việt Nam","p":null,"t":"CORPORATE","q":25256887,"pct":67.06,"d":"2026-08-25"},{"n":"Công ty TNHH Hoàng Ngân","p":null,"t":"CORPORATE","q":9215597,"pct":24.47,"d":"2026-08-25"},{"n":"Nghiêm Thị Nhung","p":null,"t":"INDIVIDUAL","q":1082624,"pct":2.874,"d":"2026-08-25"},{"n":"Nguyễn Ngọc Thạch","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":436107,"pct":1.16,"d":"2026-08-25"},{"n":"Nghiêm Đức Toàn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":126876,"pct":0.337,"d":"2026-08-25"},{"n":"Lê Ngọc Quang","p":null,"t":"INDIVIDUAL","q":21245,"pct":0.06,"d":"2025-10-05"},{"n":"Văn Hồng Sơn","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":16274,"pct":0.043,"d":"2026-08-25"},{"n":"Hồ Sỹ Tiến","p":null,"t":"INDIVIDUAL","q":13000,"pct":0.034,"d":"2025-10-05"},{"n":"Hoàng Văn Tại","p":null,"t":"INDIVIDUAL","q":8485,"pct":0.02,"d":"2025-10-05"},{"n":"Chu Văn Thước","p":null,"t":"INDIVIDUAL","q":3338,"pct":0.01,"d":"2025-10-05"},{"n":"Cấn Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":2364,"pct":0.01,"d":"2025-10-05"},{"n":"Nguyễn Thị Hiền","p":null,"t":"INDIVIDUAL","q":2364,"pct":0.01,"d":"2025-10-05"},{"n":"Phạm Quang Trung","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2225,"pct":0.006,"d":"2026-08-25"},{"n":"Nguyễn Thị Uyên","p":null,"t":"INDIVIDUAL","q":1530,"pct":0.004,"d":"2025-10-05"