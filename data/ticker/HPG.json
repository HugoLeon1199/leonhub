 cốt lõi của tập đoàn với việc đóng góp hơn 90% doanh thu và lợi nhuận. HPG hiện là nhà sản xuất thép lớn nhất Việt Nam cũng như khu vực Đông Nam Á với công suất đạt 16 triệu tấn/ năm. Năm 2025, công ty tiếp tục củng cố vị thế thị phần số 1 cả nước về thép xây dựng với khoảng 37%, và là doanh nghiệp Việt Nam duy nhất sản xuất được Thép cuộn cán nóng HRC. HPG được niêm yết và giao dịch Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2007.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2007-11-15","state":0.0,"foreign":0.21719243,"rating":"BUY","target":32700.0,"rating_as_of":"2026-08-18","source":"Vietcap"},"owners":[{"n":"Trần Đình Long","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1980000000,"pct":25.796,"d":"2026-07-30"},{"n":"Vũ Thị Hiền","p":null,"t":"INDIVIDUAL","q":528000000,"pct":6.879,"d":"2026-07-30"},{"n":"Trần Vũ Minh","p":null,"t":"INDIVIDUAL","q":209683900,"pct":2.732,"d":"2026-07-30"},{"n":"Trần Tuấn Dương","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":177556764,"pct":2.313,"d":"2026-07-30"},{"n":"Nguyễn Mạnh Tuấn","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":174088076,"pct":2.27,"d":"2026-07-30"},{"n":"Nguyễn Ngọc Quang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":131434285,"pct":1.56,"d":"2026-07-09"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":66860749,"pct":1.495,"d":"2025-10-05"},{"n":"Doãn Gia Cường","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":96209794,"pct":1.25,"d":"2026-07-30"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":39886441,"pct":0.892,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư Và Xây Dựng Sao Phương Bắc","p":null,"t":"CORPORATE","q":43891680,"pct":0.69,"d":"2026-07-30"},{"n":"CTBC Vietnam Equity Fund","p":null,"t":"CORPORATE","q":25500000,"pct":0.57,"d":"2025-10-05"},{"n":"Chu Quân","p":null,"t":"INDIVIDUAL","q":3600000,"pct":0.491,"d":"2015-09-14"},{"n":"Wareham Group Limited","p":null,"t":"CORPORATE","q":21153896,"pct":