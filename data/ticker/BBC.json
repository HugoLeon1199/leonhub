 phẩm bánh kẹo trong thị trường nội địa, công ty còn cung cấp một số sản phẩm sang nước ngoài như Mỹ, Đức, Nam Phi.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2001-12-19","state":0.0,"foreign":0.00409717,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn PAN","p":null,"t":"CORPORATE","q":18434662,"pct":98.3,"d":"2026-05-28"},{"n":"Châu Vinh Quang","p":null,"t":"INDIVIDUAL","q":316410,"pct":2.052,"d":"2015-09-14"},{"n":"Polunin Discovery Funds - Frontier Markets","p":null,"t":"CORPORATE","q":224620,"pct":1.457,"d":"2025-10-05"},{"n":"Hoàng Thọ Vĩnh","p":null,"t":"INDIVIDUAL","q":103265,"pct":0.67,"d":"2015-09-14"},{"n":"Nguyễn Thị Kim Liên","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.1,"d":"2025-10-05"},{"n":"Trần Lê Việt Hùng","p":null,"t":"INDIVIDUAL","q":11340,"pct":0.074,"d":"2015-09-14"},{"n":"Trần Quốc Việt","p":null,"t":"INDIVIDUAL","q":4508,"pct":0.029,"d":"2015-09-14"},{"n":"Võ Ngọc Thành","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.02,"d":"2025-10-05"},{"n":"Bùi Thị Kim Khuê","p":null,"t":"INDIVIDUAL","q":2236,"pct":0.012,"d":"2025-10-05"},{"n":"Trương Phú Chiến","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.011,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Duy","p":null,"t":"INDIVIDUAL","q":1503,"pct":0.009,"d":"2025-10-05"},{"n":"Ngô Thị Kim Phụng","p":null,"t":"INDIVIDUAL","q":830,"pct":0.005,"d":"2025-10-05"},{"n":"Trần Đức Tuyển","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":166,"pct":0.001,"d":"2025-10-05"},{"n":"Lê Hoài Nam","p":null,"t":"INDIVIDUAL","q":9,"pct":0.0,"d":"2015-09-14"},{"n":"Phan Văn Thiện","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":47,"pct":0.0,"d":"2025-10-05"}],"rel":[{"c":"12662","n":"Công Ty TNHH MTV Bibica Miền Tây","t":"subsidiary","pct":100.0},{"c":"12663","n":"Công ty TNHH MTV Bibica Biên Hòa","t":"subsidiary","pct":100.0},{"c":"12664","n":"Công ty TNHH Một Thành Viên Bibica Hà Nội","t":"subsidiary","pct":100.0},{"c":"PANCG","n":"CÔNG TY TNHH PHÂN PHỐI HÀNG TIÊU DÙNG BIB