ng trong lĩnh vực nuôi trồng và chế biến thủy sản xuất khẩu, và sản xuất thức ăn thủy sản. TCJ trở thành công ty đại chúng từ năm 2008. Công ty đã hình thành chuỗi sản xuất kinh doanh khép kín từ nuôi trồng thủy sản, sản xuất thức ăn thủy sản và chế biến thủy sản. Công ty là thành viên của Hiệp hội chế biến và xuất khẩu thủy sản Việt Nam (VASEP), và phòng công nghiệp- thương mại Việt Nam (VCCI). Thị trường xuất khẩu của công ty chủ yếu là Châu Âu và Châu Á. TCJ được giao dịch trên thị trường UPCOM từ cuối tháng 11/2017.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-11-24","state":0.654,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Lương thực Miền Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":6540000,"pct":65.4,"d":"2026-03-05"},{"n":"Nguyễn Thanh Hiền","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1230000,"pct":12.3,"d":"2026-06-30"},{"n":"Lê Phát Tài","p":null,"t":"INDIVIDUAL","q":920000,"pct":9.2,"d":"2026-06-30"},{"n":"Trần Tấn Đức","p":null,"t":"INDIVIDUAL","q":91400,"pct":0.91,"d":"2025-10-05"},{"n":"Nguyễn Hữu Trí","p":null,"t":"INDIVIDUAL","q":9000,"pct":0.09,"d":"2025-10-05"},{"n":"Huỳnh Đăng Khoa","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.03,"d":"2025-10-05"}],"events":[{"c":"DDINS","t":"Công ty CP Baomi Holdings - Đăng kí Bán TCJ","d":"2026-06-12","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Thanh Hiền - Đăng kí Mua TCJ","d":"2026-06-12","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Thanh Hiền - Đăng kí Bán TCJ","d":"2026-06-10","record":null,"ex":null},{"c":"AGME","t":"TCJ - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-19","record":"2026-05-27","ex":"2026-05-26"},{"c":"EGME","t":"TCJ - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-01-20","record":"2026-02-04","ex":"2026-02-03"},{"c":"AGME","t":"TCJ - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-22","record":"2025-05-05","ex":"2025-04-29"},{"c":"EGME","t":"TCJ - Tổ chức ĐHĐCĐ bất thường 2024","d":"2024-08-02