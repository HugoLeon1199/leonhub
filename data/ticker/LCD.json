iện Uông Bí mở rộng, CT Thủy Điện Sơn La, CTLọc Dầu Dung Quất, CT Nhiệt Điện Nhơn Trạch, CT Xi măng Thăng Long,….Ngày 15/11/2010, LCD chính thức giao dịch trên Sở Giao dịch Chứng Khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-11-15","state":0.36183333,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty lắp máy Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":542750,"pct":36.18,"d":"2026-06-04"},{"n":"Vũ Anh Tuấn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":350173,"pct":23.35,"d":"2026-08-12"},{"n":"Vũ Hoàng Tùng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":286350,"pct":19.09,"d":"2026-08-12"},{"n":"Vũ Thị Thúy Giang","p":null,"t":"INDIVIDUAL","q":255000,"pct":17.0,"d":"2026-03-06"},{"n":"Nguyễn Văn Hùng","p":null,"t":"INDIVIDUAL","q":36688,"pct":2.446,"d":"2015-09-14"},{"n":"Hoàng Minh Phương","p":null,"t":"INDIVIDUAL","q":29124,"pct":1.942,"d":"2015-09-14"},{"n":"Lương Văn Khải","p":null,"t":"INDIVIDUAL","q":14011,"pct":0.934,"d":"2015-09-14"},{"n":"Phan Trí Hùng","p":null,"t":"INDIVIDUAL","q":11833,"pct":0.789,"d":"2025-10-05"},{"n":"Lê Văn Định","p":null,"t":"INDIVIDUAL","q":10633,"pct":0.71,"d":"2025-10-05"},{"n":"Nguyễn Đình Bảo","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.667,"d":"2025-10-05"},{"n":"Vũ Quang Hưng","p":null,"t":"INDIVIDUAL","q":5566,"pct":0.371,"d":"2025-10-05"},{"n":"Lê Tuấn Anh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.13,"d":"2026-08-12"},{"n":"Nguyễn Mạnh Hưởng","p":null,"t":"INDIVIDUAL","q":88,"pct":0.006,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"LCD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-02","record":"2026-04-14","ex":"2026-04-13"},{"c":"DDINS","t":"Tổng Công ty lắp máy Việt Nam - Công ty Cổ phần - Đăng kí Bán 542,750 LCD","d":"2025-07-02","record":null,"ex":null},{"c":"AGME","t":"LCD - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-15","record":