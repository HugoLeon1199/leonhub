công ty là khai thác, sản xuất và cung cấp vật liệu xây dựng cho các công trình đân dụng, công nghiệp, giao thông và thủy điện. Là thành viên của Công ty Cổ phần Sông Đà 7, công ty được thực hiện phần lớn công việc Tổng Công ty Sông Đà giao cho Công ty Cổ phần Sông Đà 7. Công ty đã và đang cung cấp vật liệu cho những công trình lớn mang tầm cỡ quốc gia như công trình thủy điện Huội Quảng, thủy điện Sơn La. S74 tiếp tục sản xuất và cung cấp hơn 2 triệu m3 đá dăm các loại và khoảng 1,2 triệu m3 cát nhân tạo đáp ứng đủ nhu cầu vật liệu thi công bê tông đầm lăn (RCC) và bê tông lạnh (CVC) tại công trình. Tổng công suất lắp đặt của 04 dây truyền nghiền sàng đá tại CTTĐ Lai Châu có công suất 1.600.000 m3 /năm.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-07-02","state":0.2345679,"foreign":0.00995617,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Đầu Tư Thương Mại Sông Đà Miền Bắc","p":null,"t":"CORPORATE","q":3816372,"pct":58.89,"d":"2026-03-03"},{"n":"Đặng Thị Hồng Hạnh","p":null,"t":"INDIVIDUAL","q":1600000,"pct":24.691,"d":"2026-03-03"},{"n":"Nguyễn Hữu Chuẩn","p":null,"t":"INDIVIDUAL","q":424450,"pct":6.55,"d":"2026-07-24"},{"n":"Nguyễn Ngọc Minh","p":null,"t":"INDIVIDUAL","q":250500,"pct":4.175,"d":"2015-09-14"},{"n":"Chu Thị Chiến","p":"Thư ký Hội đồng Quản Trị","t":"INDIVIDUAL","q":12188,"pct":0.188,"d":"2026-03-03"},{"n":"Phạm Đình Hùng","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.117,"d":"2015-09-14"},{"n":"Nguyễn Hữu Doanh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5400,"pct":0.083,"d":"2026-03-03"},{"n":"Nguyễn Khắc Tiến","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.083,"d":"2015-09-14"},{"n":"Nguyễn Thông Hoa","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.083,"d":"2015-09-14"},{"n":"Nguyễn Tuấn Anh","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.083,"d":"2015-09-14"},{"n":"Trần Văn Tài","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":4860,"pct":0.075,"d":"2026-03-03"},{"n":"Nguyễn Xuân Đức","p":nul