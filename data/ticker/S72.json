hần Sông Đà 7.02 (S72) được thành lập vào năm 2004. Công ty hoạt động trong lĩnh vực thi công xây lắp các công trình công nghiệp, thủy lợi, dân dụng sản xuất chế biến vật liệu xây dưng và đầu tư xây dựng các công trình thủy điện. S72 trở thành công ty đại chúng từ năm 2010. Công ty đã tham gia thi công xây lắp nhiều dự án thủy điện lớn như Công trình Thủy điện Sơn La, Công trình Thủy điện Sử Pán II, Công trình Thủy điện Bản Chát. S72 đang thực hiện đầu tư xây dựng công trình thủy điện Nậm Thi với công suất 18MW tại huyện Tam Đường, tỉnh Lai Châu. Bên cạnh đó, Công ty còn tham gia sản xuất cung ứng vật liệu xây dựng. S72 được giao dịch trên thị trường UPCOM từ tháng 05/2018.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2018-05-22","state":0.0,"foreign":0.00033333,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Sông Đà 7","p":null,"t":"CORPORATE","q":4177406,"pct":34.812,"d":"2026-01-22"},{"n":"Công ty Cổ phần Sông Đà 7.04","p":null,"t":"CORPORATE","q":4080000,"pct":34.0,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Thủy Điện Cao Nguyên - Sông Đà 7","p":null,"t":"CORPORATE","q":1920000,"pct":16.0,"d":"2026-01-22"},{"n":"Phạm Văn Phong","p":"Kế toán trưởng/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":25021,"pct":0.2,"d":"2026-08-20"},{"n":"Nguyễn Hữu Doanh","p":null,"t":"INDIVIDUAL","q":14589,"pct":0.12,"d":"2026-08-20"},{"n":"NGUYỄN VĂN BÚT","p":null,"t":"INDIVIDUAL","q":7200,"pct":0.06,"d":"2025-10-05"},{"n":"Nguyễn Văn Bút","p":null,"t":"INDIVIDUAL","q":7200,"pct":0.06,"d":"2020-09-21"},{"n":"Nguyễn Xuân Đức","p":null,"t":"INDIVIDUAL","q":131,"pct":0.001,"d":"2025-10-05"},{"n":"Ngô Quốc Thế","p":null,"t":"INDIVIDUAL","q":131,"pct":0.001,"d":"2025-10-05"}],"rel":[{"c":"XLSDHL","n":"Công ty Cổ Phần Xây Lắp Sông Đà Hoàng Liên","t":"affiliate","pct":20.29}],"rel_count":1,"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Quyền mua CP cho Cổ đông hiện hữu tỉ lệ 80.0%","d":"2026-04-28","record":null,"ex":null},