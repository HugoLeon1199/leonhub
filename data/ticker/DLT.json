g, vận chuyển. Ngoài ra, Công ty còn cung cấp các dịch vụ cho sản xuất và tiêu dùng, chế biến và kinh doanh than,vật tư thiết bị, giáo dục đào tạo, mua bán ký gửi. DLT chính thức hoạt động theo mô hình công ty cổ phần từ năm 2004. DLT được giao dịch trên thị trường UPCOM từ năm 2005.","sector":"Du lịch và Giải trí","type":"CT","listed":"2015-11-16","state":0.36000034,"foreign":0.00039999,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Công nghiệp Than - Khoáng sản Việt Nam","p":null,"t":"CORPORATE","q":900021,"pct":36.0,"d":"2026-08-06"},{"n":"Công ty Cổ Phần Lốp Xe Việt","p":null,"t":"CORPORATE","q":375000,"pct":15.0,"d":"2026-08-06"},{"n":"Đặng Quỳnh Tiên","p":null,"t":"INDIVIDUAL","q":219213,"pct":8.77,"d":"2026-06-23"},{"n":"Nguyễn Quỳnh Phương","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":174463,"pct":6.98,"d":"2026-08-06"},{"n":"Nguyễn Mạnh Toàn","p":null,"t":"INDIVIDUAL","q":137923,"pct":5.51,"d":"2026-06-23"},{"n":"Nguyễn Thanh Tùng","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":44392,"pct":1.77,"d":"2026-08-06"},{"n":"Bùi Thanh Trường","p":null,"t":"INDIVIDUAL","q":31324,"pct":1.25,"d":"2025-10-05"},{"n":"Bùi Thanh Hùng","p":null,"t":"INDIVIDUAL","q":20751,"pct":0.83,"d":"2025-10-05"},{"n":"Phan Thành Chung","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":20500,"pct":0.81,"d":"2026-08-06"},{"n":"PHAN THỊ HẰNG","p":null,"t":"INDIVIDUAL","q":18504,"pct":0.74,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Oanh","p":null,"t":"INDIVIDUAL","q":15254,"pct":0.61,"d":"2025-10-05"},{"n":"Nguyễn Thành Trung","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":14539,"pct":0.58,"d":"2026-08-06"},{"n":"Trần Tất Thành","p":null,"t":"INDIVIDUAL","q":10016,"pct":0.4,"d":"2025-10-05"},{"n":"Trịnh Đăng Thuận","p":"Phụ trách Công bố thông tin/Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":10169,"pct":0.4,"d":"2025-10-05"},{"n":"Trần Thị Ngọc Uyển","p":null,"t":"INDIVIDUAL","q":9059,