019",8.472],["2020",13.98],["2021",11.929],["2022",11.164],["2023",4.405],["2024",-4.165],["2025",2.243]]}},"co":{"short":"Nhiệt điện Ninh Bình","profile":"Công ty Cổ phần Nhiệt Điện Ninh Bình (NBP) tiền thân là Nhà máy Điện Ninh Bình trực thuộc Công ty Điện lực miền Bắc thành lập năm 1974. Năm 2006, Công ty chuyển đổi mô hình kinh doanh hoạt động là Công ty Cổ phần. Lĩnh vực hoạt động kinh doanh chủ yếu của Công ty là: Sản xuất điện năng; Quản lý, vận hành, bảo dưỡng sửa chữa thí nghiệm hiệu chỉnh thiết bị điện, công trình kiến trúc nhà máy điện; Lắp đặt hệ thống điện (đường dây và trạm biến áp)... Công ty có địa bàn đặt tại tỉnh Ninh Bình, chuyên cung cấp điện thương phẩm cho Tổng công ty điện lực Việt Nam (EVN) và phân phối điện cho các tỉnh miền Bắc. Sở hữu nhà máy có 4 tổ lò máy, mỗi tổ có công suất lắp đặt là 25MW, tổng công suất là 100MW. Ngoài ra, Công ty đang được giao nhiệm vụ thay mặt EVN quản lý dự án nhà máy nhiệt điện Thái Bình 1 được xây dựng tại Xã Mỹ Lộc - Thái Bình với tổng công suất lắp đặt là 600MW. Ngày 06/08/2009, NBP chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2009-08-06","state":0.54762271,"foreign":0.01341572,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Phát điện 3 - Công ty Cổ phần","p":null,"t":"CORPORATE","q":7045440,"pct":54.76,"d":"2026-05-14"},{"n":"Công ty Cổ Phần Dịch Vụ Vận Tải Thuận Hải","p":null,"t":"CORPORATE","q":3806700,"pct":29.59,"d":"2025-10-05"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":642600,"pct":4.99,"d":"2025-10-05"},{"n":"Trần Kế Tấn","p":null,"t":"INDIVIDUAL","q":56000,"pct":0.435,"d":"2015-09-14"},{"n":"Phạm Ngọc Hòa","p":null,"t":"INDIVIDUAL","q":12600,"pct":0.098,"d":"2015-09-14"},{"n":"Nguyễn Thọ Tiệm","p":null,"t":"INDIVIDUAL","q":12400,"pct":0.096,"d":"2015-09-14"},{"n":"Tống Đức Chính","p":null,"t":"INDIVIDUAL","q":12100,"pct":0.094,"d":"2025-10-05