 huy động vốn và cho vay tín dụng. HDB lần lượt được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ cuối năm 2017 và đầu năm 2018. Năm 2025, so với cùng kỳ, biên lãi thuần (NIM) ở mức 4.53%, giảm 0.67%. Tỷ lệ nợ xấu ở mức 2.44%, tăng 0.5%. Tỷ lệ bao phủ nợ xấu ở mức 54.8%, giảm 13.91%. Lợi nhuận sau thuế công ty mẹ có giá trị bằng 16,5 nghìn tỷ đồng, tăng 29.47%. Tỷ suất lợi nhuận trên vốn chủ sở hữu (ROE) ở mức 25.41%, giảm 0.38%.","sector":"Ngân hàng","type":"NH","listed":"2018-01-05","state":0.02777166,"foreign":0.21641465,"rating":"BUY","target":33000.0,"rating_as_of":"2026-03-06","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Sovico","p":null,"t":"CORPORATE","q":500140707,"pct":9.992,"d":"2026-08-17"},{"n":"Phạm Văn Đẩu","p":"Giám đốc Tài chính/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":194638356,"pct":3.89,"d":"2026-07-31"},{"n":"Clarendelle Investment PTE. Ltd","p":null,"t":"CORPORATE","q":141834905,"pct":3.689,"d":"2025-11-12"},{"n":"Core Capital (1) PTE. Ltd","p":null,"t":"CORPORATE","q":141834905,"pct":3.689,"d":"2025-11-12"},{"n":"Nguyễn Thị Phương Thảo","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":169574091,"pct":3.388,"d":"2026-07-31"},{"n":"Lưu Văn Sơn","p":null,"t":"INDIVIDUAL","q":15044904,"pct":3.009,"d":"2015-09-14"},{"n":"Công ty Đầu tư Tài chính Nhà nước Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":93591512,"pct":2.666,"d":"2025-10-05"},{"n":"Đào Duy Tường","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":124167780,"pct":2.481,"d":"2026-07-31"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":64476672,"pct":2.2,"d":"2025-10-05"},{"n":"Sky Capital Advisor Pte.ltd.","p":null,"t":"CORPORATE","q":78885373,"pct":2.044,"d":"2025-11-12"},{"n":"Baillie Gifford Pacific Fund","p":null,"t":"CORPORATE","q":67987441,"pct":1.937,"d":"2025-10-05"},{"n":"Tianhong Vietnamese Market Equity Launched QDII Fund","p":null,"t":"CORPORATE","q":59195721,"pct":1.686,"d":