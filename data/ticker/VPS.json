uất và kinh doanh thuốc bảo vệ thực vật, phân bón, dịch vụ khử trùng và thuốc sát trùng gia dụng, vật tư phục vụ ngành nông nghiệp. VPS chính thức hoạt động theo mô hình công ty cổ phần từ năm 2006. Hiện tại, sản phẩm của công ty đã được xuất khẩu sang Đài Loan, Cambodia, Myanmar. VPS được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2015.","sector":"Hóa chất","type":"CT","listed":"2015-08-19","state":0.51000017,"foreign":0.00059373,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Hóa chất Việt Nam","p":null,"t":"CORPORATE","q":12475008,"pct":51.0,"d":"2026-07-20"},{"n":"Nguyễn Đức Thuấn","p":null,"t":"INDIVIDUAL","q":4948720,"pct":20.23,"d":"2026-07-20"},{"n":"Lâm Thị Mai","p":null,"t":"INDIVIDUAL","q":2062980,"pct":8.43,"d":"2026-07-20"},{"n":"Trịnh Quang Nghĩa","p":null,"t":"INDIVIDUAL","q":1376117,"pct":6.232,"d":"2025-11-26"},{"n":"Công Ty Cổ Phần Đầu Tư Và Xúc Tiến Thương Mại Việt Nam Lefaso","p":null,"t":"CORPORATE","q":228424,"pct":0.93,"d":"2025-10-05"},{"n":"Ctcp Đầu Tư Thái Bình","p":null,"t":"CORPORATE","q":214816,"pct":0.88,"d":"2025-10-05"},{"n":"Nguyễn Thân","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":40149,"pct":0.164,"d":"2026-02-27"},{"n":"Trần Thị Mộng Thu","p":null,"t":"INDIVIDUAL","q":11760,"pct":0.048,"d":"2025-10-05"},{"n":"Nguyễn Xuân Khánh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":8310,"pct":0.034,"d":"2026-02-27"},{"n":"Nguyễn Thị Thu Hoài","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":5488,"pct":0.022,"d":"2026-02-27"},{"n":"Nguyễn Xuân Đà","p":null,"t":"INDIVIDUAL","q":4704,"pct":0.019,"d":"2025-10-05"},{"n":"Cao Minh Kiệm","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2979,"pct":0.012,"d":"2026-02-27"},{"n":"Thái Nguyên Luật","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1568,"pct":0.006,"d":"2026-02-27"},{"n":"Văn Phú Tâm","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.006,"d":"2025-10-05"},{"n":"Đoàn Tấn Vinh","p":null,"t":"I