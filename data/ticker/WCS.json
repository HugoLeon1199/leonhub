h lập năm 1970. Năm 2005, Công ty chuyển sang hoạt động theo mô hình công ty cổ phần. Công ty hoạt động chính trong lĩnh vực khai thác và kinh doanh bến xe; khai thác dịch vụ phục vụ trong bến xe. Hiện tại WCS đang quản lý Bến xe Ngã Tư ga (Quận 12 Thành phố Hồ Chí Minh), Bến xe An Sương (Quận 12 thành phố Hồ Chí Minh), Bến xe tàu Bạc Liêu (Thành phố Bạc Liêu - Tỉnh Bạc Liêu), Bến xe và Phà Bến Tre (Thành phố Bến Tre). Công ty có trên 145 đơn vị vận tải với khoảng 3.450 phương tiện, hoạt động trên 172 tuyến đường về 29 tỉnh, thành phố khắp cả nước. Năm 2010, WCS chính thức được niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-09-17","state":0.51,"foreign":0.27726933,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cơ khí Giao thông Vận tải Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":1530000,"pct":51.0,"d":"2026-07-29"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":708240,"pct":24.0,"d":"2026-07-29"},{"n":"Công Ty Cổ Phần Đầu Tư Thái Bình","p":null,"t":"CORPORATE","q":250500,"pct":10.02,"d":"2015-06-15"},{"n":"Ctcp Đầu Tư Thái Bình","p":null,"t":"CORPORATE","q":300600,"pct":10.0,"d":"2026-07-29"},{"n":"Huỳnh Hải Oanh","p":null,"t":"INDIVIDUAL","q":3900,"pct":0.156,"d":"2015-09-14"},{"n":"Kiều Nam Thành","p":null,"t":"INDIVIDUAL","q":3900,"pct":0.156,"d":"2015-09-14"},{"n":"Phạm Văn Thông","p":null,"t":"INDIVIDUAL","q":2600,"pct":0.104,"d":"2015-09-14"},{"n":"Nguyễn Văn Thành","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":600,"pct":0.02,"d":"2026-07-29"}],"events":[{"c":"AGME","t":"WCS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-22","record":"2026-05-12","ex":"2026-05-11"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 16,666 VND","d":"2025-12-09","record":"2025-12-16","ex":"2025-12-15"},{"c":"AIS","t":"WCS - Niêm yết bổ sung 500.000 cổ phiếu","d":"2025-09-24","record":null,"ex":null},{"c