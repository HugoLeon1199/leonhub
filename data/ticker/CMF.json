["2021",26.897],["2022",26.196],["2023",21.862],["2024",19.868],["2025",22.06]]}},"co":{"short":"Thực phẩm Cholimex","profile":"Công ty Cổ phần Thực phẩm Cholimex (CMF) có tiền thân là Xí nghiệp chế biến hàng xuất khẩu Quận 5, được thành lập vào năm 1983. CMF hoạt động chính trong lĩnh vực sản xuất kinh doanh gia vị, nước chấm, hải sản đông lạnh và thực phẩm tinh chế. Công ty chính thức hoạt động theo mô hình công ty cổ phần từ năm 2006. Công ty hiện giữ vững vị thế dẫn đầu trong ngành hàng sauce và gia vị, với hệ thống phân phối rộng khắp cả nước và là nhà cung cấp cho nhiều nhãn hàng lớn. CMF được giao dịch trên thị trường UPCOM từ tháng 11/2016.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2016-11-30","state":0.40716049,"foreign":0.24582383,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Xuất nhập khẩu và Đầu tư Chợ Lớn (CHOLIMEX)","p":null,"t":"CORPORATE","q":3298000,"pct":40.72,"d":"2026-08-04"},{"n":"Công ty TNHH MTV Thực Phẩm Masan","p":null,"t":"CORPORATE","q":2659217,"pct":32.83,"d":"2025-12-23"},{"n":"Nichirei Foods Inc.","p":null,"t":"CORPORATE","q":1539000,"pct":19.0,"d":"2025-12-23"},{"n":"Diệp Nam Hải","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":21000,"pct":0.26,"d":"2026-08-04"},{"n":"Dương Văn Hùng","p":null,"t":"INDIVIDUAL","q":10600,"pct":0.13,"d":"2025-10-05"},{"n":"Nguyễn Thị Huyền Trang","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":4000,"pct":0.05,"d":"2026-08-04"},{"n":"Nguyễn Thị Bích Ngọc","p":"Giám đốc Tài chính/Kế toán trưởng","t":"INDIVIDUAL","q":3000,"pct":0.04,"d":"2026-08-04"},{"n":"Hồ Ngọc Hương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2300,"pct":0.03,"d":"2026-08-04"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2025 - 5,000 VND","d":"2026-03-05","record":"2026-03-20","ex":"2026-03-19"},{"c":"AGME","t":"CMF - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-05","record":"2026-03-20","ex":"2026-03-19"},{"