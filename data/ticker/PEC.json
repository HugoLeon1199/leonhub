iện lực (PEC) thành lập năm 2004 từ việc chuyển đổi Nhà máy Cơ khí Yên Viên. Công ty hoạt động chính trong lĩnh vực thủy công; mạ kẽm nóng, kết cấu thép. Trong đó doanh thu đến từ hoạt thủy công chiếm tỷ trọng cao. Công ty có khả năng chế tạo kết cấu thủy công , thiết bị phi tiêu chuẩn, cột điện thép mạ kẽm nhúng nóng đồng bộ đến 500KV với sả lượng 14.400 tấn/năm và chế tạo các loại Bulông và phụ kiện đường dây mạ kẽm với sản lượng 3.000 tấn/năm.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-10-06","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Minh Hải","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":1130780,"pct":36.296,"d":"2025-10-05"},{"n":"Lê Nam Hưng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":773351,"pct":24.823,"d":"2025-10-05"},{"n":"Nguyễn Tiến Đạt","p":null,"t":"INDIVIDUAL","q":718971,"pct":23.08,"d":"2025-10-05"},{"n":"Nguyễn Trần Tuấn","p":null,"t":"INDIVIDUAL","q":196431,"pct":6.31,"d":"2025-10-05"},{"n":"Lê Đăng Thuận","p":null,"t":"INDIVIDUAL","q":38037,"pct":1.22,"d":"2025-10-05"},{"n":"Phạm Thu Hằng","p":null,"t":"INDIVIDUAL","q":20744,"pct":0.666,"d":"2025-10-05"},{"n":"Hoàng Đức Trung","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.257,"d":"2015-09-14"},{"n":"Lê Định","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.257,"d":"2015-09-14"},{"n":"Phan Đức Tiến","p":null,"t":"INDIVIDUAL","q":6170,"pct":0.227,"d":"2015-09-14"},{"n":"Phùng Hoài Linh","p":null,"t":"INDIVIDUAL","q":5200,"pct":0.191,"d":"2015-09-14"},{"n":"Nguyễn Văn Khánh","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.184,"d":"2015-09-14"},{"n":"Vũ Ngọc Đàm","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.184,"d":"2015-09-14"},{"n":"Đào Quốc Tuấn","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.184,"d":"2015-09-14"},{"n":"Hà Thanh Thủy","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.037,"d":"2025-10-05"}],"rel":[{"c":"0102277988","n":"Công ty Cổ Phần Thương Mại Và 