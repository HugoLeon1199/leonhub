gestone, Dunlop, Yokohama. Ngày 09/05/2023, VKC chính thức giao dịch trên thị trường UPCOM.","sector":"Ô tô và phụ tùng","type":"CT","listed":"2010-12-08","state":0.0,"foreign":0.0139857,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Thân Xuân Nghĩa","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3000000,"pct":15.56,"d":"2026-08-06"},{"n":"Võ Xuân Phong","p":null,"t":"INDIVIDUAL","q":904800,"pct":4.69,"d":"2025-10-05"},{"n":"Lâm Quy Chương","p":null,"t":"INDIVIDUAL","q":200000,"pct":1.04,"d":"2025-10-05"},{"n":"Đỗ Ngọc Nam","p":null,"t":"INDIVIDUAL","q":200000,"pct":1.04,"d":"2025-10-05"},{"n":"Trần Mạnh","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.385,"d":"2015-09-14"},{"n":"Lê Minh Chi","p":null,"t":"INDIVIDUAL","q":51000,"pct":0.25,"d":"2025-10-05"},{"n":"Lê Phẩm Vinh","p":null,"t":"INDIVIDUAL","q":12510,"pct":0.096,"d":"2015-09-14"},{"n":"Nguyễn Thanh Tùng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.05,"d":"2025-10-05"},{"n":"Phạm Tiến Dũng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.026,"d":"2025-10-05"},{"n":"Hà Anh Tuấn","p":null,"t":"INDIVIDUAL","q":500,"pct":0.003,"d":"2025-10-05"},{"n":"Quỹ Đầu tư Cổ phiếu Manulife","p":null,"t":"CORPORATE","q":61,"pct":0.0,"d":"2020-07-14"}],"rel":[{"c":"3703278004","n":"Công ty Cổ Phần Sản Xuất Cáp Nhựa Vĩnh Khánh","t":"subsidiary","pct":97.0},{"c":"3703250383","n":"Công ty Cổ Phần Đầu Tư Kinh Doanh Vĩnh Khánh","t":"subsidiary","pct":92.11}],"rel_count":2,"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 881.8%","d":"2026-07-02","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 285.3%","d":"2026-07-02","record":null,"ex":null},{"c":"AGME","t":"VKC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-08","record":"2026-06-01","ex":"2026-05-29"},{"c":"DDIND","t":"Phạm Thị Lan - Đăng kí Bán 1,197,200 VKC","d":"2025-06-25","record":null,"ex":null},{"c":"DDIND","t":"Phạm Thị Lan - Đăng kí Bán 1,197,200 VKC","d":"2025-04-04","