 Năm 2007 cổ phiếu của Công ty niêm yết tại HNX.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2007-11-27","state":0.53860746,"foreign":0.00381872,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Xi măng Việt Nam","p":null,"t":"CORPORATE","q":1086040,"pct":53.861,"d":"2026-08-10"},{"n":"Nguyễn Tuấn Anh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":497900,"pct":24.69,"d":"2026-08-10"},{"n":"Nguyễn Thị Huyền Nhung","p":null,"t":"INDIVIDUAL","q":105400,"pct":5.23,"d":"2025-10-05"},{"n":"Nguyễn Đặng Bảo Linh","p":null,"t":"INDIVIDUAL","q":101200,"pct":5.02,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán Hải Phòng","p":null,"t":"CORPORATE","q":25000,"pct":1.24,"d":"2015-06-15"},{"n":"Vũ Châu Thành","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.49,"d":"2025-10-05"},{"n":"Vũ Văn Đức","p":null,"t":"INDIVIDUAL","q":2800,"pct":0.139,"d":"2015-09-14"},{"n":"Lê Văn Thắng","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":2500,"pct":0.12,"d":"2026-08-10"},{"n":"NGUYỄN THÀNH PHƯƠNG","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.12,"d":"2025-10-05"},{"n":"Vũ Xuân Bằng","p":null,"t":"INDIVIDUAL","q":1840,"pct":0.091,"d":"2015-09-14"},{"n":"Trần Thị Bích Hà","p":null,"t":"INDIVIDUAL","q":1500,"pct":0.074,"d":"2015-09-14"},{"n":"Hồ Thị Vân","p":null,"t":"INDIVIDUAL","q":1120,"pct":0.056,"d":"2015-09-14"},{"n":"Đặng Văn Hải","p":null,"t":"INDIVIDUAL","q":900,"pct":0.045,"d":"2015-09-14"},{"n":"Lương Quang Tân","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":700,"pct":0.035,"d":"2026-08-10"},{"n":"Đinh Văn Liêm","p":null,"t":"INDIVIDUAL","q":600,"pct":0.03,"d":"2015-09-14"},{"n":"Phạm Đăng Lợi","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":560,"pct":0.028,"d":"2026-08-10"},{"n":"Trịnh Thị Hương","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":500,"pct":0.025,"d":"2026-08-10"},{"n":"Trần Quang Hiển","p":null,"t":"INDIVIDUAL","q":200,"pct":0.01,"d":"2015-09-14"}],"events":[{"c":"AGME","t":