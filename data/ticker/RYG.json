ưởng rộng 60.000 m2 với công xuất khoảng 12.000.000 m2/năm. Hệ thống phân phối với hơn 3.000 cửa hàng, đại lý và showroom của công ty được trải dài khắp các tỉnh thành Việt Nam. Các sản phẩm của công ty đã được xuất khẩu đến nhiều quốc qia, khu vực như: Đông Bắc Á (Đài Loan, Hàn Quốc), Đông Nam Á (Campuchia, Thái Lan, Malaysia, Myanmar, Philippines), Mỹ và Trung Đông. Ngày 12/12/2024, RYG chính thức giao dịch trên Sở Giao dịch Chứng khoán Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2024-12-12","state":0.0,"foreign":8e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đinh Việt Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":9360000,"pct":20.8,"d":"2026-08-10"},{"n":"Nguyễn Thị Lê","p":null,"t":"INDIVIDUAL","q":4816000,"pct":10.7,"d":"2026-08-17"},{"n":"Công ty Cổ phần Chứng khoán Bảo Minh","p":null,"t":"CORPORATE","q":2075000,"pct":4.611,"d":"2025-11-27"},{"n":"Nguyễn Văn Vinh","p":null,"t":"INDIVIDUAL","q":2030000,"pct":4.511,"d":"2025-11-27"},{"n":"Phan Bá Hiệu","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1840600,"pct":4.09,"d":"2026-08-10"},{"n":"Nguyễn Minh Tuyển","p":null,"t":"INDIVIDUAL","q":1673100,"pct":3.72,"d":"2026-07-20"},{"n":"Huỳnh Quang Báu","p":null,"t":"INDIVIDUAL","q":1620000,"pct":3.6,"d":"2025-11-27"},{"n":"Lê Thị Vi Na","p":null,"t":"INDIVIDUAL","q":1000000,"pct":2.22,"d":"2025-11-13"},{"n":"Trịnh Xuân Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":720000,"pct":1.6,"d":"2026-08-10"},{"n":"Trương Văn Việt","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":393000,"pct":0.873,"d":"2026-08-10"},{"n":"Nguyễn Thị Kim Loan","p":"Kế toán trưởng/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":358000,"pct":0.796,"d":"2026-08-10"},{"n":"Đinh Quốc Anh","p":null,"t":"INDIVIDUAL","q":45000,"pct":0.1,"d":"2026-08-10"}],"rel":[{"c":"3602194679","n":"Công ty Cổ Phần Sản Xuất Và Đầu Tư Royal Sintered Stone","t":"subsidiary","pct":92.006},{"c":"