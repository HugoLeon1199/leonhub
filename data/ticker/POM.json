Thị trường chính của công ty bao gồm toàn bộ khu vực miền Trung, các tỉnh Đồng bằng Sông Cửu Long và thị trường Campuchia. Pomina là nhà máy thép lớn nhất Việt Nam với tổng công suất luyện phôi thép 1,5 triệu tấn, công suất cán thép 1,1 triệu tấn. Mạng lưới phân phối của công ty rộng khắp với 7 tổng đại lý và hơn 800 đại lý thứ cấp. Ngày 23/05/2024, POM chính thức giao dịch trên thị trường UPCOM.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2010-04-20","state":0.0,"foreign":0.03909455,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Tm - Sx Thép Việt","p":null,"t":"CORPORATE","q":146335815,"pct":52.54,"d":"2026-03-17"},{"n":"Công ty TNHH Thương Mại Và Sản Xuất Thép Việt","p":null,"t":"CORPORATE","q":116335815,"pct":41.77,"d":"2026-08-10"},{"n":"Đỗ Tiến Sĩ","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":8602216,"pct":3.088,"d":"2026-08-10"},{"n":"Phạm Thanh Nghị","p":null,"t":"INDIVIDUAL","q":8383784,"pct":3.0,"d":"2026-08-10"},{"n":"Trần Kim Phượng","p":null,"t":"INDIVIDUAL","q":7602986,"pct":2.72,"d":"2026-08-10"},{"n":"Đỗ Văn Phúc","p":null,"t":"INDIVIDUAL","q":3536538,"pct":1.27,"d":"2026-08-10"},{"n":"Nguyễn Thanh Lan","p":null,"t":"INDIVIDUAL","q":3256275,"pct":1.169,"d":"2026-08-10"},{"n":"Đỗ Thị Kim Ngọc","p":null,"t":"INDIVIDUAL","q":2358106,"pct":0.84,"d":"2026-08-10"},{"n":"Đỗ Xuân Chiểu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1650480,"pct":0.59,"d":"2026-08-10"},{"n":"Đỗ Duy Thái","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":869400,"pct":0.31,"d":"2026-08-10"},{"n":"Đỗ Hoài Khánh Linh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":542811,"pct":0.19,"d":"2026-08-10"},{"n":"Trần Kim Giao","p":null,"t":"INDIVIDUAL","q":6016,"pct":0.002,"d":"2026-08-10"},{"n":"Trần Tô Tử","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":4297,"pct":0.002,"d":"2026-08-10"}],"rel":[{"c":"POM2","n":"Công ty Cổ phần Thép Pomina 2","t":"subsidiary","pct":99.5}],"rel_co