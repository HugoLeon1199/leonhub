7.174]]}},"co":{"short":"Chứng khoán Vietcap","profile":"Công ty Cổ phần Chứng khoán Vietcap (VCI), tiền thân là Công ty Cổ phần Chứng khoán Bản Việt, được thành lập và chính thức hoạt động vào năm 2007. Công ty hoạt động chính trong lĩnh vực dịch vụ môi giới chứng khoán, ngân hàng đầu tư và dịch vụ nghiên cứu chứng khoán. Năm 2025, Doanh thu nghiệp vụ môi giới chứng khoán có giá trị bằng 1.000,21 tỷ đồng, tăng 37.09% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 88.97%, tăng 3.18%. Lợi nhuận trước thuế có giá trị bằng 1.629,22 tỷ đồng, tăng 49.56%. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 8.67%, giảm 0.29%. VCI được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2017.","sector":"Dịch vụ tài chính","type":"CK","listed":"2017-07-07","state":0.0,"foreign":0.17058721,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tô Hải","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":205388194,"pct":17.84,"d":"2026-08-26"},{"n":"Nguyễn Thanh Phượng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":22815000,"pct":3.18,"d":"2026-07-31"},{"n":"Nguyễn Quang Bảo","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3287610,"pct":0.29,"d":"2026-07-31"},{"n":"Trần Quyết Thắng","p":null,"t":"INDIVIDUAL","q":702000,"pct":0.16,"d":"2025-10-05"},{"n":"Tôn Minh Phương","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1126650,"pct":0.1,"d":"2026-07-31"},{"n":"Tuan Nhan","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":758000,"pct":0.07,"d":"2026-07-31"},{"n":"Đinh Quang Hoàn","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":797436,"pct":0.07,"d":"2026-07-31"},{"n":"Đoàn Minh Thiện","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":858850,"pct":0.07,"d":"2026-07-31"},{"n":"Quỹ Đầu tư Tăng trưởng Thiên Việt 2","p":null,"t":"CORPORATE","q":100000,"pct":0.061,"d":"2020-07-14"},{"n":"Công ty Cổ phần Quản lý quỹ đầu tư chứng khoán Bản Việt","p":null,"t":"CORPORATE","q":580500,"pct":0.05,"d"