uỷ điện Nậm Mu (HJS) tiền thân là Nhà máy xây dựng năm 2002. Hoạt động kinh doanh chính của Công ty là sản xuất và cung cấp điện năng cho hệ thống lưới điện quốc gia theo hợp đồng ký kết dài hạn với Tổng công ty điện lực Việt nam. Thủy điện Nậm mu nằm trên địa bàn xã Tân thành, huyện Bắc quang, Hà giang là nơi có lượng mưa hàng năm lớn nhất miền Bắc, trung bình 3.500mm/năm. Thủy điện Nậm Mu thuộc các nhà máy điện có công suất nhỏ (hệ thống điện của Việt nam tính đến tháng 7/2005 có công suất là 11.286 MW) có sản lượng điện trung bình 60 triệu KW/năm.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2006-12-20","state":6.67e-06,"foreign":0.00145215,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Sông Đà 9","p":null,"t":"CORPORATE","q":10710000,"pct":51.0,"d":"2026-06-22"},{"n":"Công ty Cổ phần Đầu tư ICAPITAL","p":null,"t":"CORPORATE","q":3840100,"pct":18.29,"d":"2025-10-27"},{"n":"Công ty Cổ Phần Dây Điện Và Phích Cắm Trần Phú","p":null,"t":"CORPORATE","q":3742200,"pct":17.82,"d":"2025-10-27"},{"n":"Công ty Cổ phần Chứng khoán VIX","p":null,"t":"CORPORATE","q":1005162,"pct":4.79,"d":"2025-10-05"},{"n":"Công ty Cổ phần Hạ tầng Gelex","p":null,"t":"CORPORATE","q":840962,"pct":4.0,"d":"2025-10-05"},{"n":"Đoàn Hùng Sơn","p":null,"t":"INDIVIDUAL","q":31250,"pct":0.208,"d":"2015-09-14"},{"n":"Đỗ Văn Hà","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.048,"d":"2020-08-04"},{"n":"Nguyễn Xuân Hồng","p":null,"t":"INDIVIDUAL","q":6500,"pct":0.043,"d":"2015-09-14"},{"n":"Lê Văn Hưng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.033,"d":"2015-09-14"},{"n":"Bùi Trọng Cẩn","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":5302,"pct":0.025,"d":"2026-08-28"},{"n":"Nguyễn Đức Nang","p":null,"t":"INDIVIDUAL","q":3750,"pct":0.025,"d":"2015-09-14"},{"n":"Phùng Xuân Hưng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.02,"d":"2025-10-05"},{"n":"Công ty TNHH Quản lý Quỹ Bảo Việt","p":null,"t":"CORPORATE","q":80,"pct":