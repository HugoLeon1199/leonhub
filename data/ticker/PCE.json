n và Hóa chất Dầu khí. Thị trường tiêu thụ của Công ty chiếm 70% thị phần Đạm Phú Mỹ tại thị trường khu vực miền Trung – Tây Nguyên. Công ty là đơn vị thành viên của Tổng Công ty Phân bón và Hóa chất Dầu khí, do đó PCE luôn nhận được sự giúp đỡ về vốn, chiến lược mở rộng thị phần, cũng như hệ thống kênh phân phối của Tổng Công ty. PVFCCo Central là nhà phân phối phân bón lớn nhất tại khu vực Miền Trung Tây Nguyên. Ngày 23/07/2015, PCE chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hóa chất","type":"CT","listed":"2015-07-23","state":0.75,"foreign":0.00421,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Phân bón và Hóa chất Dầu khí - Công ty Cổ phần","p":null,"t":"CORPORATE","q":7500000,"pct":75.0,"d":"2026-02-27"},{"n":"Nguyễn Hữu Luận","p":null,"t":"INDIVIDUAL","q":850000,"pct":8.5,"d":"2025-10-13"},{"n":"Công ty Cổ phần Công nghiệp Hóa chất Đà Nẵng","p":null,"t":"CORPORATE","q":500000,"pct":5.0,"d":"2025-10-13"},{"n":"Công ty TNHH MTV Minh Tân","p":null,"t":"CORPORATE","q":300000,"pct":3.0,"d":"2025-10-05"},{"n":"Quỳnh Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":60000,"pct":0.6,"d":"2026-02-27"},{"n":"Mai Minh Phương","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.4,"d":"2025-10-05"},{"n":"Cao Trung Kiên","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.3,"d":"2025-10-05"},{"n":"Nguyễn Tú Quyên","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.1,"d":"2026-02-27"},{"n":"Cao Thị Lệ Thanh","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":200,"pct":0.002,"d":"2026-02-27"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,400 VND","d":"2026-08-21","record":"2026-09-15","ex":"2026-09-14"},{"c":"AGME","t":"PCE - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-02","record":"2026-03-18","ex":"2026-03-17"},{"c":"OTHE","t":"PCE - Thay đổi địa chỉ","d":"2025-10-21","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 2,500 VND","d":"2025-08-20","record":"2