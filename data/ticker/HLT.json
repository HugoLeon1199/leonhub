p đoàn Dệt may Việt Nam, HLT có nhiều điều kiện thuận lợi để tham gia vào chuỗi cung ứng dệt- nhuộm-may của Tâp đoàn. HLT đầu tư sử dụng những dây chuyền kéo sợi hiện đại của các hãng nổi tiếng trên thế giới như: Marzoli, Toyoda, Schlafhorst, Trueztchler...Tổng sản lượng toàn hệ thống đạt khoảng 1.100 tấn sợi nồi cọc/tháng, 300 tấn sợi OE/tháng và 200 tấn sợi SE/tháng bằng nguyên liệu nhập khẩu từ Mỹ, Úc, Brazin, Cameron, Tây Phi, Đài Loan...Ngày 27/12/2019, HLT chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2019-12-27","state":0.46174545,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đào Thị Hà","p":null,"t":"INDIVIDUAL","q":1100000,"pct":20.0,"d":"2025-10-05"},{"n":"Nguyễn Du","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1335500,"pct":18.81,"d":"2026-08-06"},{"n":"Ngô Văn Thanh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1272200,"pct":17.92,"d":"2026-08-07"},{"n":"Phan Văn Trang","p":null,"t":"INDIVIDUAL","q":857300,"pct":15.587,"d":"2026-03-05"},{"n":"Phan Minh Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":709400,"pct":12.898,"d":"2026-08-24"},{"n":"Lương Trường Nam","p":null,"t":"INDIVIDUAL","q":343700,"pct":6.25,"d":"2025-10-05"},{"n":"Nguyễn Huy Quang","p":null,"t":"INDIVIDUAL","q":327300,"pct":5.95,"d":"2025-10-05"},{"n":"Đinh Thị Lan Anh","p":null,"t":"INDIVIDUAL","q":88400,"pct":1.61,"d":"2025-10-05"},{"n":"Nguyễn Song Hải","p":null,"t":"INDIVIDUAL","q":44330,"pct":0.81,"d":"2025-10-05"},{"n":"Phan Xuân Hợi","p":null,"t":"INDIVIDUAL","q":17772,"pct":0.53,"d":"2025-10-05"},{"n":"Nguyễn Khánh Ly","p":null,"t":"INDIVIDUAL","q":4219,"pct":0.077,"d":"2025-10-05"},{"n":"Trần Quốc Tuấn","p":null,"t":"INDIVIDUAL","q":2541,"pct":0.05,"d":"2025-10-05"},{"n":"Lê Thị Mỹ Linh","p":"Phó Tổng Giám đốc Tài chính - Kế toán/Kế toán trưởng/Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":111