ao thông. Công ty cổ phần Xây dựng hạ tầng Sông Đà đã được tổ chức Quacert – Trung tâm chứng nhận sự phù hợp tiêu chuẩn – Tổng cục Tiêu chuẩn đo lường Việt Nam chứng nhận đạt chuẩn về Hệ thống quản lý chất lượng theo tiêu chuẩn ISO 9001-2000 từ ngày 10 tháng 11 năm 2007. Hiện tại, Công ty có 4 trạm trộn bê tông thương phẩm, bình quân mỗi trạm trộn đầu tư khoảng 3 tỷ đồng gồm có 2 trạm tại Hà Nội, 1 trạm tại Bản Vẽ, 1 trạm tại Hiệp Phước. Các trạm trộn được đầu tư theo công nghệ Italia, Hàn Quốc có công suất từ 80-100m3 bê tông/giờ.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-10-19","state":0.0,"foreign":0.45161337,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Asean Deep Value Fund","p":null,"t":"CORPORATE","q":4545300,"pct":22.13,"d":"2025-10-05"},{"n":"Lucerne Enterprise Ltd","p":null,"t":"CORPORATE","q":4375800,"pct":21.3,"d":"2025-10-05"},{"n":"Asean Small Cap Fund","p":null,"t":"CORPORATE","q":1817600,"pct":8.676,"d":"2015-06-15"},{"n":"Chu Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":1528900,"pct":7.444,"d":"2015-09-14"},{"n":"Công ty Cổ phần Sông Đà 9","p":null,"t":"CORPORATE","q":465700,"pct":2.223,"d":"2015-06-15"},{"n":"Nguyễn Việt Cường","p":null,"t":"INDIVIDUAL","q":250525,"pct":1.22,"d":"2015-09-14"},{"n":"Vũ Văn Bảy","p":"Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":238488,"pct":1.161,"d":"2016-09-14"},{"n":"Lưu Tuấn Hùng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":75875,"pct":0.369,"d":"2015-09-14"},{"n":"Nguyễn Ngọc Lộc","p":"Phó Tổng Giám đốc/Giám đốc Xí nghiệp","t":"INDIVIDUAL","q":15000,"pct":0.073,"d":"2015-09-14"},{"n":"Trần Đại Tùng","p":"Thành viên Hội đồng Quản trị/Trưởng phòng Kinh tế - Kế hoạch","t":"INDIVIDUAL","q":9000,"pct":0.044,"d":"2015-09-14"},{"n":"Trần Quang Khải","p":"Thành viên Ban kiểm soát/Trưởng phòng Tổ chức hành chính","t":"INDIVIDUAL","q":7200,"pct":0.035,"d":"2015-09-14"},{"n":"Đặng Văn Thăng","p":"Thành viên Hội đồng Quản