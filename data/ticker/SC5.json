g ty còn được mở rộng ra nhiều công trình trong và ngoài Tp.HCM; là đại lý phân phối vật liệu xây dựng của nhiều Công ty lớn như: Công TNHH Thép Việt, Công ty liên doanh ximăng Holcim, Công ty dây & cáp điện CADIVI. Ngày 18/10/2007, SC5 chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2007-10-18","state":0.0,"foreign":0.0190906,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Đình Dũng","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":8686879,"pct":57.97,"d":"2026-02-26"},{"n":"Công ty TNHH Đầu tư SATO","p":null,"t":"CORPORATE","q":3988949,"pct":26.62,"d":"2015-06-15"},{"n":"Phạm Văn Tư","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3000000,"pct":20.02,"d":"2026-02-26"},{"n":"Phạm Thị Liên","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000000,"pct":6.67,"d":"2026-02-26"},{"n":"Nguyễn Thị Hạnh Liên","p":null,"t":"INDIVIDUAL","q":564800,"pct":4.98,"d":"2025-10-05"},{"n":"Dương Thị Trinh","p":null,"t":"INDIVIDUAL","q":500000,"pct":3.33,"d":"2025-10-05"},{"n":"Nguyễn Xuân Hòa","p":null,"t":"INDIVIDUAL","q":485480,"pct":3.24,"d":"2015-09-14"},{"n":"Lê Hữu Hoè","p":null,"t":"INDIVIDUAL","q":87120,"pct":0.581,"d":"2025-10-05"},{"n":"Vũ Thị Hương","p":null,"t":"INDIVIDUAL","q":77132,"pct":0.51,"d":"2025-10-05"},{"n":"Vũ Khắc Giang","p":null,"t":"INDIVIDUAL","q":75810,"pct":0.506,"d":"2015-09-14"},{"n":"Hoàng Văn Hoan","p":null,"t":"INDIVIDUAL","q":56628,"pct":0.378,"d":"2015-09-14"},{"n":"Trần Chính Diệp","p":null,"t":"INDIVIDUAL","q":48787,"pct":0.326,"d":"2025-10-05"},{"n":"Hà Văn Khanh","p":null,"t":"INDIVIDUAL","q":42900,"pct":0.286,"d":"2015-09-14"},{"n":"Nguyễn Kinh Kha","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":34993,"pct":0.23,"d":"2026-02-26"},{"n":"Nguyễn Văn Cường","p":null,"t":"INDIVIDUAL","q":34848,"pct":0.23,"d":"2025-10-05"},{"n":"Phạm Thị Kim Xuân","p":null,"t":"INDIVIDU