p đoàn Lộc Trời (LTG) có tiền thân là Công ty Cổ phần Bảo vệ thực vật An Giang, được thành lập vào năm 1993. Tập đoàn hoạt động chính trong lĩnh vực sản xuất thuốc bảo vệ cây trồng, kinh doanh hóa chất, hạt giống và bao bì giấy ở Việt Nam. LTG cũng tham gia vào chế biến gạo cho xuất khẩu. Tập đoàn Lộc Trời chiếm hơn 20% thị phần ngành thuốc bảo vệ thực vật và là nhà phân phối hạt giống lớn thứ 2 tại Việt Nam. Hơn nữa, LTG đã thiết lập mối quan hệ chặt chẽ với các công ty hóa chất nông nghiệp quốc tế hàng đầu như Syngenta (Thụy Sĩ), DEVI CropScience (Ấn Độ), ITOCHU (Nhật Bản) và được chuyển giao công nghệ tiên tiến trong lĩnh vực sản phẩm bảo vệ thực vật từ các công ty này.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-07-24","state":0.24153312,"foreign":0.33496869,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Marina Viet Pte. Ltd","p":null,"t":"CORPORATE","q":20317183,"pct":25.21,"d":"2025-10-05"},{"n":"Ủy Ban Nhân Dân Tỉnh An Giang","p":null,"t":"CORPORATE","q":24332400,"pct":24.153,"d":"2025-10-05"},{"n":"Augusta Viet Pte. Ltd","p":null,"t":"CORPORATE","q":4598880,"pct":5.71,"d":"2025-10-05"},{"n":"Luminous Vietnam and Indochina Growth Fund","p":null,"t":"CORPORATE","q":4000000,"pct":4.96,"d":"2025-10-05"},{"n":"Huỳnh Văn Thòn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3178608,"pct":3.155,"d":"2026-08-07"},{"n":"Endurance Capital Vietnam I Ltd","p":null,"t":"CORPORATE","q":2982965,"pct":2.96,"d":"2025-10-05"},{"n":"Endurance Capital Vietnam II S.A. SICAV-RAIF","p":null,"t":"CORPORATE","q":2034660,"pct":2.02,"d":"2025-10-05"},{"n":"Vietnam Azalea Fund Limited","p":null,"t":"CORPORATE","q":1000000,"pct":1.49,"d":"2025-10-05"},{"n":"Nguyễn Mỹ","p":null,"t":"INDIVIDUAL","q":381636,"pct":0.47,"d":"2025-10-05"},{"n":"Nguyễn Tiến Tùng","p":null,"t":"INDIVIDUAL","q":288960,"pct":0.358,"d":"2026-08-07"},{"n":"TRẦN TIẾN DŨNG","p":null,"t":"INDIVIDUAL","q":212040,"pct":0.263,"d":"2025-10-05"},{"n":"Nguyễn Thị Ấm