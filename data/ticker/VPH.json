 Minh), Dự án Khu phức hợp La Casa (Quận 7, Thành phố Hồ Chí Minh). VPH được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2009.","sector":"Bất động sản","type":"CT","listed":"2009-09-09","state":0.0,"foreign":0.00385163,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"VÕ ANH TUẤN","p":null,"t":"INDIVIDUAL","q":10503463,"pct":11.015,"d":"2026-04-23"},{"n":"Võ Nguyễn Như Nguyện","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":7820881,"pct":8.202,"d":"2026-08-10"},{"n":"Võ Phan Hồng Ngọc (Võ Gwenyth Ngọ","p":null,"t":"INDIVIDUAL","q":7780656,"pct":8.159,"d":"2026-02-24"},{"n":"Võ Phan Khôi Nguyên","p":null,"t":"INDIVIDUAL","q":7780656,"pct":8.159,"d":"2026-02-24"},{"n":"PHAN TIẾT HỒNG MINH","p":null,"t":"INDIVIDUAL","q":6619138,"pct":6.941,"d":"2026-02-24"},{"n":"Quỹ đầu tư chứng khoán Bản Việt","p":null,"t":"CORPORATE","q":2016657,"pct":4.451,"d":"2015-06-15"},{"n":"Công ty TNHH Quản lý Quỹ Đầu tư Chứng khoán Prudential Việt Nam","p":null,"t":"CORPORATE","q":2000000,"pct":4.414,"d":"2015-06-15"},{"n":"Nguyễn Kim Thanh","p":null,"t":"INDIVIDUAL","q":1509360,"pct":3.331,"d":"2015-09-14"},{"n":"Ngân hàng Thương mại TNHH MTV Ngoại thương Công nghệ Số","p":null,"t":"CORPORATE","q":1400000,"pct":3.09,"d":"2015-06-15"},{"n":"Lý Chí Nguyễn","p":null,"t":"INDIVIDUAL","q":1359300,"pct":3.0,"d":"2015-09-14"},{"n":"Quách Thị Tú Anh","p":null,"t":"INDIVIDUAL","q":1002000,"pct":2.211,"d":"2015-09-14"},{"n":"Trần Văn Thành","p":null,"t":"INDIVIDUAL","q":215880,"pct":0.476,"d":"2015-09-14"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":221300,"pct":0.23,"d":"2025-10-05"},{"n":"Phạm Thị Kim Dung","p":null,"t":"INDIVIDUAL","q":4905,"pct":0.011,"d":"2015-09-14"},{"n":"Huỳnh Trần Nguyên Khang","p":null,"t":"INDIVIDUAL","q":1960,"pct":0.004,"d":"2015-09-14"},{"n":"Trương Thành Nhân","p":null,"t":"INDIVIDUAL","q":49,"pct":0.0,"d":"2026-04-23"}],"rel":[{"c":"0316770686","n":"Công ty CP Đầu Tư Định An","t":"subsidiar