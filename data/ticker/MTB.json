",0.0],["2023",0.969],["2024",1.287],["2025",1.274]]}},"co":{"short":"Công trình đô thị tỉnh Thái Bình","profile":"Công ty Cổ phần Môi trường và Công trình Đô thị tỉnh Thái Bình (MTB) có tiền thân là Công ty Môi trường Đô thị Thái Bình được thành lập vào năm 2002. Công ty hoạt động chính trong lĩnh vực cung cấp vệ sinh môi trường trên địa bàn tỉnh Thái Bình. MTB chính thức hoạt động theo mô hình công ty cổ phần từ năm 2015. Với cổ đông lớn là UBND tỉnh Thái Bình, MTB được tạo các điều kiện thuận lợi để thực hiện cung cấp dịch vụ vệ sinh môi trường trên địa bàn thành phố Thái Bình và các khu vùng lân cận. MTB được giao dịch trên thị trường UPCOM từ tháng 12/2020.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2020-12-10","state":0.73061003,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Thái Bình","p":null,"t":"CORPORATE","q":4586959,"pct":73.06,"d":"2026-03-04"},{"n":"Vũ Đình Hành","p":null,"t":"INDIVIDUAL","q":396500,"pct":6.32,"d":"2025-10-05"},{"n":"Trần Xuân Huyên","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":23100,"pct":0.37,"d":"2026-03-04"},{"n":"Phạm Minh Tuấn","p":"Thành viên Hội đồng Quản trị/Kế toán trưởng","t":"INDIVIDUAL","q":17600,"pct":0.28,"d":"2026-03-04"},{"n":"Hoàng Anh Dương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":16800,"pct":0.26,"d":"2026-03-04"},{"n":"Nguyễn Thị Lan","p":null,"t":"INDIVIDUAL","q":13000,"pct":0.2,"d":"2026-03-04"},{"n":"Trịnh Duy Hiển","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":11000,"pct":0.18,"d":"2026-03-04"},{"n":"Nguyễn Văn Định","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":9400,"pct":0.149,"d":"2026-03-04"},{"n":"Nhâm Thị Hồng Hạnh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":4800,"pct":0.076,"d":"2026-03-04"},{"n":"Đinh Thị Đức Hạnh","p":null,"t":"INDIVIDUAL","q":4400,"pct":0.07,"d":"2025-10-05"},{"n":"Đỗ Thị Ngọc","p":"Trưởng Ban kiểm soát","t":