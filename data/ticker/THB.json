iết bị hiện tại đạt 100 triệu lít/năm. Ngày 19/11/2008, THB chính thức được niêm yết và giao dịch trên HNX.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2008-11-19","state":0.54999969,"foreign":0.05942114,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Bia - Rượu - Nước giải khát Hà Nội","p":null,"t":"CORPORATE","q":6283510,"pct":55.0,"d":"2025-11-18"},{"n":"Lương Xuân Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":701460,"pct":6.14,"d":"2026-03-03"},{"n":"Barca Global Master Fund, L.P","p":null,"t":"CORPORATE","q":423715,"pct":3.71,"d":"2025-10-05"},{"n":"Lương Xuân Hải","p":null,"t":"INDIVIDUAL","q":211160,"pct":1.848,"d":"2025-10-05"},{"n":"Hồ Thị Hà","p":null,"t":"INDIVIDUAL","q":176530,"pct":1.545,"d":"2025-10-05"},{"n":"Lương Thị Thùy Nga","p":null,"t":"INDIVIDUAL","q":137960,"pct":1.208,"d":"2025-10-05"},{"n":"Nguyễn Kiên Cường","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":130150,"pct":1.139,"d":"2026-08-07"},{"n":"Nguyễn Quang Huynh","p":null,"t":"INDIVIDUAL","q":20680,"pct":0.181,"d":"2015-09-14"},{"n":"Nguyễn Quốc Chính","p":null,"t":"INDIVIDUAL","q":14040,"pct":0.123,"d":"2015-09-14"},{"n":"Lê Ngọc Tụng","p":null,"t":"INDIVIDUAL","q":13810,"pct":0.121,"d":"2015-09-14"},{"n":"Lê Nguyên Hùng","p":null,"t":"INDIVIDUAL","q":13470,"pct":0.118,"d":"2025-10-05"},{"n":"Nguyễn Viết Hòa","p":null,"t":"INDIVIDUAL","q":10460,"pct":0.092,"d":"2015-09-14"},{"n":"Trần Thái Hoà","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.088,"d":"2015-09-14"},{"n":"Trần Văn Chung","p":null,"t":"INDIVIDUAL","q":10060,"pct":0.088,"d":"2015-09-14"},{"n":"Đỗ Trường Giang","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":1280,"pct":0.011,"d":"2026-03-03"},{"n":"Vũ Thị Luyện","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.009,"d":"2025-10-05"},{"n":"Lê Văn Hiếu","p":null,"t":"INDIVIDUAL","q":360,"pct":0.003,"d":"2015-09-14"},{"n":"Nguyễn Duy Hà","p":"Phụ trách Công bố thông tin","t":"IND