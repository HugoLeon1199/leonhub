4",6.074],["2022-Q1",5.794],["2022-Q2",5.794]],"y":[["2018",4.689],["2019",7.365],["2020",6.074],["2021",5.794]]}},"co":{"short":"QL và XD Giao thông Lạng Sơn","profile":"Công ty Cổ phần Quản lý và Xây dựng Giao thông Lạng Sơn (QLD) có tiền thân là Đoạn Quản lý Đường bộ Lạng Sơn trực thuộc Ty Giao thông Công Chính (nay là Sở Giao thông Vận tải Tỉnh Lạng Sơn), được thành lập vào năm 1962. Công ty hoạt động chính trong lĩnh vực duy tu, quản lý, bảo trì cơ sở hạ tầng đường bộ. QLD chính thức hoạt động theo mô hình công ty cổ phần từ năm 2009. Công ty hiện đang thực hiện quản lý, bảo dưỡng thường xuyên 04 tuyến quốc lộ, 14 tuyến tỉnh lộ, 17 tuyến đường huyện và 01 tuyến nội thị với tổng chiều dài là 945,5km. Bên cạnh đó, Công ty còn tham gia đấu thầu, thi công xây lắp các công trình giao thông, dân dụng.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2018-01-05","state":0.3600116,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Lạng Sơn","p":null,"t":"CORPORATE","q":434678,"pct":36.0,"d":"2025-10-05"},{"n":"Phạm Hữu Tuân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":257382,"pct":21.31,"d":"2022-05-12"},{"n":"Lê Văn Thắng","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":78494,"pct":6.5,"d":"2022-05-12"},{"n":"Lộc Đức Toàn","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":41297,"pct":3.42,"d":"2022-05-12"},{"n":"Trương Văn Trung","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":24999,"pct":2.07,"d":"2022-05-12"},{"n":"Vi Văn Dân","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":24199,"pct":2.0,"d":"2022-05-12"},{"n":"BCH Công đoàn CTCP Quản lý và Xây dựng Giao thông Lạng Sơn","p":null,"t":"CORPORATE","q":20600,"pct":1.71,"d":"2025-10-05"},{"n":"Trần Thị Mai Hân","p":"Kế toán trưởng","t":"INDIVIDUAL","q":18199,"pct":1.51,"d":"2022-05-12"},{"n":"Lương Thị Thu","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":