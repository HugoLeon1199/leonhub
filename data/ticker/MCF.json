 tiêu thụ ổn định với mức tăng trưởng từ 5% đến 10% một năm. Trung bình năng lực sản xuất của Công ty trên 1.000.000 sản phẩm (tương đương với khoảng 47 container 40 feet), đây là sản phẩm đặc thù mà Công ty xuất khẩu trực tiếp góp phần giải quyết trên 400 việc làm cho xã hội. Ngày 14/02/2011, MCF chính thức giao dịch trên Sở Giao dịch chứng khoán Hà Nội (HNX).","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2011-02-14","state":0.60000902,"foreign":0.01454039,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Lương thực Miền Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":6466800,"pct":60.0,"d":"2026-03-04"},{"n":"Trần Xuân Hùng","p":null,"t":"INDIVIDUAL","q":470000,"pct":4.36,"d":"2025-10-05"},{"n":"Nguyễn Thị Muôn","p":null,"t":"INDIVIDUAL","q":58335,"pct":0.541,"d":"2025-10-05"},{"n":"Trần Thị Yến","p":null,"t":"INDIVIDUAL","q":52812,"pct":0.49,"d":"2025-10-05"},{"n":"Lê Văn Lộc","p":null,"t":"INDIVIDUAL","q":41360,"pct":0.384,"d":"2025-10-05"},{"n":"Hồ Văn Luân","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.375,"d":"2015-09-14"},{"n":"Nguyễn Bình Hiển","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":36348,"pct":0.337,"d":"2026-03-04"},{"n":"Nguyễn Hữu Trung","p":null,"t":"INDIVIDUAL","q":19983,"pct":0.25,"d":"2015-09-14"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":21002,"pct":0.19,"d":"2025-10-05"},{"n":"Hoàng Thị Liên","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":20208,"pct":0.188,"d":"2026-03-04"},{"n":"Lê Trường Sơn","p":"Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":18839,"pct":0.17,"d":"2026-03-04"},{"n":"Nguyễn Văn Kiệt","p":null,"t":"INDIVIDUAL","q":14280,"pct":0.132,"d":"2026-03-04"},{"n":"Huỳnh Văn Tranh","p":null,"t":"INDIVIDUAL","q":8026,"pct":0.1,"d":"2015-09-14"},{"n":"Trần Thị Phượng","p":null,"t":"INDIVIDUAL","q":8083,"pct":0.075,"d":"2025-10-05"},{"n":"Nguyễn Thị Chính","p":null,"t":"INDIVIDUAL","q":7653,"pct":0.071,"d":"2025-10-05"},{"n":"Nguyễn Hoàng Đ