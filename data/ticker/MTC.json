lịch Mỹ Trà (MTC) tiền thân là Khu Du lịch Mỹ Trà được thành lập năm 2000. Công ty được cổ phần hóa năm 2009. Hoạt động kinh doanh chính là cung cấp dịch vụ nhà hàng, khách sạn và các dịch vụ du lịch khác tại tỉnh Đồng Tháp. Công ty được đánh giá là một trong những doanh nghiệp hàng đầu của tỉnh Đồng Tháp về lĩnh vực du lịch. Hiện nay, công ty sở hữu khách sạn Hòa Bình đạt tiêu chuẩn 3 sao, khu du lịch Mỹ Trà đạt tiêu chuẩn 2 sao và 06 nhà hàng lớn tại trung tâm thành phố Cao Lãnh tỉnh Đồng Tháp.","sector":"Du lịch và Giải trí","type":"CT","listed":"2012-08-17","state":0.59803052,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Huỳnh Mộng Kiều","p":null,"t":"INDIVIDUAL","q":438300,"pct":23.91,"d":"2025-03-21"},{"n":"Công ty Cổ phần Nhiên liệu Đồng Tháp","p":null,"t":"CORPORATE","q":70000,"pct":3.82,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Thương Mại Dầu Khí Cửu Long","p":null,"t":"CORPORATE","q":50000,"pct":2.73,"d":"2025-10-05"},{"n":"Công ty Cổ phần Vận tải Xăng dầu Đồng Tháp","p":null,"t":"CORPORATE","q":30000,"pct":1.64,"d":"2025-10-05"},{"n":"Ngô Quang Danh","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.581,"d":"2015-09-14"},{"n":"Công ty Cổ phần Vận tải Xăng dầu VIPCO","p":null,"t":"CORPORATE","q":30000,"pct":0.577,"d":"2015-06-15"},{"n":"Nguyễn Thị Hạnh","p":null,"t":"INDIVIDUAL","q":25000,"pct":0.484,"d":"2015-09-14"},{"n":"Công ty Cổ phần Cơ khí Đồng Tháp","p":null,"t":"CORPORATE","q":20000,"pct":0.385,"d":"2015-06-15"},{"n":"Lê Thị Phiến","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.278,"d":"2025-02-25"},{"n":"Nguyễn Viết Khái","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.111,"d":"2024-06-19"},{"n":"Nguyễn Anh","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.097,"d":"2015-09-14"},{"n":"Võ Hửu Nhạc","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.056,"d":"2024-06-19"},{"n":"Phạm Văn Tân","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.048,"d":"2015-09-14"},{"n":"Huỳnh Anh Tuấn","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.039,"d":"2