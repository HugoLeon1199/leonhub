đầu tiên được Chính phủ lựa chọn thực hiện thí điểm cổ phần hoá, Ngân hàng Ngoại thương Việt Nam chính thức hoạt động với tư cách là một Ngân hàng Thương mại Cổ phần từ ngày 02/06/2008 sau khi thực hiện thành công kế hoạch cổ phần hóa thông qua việc phát hành cổ phiếu lần đầu ra công chúng. Năm 2025, so với cùng kỳ, biên lãi thuần (NIM) ở mức 2.63%, giảm 0.23%. Tỷ lệ nợ xấu ở mức 0.58%, giảm 0.39%. Tỷ lệ bao phủ nợ xấu ở mức 258.29%, tăng 34.98%. Lợi nhuận sau thuế công ty mẹ có giá trị bằng 35,2 nghìn tỷ đồng, tăng 3.98%. Tỷ suất lợi nhuận trên vốn chủ sở hữu (ROE) ở mức 16.73%, giảm 2.01%. VCB chính thức niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh từ năm 2009.","sector":"Ngân hàng","type":"NH","listed":"2009-06-30","state":0.74803514,"foreign":0.20036252,"rating":"BUY","target":78500.0,"rating_as_of":"2026-05-18","source":"Vietcap"},"owners":[{"n":"Ngân Hàng Nhà Nước Việt Nam","p":null,"t":"CORPORATE","q":6250338579,"pct":74.8,"d":"2026-07-31"},{"n":"Mizuho Bank Limited","p":null,"t":"CORPORATE","q":1253366534,"pct":15.0,"d":"2026-07-31"},{"n":"Quỹ Đầu tư Chính phủ Singapore (GIC)","p":null,"t":"CORPORATE","q":84503639,"pct":1.01,"d":"2025-10-05"},{"n":"T. Rowe Price Associates, Inc","p":null,"t":"CORPORATE","q":12522661,"pct":0.15,"d":"2025-10-05"},{"n":"Vietnam Holding Ltd","p":null,"t":"CORPORATE","q":1428898,"pct":0.039,"d":"2020-07-14"},{"n":"Quỹ Đầu tư Cổ phiếu Manulife","p":null,"t":"CORPORATE","q":252294,"pct":0.007,"d":"2020-07-14"},{"n":"Quỹ Đầu tư Cổ phiếu Techcom","p":null,"t":"CORPORATE","q":103030,"pct":0.003,"d":"2020-07-14"},{"n":"Quỹ Đầu tư Tăng trưởng DFVN","p":null,"t":"CORPORATE","q":65000,"pct":0.002,"d":"2020-07-14"},{"n":"Phùng Nguyễn Hải Yến","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":52339,"pct":0.001,"d":"2026-07-31"},{"n":"La Thị Hồng Minh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":7389,"pct":0.0,"d":"2026-07-31"},{"n":"Lê Hoàng Tùng","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q"