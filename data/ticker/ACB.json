 mức 0.97%, giảm 0.52%. Tỷ lệ bao phủ nợ xấu ở mức 114.29%, tăng 36.37%. Lợi nhuận sau thuế công ty mẹ có giá trị bằng 15,6 nghìn tỷ đồng, giảm 6.94%. Tỷ suất lợi nhuận trên vốn chủ sở hữu (ROE) ở mức 17.56%, giảm 4.19%. Ngày 09/12/2020, ACB chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Ngân hàng","type":"NH","listed":"2006-11-21","state":0.0,"foreign":0.2374015,"rating":"BUY","target":28000.0,"rating_as_of":"2026-08-28","source":"Vietcap"},"owners":[{"n":"Sather Gate Investments Limited","p":null,"t":"CORPORATE","q":193907186,"pct":4.99,"d":"2025-10-05"},{"n":"Dragon Financial Holdings Limited","p":null,"t":"CORPORATE","q":140770684,"pct":3.624,"d":"2025-10-05"},{"n":"Trần Hùng Huy","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":198904274,"pct":3.43,"d":"2026-08-03"},{"n":"Nguyễn Thiên Hương Jenny","p":null,"t":"INDIVIDUAL","q":151421326,"pct":2.95,"d":"2026-06-19"},{"n":"Nguyễn Đức Hiếu Johnny","p":null,"t":"INDIVIDUAL","q":97631891,"pct":1.9,"d":"2026-06-12"},{"n":"Công ty Cổ phần Đầu Tư Thương Mại Giang Sen","p":null,"t":"CORPORATE","q":92341037,"pct":1.8,"d":"2025-10-05"},{"n":"Nguyễn Đức Hinh","p":null,"t":"INDIVIDUAL","q":85364000,"pct":1.662,"d":"2026-06-23"},{"n":"Smallcap World Fund Incoporation","p":null,"t":"CORPORATE","q":76727123,"pct":1.494,"d":"2026-06-23"},{"n":"Ngô Thu Thúy","p":null,"t":"INDIVIDUAL","q":71285464,"pct":1.39,"d":"2026-05-29"},{"n":"Công ty Cổ phần Đầu Tư Thương Mại Bách Thanh","p":null,"t":"CORPORATE","q":64287678,"pct":1.252,"d":"2025-10-05"},{"n":"Bch Công Đoàn Ngân Hàng Tmcp Á Châu","p":null,"t":"CORPORATE","q":61480023,"pct":1.197,"d":"2025-11-24"},{"n":"Đặng Thu Thủy","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":69328371,"pct":1.19,"d":"2026-08-03"},{"n":"Estes Investments Limited","p":null,"t":"CORPORATE","q":60175371,"pct":1.171,"d":"2026-06-23"},{"n":"Employees Provident Fund Board","p":null,"t":"CORPORATE","q":45600446,"pct":1.021,"d":"2025-10-05"},{"n":"Princi