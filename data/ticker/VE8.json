 phần. Công ty hoạt động chính trên thị trường miền Nam, miền Trung và Tây Nguyên. Ngày 09/06/2025, VE8 chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2012-08-27","state":0.55933833,"foreign":0.00216667,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xây dựng điện Việt Nam","p":null,"t":"CORPORATE","q":1006809,"pct":55.934,"d":"2025-10-05"},{"n":"Trần Quang Đức","p":null,"t":"INDIVIDUAL","q":126600,"pct":7.03,"d":"2025-12-19"},{"n":"Trần Hoài Linh","p":null,"t":"INDIVIDUAL","q":84900,"pct":4.72,"d":"2025-10-05"},{"n":"Andreas Karall","p":null,"t":"INDIVIDUAL","q":81200,"pct":4.51,"d":"2025-10-05"},{"n":"Nguyễn Công Diệu","p":"Phó Chủ tịch Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":61220,"pct":3.4,"d":"2025-10-05"},{"n":"Võ Đức Sơn","p":null,"t":"INDIVIDUAL","q":24500,"pct":1.361,"d":"2015-09-14"},{"n":"Nguyễn Tráng Sỹ","p":null,"t":"INDIVIDUAL","q":14500,"pct":0.806,"d":"2025-10-05"},{"n":"Trần Quang Cần","p":null,"t":"INDIVIDUAL","q":11000,"pct":0.61,"d":"2025-10-05"},{"n":"Nguyễn Tiến Chữ","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.556,"d":"2015-09-14"},{"n":"Nguyễn Tất Ánh","p":null,"t":"INDIVIDUAL","q":7791,"pct":0.433,"d":"2015-09-14"},{"n":"Trần Ngọc Báu","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2900,"pct":0.161,"d":"2025-10-05"},{"n":"Nguyễn Thị Hiệp Giang","p":null,"t":"INDIVIDUAL","q":1557,"pct":0.09,"d":"2025-10-05"}],"events":[{"c":"DDIND","t":"Trần Quang Đức - Đăng kí Mua VE8","d":"2025-12-18","record":null,"ex":null},{"c":"MOVE","t":"VE8 - Chuyển sàn từ HNX sang UPCoM","d":"2025-06-02","record":null,"ex":null},{"c":"SUSP","t":"VE8 - Hủy niêm yết cổ phiếu trên sàn HNX","d":"2025-04-25","record":null,"ex":null},{"c":"DDIND","t":"Trần Quang Đức - Đăng kí Mua VE8","d":"2025-04-15","record":null,"ex":null},{"c":"DDIND","t":"Trần Quang Đức - Đăng kí Bán VE8","d":"2025-03-20","record":null,"ex":null},{"c":"EGME","t":"VE8 - Tổ chức ĐHĐC