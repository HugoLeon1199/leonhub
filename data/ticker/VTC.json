Loan), E 77 (Hungary) và là nhà phân phối lớn các sản phẩm của Huawei (Trung Quốc) tại thị trường Việt Nam. Mức tăng trưởng doanh thu trung bình của hoạt động này hàng năm khá cao (hơn 50%).","sector":"Công nghệ Thông tin","type":"CT","listed":"2003-01-24","state":0.46669413,"foreign":0.0989149,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập Đoàn Bưu Chính Viễn Thông Việt Nam","p":null,"t":"CORPORATE","q":2116316,"pct":46.67,"d":"2026-08-21"},{"n":"Lê Xuân Tiến","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":924862,"pct":20.4,"d":"2026-08-21"},{"n":"Ngân hàng Thương mại Cổ phần Quốc tế Việt Nam","p":null,"t":"CORPORATE","q":120000,"pct":2.646,"d":"2015-06-15"},{"n":"Lê Văn Giảng","p":null,"t":"INDIVIDUAL","q":38232,"pct":0.844,"d":"2015-09-14"},{"n":"Võ Hùng Tiến","p":null,"t":"INDIVIDUAL","q":20519,"pct":0.45,"d":"2026-03-05"},{"n":"Trần Viết Tống","p":null,"t":"INDIVIDUAL","q":20300,"pct":0.448,"d":"2015-09-14"},{"n":"Phạm Cử","p":null,"t":"INDIVIDUAL","q":6006,"pct":0.133,"d":"2015-09-14"},{"n":"Nguyễn Thị Thu Huyền","p":null,"t":"INDIVIDUAL","q":3794,"pct":0.084,"d":"2015-09-14"},{"n":"Nguyễn Minh Vũ","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3011,"pct":0.066,"d":"2026-08-21"},{"n":"Dương Thị Hoàng Cát","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3000,"pct":0.06,"d":"2026-08-21"},{"n":"Nguyễn Quang Hưng","p":null,"t":"INDIVIDUAL","q":395,"pct":0.009,"d":"2015-09-14"},{"n":"Mai Thị Kim Oanh","p":null,"t":"INDIVIDUAL","q":170,"pct":0.004,"d":"2026-08-21"},{"n":"Nguyễn Minh Trí","p":null,"t":"INDIVIDUAL","q":181,"pct":0.004,"d":"2015-09-14"},{"n":"Phạm Quốc Cường","p":null,"t":"INDIVIDUAL","q":30,"pct":0.001,"d":"2015-09-14"}],"rel":[{"c":"0102136190","n":"Công ty Cổ Phần Đầu Tư Và Phát Triển Công Nghệ Thông Minh","t":"subsidiary","pct":60.0}],"rel_count":1,"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 17.6%","d":"2026-07-15","record":"2026-