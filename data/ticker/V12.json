tỷ đồng), (iii) Cơ sở hạ tầng giao thông: dự án mở rộng quốc lộ Láng Hòa Lạc, hạ tầng giao thông bên ngoài nhà máy xi măng Cẩm Phả... Ngày 05/01/2010, V12 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-01-05","state":0.36,"foreign":0.00038673,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Phùng Hòa","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2310000,"pct":19.852,"d":"2026-03-02"},{"n":"Nguyễn Minh Tuấn","p":null,"t":"INDIVIDUAL","q":1803580,"pct":15.5,"d":"2025-10-05"},{"n":"Nguyễn Hữu Tới","p":null,"t":"INDIVIDUAL","q":1525049,"pct":13.106,"d":"2026-03-11"},{"n":"Đinh Thị Hằng","p":null,"t":"INDIVIDUAL","q":1245600,"pct":10.705,"d":"2026-03-02"},{"n":"Ngô Văn Dũng","p":null,"t":"INDIVIDUAL","q":182175,"pct":3.131,"d":"2015-09-14"},{"n":"Tổng Công ty Cổ phần Xuất nhập khẩu và Xây dựng Việt Nam","p":null,"t":"CORPORATE","q":290900,"pct":2.5,"d":"2025-10-05"},{"n":"Phạm Thành Nhâm","p":null,"t":"INDIVIDUAL","q":64600,"pct":1.11,"d":"2015-09-14"},{"n":"Trần Ngọc Hùng","p":null,"t":"INDIVIDUAL","q":26500,"pct":0.455,"d":"2015-09-14"},{"n":"Lê Ngọc Anh","p":null,"t":"INDIVIDUAL","q":28840,"pct":0.25,"d":"2025-10-05"},{"n":"Nguyễn Thị Hằng","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":22500,"pct":0.193,"d":"2026-03-02"},{"n":"Đào Văn Tuyến","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.172,"d":"2015-09-14"},{"n":"Hoàng Đức Minh","p":null,"t":"INDIVIDUAL","q":9393,"pct":0.161,"d":"2015-09-14"},{"n":"Vũ Chí Dũng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":14160,"pct":0.122,"d":"2026-03-02"},{"n":"Nguyễn Văn Bộ","p":null,"t":"INDIVIDUAL","q":11500,"pct":0.1,"d":"2026-03-02"},{"n":"Nguyễn Văn Hiến","p":null,"t":"INDIVIDUAL","q":1570,"pct":0.027,"d":"2015-09-14"},{"n":"Phạm Thị Minh Lý","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":1000,"pct":0.009,"d":"2026-03-02"},{"n":"Lê Phùng Quang","p":null,"t":"INDIVIDUAL","q":120,"pct