 hồi sức đặc biệt, 02 phòng thông tim can thiệp, 01 phòng điện sinh lý tim, 03 phòng mổ, 02 khoa hồi sức tim mạch và khu thăm dò chức năng tim mạch với 02 máy MSCT. Năm 2020, Bệnh viện Tim Tâm Đức là 1 trong 10 bệnh viện mổ tim nhiều nhất và là bệnh viện chuyên khoa tim ngoài công lập mổ tim nhiều nhất. TTD được giao dịch trên thị trường UPCoM từ tháng 02/2017.","sector":"Y tế","type":"CT","listed":"2017-02-06","state":0.0,"foreign":0.00398663,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty Cổ Phần Đầu Tư An Việt Hưng","p":null,"t":"CORPORATE","q":1666260,"pct":10.71,"d":"2026-06-15"},{"n":"Nguyễn Thị Hạnh","p":null,"t":"INDIVIDUAL","q":1555200,"pct":10.0,"d":"2026-06-15"},{"n":"Nguyễn Thị Thu Hồng","p":null,"t":"INDIVIDUAL","q":1235000,"pct":7.94,"d":"2026-06-15"},{"n":"Phạm Anh Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1176000,"pct":3.781,"d":"2026-07-27"},{"n":"Phan Kim Phương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1144000,"pct":3.678,"d":"2026-07-27"},{"n":"Phạm Bích Xuân","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":728800,"pct":2.34,"d":"2026-07-27"},{"n":"Nguyễn Ngọc Chiếu","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":240000,"pct":0.772,"d":"2026-07-27"},{"n":"Nguyễn Ngọc Như Anh","p":"Phó Giám đốc Điều hành/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":240000,"pct":0.772,"d":"2026-07-27"},{"n":"Dương Tôn Thái Dương","p":null,"t":"INDIVIDUAL","q":114400,"pct":0.736,"d":"2026-01-30"},{"n":"Nguyễn Ngọc An Khôi","p":"Phó Giám đốc Điều hành","t":"INDIVIDUAL","q":216000,"pct":0.694,"d":"2026-07-27"},{"n":"Tôn Thất Minh","p":"Giám đốc","t":"INDIVIDUAL","q":158000,"pct":0.51,"d":"2026-07-27"},{"n":"Dương Tôn Xuân Trang","p":null,"t":"INDIVIDUAL","q":65132,"pct":0.419,"d":"2026-01-30"},{"n":"Bùi Thúy Kiều","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":122000,"pct":0.39,"d":"2026-08-06"},{"n":"Nguyễn Thị Bích Đào","p":"Phó Giám đốc Điều hành","t":"INDIV