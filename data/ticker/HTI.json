g thời gian qua. Là công ty con của Tổng công ty IDICO, HTI được sự giúp đỡ của công ty mẹ trong việc tham mưu, giúp đỡ về vốn, trong các chiến lược khai thác, vận hành các dự án. Ngoài ra, với lịch sử hình thành gần 20 năm, công ty đã chiếm được sự tin tưởng của người dân tại địa bàn hoạt động và những khu vực lân cận. Ngày 20/02/2010, HTI chính thức giao dịch trên Sở giao dịch chứng khoán Thành phố Hồ Chí Minh.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-12-20","state":0.0,"foreign":0.07581578,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty IDICO - CTCP","p":null,"t":"CORPORATE","q":14345790,"pct":57.5,"d":"2026-07-03"},{"n":"Finansia Syrus Securities Public Company Limited","p":null,"t":"CORPORATE","q":1336300,"pct":5.36,"d":"2025-10-05"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":1232400,"pct":4.92,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư Xây dựng Dầu khí IDICO","p":null,"t":"CORPORATE","q":1067600,"pct":4.28,"d":"2025-10-05"},{"n":"Lã Thị Nhã Phương","p":null,"t":"INDIVIDUAL","q":580546,"pct":2.327,"d":"2015-09-14"},{"n":"Lê Quốc Đạt","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":66000,"pct":0.265,"d":"2026-09-03"},{"n":"Nguyễn Hồng Ninh","p":null,"t":"INDIVIDUAL","q":60000,"pct":0.24,"d":"2025-10-05"},{"n":"Trần Thị Minh Tuyết","p":null,"t":"INDIVIDUAL","q":54000,"pct":0.22,"d":"2026-09-03"},{"n":"Nguyễn Văn Thúy","p":null,"t":"INDIVIDUAL","q":40050,"pct":0.161,"d":"2025-10-05"},{"n":"Vũ Nhật Bình","p":null,"t":"INDIVIDUAL","q":33000,"pct":0.13,"d":"2025-10-05"},{"n":"Nguyễn Tiên Lượng","p":null,"t":"INDIVIDUAL","q":29950,"pct":0.12,"d":"2025-10-05"},{"n":"Phạm Thị Kiều Trang","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.12,"d":"2025-10-05"},{"n":"Nguyễn Vũ Minh Long","p":null,"t":"INDIVIDUAL","q":29030,"pct":0.11,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Dung","p":null,"t":"INDIVIDUAL","q":26550,"pct":0.106,"d":"2025-10-05"},{"n":"Nguyễn Đăng Nghị"