 động chính trong lĩnh vực sản xuất và cung cấp nước sạch. VLW chính thức hoạt động theo mô hình công ty cổ phần từ năm 2016. Công ty đang quản lý và khai thác 8 hệ thống cấp nước với tổng công suất 48.400m3/ngày đêm. Bên cạnh đó, Công ty còn sản xuất và kinh doanh sản phẩm nước uống đóng chai với công suất 5.000lít/giờ. VLW được giao dịch trên thị trường UPCOM từ tháng 07/2017.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-07-17","state":0.51,"foreign":0.00182353,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Vĩnh Long","p":null,"t":"CORPORATE","q":14739000,"pct":51.0,"d":"2026-08-25"},{"n":"Công ty Cổ phần - Tổng công ty Nước - Môi trường Bình Dương","p":null,"t":"CORPORATE","q":9725862,"pct":33.65,"d":"2026-05-25"},{"n":"Công ty CP Nước Và Môi Trường Đồng Bằng","p":null,"t":"CORPORATE","q":1445000,"pct":5.0,"d":"2025-10-05"},{"n":"Đặng Tấn Chiến","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":322822,"pct":1.12,"d":"2026-08-25"},{"n":"Nguyễn Tấn Phát","p":null,"t":"INDIVIDUAL","q":57400,"pct":0.199,"d":"2025-10-05"},{"n":"Trần Văn Bản","p":null,"t":"INDIVIDUAL","q":56100,"pct":0.194,"d":"2025-10-05"},{"n":"Bùi Thiện Ngọc Minh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":16400,"pct":0.057,"d":"2026-08-25"},{"n":"Lê Thị Quyến","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":15300,"pct":0.053,"d":"2026-08-25"},{"n":"Lương Minh Triết","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":15000,"pct":0.052,"d":"2026-08-25"},{"n":"Lê Văn Thắng","p":"Kế toán trưởng/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":14400,"pct":0.05,"d":"2026-08-25"},{"n":"Nguyễn Quốc Đạt","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7700,"pct":0.027,"d":"2026-08-25"},{"n":"Nguyễn Thị Hồng Nhung","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":6600,"pct":0.023,"d":"2026-08-25"},{"n":"Trần Thị Huỳnh Mai","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.01,"d":"2025-10-05