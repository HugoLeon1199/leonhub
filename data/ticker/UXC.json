t Bản, Trung Quốc, Ấn Độ và một số nước khác. Ngày 31/12/2024, UXC chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2024-12-31","state":0.06779661,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Hoàng Nhã","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7973086,"pct":22.522,"d":"2026-04-13"},{"n":"Nguyễn Triệu Dõng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":7116000,"pct":20.101,"d":"2026-04-13"},{"n":"Nguyễn Hoàng Phương","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5329411,"pct":15.054,"d":"2026-04-13"},{"n":"Công ty Cổ phần Thương Mại & Dịch Vụ Dầu Khí Việt Nam","p":null,"t":"CORPORATE","q":2400000,"pct":6.78,"d":"2026-04-13"},{"n":"Tổng Công ty Phân bón và Hóa chất Dầu khí - Công ty Cổ phần","p":null,"t":"CORPORATE","q":2400000,"pct":6.78,"d":"2026-04-13"},{"n":"Trương Văn Phước","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1789411,"pct":5.054,"d":"2026-04-13"},{"n":"Trần Thị Thuý Liên","p":null,"t":"INDIVIDUAL","q":1789411,"pct":5.054,"d":"2026-04-13"},{"n":"Nguyễn Thị Thanh Thuỷ","p":null,"t":"INDIVIDUAL","q":358580,"pct":1.013,"d":"2026-03-04"},{"n":"Lý Bích Quyên","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":65398,"pct":0.185,"d":"2026-03-04"},{"n":"Nguyễn Anh Tuấn","p":null,"t":"INDIVIDUAL","q":28164,"pct":0.08,"d":"2025-10-05"},{"n":"Nguyễn Kim Hồng Đào","p":null,"t":"INDIVIDUAL","q":24430,"pct":0.069,"d":"2026-03-04"},{"n":"Trương Nguyễn Phương Vy","p":null,"t":"INDIVIDUAL","q":13764,"pct":0.039,"d":"2026-03-04"},{"n":"Phan Khánh Cường","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.034,"d":"2026-03-04"},{"n":"Đỗ Thành Nhơn","p":"Kế toán trưởng","t":"INDIVIDUAL","q":10842,"pct":0.031,"d":"2026-03-04"},{"n":"Nguyễn Thái Nguyên","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":7234,"pct":0.02,"d":"2026-03-04"},{"n":"Bùi Chí Thiện","p":null,"t":"INDIVIDUAL","q":