ty là hoạt động khai thác, xử lý và cung cấp nước sạch. Thành lập từ năm 1924, Công ty đã có gần 100 năm kinh nghiệm trong hoạt động cung ứng dịch vụ quản lý, khai thác, sản xuất kinh doanh nước sạch phục vụ sinh hoạt, sản xuất trên địa bàn tỉnh Nam Định. Với công suất của nhà máy cấp nước là 115.000m3/ngày đêm đảm bảo đủ cung cấp nhu cầu nước sinh hoạt trên địa bàn Tỉnh. Ngày 11/06/2019, NDW chính thức giao dịch trên thị trường UPCOM.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2019-06-11","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Nam Định","p":null,"t":"CORPORATE","q":16984315,"pct":49.5,"d":"2026-01-27"},{"n":"Ủy Ban Nhân Dân Tỉnh Ninh Bình","p":null,"t":"CORPORATE","q":16984315,"pct":49.5,"d":"2026-09-03"},{"n":"Công ty Cổ Phần Du Lịch Nam Định","p":null,"t":"CORPORATE","q":6347673,"pct":18.5,"d":"2026-09-03"},{"n":"Công ty Cổ phần Nhựa Thiếu niên Tiền Phong","p":null,"t":"CORPORATE","q":4632086,"pct":13.5,"d":"2026-09-03"},{"n":"Công ty CP Thiết Bị Xử Lý Nước Setfil","p":null,"t":"CORPORATE","q":1726267,"pct":5.03,"d":"2026-09-03"},{"n":"Bùi Xuân Thiểm","p":null,"t":"INDIVIDUAL","q":302630,"pct":0.88,"d":"2025-10-05"},{"n":"Nguyễn Sỹ Long","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":201209,"pct":0.58,"d":"2026-09-03"},{"n":"TRẦN ĐĂNG QUÝ","p":null,"t":"INDIVIDUAL","q":200407,"pct":0.58,"d":"2025-10-05"},{"n":"Đinh Văn Hoà","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":122176,"pct":0.36,"d":"2026-09-03"},{"n":"Phạm Tài Đình","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":106910,"pct":0.31,"d":"2026-09-03"},{"n":"Trần Thị Hồng Phấn","p":"Kế toán trưởng","t":"INDIVIDUAL","q":105381,"pct":0.31,"d":"2026-09-03"},{"n":"Nguyễn Văn Ngôn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":95509,"pct":0.28,"d":"2026-09-03"},{"n":"Nguyễn Thành Trì","p":null,"t":"INDIVIDUAL","q":73976,"pct":0.22,"