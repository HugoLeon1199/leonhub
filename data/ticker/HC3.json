III, Nhà Câu lạc bộ sân Golf Đồ Sơn, Hệ thống hạ tầng Trung tâm hội chợ triển lãm thương mại văn hóa Hải Phòng, Nhà xưởng nhà máy may Yen, Nhà máy van Việt Nhật, Nhà máy nhựa Vân Long, Nhà máy đóng tàu DAMEN Sông Cấm. Ngoài ra, HC3 kinh doanh cho thuê căn hộ, văn phòng Tòa nhà H Tower tại trung tâm thành phố Hải phòng. HC3 được giao dịch trên thị trường UPCOM từ tháng 07/2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-07-11","state":0.0,"foreign":0.00086301,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phạm Kỳ Hưng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":6104498,"pct":29.68,"d":"2026-07-15"},{"n":"Phạm Đức Duy","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2145633,"pct":10.37,"d":"2026-07-15"},{"n":"Nguyễn Thị Thuý","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1696466,"pct":8.2,"d":"2026-07-15"},{"n":"Phạm Thị Kim Thoa","p":null,"t":"INDIVIDUAL","q":1290485,"pct":7.56,"d":"2025-10-05"},{"n":"Đào Viết Trúc","p":null,"t":"INDIVIDUAL","q":1003048,"pct":6.45,"d":"2025-10-05"},{"n":"Bùi Ngọc Phương","p":null,"t":"INDIVIDUAL","q":796170,"pct":3.85,"d":"2025-10-05"},{"n":"Bùi Thị Ngọc Anh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":450000,"pct":2.18,"d":"2026-02-24"},{"n":"Bùi Ngọc Khôi","p":null,"t":"INDIVIDUAL","q":313549,"pct":1.52,"d":"2025-10-05"},{"n":"Đào Viết Liễu","p":null,"t":"INDIVIDUAL","q":260477,"pct":1.52,"d":"2025-10-05"},{"n":"Đào Thanh Bình","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":185807,"pct":0.9,"d":"2025-10-05"},{"n":"Nguyễn Hoàng Rộng","p":null,"t":"INDIVIDUAL","q":100149,"pct":0.64,"d":"2025-10-05"},{"n":"Lưu Thị Phương","p":"Kế toán trưởng","t":"INDIVIDUAL","q":93144,"pct":0.59,"d":"2025-10-05"},{"n":"Phạm Thị Kim Hoa","p":null,"t":"INDIVIDUAL","q":49064,"pct":0.29,"d":"2025-10-05"}],"rel":[{"c":"0200870956","n":"Công ty TNHH Tư Vấn Thiết Kế Haco 3","t":"subsidiary","pct":100.0},{"c":"0200115223",