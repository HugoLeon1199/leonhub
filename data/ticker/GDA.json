tiền thân là công ty TNHH Đông Á, được thành lập vào năm 1998. Công ty chuyên sản xuất các sản phẩm tôn mạ kẽm, tôn mạ kẽm màu, tôn mạ lạnh và tôn mạ màu lạnh. Các sản phẩm của công ty được phân phối bởi hệ thống hơn 1.700 đại lý trên khắp cả nước và có mặt tại hơn 50 quốc gia, trong đó bao gồm cả những thị trường khó tính như Mỹ, Nhật, Úc và các nước Châu Â,... Đối với thị trường tôn trong nước nói chung, Tôn Đông Á đứng thứ 2 về thị phần và đứng thứ nhất về mảng tôn lạnh và lạnh màu nói riêng. Công ty có 2 nhà máy tại KCN Đồng An và Sóng Thần 1 (Bình Dương) với tổng công suất đạt 800.000 tấn/năm và 1 nhà máy sản xuất thép hộp mạ kẽm tại tỉnh Long An. GDA chính thức được giao dịch trên thị trường UPCoM từ ngày 06/09/2023.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2023-09-07","state":0.0,"foreign":0.18055902,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thanh Trung","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":48610432,"pct":32.603,"d":"2026-07-29"},{"n":"Lê Thị Phương Loan","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":19210250,"pct":12.88,"d":"2026-07-29"},{"n":"Công ty TNHH Jfe Shoji Việt Nam","p":null,"t":"CORPORATE","q":11096800,"pct":7.44,"d":"2026-07-07"},{"n":"Nguyễn Thị Ngọc Quỳnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":9788628,"pct":6.565,"d":"2026-07-29"},{"n":"Nguyễn Thanh Quỳnh An","p":null,"t":"INDIVIDUAL","q":2183117,"pct":1.464,"d":"2026-07-29"},{"n":"Nguyễn Thanh Vĩnh Nhật","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1676949,"pct":1.125,"d":"2026-07-29"},{"n":"Phạm Quốc Thắng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1636554,"pct":1.098,"d":"2026-07-29"},{"n":"Hồ Song Ngọc","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1541274,"pct":1.034,"d":"2026-07-29"},{"n":"Đoàn Vĩnh Phước","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":927929,"pct":0.622,"d":"2026-07-29"},{"n":"Nguyễn Văn Đại","p":"Phó Tổng Giám đốc","t"