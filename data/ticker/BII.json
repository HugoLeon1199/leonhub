Bảo Thư (BII) được thành lập từ năm 2008. Lĩnh vực hoạt động chính của công ty là kinh doanh bất động sản dân dụng, bất động sản công nghiệp, khai thác cát trắng và sản xuất vật liệu xây dựng. Hiện tại, BII đang đầu tư và khai thác 3 Cụm công nghiệp bao gồm Cụm công nghiệp Trị An (Đồng Nai), Cụm công nghiệp Thắng Hải và Cụm công nghiệp Tân Bình (Bình Thuận). Ở mảng bất động sản dân dụng, BII đã thực hiện các dự án Khu an sinh xã hội Định Thành, Louis Trade Center và Louis Seaview.","sector":"Bất động sản","type":"CT","listed":"2014-09-22","state":0.0,"foreign":0.00092926,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Louis Holdings","p":null,"t":"CORPORATE","q":33000000,"pct":57.21,"d":"2025-10-05"},{"n":"Công ty Cổ phần The Golden Group","p":null,"t":"CORPORATE","q":1317300,"pct":2.28,"d":"2025-10-05"},{"n":"Trần Trường Vũ","p":null,"t":"INDIVIDUAL","q":55500,"pct":0.096,"d":"2025-10-05"},{"n":"Vũ Tuấn Hưng","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.087,"d":"2025-10-05"},{"n":"Võ Phú Nông","p":null,"t":"INDIVIDUAL","q":18400,"pct":0.03,"d":"2025-10-05"},{"n":"Nguyễn Quang Minh","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.017,"d":"2022-05-11"},{"n":"Lê Thị Thanh Thảo","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.009,"d":"2015-09-14"}],"rel":[{"c":"3603594623","n":"Công ty TNHH MTV Kinh Doanh Hạ Tầng Bảo Thư Trị An","t":"subsidiary","pct":100.0},{"c":"12676","n":"Công ty TNHH MTV Đô Thị An Sinh Định Thành","t":"subsidiary","pct":100.0},{"c":"12677","n":"Công ty Cổ Phần Louis Mega Tower","t":"subsidiary","pct":88.53},{"c":"12678","n":"Công Ty TNHH Toccoo Viet Nam","t":"subsidiary","pct":85.0}],"rel_count":4,"events":[{"c":"SUSP","t":"BII - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2026-01-08","record":null,"ex":null},{"c":"MOVE","t":"BII - Chuyển sàn từ HNX sang UPCoM","d":"2023-05-24","record":null,"ex":null},{"c":"SUSP","t":"BII - Hủy niêm yết cổ phiếu trên sàn HNX","d":"2023-04-20","record":null,"ex":nu