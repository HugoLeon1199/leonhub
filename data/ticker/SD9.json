A (đoạn Thường Tín - Cầu Giẽ, Hà Nội – Lạng Sơn) và nay là các công trình: Thủy điện Lai Châu; Thủy điện Huội Quảng, thủy điện Hủa Na; Đường cao tốc Nội Bài – Lào Cai, Xây dựng hạ tầng mỏ đa kim Núi Pháo – Thái Nguyên…Ngày 20/12/2006, SD9 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-20","state":0.5586937,"foreign":0.01114004,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Sông Đà","p":null,"t":"CORPORATE","q":20026944,"pct":58.5,"d":"2026-05-26"},{"n":"Công ty Cổ Phần VBP","p":null,"t":"CORPORATE","q":1401000,"pct":4.09,"d":"2025-10-05"},{"n":"Lê Hải Đoàn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":147617,"pct":0.43,"d":"2026-03-13"},{"n":"Nguyễn Đăng Lanh","p":null,"t":"INDIVIDUAL","q":96290,"pct":0.315,"d":"2015-09-14"},{"n":"Dương Hữu Thắng","p":null,"t":"INDIVIDUAL","q":49964,"pct":0.163,"d":"2015-09-14"},{"n":"Lê Văn Hưng","p":null,"t":"INDIVIDUAL","q":20303,"pct":0.066,"d":"2015-09-14"},{"n":"Trần Thế Quang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":17756,"pct":0.058,"d":"2026-02-24"},{"n":"Nguyễn Hoàng Cường","p":null,"t":"INDIVIDUAL","q":2688,"pct":0.008,"d":"2025-10-05"},{"n":"Nguyễn Văn Phúc","p":null,"t":"INDIVIDUAL","q":1457,"pct":0.005,"d":"2015-09-14"},{"n":"Dương Kim Ngọc","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.004,"d":"2015-09-14"},{"n":"Lê Công Tinh","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.004,"d":"2015-09-14"},{"n":"Nguyễn Đắc Thiệp","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.004,"d":"2015-09-14"},{"n":"Đỗ Văn Hà","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.004,"d":"2015-09-14"},{"n":"Nguyễn Gia Hản","p":null,"t":"INDIVIDUAL","q":896,"pct":0.003,"d":"2025-10-05"},{"n":"Trần Thị Chung","p":null,"t":"INDIVIDUAL","q":800,"pct":0.003,"d":"2025-10-05"},{"n":"Trần Anh Phương","p":null,"t":"INDIVIDUAL","q":488,"pct":0.001,"d":"2026-04-10"},{"n":"Lê Sỹ Tiến","p":"Phó Tổng Giám đốc","t":"INDIVIDUA