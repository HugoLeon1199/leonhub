hiệp là Công ty Thương nghiệp Tổng hợp Quận 1, Công ty Thương nghiệp Tổng hợp chợ Bến Thành và Công ty Thương nghiệp Tổng hợp chợ Dân Sinh. Năm 2004 công ty chính thức chuyển sang hoạt động theo mô hình công ty cổ phần. Công ty hoạt động trong các lĩnh vực chính: Dịch vụ Thương mại, dịch vụ địa ốc, đầu tư tài chính trong đó hoạt động kinh doanh mũi nhọn của công ty là dịch vụ bán lẻ tại chợ Bến Thành - trung tâm Dân Sinh, xuất nhập khẩu tổng hợp các ngành hàng, xây dựng và khai thác trung tâm thương mại - văn phòng. Năm 2010, BTT chính thức được giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bán lẻ","type":"CT","listed":"2010-04-14","state":0.41393756,"foreign":0.04845504,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Bến Thành - TNHH MTV","p":null,"t":"CORPORATE","q":5588157,"pct":41.39,"d":"2026-08-28"},{"n":"Ngô Thị Thái","p":null,"t":"INDIVIDUAL","q":638080,"pct":4.73,"d":"2025-10-05"},{"n":"Nguyễn Hồng Đức","p":null,"t":"INDIVIDUAL","q":311050,"pct":2.934,"d":"2015-09-14"},{"n":"Đỗ Ngọc Đông","p":null,"t":"INDIVIDUAL","q":183886,"pct":1.36,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Phát Triển Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":135000,"pct":1.274,"d":"2015-06-15"},{"n":"Nguyễn Thị Thanh Hà","p":null,"t":"INDIVIDUAL","q":70227,"pct":0.663,"d":"2015-09-14"},{"n":"Đào Văn Hùng","p":null,"t":"INDIVIDUAL","q":49571,"pct":0.468,"d":"2015-09-14"},{"n":"Phan Văn Quang","p":null,"t":"INDIVIDUAL","q":60634,"pct":0.45,"d":"2025-10-05"},{"n":"Huỳnh Thị Thu","p":null,"t":"INDIVIDUAL","q":58834,"pct":0.44,"d":"2025-10-05"},{"n":"Lê Thị Yến Tuyết","p":null,"t":"INDIVIDUAL","q":53117,"pct":0.39,"d":"2025-10-05"},{"n":"Đỗ Hùng Kiệt","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.377,"d":"2015-09-14"},{"n":"Vũ Hoàng Tuấn","p":null,"t":"INDIVIDUAL","q":43804,"pct":0.32,"d":"2025-10-05"},{"n":"Vương Công Minh","p":null,"t":"INDIVIDUAL","q":32632,"pct":0.308,"d":"2025-10-05"},{