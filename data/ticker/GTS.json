4],["2020",16.076],["2021",9.444],["2022",9.387],["2023",8.792],["2024",13.846],["2025",13.997]]}},"co":{"short":"Công trình Giao thông Sài Gòn","profile":"Công ty Cổ phần Công trình Giao thông Sài Gòn (GTS), tiền thân là Khu cầu đường Chợ Lớn, được thành lập từ năm 1975. Hoạt động chủ yếu của Công ty là dịch vụ công cộng, thi công các công trình giao thông và sản xuất, kinh doanh vật liệu xây dựng. GTS chính thức hoạt động theo mô hình công ty cổ phần từ năm 2016. Trong quá trình phát triển, Công ty đã đầu tư nhiều máy móc, thiết bị với công nghệ tiên tiến nhằm phục vụ các hoạt động kinh doanh chính. Qua 40 năm hoạt động, công ty luôn giữ vị thế dẫn đầu trong lĩnh vực quản lý, bảo dưỡng, sửa chữa công trình giao thông đường bộ trên địa bàn thành phố Hồ Chí Minh. Tính đến nay, Công ty đã tham gia vào nhiều các gói thầu, dự án trên địa bàn TP. Hồ Chí Minh và các tỉnh lân cận. GTS được giao dịch trên thị trường UPCOM từ tháng 10/2016.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-10-21","state":0.49000406,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Đầu tư Tài chính Nhà nước Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":13965000,"pct":49.0,"d":"2026-07-29"},{"n":"Đặng Quốc Tuấn","p":null,"t":"INDIVIDUAL","q":5295200,"pct":18.58,"d":"2026-07-29"},{"n":"Lâm Tấn Kiệt","p":null,"t":"INDIVIDUAL","q":4211246,"pct":14.78,"d":"2026-07-29"},{"n":"Trần Thanh Hưng","p":null,"t":"INDIVIDUAL","q":510048,"pct":1.79,"d":"2026-04-24"},{"n":"Võ Văn Sơn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":103719,"pct":0.364,"d":"2026-07-29"},{"n":"Võ Anh Tú","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":22087,"pct":0.077,"d":"2026-07-29"},{"n":"Phan Thị Tú Trinh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":8753,"pct":0.031,"d":"2026-07-29"},{"n":"Nguyễn Hoàng Thái","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5089,"pct":0.018,"d":"2026-07-29"},{"n":"Nguyễn Minh Đức","p":"Trưởng Ban kiểm 