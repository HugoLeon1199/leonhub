024",5.014],["2025",5.79]]}},"co":{"short":"Tập đoàn Quản lý tài sản T-Corp","profile":"Công ty Cổ phần Tập đoàn Quản lý tài sản T-Corp (TVC), tiền thân là Công ty Cổ phần Thương mại và Phát triển Thúy Dương, được thành lập vào năm 2012. Công ty hoạt động tập trung vào một số ngành nghề kinh doanh như: Hoạt động tài chính, Dịch vụ ủy thác đầu tư, Dịch vụ tư vấn quản trị doanh nghiệp, Dịch vụ tư vấn công bố thông tin, Dịch vụ tư vấn nghiên cứu thị trường,…Trong lĩnh vực đầu tư tài chính và lĩnh vực cung cấp dịch vụ quản trị doanh nghiệp, TVC có vị thế tương đối tốt dựa vào việc sở hữu cổ phần lớn của Công ty Cổ phần Chứng khoán Trí Việt. Ngày 23/09/2014, TVC chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Dịch vụ tài chính","type":"CT","listed":"2014-09-23","state":0.0,"foreign":0.00099267,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Tùng Trí Việt","p":null,"t":"CORPORATE","q":16021463,"pct":13.51,"d":"2025-10-05"},{"n":"Phạm Thanh Tùng","p":null,"t":"INDIVIDUAL","q":8390134,"pct":7.074,"d":"2025-10-05"},{"n":"Lê Việt","p":null,"t":"INDIVIDUAL","q":900000,"pct":6.363,"d":"2015-09-14"},{"n":"Đỗ Thanh Hà","p":null,"t":"INDIVIDUAL","q":3537800,"pct":2.98,"d":"2025-10-05"},{"n":"Phạm Thanh Hoa","p":null,"t":"INDIVIDUAL","q":3214300,"pct":2.71,"d":"2025-10-05"},{"n":"Đỗ Thị Nga","p":null,"t":"INDIVIDUAL","q":1050000,"pct":0.89,"d":"2025-10-05"},{"n":"Đỗ Đức Nam","p":null,"t":"INDIVIDUAL","q":1000000,"pct":0.84,"d":"2025-10-05"},{"n":"Nguyễn Đức Anh Tuấn","p":null,"t":"INDIVIDUAL","q":96000,"pct":0.679,"d":"2015-09-14"},{"n":"Đỗ Thanh Hà","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":267837,"pct":0.58,"d":"2021-03-09"},{"n":"Bùi Minh Tuấn","p":null,"t":"INDIVIDUAL","q":630000,"pct":0.53,"d":"2025-10-05"},{"n":"Nguyễn Tiến Sơn","p":null,"t":"INDIVIDUAL","q":230800,"pct":0.5,"d":"2021-03-31"},{"n":"Phạm Thị Thanh Huyền","p":null,"t":"INDIVIDUAL","q":328400,"pct":0.277,"d":"2025-10