ng trình giao thông theo hình thức BOT, BT. Công ty còn liên kết với các đối tác có tiềm lực tài chính cùng đầu tư và phát triển các dự án bất động sản tại thành phố Hồ Chí Minh, Đà Nẵng, Quảng Nam và các vùng lân cận. Bên cạnh đó, Công ty còn tham gia đầu tư phát triển các dự án năng lượng tái tạo. Hoạt động kinh doanh của công ty chủ yếu diễn ra tại các tình miền Nam và Nam Trung Bộ.","sector":"Dịch vụ tài chính","type":"CT","listed":"2015-07-16","state":0.0,"foreign":0.01136037,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Hồ Nam","p":null,"t":"INDIVIDUAL","q":81023783,"pct":9.21,"d":"2025-10-05"},{"n":"Công Ty TNHH MTV Nhn","p":null,"t":"CORPORATE","q":52800000,"pct":5.99,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Regeneration Investment","p":null,"t":"CORPORATE","q":49088208,"pct":5.58,"d":"2025-10-05"},{"n":"Trần Thị Kiều Tiên","p":null,"t":"INDIVIDUAL","q":1964706,"pct":4.827,"d":"2015-09-14"},{"n":"Công ty Cổ phần Đầu tư và Dịch vụ Helios","p":null,"t":"CORPORATE","q":24131317,"pct":4.52,"d":"2025-10-05"},{"n":"Hoàng Thị Minh Châu","p":null,"t":"INDIVIDUAL","q":8751675,"pct":1.63,"d":"2025-10-05"},{"n":"Nguyễn Thị Thùy Linh","p":null,"t":"INDIVIDUAL","q":8587444,"pct":0.976,"d":"2025-10-05"},{"n":"Nguyễn Thanh Hùng","p":null,"t":"INDIVIDUAL","q":7366934,"pct":0.84,"d":"2025-12-29"},{"n":"Nguyễn Thế Tài","p":null,"t":"INDIVIDUAL","q":4340050,"pct":0.54,"d":"2025-10-05"},{"n":"Ngô Thành Vinh","p":null,"t":"INDIVIDUAL","q":2409750,"pct":0.45,"d":"2025-10-05"},{"n":"Trần Thị Huệ Linh","p":null,"t":"INDIVIDUAL","q":2252500,"pct":0.42,"d":"2025-10-05"},{"n":"Phạm Minh Tuấn","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":3433646,"pct":0.39,"d":"2026-01-30"},{"n":"Đinh Hoài Châu","p":null,"t":"INDIVIDUAL","q":2008572,"pct":0.39,"d":"2025-10-05"},{"n":"Đào Thị Thanh Hiền","p":null,"t":"INDIVIDUAL","q":200000,"pct":0.19,"d":"2025-10-05"},{"n":"Đặng Trung Kiên","p":null,"t":"INDIVIDUAL","q":200000,"pct":0.19,"d":"2025-1