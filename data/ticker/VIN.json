 nhận vận tải quốc tế và logistics. VINATRANS có cơ hội phát triển bền vững nhờ vào hệ thống kho bãi cảng lớn và tọa lạc tại các vị trí quan trọng, thuận lợi giao thương. Hiện tại, VIN có 5 chi nhánh tại Hà Nội, Hải Phòng, Cần Thơ, Quảng Ninh và Quảng Ngãi. Năm 2014, VIN chính thức được giao dịch tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2014-09-04","state":0.95369804,"foreign":0.00091765,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Thép Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":24319300,"pct":95.37,"d":"2026-08-07"},{"n":"Vũ Thế Đức","p":null,"t":"INDIVIDUAL","q":18000,"pct":0.071,"d":"2015-09-14"},{"n":"Phạm Tú Anh","p":null,"t":"INDIVIDUAL","q":16500,"pct":0.065,"d":"2025-10-05"},{"n":"Lương Ngọc Bảo","p":null,"t":"INDIVIDUAL","q":14100,"pct":0.055,"d":"2015-09-14"},{"n":"Nguyễn Bích Liên","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.039,"d":"2015-09-14"},{"n":"Nguyễn Quốc Huy","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.031,"d":"2015-09-14"},{"n":"Lê Hoàng Như Uyên","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.024,"d":"2025-10-05"},{"n":"Ninh Kim Thoa","p":"Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":5400,"pct":0.021,"d":"2026-08-07"},{"n":"Nguyễn Thanh Tòng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5000,"pct":0.02,"d":"2026-08-07"},{"n":"Trương Minh Long","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.02,"d":"2025-10-05"},{"n":"Văn Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.016,"d":"2025-10-05"},{"n":"Vũ Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.016,"d":"2025-10-05"},{"n":"Võ Hồng Tương","p":null,"t":"INDIVIDUAL","q":3200,"pct":0.013,"d":"2015-09-14"},{"n":"Vũ Thị Bình Nguyên","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.01,"d":"2025-10-05"},{"n":"Cao Thị Mỹ Trang","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.009,"d":"2025-10-05"},{"n":"Ngô Thị Lương","p":null,"t":"INDIVID