ng kho đạt tiêu chuẩn GSP - ASEAN và Phòng thí nghiệm đạt tiêu chuẩn GLP - ASEAN. IMP được cấp visa Châu Âu cho sản phẩm thuốc Cephalexin 500mg và việc được cấp giấy chứng nhận WHO-GMP cho nhà máy sản xuất Thực phẩm bảo vệ sức khỏe. Sản phẩm sản xuất tập trung các nhóm hạ sốt giảm đau, kháng sinh, vitamin, thực phẩm chức năng. Về mạng lưới thị trường, Công ty hiện có 18 chi nhánh phụ trách bán hàng trên toàn quốc. Công ty còn hợp tác với các công ty dược phẩm khác để trở thành đại lý độc quyền phân phối. IMP chính thức niêm yết trên sàn HOSE từ ngày 04/12/2006.","sector":"Y tế","type":"CT","listed":"2006-12-04","state":0.2203868,"foreign":0.72597143,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"LIAN SGP HOLDING PTE. LTD.","p":null,"t":"CORPORATE","q":104545781,"pct":67.87,"d":"2026-08-11"},{"n":"Tổng Công ty Dược Việt Nam - CTCP","p":null,"t":"CORPORATE","q":33948992,"pct":22.04,"d":"2026-07-31"},{"n":"Sk Investment Vina Iii Pte.ltd","p":null,"t":"CORPORATE","q":4647051,"pct":3.02,"d":"2026-08-11"},{"n":"FTIF - Templeton Frontier Markets Fund","p":null,"t":"CORPORATE","q":1629479,"pct":2.443,"d":"2025-10-05"},{"n":"Công ty Cổ phần Giải pháp Phân phối và Bán lẻ PHANO","p":null,"t":"CORPORATE","q":1437198,"pct":2.155,"d":"2025-10-05"},{"n":"Quỹ Đầu tư Chứng khoán Y tế Bản Việt","p":null,"t":"CORPORATE","q":807394,"pct":1.21,"d":"2025-10-05"},{"n":"TGIT-Templeton Emerging Markets Small Cap Fund","p":null,"t":"CORPORATE","q":610706,"pct":0.916,"d":"2025-10-05"},{"n":"J.P. Morgan Whitefriars Inc.","p":null,"t":"CORPORATE","q":433500,"pct":0.65,"d":"2025-10-05"},{"n":"Quỹ Đầu tư Lợi Thế Cạnh Tranh Bền Vững SSI","p":null,"t":"CORPORATE","q":262093,"pct":0.531,"d":"2020-07-14"},{"n":"Nguyễn Quốc Định","p":null,"t":"INDIVIDUAL","q":315000,"pct":0.45,"d":"2025-10-05"},{"n":"Trần Thị Đào","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":300000,"pct":0.19,"d":"2026-07-31"},{"n":"Trần Thái Hoàng","p":null,"t":"INDIVIDUAL