thức hoạt động theo mô hình công ty cổ phần từ năm 2005. Hoạt động chính của công ty là vận tải xăng dầu viễn dương và ven biển, kinh doanh xăng dầu, kinh doanh bất động sản. Công ty có đội tàu biển tổng trọng tải 180.000 DWT, là một trong số ít đội tàu biển vận tải xăng dầu của Việt Nam có tải trọng lớn nhất, được chia làm 2 nhóm chuyên vận tải tuyến quốc tế và nội địa. VIP Là thành viên của PETROLIMEX, nên công ty có sẵn thị phần lớn trong việc vận chuyển và kinh doanh xăng dầu cho chính Tổng công ty. Ngày 21/12/2006, VIP chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-12-21","state":0.51004457,"foreign":0.05184731,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Vận Tải Thủy Petrolimex","p":null,"t":"CORPORATE","q":34923232,"pct":51.0,"d":"2026-08-26"},{"n":"Phan Minh Tuấn","p":null,"t":"INDIVIDUAL","q":6507645,"pct":10.169,"d":"2015-09-14"},{"n":"Công ty Cổ phần Tập đoàn Macstar","p":null,"t":"CORPORATE","q":3420000,"pct":4.99,"d":"2025-10-05"},{"n":"Tổng Công ty Cổ phần Bảo hiểm Petrolimex","p":null,"t":"CORPORATE","q":3286249,"pct":4.799,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu tư TM","p":null,"t":"CORPORATE","q":2850000,"pct":4.16,"d":"2025-10-05"},{"n":"Deutsche Asset Management (Asia) Limited","p":null,"t":"CORPORATE","q":1832080,"pct":2.863,"d":"2015-06-15"},{"n":"Tmam Vietnam Equity Mother Fund","p":null,"t":"CORPORATE","q":1674600,"pct":2.45,"d":"2026-01-30"},{"n":"Ngân hàng Deutsche Aktiengesellschaft","p":null,"t":"CORPORATE","q":1126183,"pct":1.76,"d":"2015-06-15"},{"n":"KITMC Worldwide Vietnam RSP Balanced Fund","p":null,"t":"CORPORATE","q":1071000,"pct":1.56,"d":"2026-01-30"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":460900,"pct":0.67,"d":"2026-01-30"},{"n":"Vũ Ngọc Kháu","p":null,"t":"INDIVIDUAL","q":56743,"pct":0.089,"d":"2015-09-14"},{"n":"Nguyễn Đạo Thịnh","p":null,"t":"INDIVI