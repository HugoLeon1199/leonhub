 dự án là 113 tỷ đồng; Khu đô thị mới Yên Hòa với tổng diện tích đất quy hoạch lên tới 39.9 ha. XDH được giao dịch trên thị trường UPCOM từ tháng 10/2018.","sector":"Bất động sản","type":"CT","listed":"2018-10-22","state":0.43103478,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng công ty Đầu tư Phát triển Hạ tầng Đô thị UDIC - Công ty TNHH MTV","p":null,"t":"CORPORATE","q":11649537,"pct":43.1,"d":"2026-01-28"},{"n":"Phương Kim Thảo","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3949604,"pct":14.61,"d":"2026-01-28"},{"n":"Trần Hồng Tâm","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3433779,"pct":12.705,"d":"2026-01-28"},{"n":"Nguyễn Thị Hồng","p":null,"t":"INDIVIDUAL","q":1357656,"pct":5.023,"d":"2026-01-28"},{"n":"Đoàn Trịnh Linh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":710532,"pct":2.629,"d":"2026-01-28"},{"n":"Phương Minh Vũ","p":null,"t":"INDIVIDUAL","q":540540,"pct":2.0,"d":"2026-01-28"},{"n":"Phương Thị Minh Thu","p":null,"t":"INDIVIDUAL","q":540540,"pct":2.0,"d":"2026-02-27"},{"n":"Phạm Tiến Điệp","p":"Giám đốc","t":"INDIVIDUAL","q":80293,"pct":0.3,"d":"2026-01-28"},{"n":"Trần Quang Khuê","p":"Phó Giám đốc","t":"INDIVIDUAL","q":67623,"pct":0.25,"d":"2026-01-28"},{"n":"Nguyễn Thị Hải","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":39639,"pct":0.147,"d":"2026-01-28"},{"n":"Đinh Công Đức","p":null,"t":"INDIVIDUAL","q":17220,"pct":0.105,"d":"2025-10-05"},{"n":"Nguyễn Bình Nam","p":"Phó Giám đốc","t":"INDIVIDUAL","q":5405,"pct":0.02,"d":"2026-01-28"},{"n":"Nguyễn Thu Trang","p":null,"t":"INDIVIDUAL","q":520,"pct":0.007,"d":"2025-10-05"},{"n":"Hà Vân Chi","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":500,"pct":0.002,"d":"2026-01-28"}],"events":[{"c":"OTHE","t":"XDH - Thay đổi địa chỉ","d":"2026-08-18","record":null,"ex":null},{"c":"AGME","t":"XDH - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-11","record":"2026-03-30","ex":"2026-03-27