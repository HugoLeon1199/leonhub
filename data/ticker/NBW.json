 7, huyện Nhà Bè và huyện Cần Giờ. Kế hoạch của công ty trong thời gian tới là tập trung nâng cao chất lượng nước sạch, gia tăng sản lượng nước để đáp ứng kịp tốc độ đô thị hóa của địa bàn quản lý.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2010-05-04","state":0.53442844,"foreign":0.05702752,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cấp nước Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":5825270,"pct":53.443,"d":"2026-02-24"},{"n":"Công ty TNHH Nước Sạch Ree","p":null,"t":"CORPORATE","q":2182100,"pct":20.02,"d":"2026-02-24"},{"n":"Ngân hàng TNHH MTV Số Vikki","p":null,"t":"CORPORATE","q":1090000,"pct":10.0,"d":"2026-02-24"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":547300,"pct":5.02,"d":"2025-10-05"},{"n":"Công ty TNHH Quản lý Quỹ đầu tư Chứng khoán Đông Á","p":null,"t":"CORPORATE","q":69748,"pct":0.64,"d":"2025-10-05"},{"n":"Bùi Nhật Lam","p":null,"t":"INDIVIDUAL","q":49000,"pct":0.45,"d":"2025-10-05"},{"n":"Hứa Trọng Nghi","p":null,"t":"INDIVIDUAL","q":20900,"pct":0.192,"d":"2025-10-05"},{"n":"Lý Thành Tài","p":null,"t":"INDIVIDUAL","q":10600,"pct":0.097,"d":"2025-10-05"},{"n":"Nguyễn Doãn Xã","p":null,"t":"INDIVIDUAL","q":4300,"pct":0.039,"d":"2025-10-05"},{"n":"Mai Ngọc Bích Hồng","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3700,"pct":0.034,"d":"2026-08-10"},{"n":"Nguyễn Hương Lan","p":null,"t":"INDIVIDUAL","q":2800,"pct":0.026,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Trang","p":"Phó Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":2400,"pct":0.022,"d":"2026-08-10"},{"n":"Dương Văn Hoà","p":"Thành viên Hội đồng Quản trị/Giám đốc/Phó Giám đốc Kỹ thuật","t":"INDIVIDUAL","q":1300,"pct":0.012,"d":"2026-08-10"},{"n":"Võ Nhật Trân","p":null,"t":"INDIVIDUAL","q":1300,"pct":0.012,"d":"2015-09-14"},{"n":"Lê Hữu Dương","p":null,"t":"INDIVIDUAL","q":1200,"pct":0.011,"d":"2015-09-14"},{"n":"Phạm Chí Thiện","p":null,"t":"INDIVIDUAL","q":1200,"pct":0.