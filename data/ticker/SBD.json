g nghệ thông tin. SBD là đối tác công nghệ duy nhất của Cisco tại thị trường Việt Nam. SBD được giao dịch trên thị trường UPCOM từ tháng 02/2017.","sector":"Công nghệ Thông tin","type":"CT","listed":"2017-02-16","state":0.0,"foreign":0.00970813,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Đức Quang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2317178,"pct":16.65,"d":"2026-08-20"},{"n":"Mai Thị Thúy Mai","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":1015290,"pct":7.3,"d":"2026-08-17"},{"n":"Đỗ Văn Hào","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":670235,"pct":4.82,"d":"2026-08-06"},{"n":"Nguyễn Việt Thắng","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":667820,"pct":4.8,"d":"2026-08-17"},{"n":"Trần Tuyên Đức","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":464305,"pct":3.34,"d":"2026-08-17"},{"n":"Ngô Tiến Mạnh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":463400,"pct":3.33,"d":"2026-08-17"},{"n":"Nguyễn Xuân Trường","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":346571,"pct":2.49,"d":"2026-08-17"},{"n":"Trần Phương Lan","p":null,"t":"INDIVIDUAL","q":345320,"pct":2.48,"d":"2026-03-03"},{"n":"Lê Quốc Khánh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":251200,"pct":1.81,"d":"2026-08-17"},{"n":"Hoàng Mạnh Cường","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":143504,"pct":1.03,"d":"2026-08-17"},{"n":"Nguyễn Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":129935,"pct":0.93,"d":"2026-03-03"},{"n":"Tạ Thị Hồng Đào","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":104378,"pct":0.75,"d":"2026-08-17"},{"n":"Đặng Nam Sơn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":94564,"pct":0.68,"d":"2026-08-17"},{"n":"Bùi Anh Tâm","p":null,"t":"INDIVIDUAL","q":69620,"pct":0.5,"d":"2026-03-03"},{"n":"Nguyễn Hồng Minh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":54598,"pct":0.39,"d":"2026-08-17"},{"n":"Lê Nguyễn Anh Uyên","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị