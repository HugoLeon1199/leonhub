– Thiết bị dầu khí (PV MACHINO) được thành lập trên cơ sở hợp nhất Tổng Công ty Xuất nhập khẩu Máy và Tổng Công ty Thiết bị Phụ tùng vào ngày 02/03/1992. PV MACHINO chuyên cung cấp vật tư, thiết bị, lắp đặt, vận hành cho các công trình trong và ngoài ngành Dầu khí. Là thành viên của Tập đoàn Dầu khí Việt Nam, PV MACHINO có điều kiện thuận lợi tham gia vào chuỗi cung ứng của Tập đoàn. Công ty đã tham gia một số dự án lớn của Tập đoàn như Viện Dầu Khí, các công trình khác của Tổng Công ty Xây lắp Dầu khí (PVC), Tổng Công ty Cổ phần Dịch vụ Kỹ Thuật Dầu khí Việt Nam (PTSC). Năm 2016, PVM chính thức được giao dịch trên thị trường Upcom.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-12-20","state":0.0,"foreign":0.00010694,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Thị Kiều Vân","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":7000000,"pct":18.117,"d":"2026-08-26"},{"n":"Nguyễn Anh Thu","p":null,"t":"INDIVIDUAL","q":6535100,"pct":16.913,"d":"2025-10-05"}],"rel":[{"c":"0110141356","n":"Công ty Cổ Phần Machino Thành Đạt","t":"subsidiary","pct":94.05},{"c":"1001268964","n":"Công ty TNHH Machino Phú Xuân","t":"subsidiary","pct":70.0},{"c":"1001268989","n":"Công ty Cổ phần Machino An Phú","t":"subsidiary","pct":55.0},{"c":"4900921699","n":"Công ty TNHH Đầu Tư Và Kinh Doanh Bất Động Sản Đông Kinh","t":"affiliate","pct":50.0},{"c":"DAS","n":"Công ty Cổ phần Máy - Thiết bị Dầu khí Đà Nẵng","t":"subsidiary","pct":49.78},{"c":"PVMN","n":"Công ty Cổ Phần Máy - Thiết Bị Dầu Khí Miền Bắc Việt Nam","t":"affiliate","pct":34.58}],"rel_count":6,"events":[{"c":"OTHE","t":"PVM - Thay đổi địa chỉ","d":"2026-07-10","record":null,"ex":null},{"c":"AGME","t":"PVM - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-07","record":"2026-05-26","ex":"2026-05-25"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 600 VND","d":"2025-11-21","record":"2025-12-15","ex":"2025-12-12"},{"c":"AGME","t":"PVM - Tổ chức ĐHĐCĐ thường niên 2025","d":