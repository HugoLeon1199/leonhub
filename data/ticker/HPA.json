{"s":"HPA","n":"Công ty Cổ phần Phát triển Nông nghiệp Hoà Phát","e":"HSX","i":"Nuôi trồng nông & hải sản","src":"Vietcap","as_of":"2026-09-03T12:38:46.149018+04:00","m":{"at":{"q":[["2026-Q2",1.44]]},"cycle":{"q":[["2026-Q2",83.647]]},"cash":{"q":[["2026-Q2",0.975]]},"cr":{"q":[["2026-Q2",4.047]]},"de":{"q":[["2026-Q2",0.18]]},"ebitm":{"q":[["2026-Q2",19.823]]},"ebitda":{"q":[["2026-Q2",1794.554]]},"ev":{"q":[["2026-Q2",4.269]]},"gpm":{"q":[["2026-Q2",25.064]]},"lev":{"q":[["2026-Q2",0.18]]},"mc":{"q":[["2026-Q2",8008.5]]},"npm":{"q":[["2026-Q2",18.248]]},"pcf":{"q":[["2026-Q2",3.702]]},"pb":{"q":[["2026-Q2",1.816]]},"pe":{"q":[["2026-Q2",5.816]]},"ps":{"q":[["2026-Q2",1.116]]},"qr":{"q":[["2026-Q2",3.364]]},"roa":{"q":[["2026-Q2",26.122]]},"roe":{"q":[["2026-Q2",34.266]]},"roic":{"q":[["2026-Q2",29.368]]}},"co":{"short":"Phát triển Nông nghiệp Hoà Phát","profile":"Công ty Cổ phần Phát triển Nông nghiệp Hoà Phát (HPA) được thành lập năm 2016 theo Giấy chứng nhận đăng ký kinh doanh số 0900986272 do Sở Kế hoạch và Đầu tư Tỉnh Hưng Yên cấp. Công ty hoạt động chính trong lĩnh vực chăn nuôi lợn, bò, gia cầm và sản xuất các sản phẩm thức ăn chăn nuôi. HPA hiện sở hữu hệ thống trang trại với 7 trang trại nuôi lợn với quy mô hơn 162 nghìn con lợn thịt/ lứa, 3 trang trại nuôi bò Úc với quy mô hơn 42,5 nghìn con bò/ lứa, 2 trang trại nuôi gà với công suất hơn 330 triệu quả trứng/năm và 2 nhà máy sản xuất thức ăn chăn nuôi với tổng công suất đạt 600.000 tấn/năm, hoạt động trải dài trên khắp cả nước. Hiện nay, công ty đang duy trì tệp khách hàng với hơn 700 hệ thống nhà phân phối trên toàn quốc, tập trung tại khu vực phía Bắc. Ngày 06/02/2026, HPA chính thức giao dịch trên Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE)","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2026-02-06","state":0.0,"foreign":0.00912801,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn Hòa Phát","p":null,"t":"CORPORATE","q":2409267