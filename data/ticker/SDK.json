iao dịch tại Thị trường UPCoM từ Ngày 28/10/2010.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-10-28","state":0.45000173,"foreign":0.00242853,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Thép Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":1404000,"pct":45.0,"d":"2026-03-04"},{"n":"Lê Xuân Hiếu","p":null,"t":"INDIVIDUAL","q":686400,"pct":22.0,"d":"2026-08-28"},{"n":"Nguyễn Thái Sơn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":537840,"pct":17.24,"d":"2026-08-07"},{"n":"Công ty Cổ phần Bảo hiểm Viễn Đông","p":null,"t":"CORPORATE","q":180263,"pct":6.933,"d":"2015-06-15"},{"n":"Trần Văn Ngọc","p":null,"t":"INDIVIDUAL","q":180264,"pct":6.933,"d":"2015-09-14"},{"n":"Nguyễn Xuân Thu","p":null,"t":"INDIVIDUAL","q":170442,"pct":6.555,"d":"2015-09-14"},{"n":"Bùi Thị Lan Phương","p":null,"t":"INDIVIDUAL","q":139500,"pct":5.365,"d":"2015-09-14"},{"n":"Phạm Văn Tốn","p":null,"t":"INDIVIDUAL","q":13300,"pct":0.512,"d":"2015-09-14"},{"n":"Đỗ Xuân Quang","p":null,"t":"INDIVIDUAL","q":2800,"pct":0.108,"d":"2015-09-14"},{"n":"Mai Văn Thanh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2160,"pct":0.07,"d":"2026-03-04"}],"events":[{"c":"DDIND","t":"Lê Xuân Hiếu - Đăng kí Mua SDK","d":"2026-08-28","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Cổ phiếu thưởng tỉ lệ 48.6%","d":"2026-08-26","record":"2026-09-03","ex":"2026-08-28"},{"c":"DDRP","t":"Nguyễn Thái Thiện - Đăng kí Bán 686,400 SDK","d":"2026-08-22","record":null,"ex":null},{"c":"DDIND","t":"Trần Phước Dũng - Đăng kí Bán SDK","d":"2026-08-10","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Thái Sơn - Đăng kí Mua SDK","d":"2026-08-07","record":null,"ex":null},{"c":"DDIND","t":"Ngô Thế Hiển - Đăng kí Bán 78,480 SDK","d":"2026-08-03","record":null,"ex":null},{"c":"EGME","t":"SDK - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-06-10","record":"2026-06-25","ex":"2026-06-24"},{"c":"AGME","t":"SDK - Tổ chức 