 sản phẩm kinh doanh côt lõi của Công ty, mang lại nguồn doanh thu chính. Ngoài ra, Công ty còn sản xuất và kinh doanh thương mại nhiều sản phẩm hóa chất cơ bản khác. Nằm trong chiến lược dài hạn, Công ty còn triển khai mở rộng sản xuất sang lĩnh vực hóa chất nông nghiệp, phân bón. DGC giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 07/2020.","sector":"Hóa chất","type":"CT","listed":"2014-08-26","state":0.0,"foreign":0.03864003,"rating":"O-PF","target":52100.0,"rating_as_of":"2026-07-20","source":"Vietcap"},"owners":[{"n":"Đào Hữu Huyền","p":null,"t":"INDIVIDUAL","q":69794354,"pct":18.38,"d":"2026-08-03"},{"n":"Ngô Thị Ngọc Lan","p":null,"t":"INDIVIDUAL","q":25205068,"pct":6.637,"d":"2026-08-03"},{"n":"Đào Hữu Kha","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":22667148,"pct":5.969,"d":"2026-08-03"},{"n":"Nguyễn Thị Hồng Lan","p":null,"t":"INDIVIDUAL","q":14298574,"pct":3.765,"d":"2026-08-03"},{"n":"Đào Hữu Duy Anh","p":null,"t":"INDIVIDUAL","q":11450291,"pct":3.01,"d":"2026-08-03"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":7403040,"pct":1.949,"d":"2025-11-14"},{"n":"Đào Hồng Hạnh","p":null,"t":"INDIVIDUAL","q":5136504,"pct":1.353,"d":"2026-08-03"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":4771560,"pct":1.256,"d":"2025-11-14"},{"n":"CTBC Vietnam Equity Fund","p":null,"t":"CORPORATE","q":4700000,"pct":1.238,"d":"2025-10-05"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":2896900,"pct":0.763,"d":"2025-11-14"},{"n":"Hanoi Investments Holdings Limited","p":null,"t":"CORPORATE","q":2169400,"pct":0.571,"d":"2025-11-14"},{"n":"Đào Thị Quyên","p":null,"t":"INDIVIDUAL","q":2170034,"pct":0.571,"d":"2026-08-03"},{"n":"Quách Tiến Nhất","p":null,"t":"INDIVIDUAL","q":1816016,"pct":0.48,"d":"2026-08-03"},{"n":"Wareham Group Limited","p":null,"t":"CORPORATE","q":1630500,"pct":0.429,"d":"2025-11-14"},{"n":"Lê Thị Lựu","p":null,"t":"INDIVIDUAL","q":1580240,"pct":0.42,"d":"2026-08-03"},{"n":"P