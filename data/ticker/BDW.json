 Đầu tư Phát triển Tỉnh Gia Lai","p":null,"t":"CORPORATE","q":6329508,"pct":51.0,"d":"2026-02-25"},{"n":"Công ty CP Cấp Thoát Nước Thủy Anh","p":null,"t":"CORPORATE","q":3090131,"pct":24.899,"d":"2026-02-25"},{"n":"Nguyễn Thị Kim Phượng","p":null,"t":"INDIVIDUAL","q":1180644,"pct":9.54,"d":"2026-02-25"},{"n":"Lê Tiến Dũng","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":6800,"pct":0.055,"d":"2026-02-25"},{"n":"Nguyễn Văn Châu","p":null,"t":"INDIVIDUAL","q":6800,"pct":0.055,"d":"2026-02-25"},{"n":"Trần Nguyễn Hạnh Lan","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":4700,"pct":0.038,"d":"2026-02-25"},{"n":"Lê Thanh Cường","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":3500,"pct":0.028,"d":"2026-02-25"},{"n":"Nguyễn Nguyễn Hoài Viễn","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":1200,"pct":0.01,"d":"2026-02-25"},{"n":"Đặng Hoàng Trung","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1100,"pct":0.009,"d":"2026-02-25"},{"n":"Nguyễn Thị Phương Trà","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1000,"pct":0.008,"d":"2026-02-25"}],"events":[{"c":"DDIND","t":"Ngô Thị Hồng Vân - Đăng kí Bán 496,000 BDW","d":"2026-08-11","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,250 VND","d":"2026-06-22","record":"2026-07-28","ex":"2026-07-27"},{"c":"AGME","t":"BDW - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-09","record":"2026-03-25","ex":"2026-03-24"},{"c":"EGME","t":"BDW - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-09-26","record":"2025-10-17","ex":"2025-10-16"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 1,100 VND","d":"2025-07-29","record":"2025-08-14","ex":"2025-08-13"},{"c":"AGME","t":"BDW - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-17","record":"2025-05-06","ex":"2025-05-05"},{"c":"DDIND","t":"Dương Tiến Dũng - Đăng kí Bán BDW","d":"2025-01-15","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Thị Kim Phượng - Đăng kí Mua BDW","d":"2025-01-15","r