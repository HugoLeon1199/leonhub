rạm chiết áp lớn tại Ninh hiệp và Bến Lức, tổng công suất khoảng 150.000 tấn/năm. và đội xe vận chuyển gas chuyên dụng khoảng 100 chiếc. Việc sở hữu một hệ thống hoàn chỉnh từ khâu nhập khẩu, vận tải, tồn trữ đến phân phối bán buôn, bán lẻ trên địa bàn toàn quốc với qui mô lớn như vậy đã tạo cho công ty ưu thế về tính chủ động trong điều tiết nguồn hàng, dự trữ khi cần thiết cũng như đa dạng trong kinh doanh LPG ( bán buôn, bán lẻ gas dân dụng). Ngày 15/02/2008, ASP chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE)","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2008-02-15","state":0.0,"foreign":0.48989113,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Saisan Joint Stock Company","p":null,"t":"CORPORATE","q":17998426,"pct":48.202,"d":"2026-07-29"},{"n":"Trần Minh Loan","p":null,"t":"INDIVIDUAL","q":2188100,"pct":5.86,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Đầu tư và Phát triển Việt Nam - Chi nhánh Hải Phòng","p":null,"t":"CORPORATE","q":2050000,"pct":5.49,"d":"2015-06-15"},{"n":"Trần Duy Luân","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":2000000,"pct":5.35,"d":"2026-07-29"},{"n":"Đinh Ngọc Hải","p":null,"t":"INDIVIDUAL","q":1170000,"pct":3.133,"d":"2015-09-14"},{"n":"Phạm Thu Hiền","p":null,"t":"INDIVIDUAL","q":1137000,"pct":3.045,"d":"2015-09-14"},{"n":"Ngân hàng Thương mại Cổ phần Đầu tư và Phát triển Việt Nam","p":null,"t":"CORPORATE","q":1103360,"pct":2.955,"d":"2015-06-15"},{"n":"Trần Thị Thanh Hằng","p":null,"t":"INDIVIDUAL","q":862650,"pct":2.31,"d":"2025-10-05"},{"n":"Lê Xuân Hoàng","p":null,"t":"INDIVIDUAL","q":596100,"pct":1.596,"d":"2025-10-05"},{"n":"Nguyễn Hồng Hiệp","p":null,"t":"INDIVIDUAL","q":472400,"pct":1.27,"d":"2025-10-05"},{"n":"Ngô Tiến Dũng","p":null,"t":"INDIVIDUAL","q":177383,"pct":0.475,"d":"2025-10-05"},{"n":"Nguyễn Hữu Tuyến","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.016,"d":"2015-09