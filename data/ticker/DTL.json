khúc thép chất lượng cao. DTL sở hữu hệ thống sản xuất với tổng công suất lớn, trong đó nổi bật là 600.000 tấn/năm dây chuyền tẩy rửa, 400.000 tấn/năm thép lá cán nguội và 270.000 tấn/năm thép lá mạ hợp kim nhôm-kẽm. Bên cạnh thị trường nội địa, sản phẩm của Công ty còn được xuất khẩu sang nhiều khu vực như ASEAN, châu Á, Trung Đông, châu Phi, Nam Mỹ và châu Âu. DTL chính thức được niêm yết trên sàn Chứng khoán thành phố Hồ Chí Minh từ tháng 8/2010.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2010-06-04","state":0.0,"foreign":6.503e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thanh Nghĩa","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":29220313,"pct":47.56,"d":"2026-08-28"},{"n":"Công ty TNHH Sản Xuất Thép Tâm Đức","p":null,"t":"CORPORATE","q":10108189,"pct":16.45,"d":"2026-08-28"},{"n":"Nguyễn Thị Bích Liên","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7899952,"pct":12.86,"d":"2026-08-28"},{"n":"Nguyễn Thanh Loan","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6244378,"pct":10.16,"d":"2026-08-28"},{"n":"Nguyễn Thanh Dung","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":2573990,"pct":4.19,"d":"2026-08-28"},{"n":"Nguyễn Thanh Trúc","p":null,"t":"INDIVIDUAL","q":2435000,"pct":3.96,"d":"2026-08-28"},{"n":"Công ty Cổ phần Chứng khoán SSI","p":null,"t":"CORPORATE","q":1593180,"pct":2.593,"d":"2015-06-15"},{"n":"Phan Minh Hiển","p":null,"t":"INDIVIDUAL","q":16000,"pct":0.027,"d":"2015-09-14"},{"n":"Lê Hồng Nhung","p":null,"t":"INDIVIDUAL","q":1320,"pct":0.002,"d":"2015-09-14"},{"n":"Lê Anh Thi","p":null,"t":"INDIVIDUAL","q":500,"pct":0.001,"d":"2015-09-14"},{"n":"Nguyễn Quang Quảng","p":null,"t":"INDIVIDUAL","q":625,"pct":0.001,"d":"2026-02-13"},{"n":"Công ty Cổ phần Xuất nhập khẩu Thủy sản Bến Tre","p":null,"t":"CORPORATE","q":3,"pct":0.0,"d":"2015-06-15"}],"rel":[{"c":"DTLS","n":"CÔNG TY TNHH MTV THÉP ĐẠI THIÊN LỘC","t":