ào hoạt động 04 Trung tâm thương mại Sense City tại Cần Thơ, Cà Mau, Bến Tre và thành phố Hồ Chí Minh với tổng diện tích hơn 85.000 m2. Bên cạnh đó, Công ty cùng với đối tác chiến lược Công ty TNHH đầu tư Mapletree đưa Trung tâm Thương mại SC VivoCity tại Quận 7, Thành phố Hồ Chí Minh đi vào hoạt động với tổng diện tích sàn thương mại lên đến 62.000m2. SID được được giao dịch trên thị trường UPCOM từ đầu năm 2017.","sector":"Bất động sản","type":"CT","listed":"2017-01-09","state":0.96092796,"foreign":0.000884,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Liên Hiệp Hợp Tác Xã Thương Mại Tp. Hồ Chí Minh","p":null,"t":"CORPORATE","q":96092796,"pct":96.09,"d":"2026-08-24"},{"n":"Nguyễn Thị Tranh","p":null,"t":"INDIVIDUAL","q":9334,"pct":0.009,"d":"2025-10-05"}],"rel":[{"c":"1300419650","n":"Công Ty TNHH Một Thành Viên Thương Mại Sài Gòn - Bến Tre","t":"subsidiary","pct":100.0},{"c":"1201677996","n":"Công ty TNHH MTV Thương Mại Dịch Vụ Sense Cái Bè","t":"subsidiary","pct":100.0},{"c":"5901160960","n":"Công ty TNHH Một Thành Viên Thương Mại Dịch Vụ Sài Gòn - Pleiku","t":"subsidiary","pct":100.0},{"c":"0315949585","n":"Công ty TNHH Thương Mại Dịch Vụ Sài Gòn - Xuân Oai","t":"affiliate","pct":49.0},{"c":"0310384927","n":"Công ty TNHH Đầu Tư Quốc Tế Sài Gòn Co.op","t":"affiliate","pct":49.0},{"c":"5702088237","n":"Công ty TNHH Đầu Tư Phát Triển Trung Tâm Thương Mại Đông Bắc","t":"affiliate","pct":40.0},{"c":"2000969020","n":"Công ty TNHH Thương Mại Dịch Vụ Sài Gòn - Cà Mau","t":"affiliate","pct":36.75},{"c":"0310055721","n":"Công ty CP Phát Triển Khu Phức Hợp Thương Mại Vietsin","t":"affiliate","pct":36.0},{"c":"1800502219","n":"Công ty TNHH Thương Mại Sài Gòn Cần Thơ","t":"affiliate","pct":34.0},{"c":"3600753610","n":"Công ty TNHH Thương Mại Dịch Vụ Siêu Thị Co.op Mart Biên Hòa","t":"affiliate","pct":29.0},{"c":"12617","n":"Công ty TNHH Sài Gòn - Châu Đốc","t":"affiliate","pct":25.0}],"rel_count":11,"events":[{"c":"AGME","t":"SID - Tổ c