 trạm. Ngày 13/12/2007, VC3 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2007-12-13","state":0.0,"foreign":0.00143637,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Kiều Xuân Nam","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":69461694,"pct":50.919,"d":"2026-08-24"},{"n":"Nguyễn Thanh Phương","p":null,"t":"INDIVIDUAL","q":1360000,"pct":17.142,"d":"2015-09-14"},{"n":"Nguyễn Hoài Anh","p":null,"t":"INDIVIDUAL","q":643800,"pct":2.27,"d":"2019-02-12"},{"n":"Nguyễn Ngọc Vĩnh","p":null,"t":"INDIVIDUAL","q":35000,"pct":0.441,"d":"2015-09-14"},{"n":"Đặng Minh Huệ","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":390855,"pct":0.282,"d":"2026-08-24"},{"n":"Phạm Xuân Ưởng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":299522,"pct":0.216,"d":"2026-08-24"},{"n":"Nguyễn Hoàng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":220000,"pct":0.159,"d":"2026-08-24"},{"n":"Phan Tạ Thanh Huyền","p":"Kế toán trưởng","t":"INDIVIDUAL","q":81974,"pct":0.059,"d":"2026-08-24"},{"n":"Võ Đình Lượng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":60000,"pct":0.043,"d":"2026-08-24"},{"n":"Nguyễn Tuấn Minh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":50000,"pct":0.036,"d":"2026-02-13"},{"n":"Bùi Hoàng Phương","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.03,"d":"2025-10-05"},{"n":"Vũ Nhất","p":null,"t":"INDIVIDUAL","q":2270,"pct":0.029,"d":"2015-09-14"},{"n":"Đậu Ngọc Thanh","p":null,"t":"INDIVIDUAL","q":11500,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Thị Thu Nga","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":20000,"pct":0.014,"d":"2026-02-13"},{"n":"Trương Quang Minh","p":null,"t":"INDIVIDUAL","q":1086,"pct":0.014,"d":"2015-09-14"},{"n":"Đặng Thanh Huấn","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.013,"d":"2015-09-14"},{"n":"Nguyễn Thu Hà","p":null,"t":"INDIVIDUAL","q":55000,"pct":0.009,"d":"2025-10-05"},{"n":