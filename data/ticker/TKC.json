19",7.748],["2020",4.035],["2021",6.425],["2022",-333.286],["2023",0.0],["2024",0.0],["2025",0.0]]}},"co":{"short":"Địa ốc Tân Kỷ","profile":"Công ty cổ phần Xây dựng và Kinh doanh Địa ốc Tân Kỷ (TKC) tiền thân là công ty TNHH Xây dựng – Dịch vụ Tân Kỷ được thành lập năm 1999. Năm 2007, Công ty chính thức chuyển đổi thành Công ty Cổ phần. Lĩnh vực kinh doanh chính của công ty là: Xây dựng công nghiệp, xây dựng dân dụng và trang trì nội thất; Xây dựng cầu đường; Lập dự án đầu tư, tư vấn đầu tư, tư vấn đấu thầu. Thị trường kinh doanh chính của công ty bao gồm thành phố Hồ Chí Minh, Nha Trang, Đà Nẵng. Công ty đã trang bị đầy đủ các máy móc thiết bị thi công cơ giới, làm đất, nền đường, mặt đường, … cho thi công cầu đường. Các loại máy vận thăng, cẩu tháp, cắt thép, uốn thép, xoa, cán phẳng nền bêtông, …","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-12-01","state":0.0,"foreign":0.00340357,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Đại Nghĩa","p":null,"t":"INDIVIDUAL","q":1100000,"pct":10.25,"d":"2022-01-13"},{"n":"Quỹ Đầu Tư Tài Chính MKDS","p":null,"t":"CORPORATE","q":1524503,"pct":10.15,"d":"2025-10-05"},{"n":"Nguyễn Thị Thuận Vi","p":null,"t":"INDIVIDUAL","q":1486700,"pct":9.89,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư và Xây dựng COTEC","p":null,"t":"CORPORATE","q":400000,"pct":3.844,"d":"2015-06-15"},{"n":"Nguyễn Thanh Hằng","p":null,"t":"INDIVIDUAL","q":407576,"pct":3.581,"d":"2025-10-05"},{"n":"Nguyễn Uy Trường","p":null,"t":"INDIVIDUAL","q":372914,"pct":3.47,"d":"2025-10-05"},{"n":"Trần Văn Tuấn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":302901,"pct":2.82,"d":"2025-10-05"},{"n":"Trần Văn Nho","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":210547,"pct":1.96,"d":"2025-10-05"},{"n":"Trần Văn Sỹ","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":57157,"pct":0.38,"d":"2025-10-05"},{"n":"Phạm Thị Bạch Huệ","p":null,"t":"INDIVIDUAL","q":20700,"pct":0.19,"d":"2025-10-05"},{"n":"Công ty C