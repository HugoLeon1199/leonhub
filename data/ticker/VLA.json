nghệ Văn Lang","profile":"Công ty Cổ phần Đầu tư và Phát triển Công nghệ Văn Lang (VLA) là đơn vị thành viên của Nhà xuất bản Giáo dục Việt Nam thành lập năm 2007. Lĩnh vực hoạt động chính của Công ty là phát triển và cung cấp các sản phẩm, dịch vụ công nghệ thông tin. Bên cạnh đó, Công ty còn tham gia đầu tư tài chính, chứng khoán, kinh doanh bất động sản. Hiện tại Công ty là là đơn vị cung cấp các sản phẩm phần mềm phục vụ hoạt động sản xuất kinh doanh của các đơn vị trong toàn ngành giáo dục. Ngày 04/08/2010, VLA chính thức giao dịch tại Sở giao dịch Chứng khoán Hà Nội (HNX).","sector":"Công nghệ Thông tin","type":"CT","listed":"2010-08-04","state":0.0,"foreign":0.0160298,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đặng Trọng Khang","p":null,"t":"INDIVIDUAL","q":998260,"pct":24.98,"d":"2025-10-16"},{"n":"Nguyễn Thành Tiến","p":"Thành viên Hội đồng Quản trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":458170,"pct":11.47,"d":"2026-08-13"},{"n":"Nguyễn Hữu Thuận","p":"Phó Chủ tịch Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":399600,"pct":10.0,"d":"2026-08-13"},{"n":"Nguyễn Thu Hà","p":"Phó Tổng Giám đốc/Phó Giám đốc","t":"INDIVIDUAL","q":375347,"pct":9.39,"d":"2026-08-13"},{"n":"Lê Anh Nguyên","p":null,"t":"INDIVIDUAL","q":58700,"pct":5.435,"d":"2015-09-14"},{"n":"Công ty Cổ Phần Ci Holding","p":null,"t":"CORPORATE","q":198000,"pct":4.95,"d":"2025-10-16"},{"n":"Trần Thị Thanh Hoa","p":null,"t":"INDIVIDUAL","q":176120,"pct":4.41,"d":"2026-08-13"},{"n":"Nguyễn Văn Thọ","p":null,"t":"INDIVIDUAL","q":160950,"pct":4.03,"d":"2026-08-13"},{"n":"Vũ Thị Hiền Nhung","p":null,"t":"INDIVIDUAL","q":120620,"pct":3.02,"d":"2026-08-13"},{"n":"Trần Quang Thịnh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":95090,"pct":2.37,"d":"2026-08-13"},{"n":"Nguyễn Văn Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":13810,"pct":0.34,"d":"2026-08-13"},{"n":"Nguyễn Thị Tâm","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":1