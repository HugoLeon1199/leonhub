ành phố Hồ Chí Minh với các dự án tiêu biểu như các dự án nhà thấp tầng (biệt thự, liền kế) Goldora Villa, Mega Ruby, Mega Village, The Venica, Lucasta và dự án căn hộ Jamila. KDH được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Bất động sản","type":"CT","listed":"2010-02-01","state":0.0,"foreign":0.24351914,"rating":"BUY","target":31700.0,"rating_as_of":"2026-08-28","source":"Vietcap"},"owners":[{"n":"Vinacapital Vietnam Opportunity Fund Ltd.","p":null,"t":"CORPORATE","q":72985305,"pct":13.913,"d":"2020-06-18"},{"n":"Công ty CP Đầu Tư Tiên Lộc","p":null,"t":"CORPORATE","q":126068574,"pct":11.23,"d":"2026-08-10"},{"n":"Công ty TNHH Đầu tư Tiến Lộc","p":null,"t":"CORPORATE","q":71552815,"pct":11.13,"d":"2022-08-03"},{"n":"Công ty Cổ phần Dịch Vụ Tư Vấn Đầu Tư Gam Ma","p":null,"t":"CORPORATE","q":70015669,"pct":8.76,"d":"2025-10-05"},{"n":"Công ty CP Đầu Tư Thương Mại Á Âu","p":null,"t":"CORPORATE","q":69703798,"pct":8.72,"d":"2025-10-05"},{"n":"Vietnam Enterprise Limited","p":null,"t":"CORPORATE","q":67683856,"pct":6.03,"d":"2026-02-02"},{"n":"CTBC Vietnam Equity Fund","p":null,"t":"CORPORATE","q":28400000,"pct":3.553,"d":"2025-10-05"},{"n":"Mai Trần Thanh Trang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":31402548,"pct":2.8,"d":"2026-08-10"},{"n":"Lý Tuấn Kiệt","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":20623635,"pct":1.838,"d":"2026-08-24"},{"n":"Đoàn Thị Nguyên","p":null,"t":"INDIVIDUAL","q":17829383,"pct":1.59,"d":"2026-08-10"},{"n":"Vietnam Holding Ltd","p":null,"t":"CORPORATE","q":7418567,"pct":1.414,"d":"2020-07-14"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":14919449,"pct":1.329,"d":"2026-06-16"},{"n":"Veil Holdings Limited","p":null,"t":"CORPORATE","q":14246124,"pct":1.27,"d":"2026-06-16"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":13453935,"pct":1.199,"d":"2026-06-16"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":13405418,"pct":1.