, QNW còn tham gia thiết kế, đầu tư, thi công các công trình cấp thoát nước. Công ty chính thức hoạt động theo mô hình công ty cổ phần vào tháng 02/2010. QNW hiện đang quản lý và vận hành hệ thống sản xuất nước sạch với công suất 20.000m3/ngày đêm. QNW được giao dịch trên thị trường UPCOM từ cuối năm 2016.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2016-12-26","state":0.2335594,"foreign":5e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Hoàng Thịnh Đạt","p":null,"t":"CORPORATE","q":13327012,"pct":66.64,"d":"2026-07-28"},{"n":"Ủy Ban Nhân Dân Tỉnh Quảng Ngãi","p":null,"t":"CORPORATE","q":4671188,"pct":23.36,"d":"2026-07-28"},{"n":"Hoàng Nguyệt Hà","p":null,"t":"INDIVIDUAL","q":992000,"pct":4.96,"d":"2026-07-28"},{"n":"Hoàng Văn Thắng","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":190000,"pct":0.95,"d":"2026-07-28"},{"n":"Nguyễn Thanh Tùng","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":6800,"pct":0.034,"d":"2026-07-28"},{"n":"Lê Thị Hoài An","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":3000,"pct":0.02,"d":"2026-07-28"},{"n":"VÕ XUÂN VŨ","p":null,"t":"INDIVIDUAL","q":3700,"pct":0.018,"d":"2025-10-05"},{"n":"Nguyễn Đăng Đơ","p":"Thành viên Hội đồng Quản trị/Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":3100,"pct":0.015,"d":"2026-07-28"},{"n":"Phạm Đình Tùng","p":"Phó Giám đốc","t":"INDIVIDUAL","q":2500,"pct":0.013,"d":"2026-08-10"},{"n":"Bùi Hải Ninh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.01,"d":"2026-07-28"}],"rel":[{"c":"4300860331","n":"Công Ty TNHH Một Thành Viên Xây Lắp Hạ Tầng Quảng Ngãi","t":"subsidiary","pct":100.0},{"c":"11106","n":"Công ty TNHH Cấp Nước Dung Quất","t":"subsidiary","pct":60.0}],"rel_count":2,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,290 VND","d":"2026-07-10","record":"2026-07-20","ex":"2026-07-17"},{"c":"AGME","t":"QNW - Tổ chức ĐHĐCĐ thường niên 2026","d":"20