,18.325],["2026-Q1",19.33],["2026-Q2",21.531]],"y":[["2018",26.556],["2019",26.026],["2020",22.262],["2021",15.094],["2022",21.456],["2023",14.555],["2024",17.855],["2025",18.325]]}},"co":{"short":"SABECO","profile":"Tổng công ty cổ phần Bia – Rượu – Nước giải khát Sài Gòn (SAB) có tiền thân là một xưởng bia nhỏ do người Pháp thành lập vào năm 1875. SABECO hoạt động chính trong ngành sản xuất bia và các loại nước giải khát. SABECO hiện có 26 nhà máy với tổng công suất sản xuất đạt trên 2,4 tỷ lít bia/năm. SABECO sở hữu công nghệ sản xuất hiện đại, nhập khẩu từ các hãng sản xuất thiết bị chuyên dùng cho ngành bia hàng đầu thế giới tại Châu Âu như Krones AG, KHS... Sản phẩm bia của SABECO được xuất khấu tới hơn 40 nước trên thế giới. SAB chính thức được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ cuối năm 2016.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2016-12-06","state":0.36002389,"foreign":0.58857631,"rating":"BUY","target":59000.0,"rating_as_of":"2026-01-06","source":"Vietcap"},"owners":[{"n":"Công ty TNHH Vietnam Beverage","p":null,"t":"CORPORATE","q":687285174,"pct":53.59,"d":"2026-08-03"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":461753094,"pct":36.0,"d":"2026-08-03"},{"n":"Quỹ Đầu tư Cổ phiếu Manulife","p":null,"t":"CORPORATE","q":26890,"pct":0.004,"d":"2020-07-14"},{"n":"Quỹ ETF SSIAM VNX50","p":null,"t":"CORPORATE","q":13500,"pct":0.002,"d":"2020-07-14"},{"n":"Quỹ Đầu tư Cổ phiếu Năng động Bảo Việt","p":null,"t":"CORPORATE","q":7120,"pct":0.001,"d":"2020-07-14"},{"n":"Quỹ Đầu tư Tăng trưởng DFVN","p":null,"t":"CORPORATE","q":9200,"pct":0.001,"d":"2020-07-14"},{"n":"Trần Nguyên Trung","p":"Kế toán trưởng","t":"INDIVIDUAL","q":3400,"pct":0.0,"d":"2026-08-03"}],"rel":[{"c":"BIASGHT","n":"Công Ty TNHH Một Thành Viên Bia Sài Gòn - Hà Tĩnh","t":"subsidiary","pct":100.0},{"c":"SABECO","n":"Công Ty TNHH Một Thành Viên Cơ Khí Sa Be Co","t":"subsidiary","pct":100.0},{"c":"SG