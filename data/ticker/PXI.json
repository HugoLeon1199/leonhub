hị trường tại tỉnh Bà Rịa - Vũng tàu và Thành phố Hồ Chí Minh. Công ty là thành viên của Tập đoàn Dầu khí Quốc gia Việt Nam nên có được một lượng lớn khách hàng sẵn có thông qua các công ty có liên quan và công ty thành viên trong Tập đoàn. Công ty có hệ thống máy móc, thiết bị thi công hiện đại, có thể thi công xây dựng nhà cao tầng đến trên 30 tầng như cầu tháp, máy trộn bê tông, máy bơm bê tông, máy trắc địa, máy phát điện, máy hàn, hệ thống giàn giáo cốp pha... Ngày 19/05/2022, PXI chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-21","state":0.0,"foreign":0.00165533,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xây lắp Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":15300000,"pct":51.0,"d":"2026-08-06"},{"n":"Công ty TNHH Đầu tư và Phát triển Bất động sản EZ","p":null,"t":"CORPORATE","q":3000000,"pct":10.0,"d":"2015-06-15"},{"n":"Lê Duy Chỉnh","p":null,"t":"INDIVIDUAL","q":1483999,"pct":4.947,"d":"2025-10-05"},{"n":"Hồ Sỹ Hoàng","p":null,"t":"INDIVIDUAL","q":54700,"pct":0.182,"d":"2025-10-05"},{"n":"Hồ Sỹ Hoàng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":54700,"pct":0.182,"d":"2021-09-02"},{"n":"Hà Quốc Hải","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.067,"d":"2015-09-14"},{"n":"Nguyễn Trọng Kha","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.067,"d":"2015-09-14"},{"n":"Vũ Thị Yến Hà","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.067,"d":"2015-09-14"},{"n":"Nguyễn Khoa","p":null,"t":"INDIVIDUAL","q":18400,"pct":0.061,"d":"2015-09-14"},{"n":"Phạm Chu Tứ","p":null,"t":"INDIVIDUAL","q":17000,"pct":0.057,"d":"2025-10-05"},{"n":"Mai Xuân Bình","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.033,"d":"2015-09-14"},{"n":"Nguyễn Duy Hưng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.033,"d":"2015-09-14"},{"n":"Nguyễn Thị Hoan","p":null,"t":"INDIVIDUAL","q":9750,"pct":0.033,"d":"2015-09-14"},{"n":"Bùi Văn Đấu","p":null,"t":"INDIVIDUAL","q":7850,"pct":0.02