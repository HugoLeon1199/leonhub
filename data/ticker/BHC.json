ược thành lập năm 1968. Công ty là thành viên liên kết của Tổng Công ty xây dựng số 1, chuyên sản xuất các loại sản phẩm bê tông công nghiệp có chất lượng cao với 40 năm kinh nghiệm trong ngành bê tông. Sản phẩm chính của nhà máy là bê tông trộn sẵn, bê tông đúc sẵn và bê tông li tâm. Hiện tại Công ty đang sở hữu 3 Nhà máy sản xuất bê tông: Nhà máy tại Khu Công nghiệp Biên Hòa 1 nằm trong vùng kinh tế trọng điểm phía Nam, Nhà máy bê tông Tân Hòa tại Bà Rịa-Vũng Tàu, Nhà máy bê tông An Hoàn tại Khu công nghiệp Nhật Chánh nằm ở cửa ngõ phía Tây thành phố Hồ Chí Minh. BHC được giao dịch trên thị trường UPCoM từ năm 2015.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-05-15","state":0.0,"foreign":0.00202222,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Quốc Lập","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":920641,"pct":20.46,"d":"2026-07-20"},{"n":"Đặng Văn Hoan","p":null,"t":"INDIVIDUAL","q":920641,"pct":20.46,"d":"2025-10-21"},{"n":"Nguyễn Văn Sơn","p":null,"t":"INDIVIDUAL","q":631688,"pct":14.04,"d":"2025-12-03"},{"n":"Đàm Thanh Long","p":null,"t":"INDIVIDUAL","q":225100,"pct":5.0,"d":"2025-10-05"},{"n":"Phạm Hùng","p":null,"t":"INDIVIDUAL","q":21000,"pct":0.467,"d":"2015-09-14"},{"n":"Nguyễn Thị Ngọc Dung","p":null,"t":"INDIVIDUAL","q":14529,"pct":0.323,"d":"2015-09-14"},{"n":"Hoàng Xuân Lộc","p":null,"t":"INDIVIDUAL","q":2423,"pct":0.054,"d":"2015-09-14"}],"events":[{"c":"EGME","t":"BHC - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-07-20","record":"2026-08-05","ex":"2026-08-04"},{"c":"AGME","t":"BHC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-04","record":"2026-05-14","ex":"2026-05-13"},{"c":"AGME","t":"BHC - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-24","record":"2025-04-09","ex":"2025-04-08"},{"c":"DDIND","t":"Đàm Thanh Long - Đăng kí Mua BHC","d":"2025-02-24","record":null,"ex":null},{"c":"AGME","t":"BHC - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-04-10","record":"2024-04-25","ex":"2024-04-24"