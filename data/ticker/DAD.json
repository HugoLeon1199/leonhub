ác tỉnh Miền Trung như: Quảng Bình, Quảng Trị, Thừa Thiên Huế, Đà Nẵng, Quảng Nam, Quảng Ngãi, Bình Định, Gia Lai, Kon Tum, Phú Yên, Khánh Hoà... Ngày 19/08/2009, DAD chính thức giao dịch trên Sở giao dịch Chứng khoán Hà Nội (HNX).","sector":"Truyền thông","type":"CT","listed":"2009-08-19","state":0.415,"foreign":0.2797808,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Nhà Xuất Bản Giáo Dục Việt Nam","p":null,"t":"CORPORATE","q":2075000,"pct":41.5,"d":"2025-10-05"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":880100,"pct":18.89,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư tài chính Thiên Hóa","p":null,"t":"CORPORATE","q":191100,"pct":3.822,"d":"2015-06-15"},{"n":"Hồ Văn Lĩnh","p":null,"t":"INDIVIDUAL","q":60100,"pct":1.29,"d":"2019-01-29"},{"n":"Hoàng Quốc Hiệp","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":39300,"pct":0.79,"d":"2026-03-04"},{"n":"Trần Thị Kim Hương","p":null,"t":"INDIVIDUAL","q":19205,"pct":0.412,"d":"2015-09-14"},{"n":"Lê Ngọc","p":"Kế toán trưởng","t":"INDIVIDUAL","q":18000,"pct":0.36,"d":"2026-03-04"},{"n":"Huỳnh Ngọc Bảo","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":17600,"pct":0.35,"d":"2026-03-04"},{"n":"Nguyễn Quang Dũng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":14800,"pct":0.3,"d":"2026-03-04"},{"n":"Phạm Văn An","p":null,"t":"INDIVIDUAL","q":7500,"pct":0.161,"d":"2015-09-14"},{"n":"Lê Hồng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.1,"d":"2026-03-04"},{"n":"Trần Công Hội","p":null,"t":"INDIVIDUAL","q":3101,"pct":0.067,"d":"2015-09-14"}],"rel":[{"c":"BDB","n":"Công ty Cổ phần Sách và Thiết bị Bình Định","t":"affiliate","pct":25.92},{"c":"DAPRICO","n":"Công ty Cổ phần In và Dịch vụ Đà Nẵng","t":"affiliate","pct":20.0}],"rel_count":2,"events":[{"c":"AGME","t":"DAD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-20","record":"2026-05-07","ex":"2026-05-06"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2025 