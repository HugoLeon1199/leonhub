ực của công ty. Công ty là chủ đầu tư xây dựng dự án Khu công nghiệp Tây Bắc Củ Chi và hiện tại đang là đơn vị khai thác, quản lý. Năm 2010, CCI chính thức được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2010-04-15","state":0.25751455,"foreign":0.01354285,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Đầu tư Tài chính Nhà nước Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":6075000,"pct":25.975,"d":"2026-05-28"},{"n":"Tổng Công ty Cổ phần Bảo hiểm Hùng Vương","p":null,"t":"CORPORATE","q":2163730,"pct":9.25,"d":"2026-04-23"},{"n":"Đoàn Minh Duy","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1821984,"pct":7.7,"d":"2026-08-28"},{"n":"Đặng Thị Mai Thi","p":null,"t":"INDIVIDUAL","q":1189840,"pct":5.08,"d":"2026-04-23"},{"n":"Công ty Cổ Phần Đầu Tư Gia Thy","p":null,"t":"CORPORATE","q":1115960,"pct":4.77,"d":"2026-04-23"},{"n":"Công ty TNHH Xây Dựng - Thương Mại Thuận Việt","p":null,"t":"CORPORATE","q":1096875,"pct":4.69,"d":"2026-05-28"},{"n":"Công ty Xăng Dầu Khu Vực II","p":null,"t":"CORPORATE","q":900000,"pct":3.848,"d":"2026-05-28"},{"n":"Phan Hoàng Tuấn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":695813,"pct":2.97,"d":"2026-04-23"},{"n":"Lâm Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":360000,"pct":1.15,"d":"2026-04-29"},{"n":"Phan Văn Tới","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":202493,"pct":0.87,"d":"2026-04-29"},{"n":"Phan Thị Thanh Xuân","p":null,"t":"INDIVIDUAL","q":189000,"pct":0.81,"d":"2026-04-29"},{"n":"Tống Huy Cường","p":"Phó Giám đốc Điều hành","t":"INDIVIDUAL","q":55179,"pct":0.24,"d":"2026-05-18"},{"n":"Trần Tấn Trung","p":null,"t":"INDIVIDUAL","q":18000,"pct":0.136,"d":"2015-09-14"},{"n":"Công đoàn Cơ sở thành viên Công ty Cổ phần Đầu tư Phát triển Công nghiệp Thương mại Củ Chi","p":null,"t":"CORPORATE","q":31053,"pct":0.13,"d":"2026-05-18"},{"n":"Trần Hữu Nghĩa",