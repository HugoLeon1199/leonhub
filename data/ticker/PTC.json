 dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-12-15","state":0.0,"foreign":0.00471645,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Võ Anh Linh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":11494680,"pct":35.58,"d":"2026-07-30"},{"n":"Phạm Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":2900000,"pct":8.98,"d":"2026-07-30"},{"n":"Công ty Cổ phần Tập đoàn đầu tư tài chính toàn cầu","p":null,"t":"CORPORATE","q":1100000,"pct":6.111,"d":"2015-06-15"},{"n":"Công ty Tài Chính TNHH MTV Bưu Điện","p":null,"t":"CORPORATE","q":157800,"pct":0.877,"d":"2015-06-15"},{"n":"Nguyễn Công Vinh","p":null,"t":"INDIVIDUAL","q":157800,"pct":0.877,"d":"2015-09-14"},{"n":"Nguyễn Phong","p":null,"t":"INDIVIDUAL","q":114880,"pct":0.638,"d":"2015-09-14"},{"n":"Lê Đỗ Vinh","p":null,"t":"INDIVIDUAL","q":56190,"pct":0.312,"d":"2015-09-14"},{"n":"Nguyễn Duy Bắc Việt","p":null,"t":"INDIVIDUAL","q":40360,"pct":0.224,"d":"2015-09-14"},{"n":"Phạm Thị Thau","p":null,"t":"INDIVIDUAL","q":17750,"pct":0.099,"d":"2015-09-14"},{"n":"Đỗ Đức Thịnh","p":null,"t":"INDIVIDUAL","q":13000,"pct":0.072,"d":"2015-09-14"},{"n":"Nguyễn Lê Văn","p":null,"t":"INDIVIDUAL","q":9460,"pct":0.053,"d":"2015-09-14"},{"n":"Lê Cao Điền","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.006,"d":"2015-09-14"}],"rel":[{"c":"POST","n":"Công ty Cổ phần Khách sạn bưu điện Nha Trang","t":"affiliate","pct":48.98},{"c":"12118","n":"Công ty Cổ phần Điện gió Hướng Linh 7","t":"affiliate","pct":32.81}],"rel_count":2,"events":[{"c":"OTHE","t":"PTC - Thay đổi địa chỉ","d":"2026-06-05","record":null,"ex":null},{"c":"AGME","t":"PTC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-07","record":"2026-04-20","ex":"2026-04-17"},{"c":"AGME","t":"PTC - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-27","record":"2025-04-16","ex":"2025-04-15"},{"c":"DDIND","t":"Võ Anh Linh - Đăng kí Mua 6,687,000 PTC","d":"2024-04-01","record":null,"ex":null},{"c":"AGME","t":"PT