 theo mô hình công ty cổ phần. Công ty chuyên sản xuất, kinh doanh, xuất khẩu các kết cấu, cấu kiện thép, sản phẩm cơ khí. Công ty quản lý vận hành nhà máy thép hiện đại với quy mô 48.000 tấn/năm. Bên cạnh đó, Công ty tìm kiếm các dự án, cơ hội kinh doanh trong các lĩnh vực đầu tư, dịch vụ tài chính, mua bán sáp nhập (M&A), kinh doanh bất động sản và khai khoáng. BVG được giao dịch trên thị trường UPCOM từ năm 2015.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2010-08-09","state":0.0,"foreign":0.00092873,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty TNHH Một Thành Viên King Invest","p":null,"t":"CORPORATE","q":515000,"pct":5.28,"d":"2026-08-11"},{"n":"Ngô Văn Khoa","p":null,"t":"INDIVIDUAL","q":489200,"pct":5.02,"d":"2025-10-05"},{"n":"Nguyễn Minh Thắng","p":null,"t":"INDIVIDUAL","q":450000,"pct":4.61,"d":"2025-10-05"},{"n":"Phạm Cương","p":null,"t":"INDIVIDUAL","q":170000,"pct":1.743,"d":"2015-09-14"},{"n":"Nguyễn Hữu Bảo","p":null,"t":"INDIVIDUAL","q":126000,"pct":1.292,"d":"2015-09-14"},{"n":"Đặng Đức Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":116000,"pct":1.19,"d":"2026-08-11"},{"n":"Lê Văn Thuyên","p":null,"t":"INDIVIDUAL","q":102734,"pct":1.054,"d":"2015-09-14"},{"n":"Vũ Hữu Trí","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.51,"d":"2025-10-05"},{"n":"Lê Quốc Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":44404,"pct":0.455,"d":"2026-08-11"},{"n":"Trần Thị Thu Lệ","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":88,"pct":0.001,"d":"2026-08-11"}],"events":[{"c":"AGME","t":"BVG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-02","record":"2026-03-06","ex":"2026-03-05"},{"c":"AGME","t":"BVG - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-24","record":"2025-03-12","ex":"2025-03-11"},{"c":"AGME","t":"BVG - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-06","record":"2024-03-19","ex":"2024-03-18"},{"c":"AGME","t":"BVG - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-02-22","record":"2023-03-09