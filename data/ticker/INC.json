018-Q1",10.216],["2018-Q2",8.059],["2018-Q3",8.345],["2018-Q4",8.157],["2019-Q1",7.515],["2019-Q2",9.093],["2019-Q3",9.737],["2019-Q4",9.544],["2020-Q1",10.654],["2020-Q2",13.604],["2020-Q3",12.89],["2020-Q4",10.285],["2021-Q1",10.881],["2021-Q3",10.741],["2022-Q1",12.489],["2022-Q2",12.526],["2022-Q3",14.307],["2022-Q4",12.668],["2023-Q1",10.794],["2023-Q2",10.452],["2023-Q3",9.286],["2023-Q4",9.822],["2024-Q1",9.354],["2024-Q2",5.854],["2024-Q3",4.7],["2024-Q4",3.701],["2025-Q1",3.642],["2025-Q2",6.986],["2025-Q3",8.509],["2025-Q4",5.045],["2026-Q1",5.651],["2026-Q2",4.73]],"y":[["2018",8.157],["2019",9.544],["2020",10.285],["2021",12.524],["2022",12.668],["2023",9.822],["2024",3.701],["2025",5.045]]}},"co":{"short":"Tư vấn Đầu tư IDICO","profile":"Công ty Cổ phần Tư vấn Đầu tư IDICO (INC), tiền thân Trung tâm Khoa học Công nghệ và Tư vấn Đầu tư Xây dựng, được thành lập vào năm 2002. Công ty chính thức cổ phần hóa vào năm 2007. Hoạt động kinh doanh chính của Công ty là khảo sát xây dựng, thiết kế - quy hoạch, giám sát và quản lý dự án, thí nghiệm xây dựng. Công ty hoạt động chủ yếu tại các tỉnh miền Tây Nam bộ như Bình Thuận, Đồng Nai, Bình Dương, Lâm Đồng. Công ty là đơn vị trực thuộc Tổng Công ty Đầu tư phát triển đô thị và khu Công nghiệp VN, do vây luôn được ưu tiên giao thầu thực hiện công tác tư vấn các dự án lớn do Tổng Công ty làm chủ đầu tư. Với thế mạnh quy hoạch, xây dựng, thiết kế công trình... INC đã thực hiện được rất nhiều các hạng mục công trình trong và ngoài địa bàn kinh doanh thu về doanh thu lớn. Một số các công trình tiêu biểu như sau: Lập dự án đầu tư xây dựng và kinh doanh hạ tầng kỹ thuật Khu Công nghiệp Sơn Mỹ 1 (Bình Thuận); Hệ thống thoát nước và xử lý nước thải giai đoạn 1 tại thị trấn Vĩnh An - Huyện Vĩnh Cửu...Ngày 14/07/2011, INC chính thức giao dịch trên Sàn Giao dịch chứng khoán Hà Nội (HNX)","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2011-07-14","state":0.44,"foreign":0.0585625,"rating":null,"target":null,"rating_as_of"