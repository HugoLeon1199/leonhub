hành lập năm 1995. ELC chính thức chuyển đổi hoạt động theo mô hình công ty cổ phần từ năm 2003. Công ty hiện là nhà cung cấp các sản phẩm phần mềm và hệ thống cho các nhà cung cấp dịch vụ mạng, cung cấp các giải pháp chìa khóa trao tay và các dịch vụ kỹ thuật cho ngành Viễn thông và An ninh. Hoạt động của công ty bao hồm hoạt động thương mại đại lý, sản xuất phần mềm và tích hợp phần mềm. Ngoài ra công ty đang sở hữu một số dự án bất động sản và khai khoáng có giá trị cao. Công ty là đơn vị đầu tiên tại Việt Nam cũng như trên thế giới nghiên cứu thành công trong việc đưa ra giải pháp hệ thống hội nghị truyền hình qua công nghệ nén MPEG, cũng như các giải pháp hội nghị truyền hình trên nền 4G, 5G. Các đối thủ cạnh tranh lớn của công ty là Huawei, ZTE (Trung Quốc), NEO, FPT, Siseo (Mỹ). ELC được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Công nghệ Thông tin","type":"CT","listed":"2010-10-13","state":0.0,"foreign":0.03151515,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phan Chiến Thắng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5577513,"pct":5.07,"d":"2026-08-24"},{"n":"Vietnam Equity Holding","p":null,"t":"CORPORATE","q":2515002,"pct":4.97,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán SSI","p":null,"t":"CORPORATE","q":2512021,"pct":4.96,"d":"2025-10-05"},{"n":"Nguyễn Mạnh Hải","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5455259,"pct":4.96,"d":"2026-08-03"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":2499557,"pct":4.94,"d":"2025-10-05"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":2501922,"pct":4.94,"d":"2025-10-05"},{"n":"Trần Hùng Giang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5239518,"pct":4.76,"d":"2026-07-14"},{"n":"Quỹ tầm nhìn SSI","p":null,"t":"CORPORATE","q":1819312,"pct":4.44,"d":"2015-06-15"},{"n":"Ngô Ngọc Hà","p":"Thành viên Hội đồng Quản trị/Trưởng Ban Kiểm toán nội bộ","t":"INDIVID