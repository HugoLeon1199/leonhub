. Công ty có 1 thị trường rộng lớn bao phủ nhiều nước như: Hàn Quốc, Trung Quốc, Bungari, Cuba, Thái Lan, Đài Loan… Công ty cũng liên kết, hợp tác với các đối tác nước ngoài từ nhiều nước trên thế giới như Mỹ, Nhật Bản, Thụy Sỹ, Trung Quốc, Nga, Phần Lan… Một số sản phẩm nhập khẩu của công ty như: Máy xúc bánh xích PC450LC-7 và PC1250-7, Máy ủi bánh xích D85EX-15, Xe tải A40E…CLM được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2016.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2016-04-15","state":0.55412538,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Công nghiệp Than - Khoáng sản Việt Nam","p":null,"t":"CORPORATE","q":6095348,"pct":55.41,"d":"2026-08-27"},{"n":"Nguyễn Văn Cứ","p":null,"t":"INDIVIDUAL","q":502673,"pct":4.56,"d":"2026-02-13"},{"n":"Nguyễn Thái Hà","p":null,"t":"INDIVIDUAL","q":260718,"pct":2.37,"d":"2026-02-13"},{"n":"Nguyễn Thị Lợi","p":null,"t":"INDIVIDUAL","q":212749,"pct":1.93,"d":"2026-02-13"},{"n":"Đinh Thị Vân","p":null,"t":"INDIVIDUAL","q":119488,"pct":1.09,"d":"2026-02-13"},{"n":"Lê Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":76608,"pct":0.696,"d":"2026-03-27"},{"n":"Trần Xuân Hòa","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":59744,"pct":0.543,"d":"2026-08-26"},{"n":"Bùi Thị Minh Thư","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":52515,"pct":0.477,"d":"2026-08-26"},{"n":"Hoàng Đức Phương","p":null,"t":"INDIVIDUAL","q":47339,"pct":0.43,"d":"2025-10-05"},{"n":"Nguyễn Thanh Hải","p":null,"t":"INDIVIDUAL","q":37040,"pct":0.34,"d":"2025-10-05"},{"n":"Nguyễn Thanh Nga","p":null,"t":"INDIVIDUAL","q":18410,"pct":0.167,"d":"2025-10-05"},{"n":"Nguyễn Thị Quỳnh Ngân","p":"Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":16500,"pct":0.15,"d":"2026-08-26"},{"n":"Phạm Minh","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":17533,"pct":0.15,"d":"2026-08-26"},{"n":"Nguyễn Mạnh Điệp","p":"Thành viên Hội đồng Quản tr