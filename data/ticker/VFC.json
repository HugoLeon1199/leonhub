n tại, công ty chỉ hoạt động kinh doanh trên lãnh thổ Việt Nam. VFC được niêm yết trên thị trường Upcom từ năm 2013.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-06-26","state":0.0,"foreign":0.44680582,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Logistics Asg","p":null,"t":"CORPORATE","q":17437281,"pct":51.59,"d":"2026-08-19"},{"n":"The Shibusawa Warehouse Ltd.","p":null,"t":"CORPORATE","q":15166718,"pct":44.61,"d":"2025-10-05"},{"n":"Nguyễn Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":55790,"pct":0.165,"d":"2015-09-14"},{"n":"Vũ Tuấn Hưng","p":null,"t":"INDIVIDUAL","q":22196,"pct":0.07,"d":"2025-10-05"},{"n":"Nguyễn Phương Mai","p":null,"t":"INDIVIDUAL","q":11129,"pct":0.033,"d":"2015-09-14"},{"n":"Nguyễn Thị Minh Thuần","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.01,"d":"2025-10-05"},{"n":"Phạm Lê Vân Anh","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.009,"d":"2015-09-14"},{"n":"Dương Thị Luyến","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.003,"d":"2015-09-14"},{"n":"Nguyễn Phương Khanh","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.003,"d":"2015-09-14"}],"rel":[{"c":"3701833950","n":"Công ty TNHH MTV Vinafco Bình Dương","t":"subsidiary","pct":100.0},{"c":"VNCDN","n":"Công ty TNHH MTV Vinafco Đà Nẵng","t":"subsidiary","pct":100.0},{"c":"VNCLC","n":"Công ty TNHH Tiếp Vận Vinafco","t":"subsidiary","pct":100.0},{"c":"VNCDV","n":"Công ty TNHH Tiếp Vận Vinafco Đình Vũ","t":"subsidiary","pct":100.0},{"c":"VNCTSC","n":"Công ty TNHH Vận Tải Và Dịch Vụ Vinafco","t":"subsidiary","pct":100.0},{"c":"3100943814","n":"Công ty TNHH Vận Tải Và Dịch Vụ Vinafco Miền Trung","t":"subsidiary","pct":100.0},{"c":"VNCS","n":"Công ty Cổ Phần Vận Tải Biển Vinafco","t":"subsidiary","pct":90.12},{"c":"2813889","n":"Công ty Cổ phần Cảng Xanh Vinafco","t":"subsidiary","pct":45.96}],"rel_count":8,"events":[{"c":"AGME","t":"VFC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-28","record":"2026-05-12","ex":"2026-05-11"},{"c":"DIV","t