gân hàng Công thương. Ngoài ra, còn có thể kể đến dự án khu đô thị Hồng Hà Eco City, khu biệt thự Quảng An (Tây Hồ, Hà Nội), toà nhà văn phòng 407 Nguyễn An Ninh (Vũng Tàu)... Ngày 17/03/2010, PHH chính thức được giao dịch tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-03-17","state":0.0,"foreign":0.00439595,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thị Huyền Trang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3575600,"pct":19.75,"d":"2025-10-05"},{"n":"Trương Mỹ Hạnh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2511496,"pct":13.88,"d":"2025-10-05"},{"n":"Nguyễn Thị Thúy Huyền","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2486770,"pct":13.74,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư và Quản lý mặt bằng Hà Nội","p":null,"t":"CORPORATE","q":2138300,"pct":11.81,"d":"2025-10-05"},{"n":"Trần Thị Thanh Bình","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000000,"pct":5.52,"d":"2025-10-05"},{"n":"Asean Small Cap Fund","p":null,"t":"CORPORATE","q":916900,"pct":4.584,"d":"2015-06-15"},{"n":"Tổng Công ty Cổ phần Xây lắp Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":891200,"pct":4.46,"d":"2025-10-05"},{"n":"Trần Tùng Anh","p":null,"t":"INDIVIDUAL","q":753800,"pct":4.165,"d":"2015-09-14"},{"n":"Tổng Công ty Cổ phần Bảo hiểm Bưu điện","p":null,"t":"CORPORATE","q":273930,"pct":1.51,"d":"2025-10-05"},{"n":"Nguyễn Văn Thanh","p":null,"t":"INDIVIDUAL","q":135700,"pct":0.75,"d":"2025-10-05"},{"n":"Phạm Vinh Hiển","p":null,"t":"INDIVIDUAL","q":109996,"pct":0.608,"d":"2015-09-14"},{"n":"Lê Quang Việt","p":null,"t":"INDIVIDUAL","q":85700,"pct":0.473,"d":"2015-09-14"},{"n":"Bùi Thị Hải","p":null,"t":"INDIVIDUAL","q":61000,"pct":0.34,"d":"2025-10-05"},{"n":"Nguyễn Phúc Thịnh","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.276,"d":"2015-09-14"},{"n":"TRỊNH THANH GIẢNG","p":null,"t":"INDIVIDUAL","q":39000,"pct":0.21