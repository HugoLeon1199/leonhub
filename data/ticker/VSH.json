,["2025",15.153]]}},"co":{"short":"Thủy điện Vĩnh Sơn - Sông Hinh","profile":"Công ty Cổ phần Thủy điện Vĩnh Sơn - Sông Hinh (VSH) có tiền thân là Nhà máy Thuỷ điện Vĩnh Sơn trực thuộc Công ty Điện Lực III được thành lập vào năm 1994. Hoạt động kinh doanh chính là sản xuât và kinh doanh điện năng, dịch vụ quản lý, vận hành bảo dưỡng các nhà máy thủy điện, tư vấn quản lý dự án, giám sát thi công các nhà máy thủy điện. VSH chính thức hoạt động theo mô hình công ty cổ phần từ năm 2005. Công ty hiện đang quản lý vận hành Nhà máy Thủy điện Vĩnh Sơn, Nhà máy Thủy điện Sông Hinh và nhà máy thủy điện Thượng Kon Tum với tổng công suất lắp đặt 356MW. VSH được giao dịch tại Trung tâm Giao dịch Chứng khoán Thành phố Hồ Chí Minh (nay là Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh) từ năm 2006.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2006-07-18","state":0.30554804,"foreign":0.01185647,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Năng Lượng Ree","p":null,"t":"CORPORATE","q":124212978,"pct":52.58,"d":"2026-07-27"},{"n":"Tổng Công ty Phát điện 3 - Công ty Cổ phần","p":null,"t":"CORPORATE","q":72183049,"pct":30.55,"d":"2026-07-27"},{"n":"Công ty Cổ phần Quản Lý Quỹ Đầu Tư Đỏ","p":null,"t":"CORPORATE","q":2640000,"pct":1.12,"d":"2025-11-25"},{"n":"Đặng Thị Hồng Phương","p":null,"t":"INDIVIDUAL","q":1000000,"pct":0.485,"d":"2015-09-14"},{"n":"Nguyễn Đức Đối","p":null,"t":"INDIVIDUAL","q":453160,"pct":0.22,"d":"2015-09-14"},{"n":"Võ Thành Trung","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":298242,"pct":0.13,"d":"2026-07-27"},{"n":"Trần Lê Cảnh","p":null,"t":"INDIVIDUAL","q":71370,"pct":0.035,"d":"2015-09-14"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":38700,"pct":0.02,"d":"2025-10-23"},{"n":"Đỗ Phong Thu","p":null,"t":"INDIVIDUAL","q":27500,"pct":0.013,"d":"2015-09-14"},{"n":"Dương Tấn Tưởng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":