ơng mại. Ngày 05/10/2011, SVT chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bán lẻ","type":"CT","listed":"2011-10-05","state":0.0,"foreign":0.00228647,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Đầu tư Phát triển Thương mại Viễn Đông","p":null,"t":"CORPORATE","q":5759703,"pct":33.27,"d":"2026-07-30"},{"n":"Công ty Cổ phần Giấy Toàn Lực","p":null,"t":"CORPORATE","q":1281658,"pct":7.4,"d":"2026-07-30"},{"n":"Lê Thị Minh Giang","p":"Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":932543,"pct":5.39,"d":"2026-07-30"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":577400,"pct":4.99,"d":"2025-10-05"},{"n":"Bùi Quang Minh","p":"Thành viên Hội đồng Quản trị/Giám đốc khối","t":"INDIVIDUAL","q":772060,"pct":4.46,"d":"2026-07-30"},{"n":"Bùi Quang Mẫn","p":null,"t":"INDIVIDUAL","q":597848,"pct":3.45,"d":"2026-07-30"},{"n":"Nguyễn Thị Thu","p":null,"t":"INDIVIDUAL","q":374425,"pct":2.16,"d":"2026-07-30"},{"n":"Nguyễn Thị Việt Anh","p":null,"t":"INDIVIDUAL","q":63457,"pct":0.663,"d":"2015-09-14"},{"n":"Bùi Quang Khoa","p":null,"t":"INDIVIDUAL","q":99492,"pct":0.57,"d":"2026-07-30"},{"n":"Bùi Quang Khoa","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":66550,"pct":0.57,"d":"2021-03-19"},{"n":"Mai Thị Trúc Giang","p":"Kế toán trưởng","t":"INDIVIDUAL","q":47562,"pct":0.41,"d":"2021-03-19"},{"n":"Trần Hoàng Nghĩa","p":null,"t":"INDIVIDUAL","q":46845,"pct":0.27,"d":"2026-07-30"},{"n":"Bùi Quang Toàn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":27819,"pct":0.16,"d":"2026-07-30"},{"n":"Võ Nguyên Khôi","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.052,"d":"2015-09-14"},{"n":"Lý Thị Ngọc Châu","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":100,"pct":0.001,"d":"2026-07-30"}],"rel":[{"c":"0306213397","n":"Công Ty Cổ Phần Đầu Tư Phát Triển Giáo Dục Hoàng Việt","t":"affiliate","pct":38.7},{"c":"TLPAP","n":"Công ty Cổ phần Giấy Toàn Lực","t":"a