-4.2],["2022",8.591],["2023",11.2],["2024",22.328],["2025",36.958]]}},"co":{"short":"DV Hàng không sân bay TSN","profile":"Công ty Cổ phần Dịch vụ Hàng không Sân bay Tân Sơn Nhất (SAS) được thành lập năm 1994, là công ty con của Tổng Công ty Cảng Hàng không Việt Nam (ACV), hoạt động chính trong lĩnh vực kinh doanh hàng miễn thuế và cung cấp dịch vụ tại sân bay. Công ty hiện kinh doanh dịch vụ hàng không chủ lực tại Cảng Hàng không Quốc tế Tân Sơn Nhất (sân bay có lưu lượng hành khách lớn nhất Việt Nam), Cảng Hàng không Quốc tế Phú Quốc, Cảng Hàng không Quốc tế Cam ranh. SAS cung cấp nhiều dịch vụ chất lượng cao bao gồm: Phòng chờ hạng thương gia (SASCO Business Lounge), Dịch vụ sleep box, spa, và tiện ích sân bay, Bán lẻ miễn thuế và hàng lưu niệm, Nhà hàng, cafe, dịch vụ đưa đón ưu tiên... Ngày 16/04/2015, SAS chính thức giao dịch trên thị trường UPCOM.","sector":"Bán lẻ","type":"CT","listed":"2015-04-16","state":0.49073687,"foreign":0.00301535,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cảng Hàng không Việt Nam - CTCP","p":null,"t":"CORPORATE","q":65504200,"pct":49.07,"d":"2026-08-07"},{"n":"Công ty TNHH Xuất Nhập Khẩu Liên Thái Bình Dương","p":null,"t":"CORPORATE","q":33340200,"pct":24.98,"d":"2026-08-07"},{"n":"Công Ty TNHH Thời trang và Mỹ phẩm Âu Châu","p":null,"t":"CORPORATE","q":19871400,"pct":14.89,"d":"2026-08-07"},{"n":"Công ty Cổ phần Thời trang và Mỹ phẩm Duy Anh","p":null,"t":"CORPORATE","q":6575000,"pct":4.93,"d":"2026-08-07"},{"n":"Công ty Cổ phần Thương mại Duy Anh","p":null,"t":"CORPORATE","q":2281700,"pct":1.71,"d":"2026-08-07"},{"n":"Nguyễn Hạnh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":200000,"pct":0.15,"d":"2026-08-07"},{"n":"Đoàn Thị Mai Hương","p":null,"t":"INDIVIDUAL","q":206100,"pct":0.15,"d":"2025-10-05"},{"n":"Nguyễn Văn Hùng Cường","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":154100,"pct":0.115,"d":"2026-08-13"},{"n":"Cao Hữu Minh Nhật","p":null,"t":"INDIVIDUAL"