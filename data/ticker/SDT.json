 suất 720 MW, nhà máy thuỷ điện Sông Hinh công suất 66 MW, hầm đường bộ qua đèo Hải Vân - chiều dài 6,7 km, đường Hồ Chí Minh và nhiều công trình khác. Trong quá trình thi công hầm đường bộ qua đèo Hải Vân, Công ty đã áp dụng thành công công nghệ đào hầm theo phương pháp NATM của áo, lần đầu tiên được áp dụng tại Việt Nam. SDT chính thức giao dịch trên thị trường UPCoM từ ngày 05/02/2024.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-14","state":0.62265313,"foreign":0.00612405,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Sông Đà","p":null,"t":"CORPORATE","q":26607407,"pct":62.27,"d":"2026-08-12"},{"n":"Nguyễn Ngọc Kiều Trang","p":null,"t":"INDIVIDUAL","q":3022100,"pct":7.07,"d":"2026-08-25"},{"n":"Nguyễn Chí Hiếu","p":null,"t":"INDIVIDUAL","q":1366600,"pct":3.2,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán Bảo Việt","p":null,"t":"CORPORATE","q":560900,"pct":1.313,"d":"2015-06-15"},{"n":"Nguyễn Văn Tánh","p":null,"t":"INDIVIDUAL","q":161980,"pct":0.379,"d":"2015-09-14"},{"n":"Ngân hàng Thương mại Cổ phần Việt Á","p":null,"t":"CORPORATE","q":113100,"pct":0.265,"d":"2015-06-15"},{"n":"Đặng Thị Bích Hòa","p":null,"t":"INDIVIDUAL","q":110088,"pct":0.26,"d":"2025-10-05"},{"n":"Công ty Cổ phần Quản lý quỹ đầu tư MB","p":null,"t":"CORPORATE","q":71600,"pct":0.168,"d":"2015-06-15"},{"n":"Quỹ Đầu tư Giá trị MB Capital","p":null,"t":"CORPORATE","q":69900,"pct":0.16,"d":"2025-10-05"},{"n":"Trần Văn Tấn","p":null,"t":"INDIVIDUAL","q":24753,"pct":0.058,"d":"2025-10-05"},{"n":"Trần Thị Lan Anh","p":null,"t":"INDIVIDUAL","q":21940,"pct":0.051,"d":"2025-10-05"},{"n":"Ngô Thị Kim Nhung","p":null,"t":"INDIVIDUAL","q":21060,"pct":0.049,"d":"2025-10-05"},{"n":"Trần Ngọc Lan","p":null,"t":"INDIVIDUAL","q":19692,"pct":0.046,"d":"2025-10-05"},{"n":"Vũ Văn Tính","p":null,"t":"INDIVIDUAL","q":8640,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Hoằng","p":null,"t":"INDIVIDUAL","q":7722,"pct":0.018,"d":"2015-09-14"},{"n":"Lụ