ường Thạnh (Cần Thơ), Khu đô thị HQC Paradise City, Cao ốc Officetel Golden King (TP. HCM), Khu công nghiệp Hàm Kiệm I (Bình Thuận). HQC còn mở rộng đầu tư vào lĩnh vực Giáo dục và Tài chính. HQC được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Bất động sản","type":"CT","listed":"2010-10-20","state":0.0,"foreign":0.0072973,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trương Anh Tuấn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":73600000,"pct":11.75,"d":"2026-08-24"},{"n":"Công ty cổ phần Xây dựng và Kinh doanh Nhà Bình Thuận","p":null,"t":"CORPORATE","q":13650000,"pct":5.19,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư Hải Phát","p":null,"t":"CORPORATE","q":21200000,"pct":3.38,"d":"2026-06-17"},{"n":"Công ty Cổ phần Sông Đà 9.06","p":null,"t":"CORPORATE","q":1999900,"pct":0.76,"d":"2015-06-15"},{"n":"Nguyễn Thị Diệu Phương","p":null,"t":"INDIVIDUAL","q":3300006,"pct":0.536,"d":"2026-08-24"},{"n":"Công ty TNHH Tư Vấn Thiết Kế Xây Dựng Vdc","p":null,"t":"CORPORATE","q":1900000,"pct":0.3,"d":"2026-06-17"},{"n":"Trương Thái Sơn","p":null,"t":"INDIVIDUAL","q":572281,"pct":0.099,"d":"2026-02-10"},{"n":"Trương Đình Thảo","p":null,"t":"INDIVIDUAL","q":432000,"pct":0.075,"d":"2026-02-10"},{"n":"Trần Thị Thanh Như","p":null,"t":"INDIVIDUAL","q":189180,"pct":0.072,"d":"2015-09-14"},{"n":"Trương Đức Hiếu","p":null,"t":"INDIVIDUAL","q":243660,"pct":0.042,"d":"2026-02-10"},{"n":"Nguyễn Ngọc Cư","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.019,"d":"2015-09-14"},{"n":"Bùi Kế Thiện","p":null,"t":"INDIVIDUAL","q":35000,"pct":0.013,"d":"2015-09-14"},{"n":"Nguyễn Hoài Thu","p":null,"t":"INDIVIDUAL","q":35000,"pct":0.013,"d":"2015-09-14"},{"n":"Hồ Đình Hiếu","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.008,"d":"2015-09-14"},{"n":"Trương Thị Phương Trang","p":null,"t":"INDIVIDUAL","q":38880,"pct":0.007,"d":"2026-02-10"},{"n":"Đoàn Thị Bích Lan","p":null,"t":"INDIVIDUAL","q":15000,"