h nước sạch trên địa bàn thành Đà Nẵng. DNN chính thức hoạt động theo mô hình công ty cổ phần vào tháng 11/2016. Công ty hiện đang quản lý vận hành mạng lưới cấp nước với tổng suất 250.000 m3/ngày đêm trên địa bàn thành phố Đà Nẵng. DNN được giao dịch trên thị trường UPCOM từ tháng 07/2017.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-07-17","state":0.60078981,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Thành Phố Đà Nẵng","p":null,"t":"CORPORATE","q":34824217,"pct":60.079,"d":"2026-02-26"},{"n":"Công ty Cổ Phần Đầu Tư Đà Nẵng - Miền Trung","p":null,"t":"CORPORATE","q":20286744,"pct":35.0,"d":"2026-02-26"},{"n":"Phạm Thị Quế Chi","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":11300,"pct":0.019,"d":"2026-02-26"},{"n":"Hồ Minh Nam","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":7000,"pct":0.012,"d":"2026-02-26"},{"n":"Phan Thịnh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7200,"pct":0.012,"d":"2026-02-26"},{"n":"Trần Phước Thương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7000,"pct":0.012,"d":"2026-02-26"},{"n":"Nguyễn Trường Ảnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":4600,"pct":0.008,"d":"2026-02-26"},{"n":"Lê Mai Phương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2100,"pct":0.004,"d":"2026-07-16"},{"n":"Lê Uyên Phương","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":900,"pct":0.002,"d":"2026-02-26"},{"n":"Phạm Hồng Minh","p":"Kế toán trưởng/Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":800,"pct":0.001,"d":"2026-02-26"}],"rel":[{"c":"0401953948","n":"Công ty TNHH MTV Xây Lắp Cấp Thoát Nước Đà Nẵng","t":"subsidiary","pct":100.0}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2026 - 1,000 VND","d":"2026-08-28","record":"2026-09-10","ex":"2026-09-09"},{"c":"EGME","t":"DNN - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-05