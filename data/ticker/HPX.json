nh bất động sản, xây dựng nhà các loại, xây dựng công trình đường sắt và đường bộ, xây dựng công trình kỹ thuật dân dụng khác. Một số dự án Công ty đã thực hiện: Dự án Khu đô thị Văn Phú - Hà Đông - Hà Nội, Dự án Khu đô thị Tân Tây Đô - Đan Phượng - Hà Nội, Dự án Tổ hợp thương mại dịch vụ và căn hộ THE PRIDE - La Khê - Hà Đông - Hà Nội, Dự án khu nhà phố thương mại 24h Vạn Phúc - Hà Đông - Hà Nội. HPX chính thức niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2018.","sector":"Bất động sản","type":"CT","listed":"2018-07-24","state":0.0,"foreign":0.0036838,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đỗ Quý Hải","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":50839948,"pct":16.71,"d":"2026-08-10"},{"n":"Hoàng Văn Toàn","p":null,"t":"INDIVIDUAL","q":15200000,"pct":4.997,"d":"2025-10-05"},{"n":"Hoàng Thị Ý","p":null,"t":"INDIVIDUAL","q":15000000,"pct":4.931,"d":"2025-10-05"},{"n":"Chu Thị Lương","p":null,"t":"INDIVIDUAL","q":5032285,"pct":1.654,"d":"2026-07-29"},{"n":"Nguyễn Việt Dũng","p":null,"t":"INDIVIDUAL","q":4802200,"pct":1.579,"d":"2025-10-05"},{"n":"Lã Quốc Đạt","p":null,"t":"INDIVIDUAL","q":3000000,"pct":0.986,"d":"2025-10-05"},{"n":"Lê Việt Dũng","p":null,"t":"INDIVIDUAL","q":1419457,"pct":0.47,"d":"2025-10-05"},{"n":"Idris Ltd","p":null,"t":"CORPORATE","q":700000,"pct":0.35,"d":"2025-10-05"},{"n":"Đỗ Quý Đường","p":null,"t":"INDIVIDUAL","q":674174,"pct":0.222,"d":"2026-07-29"},{"n":"Nguyễn Văn Phương","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":608337,"pct":0.2,"d":"2026-08-03"},{"n":"Lê Thanh Hải","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":391140,"pct":0.129,"d":"2026-07-29"},{"n":"Nguyễn Văn Dũng","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":381200,"pct":0.125,"d":"2026-07-29"},{"n":"Hoàng Thị Như","p":null,"t":"INDIVIDUAL","q":318900,"pct":0.105,"d":"2025-10-05"},{"n":"Trần Hoài An