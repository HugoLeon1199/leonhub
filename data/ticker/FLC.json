ông nghiệp. Ngoài ra, FLC còn kinh doanh dịch vụ khách sạn, nghỉ dưỡng; kinh doanh các cơ sở thể thao và kinh doanh thương mại khác. Các công trình tiêu biểu mà FLC đã thực hiện: FLC Sầm Sơn Beach & Golf Resort, FLC Star Tower, Quần thể FLC Hạ Long Golf Club & Resort, FLC Twin Tower và nhiều dự án lớn khác. Bên cạnh đó, Tập đoàn còn tham gia vào lĩnh vực kinh doanh vận tải hàng không, nông nghiệp công nghệ cao và y tế.","sector":"Bất động sản","type":"CT","listed":"2011-10-05","state":0.0,"foreign":0.02157535,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trịnh Văn Quyết","p":null,"t":"INDIVIDUAL","q":215436257,"pct":30.343,"d":"2025-10-05"},{"n":"Công ty TNHH Đào tạo Goft VPGA","p":null,"t":"CORPORATE","q":35000000,"pct":6.605,"d":"2015-06-15"},{"n":"CTCP Đầu tư tài chính và Quản lý tài sản Magnus Capital","p":null,"t":"CORPORATE","q":24973000,"pct":4.713,"d":"2015-06-15"},{"n":"Công ty TNHH Đầu tư Thương mại và Xuất nhập khẩu Vietexco","p":null,"t":"CORPORATE","q":18536880,"pct":3.498,"d":"2025-10-05"},{"n":"CTCP Đầu tư Fujikaen Việt Nam","p":null,"t":"CORPORATE","q":16100000,"pct":3.038,"d":"2015-06-15"},{"n":"Hồ Thị Hiền","p":null,"t":"INDIVIDUAL","q":15000000,"pct":2.831,"d":"2015-09-14"},{"n":"VanEck Vietnam ETF","p":null,"t":"CORPORATE","q":13115222,"pct":2.05,"d":"2025-10-05"},{"n":"Nguyễn Hải Châu","p":null,"t":"INDIVIDUAL","q":10541400,"pct":1.989,"d":"2015-09-14"},{"n":"Công ty Cổ phần Đầu tư Tài chính Ninh Bắc","p":null,"t":"CORPORATE","q":5200000,"pct":0.981,"d":"2015-06-15"},{"n":"Nguyễn Văn Mạnh","p":null,"t":"INDIVIDUAL","q":2532950,"pct":0.478,"d":"2015-09-14"},{"n":"Doãn Văn Phương","p":null,"t":"INDIVIDUAL","q":1114400,"pct":0.21,"d":"2015-09-14"},{"n":"Nguyễn Thị Huyền Trang","p":null,"t":"INDIVIDUAL","q":811500,"pct":0.153,"d":"2015-09-14"},{"n":"Trịnh Văn Đại","p":null,"t":"INDIVIDUAL","q":800000,"pct":0.151,"d":"2015-09-14"},{"n":"Trịnh Thị Thanh Huyền","p":null,"t":"INDIVIDUAL","q":731200,"pct":0.138,"d":"