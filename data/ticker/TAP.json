,10.366],["2021-Q4",10.366],["2022-Q1",14.409],["2022-Q2",14.409]],"y":[["2018",23.541],["2019",19.526],["2020",10.366],["2021",14.409]]}},"co":{"short":"Đô thị Tân An","profile":"Công ty Cổ phần Đô Thị Tân An (TAP), tiền thân là Công trình Đô Thị Tân An, được thành lập từ năm 1997 và chuyển đổi thành Công ty Cổ phần vào năm 2009. Lĩnh vực kinh doanh chính của Công ty là các dịch vụ công cộng như xử lý môi trường vệ sinh công cộng, quản lý hệ thống cấp thoát nước đô thị, công viên cây xanh, và quản lý cầu đường. Bên cạnh đó, Công ty cũng tham gia trồng cây xanh, cỏ công viên, thi công xây lắp các cơ hở hạ tầng đô thị hạ tầng khác như đèn chiếu sáng, đèn tín hiệu giao thông, và kinh doanh hoa kiểng, cây xanh các loại, xăng dầu. Với kinh nghiệm hơn 20 thực hiện công tác vệ sinh môi trường và chỉnh trang đô thị trên địa bàn tỉnh, Công ty đã góp phần đưa thị xã Tân An trở thành Thành phố Tân An vào tháng 9/2009.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-09-07","state":0.6,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Long An","p":null,"t":"CORPORATE","q":850020,"pct":60.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Tập Đoàn Ô Tô Hiệp Hòa","p":null,"t":"CORPORATE","q":241340,"pct":17.035,"d":"2025-10-05"},{"n":"Nguyễn Thị Hồng Vy","p":"Thành viên Hội đồng Quản trị/Giám đốc/Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":132990,"pct":9.39,"d":"2022-08-10"},{"n":"Lương Minh Nhựt","p":null,"t":"INDIVIDUAL","q":46450,"pct":3.28,"d":"2020-09-09"},{"n":"Lại Thanh Nhàn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.141,"d":"2022-08-10"},{"n":"Nguyễn Thị Ngọc Trúc","p":"Phó Giám đốc/Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.141,"d":"2022-08-10"},{"n":"Nguyễn Minh Nhựt","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":1200,"pct":0.085,"d":"2022-08-10"},{"n":"Võ Phước Toàn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1100,"pct":0.078,