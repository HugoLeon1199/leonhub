ức hoạt động theo mô hình công ty cổ phần từ năm 2016. ACV là đơn vị duy nhất quản lý, vận hành và khai thác toàn bộ hệ thống 22 Cảng hàng không trên toàn lãnh thổ Việt Nam bao gồm 10 cảng hàng không quốc tế và 12 cảng hàng không nội địa. Năm 2025, ACV đã đảm bảo tuyệt đối an ninh, an toàn cho hơn 120 triệu hành khách và 737 nghìn lượt hạ cất cánh. Cảng HKQT Nội Bài được cấp chứng nhận AHA (Airport Health Accreditation), là một trong 118 sân bay trên thế giới được cấp chứng nhận AHA.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-11-21","state":0.95405478,"foreign":0.01711717,"rating":"M-PF","target":48000.0,"rating_as_of":"2026-05-18","source":"Vietcap"},"owners":[{"n":"Bộ Tài Chính","p":null,"t":"CORPORATE","q":3418232807,"pct":95.4,"d":"2026-06-04"},{"n":"Vinacapital Vietnam Opportunity Fund Ltd.","p":null,"t":"CORPORATE","q":22112073,"pct":1.016,"d":"2025-10-05"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":8283363,"pct":0.38,"d":"2026-08-17"},{"n":"Quỹ Đầu tư Cổ phiếu Manulife","p":null,"t":"CORPORATE","q":80100,"pct":0.004,"d":"2026-08-17"},{"n":"Lê Thị Diệu Thúy","p":null,"t":"INDIVIDUAL","q":6200,"pct":0.0,"d":"2025-10-05"},{"n":"Nguyễn Thị Hồng Phượng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5000,"pct":0.0,"d":"2025-10-05"},{"n":"Nguyễn Tiến Việt","p":"Phó Giám đốc","t":"INDIVIDUAL","q":5000,"pct":0.0,"d":"2026-06-26"},{"n":"Nguyễn Đức Hùng","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":6200,"pct":0.0,"d":"2026-05-27"},{"n":"Vũ Thế Phiệt","p":null,"t":"INDIVIDUAL","q":6900,"pct":0.0,"d":"2026-03-19"}],"rel":[{"c":"NAFSC","n":"Công ty Cổ phần Dịch Vụ Nhiên Liệu Hàng Không Nội Bài","t":"subsidiary","pct":60.0},{"c":"SAAM","n":"Công ty TNHH Dịch Vụ Bảo Dưỡng Máy Bay Cảng Hàng Không Miền Nam","t":"affiliate","pct":51.0},{"c":"SAS","n":"Công ty Cổ phần Dịch vụ Hàng không Sân bay Tân Sơn Nhất","t":"affiliate","pct":49.07},{"c":"SGN","n":"Công ty Cổ phần Phục vụ mặt đất Sài Gòn","t":"affiliate","pct":48.03},{"c":"SATSCO","n":"Cô