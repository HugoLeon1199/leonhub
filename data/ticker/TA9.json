ớc. Các công trình tiêu biểu của công ty gồm Công trình Sở Chỉ huy Sư đoàn BB2, Công trình 189, Tòa nhà Công an tỉnh Gia Lai, Hội trường sư đoàn 315. Ngày 04/06/2015, TA9 chính thức niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX);","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2015-07-31","state":0.51003262,"foreign":0.00031184,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Thành An (Công ty TNHH MTV)","p":null,"t":"CORPORATE","q":6334373,"pct":51.0,"d":"2026-08-12"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":739000,"pct":5.95,"d":"2025-10-05"},{"n":"VÕ CỬU LONG","p":null,"t":"INDIVIDUAL","q":619574,"pct":4.99,"d":"2025-10-05"},{"n":"Phạm Văn Lê","p":"Phó Giám đốc","t":"INDIVIDUAL","q":145943,"pct":1.18,"d":"2026-03-02"},{"n":"Hoàng Đức Trúc","p":null,"t":"INDIVIDUAL","q":125404,"pct":1.01,"d":"2026-03-02"},{"n":"Đặng Đình Khiêm","p":"Phó Chủ tịch Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":83483,"pct":0.67,"d":"2026-03-02"},{"n":"Lâm Văn Công","p":"Thành viên Ban kiểm soát/Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":45989,"pct":0.37,"d":"2026-03-02"},{"n":"Nguyễn Xuân Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":24278,"pct":0.19,"d":"2026-03-02"},{"n":"Trần Thị Diệu Thúy","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":10866,"pct":0.09,"d":"2026-03-02"},{"n":"Phan Xuân Bằng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":10000,"pct":0.08,"d":"2026-03-02"},{"n":"Mai Tố Loan","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":6406,"pct":0.05,"d":"2026-03-02"},{"n":"Nguyễn Văn Kháng","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":5079,"pct":0.04,"d":"2026-03-02"},{"n":"Trịnh Thị Thu Hương","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":2292,"pct":0.02,"d":"2026-06-05"}],"events":[{"c":"AIS","t":"TA9 - Niêm yết bổ sung 1.744.703 cổ phiếu","d":"2026-08-24","record":null,"ex":null},{"c":"ISS","t":"Phát h