hất, khoáng sản, vận tải, bất động sản… DSG là đơn vị đầu tiên trong nước được đầu tư để sản xuất sản phẩm kính xây dựng. Công ty đã đầu tư thực hiên nhiều dự án công trình lớn như: Chung cư Samsung, Ritz Carlton Hotel & Apartment - Dubai, CT4-ĐN3 khu đô thị mới Mỹ đình…DSG đươc giao dịch trên thị trường UPCOM từ tháng 08/2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-08-11","state":0.136,"foreign":0.00167,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Viglacera - Công ty Cổ phần","p":null,"t":"CORPORATE","q":25922500,"pct":86.41,"d":"2026-05-15"},{"n":"Hoàng Kim Bồng","p":null,"t":"INDIVIDUAL","q":23100,"pct":0.08,"d":"2021-11-11"},{"n":"Hoàng Kim Bồng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":6000,"pct":0.02,"d":"2026-02-27"},{"n":"Hoàng Thị Hằng","p":"Phụ trách Công bố thông tin/Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":2631,"pct":0.009,"d":"2026-02-27"},{"n":"Nguyễn Việt Hà","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2262,"pct":0.008,"d":"2026-02-27"},{"n":"Nguyễn Thành Chung","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2000,"pct":0.007,"d":"2026-02-27"},{"n":"Phạm Văn Chương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":494,"pct":0.002,"d":"2026-02-27"},{"n":"Nguyễn Hữu Luật","p":null,"t":"INDIVIDUAL","q":23,"pct":0.0,"d":"2025-10-05"}],"rel":[{"c":"VGCGLAZ","n":"Công Ty TNHH MTV Lắp Dựng Kính Viglacera","t":"subsidiary","pct":100.0},{"c":"VINAFACADE","n":"Công ty Cổ Phần Vinafacade","t":"affiliate","pct":20.86}],"rel_count":2,"events":[{"c":"AGME","t":"DSG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-12","record":"2026-03-02","ex":"2026-02-27"},{"c":"EGME","t":"DSG - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-07-16","record":"2025-07-29","ex":"2025-07-28"},{"c":"AGME","t":"DSG - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-04","record":"2025-03-21","ex":"2025-03-20"},{"c":"AGME","t":"DSG - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-18","