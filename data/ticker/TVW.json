inh, được thành lập vào năm 1992. Công ty hoạt động chính trong lĩnh vực cung cấp và kinh doanh nước sạch phục vụ sinh hoạt, sản xuất trên địa bàn tỉnh Trà Vinh. TVW chính thức hoạt động theo hình thức công ty cổ phần với từ năm 2016. Công ty hiện đang quản lý vận hành hệ thống cấp nước sạch với tổng công suất cấp nước lên tới 28.000m3/ngày đêm, chủ yếu cấp nước cho thành phố Trà Vinh và thị Trấn Châu Thành.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-12-11","state":0.82338507,"foreign":0.0001,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy ban Nhân dân Tỉnh Trà Vinh","p":null,"t":"CORPORATE","q":12019660,"pct":82.34,"d":"2025-10-05"},{"n":"Công ty CP Nước Và Môi Trường Đồng Bằng","p":null,"t":"CORPORATE","q":1459854,"pct":10.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Rynan Technologies Vietnam","p":null,"t":"CORPORATE","q":740146,"pct":5.07,"d":"2025-10-05"},{"n":"Đào Thiện Duyên","p":"Kế toán trưởng","t":"INDIVIDUAL","q":14900,"pct":0.1,"d":"2023-07-31"},{"n":"Nguyễn Văn Quý","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":12600,"pct":0.09,"d":"2023-07-31"},{"n":"Võ Hoàng Khương","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":12700,"pct":0.09,"d":"2023-07-31"},{"n":"Nguyễn Như Bình","p":null,"t":"INDIVIDUAL","q":4800,"pct":0.03,"d":"2018-06-19"},{"n":"Đặng Thị Bích Thủy","p":null,"t":"INDIVIDUAL","q":1800,"pct":0.012,"d":"2021-07-20"},{"n":"Nguyễn Thị Khỏe","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1300,"pct":0.01,"d":"2023-07-31"},{"n":"Trương Hoàng Diệp","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2100,"pct":0.01,"d":"2023-07-31"},{"n":"Lê Thị Thùy Trang","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":400,"pct":0.003,"d":"2023-07-31"}],"rel":[{"c":"DHWACO","n":"Công ty Cổ phần Nước và Môi trường Duyên Hải","t":"affiliate","pct":20.0}],"rel_count":1,"events":[{"c":"SUSP","t":"