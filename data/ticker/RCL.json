 liên doanh với Công ty CP Địa ốc Sài Gòn Chợ Lớn, Công ty Địa ốc III, Công ty Địa ốc 9. Công ty có lợi thế nằm tại Quận 8 và đang sở hữu một quỹ đất nông nghiệp rất lớn được quy hoạch chuyển sang đất ở và những dự án thành công trên địa bàn quận. Ngày 14/06/2007, RCL chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2007-06-14","state":0.20002258,"foreign":0.00239945,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Địa ốc Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":2827440,"pct":20.002,"d":"2026-07-16"},{"n":"Công Ty TNHH Thương Mại N.T.P","p":null,"t":"CORPORATE","q":1441330,"pct":10.4,"d":"2025-10-16"},{"n":"Trần Văn Châu","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1382579,"pct":9.59,"d":"2026-08-12"},{"n":"Công ty TNHH Đầu Tư Cores","p":null,"t":"CORPORATE","q":632210,"pct":4.56,"d":"2025-10-05"},{"n":"Phạm Đình Bá Duy","p":null,"t":"INDIVIDUAL","q":622500,"pct":4.49,"d":"2025-10-05"},{"n":"Trần Hữu Hai","p":null,"t":"INDIVIDUAL","q":619082,"pct":4.47,"d":"2025-10-05"},{"n":"Nguyễn Khôi Nguyên","p":null,"t":"INDIVIDUAL","q":554476,"pct":3.86,"d":"2026-08-12"},{"n":"Trần Thị Chi","p":null,"t":"INDIVIDUAL","q":102073,"pct":0.71,"d":"2026-08-12"},{"n":"Vũ Quốc Tuấn","p":null,"t":"INDIVIDUAL","q":74800,"pct":0.54,"d":"2025-10-05"},{"n":"Trần Thùy Dung","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":76063,"pct":0.53,"d":"2026-08-12"},{"n":"Nguyễn Xuân Dũng","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":33635,"pct":0.23,"d":"2026-08-12"},{"n":"Huỳnh Bá Dưỡng","p":null,"t":"INDIVIDUAL","q":9600,"pct":0.191,"d":"2015-09-14"},{"n":"Phạm Thị Vui","p":null,"t":"INDIVIDUAL","q":5544,"pct":0.11,"d":"2015-09-14"},{"n":"Nguyễn Kim Bửu","p":null,"t":"INDIVIDUAL","q":1677,"pct":0.033,"d":"2015-09-14"},{"n":"Lê Thị Thanh Ngân","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3547,"pct":0.025,"d":"2026-0