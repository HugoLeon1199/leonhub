Dầu khí Cửu Long là trở thành một điểm sáng trong chiến lược phát triển các khu đô thị, khu dân cư trong Tỉnh Sóc Trăng nói riêng và khu vực Đồng bằng Sông Cửu Long nói chung. CCL chính thức được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ Ngày 03/03/2011.","sector":"Bất động sản","type":"CT","listed":"2011-03-03","state":0.0,"foreign":0.01657305,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Triệu Dõng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":10662400,"pct":17.9,"d":"2026-07-14"},{"n":"Trịnh Sướng","p":null,"t":"INDIVIDUAL","q":5600000,"pct":10.53,"d":"2025-10-05"},{"n":"Dương Thế Nghiêm","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3765834,"pct":6.32,"d":"2026-07-14"},{"n":"Công ty Cổ phần Quản lý quỹ Ngân hàng TMCP Đại chúng Việt nam","p":null,"t":"CORPORATE","q":1500000,"pct":6.0,"d":"2015-06-15"},{"n":"Công ty Cổ phần Cơ điện Lạnh","p":null,"t":"CORPORATE","q":1221250,"pct":4.885,"d":"2015-06-15"},{"n":"Trương Bích Đào","p":null,"t":"INDIVIDUAL","q":2867100,"pct":4.81,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán AGRIBANK","p":null,"t":"CORPORATE","q":1100000,"pct":4.4,"d":"2015-06-15"},{"n":"Trần Thanh Tân","p":null,"t":"INDIVIDUAL","q":2000000,"pct":4.21,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Trâm","p":null,"t":"INDIVIDUAL","q":1210000,"pct":3.41,"d":"2025-10-05"},{"n":"Hồng Duy Thức","p":null,"t":"INDIVIDUAL","q":820000,"pct":3.12,"d":"2025-10-05"},{"n":"Nguyễn Tuấn Anh","p":null,"t":"INDIVIDUAL","q":256250,"pct":1.025,"d":"2015-09-14"},{"n":"Nguyễn Kim Hồng Đào","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":338828,"pct":0.57,"d":"2026-01-29"},{"n":"Trương Văn Phước","p":null,"t":"INDIVIDUAL","q":32928,"pct":0.06,"d":"2026-01-29"},{"n":"Bùi Thị Kim Ngân","p":"Kế toán trưởng","t":"INDIVIDUAL","q":26272,"pct":0.04,"d":"2026-01-29"},{"n":"Nguyễn Thái Nguyên","p":"Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":210