 hệ với các đơn vị cung cấp nguyên vật liệu uy tín trên cả nước. Ngày 28/09/2009, SDU chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-09-28","state":0.3,"foreign":0.00112,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Sông Đà","p":null,"t":"CORPORATE","q":6000000,"pct":30.0,"d":"2026-05-26"},{"n":"Hoàng Văn Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4998000,"pct":24.99,"d":"2026-02-24"},{"n":"Công ty Cổ phần Chứng khoán VNDIRECT","p":null,"t":"CORPORATE","q":3252100,"pct":16.261,"d":"2015-06-15"},{"n":"Hoàng Viết Tường","p":null,"t":"INDIVIDUAL","q":300000,"pct":1.5,"d":"2025-10-05"},{"n":"Hoàng Thị Phương Thuý","p":null,"t":"INDIVIDUAL","q":210000,"pct":1.05,"d":"2025-10-05"},{"n":"Nguyễn Thế Lợi","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":200000,"pct":1.0,"d":"2026-02-24"},{"n":"Lê Tùng Hoa","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.1,"d":"2015-09-14"},{"n":"Phạm Bá Tôn","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.1,"d":"2015-09-14"},{"n":"Trần Văn Tuấn","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.1,"d":"2015-09-14"},{"n":"Nguyễn Văn Thanh","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.075,"d":"2015-09-14"},{"n":"Bùi Thị Chén","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.05,"d":"2025-10-05"},{"n":"Nguyễn Văn Bình","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.04,"d":"2015-09-14"},{"n":"Trịnh Xuân Thụy","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":8700,"pct":0.04,"d":"2026-02-24"},{"n":"Nguyễn Văn Nghĩa","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.02,"d":"2015-09-14"},{"n":"Lý Quang Thái","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.01,"d":"2015-09-14"}],"rel":[{"c":"12106","n":"Công ty Tnhh Một Thành Viên Quản Lý Và Kinh Doanh Dịch Vụ Sdu","t":"subsidiary","pct":100.0},{"c":"SDUIC","n":"Công ty Cổ Phần Tư Vấn Đầu Tư Sdu","t":"affiliate","pct":30.0},{"c":"BHUDI","n":"Công Ty Cổ Phần Đầu Tư Xây Dựng Đô Thị Bắc Hà","t":"affi