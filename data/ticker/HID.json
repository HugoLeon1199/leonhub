 (ADB), Cơ quan Hợp tác Quốc tế Nhật Bản (JICA). Bên cạnh đó, Công ty đã và đang tham gia đầu tư phát triển công trình cấp nước, xử lý nước thải và năng lượng tái tạo.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-07-11","state":0.0,"foreign":0.00381702,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Quang Huân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":20464872,"pct":26.662,"d":"2026-02-24"},{"n":"Bùi Thị Xuyến","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":4000000,"pct":5.211,"d":"2026-06-26"},{"n":"Trần Bắc Mỹ","p":null,"t":"INDIVIDUAL","q":4000000,"pct":5.211,"d":"2025-10-05"},{"n":"Trần Thị Minh Huệ","p":null,"t":"INDIVIDUAL","q":2200000,"pct":2.86,"d":"2026-06-26"},{"n":"Nguyễn Quang Hưng","p":null,"t":"INDIVIDUAL","q":634882,"pct":1.08,"d":"2025-10-05"},{"n":"Lê Kim Anh","p":null,"t":"INDIVIDUAL","q":616460,"pct":0.803,"d":"2025-10-05"},{"n":"Nguyễn Cẩm Lê","p":null,"t":"INDIVIDUAL","q":500000,"pct":0.651,"d":"2025-10-05"},{"n":"Nguyễn Việt Dũng","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":14276,"pct":0.019,"d":"2026-08-21"},{"n":"Nguyễn Trường Giang","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":4000,"pct":0.005,"d":"2026-06-26"}],"rel":[{"c":"2813189","n":"Công ty TNHH Halcom (Cambodia)","t":"subsidiary","pct":100.0},{"c":"6300346708","n":"Công ty Cp Điện Mặt Trời Halcom - Hậu Giang","t":"subsidiary","pct":98.0},{"c":"12250","n":"Công ty Cổ phần Phát Triển Đô Thị Cần Thơ","t":"subsidiary","pct":96.88},{"c":"3101106872","n":"Công ty Cổ phần Điện Gió Halcom - Quảng Bình","t":"subsidiary","pct":96.15},{"c":"HALCOMIN","n":"Công ty Cổ phần Bảo Hiểm HALCOM","t":"subsidiary","pct":94.0},{"c":"PMSP","n":"Công ty Cổ phần Điện Mặt trời Phương Mai 3","t":"subsidiary","pct":90.9},{"c":"CENWINDCO","n":"Công ty Cổ phần Phong Điện Miền Trung","t":"subsidiary","pct":51.0},{"c":"0107613489","n":"Công ty TNHH Đầu Tư Và Ứng Dụng Công Nghệ Môi Trường Miền Bắc","t":"subsidia