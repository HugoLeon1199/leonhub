 hình đặt tại Công ty TNHH Thép Tây Nguyên có công suất thiết kế 60.000 tấn/năm, dây chuyền sản xuất thép hình khổ lớn nhất mà Việt Nam có thể sản xuất được đặt tại Công ty Cổ phần Thép Bắc Nam có công suất là 300.000 tấn thành phẩm/năm. Có được sự thành công và lớn mạnh như ngày nay, bên cạnh sự hợp tác và gắn bó lâu dài của các đối tác và bạn hàng truyền thống trong và ngoài nước như: Pháp, Nga, Kazakstan, Nhật Bản, Hàn Quốc, Trung Quốc, Đài Loan, Thái Lan, Singapore, Indonesia.. Ngày 16/03/2010, TLH chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2010-03-16","state":0.0,"foreign":0.00896564,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Mạnh Hà","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":21995359,"pct":19.58,"d":"2026-02-24"},{"n":"Phạm Thị Hồng","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":12764076,"pct":11.36,"d":"2026-02-24"},{"n":"Nguyễn Ngọc Phượng","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6141049,"pct":5.47,"d":"2026-02-24"},{"n":"Nguyễn Vũ Hồng Anh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3286000,"pct":2.93,"d":"2026-02-24"},{"n":"Công ty Cổ phần Chứng khoán Bảo Việt","p":null,"t":"CORPORATE","q":1500000,"pct":1.859,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán UP","p":null,"t":"CORPORATE","q":500000,"pct":0.62,"d":"2015-06-15"},{"n":"Đào Đức Toàn","p":null,"t":"INDIVIDUAL","q":74793,"pct":0.094,"d":"2015-09-14"},{"n":"Nguyễn Anh Hùng","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.025,"d":"2015-09-14"},{"n":"VI (Vietnam investments) partners, LLC","p":null,"t":"CORPORATE","q":5500,"pct":0.007,"d":"2015-06-15"},{"n":"New-S Securities Company Limited","p":null,"t":"CORPORATE","q":3675,"pct":0.005,"d":"2015-06-15"},{"n":"Iwai Securities Co., Ltd","p":null,"t":"CORPORATE","q":2730,"pct":0.003,"d":"2015-06-15"},{"n":"Ngô Thị Hồng Vân","p":"Kế toán trưởng","