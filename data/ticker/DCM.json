u Âu. Công ty hiện đang sở hữu hệ thống phân phối rộng khắp cả nước và Campuchia với 75 nhà phân phối, 20 khách hàng thương mại, 5 khách hàng B2B, 14.776 nhà phân phối cấp 2 và 20 kho trung chuyển với sức chứa lên tới trên 300 nghìn tấn. DCM được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 03/2015.","sector":"Hóa chất","type":"CT","listed":"2015-03-31","state":0.7556159,"foreign":0.04642954,"rating":"BUY","target":51000.0,"rating_as_of":"2026-05-25","source":"Vietcap"},"owners":[{"n":"Tập Đoàn Công Nghiệp – Năng Lượng Quốc Gia Việt Nam","p":null,"t":"CORPORATE","q":400023057,"pct":75.56,"d":"2026-07-31"},{"n":"Công ty Cổ phần Quản lý quỹ Ngân hàng TMCP Đại chúng Việt nam","p":null,"t":"CORPORATE","q":26309500,"pct":4.97,"d":"2025-10-05"},{"n":"CTBC Vietnam Equity Fund","p":null,"t":"CORPORATE","q":11500000,"pct":2.172,"d":"2025-10-05"},{"n":"Norges Bank","p":null,"t":"CORPORATE","q":9330000,"pct":1.762,"d":"2025-10-05"},{"n":"DC Developing Markets Strategies Public Limited Company","p":null,"t":"CORPORATE","q":5000000,"pct":0.945,"d":"2025-10-05"},{"n":"Samsung Vietnam Securities Master Investment Trust","p":null,"t":"CORPORATE","q":268000,"pct":0.051,"d":"2025-10-05"},{"n":"Văn Tiến Thanh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":109000,"pct":0.021,"d":"2026-07-31"},{"n":"Nguyễn Thanh Tùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5003,"pct":0.001,"d":"2026-07-31"},{"n":"Nguyễn Thanh Tùng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":5003,"pct":0.001,"d":"2026-07-31"},{"n":"Vũ Thu Hiền","p":null,"t":"INDIVIDUAL","q":2900,"pct":0.001,"d":"2026-07-31"},{"n":"Đinh Như Cường","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2900,"pct":0.001,"d":"2026-07-31"},{"n":"Lê Ngọc Minh Trí","p":null,"t":"INDIVIDUAL","q":1600,"pct":0.0,"d":"2025-10-05"},{"n":"Nguyễn Thị Song Yên","p":null,"t":"INDIVIDUAL","q":300,"pct":0.0,"d":"2026-07-31"},{"n":"Phan Thị Cẩm Hương","p":null,"t":"INDIV