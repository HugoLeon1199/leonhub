h đơn vị thành viên thuộc Tổng Công ty Điện lực Việt Nam. Nhà máy Nhiệt điện Bà Rịa chuyển sang hạch toán tài chính độc lập ngày 1/7/2005. Ngày 29/12/2006, Công ty Nhiệt điện Bà Rịa đã hoàn thành công tác cổ phần hóa và chính thức chuyển đổi sang hình thức Công ty cổ phần với tên mới là Công ty Cổ phần Nhiệt điện Bà Rịa. BTP hiện đang quản lý vận hành 10 tổ máy phát điện với tổng công suất 389 MW. BTP chính thức được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2009.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2009-11-25","state":0.79562006,"foreign":0.01496634,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Phát điện 3 - Công ty Cổ phần","p":null,"t":"CORPORATE","q":48123557,"pct":79.562,"d":"2026-05-14"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":2977710,"pct":4.92,"d":"2025-11-21"},{"n":"Phạm Hữu Hạnh","p":null,"t":"INDIVIDUAL","q":8500,"pct":0.014,"d":"2015-09-14"},{"n":"Lưu Văn Hồng","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.007,"d":"2015-09-14"}],"rel":[{"c":"5300755748","n":"Công ty Cổ phần Simacai","t":"affiliate","pct":36.0},{"c":"BSA","n":"Công ty Cổ phần Thủy điện Buôn Đôn","t":"affiliate","pct":25.0}],"rel_count":2,"events":[{"c":"AGME","t":"BTP - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-17","record":"2026-04-01","ex":"2026-03-31"},{"c":"DDINS","t":"Samarang Ucits - Samarang Asian Prosperity - Đăng kí Bán BTP","d":"2025-11-21","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 330 VND","d":"2025-11-07","record":"2025-11-25","ex":"2025-11-24"},{"c":"DDINS","t":"Samarang Ucits - Samarang Asian Prosperity - Đăng kí Bán BTP","d":"2025-10-09","record":null,"ex":null},{"c":"DDINS","t":"Samarang Ucits - Samarang Asian Prosperity - Đăng kí Bán BTP","d":"2025-08-20","record":null,"ex":null},{"c":"AGME","t":"BTP - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-06","record":"2025-04-01","ex":"2025-03