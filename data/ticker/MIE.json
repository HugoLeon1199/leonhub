n, Hàn Quốc, Nga, Campuchia… MIE được giao dịch trên thị trường UPCOM từ cuối năm 2017.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2017-12-15","state":0.99572636,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":141384680,"pct":99.57,"d":"2026-01-08"},{"n":"Trần Quốc Toản","p":null,"t":"INDIVIDUAL","q":9600,"pct":0.007,"d":"2026-08-05"},{"n":"Hoàng Minh Việt","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.001,"d":"2025-10-05"},{"n":"Vũ Trung Thực","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":1300,"pct":0.001,"d":"2026-08-05"},{"n":"Đậu Huy Ngọc Linh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.001,"d":"2026-08-05"},{"n":"Nguyễn Hữu Hiển","p":"Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":500,"pct":0.0,"d":"2026-08-05"}],"rel":[{"c":"HAMECO","n":"Công Ty TNHH MTV Cơ Khí Hà Nội","t":"subsidiary","pct":100.0},{"c":"QTMECO","n":"Công Ty TNHH MTV Cơ Khí Quang Trung","t":"subsidiary","pct":100.0},{"c":"MECANIMEX","n":"Công Ty TNHH MTV Xuất Nhập Khẩu Sản Phẩm Cơ Khí","t":"subsidiary","pct":100.0},{"c":"TECHNOIMPORT","n":"Công ty TNHH MTV Xuất Nhập Khẩu Thiết Bị Toàn Bộ Và Kỹ Thuật","t":"subsidiary","pct":100.0},{"c":"DHMC","n":"Công ty Cổ Phần Cơ Khí Duyên Hải","t":"subsidiary","pct":98.189},{"c":"TOOLS1","n":"Công ty Cổ phần Dụng cụ Số 1","t":"subsidiary","pct":51.0},{"c":"0102276127","n":"Công ty Cổ Phần Đầu Tư Và Thương Mại Sài Gòn-hà Nội","t":"affiliate","pct":20.0}],"rel_count":7,"events":[{"c":"AGME","t":"MIE - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-22","record":"2026-05-25","ex":"2026-05-22"},{"c":"DDINS","t":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH - Đăng kí Mua MIE","d":"2026-01-08","record":null,"ex":null},{"c":"OTHE","t":"MIE - Thay đổi địa chỉ","d":"2025-08-25","record":null,"ex":null},{"c":"AGME","t":"MIE -