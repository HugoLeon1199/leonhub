thiết bị, kết cấu thép các công trình công nghiệp và dân dụng trong và ngoài nước. Từ khi thành lập công ty đã tham gia lắp đặt hơn 200 công trình lớn nhỏ trên khắp mọi miền đất nước, được các nhà đầu tư trong và ngoài nước đánh giá cao về chất lượng, tiến độ thi công và các dịch vụ bảo hành, bảo trì chu đáo. Năm 2006 công ty chuyển hoạt động sang mô hình Công ty cổ phần với vốn điều lệ ban đầu là 11,2 tỷ đồng. Thương hiệu LILAMA 45.4 luôn gắn liền với những công trình xây dựng có tầm cỡ quốc gia và góp phần quan trọng vào sự nghiệp đổi mới, công nghiệp hóa – hiện đại hóa đất nước.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2009-12-21","state":0.3505865,"foreign":0.010825,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty lắp máy Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":1402346,"pct":35.06,"d":"2026-06-04"},{"n":"Phan Phúc Doãn","p":null,"t":"INDIVIDUAL","q":198300,"pct":4.982,"d":"2015-09-14"},{"n":"Phạm Văn Vĩnh","p":null,"t":"INDIVIDUAL","q":178700,"pct":4.49,"d":"2025-10-05"},{"n":"Hoàng Tuấn Anh","p":null,"t":"INDIVIDUAL","q":150000,"pct":3.77,"d":"2025-10-05"},{"n":"Nguyễn Bá Sứng","p":null,"t":"INDIVIDUAL","q":99300,"pct":2.49,"d":"2025-10-05"},{"n":"Hoàng Văn Dư","p":null,"t":"INDIVIDUAL","q":80000,"pct":2.01,"d":"2025-10-05"},{"n":"Đặng Tiến Toàn","p":null,"t":"INDIVIDUAL","q":41176,"pct":1.035,"d":"2015-09-14"},{"n":"Đặng Văn Phúc","p":null,"t":"INDIVIDUAL","q":32000,"pct":0.804,"d":"2015-09-14"},{"n":"Nguyễn Kim Tuấn","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.503,"d":"2015-09-14"},{"n":"Đào Văn Cường","p":null,"t":"INDIVIDUAL","q":18880,"pct":0.474,"d":"2015-09-14"},{"n":"Phạm Đình San","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.251,"d":"2015-09-14"},{"n":"Vũ Thế Phương","p":null,"t":"INDIVIDUAL","q":6608,"pct":0.166,"d":"2025-10-05"},{"n":"Tạ Văn Hùng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.13,"d":"2025-10-05"},{"n":"Nguyễn Văn Hiển","p":null,"t":"INDIVIDUAL","q":2600,