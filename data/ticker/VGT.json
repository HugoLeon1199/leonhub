oàn Dệt May Việt Nam – chính thức hoạt động theo mô hình công ty cổ phần vào năm 2015. Vinatex giữ vị trí dẫn đầu trong ngành dệt may Việt Nam với công suất thiết kế khoảng 190.000 tấn sợi/năm, 410 triệu sản phẩm may/năm và hệ thống thiết bị được đầu tư từ nhiều thị trường công nghiệp dệt may phát triển. Cổ phiếu của Vinatex được giao dịch trên thị trường UPCOM từ đầu năm 2017.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2017-01-03","state":0.5348762,"foreign":0.14038794,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":267438100,"pct":53.49,"d":"2026-08-13"},{"n":"Itochu Corporation","p":null,"t":"CORPORATE","q":65000000,"pct":13.0,"d":"2026-06-01"},{"n":"Bùi Mạnh Hưng","p":null,"t":"INDIVIDUAL","q":24800000,"pct":4.96,"d":"2025-10-05"},{"n":"Nguyễn Xuân Đông","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":15040000,"pct":3.008,"d":"2026-08-13"},{"n":"Trần Quang Nghị","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":10003900,"pct":2.001,"d":"2026-08-13"},{"n":"Balestrand Limited","p":null,"t":"CORPORATE","q":5000000,"pct":1.0,"d":"2025-10-05"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":4846000,"pct":0.96,"d":"2025-10-05"},{"n":"Grinling International Limited","p":null,"t":"CORPORATE","q":4000000,"pct":0.8,"d":"2025-10-05"},{"n":"Wareham Group Limited","p":null,"t":"CORPORATE","q":4000000,"pct":0.8,"d":"2025-10-05"},{"n":"Veil Holdings Limited","p":null,"t":"CORPORATE","q":3000000,"pct":0.6,"d":"2025-10-05"},{"n":"Cao Hữu Hiếu","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3300,"pct":0.001,"d":"2026-08-13"},{"n":"Lê Mạc Thuấn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5100,"pct":0.001,"d":"2026-08-13"},{"n":"Lê Tiến Trường","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5500,"pct":0.001,"d":"2026-08-13"},{"n":"Lê Trung Hải","p":null,"t":"INDIVIDUAL","q":3100