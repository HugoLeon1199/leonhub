1.728],["2025",-1.407]]}},"co":{"short":"Thương mại Hà Nội - Hapro","profile":"Tổng Công ty Thương mại Hà Nội (HTM) là doanh nghiệp nhà nước được thành lập vào năm 2004 theo Quyết định số 125/2004/QD-UBND của UBND Thành phố Hà Nội. Tổng Công ty hoạt động chính trong lĩnh vực kinh doanh xuất nhập khẩu, thương mại nội địa và đầu tư phát triển hạ tầng thương mại. Thị trường xuất khẩu của Tổng công ty được duy trì và mở rộng tới trên 70 nước và khu vực trên thế giới. Trong lĩnh vực kinh doanh thương mại nội địa, TCT đã tập trung phát triển hệ thống Siêu thị, cửa hàng tiện ích mang thương hiệu HaproMart, hệ thống thực phẩm an toàn HaproFood, hệ thống cửa hàng chuyên doanh các loại mang thương hiệu con, thương hiệu nhánh khác nhau. HTM được giao dịch trên thị trường UPCOM từ tháng 05/2018.","sector":"Bán lẻ","type":"CT","listed":"2018-05-04","state":0.0,"foreign":6.93e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Motor N.a Việt Nam","p":null,"t":"CORPORATE","q":143000000,"pct":65.0,"d":"2026-08-04"},{"n":"Công ty CP Thương Mại Dịch Vụ Hòa Hải","p":null,"t":"CORPORATE","q":34758469,"pct":15.8,"d":"2026-02-09"},{"n":"Công Ty TNHH Thương Mại Ô Tô Thành Công","p":null,"t":"CORPORATE","q":23223125,"pct":10.56,"d":"2026-04-28"},{"n":"Lê Anh Tuấn","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.001,"d":"2026-02-09"},{"n":"Nguyễn Thu Hằng","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.001,"d":"2026-05-15"},{"n":"Đỗ Tuệ Tâm","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2000,"pct":0.001,"d":"2026-08-04"},{"n":"Nguyễn Tiến Vượng","p":null,"t":"INDIVIDUAL","q":600,"pct":0.0,"d":"2025-10-05"},{"n":"Nguyễn Tiến Vượng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":600,"pct":0.0,"d":"2019-11-27"}],"rel":[{"c":"0800009770","n":"Công ty Cổ Phần Công Nghệ Phẩm Hải Dương","t":"subsidiary","pct":93.51},{"c":"0102544224","n":"Công ty Cổ Phần Đầu Tư Phát Triển Hạ Tầng Thương Mại Hà Nội","t":"affiliate","pct":92.41},{"c":"0102544224","n":"Công ty C