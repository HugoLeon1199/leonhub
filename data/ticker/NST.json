hác. Hàng năm Xí nghiệp chế biến nguyên liệu thực hiện gia công cho khách hàng trong nước khoảng 4.000 tấn/năm, chế biến nguyên liệu tách cọng phục vụ nội tiêu và xuất khẩu khoảng 1.500 đến 2.000 tấn. Ngày 29/12/2006, NST chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2006-12-29","state":0.57700297,"foreign":0.01622121,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"TỔNG CÔNG TY THUỐC LÁ VIỆT NAM - CÔNG TY TNHH MỘT THÀNH VIÊN","p":null,"t":"CORPORATE","q":6463589,"pct":57.7,"d":"2026-03-02"},{"n":"Công ty TNHH Một thành viên Thuốc lá Thăng Long","p":null,"t":"CORPORATE","q":722640,"pct":6.451,"d":"2026-03-02"},{"n":"Công ty TNHH MTV Thuốc lá Sài Gòn","p":null,"t":"CORPORATE","q":681346,"pct":6.082,"d":"2026-03-02"},{"n":"Công Ty TNHH Một Thành Viên Viện Thuốc Lá","p":null,"t":"CORPORATE","q":566101,"pct":5.054,"d":"2026-03-02"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":555100,"pct":4.96,"d":"2025-10-05"},{"n":"Công ty TNHH Một Thành Viên Thuốc Lá Thanh Hoá","p":null,"t":"CORPORATE","q":436468,"pct":3.896,"d":"2026-03-02"},{"n":"Đào Mạnh Thái","p":null,"t":"INDIVIDUAL","q":60053,"pct":0.633,"d":"2015-09-14"},{"n":"Công Ty TNHH Một Thành Viên Thuốc Lá Bắc Sơn.","p":null,"t":"CORPORATE","q":25902,"pct":0.23,"d":"2026-03-02"},{"n":"Trần Đăng Tuyết","p":null,"t":"INDIVIDUAL","q":11160,"pct":0.1,"d":"2025-10-05"},{"n":"Nguyễn Hữu Toàn","p":null,"t":"INDIVIDUAL","q":4247,"pct":0.045,"d":"2015-09-14"},{"n":"Trần Xuân Thịnh","p":null,"t":"INDIVIDUAL","q":4304,"pct":0.045,"d":"2015-09-14"},{"n":"Nguyễn Thị Lan Anh","p":"Phó Giám đốc","t":"INDIVIDUAL","q":4309,"pct":0.04,"d":"2026-08-13"},{"n":"Trần Đăng Kiên","p":null,"t":"INDIVIDUAL","q":3263,"pct":0.034,"d":"2015-09-14"},{"n":"Đặng Xuân Phương","p":null,"t":"INDIVIDUAL","q":2891,"pct":0.03,"d":"2015-09-14"},{"n":"Nguyễn Chí Thanh","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":3290,"pc