 thành lập năm 1971. Năm 2017, TQW cổ phần hóa và đổi tên thành Công ty Cổ phần Cấp thoát nước Tuyên Quang. TQW chuyên khai thác, xử lý và cung cấp nước sạch trên địa bàn tỉnh Tuyên Quang. Xét trên bình diện toàn Tỉnh, thì Công ty Cổ phần Cấp thoát nước Tuyên Quang là doanh nghiệp chủ lực, kinh doanh và bán nước sạch phục vụ nhu cầu tiêu dùng trong Tỉnh. Một số Công trình mà công ty đã thực hiện như: Trạm Xử lý nước mặt công suất 5.000m3/ngày đêm trị giá 13,2 tỷ đồng; Công trình Xây dựng nhà trực, giếng khoan, hệ lọc trị giá 1,04 tỷ đồng...Ngày 14/06/2019, TQW chính thức giao dịch trên thị trường UPCOM.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2019-06-14","state":0.68656249,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Tuyên Quang","p":null,"t":"CORPORATE","q":6133200,"pct":68.656,"d":"2026-08-21"},{"n":"Nguyễn Hữu Tuấn","p":null,"t":"INDIVIDUAL","q":814400,"pct":9.12,"d":"2025-10-13"},{"n":"Hoàng Quang Huy","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":814400,"pct":9.117,"d":"2026-08-21"},{"n":"Lê Văn Hoành","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":47500,"pct":0.532,"d":"2026-08-21"},{"n":"Trần Thị Khánh","p":"Thành viên Hội đồng Quản trị/Kế toán trưởng","t":"INDIVIDUAL","q":46300,"pct":0.518,"d":"2026-08-21"},{"n":"Lê Văn Hải","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":40000,"pct":0.448,"d":"2026-08-21"},{"n":"Đinh Tiến Dũng","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":6600,"pct":0.074,"d":"2026-08-21"},{"n":"Đinh Đức Tùng","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":2800,"pct":0.031,"d":"2026-08-21"},{"n":"Nguyễn Quang Huy","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":2200,"pct":0.025,"d":"2026-08-27"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 620 VND","d":"2026-07-30","record":"2026-08-10","ex":"2026-08-07"},{"c":"AGME","t":"TQW - Tổ chức ĐHĐCĐ thường niên 20