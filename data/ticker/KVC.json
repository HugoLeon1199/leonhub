ên thế giới như Jindan Stainless Steel Ltd (Ấn Độ), Fujian Wuhang Stainless Steel (Trung Quốc), Acerinox, Posco VST...Ngày 25/05/2023, KVC chính thức giao dịch trên thị trường UPCOM.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2015-04-14","state":0.0,"foreign":0.0066836,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Đăng Quang","p":null,"t":"INDIVIDUAL","q":2277800,"pct":4.6,"d":"2025-10-05"},{"n":"Nguyễn Tuấn Anh","p":null,"t":"INDIVIDUAL","q":2200000,"pct":4.44,"d":"2025-10-05"},{"n":"Đỗ Hùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1100000,"pct":2.22,"d":"2025-10-05"},{"n":"Đỗ Hòa","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":400000,"pct":0.81,"d":"2025-10-05"},{"n":"Đỗ Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":200000,"pct":0.4,"d":"2026-01-22"},{"n":"Trần Thị Quỳnh Anh","p":null,"t":"INDIVIDUAL","q":69400,"pct":0.14,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Chi","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.02,"d":"2025-10-05"},{"n":"Trần Trung Nghĩa","p":"Kế toán trưởng/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":10000,"pct":0.02,"d":"2025-10-05"},{"n":"Lưu Xuân","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.01,"d":"2026-01-22"},{"n":"Nguyễn Tăng Minh Đức","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1000,"pct":0.002,"d":"2025-10-05"},{"n":"Nguyễn Đài Trang","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1000,"pct":0.002,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"KVC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-19","record":"2026-04-16","ex":"2026-04-15"},{"c":"AGME","t":"KVC - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-11","record":"2025-05-26","ex":"2025-05-23"},{"c":"AGME","t":"KVC - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-13","record":"2024-03-29","ex":"2024-03-28"},{"c":"MOVE","t":"KVC - Chuyển sàn từ HNX sang UPCoM","d":"2023-05-19","record":null,"ex":null},{"c":"SUSP","t":"KVC - Hủy niêm yết cổ phiếu trên sà