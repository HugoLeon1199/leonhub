. Hiện tại công ty đang hoạt động trong lĩnh vực kinh doanh vận tải hành khách bằng taxi dùng nguyên liệu LPG/CNG (tại Thành phố Hồ Chí Minh và Thành phố Vũng Tàu); cho thuê xe văn phòng với 185 đầu xe, vận chuyển LPG bằng đường bộ (05 xe bồn). PCT đang sở hữu, quản lý khai thác đội tàu biển, sà lan hàng rời trọng tải 1.000 DWT – 25.000 DWT hoạt động trong nước và quốc tế và đang tham gia vận tải hàng hóa, thiết bị cho các nhà máy Nhiệt điện khu vực Miền Trung và Miền Nam. Ngày 12/09/2011, PCT chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2011-09-12","state":0.0,"foreign":9e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Cao Đức Sơn","p":null,"t":"INDIVIDUAL","q":11788280,"pct":23.56,"d":"2026-02-25"},{"n":"Lương Diệu Linh","p":null,"t":"INDIVIDUAL","q":18691200,"pct":23.35,"d":"2026-05-04"},{"n":"Đặng Nguyên Đăng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":10794000,"pct":21.57,"d":"2026-08-06"},{"n":"Trần Vọng Phúc","p":null,"t":"INDIVIDUAL","q":16073052,"pct":20.1,"d":"2026-04-01"},{"n":"Trần Xuân Thành","p":null,"t":"INDIVIDUAL","q":4500000,"pct":19.565,"d":"2015-09-14"},{"n":"Trần Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":14655280,"pct":18.3,"d":"2026-04-01"},{"n":"Nguyễn Thị Phượng","p":null,"t":"INDIVIDUAL","q":11788280,"pct":14.73,"d":"2026-08-26"},{"n":"Nguyễn Duyên Hiếu","p":null,"t":"INDIVIDUAL","q":1500000,"pct":6.522,"d":"2015-09-14"},{"n":"Ngân hàng Thương mại Cổ phần Đại chúng Việt Nam","p":null,"t":"CORPORATE","q":1066300,"pct":4.636,"d":"2015-06-15"},{"n":"Nguyễn Hồng Hiệp","p":null,"t":"INDIVIDUAL","q":2258320,"pct":4.51,"d":"2025-10-05"},{"n":"Vũ Thị Thanh Thanh","p":null,"t":"INDIVIDUAL","q":3298160,"pct":4.1,"d":"2026-04-01"},{"n":"Công ty Cổ phần Thương mại và Vận tải Sông Đà","p":null,"t":"CORPORATE","q":103220,"pct":0.449,"d":"2015-06-15"},{"n":"Lê Thanh Sơn","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.04,"d":"20