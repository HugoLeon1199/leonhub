2025",1.792]]}},"co":{"short":"Tứ Hải Hà Nam","profile":"Công ty Cổ phần Tứ Hải Hà Nam (THM) là một doanh nghiệp hoạt động trong ngành dệt may được thành lập từ năm 2010. Công ty chuyên cung cấp dịch vụ may đo, gia công số lượng lớn cho các thương hiệu nước ngoài. THM sở hữu 10 dây chuyền sản xuất, công suất ước tính 3 triệu sản phẩm/năm. Các sản phẩm chính của công ty là Áo Jacket và quần Soóc. Các sản phẩm của công ty hiện đang được xuất khẩu sang các nước EU, Mỹ, Hàn Quốc, ... với các đối tác như Zara, Bershka, Pull&Bear, Robinson, Delaney,... THM chính thức được giao dịch tại thị trường UPCoM từ ngày 18/10/2023.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2023-10-18","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Appatex","p":null,"t":"CORPORATE","q":7969500,"pct":65.58,"d":"2026-07-29"},{"n":"Nguyễn Thị Hương","p":"Kế toán trưởng","t":"INDIVIDUAL","q":26400,"pct":0.22,"d":"2026-03-03"}],"events":[{"c":"EGME","t":"THM - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-08-06","record":"2026-08-18","ex":"2026-08-17"},{"c":"DDINS","t":"Công ty Cổ Phần Appatex - Đăng kí Bán 4,500,000 THM","d":"2026-07-28","record":null,"ex":null},{"c":"AGME","t":"THM - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-26","record":"2026-06-04","ex":"2026-06-03"},{"c":"OTHE","t":"THM - Thay đổi địa chỉ","d":"2025-08-04","record":null,"ex":null},{"c":"EGME","t":"THM - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-07-25","record":"2025-08-11","ex":"2025-08-08"},{"c":"AGME","t":"THM - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-14","record":"2025-03-27","ex":"2025-03-26"},{"c":"DDINS","t":"Công ty Cổ Phần Appatex - Đăng kí Bán 1,500,000 THM","d":"2025-02-24","record":null,"ex":null},{"c":"AIS","t":"THM - Đăng ký giao dịch bổ sung 1.104.800 cổ phiếu","d":"2024-09-24","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Thị Hương - Đăng kí Bán 24,000 THM","d":"2024-08-20","record":null,"ex":null},{"c":"ISS","t":"Phát