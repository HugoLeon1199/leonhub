3",5.514],["2024",6.964],["2025",14.883]]}},"co":{"short":"Tập đoàn Đầu tư BIG","profile":"Công ty Cổ phần Tập đoàn Đầu tư BIG (BIG), thành lập năm 2017 từ tiền thân là Công ty Cổ phần Thiết bị Công nghệ Nam Sơn, hiện hoạt động trong bốn lĩnh vực chính: nông sản, bất động sản, thương mại và tài chính – công nghệ. Công ty duy trì hoạt động cho thuê văn phòng, căn hộ, khách sạn tại một số thành phố lớn; kinh doanh nông sản, vật liệu xây dựng, thép và thiết bị máy móc; đồng thời tham gia đầu tư, M&A và nghiên cứu ứng dụng công nghệ mới. BIG cũng thường xuyên tổ chức các hội nghị về bất động sản và kinh doanh từ năm 2019. Ngày 10/01/2022, BIG chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2022-01-10","state":0.0,"foreign":0.02709914,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap","ff":0.35,"fmax":0.49,"liq":2.418,"icb2":"3500","icb4":"3573"},"owners":[{"n":"Võ Phi Nhật Huy","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":6219021,"pct":20.01,"d":"2026-07-22"},{"n":"Nguyễn Ngọc Nhi","p":null,"t":"INDIVIDUAL","q":1500014,"pct":4.83,"d":"2026-06-12"},{"n":"Công ty TNHH Công Nghệ Y Tế Metacare","p":null,"t":"CORPORATE","q":790000,"pct":2.542,"d":"2026-03-20"},{"n":"Kiều Văn Khoa","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":691607,"pct":2.02,"d":"2026-07-07"},{"n":"Lương Hoàng Hưng","p":null,"t":"INDIVIDUAL","q":244795,"pct":0.788,"d":"2026-03-20"},{"n":"Công ty CP Huy Hoàng Holding","p":null,"t":"CORPORATE","q":240000,"pct":0.772,"d":"2026-03-20"},{"n":"Nguyễn Thị Hảo","p":null,"t":"INDIVIDUAL","q":112930,"pct":0.71,"d":"2026-03-03"},{"n":"Tấn Lộc Louis","p":null,"t":"INDIVIDUAL","q":111544,"pct":0.7,"d":"2026-05-14"},{"n":"Công ty Cổ phần Dược Lâm Đồng - Ladophar","p":null,"t":"CORPORATE","q":201000,"pct":0.647,"d":"2026-03-20"},{"n":"Công ty CP Đầu Tư Blc","p":null,"t":"CORPORATE","q":171600,"pct":0.552,"d":"2026-03-20"},{"n":"Kim Thị Vân","p":null,"t":"INDIVIDUAL","q":