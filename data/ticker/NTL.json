2023",29.972],["2024",47.111],["2025",-2.44]]}},"co":{"short":"Đô thị Từ Liêm","profile":"Công ty Cổ phần Phát triển Đô thị Từ Liêm (NTL), tiền thân là Xí nghiệp Xây dựng Từ Liêm được thành lập từ năm 1974. Năm 2004, chuyển đổi sang hoạt động theo mô hình cổ phần. Năm 2007 đổi tên thành Công ty cổ phần phát triển đô thị Từ liêm và cổ phiếu của Công ty niêm yết trên HOSE. Hoạt động kinh doanh chính của công ty là xây lắp và đầu tư kinh doanh dự án các khu đô thị, khu công nghiệp. Công ty đã và đang thực hiện nhiều dự án lớn như khu đô thị mới Dịch Vọng, dự án khu đô thị phía Bắc quốc lộ 32 thị trấn Trạm Trôi; Dự án Chung cư LIDECO Hạ Long với tổng mức đầu tư 915 tỷ đồng; Dự án Khu đô thị mới tại khu vực Núi Hạm - Hạ Long với tổng diện tích 68ha... Trải qua hơn 40 năm xây dựng, phát triển và trưởng thành, đến nay quy mô tổ chức hoạt động của Công ty đã được nâng lên tầm cao mới và hoạt động theo mô hình Công ty kinh doanh đa ngành nghề. Ngày 21/12/2007, NTL chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bất động sản","type":"CT","listed":"2007-12-21","state":0.0,"foreign":0.13109982,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đinh Quang Chiến","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":18000000,"pct":14.76,"d":"2026-08-04"},{"n":"Vũ Gia Cường","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":7386624,"pct":6.05,"d":"2026-08-04"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":6100000,"pct":5.0,"d":"2025-10-05"},{"n":"Asiavantage Global Limited","p":null,"t":"CORPORATE","q":2899210,"pct":4.559,"d":"2015-06-15"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":2800810,"pct":4.404,"d":"2015-06-15"},{"n":"Quỹ Đầu tư Tăng trưởng Việt Nam (VF2)","p":null,"t":"CORPORATE","q":2746690,"pct":4.319,"d":"2015-06-15"},{"n":"Nguyễn Thị Mai","p":null,"t":"INDIVIDUAL","q":3862880,"pct":3.17,"d":"2026-08-04"},{"n":"Lê Minh Tuân","p":"Chủ tịch H