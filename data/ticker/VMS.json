ên thế giới chọn Vimadeco là đối tác chiến lược duy nhất làm đại lý tại Việt Nam như Trans America, Seacube, Gold...Ngoài ra còn rất nhiều hãng lớn chọn Vimadeco làm đại lý như Klines, Dongfeng, Cronos,…Ngày 20/10/2015, VMS chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2015-10-20","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Vận Tải Container Vimc","p":null,"t":"CORPORATE","q":4590000,"pct":51.0,"d":"2026-07-07"},{"n":"Công ty TNHH Đầu tư TM","p":null,"t":"CORPORATE","q":1150000,"pct":12.78,"d":"2026-08-11"},{"n":"Công ty Cổ phần Đầu Tư Sao Á D.C","p":null,"t":"CORPORATE","q":534800,"pct":5.94,"d":"2026-08-07"},{"n":"Đào Hồng Chương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":499300,"pct":5.55,"d":"2026-09-03"},{"n":"Hoàng Thuỳ Dương","p":null,"t":"INDIVIDUAL","q":442500,"pct":4.92,"d":"2026-07-07"},{"n":"Bùi Thị Phương Thảo","p":null,"t":"INDIVIDUAL","q":400900,"pct":4.45,"d":"2026-07-07"},{"n":"Công ty Cổ Phần Bất Động Sản Macland","p":null,"t":"CORPORATE","q":329300,"pct":3.66,"d":"2026-07-07"},{"n":"Nguyễn Cao Thắng","p":null,"t":"INDIVIDUAL","q":35000,"pct":0.38,"d":"2026-09-03"},{"n":"Nguyễn Chí Kiên","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":17500,"pct":0.19,"d":"2026-09-03"},{"n":"Phạm Quốc Hùng","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":25,"pct":0.0,"d":"2026-09-03"}],"rel":[{"c":"VNLSHIP","n":"Công ty Cổ phần Cảng Quốc Tế Qtm","t":"affiliate","pct":2.24}],"rel_count":1,"events":[{"c":"DDINS","t":"Công ty TNHH Đầu tư TM - Đăng kí Bán VMS","d":"2026-08-11","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Đầu Tư Sao Á D.C - Đăng kí Mua VMS","d":"2026-08-07","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 650 VND","d":"2026-06-19","record":"2026-06-30","ex":"2026-06-29"},{"c":"AGME","t":"VMS - Tổ chức ĐHĐCĐ thường niên 202