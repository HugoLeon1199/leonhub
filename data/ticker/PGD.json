en biển, các đảo ngoài khơi. Ngày 26/11/2009, PGD chính thức giao dịch trên Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE);","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2009-11-26","state":0.50500885,"foreign":0.46414795,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Khí Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":49995000,"pct":50.5,"d":"2026-02-09"},{"n":"Tokyo Gas Asia Pte. Ltd.","p":null,"t":"CORPORATE","q":24749732,"pct":25.0,"d":"2025-10-05"},{"n":"Saibu Gas Co., Ltd.","p":null,"t":"CORPORATE","q":20789775,"pct":21.0,"d":"2026-02-02"},{"n":"Công ty Cổ phần Chứng khoán SBS","p":null,"t":"CORPORATE","q":2350087,"pct":2.611,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Thương Mại Tổng Hợp Tỉnh Bà Rịa-vũng Tàu","p":null,"t":"CORPORATE","q":318980,"pct":0.354,"d":"2025-10-05"},{"n":"Nguyễn Văn Sơn","p":null,"t":"INDIVIDUAL","q":92987,"pct":0.155,"d":"2025-10-05"},{"n":"Nguyễn Như Song","p":null,"t":"INDIVIDUAL","q":63248,"pct":0.105,"d":"2025-10-05"},{"n":"Phạm Văn Huệ","p":null,"t":"INDIVIDUAL","q":36400,"pct":0.061,"d":"2015-09-14"},{"n":"Nguyễn Nhật Quốc Toản","p":null,"t":"INDIVIDUAL","q":10688,"pct":0.011,"d":"2026-02-09"},{"n":"Trần Thị Thu Hiền","p":null,"t":"INDIVIDUAL","q":6505,"pct":0.011,"d":"2015-09-14"},{"n":"Vũ Quý Hiệu","p":null,"t":"INDIVIDUAL","q":5250,"pct":0.009,"d":"2015-09-14"},{"n":"Nguyễn Phương Thúy","p":null,"t":"INDIVIDUAL","q":7507,"pct":0.008,"d":"2025-10-05"},{"n":"Lê Quyết Thắng","p":null,"t":"INDIVIDUAL","q":3137,"pct":0.005,"d":"2015-09-14"},{"n":"Nguyễn Quang Huy","p":null,"t":"INDIVIDUAL","q":679,"pct":0.001,"d":"2025-12-24"},{"n":"Bùi Kim Hạnh","p":null,"t":"INDIVIDUAL","q":4,"pct":0.0,"d":"2015-09-14"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,000 VND","d":"2026-07-15","record":"2026-09-25","ex":"2026-09-24"},{"c":"AGME","t":"PGD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-17","record":"2026-05-05","ex":"2026-05-04"},