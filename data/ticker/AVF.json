"2023",0.0],["2024",0.0],["2025",0.0]]}},"co":{"short":"Thủy sản Việt An","profile":"<DIV style=\"FONT-FAMILY: Arial; FONT-SIZE: 10pt;\"> <P>Công ty Cổ phần Việt An tiền thân là Công ty TNHH Angiang - Basa được thành lập năm 2004. Vốn điều lệ hiện tại là&nbsp;433,38 tỷ đồng. Hoạt động kinh doanh của Công ty tập trung chủ yếu vào sản xuất chế biến xuất khẩu các sản phẩm từ cá tra như cá tra fillet, các tra cắt khúc, cá tra nguyên con cấp đông... Trong đó doanh thu các tra fillet chiếm tới 90% doanh thu trung bình hàng năm của Công ty. Công ty là doanh nghiệp có quy mô lớn&nbsp;ở Đồng bằng sông Cửu Long với 2 xí nghiệp chế biến là An Thịnh (công suất 100 tấn/ngày) và Việt Thắng (công suất 150 tấn/ngày) và có 1 vùng nuôi cá tra (hơn 17 ha) và 5 vùng liên kết. Công ty còn sở hữu hệ thống kho lạnh với công suất 40.000 tấn tại Khu công nghiệp&nbsp;Long Hậu. </P></DIV>","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2010-11-23","state":0.0,"foreign":0.00210234,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Văn Lợi","p":null,"t":"INDIVIDUAL","q":5660950,"pct":13.06,"d":"2025-10-05"},{"n":"Công ty Cổ phần Thủy Sản Ba","p":null,"t":"CORPORATE","q":4339910,"pct":10.014,"d":"2015-06-15"},{"n":"Nguyễn Anh Đĩnh","p":null,"t":"INDIVIDUAL","q":2337500,"pct":5.39,"d":"2025-10-05"},{"n":"Ngô Văn Thu","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1079900,"pct":2.49,"d":"2025-10-05"},{"n":"Nguyễn Thị Phương Song","p":null,"t":"INDIVIDUAL","q":783930,"pct":1.809,"d":"2015-09-14"},{"n":"Lê Thị Lài","p":null,"t":"INDIVIDUAL","q":658436,"pct":1.519,"d":"2015-09-14"},{"n":"Lê Thị Lệ Thủy","p":null,"t":"INDIVIDUAL","q":423375,"pct":0.977,"d":"2015-09-14"},{"n":"Phùng Hoàng Trâm Anh","p":null,"t":"INDIVIDUAL","q":383700,"pct":0.885,"d":"2015-09-14"},{"n":"Nguyễn Thị Thanh Giang","p":null,"t":"INDIVIDUAL","q":254045,"pct":0.586,"d":"2015-09-14"},{"n":"Công ty Cổ phần Chứng khoán BIDV","p":null,"t":"CORPORATE","q":197435,"pc