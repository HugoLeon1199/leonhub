, đào tạo và sát hạch lái xe, dịch vụ sửa chữa và đóng mới các loại xe.","sector":"Du lịch và Giải trí","type":"CT","listed":"2016-11-21","state":0.49,"foreign":1.667e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cơ khí Giao thông Vận tải Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":29400000,"pct":49.0,"d":"2025-10-05"},{"n":"Vũ Duy Anh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":201200,"pct":0.34,"d":"2026-01-12"},{"n":"Đoàn Minh Tâm","p":null,"t":"INDIVIDUAL","q":206900,"pct":0.34,"d":"2025-10-05"},{"n":"Trần Thị Thanh Trúc","p":null,"t":"INDIVIDUAL","q":20200,"pct":0.03,"d":"2025-10-05"},{"n":"Nguyễn Hồ Minh","p":null,"t":"INDIVIDUAL","q":6800,"pct":0.01,"d":"2026-02-11"},{"n":"Nguyễn Tuấn Việt","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.007,"d":"2026-01-12"},{"n":"Trần Kim Tuyến","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2100,"pct":0.004,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"BSG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-19","record":"2026-06-03","ex":"2026-06-02"},{"c":"OTHE","t":"BSG - Thay đổi địa chỉ","d":"2025-10-09","record":null,"ex":null},{"c":"EGME","t":"BSG - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-10-08","record":"2025-10-23","ex":"2025-10-22"},{"c":"DDIND","t":"Nguyễn Hồ Minh - Đăng kí Bán 200,000 BSG","d":"2025-06-16","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ Phần Tập Đoàn Tân Thành Đô - Đăng kí Bán BSG","d":"2025-05-26","record":null,"ex":null},{"c":"DDRP","t":"Nguyễn Văn Thành - Đăng kí Bán 4,500,000 BSG","d":"2025-05-23","record":null,"ex":null},{"c":"DDRP","t":"Phạm Anh Hưng - Đăng kí Bán 9,000,000 BSG","d":"2025-05-23","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ Phần Tập Đoàn Tân Thành Đô - Đăng kí Bán 14,427,400 BSG","d":"2025-05-14","record":null,"ex":null},{"c":"AGME","t":"BSG - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-19","record":"2025-03-24","ex":"2025-03-21"},{"c":"AGME","t":"BSG - Tổ chức ĐHĐCĐ thường ni