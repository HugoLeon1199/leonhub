 thị trường. Bên cạnh đó, hệ thống kho bãi rộng lớn cùng với các bến cảng chuyên dụng cũng là những lợi thế cạnh tranh của CMP. Với vị trí địa lý thuận lợi, nằm trên tuyến hành lang kinh tế Đông - Tây, CMP sẵn có nguồn hàng hóa dồi dào từ các tỉnh thành lân cận như Thừa Thiên Huế, Quảng Trị, Quảng Bình. CMP chính thức giao dịch trên thị trường UPCOM từ năm 2006.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-02-15","state":0.9888602,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Công Nghiệp Tàu Thủy","p":null,"t":"CORPORATE","q":32044425,"pct":98.89,"d":"2025-10-05"},{"n":"Trần Văn Phong","p":null,"t":"INDIVIDUAL","q":8295,"pct":0.026,"d":"2025-11-12"},{"n":"Hồ Hoàng Thi","p":"Phó Tổng Giám đốc/Phó Tổng Giám đốc Tài chính","t":"INDIVIDUAL","q":6615,"pct":0.02,"d":"2025-11-12"},{"n":"Huỳnh Văn Toàn","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":6300,"pct":0.019,"d":"2025-10-05"},{"n":"LÊ VĂN TIẾN","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":5670,"pct":0.017,"d":"2025-10-05"},{"n":"Nguyễn Hữu Thọ","p":null,"t":"INDIVIDUAL","q":4500,"pct":0.015,"d":"2025-10-05"},{"n":"Lê Chí Phai","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2625,"pct":0.008,"d":"2025-11-12"},{"n":"Lê Thị Ni Na","p":null,"t":"INDIVIDUAL","q":2730,"pct":0.008,"d":"2025-10-05"},{"n":"Nguyễn Thị Thúy Diệu","p":null,"t":"INDIVIDUAL","q":2520,"pct":0.008,"d":"2025-10-05"},{"n":"NGÔ KHÁNH TOÀN","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1995,"pct":0.006,"d":"2025-10-05"},{"n":"Nguyễn Thành Công","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1890,"pct":0.006,"d":"2025-10-05"},{"n":"Nguyễn Văn Chương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1890,"pct":0.006,"d":"2025-10-05"},{"n":"Phan Tuấn Anh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":1680,"pct":0.005,"d":"2025-10-05"},{"n":"Hồ Anh Hùng","p":null,"t":"INDIVIDUAL","q":1260,"pct":0.004,"d":"2025-10-05"},{"n":"Nguyễn Thị Tố Trinh","p":n