 sản phẩm săm lốp ô tô, xe máy, xe đạp. SRC chính thức hoạt động theo hình thức công ty cổ phần từ tháng 04/2006. Công ty đã xây dựng được hệ thống phân phối rộng với khoảng 157 nhà phân phối nội địa, và hệ thống phân phối khác tại các nước Angola, Campuchia, Philippines, Ai Cập, Mỹ, Bangladesh. SRC được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2009.","sector":"Ô tô và phụ tùng","type":"CT","listed":"2009-10-07","state":0.3600292,"foreign":0.00072741,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cp Tập Đoàn Hoành Sơn","p":null,"t":"CORPORATE","q":18321277,"pct":50.22,"d":"2026-07-30"},{"n":"Tập đoàn Hóa chất Việt Nam","p":null,"t":"CORPORATE","q":13135349,"pct":36.0,"d":"2026-07-30"},{"n":"Nguyễn Tiến Ngọc","p":null,"t":"INDIVIDUAL","q":1385430,"pct":4.94,"d":"2025-10-05"},{"n":"Hồ Viết Hùng","p":null,"t":"INDIVIDUAL","q":359000,"pct":1.28,"d":"2025-10-05"},{"n":"Lê Công An","p":null,"t":"INDIVIDUAL","q":104649,"pct":0.522,"d":"2015-09-14"},{"n":"Nguyễn Gia Tường","p":null,"t":"INDIVIDUAL","q":99998,"pct":0.499,"d":"2015-09-14"},{"n":"Đào Thị Hoa","p":null,"t":"INDIVIDUAL","q":100118,"pct":0.49,"d":"2025-10-05"},{"n":"Nguyễn Thị Hợp","p":null,"t":"INDIVIDUAL","q":43105,"pct":0.215,"d":"2015-09-14"},{"n":"Mai Chiến Thắng","p":null,"t":"INDIVIDUAL","q":51571,"pct":0.18,"d":"2025-10-05"},{"n":"Lê Văn Cường","p":null,"t":"INDIVIDUAL","q":13639,"pct":0.068,"d":"2025-10-05"},{"n":"Nguyễn Văn Thịnh","p":null,"t":"INDIVIDUAL","q":11536,"pct":0.06,"d":"2025-10-05"},{"n":"Phạm Quang Rong","p":null,"t":"INDIVIDUAL","q":7499,"pct":0.037,"d":"2015-09-14"},{"n":"Đào Thị Thu Thảo","p":null,"t":"INDIVIDUAL","q":3747,"pct":0.017,"d":"2025-10-05"},{"n":"Nghiêm Thị Thanh Hương","p":null,"t":"INDIVIDUAL","q":3788,"pct":0.01,"d":"2025-10-05"},{"n":"Nguyễn Văn Hiệu","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.01,"d":"2015-09-14"},{"n":"Ngô Tuấn Anh","p":null,"t":"INDIVIDUAL","q":2240,"pct":0.01,"d