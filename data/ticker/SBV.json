a và Na Uy. Tổng năng suất của công ty trung bình khoảng 9.000 tấn/năm cho các sản phẩm được sản xuất từ nguyên liệu chính là Poly Propylene và Poly Ethylene: Dây thừng PP: 3 tao, 4 tao, 8 tao…Dây thừng PE: 3 tao, 4 tao, 8 tao,…Chỉ PE, PP, Sợi đơn PP, PE. Ngày 16/05/2017, Giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bán lẻ","type":"CT","listed":"2017-05-16","state":0.0,"foreign":0.14416645,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Siam Holdings Việt Nam","p":null,"t":"CORPORATE","q":17902909,"pct":65.4,"d":"2025-10-05"},{"n":"Itthapat Sawatyanon","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1256666,"pct":4.599,"d":"2026-05-14"},{"n":"VEERAPONG SAWATYANON","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1066666,"pct":3.904,"d":"2026-05-14"},{"n":"Vietnam Holding Ltd","p":null,"t":"CORPORATE","q":743140,"pct":3.62,"d":"2025-10-05"},{"n":"Pratip Sawatyanon","p":null,"t":"INDIVIDUAL","q":585712,"pct":2.144,"d":"2025-10-05"},{"n":"Vimuttiratna Sawatyanon","p":null,"t":"INDIVIDUAL","q":87530,"pct":0.31,"d":"2025-10-05"},{"n":"Lê Phụng Hào","p":null,"t":"INDIVIDUAL","q":14282,"pct":0.052,"d":"2025-10-05"},{"n":"LÊ TRẦN ANH TUẤN","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":4020,"pct":0.015,"d":"2025-10-05"},{"n":"Huỳnh Tiến Việt","p":"Thành viên Hội đồng Quản trị/Giám đốc Sản xuất","t":"INDIVIDUAL","q":2213,"pct":0.008,"d":"2026-08-25"},{"n":"Đặng Thị Mỹ Kim","p":null,"t":"INDIVIDUAL","q":500,"pct":0.002,"d":"2025-10-05"},{"n":"Nguyễn Trường Hải","p":null,"t":"INDIVIDUAL","q":6,"pct":0.0,"d":"2025-10-05"},{"n":"Trần Thanh Long","p":"Giám đốc Kinh doanh/Giám đốc khối","t":"INDIVIDUAL","q":26,"pct":0.0,"d":"2025-10-05"}],"rel":[{"c":"1102059300","n":"Công ty TNHH Siam Brothers Việt Nam Toàn Cầu","t":"subsidiary","pct":100.0},{"c":"SIAMBROVN","n":"Công ty TNHH Thương Mại Và Dịch Vụ Siam Brothers Việt Nam","t":"subsidiary","pct":100.0},{"c":"1