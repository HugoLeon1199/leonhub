nghiệp hàng đầu về thị phần vận tải. Cùng với hệ thống vận chuyển: Hơn 1000 container 20 feet và hàng trăm đầu kéo, đây là điều kiện cần và có cho MHC thực hiện hoạt động kinh doanh của mình. Ngày 21/03/2005, MHC chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2005-03-21","state":0.0,"foreign":0.0081359,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Thương Mại Và Đầu Tư Ht Đông Nam Á","p":null,"t":"CORPORATE","q":8217024,"pct":18.9,"d":"2026-07-09"},{"n":"Công ty TNHH Đầu tư và Thương mại Phong Sơn","p":null,"t":"CORPORATE","q":8199900,"pct":18.86,"d":"2026-07-09"},{"n":"Công ty Cổ Phần Bất Động Sản Peaceful Land","p":null,"t":"CORPORATE","q":5821479,"pct":13.39,"d":"2026-07-09"},{"n":"Võ Trung Cương","p":null,"t":"INDIVIDUAL","q":1752040,"pct":6.463,"d":"2015-09-14"},{"n":"Bùi Thu Nga","p":null,"t":"INDIVIDUAL","q":2145200,"pct":5.18,"d":"2025-10-05"},{"n":"Nguyễn Quốc Việt","p":null,"t":"INDIVIDUAL","q":1400000,"pct":5.164,"d":"2015-09-14"},{"n":"Nguyễn Chiến Thắng","p":null,"t":"INDIVIDUAL","q":2002150,"pct":4.84,"d":"2025-10-05"},{"n":"Trần Hoàng Anh","p":null,"t":"INDIVIDUAL","q":1955870,"pct":4.72,"d":"2025-10-05"},{"n":"Dương Thị Hồng Hạnh","p":null,"t":"INDIVIDUAL","q":1386500,"pct":3.348,"d":"2025-10-05"},{"n":"Phạm Bá Huy","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1050000,"pct":2.42,"d":"2026-08-07"},{"n":"Bùi Đình Quý","p":null,"t":"INDIVIDUAL","q":576290,"pct":2.126,"d":"2015-09-14"},{"n":"Đặng Tiến Thành","p":null,"t":"INDIVIDUAL","q":794211,"pct":2.11,"d":"2025-10-05"},{"n":"Nguyễn Hữu Vinh","p":null,"t":"INDIVIDUAL","q":571260,"pct":2.107,"d":"2015-09-14"},{"n":"Đỗ Hồng Thái","p":null,"t":"INDIVIDUAL","q":773662,"pct":2.06,"d":"2025-10-05"},{"n":"Nguyễn Quốc Dũng","p":null,"t":"INDIVIDUAL","q":500005,"pct":1.844,"d":"2015-09-14"},{"n":"Hoàng Hà","p":null,"t":"INDIVIDUAL","q":350220,"pct":1.292,"