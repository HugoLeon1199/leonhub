phía hạ lưu và cách thành phố Long Xuyên 10 km về phía thượng lưu, có 5.900 m2 kho và 10.500 m2 bãi chứa hàng tổng hợp. Cảng Bình Long có 6.159 m2 kho và 3.200 m2 bãi chứa hàng tổng hợp, với nhiều cẩu, đầu kéo, rơ - móoc các loại giúp thực hiện các nghiệp vụ xuất nhập nhanh chóng, an toàn. Ngày 04/12/2017, CAG chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2017-12-04","state":0.52982609,"foreign":0.00199275,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":7311600,"pct":52.98,"d":"2026-08-19"},{"n":"Công ty Cổ Phần Tiếp Vận Phước Tạo","p":null,"t":"CORPORATE","q":2531200,"pct":18.34,"d":"2026-08-19"},{"n":"Công ty Cổ Phần Vận Tải Thủy Tân Cảng","p":null,"t":"CORPORATE","q":800000,"pct":5.8,"d":"2025-10-05"},{"n":"Phan Thành Tiến","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":15000,"pct":0.11,"d":"2026-08-19"},{"n":"Công Ty Tnhh Một Thành Viên Xuất Nhập Khẩu Hùng Anh","p":null,"t":"CORPORATE","q":7500,"pct":0.05,"d":"2025-10-05"},{"n":"Bùi Thành Hiệp","p":null,"t":"INDIVIDUAL","q":2400,"pct":0.02,"d":"2026-01-08"},{"n":"Bùi Thị Oanh","p":null,"t":"INDIVIDUAL","q":1400,"pct":0.01,"d":"2026-03-04"},{"n":"Nguyễn Văn Cơ","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1800,"pct":0.01,"d":"2026-08-19"},{"n":"Trần Tấn Phong","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1300,"pct":0.01,"d":"2026-08-19"},{"n":"Trần Văn Cam","p":null,"t":"INDIVIDUAL","q":1200,"pct":0.01,"d":"2026-01-08"},{"n":"Trần Thị Thúy Hạnh","p":null,"t":"INDIVIDUAL","q":400,"pct":0.003,"d":"2026-06-23"},{"n":"Phạm Văn Thành","p":null,"t":"INDIVIDUAL","q":100,"pct":0.001,"d":"2026-06-23"}],"events":[{"c":"DDIND","t":"Nguyễn Văn Linh - Đăng kí Bán 2,531,200 CAG","d":"2026-04-29","record":null,"ex":null},{"c":"AGME","t":"CAG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-