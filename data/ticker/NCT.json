hóa Nội Bài","profile":"Công ty Cổ phần Dịch vụ Hàng hóa Nội Bài (NCT), đơn vị thành viên của Tổng Công ty Hàng không Việt Nam, được thành lập năm 2005. Công ty là doanh nghiệp hoạt động lâu đời nhất sân bay Quốc tế Nội Bài và có mạng lưới khách hàng rộng lớn. Khách hàng của công ty NCT bao gồm hơn 30 hãng hàng không trong và ngoài nước đang khai thác tại sân bay Quốc tế Nội Bài, trên 400 công ty, đại lý giao nhận hàng hoá. Công ty cung cấp dịch vụ phục vụ hàng hóa, xử lý hàng hóa, lưu kho và dịch vụ khác. Sản lượng hàng thông qua bao gồm thiết bị điện tử (40 - 45%), dệt may (25 - 30%). NCT được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2015.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2015-01-08","state":0.65070677,"foreign":0.11337478,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Hàng không Việt Nam - CTCP","p":null,"t":"CORPORATE","q":14425401,"pct":55.13,"d":"2026-08-20"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":2085050,"pct":7.969,"d":"2026-08-10"},{"n":"Công ty Cổ phần Dịch vụ Hàng không Sân bay Việt Nam","p":null,"t":"CORPORATE","q":1827649,"pct":6.98,"d":"2026-06-23"},{"n":"Công ty TNHH Quốc tế Sao Đỏ","p":null,"t":"CORPORATE","q":633440,"pct":2.421,"d":"2015-06-15"},{"n":"Đặng Thanh Hải","p":null,"t":"INDIVIDUAL","q":42988,"pct":0.164,"d":"2015-09-14"},{"n":"Nguyễn Giang Tiến","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":17745,"pct":0.068,"d":"2026-08-20"},{"n":"Đinh Trọng Sơn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":10500,"pct":0.04,"d":"2026-08-20"},{"n":"Ngô Quang Huy","p":null,"t":"INDIVIDUAL","q":2002,"pct":0.008,"d":"2015-09-14"},{"n":"Đinh Thu Hà","p":null,"t":"INDIVIDUAL","q":1345,"pct":0.005,"d":"2015-09-14"},{"n":"Nguyễn Duy Việt","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":300,"pct":0.001,"d":"2026-08-20"},{"n":"Tạ Mạnh Hùng","p":null,"t":"INDIVIDUAL","q":200,"pct":0.001,"d":"2025-10-05"},{"