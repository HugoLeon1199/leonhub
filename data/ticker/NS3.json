ước sạch cho 18 phường thuộc quận Hoàn Kiếm, thành phố Hà Nội. Công ty tự sản xuất được khoảng 18% nước cấp từ trạm sản xuất nước Đồn Thủy với công suất 8.500-9.000m3/ngày đêm.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2016-12-26","state":0.6561,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Đầu tư Ngành nước DNP","p":null,"t":"CORPORATE","q":6840000,"pct":86.0,"d":"2025-10-05"},{"n":"Lê Hải Đoàn","p":null,"t":"INDIVIDUAL","q":350400,"pct":6.37,"d":"2018-07-04"},{"n":"Công ty Cổ Phần Tập Đoàn Quốc Tế Đông Á","p":null,"t":"CORPORATE","q":290600,"pct":5.28,"d":"2025-10-05"},{"n":"Phạm Vân Khánh","p":"Kế toán trưởng/Phụ trách Công bố thông tin/Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":13200,"pct":0.24,"d":"2022-05-12"},{"n":"Đỗ Phương Nam","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.18,"d":"2016-12-25"},{"n":"Nguyễn Thị Thu Huyền","p":null,"t":"INDIVIDUAL","q":3100,"pct":0.056,"d":"2016-12-25"},{"n":"Phạm Việt Anh","p":"Phó Giám đốc","t":"INDIVIDUAL","q":2000,"pct":0.04,"d":"2022-03-18"},{"n":"Nguyễn Đình Tiến","p":null,"t":"INDIVIDUAL","q":1200,"pct":0.02,"d":"2019-11-11"},{"n":"Đỗ Thị Thanh Thủy","p":"Phó Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.02,"d":"2022-03-18"},{"n":"Phan Thị Tuyết Lan","p":null,"t":"INDIVIDUAL","q":400,"pct":0.01,"d":"2018-07-04"}],"rel":[{"c":"TANIWACO","n":"Công ty Cổ phần Cấp Thoát Nước Tây Ninh","t":"affiliate","pct":24.96},{"c":"CT2WASUCO","n":"Công ty Cổ phần Cấp nước Cần Thơ 2","t":"affiliate","pct":0.0}],"rel_count":2,"events":[{"c":"SUSP","t":"NS3 - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCoM","d":"2022-06-20","record":null,"ex":null},{"c":"AGME","t":"NS3 - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-08","record":"2022-03-17","ex":"2022-03-16"},{"c":"AGME","t":"NS3 - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-02-23","record":"2021-03-01","ex":"2021-02-26"},{"c":"AIS","t":"NS3 - Đăng ký giao dịch bổ sung 1.319.999 cổ phiếu","d":"202