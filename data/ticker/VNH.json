["2023",-2.087],["2024",-45.119],["2025",31.692]]},"pb":{"q":[["2019-Q4",11.773],["2020-Q4",13.096],["2021-Q4",11.854],["2022-Q4",2.899],["2023-Q4",3.163],["2024-Q4",1.571],["2025-Q4",1.351],["2026-Q2",0.678]],"y":[["2018",0.0],["2019",19.028],["2020",13.951],["2021",3.295],["2022",3.413],["2023",1.581],["2024",1.309],["2025",0.678]]}},"co":{"short":"Đầu tư Việt Việt Nhật","profile":"Công ty Cổ phần Thủy hải sản Việt Nhật (VNH), tiền thân là Công ty TNHH Sản xuất - Thương mại - Xuất nhập khẩu Việt Nhật được thành lập năm 2000. Năm 2007 công ty chuyển sang hoạt động theo mô hình công ty cổ phần. Sản phẩm chính hiện nay của công ty là các loại sản phẩm thủy hải sản chế biến có giá trị gia tăng cao, rất đa dạng, được chia thành các nhóm sản phẩm chính như: bạch tuộc, mực, ghẹ, tôm, cá và các loại thủy sản khác. Các sản phẩm của công ty hoàn toàn phục vụ cho thị trường xuất khẩu. Sản phẩm được xuất khẩu sang các thị trường lớn như Mỹ, Nhật chiếm trên 80% sản lượng, còn lại là thị trường Hàn Quốc, Singapore, Trung Quốc, Châu Âu, các nước Trung Đông. Công ty hiện có 1 nhà máy với hệ thống 2 xưởng sản xuất: chuyên chế biến thủy hải sản đông lạnh có diện tích 2.400 m2 và xưởng chuyên chế biến đồ hộp có diện tích 1.700 m2. Tổng công suất thiết kế của nhà máy là 20 tấn thành phẩm đông lạnh/ngày, hệ thống kho lạnh có công suất thiết kế là 700 tấn. Ngày 31/03/2017, VNH chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2010-04-08","state":0.0,"foreign":0.01383647,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Đình Điệp","p":null,"t":"INDIVIDUAL","q":1446790,"pct":18.03,"d":"2025-10-05"},{"n":"Vũ Thị Tuyến","p":null,"t":"INDIVIDUAL","q":579300,"pct":7.22,"d":"2026-08-11"},{"n":"Bùi Thị Kim Cúc","p":null,"t":"INDIVIDUAL","q":398000,"pct":4.96,"d":"2025-10-05"},{"n":"Nguyễn Đức Phong","p":null,"t":"INDIVIDUAL","q":390700,"pct":4.87,"d":"2025-10-05"},{"n":"Nguyễn Thanh Sơn","p":"Chủ tịch Hội