iống lúa trên địa bàn tỉnh Hải Dương và hơn 21 tỉnh thành trên cả nước như các tỉnh đồng bằng Bắc bộ, Trung du miền núi và Bắc Trung bộ. Hiện tại, HDS đang cung cấp nhiều các giống lúa năng suất, giống cây ăn quả và giống thuỷ sản vật nuôi trải khắp các tỉnh thành, đặc biệt đẩy mạnh khu vực Tây Nguyên và Nam Trung Bộ.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2024-04-24","state":0.48999985,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Hải Dương","p":null,"t":"CORPORATE","q":2529832,"pct":49.0,"d":"2025-10-05"},{"n":"Phạm Thị Linh","p":null,"t":"INDIVIDUAL","q":1030000,"pct":19.95,"d":"2024-04-11"},{"n":"Đỗ Hoàng Phúc","p":"Chủ tịch Hội đồng Quản trị/Người đại diện theo pháp luật","t":"INDIVIDUAL","q":633900,"pct":12.278,"d":"2025-02-17"},{"n":"Đỗ Hoàng Phương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":430992,"pct":8.348,"d":"2025-02-17"},{"n":"VŨ VĂN NGA","p":null,"t":"INDIVIDUAL","q":313800,"pct":6.08,"d":"2024-04-11"},{"n":"Nguyễn Thị Hồng Hà","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":23000,"pct":0.445,"d":"2025-02-17"},{"n":"Dương Vũ Thắng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2500,"pct":0.048,"d":"2025-02-17"},{"n":"Lê Hải Hưng","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2100,"pct":0.04,"d":"2025-02-17"}],"events":[{"c":"SUSP","t":"HDS - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2025-06-10","record":null,"ex":null},{"c":"AGME","t":"HDS - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-29","record":"2025-05-13","ex":"2025-05-12"},{"c":"AGME","t":"HDS - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-06-13","record":"2024-06-20","ex":"2024-06-19"},{"c":"NLIS","t":"HDS - Chính thức đăng ký giao dịch trên UPCOM","d":"2024-04-16","record":null,"ex":null}],"st":{"bsa15":{"label":"Hàng tồn kho, ròng","section":"balance","y":[["2022",9.176],["2023",7.423],["2024",7.737]],"published":"2025-03-26"},"bsa2":{"label":"Tiền và tương