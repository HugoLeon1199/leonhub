ốn mô hình sản phẩm: Vincom Center, Vincom Mega Mall, Vincom Plaza và Vincom+. Hệ thống của doanh nghiệp bao gồm nhiều mô hình TTTM từ cao cấp, quy mô lớn đến mô hình địa phương, trong đó Vincom Plaza chiếm tỷ trọng lớn nhất về số lượng và diện tích. Doanh nghiệp duy trì mạng lưới gần 1.000 thương hiệu trong và ngoài nước, đồng thời tiếp tục mở rộng các mô hình flagship, concept mới và nâng cấp tài sản hiện hữu. VRE được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ cuối năm 2017.","sector":"Bất động sản","type":"CT","listed":"2017-11-06","state":0.0,"foreign":0.11118131,"rating":"M-PF","target":34200.0,"rating_as_of":"2026-05-29","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Kinh Doanh Thương Mại Sado","p":null,"t":"CORPORATE","q":943219292,"pct":40.5,"d":"2025-10-05"},{"n":"Tập đoàn Vingroup - Công ty CP","p":null,"t":"CORPORATE","q":427715101,"pct":18.37,"d":"2026-02-02"},{"n":"WP Investments III B.V.","p":null,"t":"CORPORATE","q":92996397,"pct":4.89,"d":"2025-10-05"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":63112488,"pct":2.78,"d":"2025-10-05"},{"n":"RWC Emerging Equities","p":null,"t":"CORPORATE","q":46258811,"pct":2.04,"d":"2025-10-05"},{"n":"Credit Suisse Singapore Branch","p":null,"t":"CORPORATE","q":30998798,"pct":1.63,"d":"2025-10-05"},{"n":"APG Emerging Markets","p":null,"t":"CORPORATE","q":21113560,"pct":0.93,"d":"2025-10-05"},{"n":"RWC Global Emerging Markets","p":null,"t":"CORPORATE","q":14366784,"pct":0.63,"d":"2025-10-05"},{"n":"AI MEHWAR Emerging Markets","p":null,"t":"CORPORATE","q":8663300,"pct":0.38,"d":"2025-10-05"},{"n":"RWC Emerging Markets SRI","p":null,"t":"CORPORATE","q":5523719,"pct":0.24,"d":"2025-10-05"},{"n":"SIIT International Equities","p":null,"t":"CORPORATE","q":2591045,"pct":0.11,"d":"2025-10-05"},{"n":"RWC Frontier Markets","p":null,"t":"CORPORATE","q":2178523,"pct":0.1,"d":"2025-10-05"},{"n":"SIT Emerging Equities","p":null,"t":"CORPORATE","q":2196659,"pct":0.1,"d":"2025-10-05