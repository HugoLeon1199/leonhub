 giảm 5.93%. VIG được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2009.","sector":"Dịch vụ tài chính","type":"CK","listed":"2009-12-01","state":0.0,"foreign":0.00418146,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"La Mỹ Phượng","p":null,"t":"INDIVIDUAL","q":2338700,"pct":6.85,"d":"2025-10-05"},{"n":"Nguyễn Thị Thảo","p":null,"t":"INDIVIDUAL","q":1693300,"pct":4.96,"d":"2025-10-05"},{"n":"Lê Thị Thanh Bình","p":null,"t":"INDIVIDUAL","q":1532400,"pct":4.49,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư Xây dựng và Quản lý Kinh doanh Bất động sản Thăng Long","p":null,"t":"CORPORATE","q":1484050,"pct":4.348,"d":"2015-06-15"},{"n":"Lê Thị Ngọc Hà","p":null,"t":"INDIVIDUAL","q":1037900,"pct":3.04,"d":"2025-10-05"},{"n":"Phan Ngọc Hồng","p":null,"t":"INDIVIDUAL","q":978100,"pct":2.87,"d":"2025-10-05"},{"n":"Nguyễn Nhật Minh","p":null,"t":"INDIVIDUAL","q":806700,"pct":2.36,"d":"2025-10-05"},{"n":"Công ty Cổ phần Tập đoàn Đầu tư Thăng Long","p":null,"t":"CORPORATE","q":642000,"pct":1.881,"d":"2015-06-15"},{"n":"Nguyễn Hải","p":null,"t":"INDIVIDUAL","q":473000,"pct":1.39,"d":"2025-10-05"},{"n":"Cao Văn Anh","p":null,"t":"INDIVIDUAL","q":405000,"pct":1.19,"d":"2025-10-05"},{"n":"Nguyễn Đăng Quang","p":null,"t":"INDIVIDUAL","q":33200,"pct":0.97,"d":"2025-10-05"},{"n":"Võ Sỹ Dởng","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.059,"d":"2025-10-05"},{"n":"Vũ Xuân Hòa","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.044,"d":"2015-09-14"},{"n":"Hồ Thị Hiền","p":null,"t":"INDIVIDUAL","q":13000,"pct":0.038,"d":"2025-10-05"},{"n":"Nguyễn Trọng Bằng","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.015,"d":"2025-10-05"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 155.0%","d":"2026-04-20","record":null,"ex":null},{"c":"AGME","t":"VIG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-05","record":"2026-03-20","ex":"2026-03-19"},{"c":"OTHE","t":"VIG - Thay đổi địa chỉ","d":"2025-08-18","record":null,"ex":null}