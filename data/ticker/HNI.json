["2023",18.04],["2024",24.194],["2025",19.266]]}},"co":{"short":"May Hữu Nghị","profile":"Công ty Cổ phần May Hữu Nghị (HNI) có tiền thân là ty May và In Hữu Nghị trực thuộc Tổng Công ty Dệt - May Việt Nam, được thành lập vào năm 1993. Công ty hoạt động chính trong lĩnh vực sản xuất, kinh doanh, xuất khẩu các sản phầm may mặc và thiết bị phụ tùng, nguyên phụ liệu ngành may. HNI chính thức hoạt động theo mô hình công ty cổ phần từ năm 2002. Công ty hiện đang quản lý vận hành 01 xưởng sản xuất chính và 04 xí nghiệp trực thuộc với năng lực sản xuất 01 triệu sản phẩm jackets/năm, 02 triệu sản phẩm sơ mi - quần tây/năm. HNI được giao dịch trên thị trường UPCOM từ cuối năm 2017.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2017-12-12","state":0.29241857,"foreign":0.00716181,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Dệt May Việt Nam","p":null,"t":"CORPORATE","q":6953392,"pct":29.24,"d":"2025-11-12"},{"n":"Hà Văn Duyệt","p":"Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2618174,"pct":11.01,"d":"2026-07-28"},{"n":"Hà Văn Nghĩa","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1293468,"pct":5.44,"d":"2026-07-28"},{"n":"Kiều Ngọc Mạnh Hùng","p":"Giám đốc","t":"INDIVIDUAL","q":1276554,"pct":5.37,"d":"2026-07-28"},{"n":"Hà Văn Long","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1217772,"pct":5.12,"d":"2026-07-28"},{"n":"Dương Thanh Tùng","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":720000,"pct":3.03,"d":"2026-07-28"},{"n":"Hà Hải Ninh","p":"Giám đốc","t":"INDIVIDUAL","q":662348,"pct":2.79,"d":"2026-07-28"},{"n":"Nguyễn Thị Hằng Nga","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":595604,"pct":2.5,"d":"2026-07-28"},{"n":"Vũ Thị Ngát","p":"Kế toán trưởng","t":"INDIVIDUAL","q":252816,"pct":1.06,"d":"2026-07-28"},{"n":"Phạm Đức Hà","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":224324,"pct":0.94,"d":"2026-08-11"},{"n":"Nguyễn Đình Minh","p":null,