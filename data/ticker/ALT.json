i Lan, Indonesia, Malaysia, Việt Nam. Ngày 22/11/2006, ALT chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Truyền thông","type":"CT","listed":"2006-11-22","state":0.1231605,"foreign":0.03124282,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Địa Ốc A.c.b","p":null,"t":"CORPORATE","q":1051244,"pct":17.03,"d":"2026-03-04"},{"n":"Tổng Công ty Công Nghiệp - In - Bao Bì Liksin - TNHH MTV","p":null,"t":"CORPORATE","q":760211,"pct":12.32,"d":"2026-03-04"},{"n":"Hoàng Văn Điều","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":582000,"pct":10.15,"d":"2026-08-20"},{"n":"Hoàng Minh Anh Tú","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":581695,"pct":10.14,"d":"2026-08-20"},{"n":"Lại Thị Hồng Điệp","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":355863,"pct":5.77,"d":"2026-08-20"},{"n":"Hoàng Minh Anh Tài","p":"Phó Tổng Giám đốc Kinh doanh","t":"INDIVIDUAL","q":282100,"pct":4.92,"d":"2026-06-15"},{"n":"La Thế Nhân","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":295550,"pct":4.79,"d":"2026-08-20"},{"n":"Nguyễn Văn Mạnh","p":null,"t":"INDIVIDUAL","q":273300,"pct":4.76,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Á Châu","p":null,"t":"CORPORATE","q":177960,"pct":3.043,"d":"2015-06-15"},{"n":"Nguyễn Lại Xuân Duyên","p":null,"t":"INDIVIDUAL","q":60000,"pct":1.05,"d":"2026-03-04"},{"n":"Nguyễn Văn Ngạn","p":null,"t":"INDIVIDUAL","q":50660,"pct":0.936,"d":"2015-09-14"},{"n":"Công ty Cổ phần TIE","p":null,"t":"CORPORATE","q":37500,"pct":0.641,"d":"2015-06-15"},{"n":"Trần Thị Thu Anh","p":null,"t":"INDIVIDUAL","q":33741,"pct":0.588,"d":"2026-03-04"},{"n":"Công ty CP Đầu Tư Toàn Việt","p":null,"t":"CORPORATE","q":31127,"pct":0.54,"d":"2025-10-05"},{"n":"Hans Eberhard Fortenbacher","p":null,"t":"INDIVIDUAL","q":26060,"pct":0.482,"d":"2015-09-14"},{"n":"Lại Thế Tiến","p":null,"t":"INDIVIDUAL","q":24617,"pct":0.429,"d":"2026-03-04"},{"n":"Th