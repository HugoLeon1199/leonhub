5",0.0]]}},"co":{"short":"Khoáng sản SG-Quy Nhơn","profile":"Công ty Cổ phần Khoáng sản Sài Gòn - Quy Nhơn là thành viên Tập đoàn Đầu te Sài Gòn (Saigon Invest Group - SGI) được thành lập năm 2006. Hoạt động chính của Công ty là khai thác, chế biến và xuất khẩu các sản phẩm từ quặng Titan. Công ty đã đầu tư xây dựng Nhà máy xỉ Titan lớn nhất, hiện đại nhất Việt Nam tại tỉnh Bình Định. Nhà máy xỉ Titan được đầu tư với công suất 60.000T xỉ Titan/ năm và 30.000T gang trắng/ năm. Nhà máy đã hoàn thành và đi vào hoạt động từ tháng 7/2009. Công ty đã tăng mức vốn điều lệ ban đầu là 10 tỷ đồng lên 1.200 tỷ đồng (vốn thực góp đạt 1.000 tỷ đồng). Công ty đặt mục tiêu trở thành công ty khoáng sản hàng đầu tại Việt Nam.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2009-12-17","state":0.0,"foreign":0.06909327,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đặng Thanh Tâm","p":null,"t":"INDIVIDUAL","q":44000000,"pct":40.0,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Tư Vấn Và Đầu Tư Kinh Bắc","p":null,"t":"CORPORATE","q":10277150,"pct":9.58,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Xuân","p":null,"t":"INDIVIDUAL","q":7590000,"pct":6.9,"d":"2025-10-05"},{"n":"Tổng Công ty Phát triển Đô thị Kinh Bắc","p":null,"t":"CORPORATE","q":7590000,"pct":6.9,"d":"2025-10-05"},{"n":"Công ty Cổ phần Công nghệ Viễn thông Sài Gòn","p":null,"t":"CORPORATE","q":6270000,"pct":5.699,"d":"2025-10-05"},{"n":"Đặng Thị Hoàng Phượng","p":null,"t":"INDIVIDUAL","q":5137000,"pct":4.788,"d":"2025-10-05"},{"n":"Công ty Cổ phần Mỹ phẩm Sài Gòn","p":null,"t":"CORPORATE","q":2900000,"pct":2.636,"d":"2015-06-15"},{"n":"CHAU KIN HANG KELVIN","p":null,"t":"INDIVIDUAL","q":1000000,"pct":0.932,"d":"2015-09-14"},{"n":"Nguyễn Trần Triệu Thanh","p":null,"t":"INDIVIDUAL","q":275000,"pct":0.233,"d":"2025-10-05"},{"n":"Hoàng Thị Kim Hiên","p":null,"t":"INDIVIDUAL","q":158400,"pct":0.144,"d":"2025-10-05"},{"n":"Đặng Nhứt","p":null,"t":"INDIVIDUAL","q":150000,"pct":0.14,"d":"2025-10-05"},{"n