ổ phần Công nghiệp - Dịch vụ - Thương mại Ngọc Nghĩa (NNG), tiền thân là công ty TNHH Sản xuất - Thương mại Ngọc Nghĩa, được thành lập vào tháng 06/1993. Tháng 05/2007, công ty đã tiến hành cổ phẩn hóa và đổi tên thành Công ty Cổ phần Nhựa Ngọc Nghĩa. Hoạt động kinh doanh chủ yếu của công ty là sản xuất, cung ứng bao bì PET và phôi nhựa. Công ty hiện là một trong những nhà sản xuất PET lớn nhất tại Việt Nam với 3 nhà máy sản xuất PET, năng lực sản xuất hơn 7 tỷ đơn vị sản phẩm/ năm. NNG hiện là doanh nghiệp hàng đầu cả nước và trong khu vực Đông Nam Á về sản xuất và cung ứng bao bì PET với doanh thu hàng năm đạt khoảng 1.800 tỷ đồng. Sản phẩm của công ty đã được xuất khẩu sang thị trường Nhật Bản, Úc. Công ty bắt đầu niêm yết cổ phiếu trên sàn UPCOM từ tháng 03/2015.","sector":"Hóa chất","type":"CT","listed":"2015-03-31","state":0.0,"foreign":0.9782,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đào Thị Thuận","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":200939,"pct":0.416,"d":"2022-03-02"},{"n":"Nguyễn Thị Châu","p":null,"t":"INDIVIDUAL","q":43924,"pct":0.091,"d":"2015-09-14"},{"n":"Nguyễn Văn Thành","p":null,"t":"INDIVIDUAL","q":24589,"pct":0.051,"d":"2015-09-14"},{"n":"Trương Quốc Thắng","p":null,"t":"INDIVIDUAL","q":19001,"pct":0.039,"d":"2015-09-14"},{"n":"Nguyễn Mạnh Hà","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.031,"d":"2015-09-14"},{"n":"La Hoài Nam","p":null,"t":"INDIVIDUAL","q":7772,"pct":0.016,"d":"2015-09-14"},{"n":"Nguyễn Thị Kim Chi","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3000,"pct":0.006,"d":"2022-03-02"}],"rel":[{"c":"PETPLAS","n":"CÔNG TY TNHH MTV NHỰA P.E.T VIỆT NAM","t":"subsidiary","pct":100.0},{"c":"NNINTER","n":"Công ty TNHH MTV Bao Bì Quốc Tế Ngọc Nghĩa","t":"subsidiary","pct":100.0},{"c":"GBCAPCO","n":"Công ty TNHH MTV Nắp Toàn Cầu","t":"subsidiary","pct":100.0},{"c":"INTERPET","n":"Công ty TNHH MTV Pet Quốc Tế","t":"subsidiary","pct":100.0}],"rel_count":4,"events":[{"c":"SUSP","t":"NNG - Hủy đăng 