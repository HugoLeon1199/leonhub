ểm có mức đầu tư và ứng dụng CNTT lớn nhất Việt Nam như khối Chính phủ, Tài chính - Bảo hiểm - Ngân hàng, Giáo dục. CMG được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Công nghệ Thông tin","type":"CT","listed":"2010-01-22","state":0.0,"foreign":0.36412077,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Samsung Sds Asia Pacific Pte. Ltd","p":null,"t":"CORPORATE","q":69343171,"pct":29.767,"d":"2026-08-13"},{"n":"Công ty TNHH Đầu Tư Mvi","p":null,"t":"CORPORATE","q":31321340,"pct":13.445,"d":"2026-08-13"},{"n":"Trương Ngọc Lân","p":null,"t":"INDIVIDUAL","q":3392000,"pct":5.121,"d":"2015-09-14"},{"n":"Công ty TNHH Đầu Tư Mỹ Linh","p":null,"t":"CORPORATE","q":11864305,"pct":5.093,"d":"2026-08-13"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":9229279,"pct":4.85,"d":"2025-10-05"},{"n":"Tập Đoàn Geleximco - Công ty Cp","p":null,"t":"CORPORATE","q":9217189,"pct":4.85,"d":"2025-10-05"},{"n":"Tập đoàn Bảo Việt","p":null,"t":"CORPORATE","q":8732186,"pct":3.748,"d":"2026-08-13"},{"n":"Nguyễn Minh Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5348269,"pct":2.296,"d":"2026-08-13"},{"n":"Nguyễn Phước Hải","p":null,"t":"INDIVIDUAL","q":3799253,"pct":1.63,"d":"2026-08-13"},{"n":"Nguyễn Trung Chính","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2750606,"pct":1.181,"d":"2026-08-13"},{"n":"Nguyễn Mỹ Hương","p":null,"t":"INDIVIDUAL","q":701067,"pct":0.3,"d":"2026-08-13"},{"n":"Tạ Hoàng Linh","p":null,"t":"INDIVIDUAL","q":651992,"pct":0.285,"d":"2026-08-13"},{"n":"Nguyễn Hồng Sơn","p":null,"t":"INDIVIDUAL","q":231790,"pct":0.23,"d":"2025-10-05"},{"n":"Nguyễn Kim Cương","p":null,"t":"INDIVIDUAL","q":237226,"pct":0.23,"d":"2025-10-05"},{"n":"Hoàng Xuân Hiếu","p":null,"t":"INDIVIDUAL","q":87500,"pct":0.132,"d":"2015-09-14"},{"n":"Phạm Hồng Hải","p":null,"t":"INDIVIDUAL","q":87500,"pct":0.132,"d":"2015-09-14"},{"n":"Hoàng Ngọc Hùng","p":null,"t":"INDIVIDUAL","q":11805