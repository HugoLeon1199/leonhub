ại hóa y học cổ truyền. DVM chính thức được giao dịch tại Sở Giao dịch Chứng khoán Hà Nội (HNX) từ ngày 19/07/2022.","sector":"Y tế","type":"CT","listed":"2022-07-19","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Dương Thị Thái","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":9404700,"pct":19.99,"d":"2026-08-10"},{"n":"Công ty Cổ phần Chứng khoán DSC","p":null,"t":"CORPORATE","q":6631740,"pct":14.09,"d":"2026-04-28"},{"n":"Lê Cao Hoàng","p":null,"t":"INDIVIDUAL","q":750000,"pct":2.1,"d":"2025-10-05"},{"n":"Vũ Thành Trung","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":941459,"pct":2.0,"d":"2026-08-10"},{"n":"Công ty TNHH Chứng khoán Ngân hàng Thương mại Cổ phần Ngoại thương Việt Nam","p":null,"t":"CORPORATE","q":540000,"pct":1.51,"d":"2025-10-05"},{"n":"Đoàn Thị Thu Hoài","p":null,"t":"INDIVIDUAL","q":450000,"pct":1.26,"d":"2025-10-05"},{"n":"TRẦN BÌNH DUYÊN","p":null,"t":"INDIVIDUAL","q":160000,"pct":0.449,"d":"2025-10-05"},{"n":"Trần Thị Thanh Tâm","p":null,"t":"INDIVIDUAL","q":183,"pct":0.001,"d":"2025-10-05"},{"n":"Bùi Công Tuấn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":143,"pct":0.0,"d":"2026-08-10"},{"n":"Dương Thị Ngọc","p":null,"t":"INDIVIDUAL","q":36,"pct":0.0,"d":"2025-10-05"}],"rel":[{"c":"0110581572","n":"Công ty Cổ Phần VIBFA","t":"affiliate","pct":40.0}],"rel_count":1,"events":[{"c":"DDIND","t":"Dương Thị Thái - Đăng kí Mua 6,500,000 DVM","d":"2026-05-06","record":null,"ex":null},{"c":"AGME","t":"DVM - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-06","record":"2026-05-15","ex":"2026-05-14"},{"c":"DDINS","t":"Công ty Cổ phần Chứng khoán DSC - Đăng kí Mua DVM","d":"2026-04-24","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ Phần Ntp Tc - Đăng kí Mua DVM","d":"2026-04-24","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Chứng khoán DSC - Đăng kí Mua DVM","d":"2026-04-22","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Chứng khoán DSC -