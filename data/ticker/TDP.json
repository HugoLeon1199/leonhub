ng 07/2018. TDP hiện quản lý vận hành 05 Nhà máy sản xuất bao bì hạt nhựa tái chế. Công ty đang là đối tác cung cấp chính cho nhiều doanh nghiệp uy tín tại Việt Nam với hơn 200 đại lý trên toàn quốc. Ngoài ra, các sản phẩm hạt nhựa, bao bì PP, PP shopping bags của Công ty hiện có thể đáp ứng được hầu hết các yêu cầu của các thị trường khắt khe như Nhật Bản, Mỹ, EU...TDP được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2020.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2018-11-12","state":0.0,"foreign":0.00808268,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Đức Cường","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":32425159,"pct":34.605,"d":"2026-08-20"},{"n":"Ngô Kim Dung","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7693785,"pct":8.211,"d":"2026-08-20"},{"n":"Trần Đăng Duy","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3930484,"pct":4.2,"d":"2026-08-20"},{"n":"Nguyễn Đức Chính","p":null,"t":"INDIVIDUAL","q":3569877,"pct":3.81,"d":"2026-08-20"},{"n":"Nguyễn Kim Anh","p":"Thành viên Hội đồng Quản trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1367478,"pct":1.46,"d":"2026-08-20"},{"n":"Nguyễn Đức Thịnh","p":null,"t":"INDIVIDUAL","q":1368170,"pct":1.46,"d":"2026-08-20"},{"n":"Lê Văn Quang","p":null,"t":"INDIVIDUAL","q":552688,"pct":0.92,"d":"2025-10-05"},{"n":"Nguyễn Văn Trưởng","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":722706,"pct":0.77,"d":"2026-08-20"},{"n":"Nguyễn Thị Lái","p":null,"t":"INDIVIDUAL","q":519260,"pct":0.55,"d":"2026-08-20"},{"n":"Nguyễn Thị Vinh","p":null,"t":"INDIVIDUAL","q":386355,"pct":0.41,"d":"2026-08-20"},{"n":"Ngô Thúy Nga","p":null,"t":"INDIVIDUAL","q":346173,"pct":0.37,"d":"2026-08-20"},{"n":"Ngô Thị Yên","p":null,"t":"INDIVIDUAL","q":173086,"pct":0.18,"d":"2026-08-20"},{"n":"Nguyễn Thị Hằng","p":null,"t":"INDIVIDUAL","q":160407,"pct":0.17,"d"