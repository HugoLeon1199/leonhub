g nghiệp Hà Nội được thành lập vào năm 1980. Công ty hoạt động trong lĩnh vực sản xuất và kinh doanh thiết bị nội thất văn phòng, gia đình, trường học, nơi công cộng. Từ năm 2015, XHC chính thức hoạt động theo mô hình công ty cổ phần. Công ty có công suất 400.000 - 500.000 sản phẩm mộc/năm. XHC đã tham gia cung cấp các sản phẩm nội thất cho các công trình tiêu biểu như Trung tâm Hội nghị quốc gia, Tòa nhà Bộ Tài chính, Bảo tàng Hà Nội, Cung Văn hóa Hữu nghị Việt Xô, Bệnh viện An Sinh, Khách sạn Mường Thanh, Trường Phổ thông Liên cấp Olympia. XHC được giao dịch trên thị trường UPCOM từ cuối năm 2016.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2016-11-03","state":0.0,"foreign":4.266e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty Cổ Phần Đầu Tư VAC Việt Nam","p":null,"t":"CORPORATE","q":5427000,"pct":25.73,"d":"2026-05-07"},{"n":"Công ty TNHH Quản lý Quỹ Bảo Việt","p":null,"t":"CORPORATE","q":2400000,"pct":11.37,"d":"2026-05-07"},{"n":"Nguyễn Hoàng Hải","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2390282,"pct":11.33,"d":"2026-07-28"},{"n":"Nguyễn Việt Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1763043,"pct":8.36,"d":"2026-07-28"},{"n":"Trần Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":1715396,"pct":8.13,"d":"2026-05-07"},{"n":"Lê Tú Anh","p":null,"t":"INDIVIDUAL","q":1310011,"pct":6.21,"d":"2026-05-07"},{"n":"Nguyễn Thi Minh Hiền","p":null,"t":"INDIVIDUAL","q":1243023,"pct":5.89,"d":"2026-05-07"},{"n":"Lê Thị Hoa","p":null,"t":"INDIVIDUAL","q":989332,"pct":4.692,"d":"2026-02-24"},{"n":"Khúc Văn Quang","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":753300,"pct":3.572,"d":"2026-07-28"},{"n":"Nguyễn Anh Tuấn","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":562636,"pct":2.668,"d":"2026-07-28"},{"n":"Nguyên Thị Dạ Liên","p":null,"t":"INDIVIDUAL","q":104912,"pct":0.498,"d":"2026-02-24"},{"n":"Tạ Lê Hải Anh","p":null,"t":"