rofile":"Công ty Cổ phần Phát triển Hạ tầng Vĩnh Phúc (IDV) là doanh nghiệp chuyên kinh doanh cơ sở hạ tầng khu công nghiệp được thành lập năm 2003. Công ty là chủ đầu tư phát triển kinh doanh hạ tầng của 2 khu công nghiệp là khu công nghiệp Khai Quang tại thành phố Vĩnh Yên, tỉnh Vĩnh Phúc và khu công nghiệp Châu Sơn tại thành phố Phủ Lý, tỉnh Hà Nam. Doanh thu của công ty đến từ 3 nguồn chính là phí sử dụng hạ tầng, phí quản lý khu công nghiệp và phí xử lý nước thải. Công ty là một doanh nghiệp có uy tín trong lĩnh vực xây dựng và kinh doanh hạ tầng kỹ thuật khu công nghiệp. IDV được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2010.","sector":"Bất động sản","type":"CT","listed":"2010-06-01","state":0.0,"foreign":0.19521982,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":4542924,"pct":18.007,"d":"2025-10-05"},{"n":"Hoàng Đình Thắng","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5995967,"pct":12.64,"d":"2026-08-05"},{"n":"Trịnh Việt Dũng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3773282,"pct":7.96,"d":"2026-08-05"},{"n":"Nguyễn Thị Kiến","p":null,"t":"INDIVIDUAL","q":3284135,"pct":6.93,"d":"2026-08-05"},{"n":"VĂN PHỤNG HÀ","p":null,"t":"INDIVIDUAL","q":1700508,"pct":4.742,"d":"2025-10-05"},{"n":"Tạ Phạm Bích Thủy","p":null,"t":"INDIVIDUAL","q":2067694,"pct":4.36,"d":"2026-08-05"},{"n":"CÔNG TY TNHH MTV VPID HÀ NỘI","p":null,"t":"CORPORATE","q":326300,"pct":4.224,"d":"2015-06-15"},{"n":"Lê Tùng Sơn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1599736,"pct":3.37,"d":"2026-08-05"},{"n":"Phùng Văn Quý","p":null,"t":"INDIVIDUAL","q":1446974,"pct":3.05,"d":"2026-08-05"},{"n":"Phạm Hữu Ái","p":null,"t":"INDIVIDUAL","q":808450,"pct":1.7,"d":"2026-08-05"},{"n":"Nguyễn Thị Hương","p":null,"t":"INDIVIDUAL","q":81348,"pct":1.053,"d":"2015-09-14"},{"n":"Nguyễn Mạnh Hà","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVI