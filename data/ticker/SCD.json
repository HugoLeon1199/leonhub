ựng vào năm 1952 trực thuộc tập đoàn BGI của Pháp. Năm 2004 chuyển sang hoạt động theo mô hình cổ phần. Chương Dương hiện đang sản xuất và kinh doanh các loại sản phẩm nước giải khát có gas, rượu nhẹ, nước tinh khiết. Sản phẩm thế mạnh của công ty là mặt hàng nước sá xị (chiếm trên 74% doanh thu) rất được ưa chuộng tại miền Nam. Công ty có hệ thống phân phối hơn 400 đại lý, siêu thị, cùng hàng ngàn điểm bán cấp 1, và cấp 2 tập trung tại TP.HCM; Long An; Bình Dương; Vũng Tàu.và xuất khẩu Đông Nam A, Mỹ, Úc, Pháp. Hiện tại Công ty có 3 dây chuyền sản xuất chiết chai thủy tinh, một dây chuyền chiết chai PET và một dây chuyền chiết lon. Ngày 15/05/2024, SCD chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2006-12-25","state":0.619,"foreign":0.05911294,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Bia - Rượu - Nước Giải khát Sài Gòn","p":null,"t":"CORPORATE","q":5261500,"pct":62.06,"d":"2026-05-12"},{"n":"Công ty Cổ phần Bảo hiểm Bảo Tín","p":null,"t":"CORPORATE","q":1100000,"pct":12.941,"d":"2015-06-15"},{"n":"Đỗ Thuý Nhung","p":null,"t":"INDIVIDUAL","q":594800,"pct":7.02,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán BIDV","p":null,"t":"CORPORATE","q":423960,"pct":4.988,"d":"2015-06-15"},{"n":"FTIF - Templeton Frontier Markets Fund","p":null,"t":"CORPORATE","q":418450,"pct":4.923,"d":"2015-06-15"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":415600,"pct":4.9,"d":"2025-10-05"},{"n":"Lê Chí Nguyện","p":null,"t":"INDIVIDUAL","q":140,"pct":0.002,"d":"2015-09-14"},{"n":"Võ Văn Thọ","p":null,"t":"INDIVIDUAL","q":200,"pct":0.002,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"SCD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-12","record":"2026-03-17","ex":"2026-03-16"},{"c":"EGME","t":"SCD - Tổ chức ĐHĐCĐ bất thường 2026","d":"2025-12-24","record":"2026-01-09","ex":"2026-01-08"},{"c":"OTHE","t":"SCD - Thay đổi địa chỉ","d":"2025-09-22","record":null,"ex":null