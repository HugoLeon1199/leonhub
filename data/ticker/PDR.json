sạn, resort cao cấp. Công ty đã và đang tiếp tục mở rộng danh mục đầu tư vào nhiều dự án Bất động sản trên địa bản cả nước, hướng đến trở thành một trong những nhà đầu tư Bất động sản lớn mạnh tại Việt Nam. Một số các công trình mà công ty đã và đang thực hiện là: The EverRich Infinity, dự án Millennium, Khu dân cư Phát Đạt - Bàu Cả, Khu đô thị Du lịch sinh thái Nhơn Hội,... PDR được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Bất động sản","type":"CT","listed":"2010-07-30","state":0.0,"foreign":0.07037926,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Văn Đạt","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":294757246,"pct":29.54,"d":"2026-08-27"},{"n":"Công ty TNHH Phát Đạt Holdings","p":null,"t":"CORPORATE","q":85334327,"pct":8.71,"d":"2026-06-23"},{"n":"ACA Vietnam Real Estate III LP","p":null,"t":"CORPORATE","q":36822600,"pct":3.69,"d":"2026-06-23"},{"n":"Nguyễn Thị Minh Thư","p":null,"t":"INDIVIDUAL","q":6455708,"pct":0.66,"d":"2026-08-03"},{"n":"Bùi Quang Anh Vũ","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2172000,"pct":0.218,"d":"2026-08-03"},{"n":"Nguyễn Khắc Sinh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1826000,"pct":0.183,"d":"2026-08-03"},{"n":"TRẦN THỊ HƯỜNG","p":"Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":1045583,"pct":0.14,"d":"2025-10-05"},{"n":"Nguyễn Đình Trí","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1340174,"pct":0.134,"d":"2026-08-03"},{"n":"Trương Ngọc Dũng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1201000,"pct":0.12,"d":"2026-08-03"},{"n":"Lê Quang Phúc","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":548192,"pct":0.11,"d":"2021-11-11"},{"n":"Nguyễn Hữu","p":null,"t":"INDIVIDUAL","q":1108714,"pct":0.11,"d":"2026-08-03"},{"n":"Lê Quang Phúc","p":"Thành viên Hội đồng Quản trị/Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":1084000,"pct":0.108,"d":"2026-08-03"},{"n":"Ngô Thuý Vân","p":null