ố các mặt hàng Ure. Ngày 18/03/2015, PSE chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hóa chất","type":"CT","listed":"2015-03-18","state":0.75,"foreign":0.000896,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Phân bón và Hóa chất Dầu khí - Công ty Cổ phần","p":null,"t":"CORPORATE","q":9375000,"pct":75.0,"d":"2026-08-13"},{"n":"Công ty TNHH Thương mại dịch vụ Hoa Anh Đào","p":null,"t":"CORPORATE","q":387500,"pct":0.31,"d":"2025-10-05"},{"n":"Trịnh Văn Khiêm","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.16,"d":"2025-10-05"},{"n":"Trịnh Văn Chương","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":30250,"pct":0.15,"d":"2026-08-13"},{"n":"Nguyễn Thị Kim Anh","p":null,"t":"INDIVIDUAL","q":11670,"pct":0.093,"d":"2025-10-05"},{"n":"Dương Trí Hội","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.08,"d":"2015-09-14"},{"n":"Phạm Tuấn Sơn","p":null,"t":"INDIVIDUAL","q":8700,"pct":0.07,"d":"2025-10-05"},{"n":"Phạm Hoài Hương","p":null,"t":"INDIVIDUAL","q":7900,"pct":0.063,"d":"2026-08-13"},{"n":"Lê Quốc Hưng","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.008,"d":"2025-10-05"},{"n":"Lê Thị Hoa Mỹ","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":200,"pct":0.002,"d":"2026-08-13"}],"events":[{"c":"AGME","t":"PSE - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-09","record":"2026-03-18","ex":"2026-03-17"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 1,000 VND","d":"2025-09-12","record":"2025-09-22","ex":"2025-09-19"},{"c":"AGME","t":"PSE - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-12","record":"2025-02-26","ex":"2025-02-25"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 - 800 VND","d":"2024-09-12","record":"2024-09-19","ex":"2024-09-18"},{"c":"AGME","t":"PSE - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-01","record":"2024-03-18","ex":"2024-03-15"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2022 - 1,500 VND","d":"2023-09-15","record":"2023-09-22","ex":"2023