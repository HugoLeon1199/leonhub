ệp Điện lực Khánh Hòa. Được cổ phần hóa vào năm 2005. Ngành nghề kinh doanh chủ yếu của Công ty là sản xuất, kinh doanh sản phẩm bê tông công nghiệp. Sản phẩm chủ yếu của Công ty là các sản phẩm bê tông ly tâm bao gồm các nhóm sản phẩm: Ống cống bê tông ly tâm, trụ điện bê tông ly tâm dự ứng lực, cọc cừ bê tông ly tâm dự ứng lực. Doanh thu từ sản phẩm Ống cống BTLT và Trụ điện BTLT chiếm tỷ trọng gần 90% tổng doanh thu của Công ty, trong đó ống cống BTLT chiếm trên 62%.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2011-02-08","state":0.0,"foreign":0.00013333,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Điện lực Khánh Hòa","p":null,"t":"CORPORATE","q":465000,"pct":31.0,"d":"2026-06-11"},{"n":"Công ty Cổ phần Bê tông ly tâm An Giang","p":null,"t":"CORPORATE","q":390000,"pct":26.0,"d":"2025-10-05"},{"n":"Phạm Thị Nhơn","p":null,"t":"INDIVIDUAL","q":150100,"pct":10.01,"d":"2025-06-16"},{"n":"Trương Văn Đồng","p":null,"t":"INDIVIDUAL","q":76675,"pct":5.11,"d":"2025-06-19"},{"n":"Cao Thị Hiếu Thảo","p":null,"t":"INDIVIDUAL","q":58200,"pct":3.88,"d":"2025-01-23"},{"n":"Phạm Thị Loan","p":null,"t":"INDIVIDUAL","q":58200,"pct":3.88,"d":"2024-01-16"},{"n":"Nguyễn Thị Tuyết Loan","p":"Kế toán trưởng","t":"INDIVIDUAL","q":39100,"pct":2.61,"d":"2025-01-23"},{"n":"Lê Duy Cửu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":30000,"pct":2.0,"d":"2025-01-23"},{"n":"Dương Xuân Thắng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":23500,"pct":1.57,"d":"2025-01-23"},{"n":"Nguyễn Phước Vĩnh Khải","p":null,"t":"INDIVIDUAL","q":15190,"pct":1.013,"d":"2023-05-08"},{"n":"Nguyễn Quang Tiến","p":null,"t":"INDIVIDUAL","q":15190,"pct":1.013,"d":"2015-09-14"},{"n":"Nguyễn Thanh Gần Em","p":null,"t":"INDIVIDUAL","q":13000,"pct":0.867,"d":"2022-05-12"},{"n":"Nguyễn Thanh Hải","p":null,"t":"INDIVIDUAL","q":3100,"pct":0.207,"d":"2024-04-12"}],"events":[{"c":"DDIND","t":"Trương Văn Đồng - Đăng kí Mua KCE","d":"2025-06-19"