e, Nautica, Haggar, JC Penny, Quechua, Champion, Elleses, Northface, Estivo, Otto, Bon – prix, Tribord và được xuất khẩu sang Châu Âu (45%), Hoa Kỳ (35%), Nhật và các nước khác (20%). Công ty kinh doanh theo Phương thức FOB “Mua nguyên liệu – bán thành phẩm” giúp Công ty tự chủ hơn trong hoạt động kinh doanh. Ngày 12/02/2025, GMC chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2006-12-22","state":0.0,"foreign":0.04712087,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Đầu Tư Và Thương Mại Thiên Hải","p":null,"t":"CORPORATE","q":5224705,"pct":15.86,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu Tư T.T.A","p":null,"t":"CORPORATE","q":5006286,"pct":15.17,"d":"2025-10-05"},{"n":"Công Ty Cổ Phần Xuất Nhập Khẩu Và Đầu Tư Thừa Thiên Huế","p":null,"t":"CORPORATE","q":4360227,"pct":13.21,"d":"2025-10-05"},{"n":"Công ty Cổ phần Dệt May Gia Định","p":null,"t":"CORPORATE","q":3324629,"pct":10.089,"d":"2025-10-05"},{"n":"Công ty Cổ phần Sản xuất Kinh doanh Xuất nhập khẩu Bình Thạnh","p":null,"t":"CORPORATE","q":2337622,"pct":7.09,"d":"2025-10-05"},{"n":"Lê Quang Hùng","p":null,"t":"INDIVIDUAL","q":443620,"pct":2.85,"d":"2025-10-05"},{"n":"Nguyễn Ân","p":null,"t":"INDIVIDUAL","q":384530,"pct":2.47,"d":"2025-10-05"},{"n":"Công ty TNHH Thương mại Á Châu","p":null,"t":"CORPORATE","q":618871,"pct":1.88,"d":"2025-10-05"},{"n":"Công ty TNHH Tân Á","p":null,"t":"CORPORATE","q":562610,"pct":1.88,"d":"2025-10-05"},{"n":"Đỗ Thị Kim Nhàn","p":null,"t":"INDIVIDUAL","q":187283,"pct":1.609,"d":"2025-10-05"},{"n":"Nguyễn Hoàng Giang","p":null,"t":"INDIVIDUAL","q":114100,"pct":0.98,"d":"2015-09-14"},{"n":"Nhữ Hồng Thanh","p":null,"t":"INDIVIDUAL","q":56745,"pct":0.487,"d":"2015-09-14"},{"n":"Nguyễn Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":75905,"pct":0.25,"d":"2025-10-05"},{"n":"Trần Cảnh Thông","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.13,"d":"2025-10-05"},{"n":"Nguyễn Minh Hằng","p":"Tổng 