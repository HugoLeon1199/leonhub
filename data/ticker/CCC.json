 công nhiều dự án trải dài trên nhiều tỉnh thành cả nước như: Cụm toà nhà Mipec Rubik Xuân Thuỷ và khu nhà ở Mipec Kiến Hưng (Hà Đông); Toà nhà Chung cư Bình Minh Garden; Khu nhà ở Athena Complex Xuân Phương và Athena Complex Pháp Vân; Khu nhà ở Hibrand Văn Phú; … Ngày 21/04/2025, CCC, chính thức giao dịch trên Sở giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2024-07-30","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Tiến Đạt","p":null,"t":"INDIVIDUAL","q":9643000,"pct":23.96,"d":"2026-03-20"},{"n":"Công ty Cổ phần Cdc Holding","p":null,"t":"CORPORATE","q":7500000,"pct":18.63,"d":"2026-08-10"},{"n":"Ngô Tấn Long","p":"Chủ tịch Hội đồng Quản trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3284400,"pct":8.0,"d":"2026-08-10"},{"n":"Trần Văn Trường","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3284400,"pct":8.0,"d":"2026-09-03"},{"n":"Đặng Thanh Trang","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3284400,"pct":8.0,"d":"2026-08-10"},{"n":"Lê Hồng Lĩnh","p":null,"t":"INDIVIDUAL","q":3215100,"pct":7.99,"d":"2026-03-20"},{"n":"Lê Văn Quang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1718700,"pct":4.19,"d":"2026-08-04"},{"n":"Mai Đình Chất","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":821100,"pct":2.0,"d":"2026-08-10"},{"n":"Nguyễn Khắc Thịnh","p":null,"t":"INDIVIDUAL","q":805000,"pct":2.0,"d":"2026-03-18"},{"n":"Nguyễn Thị Thuỷ","p":"Kế toán trưởng","t":"INDIVIDUAL","q":305998,"pct":0.75,"d":"2026-08-10"},{"n":"Nguyễn Văn Tiến","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":306000,"pct":0.7,"d":"2026-08-10"},{"n":"Ngô Quý Nhâm","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":102000,"pct":0.24,"d":"2026-08-10"},{"n":"Phan Đức Giáp","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":102000,"pct":0.2,"d":"2026-08-10"},{"n":"Trần Đình Mạnh","p":"Giám đốc khố