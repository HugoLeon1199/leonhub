6% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 70.03%, tăng 33.65%. Lợi nhuận trước thuế có giá trị bằng 1.649,37 tỷ đồng, tăng 33.09%. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 11.28%, tăng 1.82%. SHS được niêm yết trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2009.","sector":"Dịch vụ tài chính","type":"CK","listed":"2009-06-25","state":0.0,"foreign":0.08957651,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":69373110,"pct":7.71,"d":"2026-07-02"},{"n":"Công ty Cổ phần Tập đoàn T&T","p":null,"t":"CORPORATE","q":50056306,"pct":5.6,"d":"2026-02-05"},{"n":"Vũ Đức Tiến","p":null,"t":"INDIVIDUAL","q":20054983,"pct":2.47,"d":"2025-10-05"},{"n":"Đỗ Quang Vinh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":13950000,"pct":1.55,"d":"2026-08-10"},{"n":"Công ty Cổ phần Phát triển Đô thị và Khu Công nghiệp Cao Su Việt Nam","p":null,"t":"CORPORATE","q":1059733,"pct":1.06,"d":"2015-06-15"},{"n":"Đỗ Quang Hiển","p":null,"t":"INDIVIDUAL","q":4866932,"pct":0.54,"d":"2026-08-10"},{"n":"Vũ Đức Trung","p":null,"t":"INDIVIDUAL","q":2930510,"pct":0.33,"d":"2026-02-05"},{"n":"Nguyễn Thế Minh","p":null,"t":"INDIVIDUAL","q":270000,"pct":0.27,"d":"2015-09-14"},{"n":"Hoàng Đình Lợi","p":null,"t":"INDIVIDUAL","q":79300,"pct":0.079,"d":"2015-09-14"},{"n":"Nguyễn Chí Thành","p":null,"t":"INDIVIDUAL","q":624720,"pct":0.07,"d":"2026-08-10"},{"n":"Bùi Thị Minh Tâm","p":null,"t":"INDIVIDUAL","q":60900,"pct":0.061,"d":"2015-09-14"},{"n":"Nguyễn Diệu Trinh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":135000,"pct":0.04,"d":"2021-10-21"},{"n":"Uông Vân Hạnh","p":null,"t":"INDIVIDUAL","q":237514,"pct":0.03,"d":"2025-10-05"},{"n":"Lê Đăng Khoa","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":95000,"pct":0.011,"d":"2026-08-10"},{"n":"Phạm Thị Thanh Hảo","p":"Kế toán trưởng","t":"INDIVIDUAL","q":51480,"pct":0.01,"d":"2026-08-10"},{"n":"Doãn Thị Như Quỳnh","p":"Người phụ trách qu