ương lai...Ngày 13/09/2010, IDJ chính thức giao dịch trên Sàn giao dịch chứng khoán Thành phố Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2010-09-13","state":0.0,"foreign":0.00559593,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn Apec Group","p":null,"t":"CORPORATE","q":15194200,"pct":10.33,"d":"2022-03-12"},{"n":"Công ty Cổ phần Chứng khoán Châu Á - Thái Bình Dương","p":null,"t":"CORPORATE","q":16433201,"pct":9.47,"d":"2026-08-26"},{"n":"Công ty Cổ phần Đầu tư APEC Holding","p":null,"t":"CORPORATE","q":4349400,"pct":5.92,"d":"2025-10-05"},{"n":"Nguyễn Thu Trang","p":null,"t":"INDIVIDUAL","q":7561260,"pct":5.14,"d":"2025-10-05"},{"n":"Asean Small Cap Fund","p":null,"t":"CORPORATE","q":1607400,"pct":4.931,"d":"2015-06-15"},{"n":"Huỳnh Thị Mai Dung","p":null,"t":"INDIVIDUAL","q":5931596,"pct":3.419,"d":"2025-10-05"},{"n":"Yoshihiro Matsuo","p":null,"t":"INDIVIDUAL","q":1040000,"pct":3.19,"d":"2015-09-14"},{"n":"Công ty Cổ Phần Đầu Tư Và Phát Triển Đô Thị Quốc Tế","p":null,"t":"CORPORATE","q":1000000,"pct":3.067,"d":"2015-06-15"},{"n":"Nguyễn Đỗ Lăng","p":null,"t":"INDIVIDUAL","q":2260000,"pct":1.303,"d":"2025-10-05"},{"n":"Phạm Duy Hưng","p":null,"t":"INDIVIDUAL","q":1594002,"pct":0.919,"d":"2025-10-05"},{"n":"Lã Thị Quy","p":null,"t":"INDIVIDUAL","q":1221500,"pct":0.704,"d":"2025-10-05"},{"n":"Nguyễn Đỗ Đức Lâm","p":null,"t":"INDIVIDUAL","q":1088709,"pct":0.628,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh","p":null,"t":"INDIVIDUAL","q":1072571,"pct":0.618,"d":"2025-10-05"},{"n":"Nguyễn Quang Huy","p":null,"t":"INDIVIDUAL","q":550000,"pct":0.32,"d":"2025-10-05"},{"n":"Nguyễn Đức Quân","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":550000,"pct":0.317,"d":"2026-08-26"},{"n":"Phạm Hoài Phương","p":null,"t":"INDIVIDUAL","q":497200,"pct":0.287,"d":"2025-10-05"},{"n":"Nguyễn Hoài Giang","p":null,"t":"INDIVIDUAL","q":450000,"pct":0.26