50.000 tấn/năm và Nhà máy LIX Bắc Ninh với công suất 70.000 tấn bột giặt/năm và nước tẩy rửa là 15.000 tấn/năm. LIX được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2009.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2009-12-10","state":0.51,"foreign":0.02478151,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Hóa chất Việt Nam","p":null,"t":"CORPORATE","q":33048000,"pct":51.0,"d":"2026-08-24"},{"n":"Công ty Cổ phần Khami","p":null,"t":"CORPORATE","q":1650000,"pct":5.09,"d":"2025-10-05"},{"n":"Red River Holding","p":null,"t":"CORPORATE","q":1077944,"pct":4.99,"d":"2015-06-15"},{"n":"FTIF - Templeton Frontier Markets Fund","p":null,"t":"CORPORATE","q":899980,"pct":4.167,"d":"2015-06-15"},{"n":"Võ Thành Danh","p":null,"t":"INDIVIDUAL","q":401000,"pct":1.253,"d":"2025-10-05"},{"n":"Lưu Kim Huệ","p":null,"t":"INDIVIDUAL","q":140040,"pct":0.438,"d":"2025-10-05"},{"n":"Nguyễn Thị Phương Liên","p":null,"t":"INDIVIDUAL","q":72175,"pct":0.334,"d":"2015-09-14"},{"n":"Lê Thị Liên","p":null,"t":"INDIVIDUAL","q":72000,"pct":0.333,"d":"2015-09-14"},{"n":"Vũ Hoàng Chương","p":null,"t":"INDIVIDUAL","q":65209,"pct":0.204,"d":"2025-10-05"},{"n":"Nguyễn Phước Hùng","p":null,"t":"INDIVIDUAL","q":41000,"pct":0.19,"d":"2015-09-14"},{"n":"Trần Phạm Thùy Vy","p":null,"t":"INDIVIDUAL","q":73248,"pct":0.11,"d":"2026-08-24"},{"n":"Nguyễn Ngọc Quang","p":null,"t":"INDIVIDUAL","q":31945,"pct":0.1,"d":"2025-10-05"},{"n":"Tô Thị Ai","p":null,"t":"INDIVIDUAL","q":15646,"pct":0.049,"d":"2025-10-05"},{"n":"Đào Quang Toản","p":null,"t":"INDIVIDUAL","q":5250,"pct":0.024,"d":"2015-09-14"},{"n":"Huỳnh Thị Diễm Lệ","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.023,"d":"2015-09-14"},{"n":"Huỳnh Thị Ngọc Toàn","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.019,"d":"2025-10-05"},{"n":"Thiều Thị Hồng Minh","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.015,"d":"2026-08-24"},{"n":"Nguyễn Thị Thúy Vân","p":"Thành viên Ban kiểm soát",