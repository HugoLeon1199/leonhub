18",-2.65],["2019",-2.384],["2020",-1.428],["2021",-2.143],["2022",-0.245]]}},"co":{"short":"Đầu tư PV-Inconess","profile":"Công ty Cổ phần Đầu tư PV-Inconess (RGC) được thành lập vào năm 2007. Hoạt động sản xuất chính của công ty là kinh doanh sân golf và các dịch vụ golf đạt tiêu chuẩn quốc tế, kinh doanh bất động sản, nhà nghỉ, du lịch sinh thái nhà vườn, vui chơi, giải trí. RGC đang đầu tư triển khai Dự án Trung tâm liên hợp du lịch và thể thao sân golf 54 lỗ hồ Yên Thắng và Dự án khu du lịch sinh thái Hồ Đồng Thái với tổng diện tích gần 3.000ha nằm trên địa bàn huyện Yên Mô và thành phố Tam Điệp, tỉnh Ninh Bình.","sector":"Truyền thông","type":"CT","listed":"2017-06-19","state":0.0,"foreign":0.0001,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Tcg Land","p":null,"t":"CORPORATE","q":66867600,"pct":75.03,"d":"2025-10-05"},{"n":"Công ty TNHH MTV Quản Lý Quỹ Ngân Hàng Thương Mại Cổ phần Công Thương Việt Nam","p":null,"t":"CORPORATE","q":16575447,"pct":18.6,"d":"2025-10-05"},{"n":"Công Đoàn Ngân Hàng Thương Mại Cổ Phần Công Thương Việt Nam","p":null,"t":"CORPORATE","q":2332008,"pct":2.62,"d":"2025-10-05"}],"rel":[{"c":"2700343479","n":"CÔNG TY CỔ PHẦN ĐẦU TƯ XÂY DỰNG VÀ THƯƠNG MẠI ĐỒNG THÁI","t":"affiliate","pct":48.0}],"rel_count":1,"events":[{"c":"SUSP","t":"RGC - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2023-12-19","record":null,"ex":null},{"c":"AGME","t":"RGC - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-03-23","record":"2023-04-20","ex":"2023-04-19"},{"c":"AGME","t":"RGC - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-04-13","record":"2022-04-29","ex":"2022-04-28"},{"c":"DDINS","t":"Công ty TNHH Tcg Land - Đăng kí Bán 8,734,113 RGC","d":"2022-02-17","record":null,"ex":null},{"c":"DDINS","t":"Công ty TNHH Tcg Land - Đăng kí Bán 8,734,113 RGC","d":"2021-12-30","record":null,"ex":null},{"c":"AGME","t":"RGC - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-04-08","record":"2021-04-29","ex":"2021-04-28"},{"c":"AGME",