Nam, được thành lập vào năm 1995. Lĩnh vực kinh doanh chính của Petrolimex là xuất nhập khẩu và kinh doanh xăng dầu, lọc - hóa dầu, đầu tư. Với mạng lưới phân phối gồm 4.365 cửa hàng bao gồm trạm bán lẻ của Petrolimex và các đại lý trên toàn quốc, Petrolimex là nhà cung cấp lớn nhất tất cả các loại sản phẩm xăng dầu trên thị trường nội địa. Bên cạnh đó, Petrolimex cũng hoạt động trên các lĩnh vực kinh doanh khác như bảo hiểm, ngân hàng, giao thông vận tải với các thương hiệu như PLC, PGC, PG TANKER, PJJICO. PLX được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 04/2017.","sector":"Dầu khí","type":"CT","listed":"2017-04-21","state":0.75871648,"foreign":0.14052035,"rating":"BUY","target":41100.0,"rating_as_of":"2025-10-13","source":"Vietcap"},"owners":[{"n":"Bộ Tài Chính","p":null,"t":"CORPORATE","q":981686626,"pct":75.87,"d":"2026-05-12"},{"n":"Công Ty TNHH Eneos Việt Nam","p":null,"t":"CORPORATE","q":169228476,"pct":13.08,"d":"2026-07-30"},{"n":"Công đoàn Tập đoàn Xăng dầu Việt Nam","p":null,"t":"CORPORATE","q":5000000,"pct":0.39,"d":"2026-05-12"},{"n":"Đinh Thái Hương","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":32800,"pct":0.003,"d":"2026-07-30"},{"n":"Quỹ ETF SSIAM VNX50","p":null,"t":"CORPORATE","q":20420,"pct":0.002,"d":"2020-07-14"},{"n":"Đào Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.002,"d":"2026-04-20"},{"n":"Hoàng Mai Ninh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":6820,"pct":0.001,"d":"2026-07-30"},{"n":"Lê Văn Hướng","p":null,"t":"INDIVIDUAL","q":6800,"pct":0.001,"d":"2025-10-05"},{"n":"Nguyễn Anh Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":11100,"pct":0.001,"d":"2026-07-30"},{"n":"Nguyễn Quang Dũng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":8100,"pct":0.001,"d":"2026-07-30"},{"n":"Quỹ Đầu tư Cổ phiếu Năng động Bảo Việt","p":null,"t":"CORPORATE","q":10820,"pct":0.001,"d":"2020-07-14"},{"n":"Vũ Lâm","p":null,"t":"INDIVIDUAL","q":12900,"pct":0.001,"d