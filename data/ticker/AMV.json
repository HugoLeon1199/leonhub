ản xuất sinh phẩn chẩn đoán công nghệ cao với toàn bộ dây chuyền và công nghệ hiện đại được chuyển giao từ Mỹ. Năng lực sản xuất: 25 triệu test/năm. Ngày 20/12/2009, AMV chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Y tế","type":"CT","listed":"2009-12-20","state":0.0,"foreign":0.00281944,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Hoàn Thiện","p":null,"t":"INDIVIDUAL","q":7319320,"pct":5.58,"d":"2022-06-23"},{"n":"Phạm Thế Vỹ","p":null,"t":"INDIVIDUAL","q":6308000,"pct":4.81,"d":"2025-10-05"},{"n":"Nguyễn Thị Hồng Hải","p":null,"t":"INDIVIDUAL","q":6092000,"pct":4.65,"d":"2025-10-05"},{"n":"Hoàng Văn Ba","p":null,"t":"INDIVIDUAL","q":5000000,"pct":3.81,"d":"2025-10-05"},{"n":"Lê Đức Khanh","p":null,"t":"INDIVIDUAL","q":5000000,"pct":3.81,"d":"2025-10-05"},{"n":"Phạm Thị Oanh","p":null,"t":"INDIVIDUAL","q":4712044,"pct":3.59,"d":"2025-10-05"},{"n":"Ngô Văn Bình","p":null,"t":"INDIVIDUAL","q":2740145,"pct":3.01,"d":"2025-10-05"},{"n":"Bùi Văn Hải","p":null,"t":"INDIVIDUAL","q":690000,"pct":2.54,"d":"2025-10-05"},{"n":"Phạm Việt Tấn","p":null,"t":"INDIVIDUAL","q":7500,"pct":0.354,"d":"2015-09-14"},{"n":"Quỹ Đầu tư Cân bằng Bản Việt","p":null,"t":"CORPORATE","q":64500,"pct":0.17,"d":"2026-08-17"},{"n":"Nguyễn Thị Yến Oanh","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.01,"d":"2025-10-05"},{"n":"Hà Tuyết Trinh","p":null,"t":"INDIVIDUAL","q":200,"pct":0.009,"d":"2025-10-05"}],"rel":[{"c":"12627","n":"Công ty CP Phát Triển Công Nghệ Hạ Long Kyoto","t":"subsidiary","pct":99.0},{"c":"12631","n":"Công Ty Cổ Phần Phòng Khám Medicare Cần Thơ","t":"subsidiary","pct":98.0},{"c":"12630","n":"Công Ty Cổ Phần Phòng Khám Medicare Hậu Giang","t":"subsidiary","pct":98.0},{"c":"12635","n":"Công Ty Cổ Phần Phòng Khám Việt Trì","t":"subsidiary","pct":98.0},{"c":"12633","n":"Công ty CP Phòng Khám Medicare Sóc Trăng","t":"subsidiary","pct":98.0},{"c":"12639","n":"Công ty Cổ Phần Phòng Khám Hòa Bình","t":"subsidiary",