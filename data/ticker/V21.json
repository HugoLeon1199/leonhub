ọng điểm quốc gia. Một số công trình trọng điểm mà công ty đã và đang thực hiện xây dựng, nâng cấp, cải tạo như: Mở rộng đường Cao tốc Láng - Hòa Lạc; Đường nội bộ Khu Công nghiệp Đài Tư; Đường vành đai 3; Công trình Chợ Hà Đông, Nhà điều hành Công ty Than Uông Bí... Ngày 21/04/2010, V21 chính thức được giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2010-04-21","state":0.0,"foreign":0.00035834,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Xuân Việt","p":null,"t":"INDIVIDUAL","q":6137699,"pct":18.6,"d":"2026-08-25"},{"n":"Nguyễn Mạnh Hà","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":3910000,"pct":11.85,"d":"2026-08-25"},{"n":"Nguyễn Huy Cường","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":3766899,"pct":11.41,"d":"2026-08-25"},{"n":"Vũ Đức Hoà","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2582700,"pct":7.83,"d":"2026-08-25"},{"n":"Nguyễn Ngọc Xuyên","p":null,"t":"INDIVIDUAL","q":2502900,"pct":7.58,"d":"2026-08-25"},{"n":"Nguyễn Xuân Pha","p":null,"t":"INDIVIDUAL","q":2000000,"pct":6.06,"d":"2026-08-25"},{"n":"Vũ Đức Hạnh","p":null,"t":"INDIVIDUAL","q":520000,"pct":4.33,"d":"2025-10-05"},{"n":"Lê Thị Hiếu","p":null,"t":"INDIVIDUAL","q":10200,"pct":0.6,"d":"2015-09-14"},{"n":"Tổng Công ty Cổ phần Xuất nhập khẩu và Xây dựng Việt Nam","p":null,"t":"CORPORATE","q":39000,"pct":0.33,"d":"2025-10-05"},{"n":"Tô Ngọc Thành","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.176,"d":"2015-09-14"},{"n":"Tống Văn Thuận","p":null,"t":"INDIVIDUAL","q":2020,"pct":0.119,"d":"2015-09-14"},{"n":"Nguyễn Tuấn Cường","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.118,"d":"2015-09-14"},{"n":"Nguyễn Cao Lâm","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.059,"d":"2015-09-14"},{"n":"Nguyễn Thị Quỳnh Trang","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.059,"d":"2015-09-14"},{"n":"Nguyễn Hữu Khánh","p":"Trưởng Ban kiểm soát"