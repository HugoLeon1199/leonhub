hi công 7.500m ống gang từ Nhà máy nước mặt Phú Mỹ ra hướng QL 51...Ngày 17/07/2019, PMW chính thức giao dịch trên thị trường UPCOM.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2019-07-17","state":0.16692184,"foreign":2e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Cấp Nước Châu Đức","p":null,"t":"CORPORATE","q":20237719,"pct":40.48,"d":"2026-08-04"},{"n":"Công ty Cổ phần Cấp Nước Bà Rịa - Vũng Tàu","p":null,"t":"CORPORATE","q":8346064,"pct":16.69,"d":"2026-08-04"},{"n":"Võ Thị Khánh Vân","p":null,"t":"INDIVIDUAL","q":672830,"pct":1.346,"d":"2026-08-04"},{"n":"Nguyễn Chiến Thắng","p":null,"t":"INDIVIDUAL","q":392378,"pct":1.31,"d":"2019-06-17"},{"n":"Đinh Chí Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":386301,"pct":0.773,"d":"2026-08-04"},{"n":"Lê Minh Đức","p":null,"t":"INDIVIDUAL","q":227133,"pct":0.57,"d":"2021-04-08"},{"n":"Nguyễn Lương Điền","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":278483,"pct":0.56,"d":"2026-08-04"},{"n":"Đinh Thị Quỳnh Trang","p":null,"t":"INDIVIDUAL","q":179443,"pct":0.359,"d":"2025-10-05"},{"n":"Nguyễn Thị Ngọc","p":null,"t":"INDIVIDUAL","q":158508,"pct":0.317,"d":"2026-08-04"},{"n":"Nguyễn Cảnh Tùng","p":null,"t":"INDIVIDUAL","q":156446,"pct":0.31,"d":"2026-08-04"},{"n":"Đoàn Hữu Hải","p":null,"t":"INDIVIDUAL","q":140569,"pct":0.281,"d":"2025-10-05"},{"n":"Nguyễn Thị Nhung","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":133504,"pct":0.27,"d":"2026-08-04"},{"n":"Võ Hiền Hiếu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":136969,"pct":0.27,"d":"2026-08-04"},{"n":"Nguyễn Văn Mạnh","p":null,"t":"INDIVIDUAL","q":130354,"pct":0.261,"d":"2026-01-07"},{"n":"Phạm Tấn Luận","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":125637,"pct":0.25,"d":"2026-08-04"},{"n":"Võ Thị Nhã","p":null,"t":"INDIVIDUAL","q":106077,"pct":0.21,"d":"2026-08-04"},{"n":"Nguyễn Châu Trực","p":"Phó Giám đốc","t":"INDIVIDUAL","q":58288,"pct":0.19,"d":"2