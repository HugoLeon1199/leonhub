 trường UPCOM từ tháng 10/2020.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-01-17","state":0.0,"foreign":0.15435583,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tô Ngọc Hoàng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":22818891,"pct":38.03,"d":"2026-07-29"},{"n":"Công ty Cổ phần Đầu Tư Bluecem Vietnam","p":null,"t":"CORPORATE","q":14727106,"pct":24.55,"d":"2026-01-21"},{"n":"Konex Limited","p":null,"t":"CORPORATE","q":9256998,"pct":15.43,"d":"2026-07-29"},{"n":"Tô Quang Anh","p":null,"t":"INDIVIDUAL","q":2356400,"pct":3.93,"d":"2026-01-21"},{"n":"Đỗ Hoàng Phúc","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1729647,"pct":2.88,"d":"2026-07-29"},{"n":"Nguyễn Trường Giang","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1300326,"pct":2.17,"d":"2026-07-29"},{"n":"Nguyễn Hữu Tưởng","p":null,"t":"INDIVIDUAL","q":297438,"pct":1.618,"d":"2015-09-14"},{"n":"Nguyễn Đình Tâm","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":559851,"pct":0.93,"d":"2026-07-29"},{"n":"Đinh Trọng Công","p":null,"t":"INDIVIDUAL","q":110359,"pct":0.6,"d":"2015-09-14"},{"n":"Trần Văn Hiếu","p":null,"t":"INDIVIDUAL","q":79000,"pct":0.43,"d":"2015-09-14"},{"n":"Hoàng Văn Thụy","p":null,"t":"INDIVIDUAL","q":73958,"pct":0.402,"d":"2015-09-14"},{"n":"Phan Ngô Chứ","p":null,"t":"INDIVIDUAL","q":28408,"pct":0.155,"d":"2015-09-14"},{"n":"Kim Trọng Bộ","p":null,"t":"INDIVIDUAL","q":25530,"pct":0.139,"d":"2015-09-14"},{"n":"Đặng Thu Hương","p":null,"t":"INDIVIDUAL","q":21970,"pct":0.12,"d":"2015-09-14"},{"n":"Nguyễn Thị Hoài","p":null,"t":"INDIVIDUAL","q":1949,"pct":0.005,"d":"2025-10-05"},{"n":"Vũ Trọng Hiệt","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6118,"pct":0.002,"d":"2026-07-29"},{"n":"Hoàng Văn Công","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":1092,"pct":0.001,"d":"2026-07-29"},{"n":"Phạm Quốc Hùng","p":null,"t":"INDIVIDUAL","q":490,"pct":0.001,"d":"2025-10-05"}],"rel":[{"c":"11020","n":"Công ty 