đang sở hữu mỏ đá trắng CaCo3 Quỳ Hợp với trữ lượng trên 40 triệu tấn, thời gian khai thác 30 năm cùng một loạt các dự án khác: NM sản xuất đá ốp lát nhân tạo CMISTONE tại Nghĩa Đàn, Nghệ An với công suất 1.000.000m2/năm. Dự án mỏ quặng sắt Yên Bái 3.000.000 tấn. Dự án khai thác, SX VLXD Vạn Xuân, Hà Tĩnh với trữ lượng 1.111.510 tấn. Dự án BĐS Từ Liêm trên 6000m2 trên đường Đỗ Đức Dục, quận Nam Từ Liêm, TP Hà Nội. Ngày14/06/2019, CMI chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-23","state":0.0,"foreign":0.00371875,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Xuất khẩu và Khai thác khoáng sản Việt Nam","p":null,"t":"CORPORATE","q":1897500,"pct":11.859,"d":"2025-10-05"},{"n":"Lê Tuấn Điệp","p":null,"t":"INDIVIDUAL","q":1449100,"pct":9.06,"d":"2025-10-05"},{"n":"Ngũ Thị Lam","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":794800,"pct":4.967,"d":"2026-03-09"},{"n":"Công ty Cổ phần Siêu Thị Thuốc Việt","p":null,"t":"CORPORATE","q":502099,"pct":3.138,"d":"2015-06-15"},{"n":"Trần Thanh Hiệp","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":460200,"pct":2.876,"d":"2026-03-09"},{"n":"Trần Thanh Hải","p":null,"t":"INDIVIDUAL","q":292700,"pct":1.829,"d":"2015-09-14"},{"n":"Trần Thanh Hữu","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":150000,"pct":0.94,"d":"2026-03-09"},{"n":"Phạm Uyên Nguyên","p":null,"t":"INDIVIDUAL","q":116000,"pct":0.73,"d":"2025-10-05"},{"n":"Công ty Cổ phần Cavico Xây dựng Nhân lực và Dịch vụ","p":null,"t":"CORPORATE","q":70010,"pct":0.438,"d":"2015-06-15"},{"n":"Nguyễn Văn Hùng","p":null,"t":"INDIVIDUAL","q":26514,"pct":0.17,"d":"2025-10-05"},{"n":"Đặng Minh Toàn","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.125,"d":"2015-09-14"},{"n":"Chu Thị Thúy Hồng","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.019,"d":"2015-09-14"}],"rel":[{"c":"0107984331","n":"Công ty TNHH MTV Cmistone Việt Nam","t":"subsidiary","pc