VGG là một trong những công ty hàng đầu trong lĩnh vực sản xuất quần áo trang trọng. Ngành nghề kinh doanh chính của công ty là sản xuất các sản phẩm may mặc và gia công may mặc. VGG là nhà sản xuất hợp đồng cho các khách hàng lớn như Nike, Calvin kein và SBS. Công ty hiện đang cung số lượng lớn sản phẩm với các thương hiệu, được phân loại thành 3 nhóm: (i) Sanciaro, Manhattan phân khúc thu nhập cao, (ii) Việt Tiến, Việt Tiến Smartcasual cho phân khúc thu nhập trung bình, và (iii) Việt Long cho phân khúc thu nhập thấp. Sản phẩm của VGG được xuất khẩu cho hơn 50 khách hàng nước ngoài mà chủ yếu đến từ Mỹ, châu Âu và Nhật Bản. VGG được giao dịch trên thị trường UPCOM từ tháng 03/2016.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2016-03-10","state":0.30398912,"foreign":0.15042739,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Dệt May Việt Nam","p":null,"t":"CORPORATE","q":13405920,"pct":30.4,"d":"2026-08-07"},{"n":"Công Ty TNHH MTV Đầu Tư Xuân Hồng","p":null,"t":"CORPORATE","q":8796273,"pct":19.95,"d":"2026-08-07"},{"n":"South Island Garment Sdn.bhd","p":null,"t":"CORPORATE","q":6415000,"pct":14.55,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Tân Thuận Tiến","p":null,"t":"CORPORATE","q":3323610,"pct":7.54,"d":"2026-08-07"},{"n":"Tung Shing Sewing Machine Company Limited","p":null,"t":"CORPORATE","q":2196000,"pct":4.98,"d":"2025-10-05"},{"n":"Phan Văn Kiệt","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":704539,"pct":1.6,"d":"2026-08-07"},{"n":"Nguyễn Đình Trường","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":367180,"pct":0.83,"d":"2026-08-07"},{"n":"Nguyễn Trâm Anh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":264510,"pct":0.6,"d":"2026-08-07"},{"n":"Trần Minh Công","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":242700,"pct":0.55,"d":"2026-08-07"},{"n":"Bùi Văn Tiến","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":205200,"pct"