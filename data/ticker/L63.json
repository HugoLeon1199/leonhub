.458],["2020-Q4",7.021],["2021-Q4",4.655],["2022-Q4",-4.836],["2023-Q4",8.931],["2024-Q4",14.489],["2025-Q4",5.73],["2026-Q2",5.73]],"y":[["2018",5.626],["2019",7.458],["2020",7.021],["2021",4.655],["2022",-4.836],["2023",8.931],["2024",14.489],["2025",5.73]]}},"co":{"short":"Lilama 69-3","profile":"Công ty Cổ phần LILAMA 69-3 (L63) là công ty con của Tổng công ty Lắp máy Việt Nam (LILAMA), hoạt động chủ yếu trong lĩnh vực gia công chế tạo và lắp đặt các thiết bị, dây chuyền sản xuất cho các nhà máy, công trình xây dựng. Công ty đã thi công các công trình trong nước tại các địa phương như Hải Dương, Hải Phòng, Quảng Ninh, Lào Cai, Hà Giang, Ninh Bình, Thanh Hóa và xuất khẩu các sản phẩm thiết bị sang thị trường nước ngoài bao gồm Nhật Bản, Hàn Quốc, Indonesia, Nam Phi. Với bề dày kinh nghiệm và năng lực sản xuất lớn, công ty đã thực hiện một số công trình với tư cách là Tổng thầu EPC và hướng tới làm tổng thầu cho các dự án EPC lò quay xi măng. L63 chính thức được giao dịch tại Thị trường UPCoM từ ngày 06/10/2016.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-10-06","state":0.36,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty lắp máy Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":2980570,"pct":36.0,"d":"2026-06-04"},{"n":"Cao Viết Cường","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1196403,"pct":14.45,"d":"2026-03-04"},{"n":"Nguyễn Mạnh Cường","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":324446,"pct":3.92,"d":"2026-03-04"},{"n":"Nguyễn Quốc Khánh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":321796,"pct":3.89,"d":"2026-03-04"},{"n":"Đỗ Trọng Toàn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":293000,"pct":3.54,"d":"2026-03-04"},{"n":"Vũ Văn Hậu","p":null,"t":"INDIVIDUAL","q":139721,"pct":1.8,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán Bảo Việt","p":null,"t":"CORPORATE","q":1238