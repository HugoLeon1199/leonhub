0.313],["2025",9.018]]}},"co":{"short":"Dược Vật Tư Y Tế Hải Dương","profile":"Công ty Cổ phần Dược Vật tư y tế Hải Dương (DHD) có tiền thân là Xí nghiệp liên hợp Dược Hải Hưng, được thành lập vào năm 1982. DHD hoạt động chính trong lĩnh vực sản xuất, kinh doanh các loại thuốc và vật tư y tế. Công ty chính thức đi vào hoạt động theo mô hình công ty cổ phần từ tháng 04/2003. DHD đang quản lý vận hành 6 dây chuyền sản xuất đạt tiêu chuẩn GMP-WHO, 1 phòng kiểm nghiệm đạt tiêu chuẩn GLP-WHO và 1 kho thành phẩm đạt tiêu chuẩn GDP – WHO. Bên cạnh đó, DHD đã phát triển được hệ thống phân phối với 12 chi nhánh trên toàn tỉnh và gần 200 quầy thuốc trải khắp các địa bàn trong tỉnh Hải Dương. DHD được giao dịch trên thị trường UPCOM từ Ngày 05/05/2017.","sector":"Y tế","type":"CT","listed":"2017-05-05","state":0.0,"foreign":0.00057573,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Trung Việt","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":20146855,"pct":41.46,"d":"2026-07-28"},{"n":"Trần Mai Lan","p":null,"t":"INDIVIDUAL","q":6735098,"pct":13.86,"d":"2026-07-28"},{"n":"Trần Phúc Dương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1973600,"pct":4.06,"d":"2026-07-28"},{"n":"Nguyễn Thị Tú Anh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1819773,"pct":3.74,"d":"2026-07-28"},{"n":"Vũ Văn Xuyến","p":null,"t":"INDIVIDUAL","q":1058289,"pct":2.18,"d":"2026-07-28"},{"n":"Nguyễn Trung Nam","p":null,"t":"INDIVIDUAL","q":731367,"pct":1.51,"d":"2026-07-28"},{"n":"Trần Văn Oanh","p":null,"t":"INDIVIDUAL","q":477751,"pct":0.98,"d":"2026-07-28"},{"n":"Phạm Thị Thủy","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":447876,"pct":0.92,"d":"2026-07-28"},{"n":"Trần Kim Cương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":249701,"pct":0.51,"d":"2026-07-28"},{"n":"Chu Văn Long","p":"Kế toán trưởng","t":"INDIVIDUAL","q":174999,"pct":0.36,"d":"2026-07-28"},{"n":"Vũ Hiền Minh Anh","p":null,"t":"INDIVIDUAL","q":1