ất 720MW), Thủy điện Sê San 3 (290MW), Thủy điện Sê San 3A (180MW), Thủy điện Pleikrông ( 120MW), Thủy điện Đăk Mi 4 (190MW) và (ii) Các công trình dân dụng: Nhà máy Xi măng Yaly (công suất 100.000 tấn / năm), Trạm biến áp 500KV tại PleiKu, Đường dây 500KV Lâm Đồng và Viện Xã hội học Campuchia.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-25","state":0.0,"foreign":0.0003552,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Sông Đà","p":null,"t":"CORPORATE","q":8160000,"pct":51.002,"d":"2026-05-26"},{"n":"Nguyễn Thị Tuyết Oanh","p":null,"t":"INDIVIDUAL","q":1484200,"pct":9.28,"d":"2025-10-05"},{"n":"Nguyễn Hữu Bằng","p":null,"t":"INDIVIDUAL","q":799303,"pct":5.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán VIX","p":null,"t":"CORPORATE","q":701100,"pct":4.38,"d":"2025-10-05"},{"n":"Công ty Cổ phần Xi măng Sông Đà Yaly","p":null,"t":"CORPORATE","q":250000,"pct":1.563,"d":"2015-06-15"},{"n":"Võ Thanh Hùng","p":null,"t":"INDIVIDUAL","q":1577,"pct":0.01,"d":"2015-09-14"}],"rel":[{"c":"5900336410","n":"CÔNG TY CỔ PHẦN THỦY ĐIỆN SÔNG ĐÀ 3 - ĐAK LÔ","t":"subsidiary","pct":98.97}],"rel_count":1,"events":[{"c":"AGME","t":"SD3 - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-11","record":"2026-05-27","ex":"2026-05-26"},{"c":"OTHE","t":"SD3 - Thay đổi địa chỉ","d":"2025-07-23","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Hữu Bằng - Đăng kí Bán SD3","d":"2025-04-02","record":null,"ex":null},{"c":"AGME","t":"SD3 - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-11","record":"2025-03-28","ex":"2025-03-27"},{"c":"DDIND","t":"Nguyễn Hữu Bằng - Đăng kí Bán SD3","d":"2025-02-27","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Hữu Bằng - Đăng kí Mua SD3","d":"2025-02-24","record":null,"ex":null},{"c":"OTHE","t":"SD3 - Thay đổi địa chỉ","d":"2024-12-11","record":null,"ex":null},{"c":"AGME","t":"SD3 - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-13","record":"2024-03-29","ex":"2024-03-28"},{"c":"AGME","t":"SD3 - Tổ 