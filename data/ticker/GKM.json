esort Fusion Maia Đà Nẵng, khu biệt thự Green bay, khu biệt thự Ciputra,... GKM được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-07-17","state":0.0,"foreign":0.00037287,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Chứng khoán APG","p":null,"t":"CORPORATE","q":2355564,"pct":7.49,"d":"2025-10-28"},{"n":"Vũ Hòa Bình","p":null,"t":"INDIVIDUAL","q":1445400,"pct":4.598,"d":"2026-06-25"},{"n":"Đặng Việt Lê","p":null,"t":"INDIVIDUAL","q":1343676,"pct":4.27,"d":"2026-01-22"},{"n":"Nguyễn Thị Hoa","p":null,"t":"INDIVIDUAL","q":1327248,"pct":4.22,"d":"2025-10-05"},{"n":"Đinh Tuấn Anh","p":null,"t":"INDIVIDUAL","q":1158400,"pct":3.69,"d":"2025-10-05"},{"n":"Đào Đức Phong","p":null,"t":"INDIVIDUAL","q":801500,"pct":3.37,"d":"2025-10-05"},{"n":"Nguyễn Việt Hà","p":null,"t":"INDIVIDUAL","q":732571,"pct":2.33,"d":"2025-10-05"},{"n":"Hoàng Văn Hải","p":null,"t":"INDIVIDUAL","q":488162,"pct":1.553,"d":"2026-03-05"},{"n":"Lê Hoài An","p":null,"t":"INDIVIDUAL","q":200000,"pct":1.34,"d":"2025-10-05"},{"n":"Phan Mỹ Linh","p":null,"t":"INDIVIDUAL","q":99225,"pct":0.66,"d":"2025-10-05"},{"n":"Phan Thị Mỹ Linh","p":null,"t":"INDIVIDUAL","q":99225,"pct":0.66,"d":"2025-10-05"},{"n":"Phạm Sĩ Giang","p":null,"t":"INDIVIDUAL","q":66150,"pct":0.4,"d":"2025-10-05"},{"n":"Hoàng Hạnh Phúc","p":null,"t":"INDIVIDUAL","q":40845,"pct":0.27,"d":"2025-10-05"},{"n":"Phan Thị Thu","p":null,"t":"INDIVIDUAL","q":33075,"pct":0.22,"d":"2025-10-05"},{"n":"Đặng Thị Yến Ngọc","p":null,"t":"INDIVIDUAL","q":33075,"pct":0.22,"d":"2025-10-05"},{"n":"NGUYỄN VĂN TIẾM","p":"Phó Giám đốc Sản xuất","t":"INDIVIDUAL","q":48024,"pct":0.153,"d":"2025-10-05"},{"n":"Phạm Ngọc Thuyết","p":null,"t":"INDIVIDUAL","q":16537,"pct":0.11,"d":"2025-10-05"},{"n":"Lương Thị Xuân Phương","p":null,"t":"INDIVIDUAL","q":18093,"pct":0.058,"d":"2025-10-05"},{"n":"Nguyễn Quốc Huy","p":null,"t":"INDIV