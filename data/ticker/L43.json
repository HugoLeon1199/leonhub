, Trà Vinh, Quảng Ngãi, Nhà máy Thủy điện Buôn Kuốp...","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-06-11","state":0.40828571,"foreign":0.00062857,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty lắp máy Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":1429000,"pct":40.829,"d":"2026-08-04"},{"n":"Trần Nguyễn Sông Hàn","p":null,"t":"INDIVIDUAL","q":650700,"pct":18.59,"d":"2026-01-06"},{"n":"Công ty Cổ phần Phát triển Hạ tầng Vĩnh Phúc","p":null,"t":"CORPORATE","q":346400,"pct":9.9,"d":"2025-10-22"},{"n":"Nguyễn Hữu Thành","p":null,"t":"INDIVIDUAL","q":97000,"pct":2.771,"d":"2015-09-14"},{"n":"Hoàng Việt","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":55000,"pct":1.571,"d":"2026-08-04"},{"n":"Nguyễn Quang Huy","p":null,"t":"INDIVIDUAL","q":35000,"pct":1.0,"d":"2015-09-14"},{"n":"Phạm Văn Thìn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":34900,"pct":1.0,"d":"2026-08-04"},{"n":"Phùng Viết Sơn","p":null,"t":"INDIVIDUAL","q":30100,"pct":0.86,"d":"2015-09-14"},{"n":"Trần Quang Du","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.343,"d":"2015-09-14"},{"n":"Huỳnh Văn Ba","p":null,"t":"INDIVIDUAL","q":11200,"pct":0.32,"d":"2015-09-14"},{"n":"Huỳnh Lê Hòa","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.286,"d":"2015-09-14"},{"n":"Vũ Quang Thể","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.286,"d":"2015-09-14"},{"n":"Nguyễn Thanh Chi","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.2,"d":"2015-09-14"},{"n":"Cù Thanh Nghị","p":"Kế toán trưởng","t":"INDIVIDUAL","q":2000,"pct":0.06,"d":"2026-08-05"},{"n":"Phạm Thị Bích Hà","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.06,"d":"2026-08-04"},{"n":"Mạc Thanh Hải","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1700,"pct":0.05,"d":"2026-08-04"}],"events":[{"c":"AGME","t":"L43 - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-06","record":"2026-03-24","ex":"2026-03-23"},{"c":"DDIND",