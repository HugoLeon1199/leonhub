19.099],["2023",19.64],["2024",17.715],["2025",17.072]]}},"co":{"short":"Dược - TB Y tế Bình Định","profile":"Công ty Cổ phần Dược - Trang thiết bị y tế Bình Định (DBD) có tiền thân là Công ty Dược-Trang thiết bị Y tế Bình Định được thành lập vào năm 1995. Công ty chính thức chuyển đổi sang hoạt động theo mô hình công ty cổ phần từ năm 2014. Các hoạt động kinh doanh chính của Công ty gồm: (i) sản xuất, kinh doanh dược phẩm, trang thiết bị y tế; (ii) nghiên cứu khoa học trong lĩnh vực y tế, dược phẩm và (iii) cung cấp các dịch vụ trong lĩnh vực sản xuất dược phẩm. DBD đang quản lý vận hành 01 Nhà máy sản xuất thuốc với 07 xưởng sản xuất, bao gồm 12 dây chuyền công nghệ sản xuất theo tiêu chuẩn GMP-WHO, hệ thống quản lý chất lượng ISO 9001:2015. DBD đã sản xuất gần 400 sản phẩm dược thuộc 19 nhóm thuốc điều trị. Sản phẩm của công ty hiện đang được phân phối trên khắp cả nước và xuất khẩu sang Lào, Campuchia, Mông Cổ. DBD được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2018.","sector":"Y tế","type":"CT","listed":"2017-01-16","state":0.1320818,"foreign":0.1661476,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Quỹ Đầu tư Phát triển Tỉnh Gia Lai","p":null,"t":"CORPORATE","q":12485606,"pct":13.21,"d":"2026-06-03"},{"n":"KWE Beteiligungen AG","p":null,"t":"CORPORATE","q":10542550,"pct":11.16,"d":"2026-06-30"},{"n":"Nguyễn Thị Thủy","p":null,"t":"INDIVIDUAL","q":2881762,"pct":3.08,"d":"2026-03-10"},{"n":"Trương Công Minh","p":null,"t":"INDIVIDUAL","q":1006249,"pct":1.06,"d":"2026-03-10"},{"n":"Nguyễn Thị Minh Thư","p":null,"t":"INDIVIDUAL","q":926250,"pct":0.98,"d":"2026-03-10"},{"n":"Công Đoàn Cơ Sở Công ty Cổ Phần Dược - Trang Thiết Bị Y Tế Bình Định","p":null,"t":"CORPORATE","q":877087,"pct":0.938,"d":"2026-03-10"},{"n":"Phạm Thị Thanh Hương","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":844292,"pct":0.9,"d":"2026-07-27"},{"n":"HUỲNH NGỌC O