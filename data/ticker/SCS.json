,["2024",51.905],["2025",52.42]]}},"co":{"short":"DV Hàng hóa Sài Gòn","profile":"Công ty Cổ phần Dịch vụ Hàng hóa Sài Gòn (SCS) được thành lập vào ngày 08/04/2008 với vốn điều lệ ban đầu là 300 tỷ đồng. Công ty chuyên cung cấp dịch vụ khai thác hàng hóa hàng không tại Cảng hàng không quốc tế Tân Sơn Nhất. Công ty đang quản lý và vận hành 143.000m2 nhà ga hàng hóa SCSC nằm ở phía Tây Nam ga hành khách – Cảng hàng không quốc tế Tân Sơn Nhất, bao gồm 52.421 m2 khu vực sân đậu máy bay có sức chứa 3 máy bay B747F hoặc 5 máy bay A321 cùng lúc, 26.670m2 khu vực nhà ga hàng hóa có công suất thiết kế 200.000 tấn hàng hóa trong giai đoạn 1 và 350.000 tấn hàng hóa trong giai đoạn 2, và 64.000m2 khu vực nhà kho, bãi đậu xe, đường giao thông, tòa nhà văn phòng và công trình phụ trợ. SCS được giao dịch trên thị trường UPCOM từ tháng 07/2017.","sector":"Du lịch và Giải trí","type":"CT","listed":"2017-07-12","state":0.13564417,"foreign":0.07976651,"rating":"M-PF","target":51200.0,"rating_as_of":"2026-01-13","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn Gemadept","p":null,"t":"CORPORATE","q":34117034,"pct":33.09,"d":"2026-08-13"},{"n":"Tổng Công ty Cảng Hàng không Việt Nam - CTCP","p":null,"t":"CORPORATE","q":13984600,"pct":13.56,"d":"2026-08-13"},{"n":"Công Ty TNHH Một Thành Viên Sửa Chữa Máy Bay 41","p":null,"t":"CORPORATE","q":7213125,"pct":6.99,"d":"2026-08-13"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":4627535,"pct":4.9,"d":"2025-10-05"},{"n":"Đoàn Ngọc Cương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1796466,"pct":1.87,"d":"2026-08-14"},{"n":"Đặng Thị Thanh Trà","p":null,"t":"INDIVIDUAL","q":1730700,"pct":1.8,"d":"2026-08-24"},{"n":"Nguyễn Quốc Khánh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1449550,"pct":1.406,"d":"2026-08-13"},{"n":"Bùi Thị Thu Hương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":85550,"pct":0.083,"d":"2026-08-13"},{"n":"Mai Xuân Cảnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDU