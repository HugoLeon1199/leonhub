.634],["2020",18.116],["2021",13.621],["2022",19.397],["2023",17.704],["2024",19.158],["2025",20.903]]}},"co":{"short":"FPT Telecom","profile":"Công ty Cổ phần Viễn thông FPT (FOX) có tiền thân là Trung Tâm Dữ liệu trực tuyến FPT, được thành lập vào năm 1997. Công ty hoạt động chính trong lĩnh vực cung cấp các dịch vụ internet viễn thông. FPT Telecom chính thức hoạt động theo mô hình công ty cổ phần từ tháng 07/2005. Một số sản phẩm và dịch vụ của Công ty như: ung cấp dịch vụ internet thông qua các mạng kết nối giữa khách hàng ISP; cung cấp dịch vụ viễn thông qua các kết nối viễn thông hiện có như VOIP (điện thoại internet); hoạt động của các điều truy cập internet Internet băng thông rộng: ADSL/VDSL, TripplePlay, FTTH; truyền hình trực tuyến OneTV, giám sát từ xa IP Camera, điện toán đám mây.FOX có nhiều dịch vụ trực tuyến như: Online media (Hệ thống báo điện từ VNExpress với hơn 15 tỷ lượt xem mỗi ngày), FPT Play, FShare, Fsend, Mix166, Startalk (nền tảng truyền hình trực tuyến đầu tiên của Việt Nam). Ngày 13/01/2017, FOX chính thức giao dịch trên thị trường UPCOM.","sector":"Viễn thông","type":"CT","listed":"2017-01-13","state":0.5017432,"foreign":1.619e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bộ Công An","p":null,"t":"CORPORATE","q":370669546,"pct":50.17,"d":"2026-06-15"},{"n":"Công ty Cổ phần FPT","p":null,"t":"CORPORATE","q":337291780,"pct":45.66,"d":"2026-06-15"},{"n":"Chu Thị Thanh Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":4800000,"pct":0.65,"d":"2026-01-21"},{"n":"Công ty Cổ Phần HNT","p":null,"t":"CORPORATE","q":3000000,"pct":0.41,"d":"2026-01-21"},{"n":"Trương Thị Thanh Thanh","p":null,"t":"INDIVIDUAL","q":2501362,"pct":0.339,"d":"2026-01-21"},{"n":"Nguyễn Văn Khoa","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":917911,"pct":0.124,"d":"2026-01-21"},{"n":"Đỗ Thị Hương","p":null,"t":"INDIVIDUAL","q":579315,"pct":0.078,"d":"2026-07-28"},{"n":"Nguyễn Hoàng Linh","p":"Thành viên Hội đồng