và đang tiêu thụ với hơn 100 sản phẩm chế biến từ cá basa, cá tra với hệ thống phân phối rộng khắp 50 tỉnh thành trong cả nước. Ngày 24/02/2020, AGF chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2002-05-02","state":0.08242309,"foreign":0.00464337,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Hùng Vương","p":null,"t":"CORPORATE","q":22370625,"pct":79.58,"d":"2026-08-24"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":2316892,"pct":8.24,"d":"2026-08-24"},{"n":"Nguyễn Hoàng Hoài Phương","p":null,"t":"INDIVIDUAL","q":45044,"pct":0.16,"d":"2015-09-14"},{"n":"Võ Tòng Xuân","p":null,"t":"INDIVIDUAL","q":38748,"pct":0.138,"d":"2015-09-14"},{"n":"Phan Thị Lượm","p":null,"t":"INDIVIDUAL","q":32503,"pct":0.116,"d":"2015-09-14"},{"n":"Nguyễn Thị Hoàng Yến","p":null,"t":"INDIVIDUAL","q":30007,"pct":0.107,"d":"2015-09-14"},{"n":"Tăng Phước Quang","p":null,"t":"INDIVIDUAL","q":27000,"pct":0.096,"d":"2015-09-14"},{"n":"Lê Công Định","p":null,"t":"INDIVIDUAL","q":18000,"pct":0.064,"d":"2015-09-14"},{"n":"Huỳnh Việt Nhân","p":null,"t":"INDIVIDUAL","q":2307,"pct":0.008,"d":"2015-09-14"},{"n":"Lê Văn Điệp","p":null,"t":"INDIVIDUAL","q":2,"pct":0.0,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"AGF - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-01-20","record":"2026-02-27","ex":"2026-02-26"},{"c":"AGME","t":"AGF - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-01-21","record":"2025-02-27","ex":"2025-02-26"},{"c":"AGME","t":"AGF - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-01-09","record":"2024-02-20","ex":"2024-02-19"},{"c":"AGME","t":"AGF - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-02-17","record":"2023-03-15","ex":"2023-03-14"},{"c":"AGME","t":"AGF - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-02-07","record":"2022-02-28","ex":"2022-02-25"},{"c":"AGME","t":"AGF - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-02-09","record":"2021-03-02","ex":"20