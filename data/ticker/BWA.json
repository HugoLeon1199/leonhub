,6.616],["2019",7.151],["2020",0.0],["2021",6.077],["2022",4.604],["2023",4.387],["2024",2.978],["2025",1.199]]}},"co":{"short":"Cấp thoát nước và Xây dựng Bảo Lộc","profile":"Công ty Cổ phần Cấp thoát nước và Xây dựng Bảo Lộc (BWA) tiền thân là nhà máy nước Bảo Lộc được thành lập từ những năm 1970. Năm 2008, công ty tiến hành cổ phần hóa. Công ty là doanh nghiệp kinh doanh độc quyền mặt hàng nước sạch trên địa bàn thị xã Bảo Lộc dưới sự điều phối của Ủy ban Nhân dân tỉnh Lâm Đồng. Bên cạnh đó, công ty còn quản lý hệ thống thoát nước, xử lý nước thải và rác thải tại các khu đô thị và khu công nghiệp trong thành phố. Hiện tại, công ty cung cấp khoảng 53% nhu cầu về nước sạch cho khu vực nội thị trong thành phố. BWA chính thức được niêm yết trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2010.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2010-06-14","state":0.75937037,"foreign":0.00022222,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Lâm Đồng","p":null,"t":"CORPORATE","q":2050300,"pct":75.94,"d":"2026-01-23"},{"n":"Nguyễn Văn Độ","p":null,"t":"INDIVIDUAL","q":59600,"pct":2.207,"d":"2025-10-05"},{"n":"Nguyễn Thị Diễm Loan","p":null,"t":"INDIVIDUAL","q":34700,"pct":1.28,"d":"2025-10-05"},{"n":"Nguyễn Trọng Hiếu","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":31700,"pct":1.16,"d":"2026-01-23"},{"n":"Nguyễn Hữu Kiên","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":11900,"pct":0.44,"d":"2026-01-23"},{"n":"Võ Thành Y","p":null,"t":"INDIVIDUAL","q":10900,"pct":0.41,"d":"2025-10-05"},{"n":"Trần Thị Đoàn Sinh","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.37,"d":"2025-10-05"},{"n":"Võ Thành Nam","p":null,"t":"INDIVIDUAL","q":7300,"pct":0.27,"d":"2025-10-05"},{"n":"Võ Thị Thái Thanh","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.26,"d":"2025-10-05"},{"n":"Nguyễn Quốc Tuyến","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.2,"d":"2025-10-05"},{"n":"Phan Thị Trầm","p":null,"t":"INDIVIDUAL