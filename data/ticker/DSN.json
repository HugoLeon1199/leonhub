i giải trí và thể thao dưới nước tại Việt Nam theo tiêu chuẩn Châu Âu. Hiện tại, DSN đang quản lý và điều hành Công viên Nước Đầm Sen và Công viên Khủng long. DSN được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Du lịch và Giải trí","type":"CT","listed":"2010-10-26","state":0.0,"foreign":0.14591862,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Dịch vụ Du lịch Phú Thọ","p":null,"t":"CORPORATE","q":4052434,"pct":33.54,"d":"2026-09-03"},{"n":"Kenji Yabe","p":null,"t":"INDIVIDUAL","q":1284086,"pct":10.63,"d":"2026-09-03"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":568600,"pct":4.7,"d":"2025-10-05"},{"n":"Nguyễn Quốc Khánh","p":null,"t":"INDIVIDUAL","q":71500,"pct":0.59,"d":"2025-10-05"},{"n":"Nguyễn Chánh Lộc","p":null,"t":"INDIVIDUAL","q":36296,"pct":0.43,"d":"2015-09-14"},{"n":"Phạm Duy Hưng","p":null,"t":"INDIVIDUAL","q":41551,"pct":0.34,"d":"2025-10-05"},{"n":"Đặng Huy Huân","p":null,"t":"INDIVIDUAL","q":27612,"pct":0.327,"d":"2015-09-14"},{"n":"Lê Thị Mỹ Sương","p":null,"t":"INDIVIDUAL","q":34354,"pct":0.28,"d":"2025-10-05"},{"n":"Đặng Ngọc Thiên Tử","p":null,"t":"INDIVIDUAL","q":27885,"pct":0.23,"d":"2025-10-05"},{"n":"Thái Uyển Phấn","p":null,"t":"INDIVIDUAL","q":13988,"pct":0.166,"d":"2015-09-14"},{"n":"Đặng Ngọc Nghĩa","p":null,"t":"INDIVIDUAL","q":19134,"pct":0.16,"d":"2025-10-05"},{"n":"Nguyễn Quang Trường","p":"Phó Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":15730,"pct":0.13,"d":"2026-09-03"},{"n":"Vũ Ngọc Tuấn","p":"Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":7550,"pct":0.062,"d":"2026-09-03"},{"n":"Đặng Ngọc Bảo Quyên","p":null,"t":"INDIVIDUAL","q":5577,"pct":0.05,"d":"2025-10-05"},{"n":"Đặng Ngọc Niệm Thư","p":null,"t":"INDIVIDUAL","q":4714,"pct":0.04,"d":"2025-10-05"},{"n":"Nguyễn Hoàng Tố Nga","p":null,"t":"INDIVIDUAL","q":1430,"pct":0.01,"d":"2025-10-05"},{"n":"Nguyễn Quốc Long","p":nu