transtimex là một doanh nghiệp vận tải hàng đầu ở Việt Nam và Khu vực về vận chuyển, xếp dỡ và lắp đặt hàng siêu trường siêu trọng, hàng dự án và thiết bị toàn bộ. Có mặt trong Top 50 Công ty vận tải hàng nặng hàng đầu thế giới liên tục từ 2011 đến nay. Ngày 15/05/2014, VXT chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2014-05-15","state":0.0,"foreign":4.8e-07,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Kho Vận Miền Nam","p":null,"t":"CORPORATE","q":19539896,"pct":93.17,"d":"2026-08-20"},{"n":"Nguyễn Đăng Sâm","p":null,"t":"INDIVIDUAL","q":28569,"pct":0.136,"d":"2015-09-14"},{"n":"Lê Văn Hùng","p":null,"t":"INDIVIDUAL","q":23230,"pct":0.111,"d":"2015-09-14"},{"n":"Hà Tiến Đức","p":null,"t":"INDIVIDUAL","q":23134,"pct":0.11,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"VTX - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-06","record":"2026-03-16","ex":"2026-03-13"},{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 33.4%","d":"2025-10-28","record":null,"ex":null},{"c":"AGME","t":"VTX - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-27","record":"2025-04-14","ex":"2025-04-11"},{"c":"AGME","t":"VTX - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-05-04","record":"2024-05-24","ex":"2024-05-23"},{"c":"AGME","t":"VTX - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-05-05","record":"2023-05-23","ex":"2023-05-22"},{"c":"AGME","t":"VTX - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-25","record":"2022-04-12","ex":"2022-04-08"},{"c":"AGME","t":"VTX - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-04-23","record":"2021-05-10","ex":"2021-05-07"},{"c":"DDINS","t":"Công ty Cổ phần Kho Vận Miền Nam - Đăng kí Mua 3,355,571 VTX","d":"2020-10-21","record":null,"ex":null},{"c":"DDIND","t":"Đỗ Hoàng Phương - Đăng kí Bán VTX","d":"2020-10-14","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Kho Vận Miền Nam - Đăng kí Mua 3,355,571 VTX","d":"2020-09-16","record":null,"ex":n