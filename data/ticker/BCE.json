 thuật công nghệ của công ty đạt vào hạng khá. Trong lĩnh vực bất động sản, BCE đã thực hiện thành công nhiều dự án lớn như Trung tâm thương mại Mỹ Phước II, phố thương mại Rich Town... Ngày 28/06/2010 BCE chính thức giao dịch tại Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-28","state":0.44420899,"foreign":0.02660967,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Đầu tư và Phát triển Công nghiệp Becamex - CTCP","p":null,"t":"CORPORATE","q":15547258,"pct":44.42,"d":"2026-06-16"},{"n":"Công ty Cổ phần Quản lý quỹ đầu tư MB","p":null,"t":"CORPORATE","q":1452700,"pct":4.842,"d":"2015-06-15"},{"n":"Nguyễn Kim Tiên","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":386014,"pct":0.92,"d":"2026-08-27"},{"n":"Trần Thiện Thể","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":200000,"pct":0.48,"d":"2026-08-13"},{"n":"Lê Phan Minh Vũ","p":null,"t":"INDIVIDUAL","q":136750,"pct":0.456,"d":"2015-09-14"},{"n":"Đỗ Văn Minh","p":null,"t":"INDIVIDUAL","q":128773,"pct":0.429,"d":"2015-09-14"},{"n":"Phạm Viết Yên","p":"Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":100000,"pct":0.24,"d":"2026-08-24"},{"n":"Lương Thị Quỳnh Hoa","p":"Giám đốc Tài chính/Kế toán trưởng","t":"INDIVIDUAL","q":77400,"pct":0.18,"d":"2026-08-27"},{"n":"HỒ MINH DIỄM THUÝ","p":null,"t":"INDIVIDUAL","q":59000,"pct":0.17,"d":"2025-10-05"},{"n":"Nguyễn Thành Trung","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":70000,"pct":0.17,"d":"2026-07-28"},{"n":"Nguyễn Thị Bửu","p":null,"t":"INDIVIDUAL","q":33750,"pct":0.11,"d":"2025-10-05"},{"n":"Cao Đình Tuệ Minh","p":"Phó Tổng Giám đốc Tài chính - Kinh doanh","t":"INDIVIDUAL","q":20000,"pct":0.05,"d":"2026-08-24"},{"n":"Lai Nhật Xuân Trang","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":20538,"pct":0.05,"d":"2026-07-28"},{"n":"Trần Nhật Khoa","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL