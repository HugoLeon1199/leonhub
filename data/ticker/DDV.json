n công suất 12 MW, và nhà máy xử lý nước thải công suất 40 m3/giờ. Từ năm 2015, DDV được giao dịch trên thị trường UPCOM.","sector":"Hóa chất","type":"CT","listed":"2015-06-10","state":0.64,"foreign":0.02802755,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Hóa chất Việt Nam","p":null,"t":"CORPORATE","q":93510336,"pct":64.0,"d":"2026-07-31"},{"n":"Công ty Cổ phần The Golden Group","p":null,"t":"CORPORATE","q":2500000,"pct":1.71,"d":"2025-10-05"},{"n":"Nguyễn Văn Oanh","p":null,"t":"INDIVIDUAL","q":505900,"pct":0.346,"d":"2026-07-31"},{"n":"Hoàng Mạnh Thắng","p":null,"t":"INDIVIDUAL","q":500000,"pct":0.34,"d":"2020-05-07"},{"n":"Cao Thị Hồng","p":null,"t":"INDIVIDUAL","q":300000,"pct":0.205,"d":"2025-10-05"},{"n":"Nguyễn Tuấn Dũng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":209000,"pct":0.143,"d":"2026-07-31"},{"n":"Nguyễn Ngọc Sơn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":58000,"pct":0.04,"d":"2026-07-31"},{"n":"Nguyễn Thị Mai","p":null,"t":"INDIVIDUAL","q":46000,"pct":0.032,"d":"2025-10-05"},{"n":"Trần Văn Đoàn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":42000,"pct":0.029,"d":"2026-07-31"},{"n":"Nguyễn Hoàng Trung","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":18000,"pct":0.012,"d":"2026-07-31"},{"n":"Nguyễn Văn Phiên","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5600,"pct":0.004,"d":"2026-07-31"},{"n":"Bùi Đăng Duẩn","p":null,"t":"INDIVIDUAL","q":4700,"pct":0.003,"d":"2025-10-05"},{"n":"Nguyễn Thị Thu Hằng","p":null,"t":"INDIVIDUAL","q":1600,"pct":0.001,"d":"2015-09-14"},{"n":"Vũ Văn Bằng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":2100,"pct":0.001,"d":"2026-07-31"},{"n":"Đoàn Thị Minh Thúy","p":null,"t":"INDIVIDUAL","q":2100,"pct":0.001,"d":"2025-10-05"},{"n":"Lê Ngọc Nhân","p":null,"t":"INDIVIDUAL","q":600,"pct":0.0,"d":"2026-06-26"}],"events":[{"c":"DIV","t":"Trả cổ 