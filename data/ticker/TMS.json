âm Phân phối Transimex với diện tích 18.000m2 tại khu công nghiệp Sóng Thần 2, Bình Dương, Trung tâm Logistics Transimex Đà Nẵng với diên tích 16.000m2 và Trung tâm Logistics Transimex tại Khu công nghệ cao Thành phố Hồ Chí Minh với diện tích 100,000m2. Ngày 04/08/2000, TMS chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2000-08-04","state":0.03123819,"foreign":0.41222815,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Logistics Quốc Tế Ryobi Việt Nam","p":null,"t":"CORPORATE","q":36207790,"pct":20.96,"d":"2026-05-28"},{"n":"Công Ty Cổ Phần Prosper Logistics","p":null,"t":"CORPORATE","q":32187392,"pct":18.63,"d":"2026-05-28"},{"n":"Bùi Minh Tuấn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":25033967,"pct":14.49,"d":"2026-05-28"},{"n":"Công Ty CP Dịch Vụ Văn Hóa Việt","p":null,"t":"CORPORATE","q":17734608,"pct":10.27,"d":"2026-05-28"},{"n":"Công ty TNHH Đầu Tư Và Thương Mại Thiên Hải","p":null,"t":"CORPORATE","q":13047587,"pct":7.55,"d":"2026-08-03"},{"n":"Công ty Cổ Phần Đầu Tư New Asia","p":null,"t":"CORPORATE","q":12662030,"pct":7.33,"d":"2026-05-28"},{"n":"Công ty Cổ Phần Đầu Tư Vi Na","p":null,"t":"CORPORATE","q":12412177,"pct":7.19,"d":"2026-05-28"},{"n":"Halley Sicav - Halley Asian Prosperity","p":null,"t":"CORPORATE","q":1300362,"pct":5.472,"d":"2015-06-15"},{"n":"Tổng Công ty Thương Mại Sài Gòn - TNHH Một Thành Viên","p":null,"t":"CORPORATE","q":5395903,"pct":3.12,"d":"2026-05-28"},{"n":"Vietnam Dragon Fund Limited","p":null,"t":"CORPORATE","q":423150,"pct":1.78,"d":"2015-06-15"},{"n":"Vietnam Ventures Limited","p":null,"t":"CORPORATE","q":300000,"pct":1.262,"d":"2015-06-15"},{"n":"Trần Hồng Đởm","p":null,"t":"INDIVIDUAL","q":289440,"pct":1.218,"d":"2015-09-14"},{"n":"Wareham Group Limited","p":null,"t":"CORPORATE","q":231000,"pct":0.972,"d":"2015-06-15"},{"n":"Công ty Cổ phần VINAPRINT","p":null,"t":"CO