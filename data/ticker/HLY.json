",-68.97],["2023",456.764],["2024",13.315],["2025",9.617]]}},"co":{"short":"Gốm Xây Dựng Yên Hưng","profile":"Công ty cổ phần Hạ long I Viglacera (HLY) tiền thân là Xí nghiệp gạch Yên Hưng được thành lập năm 1960. Năm 2003, công ty chuyển sang hoạt động theo mô hình cổ phần. Tháng 01/2007, công ty đổi tên thành Công ty Cổ phần Viglacera Hạ Long I. Hoạt động kinh doanh chính của công ty là sản xuất và kinh doanh gốm xây dựng bằng đất sét nung như các loại gạch xây bao gồm: gạch rỗng hai lỗ, bốn lỗ, sáu lỗ, gạch đặc và gạch nem tách mang thương hiệu của Viglacera. Công ty đã trang bị hệ thống máy móc thiết bị 02 hệ lò tuynel với công xuất 36 triệu viên QTC/năm và một hệ đùn ép CMK502 với năng xuất 100.000 viên/ca. Sản phẩm của Công ty được tiêu thụ chủ yếu tại Quảng Ninh, Hải Phòng, Hà Nội với trên 200 điểm bán hàng. HLY chính thức được giao dịch trên thị trường UPCOM từ Ngày 28/04/2021.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-04","state":0.26,"foreign":0.009626,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Viglacera - Công ty Cổ phần","p":null,"t":"CORPORATE","q":260000,"pct":26.0,"d":"2026-05-15"},{"n":"Lê Thị Nhàn","p":null,"t":"INDIVIDUAL","q":183600,"pct":18.36,"d":"2026-05-21"},{"n":"Nguyễn Minh Tuấn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":103400,"pct":10.34,"d":"2026-08-04"},{"n":"Nguyễn Đức Bằng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":77600,"pct":7.6,"d":"2026-08-04"},{"n":"Nguyễn Hợi","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":53480,"pct":5.34,"d":"2026-08-04"},{"n":"Nguyễn Thị Thanh Bình","p":null,"t":"INDIVIDUAL","q":50600,"pct":5.06,"d":"2026-04-02"},{"n":"Phạm Thị Trà My","p":null,"t":"INDIVIDUAL","q":50504,"pct":5.05,"d":"2025-10-05"},{"n":"Shih Kuan Tung","p":null,"t":"INDIVIDUAL","q":49900,"pct":4.99,"d":"2025-10-05"},{"n":"Lưu Thị Thoa","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":44180,"pct":4.41,"d":"2026-08-04"}