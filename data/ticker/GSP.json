n đang sở hữu đội tàu gồm 7 con tàu có trọng tải từ 1.600DWT đến 5.200 DWT. GSP cung cấp dịch vụ vận tải khí hóa lỏng bằng xe bồn với địa bàn trải dài từ Đà Nẵng đến miền Tây Nam Bộ. Đối với thị trường xuất khẩu, Công ty là đầu mối cung cấp dịch vụ vận tả̉i cho cá́c đơn vị xuất khẩu LPG sang Campuchia. GSP được giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 03/2012.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2012-03-09","state":0.0,"foreign":0.00670238,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Vận tải Dầu khí","p":null,"t":"CORPORATE","q":45898139,"pct":67.98,"d":"2026-08-21"},{"n":"Nguyễn Phùng Hưng","p":null,"t":"INDIVIDUAL","q":22000,"pct":0.073,"d":"2015-09-14"},{"n":"Nguyễn Ngọc Anh","p":null,"t":"INDIVIDUAL","q":14000,"pct":0.047,"d":"2015-09-14"},{"n":"Nguyễn Kim Sơn","p":null,"t":"INDIVIDUAL","q":11000,"pct":0.037,"d":"2015-09-14"},{"n":"Nguyễn Văn Ổn","p":null,"t":"INDIVIDUAL","q":11000,"pct":0.037,"d":"2015-09-14"},{"n":"Trần Văn Luấn","p":null,"t":"INDIVIDUAL","q":6000,"pct":0.02,"d":"2015-09-14"},{"n":"Dương Hữu Tường","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.017,"d":"2015-09-14"},{"n":"Nguyễn Anh Minh","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.017,"d":"2015-09-14"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 10.0%","d":"2026-07-29","record":"2026-08-07","ex":"2026-08-06"},{"c":"AGME","t":"GSP - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-20","record":"2026-04-02","ex":"2026-04-01"},{"c":"AIS","t":"GSP - Niêm yết bổ sung 6.137.785 cổ phiếu","d":"2025-09-25","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 10.0%","d":"2025-08-05","record":"2025-08-14","ex":"2025-08-13"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 500 VND","d":"2025-08-05","record":"2025-08-14","ex":"2025-08-13"},{"c":"AGME","t":"GSP - Tổ chức ĐHĐCĐ thường niên 2025","d":"202