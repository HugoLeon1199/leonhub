ủa Nhà máy Lọc dầu Dung Quất với sản lượng bình quân lần lượt là 14.400 tấn/năm và 6.000 tấn/năm. Bên cạnh đó, Công ty còn cung cấp dịch vụ quản lý vận hành, cho thuê nhà ở, cung cấp dịch vụ lưu trú, các dịch vụ hậu cần khác. PBT được giao dịch trên thị trường UPCOM từ tháng 01/2018.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2019-01-18","state":0.11196948,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần - Tổng Công ty Lọc Hoá dầu Việt Nam","p":null,"t":"CORPORATE","q":14589284,"pct":83.26,"d":"2026-06-04"},{"n":"Trần Anh Triển","p":null,"t":"INDIVIDUAL","q":1275000,"pct":7.28,"d":"2026-07-17"},{"n":"Doanh Nghiệp Tư Nhân Khách Sạn Cẩm Thành","p":null,"t":"CORPORATE","q":550000,"pct":3.14,"d":"2026-07-17"},{"n":"Trần Xuân Thu","p":null,"t":"INDIVIDUAL","q":104500,"pct":0.596,"d":"2026-04-24"},{"n":"Huỳnh Việt Cường","p":"Kế toán trưởng","t":"INDIVIDUAL","q":71050,"pct":0.405,"d":"2026-08-12"},{"n":"Trần Đoàn Thịnh","p":null,"t":"INDIVIDUAL","q":9500,"pct":0.054,"d":"2025-10-05"},{"n":"Trần Đức Hợp","p":null,"t":"INDIVIDUAL","q":4500,"pct":0.026,"d":"2026-02-26"},{"n":"Huỳnh Trịnh Văn","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.006,"d":"2026-08-12"},{"n":"Nguyễn Tấn Phát","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":500,"pct":0.003,"d":"2026-08-12"},{"n":"Phạm Thanh Thảo","p":null,"t":"INDIVIDUAL","q":500,"pct":0.003,"d":"2026-04-24"},{"n":"Đỗ Thị Phương Thúy","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":300,"pct":0.002,"d":"2026-08-12"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 728 VND","d":"2026-08-14","record":"2026-09-07","ex":"2026-09-04"},{"c":"AGME","t":"PBT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-26","record":"2026-03-18","ex":"2026-03-17"},{"c":"OTHE","t":"PBT - Thay đổi địa chỉ","d":"2025-12-22","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 709 VND","d":"2025-06-19","record":"2025-06-27","ex":"2