 là Công ty Thương mại Dịch vụ Bến Thành được thành lập năm 2003. Công ty chính thức hoạt động theo mô hình công ty cổ phần từ năm 2007. Công ty hoạt động chủ yếu trong lĩnh vực kinh doanh hàng gia dụng, cung cấp dịch vụ kho vận, nhà hàng, khách sạn tại khu vực thành phố Hồ Chí Minh và các tỉnh lân cận. Hiện nay công ty đang khai thác và quản lý kho hàng với diện tích 5.246 m2 có vị trí cận kề các cảng container quốc tế Việt Nam, Tân Thuận, Bến Nghé và Khánh Hội thuận tiện để phát triển dịch vụ kho bãi và vận chuyển hàng hóa.","sector":"Bất động sản","type":"CT","listed":"2011-01-05","state":0.47113272,"foreign":0.04833774,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Bến Thành - TNHH MTV","p":null,"t":"CORPORATE","q":1484420,"pct":47.11,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu Tư & Tm Thiên Hải","p":null,"t":"CORPORATE","q":1349000,"pct":42.82,"d":"2025-10-05"},{"n":"Bùi Minh Tuấn","p":null,"t":"INDIVIDUAL","q":152000,"pct":4.82,"d":"2025-10-05"},{"n":"Trần Anh Tuấn","p":null,"t":"INDIVIDUAL","q":18600,"pct":0.59,"d":"2015-09-14"},{"n":"Nguyễn Văn Miên","p":null,"t":"INDIVIDUAL","q":12870,"pct":0.408,"d":"2015-09-14"},{"n":"Hoàng Phong Giao","p":null,"t":"INDIVIDUAL","q":100,"pct":0.003,"d":"2025-10-05"}],"rel":[{"c":"BTNV","n":"CÔNG TY CỔ PHẦN BẾN THÀNH NHẤT VIỆT","t":"subsidiary","pct":60.0},{"c":"BTLOGIS","n":"Công ty Cổ Phần Giao Nhận Bến Thành","t":"affiliate","pct":38.34},{"c":"12335","n":"Công ty CP Dịch Vụ Vĩnh Lộc - Bến Thành","t":"affiliate","pct":27.24}],"rel_count":3,"events":[{"c":"SUSP","t":"BSC - Hủy niêm yết cổ phiếu trên sàn HNX","d":"2025-12-16","record":null,"ex":null},{"c":"OTHE","t":"BSC - Thay đổi địa chỉ","d":"2025-08-26","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 1,000 VND","d":"2025-08-20","record":"2025-09-05","ex":"2025-09-04"},{"c":"AGME","t":"BSC - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-01-24","record":"2025-02-12","ex":"2025-02-11"},{"c":"AGME"