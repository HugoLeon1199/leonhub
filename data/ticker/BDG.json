ành lập năm 1989. Công ty chuyển đổi sang hình thức cổ phần từ năm 2015. Hoạt động kinh doanh chính của công ty là gia công áo sơ mi, quần jeans và quần kaki. Công ty có 4 xưởng sản xuất với công suất 200.000 áo sơ mi và 700.000 quần các loại một tháng. Thị trường tiêu thụ chính là Châu Âu và Mỹ. Khách hàng chủ chốt bao gồm Rock Revival, Miss Me, Pacific Sunwear (Hoa Kỳ); Olymp, Tom Tailor, Tommy Hilfiger (EU). BDG chính thức được giao dịch tại Thị trường Upcom vào năm 2016.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2016-04-06","state":0.47707485,"foreign":0.014164,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Sản xuất - Xuất nhập khẩu Bình Dương - Công ty cổ phần","p":null,"t":"CORPORATE","q":11831418,"pct":49.52,"d":"2026-08-05"},{"n":"Công Ty TNHH Thương Mại Việt Vương","p":null,"t":"CORPORATE","q":9677580,"pct":39.02,"d":"2026-08-05"},{"n":"Công ty TNHH Một Thành Viên Quốc Tế Protrade","p":null,"t":"CORPORATE","q":634975,"pct":2.56,"d":"2026-08-28"},{"n":"Nguyễn Thị Trúc Thanh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":19547,"pct":0.08,"d":"2026-08-05"},{"n":"Nguyễn Xuân Quân","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Giám đốc khối","t":"INDIVIDUAL","q":18523,"pct":0.07,"d":"2026-08-05"},{"n":"NGUYỄN HỒNG ANH","p":null,"t":"INDIVIDUAL","q":15896,"pct":0.06,"d":"2025-10-05"},{"n":"Phan Thành Đức","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":15140,"pct":0.06,"d":"2026-08-05"},{"n":"Đoàn Thị Kim Ngân","p":null,"t":"INDIVIDUAL","q":4166,"pct":0.02,"d":"2025-10-05"},{"n":"Hứa Tuấn Cường","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2420,"pct":0.01,"d":"2026-08-05"},{"n":"Nguyễn Minh Thuỳ","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1406,"pct":0.01,"d":"2026-08-05"}],"rel":[{"c":"12321","n":"Công ty CP Phát Triển Thời Trang","t":"affiliate","pct":76.08}],"rel_count":1,"events":[{"c":"DDINS","t":"Công ty TNHH Một Thành Viên Quốc Tế Protrade - Đăng kí Mua 181,70