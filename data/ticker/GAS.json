["2025-Q3",20.095],["2025-Q4",18.583],["2026-Q1",18.193],["2026-Q2",20.425]],"y":[["2018",26.52],["2019",26.042],["2020",16.566],["2021",17.236],["2022",26.465],["2023",18.133],["2024",18.585],["2025",18.583]]}},"co":{"short":"PV Gas","profile":"Tổng Công ty Khí Việt Nam-CTCP (GAS) có tiền thân là Công ty Khí đốt được thành lập vào năm 1990, là đơn vị thành viên thuộc Tập Đoàn Dầu Khí Quốc gia Việt Nam. GAS chủ yếu hoạt động trong lĩnh vực thu gom, vận chuyển, lưu trữ, chế biến, xuất khẩu, nhập khẩu, kinh doanh khí và các sản phẩm khí. Công ty hiện đang vận hành 3 hệ thống đường ống khí Cửu Long, Nam côn Sơn ở miền Đông Nam và PM3 ở vùng Tây Nam và 2 nhà máy chế biến khí là Dinh Cổ và Nam Côn Sơn ở khu vực Đông Nam và hệ thống Kho LPG rộng khắp cả nước. GAS có năng lực sản xuất 450.000 - 500.000 tấn LPG/năm và 70.000 tấn condensate/năm. Tổng Công ty giữ vị thế số 1 về cung cấp LPG với hơn 70% thị phần trên thị trường LPG Việt Nam. GAS được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2012.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2012-05-21","state":0.95762163,"foreign":0.02050366,"rating":"BUY","target":90000.0,"rating_as_of":"2026-07-29","source":"Vietcap"},"owners":[{"n":"Tập Đoàn Công Nghiệp – Năng Lượng Quốc Gia Việt Nam","p":null,"t":"CORPORATE","q":2243391142,"pct":95.76,"d":"2026-08-03"},{"n":"Đỗ Khang Ninh","p":null,"t":"INDIVIDUAL","q":107000,"pct":0.006,"d":"2015-09-14"},{"n":"Nguyễn Thị Lan","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.005,"d":"2015-09-14"},{"n":"Quỹ Đầu tư Cổ phiếu Manulife","p":null,"t":"CORPORATE","q":46450,"pct":0.002,"d":"2020-07-14"},{"n":"Quỹ ETF SSIAM VNX50","p":null,"t":"CORPORATE","q":18260,"pct":0.001,"d":"2020-07-14"},{"n":"Quỹ Đầu tư Cổ phiếu Năng động Bảo Việt","p":null,"t":"CORPORATE","q":9660,"pct":0.001,"d":"2020-07-14"},{"n":"Quỹ Đầu tư Tăng trưởng DFVN","p":null,"t":"CORPORATE","q":26000,"pct":0.001,"d":"2020-07-14"},{"n":"Công ty TNHH Quản Lý Quỹ Kim Việt Nam","p":n