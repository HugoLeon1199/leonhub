ET; nhựa tái chế như PC, PE, PP, ABS và các loại phụ gia cho nhựa PVC... Hiện tại, trung bình mỗi năm Công ty cung ứng cho thị trường khoảng 20.000 tấn nhựa các loại, chiếm 5% tổng sản lượng cung ứng của toàn thị trường, đứng trong Top 10 các doanh nghiệp lớn cung ứng nguyên liệu nhựa trên thị trường. Ngày 18/08/2015, VNP chính thức giao dịch trên thị trường UPCOM.","sector":"Hóa chất","type":"CT","listed":"2015-08-18","state":0.65852073,"foreign":0.00787486,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":12794342,"pct":65.85,"d":"2026-02-24"},{"n":"Vũ Thị Minh Thục","p":"Thành viên Hội đồng Quản trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":5400,"pct":0.02,"d":"2026-02-24"}],"rel":[{"c":"TRAPLAST","n":"Công ty TNHH MTV Thương Mại Và Dịch Vụ Nhựa Trường An","t":"subsidiary","pct":100.0},{"c":"PLASTRACO","n":"Công ty TNHH MTV Thương mại và Dịch vụ Nhựa Số Một","t":"subsidiary","pct":100.0},{"c":"VINAPLASTTRA","n":"Công ty TNHH Thương Mại Và Dịch Vụ Nhựa Việt Nam","t":"subsidiary","pct":100.0},{"c":"VIPLAST","n":"Công ty Cổ Phần Nhựa Việt Phước","t":"subsidiary","pct":99.52},{"c":"VIETTHAIPC","n":"Công ty TNHH Liên Doanh Việt Thái Plastchem","t":"affiliate","pct":27.51},{"c":"VANDONPLASTIC","n":"Công ty Cổ phần Nhựa Vân Đồn","t":"affiliate","pct":20.69},{"c":"TPCVINA","n":"Công ty TNHH Nhựa Và Hóa Chất TPC Vina","t":"affiliate","pct":15.0}],"rel_count":7,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 800 VND","d":"2026-06-19","record":"2026-06-30","ex":"2026-06-29"},{"c":"AGME","t":"VNP - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-06","record":"2026-03-25","ex":"2026-03-24"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 2,000 VND","d":"2025-06-10","record":"2025-06-18","ex":"2025-06-17"},{"c":"AGME","t":"VNP - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-27","record":"2025-04-14","ex":"2025-04-11"