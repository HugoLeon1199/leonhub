hơ, Siemen – Đức tại Nhà máy nhiệt điện Cà Mau, Ascom – Pháp Nhà máy điện Nhơn Trạch. Ngày 15/11/2010, LM8 chính thức giao dịch trên Sở Giao dịch chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-11-15","state":0.35999994,"foreign":0.00448263,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty lắp máy Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":3379925,"pct":36.0,"d":"2026-07-29"},{"n":"Nguyễn Dương Hồng Phát","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1412860,"pct":15.05,"d":"2026-07-29"},{"n":"Trần Mạnh Hùng","p":null,"t":"INDIVIDUAL","q":914293,"pct":9.74,"d":"2026-07-29"},{"n":"Nguyễn Hùng Bính","p":null,"t":"INDIVIDUAL","q":443200,"pct":4.721,"d":"2026-03-02"},{"n":"Võ Thị Thân","p":null,"t":"INDIVIDUAL","q":403100,"pct":4.293,"d":"2026-03-02"},{"n":"Nguyễn Ngọc Đông","p":null,"t":"INDIVIDUAL","q":369649,"pct":3.937,"d":"2025-10-05"},{"n":"Đinh Đức Trọng","p":null,"t":"INDIVIDUAL","q":250000,"pct":2.662,"d":"2025-10-05"},{"n":"Ngô Quang Định","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":175000,"pct":1.864,"d":"2026-03-02"},{"n":"Nguyễn Văn Chử","p":null,"t":"INDIVIDUAL","q":85849,"pct":0.914,"d":"2026-03-02"},{"n":"Phạm Mạnh Đức","p":"Kế toán trưởng/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":51060,"pct":0.544,"d":"2026-03-02"},{"n":"Nguyễn Thị Anh Thư","p":null,"t":"INDIVIDUAL","q":47061,"pct":0.501,"d":"2026-03-02"},{"n":"Trần Quốc Toản","p":null,"t":"INDIVIDUAL","q":37762,"pct":0.402,"d":"2025-10-05"},{"n":"Lê Quốc Ân","p":null,"t":"INDIVIDUAL","q":33075,"pct":0.352,"d":"2025-10-05"},{"n":"Trần Sỹ Quỳnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":24917,"pct":0.265,"d":"2026-03-02"},{"n":"Trần Văn Tiến","p":null,"t":"INDIVIDUAL","q":24211,"pct":0.258,"d":"2026-08-13"},{"n":"Cao Nguyên Soái","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":23059,"pct":0.246,"d":"2026-