 khẩu sang các nước Thái Lan, Campuchia, Srilanka, Hàn Quốc, Pakistan.v.v... Các công xưởng của công ty có tổng cộng 5 dây chuyền sản xuất có công suất thiết kế với sản lượng đạt 5,5 triệu m2/năm. Ngày 07/01/2010, TTC chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-08-08","state":0.50999992,"foreign":0.04583546,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Vật liệu Xây dựng số 1 - Công ty Cổ phần","p":null,"t":"CORPORATE","q":3056097,"pct":51.0,"d":"2026-02-24"},{"n":"Trần Thị Xuân Anh","p":null,"t":"INDIVIDUAL","q":590100,"pct":9.85,"d":"2026-03-05"},{"n":"Vương Gia Hưng","p":null,"t":"INDIVIDUAL","q":298000,"pct":5.02,"d":"2026-05-07"},{"n":"Trần Hưng Lương","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":14350,"pct":0.24,"d":"2026-03-05"},{"n":"Võ Thị Thu Thủy","p":"Phó Tổng Giám đốc/Kế toán trưởng","t":"INDIVIDUAL","q":11000,"pct":0.18,"d":"2026-03-05"},{"n":"Hồ Hữu Phước","p":null,"t":"INDIVIDUAL","q":9060,"pct":0.153,"d":"2015-09-14"},{"n":"Châu Thị Diệu Phương","p":null,"t":"INDIVIDUAL","q":5800,"pct":0.098,"d":"2015-09-14"},{"n":"Nguyễn Đức Lợi","p":null,"t":"INDIVIDUAL","q":5110,"pct":0.08,"d":"2025-10-05"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":3600,"pct":0.06,"d":"2025-10-05"},{"n":"Lê Xuân Thái","p":null,"t":"INDIVIDUAL","q":3791,"pct":0.06,"d":"2026-03-05"},{"n":"Trần Văn Dũng","p":null,"t":"INDIVIDUAL","q":3180,"pct":0.053,"d":"2026-03-05"},{"n":"Nguyễn Thừa Vũ","p":null,"t":"INDIVIDUAL","q":2087,"pct":0.035,"d":"2026-03-05"},{"n":"Đặng Đình Thống","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1000,"pct":0.017,"d":"2026-03-05"},{"n":"Khương Thị Chăm","p":null,"t":"INDIVIDUAL","q":500,"pct":0.008,"d":"2015-09-14"},{"n":"Trần Hưng Du","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":100,"pct":0.002,"d":"2026-03-05"}],"rel":[{"c":"PJS1","n":"Công ty Cổ Phần 