8",5.275],["2019",5.537],["2020",0.0],["2021",8.721],["2022",8.087],["2023",15.004],["2024",16.25],["2025",17.856]]}},"co":{"short":"Cấp nước Phú Hòa Tân","profile":"Công ty Cổ phần Cấp nước Phú Hòa Tân (PJS) có tiền thân là Xí nghiệp Đường ống, được thành lập vào năm 1991. Công ty đi vào hoạt động dưới hình thức công ty cổ phần từ 01/02/2007. Hoạt động kinh doanh chính của công ty là quản lý, phát triển hệ thống cấp nước, cung ứng, kinh doanh nước sạch cho nhu cầu tiêu dùng, sản xuất, xây dựng các công trình cấp nước. Công ty là đơn vị duy nhất cung cấp nước sạch tại khu vực Quận 10, Quận 11 và Phường Phú Trung – Quận Tân Phú, thành phố Hồ Chí Minh. PJS được giao dịch trên thị trường UPCOM từ tháng 12/2011.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2011-12-05","state":0.70391111,"foreign":0.07104422,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cấp nước Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":6335200,"pct":70.391,"d":"2026-02-27"},{"n":"Ngân hàng TNHH MTV Số Vikki","p":null,"t":"CORPORATE","q":900000,"pct":10.0,"d":"2026-02-27"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":631998,"pct":7.02,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu tư Thương mại Du lịch Hiệp Phúc","p":null,"t":"CORPORATE","q":150000,"pct":1.667,"d":"2015-06-15"},{"n":"Nguyễn Năng Thân","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.111,"d":"2015-09-14"},{"n":"Vũ Phương Thảo","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.011,"d":"2025-10-05"},{"n":"Nguyễn Thành Tính","p":"Thư ký Hội đồng Quản Trị","t":"INDIVIDUAL","q":800,"pct":0.009,"d":"2026-02-27"},{"n":"Bùi Đức Sinh","p":"Phó Giám đốc Điều hành/Phó Giám đốc Kỹ thuật","t":"INDIVIDUAL","q":500,"pct":0.006,"d":"2026-02-27"},{"n":"Nguyễn Hiền Vũ","p":null,"t":"INDIVIDUAL","q":500,"pct":0.006,"d":"2015-09-14"},{"n":"Trần Ngọc Phong","p":null,"t":"INDIVIDUAL","q":200,"pct":0.002,"d":"2015-09-14"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả 