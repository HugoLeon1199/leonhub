 công ty Tân Cảng Sài Gòn và chủ yếu thi công theo hình thức chỉ định thầu và đấu thầu. Một trong các công trình tiêu biểu của công ty có thể đến Hệ thống Cảng Tân Cảng Cát Lái - cảng container hiện đạt và lớn nhất Việt Nam hiện tại.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2022-12-01","state":0.51,"foreign":0.00023333,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Tổng Công ty Tân Cảng Sài Gòn","p":null,"t":"CORPORATE","q":4590000,"pct":51.0,"d":"2022-11-30"},{"n":"Phạm Văn Tiến","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4000,"pct":0.04,"d":"2023-08-09"},{"n":"Phạm Đình Hưng","p":"Phó Giám đốc","t":"INDIVIDUAL","q":3600,"pct":0.04,"d":"2023-08-09"},{"n":"Trần Văn Sang","p":"Phó Giám đốc","t":"INDIVIDUAL","q":3600,"pct":0.04,"d":"2023-08-09"},{"n":"Nguyễn Trường Giang","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1200,"pct":0.01,"d":"2023-08-09"},{"n":"Đỗ Phú Đạt","p":null,"t":"INDIVIDUAL","q":500,"pct":0.006,"d":"2023-05-05"}],"events":[{"c":"SUSP","t":"XDC - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2023-12-11","record":null,"ex":null},{"c":"DDIND","t":"Đỗ Phú Đạt - Đăng kí Mua XDC","d":"2023-05-05","record":null,"ex":null},{"c":"NLIS","t":"XDC - Chính thức đăng ký giao dịch trên UPCOM","d":"2022-11-23","record":null,"ex":null}],"st":{"bsa15":{"label":"Hàng tồn kho, ròng","section":"balance","y":[["2021",23.487],["2022",6.309]],"published":"2023-05-21"},"bsa2":{"label":"Tiền và tương đương tiền","section":"balance","y":[["2021",34.52],["2022",25.747]],"published":"2023-05-21"},"bsa53":{"label":"TỔNG CỘNG TÀI SẢN","section":"balance","y":[["2021",239.041],["2022",228.679]],"published":"2023-05-21"},"bsa54":{"label":"NỢ PHẢI TRẢ","section":"balance","y":[["2021",149.041],["2022",138.679]],"published":"2023-05-21"},"bsa6":{"label":"Đầu tư ngắn hạn","section":"balance","y":[["2021",0.0],["2022",0.0]],"published":"2023-05-21"},"bsa78":{"label":"Vốn chủ sở hữu","section":"ba