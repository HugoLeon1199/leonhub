của Công ty là sản xuất và kinh doanh Xi măng trắng PCW 30.1 (tỷ trọng chiếm 66% trong tổng khối lượng sản phẩm sản xuất của Công ty); Xi măng trắng PCW 40.1 (chiếm 29%); Xi măng trắng PCW (chiếm 2%); Xi măng Pooclăng hỗn hợp PCB 30, PCB 40 (chiếm 2%) và các loại xi măng khác. Hiện nay Công ty Xi măng Thái Bình là doanh nghiệp xi măng duy nhất trong cả nước sản xuất khép kín sản phầm xi măng trắng chiếm khoảng 30% thị phần Xi măng trắng nội địa, công suất của công ty là 30.000 tấn Xi măng trắng/năm. Sản phẩm của Công ty được tiêu thụ tại thị trường Hà Nội, thành phố Hồ Chí Minh, Ninh Bình, Thanh Hoá, Nghệ An, Đà Nẵng.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2008-11-18","state":0.0,"foreign":0.00014567,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Vũ Tiến Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":360000,"pct":23.84,"d":"2025-10-05"},{"n":"BÙI THỊ NGUYÊN HẠNH","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":350000,"pct":23.17,"d":"2025-10-05"},{"n":"Công ty CP Kiến Trúc Mỹ Thuật Treelife","p":null,"t":"CORPORATE","q":297575,"pct":19.703,"d":"2025-10-05"},{"n":"Nguyễn Hữu Biền","p":null,"t":"INDIVIDUAL","q":140000,"pct":9.27,"d":"2015-09-14"},{"n":"Công Ty Cổ Phần Thương Mại Xi Măng Thái Bình","p":null,"t":"CORPORATE","q":101627,"pct":6.729,"d":"2025-10-05"},{"n":"Nguyễn Việt Thành","p":null,"t":"INDIVIDUAL","q":78500,"pct":5.198,"d":"2015-09-14"},{"n":"Hoàng Quốc Tùng","p":null,"t":"INDIVIDUAL","q":68800,"pct":4.555,"d":"2015-09-14"},{"n":"Đinh Thu Trang","p":null,"t":"INDIVIDUAL","q":54800,"pct":3.628,"d":"2015-09-14"},{"n":"Trương Anh Hùng","p":null,"t":"INDIVIDUAL","q":49100,"pct":3.251,"d":"2015-09-14"},{"n":"Tống Hải Đường","p":null,"t":"INDIVIDUAL","q":32160,"pct":2.129,"d":"2015-09-14"},{"n":"Nguyễn Nam Cường","p":null,"t":"INDIVIDUAL","q":16100,"pct":1.066,"d":"2015-09-14"},{"n":"Vũ Thị Cấp","p":null,"t":"INDIVIDUAL","q":15934,"pct":1.055,"d":"2015-09-14"},{"n":"Phạm Quang Liêm","p"