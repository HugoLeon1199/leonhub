ới chứng khoán, tư vấn tài chính và đầu tư chứng khoán, và lưu ký chứng khoán. DSC trở thành công ty đại chúng vào cuối năm 2017. Năm 2025, Doanh thu nghiệp vụ môi giới chứng khoán có giá trị bằng 113,78 tỷ đồng, tăng 9.43% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 92.3%, tăng 5.68%. Lợi nhuận trước thuế có giá trị bằng 344,03 tỷ đồng, tăng 55.89%. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 10.14%, tăng 2.51%. Ngày 24/10/2024, DSC chính thức giao dịch trên Sở giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Dịch vụ tài chính","type":"CK","listed":"2018-01-05","state":0.0,"foreign":0.00021498,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty CP Đầu Tư Ntp","p":null,"t":"CORPORATE","q":81900000,"pct":29.782,"d":"2026-07-28"},{"n":"Nguyễn Đức Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":65360046,"pct":23.77,"d":"2026-07-28"},{"n":"Lê Ngọc Đức","p":null,"t":"INDIVIDUAL","q":32350177,"pct":11.76,"d":"2025-11-13"},{"n":"Văn Lê Hằng","p":null,"t":"INDIVIDUAL","q":10025000,"pct":4.89,"d":"2025-10-05"},{"n":"Nguyễn Thị Thu Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3034940,"pct":1.1,"d":"2026-07-28"},{"n":"Bạch Quốc Vinh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Giám đốc Chi nhánh TP HCM/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":1902755,"pct":0.69,"d":"2026-07-28"},{"n":"Trần Minh Toản","p":"Kế toán trưởng","t":"INDIVIDUAL","q":170743,"pct":0.06,"d":"2026-07-28"},{"n":"Nguyễn Thị Ánh Nguyệt","p":null,"t":"INDIVIDUAL","q":59000,"pct":0.029,"d":"2025-10-05"},{"n":"Nguyễn Thị Hiền Ngọc","p":null,"t":"INDIVIDUAL","q":25000,"pct":0.025,"d":"2025-10-05"},{"n":"Vũ Nhật Lâm","p":null,"t":"INDIVIDUAL","q":25000,"pct":0.012,"d":"2025-10-05"},{"n":"Bùi Văn Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":20137,"pct":0.01,"d":"2026-07-28"},{"n":"Nguyễn Thị Hiền Ngọc","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":33562,"pct":0.01,"d":"2026-07-28"},{"n":"Lê Thị