ình Sơn tổng diện tích 500ha, Khu nhà ở Công nhân tại Xã Hiệp Phước...Ngày 12/11/2007, UIC chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2007-11-12","state":0.64448604,"foreign":0.07625421,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty IDICO - CTCP","p":null,"t":"CORPORATE","q":5354390,"pct":64.45,"d":"2025-11-12"},{"n":"KB Vietnam QVM Securities Master Fund","p":null,"t":"CORPORATE","q":389430,"pct":4.87,"d":"2025-10-05"},{"n":"Nguyễn Văn Thế Bảo","p":null,"t":"INDIVIDUAL","q":120000,"pct":1.44,"d":"2025-10-05"},{"n":"Nguyễn Hoàng Công","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":109000,"pct":1.311,"d":"2026-07-31"},{"n":"Nguyễn Thị Cúc Nhật","p":null,"t":"INDIVIDUAL","q":100000,"pct":1.2,"d":"2025-10-05"},{"n":"Vũ Công Khái","p":null,"t":"INDIVIDUAL","q":94200,"pct":1.177,"d":"2015-09-14"},{"n":"Phan Văn Quang","p":null,"t":"INDIVIDUAL","q":82120,"pct":1.026,"d":"2015-09-14"},{"n":"Đặng Việt Dũng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":80000,"pct":1.0,"d":"2026-07-30"},{"n":"Nguyễn Thị Kim Dung","p":null,"t":"INDIVIDUAL","q":70100,"pct":0.876,"d":"2015-09-14"},{"n":"Nguyễn Văn Thịnh","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":40000,"pct":0.5,"d":"2026-07-30"},{"n":"Phạm Thiếu Sơn","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.5,"d":"2015-09-14"},{"n":"Đỗ Huy Thảo","p":null,"t":"INDIVIDUAL","q":25120,"pct":0.314,"d":"2015-09-14"},{"n":"Trịnh Xuân Tấn","p":null,"t":"INDIVIDUAL","q":24000,"pct":0.3,"d":"2015-09-14"},{"n":"Mai Thị Nguyệt","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":14500,"pct":0.174,"d":"2026-07-30"},{"n":"Nguyễn Mạnh Toại","p":"Giám đốc Tài chính/Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":13100,"pct":0.158,"d":"2026-07-30"},{"n":"Mai Quốc Chinh","p":null,"t":"INDIVIDUAL","q":4900,"pct":0.061,"d":"2022-05-11"},{"n