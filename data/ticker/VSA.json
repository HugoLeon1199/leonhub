49 Teus hàng xuất và 78.097 Teus hàng nhập; ngoài ra còn có 34.277 Teus hàng xuất và nhập rỗng... Ngày 22/12/2015, VSA chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2015-12-22","state":0.51054128,"foreign":0.02921913,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Hàng hải Việt Nam - CTCP","p":null,"t":"CORPORATE","q":7196838,"pct":51.05,"d":"2026-08-11"},{"n":"Lương Duyên Nga","p":null,"t":"INDIVIDUAL","q":1732616,"pct":12.29,"d":"2025-10-05"},{"n":"Trần Hồng Quang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":980540,"pct":6.956,"d":"2026-08-11"},{"n":"Công ty Cổ phần Cung ứng tàu biển Đà Nẵng","p":null,"t":"CORPORATE","q":722500,"pct":6.202,"d":"2015-08-14"},{"n":"Đào Bá Dong","p":null,"t":"INDIVIDUAL","q":588400,"pct":5.05,"d":"2025-10-05"},{"n":"Phan Văn Khánh","p":null,"t":"INDIVIDUAL","q":2400,"pct":0.05,"d":"2025-10-05"},{"n":"Phạm Mạnh Cường","p":null,"t":"INDIVIDUAL","q":4225,"pct":0.03,"d":"2025-10-05"},{"n":"Hoàng Hoa Phòng","p":null,"t":"INDIVIDUAL","q":3146,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Bích Thảo","p":null,"t":"INDIVIDUAL","q":3630,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Đức Thiện","p":"Thành viên Hội đồng Quản trị/Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":1936,"pct":0.014,"d":"2026-08-11"},{"n":"Nguyễn Thế Tiệp","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":500,"pct":0.01,"d":"2026-08-11"},{"n":"Nguyễn Thị Thanh Trang","p":"Phó Giám đốc","t":"INDIVIDUAL","q":1452,"pct":0.01,"d":"2025-11-06"},{"n":"Vũ Xuân Trung","p":null,"t":"INDIVIDUAL","q":2783,"pct":0.01,"d":"2025-10-05"},{"n":"Nguyễn Mạnh Hùng","p":null,"t":"INDIVIDUAL","q":1210,"pct":0.009,"d":"2025-10-05"},{"n":"TRỊNH VŨ KHOA","p":null,"t":"INDIVIDUAL","q":1089,"pct":0.008,"d":"2025-10-05"},{"n":"Lê Hoàng","p":null,"t":"INDIVIDUAL","q":605,"pct":0.004,"d":"2025-10-05"},{"n":"Trần Công Toàn","p":"Phụ trách Công bố thông tin","t