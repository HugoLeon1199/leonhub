t liệu, thiết bị phụ tùng phục vụ cho ngành thép. Thép Việt Ý hiện được trang bị một dây chuyền cán thép vào loại hiện đại nhất do tập đoàn Danieli (Ý) cung cấp. Nhà máy sản xuất phôi thép của Công ty có công suất 500.000 tấn/năm, công nghệ Consteel nhập khẩu từ Italy. Sản phẩm của Công ty được sử dụng tại các công trình lớn, trọng điểm quốc gia như thủy điện Sơn La, thủy điện Lai Châu, Tháp Keangnam, Trung tâm hội nghị quốc gia, Cầu Thanh Trì, Royal City...","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2006-12-25","state":0.0,"foreign":0.73922204,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Kyoei Steel Ltd.","p":null,"t":"CORPORATE","q":723761820000,"pct":98.03,"d":"2023-10-26"},{"n":"Lê Thành Thực","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1179040,"pct":1.6,"d":"2022-03-10"},{"n":"Trần Văn Thạnh","p":null,"t":"INDIVIDUAL","q":121372,"pct":0.247,"d":"2016-03-08"},{"n":"Nguyễn Ngọc Thịnh","p":null,"t":"INDIVIDUAL","q":52022,"pct":0.106,"d":"2016-03-08"},{"n":"Đinh Văn Vì","p":null,"t":"INDIVIDUAL","q":18870,"pct":0.038,"d":"2015-09-14"},{"n":"Nguyễn Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":23014,"pct":0.03,"d":"2020-08-04"},{"n":"Nguyễn Đức Dân","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.02,"d":"2015-09-14"},{"n":"Trần Quang Đường","p":null,"t":"INDIVIDUAL","q":9163,"pct":0.019,"d":"2016-03-08"},{"n":"Phùng Minh Bằng","p":null,"t":"INDIVIDUAL","q":6370,"pct":0.013,"d":"2015-09-14"},{"n":"Nguyễn Minh Phúc","p":null,"t":"INDIVIDUAL","q":5007,"pct":0.01,"d":"2016-03-08"},{"n":"NGUYỄN THANH HÀ","p":null,"t":"INDIVIDUAL","q":3006,"pct":0.004,"d":"2020-08-04"},{"n":"Đặng Thị Tuyết Dung","p":"Kế toán trưởng","t":"INDIVIDUAL","q":103,"pct":0.0,"d":"2022-03-10"}],"events":[{"c":"SUSP","t":"VIS - Hủy niêm yết trên sàn HOSE","d":"2022-03-22","record":null,"ex":null},{"c":"AGME","t":"VIS - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-02-26","record":"2021-02-18","ex":"2021-02-17"},{"c":"AGME","t":"VIS - Tổ chức ĐHĐCĐ thư