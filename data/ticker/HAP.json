sản xuất giấy lớn thứ 2 trong ngành công nghiệp giấy miền Bắc có tổng công suất trên 60.000 tấn/năm. HAP được giao dịch trên Sở giao dịch chứng khoán Thành phố Hồ Chí Minh từ ngày 06/09/2021.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2000-08-04","state":0.0,"foreign":0.01284602,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Vũ Dương Hiền","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":24833744,"pct":22.35,"d":"2026-07-30"},{"n":"Công Ty Cổ Phần Đại Lý Cánh Đồng Xanh","p":null,"t":"CORPORATE","q":5555000,"pct":5.01,"d":"2026-03-18"},{"n":"Công ty Cổ Phần Cánh Đồng Xanh","p":null,"t":"CORPORATE","q":5549000,"pct":5.0,"d":"2026-08-21"},{"n":"Phạm Anh Đào","p":null,"t":"INDIVIDUAL","q":5559820,"pct":5.0,"d":"2025-10-05"},{"n":"Phạm Thị Kim Nhung","p":null,"t":"INDIVIDUAL","q":5559400,"pct":5.0,"d":"2025-10-05"},{"n":"Phạm Thị Tuyết Lan","p":null,"t":"INDIVIDUAL","q":5558080,"pct":5.0,"d":"2025-10-05"},{"n":"Vũ Xuân Thủy","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":4910680,"pct":4.426,"d":"2026-07-30"},{"n":"Vũ Xuân Thịnh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":4779094,"pct":4.308,"d":"2026-07-30"},{"n":"Vũ Xuân Cường","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":4144511,"pct":3.736,"d":"2026-07-30"},{"n":"Trần Quang Tiến","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":4119000,"pct":3.71,"d":"2026-07-27"},{"n":"Asiavantage Global Limited","p":null,"t":"CORPORATE","q":1024679,"pct":1.989,"d":"2015-06-15"},{"n":"Khổng Văn Oanh","p":null,"t":"INDIVIDUAL","q":2000000,"pct":1.803,"d":"2026-02-13"},{"n":"Trần Mỹ Linh","p":null,"t":"INDIVIDUAL","q":164542,"pct":0.32,"d":"2015-09-14"},{"n":"Phạm Xuân Sơn","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":193200,"pct":0.17,"d":"2026-07-30"},{"n":"Đoàn Đức Luyện","p":null,"t":"INDIVIDUAL","q":193200,"pct":0.17,"d":"2026-04-17"},{"n":"Nguyễn Đức Hậu","p":"Phó Tổ