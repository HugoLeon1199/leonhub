điện lạnh là Công ty Cổ phần Dịch vụ Phân phối Tổng hợp Dầu khí (PSD), Công ty Cổ phần Hội tụ Thông minh (Smartcom) và Công ty Cổ phần Phân phối Sản phẩm Công nghệ cao Dầu khí (PHTD). Mảng kinh doanh này được giao cho Công ty Cổ phần Thương mại Dịch vụ Dầu khí miền Trung (PSMT) thực hiện. Các sản phẩm công nghiệp trong ngành Dầu khí do Petrosetco phân phối bao gồm: hạt nhựa PolyPropylen (PP), khí hóa lỏng (LPG). Petrosetco đảm nhận việc bao tiêu các sản phẩm của ngành công nghiệp chế biến dầu khí như LPG, PP của nhà máy lọc dầu Dung Quất với sản lượng 36 ngàn tấn PP và 30 ngàn tấn LPG/năm. Ngày 12/09/2007, PET chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bán lẻ","type":"CT","listed":"2007-09-12","state":0.0,"foreign":0.00762914,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Quản Lý Quỹ Ngân Hàng Thương Mại Cổ phần Công Thương Việt Nam","p":null,"t":"CORPORATE","q":29397500,"pct":19.0,"d":"2026-08-03"},{"n":"Công ty Cổ phần Quản lý quỹ HD","p":null,"t":"CORPORATE","q":29000000,"pct":18.74,"d":"2026-08-03"},{"n":"Công ty Cổ phần Quản lý quỹ Đầu tư Sài Gòn - Hà Nội","p":null,"t":"CORPORATE","q":5198233,"pct":6.144,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán SSI","p":null,"t":"CORPORATE","q":3459488,"pct":4.089,"d":"2015-06-15"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":3222440,"pct":3.809,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán Thành phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":2840570,"pct":3.358,"d":"2015-06-15"},{"n":"Phùng Tuấn Hà","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3154497,"pct":2.94,"d":"2025-10-05"},{"n":"KITMC Worldwide Vietnam RSP Balanced Fund","p":null,"t":"CORPORATE","q":2332722,"pct":2.757,"d":"2015-06-15"},{"n":"Ngân hàng Thương mại Cổ phần Đại chúng Việt Nam","p":null,"t":"CORPORATE","q":2295290,"pct":2.713,"d":"2015-06-15"},{"n":"Công Đoàn Tổng Công ty Cổ Phần Dịch Vụ Tổng H