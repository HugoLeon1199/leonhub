năm. Ngoài 2 ngành kinh doanh chính, Công ty hiện đang đầu tư vào các lĩnh vực: phát triển bất động sản, cung cấp giải pháp công nghệ và chế biến, khai thác khoáng sản. Năm 2021, IPA chính thức được niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-06-17","state":0.0,"foreign":0.00415715,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Quản Lý Đầu Tư H&H","p":null,"t":"CORPORATE","q":118573200,"pct":55.45,"d":"2026-06-02"},{"n":"Lương Thu Hằng","p":null,"t":"INDIVIDUAL","q":11224560,"pct":5.25,"d":"2026-06-02"},{"n":"Vũ Hiền","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2123654,"pct":0.993,"d":"2026-08-04"},{"n":"Phạm Minh Hương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":32400,"pct":0.015,"d":"2026-08-04"}],"rel":[{"c":"IPAF","n":"Công ty TNHH MTV Tài chính IPA","t":"subsidiary","pct":100.0},{"c":"IPAAM","n":"Công ty TNHH Quản lý Quỹ đầu tư IPA Partner","t":"subsidiary","pct":100.0},{"c":"0110097883","n":"Công ty Cổ phần Đầu Tư IPAF","t":"subsidiary","pct":99.8},{"c":"0103648258","n":"Công ty Cổ phần Đầu Tư IPA","t":"subsidiary","pct":92.71},{"c":"0107094441","n":"Công ty Cổ Phần Bất Động Sản Anvie Hội An","t":"subsidiary","pct":75.28},{"c":"4700151178","n":"Công ty Cổ Phần Khoáng Sản Và Gang Thép Kim Sơn","t":"affiliate","pct":70.0},{"c":"ASIANPEARL","n":"Công ty Cổ Phần Hòn Ngọc Á Châu","t":"subsidiary","pct":54.9},{"c":"NCTDI","n":"Công Ty Cổ Phần Đầu Tư Và Phát Triển Nam Cần Thơ","t":"affiliate","pct":48.6},{"c":"NCTDI","n":"Công Ty Cổ Phần Đầu Tư Và Phát Triển Nam Cần Thơ","t":"subsidiary","pct":48.6},{"c":"BHEC","n":"Công ty Cổ phần Năng Lượng Bắc Hà","t":"affiliate","pct":34.8},{"c":"FSSCO","n":"Công ty Cổ Phần Giải Pháp Phần Mềm Tài Chính","t":"affiliate","pct":28.0},{"c":"VND","n":"Công ty Cổ phần Chứng khoán VNDIRECT","t":"affiliate","pct":25.84},{"c":"0109928822","n":"Công ty Cổ Phần Giải Pháp Công Nghệ Ipa","t":"affil