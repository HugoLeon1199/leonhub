ần Tài. DSD chính thức được giao dịch tại Thị trường UPCoM từ ngày 17/05/2022.","sector":"Du lịch và Giải trí","type":"CT","listed":"2022-05-17","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty CP Đầu Tư Dhc","p":null,"t":"CORPORATE","q":12994309,"pct":22.25,"d":"2026-08-25"},{"n":"Trần Thị Hương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":10258064,"pct":17.57,"d":"2026-08-25"},{"n":"Phạm Khắc Dương","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":4622651,"pct":7.92,"d":"2026-08-25"},{"n":"Lê Minh Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":4574294,"pct":7.83,"d":"2026-08-25"},{"n":"Lê Thành Đạt","p":null,"t":"INDIVIDUAL","q":2479830,"pct":4.25,"d":"2026-08-25"},{"n":"Nguyễn Thị Thu Thủy","p":null,"t":"INDIVIDUAL","q":1928067,"pct":3.3,"d":"2026-08-25"},{"n":"Lê Thị Huyền Anh","p":null,"t":"INDIVIDUAL","q":619957,"pct":1.06,"d":"2026-08-25"},{"n":"Lê Thị Thanh Nga","p":null,"t":"INDIVIDUAL","q":619957,"pct":1.06,"d":"2026-08-25"},{"n":"Lê Như Hoa","p":null,"t":"INDIVIDUAL","q":207684,"pct":0.36,"d":"2026-08-25"},{"n":"Lại Anh Dũng","p":null,"t":"INDIVIDUAL","q":5200,"pct":0.014,"d":"2025-10-05"},{"n":"Trần Thu Trang","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":371,"pct":0.001,"d":"2026-08-25"},{"n":"Hồ Phòng","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":247,"pct":0.0,"d":"2026-08-25"},{"n":"Nguyễn Trần Quỳnh Phương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":247,"pct":0.0,"d":"2026-08-25"},{"n":"Phạm Lê Thị Lan Phương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":247,"pct":0.0,"d":"2026-08-25"},{"n":"Đặng Công Thành","p":"Phó Giám đốc/Người phụ trách quản trị công ty/Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":247,"pct":0.0,"d":"2026-08-25"}],"events":[{"c":"OTHE","t":"DSD - Thay đổi địa chỉ","d":"2026-05-06","record":null,"ex":null},{"c":"AGME","t":"DSD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-1