 thuận tiện cho giao thông và phát triển cơ sở hạ tầng. Tại Khu Công nghiệp Tân Bình, Công ty đầu tư nhà máy xử lý nước thải với công suất 4.000 m3/ngày, quy trình sản xuất đạt tiêu chuẩn ISO 14000:9001 với các tiêu chuẩn bảo vệ môi trường. Các dự án tiêu biểu của Công ty là TANIOFFICE Tây Thạnh, chưng cư Tanibuilding Sơn Kỳ II, trường THCS và THPT Trí Đức. Năm 2009, TIX chính thức được niêm yết và giao dịch tại Sở Giao dịch Chứng khoán thành phố Hồ Chí Minh (HOSE).","sector":"Bất động sản","type":"CT","listed":"2009-11-25","state":0.0,"foreign":0.00462197,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Xuất nhập khẩu và Đầu tư Chợ Lớn (CHOLIMEX)","p":null,"t":"CORPORATE","q":6014888,"pct":20.05,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Sản Xuất - Dịch vụ Tân Bình Tanimex","p":null,"t":"CORPORATE","q":5400000,"pct":18.0,"d":"2026-08-24"},{"n":"Công ty CP Đầu Tư Và Phát Triển Minh Phát","p":null,"t":"CORPORATE","q":3300000,"pct":11.0,"d":"2026-08-24"},{"n":"Võ Nguyệt Thùy Vân","p":null,"t":"INDIVIDUAL","q":2900000,"pct":9.667,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Sản Xuất Dịch Vụ Hưng Phát","p":null,"t":"CORPORATE","q":2000000,"pct":6.67,"d":"2026-01-19"},{"n":"Công ty TNHH Tư Vấn Đầu Tư Trần Phan","p":null,"t":"CORPORATE","q":1500000,"pct":5.0,"d":"2026-08-24"},{"n":"Lê Thị Minh Thanh","p":null,"t":"INDIVIDUAL","q":1280000,"pct":4.267,"d":"2026-08-24"},{"n":"Nguyễn Đình Minh Triết","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":600000,"pct":2.0,"d":"2026-08-24"},{"n":"Trần Hưng Lộc","p":null,"t":"INDIVIDUAL","q":600000,"pct":2.0,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Xây Dựng Cơ Khí Tân Bình Tanimex","p":null,"t":"CORPORATE","q":340000,"pct":1.417,"d":"2025-10-05"},{"n":"Nguyễn Minh Tâm","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":402144,"pct":1.34,"d":"2026-08-24"},{"n":"Tổng Công ty Bảo hiểm Bảo Việt","p":null,"t":"CORPORATE","q":210420,"pct":0.88,"d":"2025-10-05"},{"n":"Nguyễn Văn Ngoãn","p":null,"t":"I