 đô thị (HUD), đã giúp HLD thực hiện được những dự án bất động sản, mở rộng thêm quy mô khách hàng. Ngày 23/03/2013, HLD chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2013-03-26","state":0.51000002,"foreign":0.0258082,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu tư Phát triển Nhà và Đô thị - Công ty TNHH","p":null,"t":"CORPORATE","q":28049981,"pct":51.0,"d":"2026-06-29"},{"n":"Phạm Thị Linh","p":null,"t":"INDIVIDUAL","q":2784939,"pct":5.065,"d":"2026-06-29"},{"n":"Đỗ Hoàng Phúc","p":null,"t":"INDIVIDUAL","q":1722645,"pct":3.132,"d":"2026-02-11"},{"n":"Nguyễn Thanh Hương","p":null,"t":"INDIVIDUAL","q":681801,"pct":1.24,"d":"2025-10-05"},{"n":"Công ty TNHH Quản lý Quỹ Bảo Việt","p":null,"t":"CORPORATE","q":84000,"pct":0.42,"d":"2015-06-15"},{"n":"Phạm Cao Sơn","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":163497,"pct":0.3,"d":"2026-02-11"},{"n":"Bùi Hoàng Kiều","p":null,"t":"INDIVIDUAL","q":160000,"pct":0.291,"d":"2025-10-05"},{"n":"Vũ Tuấn Linh","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":100000,"pct":0.18,"d":"2026-03-18"},{"n":"Đặng Thanh Bình","p":null,"t":"INDIVIDUAL","q":80273,"pct":0.15,"d":"2025-10-05"},{"n":"Nguyễn Văn Hường","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":10000,"pct":0.018,"d":"2026-02-11"}],"rel":[{"c":"HUDLANDTS","n":"Công ty Cổ phần Hudland Thương mại và dịch vụ","t":"affiliate","pct":0.0}],"rel_count":1,"events":[{"c":"AGME","t":"HLD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-27","record":"2026-03-16","ex":"2026-03-13"},{"c":"AIS","t":"HLD - Niêm yết bổ sung 23.400.000 cổ phiếu","d":"2025-08-19","record":null,"ex":null},{"c":"OTHE","t":"HLD - Thay đổi địa chỉ","d":"2025-07-29","record":null,"ex":null},{"c":"DDINS","t":"Tổng Công ty Đầu tư Phát triển Nhà và Đô thị - Công ty TNHH - Đăng kí Mua 8,141 HLD","d":"2025-06-25","record":null,"ex":null},{"