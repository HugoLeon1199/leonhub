gonship. Ngoài dịch vụ vận tải, VNF còn cung cấp dịch vụ kho bãi với hệ thống kho CFS diện tích 3.000 m2, kho lạnh diện tích 1.500m2 sức chứa khoảng 1800 tấn; Kho ngoài trời rộng 10.000 m2; kho trong nhà diện tích 6.000m2. Năm 2010, VNF chính thức được giao dịch tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-12-01","state":0.0,"foreign":0.00316343,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Transimex","p":null,"t":"CORPORATE","q":19351981,"pct":61.05,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Quản Lý Và Phát Triển Bất Động Sản Conasi","p":null,"t":"CORPORATE","q":4158944,"pct":13.11,"d":"2025-11-13"},{"n":"Công ty Cổ phần Giao nhận Kho vận Ngoại thương Việt Nam","p":null,"t":"CORPORATE","q":3447360,"pct":10.87,"d":"2026-03-18"},{"n":"The Vendome Group Limited","p":null,"t":"CORPORATE","q":212500,"pct":3.795,"d":"2015-06-15"},{"n":"Nguyễn Bích Lân","p":null,"t":"INDIVIDUAL","q":120375,"pct":1.437,"d":"2021-03-19"},{"n":"Công Ty TNHH Quảng Cáo Mắt Vàng","p":null,"t":"CORPORATE","q":54900,"pct":0.98,"d":"2015-06-15"},{"n":"Nguyễn Bích Lân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":292929,"pct":0.92,"d":"2026-08-07"},{"n":"Công ty Cổ phần Giao nhận Vận tải Miền Trung","p":null,"t":"CORPORATE","q":148500,"pct":0.59,"d":"2025-10-05"},{"n":"Phạm Minh Hoàng","p":null,"t":"INDIVIDUAL","q":15750,"pct":0.282,"d":"2015-09-14"},{"n":"Lê Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":13740,"pct":0.246,"d":"2015-09-14"},{"n":"Bùi Minh Tuấn","p":null,"t":"INDIVIDUAL","q":54600,"pct":0.21,"d":"2025-10-05"},{"n":"Trương Minh Long","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.18,"d":"2025-10-05"},{"n":"Bùi Tuấn Ngọc","p":null,"t":"INDIVIDUAL","q":49584,"pct":0.16,"d":"2025-10-05"},{"n":"Nguyễn Hồng Sơn","p":null,"t":"INDIVIDUAL","q":27400,"pct":0.11,"d":"2025-10-05"},{"n":"Lê Duy Hiệp","p":null,"t":"INDIVIDUAL","q":30160,"pct":0.1,"d":"2026-08-07"},{"n":"Lê Thị Ngọc