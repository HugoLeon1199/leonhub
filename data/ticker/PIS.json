ế biến và mua bán hàng nông, lâm sản xuất khẩu. Công ty hiện đang quản lý vận hàng nhà máy chuyên sản xuất đồ gỗ xuất khẩu là: Công ty CP chế biến gỗ nội thất PISICO và Công ty chế biến gỗ PISICO Đồng An (Bình Dương). PIS được giao dịch trên thị trường UPCOM từ tháng 01/2016.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2016-01-12","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty Trách Nhiệm Hữu Hạn Thương Mại Ánh Vy","p":null,"t":"CORPORATE","q":24097000,"pct":87.63,"d":"2026-07-13"},{"n":"Lâm Duy Việt","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1265000,"pct":4.6,"d":"2026-02-25"},{"n":"Lâm Ánh Vy","p":null,"t":"INDIVIDUAL","q":1265000,"pct":4.6,"d":"2026-02-25"},{"n":"Nguyễn Hoàng Lam","p":"Kế toán trưởng","t":"INDIVIDUAL","q":6700,"pct":0.02,"d":"2026-02-25"},{"n":"Nguyễn Tấn Bảo Toàn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":5000,"pct":0.018,"d":"2026-02-25"},{"n":"Nguyễn Tường Linh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":600,"pct":0.002,"d":"2026-02-25"}],"rel":[{"c":"QCATV","n":"Công Ty TNHH Một Thành Viên Truyền Hình Cáp Quy Nhơn","t":"subsidiary","pct":100.0},{"c":"HRPISICO","n":"Công Ty Trách Nhiệm Hữu Hạn Một Thành Viên Hr Pisico","t":"subsidiary","pct":100.0},{"c":"DVHTPBC","n":"Công Ty Cổ Phần Dịch Vụ Phát Triển Hạ Tầng P.b.c","t":"subsidiary","pct":99.9},{"c":"6001759979","n":"Công ty CP Đầu Tư Pisico Đắk Lắk","t":"subsidiary","pct":83.19},{"c":"6001663071","n":"Công ty Cổ Phần Pisico Đắk Lắk","t":"subsidiary","pct":80.87},{"c":"4101601903","n":"Công ty TNHH Đầu Tư An Việt Phát","t":"subsidiary","pct":57.143},{"c":"QNWC","n":"Công ty TNHH Nguyên Liệu Giấy Qui Nhơn","t":"subsidiary","pct":51.0},{"c":"BIDINA","n":"Công ty Cổ Phần Kinh Doanh Công Nông Nghiệp Bình Định","t":"affiliate","pct":50.0},{"c":"PISICOHT","n":"Công ty CP Pisico - Hà Thanh","t":"affiliate","pct":44.97},{"c":"PISICOWF","n":"Công ty Cổ phần Chế Biến Gỗ Nội Thất 