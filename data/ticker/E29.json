25-Q4",6.67],["2026-Q2",6.67]],"y":[["2019",5.039],["2020",0.0],["2021",2.85],["2022",3.369],["2023",-5.035],["2024",8.305],["2025",6.67]]}},"co":{"short":"Đầu tư XD và Kỹ thuật 29","profile":"Công ty cổ phần Đầu tư Xây dựng và Kỹ thuật 29 (E29), tiền thân là Trung đoàn 29 - Sư đoàn 327 - Quân Khu Tả Ngạn (nay là Quân khu 3), được thành lập năm 1976. Năm 2018, Công ty chuyển đổi mô hình kinh doanh hoạt động là Công ty Cổ phần. Lĩnh vực kinh doanh chủ yếu của Công ty là: Xây dựng nhà các loại, xây dựng công trình đường sắt, đường bộ, xây dựng công trình kỹ thuật dân dụng khác; Sản xuất bê tông, vật liệu xây dựng...Với lợi thế là đơn vị thành viên của Tổng Công ty 39 - Bộ Quốc Phòng, do đo Công ty luôn nhận được sự quan tâm chỉ đạo, hỗ trợ về vốn, chiến lược phát triển kinh doanh, hệ thống nhà cung cấp nguyên vật liệu, bạn hàng lâu năm từ phía Tổng Công ty. Công ty đã tâm gia thực hiện nhiều các gói thầu lớn trọng điểm như: Dự án Điện năng lượng mặt trời tại Bến Cầu, Dự án điện năng lượng mặt trời Hồng Phong, Dự án điện mặt trời Thành Long...Ngày 05/11/2019, E29 chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2019-11-05","state":0.51,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty 319 Bộ Quốc Phòng","p":null,"t":"CORPORATE","q":2550000,"pct":51.0,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Xây Dựng Và Kinh Doanh Thương Mại Âu Lạc","p":null,"t":"CORPORATE","q":1237300,"pct":24.75,"d":"2026-08-24"},{"n":"Đặng Minh Hòa","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":699583,"pct":13.99,"d":"2026-08-24"},{"n":"Trương Ngọc Phương","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":6500,"pct":0.13,"d":"2026-08-24"},{"n":"Nguyễn Ngọc Quân","p":"Phó Giám đốc","t":"INDIVIDUAL","q":6100,"pct":0.12,"d":"2026-08-24"},{"n":"Nguyễn Văn Hồng","p":null,"t":"INDIVIDUAL","q":4536,"pct":0.09,"d":"2025-10-05"},{"n":"Nguyễn Minh Khiêm","p":null,"t":"INDIVIDUAL"