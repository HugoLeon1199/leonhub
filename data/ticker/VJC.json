4],["2020",-9.655],["2021",-9.322],["2022",-10.262],["2023",-1.148],["2024",5.3],["2025",4.19]]}},"co":{"short":"Vietjet Air","profile":"Công ty Cổ phần Hàng không Vietjet (VJC) là hãng hàng không tư nhân đầu tiên của Việt Nam được thành lập năm 2007 với 3 cổ đông chính là Tập đoàn T&C, Sovico Holdings và HD Bank. Công ty hoạt động chính trong lĩnh vực vận tải hàng không. Vietjet là hãng hàng không chi phí thấp có quy mô lớn tại Việt Nam, với mạng bay gồm 52 đường bay nội địa và 202 đường bay quốc tế. Doanh nghiệp vận hành đội tàu 107 máy bay, phục vụ các tuyến nội địa, khu vực và quốc tế. Năm 2025, Vietjet khai thác gần 153 nghìn chuyến bay và vận chuyển 28,2 triệu lượt hành khách, trong đó khách quốc tế đạt gần 10 triệu lượt. Hãng hiện diện tại nhiều thị trường trọng điểm như Australia, Ấn Độ, Trung Quốc, Nga và Trung Á. VJC được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 02/2017.","sector":"Du lịch và Giải trí","type":"CT","listed":"2017-02-28","state":0.0,"foreign":0.06046291,"rating":"O-PF","target":114000.0,"rating_as_of":"2024-03-15","source":"Vietcap"},"owners":[{"n":"Công ty TNHH Đầu Tư Hướng Dương Sunny","p":null,"t":"CORPORATE","q":154740160,"pct":26.16,"d":"2026-07-14"},{"n":"Nguyễn Thị Phương Thảo","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":61712188,"pct":8.02,"d":"2026-08-03"},{"n":"Công ty Cổ phần Sovico","p":null,"t":"CORPORATE","q":41106000,"pct":6.95,"d":"2026-07-14"},{"n":"Công Ty Cổ Phần Aviation","p":null,"t":"CORPORATE","q":35000000,"pct":5.92,"d":"2026-07-14"},{"n":"Government Of Singapore","p":null,"t":"CORPORATE","q":26125408,"pct":4.99,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư Dynamic & Development","p":null,"t":"CORPORATE","q":25000000,"pct":4.23,"d":"2025-10-05"},{"n":"Nguyễn Thanh Hùng","p":null,"t":"INDIVIDUAL","q":5358076,"pct":0.989,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư Bắc Hà","p":null,"t":"CORPORATE","q":2892531,"pct":0.96,"d":"2025-10-05"},{"n":"Nguyễn Phước Hù