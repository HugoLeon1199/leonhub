,["2025",24.433]]}},"co":{"short":"Chế tạo Giàn khoan Dầu khí","profile":"Công ty Cổ phần Chế tạo Giàn khoan Dầu khí (PVY) được thành lập vào năm 2007. Công ty hoạt động trong lĩnh vực chế tạo, sửa chữa giàn khoan và giàn khai thác. PVY đã tạo dựng được hệ thống cơ sở vật chất đồng bộ trên diện tích 39,8ha tại khu vực Sao Mai-Bến Đình, thành phố Vũng Tàu nhằm phục vụ cho việc sửa chữa, đóng mới các loại gian khoan tự nâng. Hệ thống cơ sở vật chất này giúp PV Shipyard có năng lực chế tạo 2-3 giàn khoan cùng lúc. Công ty là đơn vị chế tạo được giàn khoan tự nâng 90m, 120m nước đầu tiên tại Việt Nam. PVY được giao dịch trên thị trường UPCOM từ cuối năm 2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-12-29","state":0.44351983,"foreign":0.00527427,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Dịch vụ Kỹ thuật Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":17105643,"pct":28.75,"d":"2026-05-15"},{"n":"Tổng Công ty Công Nghiệp Tàu Thủy","p":null,"t":"CORPORATE","q":4479257,"pct":7.53,"d":"2026-01-22"},{"n":"Ngân hàng Thương mại Cổ phần Đầu tư và Phát triển Việt Nam","p":null,"t":"CORPORATE","q":2400000,"pct":4.03,"d":"2025-10-05"},{"n":"Tổng Công ty lắp máy Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":2400000,"pct":4.03,"d":"2025-10-05"},{"n":"Liên Doanh Việt - Nga Vietsovpetro","p":null,"t":"CORPORATE","q":2161300,"pct":3.63,"d":"2025-10-05"},{"n":"Phạm Thường Minh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":32000,"pct":0.053,"d":"2026-01-22"},{"n":"Nguyễn Nam Anh","p":"Phó Giám đốc","t":"INDIVIDUAL","q":16000,"pct":0.026,"d":"2026-01-22"},{"n":"Lê Thị Kim Khuyên","p":null,"t":"INDIVIDUAL","q":1467,"pct":0.025,"d":"2025-10-05"},{"n":"Nguyễn Văn Quang","p":null,"t":"INDIVIDUAL","q":32272,"pct":0.005,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"PVY - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-10","record":"2026-03-31","ex":"2026-03-30"},{"c":"EGME","t":"PVY - Tổ chức ĐHĐCĐ bấ