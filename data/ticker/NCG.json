ản phẩm sang hơn 27 quốc gia, bao gồm cả những quốc gia phát triển như Hàn Quốc, Dubai, Malasia… Về lĩnh vực chăn nuôi, thông qua công ty con, công ty sở hữu các trại heo giống với 15.200 heo nái, trang trại heo thịt gồm 123.000 con theo mô hình chăn nuôi khép kín theo chuỗi, có thể truy xuất nguồn gốc và đạt chuẩn Viet G.A.P. NCG chính thức được giao dịch trên thị trường UPCoM từ ngày 09/11/2023.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2023-11-09","state":0.0,"foreign":6.512e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Thương Mại Bảo Khang","p":null,"t":"CORPORATE","q":78587385,"pct":65.61,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư A.n.o.v.a","p":null,"t":"CORPORATE","q":16438921,"pct":13.72,"d":"2025-10-05"},{"n":"Foremost Worldwide Limited","p":null,"t":"CORPORATE","q":1350117,"pct":1.13,"d":"2025-10-05"}],"rel":[{"c":"0316595603","n":"Công ty TNHH Sản Xuất Và Thương Mại Nova Beverages","t":"subsidiary","pct":99.998},{"c":"1101550146","n":"Công ty Cổ Phần Anova Feed","t":"subsidiary","pct":99.99},{"c":"0316503257","n":"Công ty TNHH Asian Pacifixo","t":"subsidiary","pct":99.89},{"c":"0312540579","n":"Công Ty Cổ Phần Anova Farm","t":"subsidiary","pct":99.84},{"c":"0312150071","n":"Công ty Cổ Phần Anova Biotech","t":"subsidiary","pct":99.8},{"c":"0302532427","n":"Công ty Cổ Phần Sản Xuất Và Thương Mại Sài Gòn Vet","t":"subsidiary","pct":99.67},{"c":"0305054306","n":"Công ty Cổ phần Thành Nhơn","t":"subsidiary","pct":99.56},{"c":"SUGAR2","n":"Tổng Công ty Mía Đường Ii - Công ty Cổ Phần","t":"subsidiary","pct":94.96},{"c":"0101527480","n":"Công ty CP Anova Tech","t":"subsidiary","pct":85.83},{"c":"3700471585","n":"Công ty Liên Doanh TNHH Anova","t":"subsidiary","pct":57.0},{"c":"0300808221","n":"Công ty Liên Doanh Bio-pharmachemie","t":"affiliate","pct":30.01},{"c":"VXP","n":"Công ty Cổ phần Thuốc Thú y Trung ương VETVACO","t":"affiliate","pct":23.9}],"rel_count":12,"events":[{"c":"ISS","t":