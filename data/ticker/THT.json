như: Nhật Bản, Hàn Quốc, Trung Quốc, Ma-lay-xi-a, In-do-ne-xi-a và một số nước Đông Âu. Ngày 24/10/2008, THT chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2008-10-24","state":0.65000001,"foreign":0.01811633,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Công nghiệp Than - Khoáng sản Việt Nam","p":null,"t":"CORPORATE","q":15969844,"pct":65.0,"d":"2026-07-17"},{"n":"Phạm Uyên Nguyên","p":null,"t":"INDIVIDUAL","q":1215000,"pct":4.95,"d":"2025-10-05"},{"n":"Công ty Cổ phần Cơ điện Lạnh","p":null,"t":"CORPORATE","q":584500,"pct":4.28,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Đại chúng Việt Nam","p":null,"t":"CORPORATE","q":500000,"pct":3.663,"d":"2015-06-15"},{"n":"Asia Value Investment Limited","p":null,"t":"CORPORATE","q":452315,"pct":3.314,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán Ngân hàng Công thương Việt Nam","p":null,"t":"CORPORATE","q":439600,"pct":3.221,"d":"2015-06-15"},{"n":"Nguyễn Hoàng Trung","p":null,"t":"INDIVIDUAL","q":11500,"pct":0.08,"d":"2025-10-05"},{"n":"Hoàng Minh Hiếu","p":null,"t":"INDIVIDUAL","q":10502,"pct":0.077,"d":"2015-09-14"},{"n":"Phạm Thị Lan Hương","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":3000,"pct":0.012,"d":"2026-01-26"},{"n":"Trần Văn Tiến","p":null,"t":"INDIVIDUAL","q":1638,"pct":0.012,"d":"2015-09-14"},{"n":"Lê Thị Cẩm Thanh","p":null,"t":"INDIVIDUAL","q":1301,"pct":0.01,"d":"2015-09-14"},{"n":"Lý Văn Công","p":null,"t":"INDIVIDUAL","q":1204,"pct":0.009,"d":"2015-09-14"},{"n":"Nguyễn Mạnh Cường","p":null,"t":"INDIVIDUAL","q":1204,"pct":0.009,"d":"2015-09-14"},{"n":"Nguyễn Hồng Sơn","p":null,"t":"INDIVIDUAL","q":2862,"pct":0.008,"d":"2025-10-05"},{"n":"Hà Thị Diệp Anh","p":null,"t":"INDIVIDUAL","q":640,"pct":0.003,"d":"2025-10-05"},{"n":"Đào Xuân Nam","p":null,"t":"INDIVIDUAL","q":434,"pct":0.003,"d":"2015-09-14"},{"n":"Ong Thế Minh","p":null,"t":"INDIVIDUAL","q":779,"pct":0.002,"d":"202