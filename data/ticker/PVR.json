etnam. Công ty chính thức đi vào hoạt động từ tháng 11/2006 để đảm nhiệm lĩnh vực đầu tư và kinh doanh bất động sản, dịch vụ thể thao, du lịch, nghỉ dưỡng cao cấp. Công ty đang sở hữu quỹ đất lớn, có vị trí đẹp tại Ba Vì, Hà Nội và Tây Hạ Long. Công ty đang triển khai dự án Hồ Suối Hai có tổng diện tích trên 1.280 ha, dự án Khu đô thị Du lịch Văn hóa Tây Hạ Long và Trung tâm Thương mại Khách sạn Văn phòng Hạ Long. Ngày 02/06/2017, PVR chính thức giao dịch trên thị trường UPCOM.","sector":"Bất động sản","type":"CT","listed":"2010-06-21","state":0.0,"foreign":0.00095253,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Thị Thắm","p":null,"t":"INDIVIDUAL","q":12483000,"pct":24.05,"d":"2026-08-11"},{"n":"Công ty Cổ phần Quản lý Quỹ PVI","p":null,"t":"CORPORATE","q":4350000,"pct":8.19,"d":"2026-08-24"},{"n":"Công ty Cổ phần Tập đoàn Đại Dương","p":null,"t":"CORPORATE","q":3185000,"pct":6.0,"d":"2026-08-24"},{"n":"Chi cục Thi hành án Dân sự Quận Hoàn Kiếm thành phố Hà Nội","p":null,"t":"CORPORATE","q":2947000,"pct":5.68,"d":"2025-10-05"},{"n":"Vũ Thị Hương","p":null,"t":"INDIVIDUAL","q":2900000,"pct":5.587,"d":"2015-09-14"},{"n":"Bùi Thị Thu Thủy","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":2808000,"pct":5.41,"d":"2026-08-24"},{"n":"Bùi Văn Phú","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2715520,"pct":5.23,"d":"2026-08-24"},{"n":"Công ty TNHH MHD Golf","p":null,"t":"CORPORATE","q":2705900,"pct":5.1,"d":"2026-08-24"},{"n":"Khúc Thị Thanh Huyền","p":"Kế toán trưởng","t":"INDIVIDUAL","q":2539400,"pct":4.89,"d":"2026-08-24"},{"n":"Tổng Công ty Cổ phần Dịch vụ Kỹ thuật Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":2312650,"pct":4.355,"d":"2015-06-15"},{"n":"Công Ty TNHH Vnt","p":null,"t":"CORPORATE","q":2151980,"pct":4.05,"d":"2025-10-05"},{"n":"Bùi Ngọc Hưng","p":null,"t":"INDIVIDUAL","q":16000,"pct":0.031,"d":"2015-09-14"},{"n":"Đỗ Quốc Phương","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.023,"d":"2025-10-05"}