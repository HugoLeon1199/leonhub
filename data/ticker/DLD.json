 trên thị trường UPCOM từ tháng 04/2011.","sector":"Du lịch và Giải trí","type":"CT","listed":"2011-04-08","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Du lịch Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":4729401,"pct":50.81,"d":"2026-08-14"},{"n":"Công Ty TNHH Quốc Tế Dp","p":null,"t":"CORPORATE","q":842000,"pct":9.05,"d":"2026-08-14"},{"n":"Công ty Cổ phần Kim loại màu Nghệ Tĩnh","p":null,"t":"CORPORATE","q":800000,"pct":8.6,"d":"2026-08-14"},{"n":"Đỗ Vân Anh","p":null,"t":"INDIVIDUAL","q":781410,"pct":8.4,"d":"2026-08-14"},{"n":"Tổng Công ty Bến Thành - TNHH MTV","p":null,"t":"CORPORATE","q":740856,"pct":7.96,"d":"2026-08-14"},{"n":"Công ty TNHH Magentta Việt Nam","p":null,"t":"CORPORATE","q":450000,"pct":4.835,"d":"2026-03-06"},{"n":"Võ Văn Châu","p":null,"t":"INDIVIDUAL","q":87672,"pct":0.942,"d":"2015-09-14"},{"n":"Trần Duy Khương An","p":null,"t":"INDIVIDUAL","q":38856,"pct":0.417,"d":"2015-09-14"},{"n":"Trần Hồng Tâm","p":null,"t":"INDIVIDUAL","q":30167,"pct":0.324,"d":"2015-09-14"},{"n":"Ninh Văn Hiên","p":null,"t":"INDIVIDUAL","q":27973,"pct":0.301,"d":"2015-09-14"},{"n":"Nguyễn Thị Sáu","p":"Kế toán trưởng/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":10000,"pct":0.107,"d":"2026-08-14"},{"n":"Đỗ Minh Tuấn","p":null,"t":"INDIVIDUAL","q":3864,"pct":0.04,"d":"2025-10-05"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 75.0%","d":"2026-06-22","record":null,"ex":null},{"c":"AGME","t":"DLD - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-28","record":"2026-06-05","ex":"2026-06-04"},{"c":"EGME","t":"DLD - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-05-06","record":"2026-05-15","ex":"2026-05-14"},{"c":"OTHE","t":"DLD - Thay đổi địa chỉ","d":"2025-08-04","record":null,"ex":null},{"c":"AGME","t":"DLD - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-06","record":"2025-03-12","ex":"2025-03-11"},{"c":"AGME","t":"DLD - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-