ốc hội, Trung tâm hội nghị Quốc gia, sân vận động Quốc gia Mỹ Đình, và nhiều công trình khác; thâm nhập vào được thị trường Quốc tế như Canada, Singapore, Indonesia, Lào, Campuchia...Ngày 24/03/2011, TIS chính thức giao dịch trên thị trường UPCOM.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2011-03-24","state":0.65,"foreign":0.00017565,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Thép Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":119600000,"pct":65.0,"d":"2026-06-29"},{"n":"Công ty Cổ phần Thương mại Thái Hưng","p":null,"t":"CORPORATE","q":36800000,"pct":20.0,"d":"2026-06-29"},{"n":"Công ty TNHH TM và DL Trung Dũng","p":null,"t":"CORPORATE","q":32100000,"pct":11.303,"d":"2015-06-15"},{"n":"Ngân hàng Thương mại Cổ phần Công thương Việt Nam","p":null,"t":"CORPORATE","q":10000000,"pct":3.521,"d":"2015-06-15"},{"n":"Trần Văn Khâm","p":null,"t":"INDIVIDUAL","q":102500,"pct":0.036,"d":"2015-09-14"},{"n":"Đỗ Xuân Hòa","p":null,"t":"INDIVIDUAL","q":52900,"pct":0.019,"d":"2015-09-14"},{"n":"Nguyễn Minh Hạnh","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":11800,"pct":0.006,"d":"2026-08-05"},{"n":"Nguyễn Chí Dũng","p":null,"t":"INDIVIDUAL","q":8100,"pct":0.003,"d":"2015-09-14"},{"n":"Hoàng Văn Tòng","p":null,"t":"INDIVIDUAL","q":5200,"pct":0.002,"d":"2015-09-14"},{"n":"Hà Tuấn Hưng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3600,"pct":0.002,"d":"2026-08-05"},{"n":"Nguyễn Bá Tài","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1600,"pct":0.001,"d":"2026-08-05"},{"n":"Trần Anh Dũng","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":1000,"pct":0.001,"d":"2026-08-05"},{"n":"Trương Cao Khánh","p":null,"t":"INDIVIDUAL","q":600,"pct":0.0,"d":"2015-09-14"}],"rel":[{"c":"TTS","n":"Công ty Cổ phần Cán thép Thái Trung","t":"subsidiary","pct":93.68},{"c":"5000668389","n":"Công Ty Cổ Phần Khai Thác Và Chế Biến Khoáng Sản Thái Trung","t":"subsidiary","pct":5