ờng UPCOM từ tháng 07/2017.","sector":"Bất động sản","type":"CT","listed":"2017-07-17","state":0.87318602,"foreign":0.06921421,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":31238248,"pct":87.32,"d":"2026-08-17"},{"n":"Oriental Consultants Co., Ltd","p":null,"t":"CORPORATE","q":2476000,"pct":6.92,"d":"2025-10-05"},{"n":"Thân Hồng Linh","p":null,"t":"INDIVIDUAL","q":52000,"pct":0.13,"d":"2026-08-03"},{"n":"Nguyễn Bá Minh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":19000,"pct":0.053,"d":"2026-08-17"},{"n":"Nguyễn Xuân Hải","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":15500,"pct":0.043,"d":"2026-08-17"},{"n":"Đoàn Đức Phi","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":10400,"pct":0.029,"d":"2026-08-17"},{"n":"Phạm Vũ Thành","p":null,"t":"INDIVIDUAL","q":9900,"pct":0.028,"d":"2026-08-03"},{"n":"Nguyễn Thị Tố Trinh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6900,"pct":0.019,"d":"2026-08-17"},{"n":"Nguyễn Thị Đoan Trang","p":"Kế toán trưởng","t":"INDIVIDUAL","q":21600,"pct":0.015,"d":"2026-08-17"},{"n":"Nguyễn Văn Phúc","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":5000,"pct":0.013,"d":"2026-08-17"},{"n":"Lê Thị Thanh Bình","p":"Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":3100,"pct":0.009,"d":"2026-08-17"},{"n":"Trần Đức Toàn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1200,"pct":0.008,"d":"2026-08-17"},{"n":"Nguyễn Minh Hồng","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2000,"pct":0.005,"d":"2026-08-17"},{"n":"Nguyễn Trường Linh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2000,"pct":0.005,"d":"2026-08-17"}],"rel":[{"c":"USC","n":"Công ty Cổ phần Khảo sát và Xây dựng - USCO","t":"subsidiary","pct":57.75},{"c":"CCBM","n":"Công ty CP Tư Vấn Xây Dựng Công Trình Vật Liệu Xây Dựng","t":"subsidiary","pct":51.0},{"c":"CDV","n":"Công ty Cổ phần Tư Vấn Đầu Tư Và Thi