 mủ cao su có công suất 3.000 tấn/năm; Một nhà máy chế biến phân bón hữu cơ vi sinh công suất 5000 tấn/năm; Một phân x­ưởng n­ước lọc tinh khiết với công suất 1 triệu lít/năm. Ngày 04/07/2019, LNC chính thức giao dịch trên thị trường UPCOM.","sector":"Hóa chất","type":"CT","listed":"2019-07-04","state":0.90744911,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Quảng Bình","p":null,"t":"CORPORATE","q":7468367,"pct":90.74,"d":"2025-10-05"},{"n":"Ủy Ban Nhân Dân Tỉnh Quảng Trị","p":null,"t":"CORPORATE","q":7468367,"pct":90.74,"d":"2026-08-13"},{"n":"Nguyễn Ngọc Sơn","p":null,"t":"INDIVIDUAL","q":28800,"pct":0.35,"d":"2025-10-05"},{"n":"Nguyễn Mậu Hào","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":23600,"pct":0.29,"d":"2026-08-13"},{"n":"Lê Hồng Sơn","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":12000,"pct":0.15,"d":"2026-08-13"},{"n":"Hoàng Thị Phương","p":null,"t":"INDIVIDUAL","q":11800,"pct":0.14,"d":"2025-10-05"},{"n":"Trần Công Văn","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":10700,"pct":0.13,"d":"2026-08-13"},{"n":"Công đoàn Công ty cổ phần Lệ Ninh","p":null,"t":"CORPORATE","q":10000,"pct":0.12,"d":"2025-10-05"},{"n":"Lê Thanh Hùng","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":7900,"pct":0.1,"d":"2026-08-13"},{"n":"Hoàng Văn Khiêm","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":4800,"pct":0.06,"d":"2026-08-13"},{"n":"Nguyễn Thị Liên","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.06,"d":"2025-10-05"},{"n":"Lê Doãn Hiếu","p":"Kế toán trưởng/Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":4500,"pct":0.054,"d":"2026-08-13"},{"n":"Phạm Ngọc Thành","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3900,"pct":0.05,"d":"2026-08-13"},{"n":"Võ Mạnh Quỳnh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":3200,"pct":0.039,"d":"2026-08-13"},{"n":"Đinh Duy Dũng","p":null,"t":"INDIVIDUAL","q":2600,"pct":0.031,"d":"2026-08-13"},{"