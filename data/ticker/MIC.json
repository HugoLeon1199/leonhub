 Thăng Bình, Bột Fenspat, Tràng thạch Đại Lộc. Thương hiệu và sản phẩm MINCO đã được biết đến khá nhiều tại một số thị trường lớn trong khu vực như Nhật Bản, Hàn Quốc, Trung Quốc, Thái Lan, Singapore và trong nước, đây có thể xem như lợi thế so sánh của công ty so với các công ty khác cùng ngành. Công suất chế biến cát trắng hiện tại là 180.000 tấn/năm... Ngày 19/03/2025, MIC chính thức giao dịch trên Sở giao dịch Chứng khoán Hà Nội (HNX).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2007-12-21","state":0.0,"foreign":0.00816308,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Tập Đoàn Đầu Tư Việt Phương","p":null,"t":"CORPORATE","q":2196861,"pct":25.61,"d":"2026-04-23"},{"n":"Công ty Cổ Phần Vp Silica","p":null,"t":"CORPORATE","q":2117338,"pct":24.68,"d":"2026-04-23"},{"n":"Nguyễn Bá Phong","p":null,"t":"INDIVIDUAL","q":909695,"pct":10.61,"d":"2026-04-23"},{"n":"Lê Tuấn Điệp","p":null,"t":"INDIVIDUAL","q":531425,"pct":6.2,"d":"2026-04-23"},{"n":"Lê Thị Thuận","p":null,"t":"INDIVIDUAL","q":261435,"pct":4.741,"d":"2015-09-14"},{"n":"Joji Tsukamoto","p":null,"t":"INDIVIDUAL","q":237445,"pct":4.31,"d":"2025-10-05"},{"n":"Công ty Cổ phần Kinh doanh Bất động sản VHC","p":null,"t":"CORPORATE","q":237445,"pct":4.28,"d":"2025-10-05"},{"n":"Nguyễn Thị Kim Dung","p":null,"t":"INDIVIDUAL","q":235200,"pct":4.24,"d":"2025-10-05"},{"n":"Lê Thị Hạnh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":102000,"pct":1.84,"d":"2026-01-22"},{"n":"Nguyễn Xuân Lư","p":null,"t":"INDIVIDUAL","q":68202,"pct":1.24,"d":"2025-10-05"},{"n":"Nguyễn Dũng","p":null,"t":"INDIVIDUAL","q":7882,"pct":0.143,"d":"2015-09-14"},{"n":"Trương Ngọc Thành","p":null,"t":"INDIVIDUAL","q":3844,"pct":0.07,"d":"2015-09-14"},{"n":"Phạm Văn Sa","p":null,"t":"INDIVIDUAL","q":3820,"pct":0.069,"d":"2025-10-05"},{"n":"Lê Quang Lực","p":null,"t":"INDIVIDUAL","q":2832,"pct":0.051,"d":"2015-09-14"},{"n":"Trương Văn Năm","p":null,"t":"INDIVIDUAL","q":2532,"pct":0.046,"d"