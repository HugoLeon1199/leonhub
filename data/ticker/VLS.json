g dây chuyền mạ kẽm nhúng nóng công suất 60.000 tấn/năm. Các sản phẩm của Nhà máy thép Việt Long đã được sử dụng rộng rãi trong nhiều dự án và công trình trọng điểm trên cả nước như: Dự án Vin Cổ Loa, Đường Vành đai 4 (Hà Nội), Đường Vành đai 3 (TP. Hồ Chí Minh), Cao tốc Khánh Hòa – Buôn Ma Thuột, Cao tốc Đồng Đăng – Trà Lĩnh, Cao tốc Hữu Nghị – Chi Lăng, Cao tốc Bắc – Nam,... Ngày 15/12/2025, VLS chính thức giao dịch trên thị trường UPCOM.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2025-12-15","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phạm Văn Giang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":12631800,"pct":51.56,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Thép Tổng Hợp","p":null,"t":"CORPORATE","q":4537000,"pct":18.52,"d":"2026-08-24"},{"n":"Nguyễn Thị Hằng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2373080,"pct":9.68,"d":"2026-08-24"},{"n":"Nguyễn Danh Hùng","p":null,"t":"INDIVIDUAL","q":275300,"pct":1.12,"d":"2026-02-24"},{"n":"Nguyễn Thị Thuỳ Dương","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":274200,"pct":1.12,"d":"2026-08-24"},{"n":"Nguyễn Văn Tuấn","p":"Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":105000,"pct":0.44,"d":"2026-08-24"},{"n":"Phạm Thị Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":70560,"pct":0.29,"d":"2026-02-24"},{"n":"Nguyễn Chi Phương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":68560,"pct":0.28,"d":"2026-02-24"},{"n":"Trần Thị Nhất","p":null,"t":"INDIVIDUAL","q":11600,"pct":0.05,"d":"2026-04-24"},{"n":"Nguyễn Văn Đạt","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":200,"pct":0.001,"d":"2026-02-24"}],"events":[{"c":"DDIND","t":"Trần Thị Nhất - Đăng kí Bán 100,000 VLS","d":"2026-03-18","record":null,"ex":null},{"c":"AGME","t":"VLS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-13","record":"2026-03-31","ex":"2026-03-30"},{"c":"DDIND","t":"Nguyễn Hạnh Thuận - Đăng kí Bán 279,