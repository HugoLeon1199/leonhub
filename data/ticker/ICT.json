"2023",3.247],["2024",2.392],["2025",-0.007]]}},"co":{"short":"Viễn thông - Tin học Bưu điện","profile":"Công ty Cổ phần Viễn thông - Tin học Bưu điện (ICT) tiền thân là Xí nghiệp Khoa học Sản xuất thiết bị thông tin I thành lập vào năm 1972, sau được cổ phần hóa vào năm 2001. ICT là đơn vị hàng đầu của Tập đoàn Bưu chính Viễn thông Việt Nam (VNPT) hoạt động trong lĩnh vực viễn thông, công nghệ thông tin và tự động hóa tòa nhà thông minh. Công ty hiện tại đứng số 1 Việt Nam trong việc cung cấp và xây dựng hạ tầng cơ sở mạng di động cho các nhà khai thác lớn như Vinaphone và MobiPhone. Tính đến năm 2019, ICT là doanh nghiệp đầu tiên thực hiện các dự án mạng di động tại Việt Nam, là một trong những Công ty tại Việt Nam có thị phần lớn nhất (23%). Ngày 15/01/2020, ICT chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE)","sector":"Công nghệ Thông tin","type":"CT","listed":"2020-01-15","state":0.31434233,"foreign":0.00176738,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập Đoàn Bưu Chính Viễn Thông Việt Nam","p":null,"t":"CORPORATE","q":10117108,"pct":31.43,"d":"2026-08-28"},{"n":"Đặng Anh Dũng","p":null,"t":"INDIVIDUAL","q":1266532,"pct":3.94,"d":"2026-08-28"},{"n":"Nguyễn Trí Dũng","p":null,"t":"INDIVIDUAL","q":724930,"pct":2.25,"d":"2025-10-05"},{"n":"Tô Hoài Văn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":534239,"pct":1.66,"d":"2026-08-28"},{"n":"Hoàng Anh Lộc","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":487304,"pct":1.51,"d":"2026-02-23"},{"n":"Nguyễn Thành Hiếu","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":458942,"pct":1.43,"d":"2026-08-28"},{"n":"Lê Thanh Sơn","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":441676,"pct":1.37,"d":"2026-02-23"},{"n":"Lâm Nhị Hà","p":null,"t":"INDIVIDUAL","q":306420,"pct":0.95,"d":"2025-10-05"},{"n":"Nguyễn Thế Thịnh","p":null,"t":"INDIVIDUAL","q":306232,"pct":0.95,"d":"2021-10-08"},{"n":"Lê Lưu Ngân","p":null,"t":"I