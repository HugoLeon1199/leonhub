 dầu cọ Olein, dầu thực vật và Shortening. SGO là đơn vị cung cấp nguyên liệu đầu vào cho Công ty TNHH Phúc Quang - Hồng Anh để sản xuất dầu thực vật mang thương hiệu Tràng An. Cạnh tranh trực tiếp với Công ty là Công ty Cổ phần Dầu thực vật Tường An và Công ty TNHH Dầu thực vật Cái Lân. Ngày 30/12/2019, SGO chính thức giao dịch trên thị trường UPCOM.</DIV>","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2015-12-16","state":0.0,"foreign":0.001,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Chu Thị Ngọc Diệp","p":null,"t":"INDIVIDUAL","q":1193900,"pct":5.97,"d":"2018-04-04"},{"n":"Nguyễn Việt Hòa","p":null,"t":"INDIVIDUAL","q":867300,"pct":4.34,"d":"2022-01-10"},{"n":"Huỳnh Cẩm Đoan","p":null,"t":"INDIVIDUAL","q":320400,"pct":1.6,"d":"2021-04-30"},{"n":"Phạm Hoài Tâm Anh","p":null,"t":"INDIVIDUAL","q":5800,"pct":0.03,"d":"2018-06-13"}],"events":[{"c":"SUSP","t":"SGO - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2023-11-03","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Việt Hòa - Đăng kí Bán SGO","d":"2022-01-10","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Việt Hòa - Đăng kí Mua SGO","d":"2021-12-30","record":null,"ex":null},{"c":"DDIND","t":"Huỳnh Cẩm Đoan - Đăng kí Bán SGO","d":"2021-04-29","record":null,"ex":null},{"c":"MOVE","t":"SGO - Chính thức giao dịch trên sàn UPCOM","d":"2019-12-23","record":null,"ex":null},{"c":"SUSP","t":"SGO - Hủy niêm yết cổ phiếu trên sàn HNX","d":"2019-11-26","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 10.0%","d":"2018-07-30","record":null,"ex":null},{"c":"AGME","t":"SGO-Tổ chức ĐHĐCĐ thường niên 2018","d":"2018-05-21","record":"2018-06-08","ex":"2018-06-07"},{"c":"DDIND","t":"Chu Thị Ngọc Diệp - Đăng kí Mua SGO","d":"2018-04-03","record":null,"ex":null},{"c":"DDIND","t":"Huỳnh Cẩm Đoan - Đăng kí Mua SGO","d":"2017-11-02","record":null,"ex":null},{"c":"DDIND","t":"Huỳnh Cẩm Đoan - Đăng kí Mua SGO","d":"2017-11-02","record":nul