ông ty có công suất tinh luyện 80.000 tấn quặng titan / năm, 90% trong số đó là ilmenit và 10% còn lại là các sản phẩm phụ bao gồm zircon, rutile, monazite và từ tính. Nhà máy xỉ titan với công suất 35.000 tấn / năm đang hoạt động ở mức 70 - 80% công suất. Các khách hàng lớn của công ty là các nhà nhập khẩu quặng của nước ngoài như Kayfour Development Corporation Sdn.Bhd, Qinzhou Qinnan District Jia Hua Import Export Td.,Lmt, Mineral Venture Internation Ltd (Mvi). Ngày 28/12/2006, BMC chính thức giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE);","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2006-12-28","state":0.25000214,"foreign":0.04588114,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Quỹ Đầu tư Phát triển Tỉnh Gia Lai","p":null,"t":"CORPORATE","q":3098184,"pct":24.9,"d":"2026-02-27"},{"n":"Văn Phòng Tỉnh Ủy Bình Định","p":null,"t":"CORPORATE","q":1931100,"pct":15.5,"d":"2026-02-27"},{"n":"Nguyễn Đức Huyện","p":null,"t":"INDIVIDUAL","q":668820,"pct":5.397,"d":"2015-09-14"},{"n":"Nguyễn Thị Minh Huyền","p":null,"t":"INDIVIDUAL","q":180000,"pct":1.452,"d":"2015-09-14"},{"n":"Ngô Văn Tổng","p":null,"t":"INDIVIDUAL","q":60000,"pct":0.484,"d":"2015-09-14"},{"n":"Huỳnh Ngọc Bích","p":"Thành viên Hội đồng Quản trị/Kế toán trưởng/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":34372,"pct":0.27,"d":"2026-02-27"},{"n":"Nguyễn Thị Hải Vi","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":300,"pct":0.002,"d":"2026-02-27"}],"events":[{"c":"AGME","t":"BMC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-05","record":"2026-05-22","ex":"2026-05-21"},{"c":"EGME","t":"BMC - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-09-04","record":"2025-09-17","ex":"2025-09-16"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 1,300 VND","d":"2025-07-11","record":"2025-07-25","ex":"2025-07-24"},{"c":"DDINS","t":"Văn Phòng Tỉnh Ủy Bình Định - Đăng kí Bán 1,851,100 BMC","d":"2025-06-05","record":null,"ex":null},{"c":"DDINS","t":"V