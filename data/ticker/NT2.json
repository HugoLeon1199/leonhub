 ty Cổ phần Điện lực Dầu khí Nhơn Trạch 2 (NT2) được thành lập năm 2007 để thực hiện đầu tư xây dựng dự án Nhà máy Nhiệt điện Nhơn Trạch 2 tại Khu Công nghiệp Ông Kèo, ấp 3, xã Phước Khánh, huyện Nhơn Trạch, Đồng Nai. Nhà máy điện Nhơn Trạch 2 với công suất thiết kế 750MW đi vào hoạt động từ năm 2011. Trong năm 2017, Nhà máy hoàn thành công tác đại tu và nâng công suất lên 774MW. NT2 được niêm yết và giao dịch trên Sở giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 06/2015.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2010-01-22","state":0.61848845,"foreign":0.09927939,"rating":"BUY","target":29000.0,"rating_as_of":"2026-08-10","source":"Vietcap"},"owners":[{"n":"Tổng Công ty Điện lực Dầu khí Việt Nam - CTCP","p":null,"t":"CORPORATE","q":170926080,"pct":59.375,"d":"2026-07-30"},{"n":"Công ty TNHH Phát Triển Công Nghệ","p":null,"t":"CORPORATE","q":23796115,"pct":8.27,"d":"2026-07-30"},{"n":"Ngân hàng Thương mại Cổ phần Đầu tư và Phát triển Việt Nam","p":null,"t":"CORPORATE","q":6400000,"pct":2.336,"d":"2015-06-15"},{"n":"Tập đoàn Điện lực Việt Nam","p":null,"t":"CORPORATE","q":6400000,"pct":2.336,"d":"2015-06-15"},{"n":"Đặng Thị Ngọc Bích","p":null,"t":"INDIVIDUAL","q":1617250,"pct":0.56,"d":"2026-07-30"},{"n":"Nguyễn Hữu Minh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":51044,"pct":0.018,"d":"2026-07-30"},{"n":"Ngô Đức Nhân","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":51704,"pct":0.018,"d":"2026-07-30"},{"n":"Quỹ Đầu tư Tăng trưởng DFVN","p":null,"t":"CORPORATE","q":52000,"pct":0.018,"d":"2020-07-14"},{"n":"Uông Ngọc Hải","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":42170,"pct":0.015,"d":"2026-07-30"},{"n":"Hồ Xuân Lan","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":16480,"pct":0.006,"d":"2026-07-30"},{"n":"Lê Tự Hiểu","p":null,"t":"INDIVIDUAL","q":16500,"pct":0.006,"d":"2015-09-14"},{"n":"Lê Quý Dương","p":null,"t":"INDIVIDUAL","q":12500,"pct":0.005,"d":"2015-09-14"}],"events":[{"c":"AGME