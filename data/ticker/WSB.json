 phần Bia Sài Gòn - Sóc Trăng vào năm 2006. Công ty chuyên sản xuất sản phẩm mang thương hiệu Bia Sài Gòn theo hợp đồng hợp tác sản xuất với Tổng Công ty Cổ phần Bia - Rượu - Nước Giải khát Sài Gòn. Các sản phẩm chính của Công ty bao gồm: Bia chai Sài Gòn 450ml và Bia chai Sài Gòn 355ml. Công ty hiện đang quản lý vận hành Nhà máy Bia Sài Gòn - Sóc Trăng 2 với công suất thiết kế 50 triệu lít/năm và Nhà máy Bia Sài Gòn - Cần Thơ với công suất thiết kế 50 triệu lít/năm. Thị trường của WSB chủ yếu ở khu vực các tỉnh miền Tây Nam Bộ. WSB được giao dịch trên thị trường UPCOM từ tháng 08/2010.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2010-08-10","state":0.51,"foreign":0.02687041,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Bia - Rượu - Nước Giải khát Sài Gòn","p":null,"t":"CORPORATE","q":12517050,"pct":86.324,"d":"2026-05-12"},{"n":"Barca Global Master Fund, L.P","p":null,"t":"CORPORATE","q":713600,"pct":4.92,"d":"2025-10-05"},{"n":"Phạm Đình Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":90000,"pct":0.62,"d":"2026-08-06"},{"n":"Đỗ Văn Vẽ","p":null,"t":"INDIVIDUAL","q":75000,"pct":0.517,"d":"2015-09-14"},{"n":"Nguyễn Ngọc Huyện","p":null,"t":"INDIVIDUAL","q":60000,"pct":0.414,"d":"2015-09-14"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":51200,"pct":0.35,"d":"2025-10-05"},{"n":"Phạm Thị Hồng Hạnh","p":null,"t":"INDIVIDUAL","q":43250,"pct":0.298,"d":"2015-09-14"},{"n":"Lê Xuân Khởi","p":null,"t":"INDIVIDUAL","q":5180,"pct":0.036,"d":"2015-09-14"},{"n":"Trương Thị Mỹ Hồng","p":"Kế toán trưởng","t":"INDIVIDUAL","q":5220,"pct":0.0,"d":"2025-10-05"}],"rel":[{"c":"BIASGST","n":"Công ty TNHH MTV Bia Sài Gòn - Sóc Trăng","t":"subsidiary","pct":100.0},{"c":"SBL","n":"Công ty Cổ phần Bia Sài Gòn - Bạc Liêu","t":"affiliate","pct":20.0}],"rel_count":2,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2025 - 3,000 VND","d":"2026-04-09","record":"2026-04-24","ex":"2026-04-23"},{"c":