.433],["2024",0.625],["2025",6.888]]}},"co":{"short":"DIC Corp","profile":"Tổng Công ty Cổ phần Đầu tư Phát triển Xây dựng (DIG) với gần 3 thập kỷ hoạt động từ năm 1990 trên nhiều lĩnh vực như khách sạn, dịch vụ du lịch, thương mại, đầu tư phát triển Bất động sản, xây dựng … Công ty có thế mạnh trong lĩnh vực đầu tư phát triển bất động sản và doanh thu chủ yếu đến từ việc kinh doanh bất động sản. Công ty là một doanh nghiệp lớn trong ngành bất động sản, có quỹ đất sạch lớn và mức độ an toàn tài chính cao. Công ty đã thực hiện đầu tư vào các dự án lớn như Dự án Khu đô thị Trung tâm Chí Linh - Vũng Tàu, Khu đô thị du lịch Đại Phước - Đồng Nai, Khu đô thị mới Nam Vĩnh Yên - thành phố Vĩnh Phúc và các dự án tiềm năng khác trên khắp Việt Nam. DIG chính thức được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2009.","sector":"Bất động sản","type":"CT","listed":"2009-08-19","state":0.0,"foreign":0.02693086,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Bất động sản Trường Sơn","p":null,"t":"CORPORATE","q":24929077,"pct":4.987,"d":"2025-10-05"},{"n":"CÔNG TY CỔ PHẦN ĐẦU TƯ PHÁT TRIỂN THIÊN TÂN","p":null,"t":"CORPORATE","q":28684074,"pct":4.7,"d":"2025-10-05"},{"n":"Nguyễn Hùng Cường","p":"Chủ tịch Hội đồng Quản trị/Thành viên Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":27139478,"pct":3.41,"d":"2026-08-03"},{"n":"Deutsche Asset Management (Asia) Limited","p":null,"t":"CORPORATE","q":5567590,"pct":2.803,"d":"2015-06-15"},{"n":"Ngân hàng Deutsche Aktiengesellschaft","p":null,"t":"CORPORATE","q":5213790,"pct":2.625,"d":"2015-06-15"},{"n":"VOF Investment Limited","p":null,"t":"CORPORATE","q":5077000,"pct":2.556,"d":"2015-06-15"},{"n":"Epsom Limited","p":null,"t":"CORPORATE","q":3525280,"pct":1.775,"d":"2015-06-15"},{"n":"Siglap Limited","p":null,"t":"CORPORATE","q":3309207,"pct":1.666,"d":"2015-06-15"},{"n":"Vietnam Infrastructure Strategic Ltd","p":null,"t":"CORPORATE","q":3156376,"pct":1.589,"d":"20