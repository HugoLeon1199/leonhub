oa và thiết bị trường học tại tỉnh Bình Thuận. Hệ thống phân phối được củng cố, mở rộng và mang tính ổn định. Ngoài 2 nhà sách bán lẻ ở 2 địa điểm: số 11-13 đường Nguyễn Du và số 328 đường Trần Hưng Đạo Tp. Phan Thiết, công ty còn có 50 đại lý phân phối cấp 1 và 30 đại lý cấp 2 tại thành phố và các huyện. Bên cạnh đó công ty còn trực tiếp cung cấp sách và các thiết bị cho hơn 500 trường học trên địa bàn tỉnh Bình Thuận.","sector":"Truyền thông","type":"CT","listed":"2008-12-18","state":0.4,"foreign":0.00893273,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Nhà Xuất Bản Giáo Dục Việt Nam","p":null,"t":"CORPORATE","q":440000,"pct":40.0,"d":"2025-10-05"},{"n":"Trần Văn Hiển","p":null,"t":"INDIVIDUAL","q":110342,"pct":10.03,"d":"2021-12-10"},{"n":"Nguyễn Minh Hà","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":62438,"pct":5.68,"d":"2025-07-31"},{"n":"Nguyễn Văn Thành","p":null,"t":"INDIVIDUAL","q":52923,"pct":4.81,"d":"2017-04-22"},{"n":"Nguyễn Lệ Thủy","p":null,"t":"INDIVIDUAL","q":49100,"pct":4.464,"d":"2015-09-14"},{"n":"Nguyễn Trường Quang","p":null,"t":"INDIVIDUAL","q":40000,"pct":3.636,"d":"2018-06-06"},{"n":"Trần Ngọc Trang","p":null,"t":"INDIVIDUAL","q":18946,"pct":1.722,"d":"2020-03-03"},{"n":"Trần Hữu Sơn","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":16324,"pct":1.48,"d":"2025-07-31"},{"n":"Nguyễn Đức Thành","p":null,"t":"INDIVIDUAL","q":15829,"pct":1.439,"d":"2015-09-14"},{"n":"Nguyễn Văn Hiến","p":null,"t":"INDIVIDUAL","q":10108,"pct":0.919,"d":"2015-09-14"},{"n":"Nguyễn Văn So","p":null,"t":"INDIVIDUAL","q":9062,"pct":0.82,"d":"2025-04-24"},{"n":"Bùi Đình Thiện","p":null,"t":"INDIVIDUAL","q":3649,"pct":0.332,"d":"2020-03-03"},{"n":"Lê Trung Nhân","p":null,"t":"INDIVIDUAL","q":3505,"pct":0.32,"d":"2025-04-24"},{"n":"Vương Trí Thịnh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":3206,"pct":0.29,"d":"2025-07-31"},{"n":"Vũ Thị Thu Hà","p":null,"t":"INDIVIDUAL","