hí Minh, tỉnh Bình Dương và Đồng Nai. Công ty đã phát triển mạng lưới gồm 03 chi nhánh và hơn 300 đại lý và khách hàng kinh doanh phân phối sản phẩm Gas. Với thế mạnh của VMG là có kho chứa lớn, có đội xe bồn 5 chiếc, đội xe tải 15 chiếc, phục vụ 24/24. Ngày 11/10/2017, VMG chính thức giao dịch trên thị trường UPCOM.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-10-11","state":0.0,"foreign":0.00713542,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Thị Thanh Tuyền","p":null,"t":"INDIVIDUAL","q":2306000,"pct":24.02,"d":"2026-08-12"},{"n":"Nguyễn Thị Kim Thi","p":null,"t":"INDIVIDUAL","q":1847908,"pct":19.249,"d":"2026-08-12"},{"n":"Lê Hữu Chí","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1811325,"pct":18.868,"d":"2026-08-12"},{"n":"Vũ Đại Bách","p":null,"t":"INDIVIDUAL","q":479000,"pct":4.99,"d":"2025-10-05"},{"n":"Lê Quý Bình","p":null,"t":"INDIVIDUAL","q":243208,"pct":2.533,"d":"2015-09-14"},{"n":"Cao Thị Như Thủy","p":null,"t":"INDIVIDUAL","q":187300,"pct":1.951,"d":"2026-03-09"},{"n":"Đặng Ngọc Chi","p":null,"t":"INDIVIDUAL","q":100000,"pct":1.042,"d":"2015-09-14"},{"n":"Nguyễn Thanh Tùng","p":null,"t":"INDIVIDUAL","q":94050,"pct":0.98,"d":"2025-10-05"},{"n":"Nguyễn Xuân Vinh","p":null,"t":"INDIVIDUAL","q":37500,"pct":0.391,"d":"2015-09-14"},{"n":"Trần Minh Sơn","p":null,"t":"INDIVIDUAL","q":18525,"pct":0.193,"d":"2015-09-14"},{"n":"Bùi Thị Kim Xuyến","p":null,"t":"INDIVIDUAL","q":11575,"pct":0.121,"d":"2015-09-14"},{"n":"Chu Văn Chuyền","p":null,"t":"INDIVIDUAL","q":50,"pct":0.001,"d":"2025-10-05"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 55.2%","d":"2026-08-06","record":null,"ex":null},{"c":"AGME","t":"VMG - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-05-07","record":"2026-05-20","ex":"2026-05-19"},{"c":"OTHE","t":"VMG - Thay đổi địa chỉ","d":"2026-01-16","record":null,"ex":null},{"c":"EGME","t":"VMG - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-06-27","record":"20