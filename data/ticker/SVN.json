 Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2011-07-26","state":0.0,"foreign":0.00051957,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Việt Hùng","p":null,"t":"INDIVIDUAL","q":3315300,"pct":15.79,"d":"2025-10-05"},{"n":"Công ty cổ phần Đầu tư Xanh Việt Nam","p":null,"t":"CORPORATE","q":1035000,"pct":4.93,"d":"2025-10-05"},{"n":"Đỗ Bảo Anh","p":null,"t":"INDIVIDUAL","q":1030000,"pct":4.9,"d":"2025-10-05"},{"n":"Vũ Chí Công","p":null,"t":"INDIVIDUAL","q":1010200,"pct":4.81,"d":"2025-10-05"},{"n":"Bùi Thị Xuân","p":null,"t":"INDIVIDUAL","q":1000000,"pct":4.76,"d":"2025-10-05"},{"n":"Công ty TNHH Đầu tư Bảo Lộc Hà Việt","p":null,"t":"CORPORATE","q":1000000,"pct":4.76,"d":"2025-10-05"},{"n":"Triệu Văn Hợi","p":null,"t":"INDIVIDUAL","q":891000,"pct":4.24,"d":"2025-10-05"},{"n":"Trương Huy Tâm","p":null,"t":"INDIVIDUAL","q":869000,"pct":4.14,"d":"2025-10-05"},{"n":"Nguyễn Thị Hà","p":null,"t":"INDIVIDUAL","q":830100,"pct":3.95,"d":"2025-10-05"},{"n":"Nguyễn Thị Hiền","p":null,"t":"INDIVIDUAL","q":700000,"pct":3.33,"d":"2025-10-05"},{"n":"Nguyễn Sỹ Cường","p":null,"t":"INDIVIDUAL","q":641500,"pct":3.05,"d":"2025-10-05"},{"n":"Lê Hoài Hưng","p":null,"t":"INDIVIDUAL","q":390000,"pct":1.86,"d":"2025-10-05"},{"n":"Nguyễn Đức Tiến","p":null,"t":"INDIVIDUAL","q":300000,"pct":1.43,"d":"2025-10-05"},{"n":"Nguyễn Thanh Tùng","p":null,"t":"INDIVIDUAL","q":204800,"pct":0.98,"d":"2025-10-05"},{"n":"Nguyễn Viết Cường","p":null,"t":"INDIVIDUAL","q":198500,"pct":0.95,"d":"2025-10-05"},{"n":"Phạm Văn Tuấn Anh","p":null,"t":"INDIVIDUAL","q":200445,"pct":0.95,"d":"2025-10-05"},{"n":"Lý Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":7200,"pct":0.034,"d":"2025-10-05"},{"n":"Trần Thị Chinh","p":null,"t":"INDIVIDUAL","q":7200,"pct":0.034,"d":"2025-10-05"},{"n":"Dương Văn Sơn","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.025,"d":"2021-11-15"},{"n":"Lại Thế Vĩnh","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.025,"d":"2021-11-15"},{"n":"Ng