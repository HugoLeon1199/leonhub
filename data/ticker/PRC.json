ải Vân, Công ty cổ phần Xi măng Cosevco, Công ty cổ phần Xi măng Ngũ Hành Sơn, Công ty cổ phần Thép Đà Nẵng Ý, Công ty cổ phần Thép Thái Bình Dương, Công ty cổ phần Kỹ nghệ Khoáng sản Quảng Nam, Công ty TNHH Transcend Việt Nam. Ngày 29/11/2010, PRC chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-11-29","state":0.0,"foreign":0.00434828,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Quang Tuấn","p":"Giám đốc Tài chính/Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":1364766,"pct":22.01,"d":"2026-03-04"},{"n":"Nguyễn Tất Long","p":"Thành viên Hội đồng Quản trị/Trưởng Ban Kiểm toán nội bộ","t":"INDIVIDUAL","q":1158150,"pct":18.68,"d":"2026-03-04"},{"n":"Đỗ Văn Khánh","p":null,"t":"INDIVIDUAL","q":1019330,"pct":16.44,"d":"2026-03-04"},{"n":"Vũ Quang Vinh","p":"Chủ tịch Hội đồng Quản trị/Giám đốc Công nghệ","t":"INDIVIDUAL","q":884142,"pct":14.26,"d":"2026-03-04"},{"n":"Nguyễn Thị Tuyết","p":null,"t":"INDIVIDUAL","q":68700,"pct":5.828,"d":"2015-09-14"},{"n":"Nguyễn Minh Anh","p":null,"t":"INDIVIDUAL","q":69100,"pct":5.76,"d":"2025-10-05"},{"n":"Trần Viết Hòe","p":null,"t":"INDIVIDUAL","q":10240,"pct":0.869,"d":"2015-09-14"},{"n":"Lê Nam Hùng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Giám đốc điều hành Kinh doanh/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":42500,"pct":0.69,"d":"2026-05-13"},{"n":"Lê Văn Xuân","p":null,"t":"INDIVIDUAL","q":3020,"pct":0.256,"d":"2015-09-14"},{"n":"Dương Thị Huê","p":null,"t":"INDIVIDUAL","q":2100,"pct":0.178,"d":"2015-09-14"},{"n":"Tôn Hưng Toàn","p":"Giám đốc khối/Phó Giám đốc","t":"INDIVIDUAL","q":6560,"pct":0.1,"d":"2026-05-13"},{"n":"Huỳnh Thị Kim Nga","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.08,"d":"2025-10-05"},{"n":"Huỳnh Tám","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.08,"d":"2025-10-05"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Quyền mua CP cho Cổ đông hiện hữu tỉ lệ 100.0%","d"