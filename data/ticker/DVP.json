Công ty Cổ phần Đầu tư và Phát triển Cảng Đình Vũ được thành lập năm 2002 trên cơ sở quyết định của Tổng Giám đốc Tổng Công ty Hàng Hải Việt Nam. Hoạt động chủ yếu của công ty là hoạt động khai thác cảng biển và xếp dỡ hàng hóa, chiếm 90% tổng doanh thu hàng năm. Cảng Đình Vũ có vị trí địa lý thuận lợi, nằm trong khu công nghiệp Đình Vũ, một khu vực trọng điểm kinh tế có tốc độ phát triển nhanh chóng của Hải Phòng. Cảng là đầu mối đưa đón hàng xuất nhập khẩu của các doanh nghiệp trong khu công nghiệp. DVP được niêm yết trên sàn Chứng khoán thành phố Hồ Chí Minh (HOSE) từ 2009.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2009-12-01","state":0.51,"foreign":0.10309392,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Cảng Hải Phòng","p":null,"t":"CORPORATE","q":20400000,"pct":51.0,"d":"2026-08-20"},{"n":"Công ty Cổ phần Vật tư Nông sản","p":null,"t":"CORPORATE","q":7480000,"pct":18.7,"d":"2026-08-20"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":3211610,"pct":8.03,"d":"2025-10-05"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":1962630,"pct":4.91,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh","p":null,"t":"INDIVIDUAL","q":557450,"pct":1.394,"d":"2015-09-14"},{"n":"Greystanes Limited Company","p":null,"t":"CORPORATE","q":347210,"pct":0.868,"d":"2015-06-15"},{"n":"Công ty Cổ phần Vận Tải 1 Traco","p":null,"t":"CORPORATE","q":110000,"pct":0.275,"d":"2015-06-15"},{"n":"Ngô Thị Luyên","p":null,"t":"INDIVIDUAL","q":78000,"pct":0.195,"d":"2026-08-20"},{"n":"Đoàn Minh Trung","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":60000,"pct":0.15,"d":"2026-08-20"},{"n":"Cao Tiến Thụ","p":null,"t":"INDIVIDUAL","q":42000,"pct":0.105,"d":"2026-08-20"},{"n":"Đoàn Thị Thu Hương","p":null,"t":"INDIVIDUAL","q":33220,"pct":0.08,"d":"2025-10-05"},{"n":"Bùi Hữu Đạt","p":null,"t":"INDIVIDUAL","q":23500,"pct":0.059,"d":"2025-10-05"},{"n":"Đặng Ngọc Kiển","p":null,"t":"INDIVIDUAL"