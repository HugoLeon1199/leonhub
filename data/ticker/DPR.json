ó tiền thân là Đồn điền Thuận Lợi của Công ty Michelin – Pháp, được hình thành vào năm 1927. Công ty hoạt động chính trong lĩnh vực trồng trọt, khai thác, chế biến và kinh doanh cao su. DPR chính thức hoạt động theo hình thức công ty cổ phần từ năm 2006. Công ty hiện có 06 nông trường cao su với tổng diện tích là 9.817,86 ha cao su và 02 Nhà máy chế biến mủ cao su với tổng công suất 22.000 tấn/năm. Sản phẩm cao su của Công ty được tiêu thụ ở các nước châu Âu (như Pháp, Bỉ, Hà Lan, Anh, Tây Ban Nha, Slovakia, …) Hàn quốc, Trung quốc, Mỹ, … thông qua các khách hàng truyền thống như SMTP (Michelin), Saficalcan (Pháp), Tae Young (Hàn Quốc) và các công ty khác trong nước. DPR được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2007.","sector":"Hóa chất","type":"CT","listed":"2007-11-30","state":0.55244847,"foreign":0.02319374,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Công nghiệp Cao su Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":48000000,"pct":55.24,"d":"2026-05-08"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":2144680,"pct":4.99,"d":"2025-10-05"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":1988540,"pct":4.96,"d":"2025-10-05"},{"n":"FTIF - Templeton Frontier Markets Fund","p":null,"t":"CORPORATE","q":259480,"pct":0.603,"d":"2015-06-15"},{"n":"Nguyễn Thanh Hải","p":null,"t":"INDIVIDUAL","q":155000,"pct":0.178,"d":"2025-10-05"},{"n":"Phạm Phi Điểu","p":null,"t":"INDIVIDUAL","q":13790,"pct":0.016,"d":"2025-10-05"},{"n":"Huỳnh Minh Tâm","p":null,"t":"INDIVIDUAL","q":10400,"pct":0.012,"d":"2025-10-05"},{"n":"Huỳnh Trọng Thủy","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7000,"pct":0.008,"d":"2026-07-31"},{"n":"Ngô Trường Kỳ","p":null,"t":"INDIVIDUAL","q":2900,"pct":0.007,"d":"2015-09-14"},{"n":"Hoàng Đình Huy","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.006,"d":"2015-09-14"},{"n":"Hồ Cường","p":null,"t":"