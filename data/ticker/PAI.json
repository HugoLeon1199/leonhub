-Q2",6.423]],"y":[["2018",3.535],["2019",4.992],["2020",0.0],["2021",7.474],["2022",5.631],["2023",6.231],["2024",6.865],["2025",6.423]]}},"co":{"short":"CNTT, VT và Tự động hóa Dầu khí - PAIC","profile":"Công ty Cổ phần Công nghệ Thông tin, Viễn thông và Tự động hóa Dầu khí (PAI) có tiền thân là Trung tâm Công nghệ Thông tin, Viễn thông và Tự động hóa Dầu khí, được thành lập vào năm 2006. PAI chuyên cung cấp các dịch vụ công nghệ thông tin và viễn thông, dịch vụ tự động hóa và tích hợp hệ thống, và dịch vụ phần mềm. Công ty đã trúng thầu một số hợp đồng EPC như hệ thống MIS cho nhà máy điện Nhơn Trạch 2, Hệ thống Lan-Telecom cho nhà máy nhiệt điện Vũng Áng 1, hệ thống camera giám sát cho nhà máy lọc hóa dầu Dung Quất, hệ thống điện nhẹ cho một số tòa nhà của Tập đoàn. PAI cũng tham gia thiết kế một số phần mềm cho Tập đoàn. PAI được giao dịch trên thị trường UPCOM từ tháng 01/2017.","sector":"Viễn thông","type":"CT","listed":"2017-01-23","state":0.13602847,"foreign":0.0017,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Thương mại Dầu khí","p":null,"t":"CORPORATE","q":2196000,"pct":51.85,"d":"2026-08-24"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":576120,"pct":13.6,"d":"2026-08-24"},{"n":"Công ty Cổ phần Dịch vụ Kỹ thuật Điện lực Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":504000,"pct":11.9,"d":"2026-03-05"},{"n":"Công ty Cổ phần Chứng khoán Dầu khí","p":null,"t":"CORPORATE","q":501810,"pct":11.85,"d":"2026-06-12"},{"n":"Tổng Công ty Phân bón và Hóa chất Dầu khí - Công ty Cổ phần","p":null,"t":"CORPORATE","q":360000,"pct":8.5,"d":"2026-08-24"},{"n":"Nguyễn Việt Anh","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":10000,"pct":0.236,"d":"2026-08-24"},{"n":"Vũ Trường Quang","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":2710,"pct":0.064,"d":"2026-08-24"},{"n":"Đào Quang Ngọc","p":"Phó Giám đốc","t":"INDIVIDUAL","q":2000,"pct":0.047,"d":"2026-