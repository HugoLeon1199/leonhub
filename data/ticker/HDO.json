 doanh nghiệp sang hoạt động theo mô hình công ty cổ phần với vốn điều lệ đăng ký là 12,5 tỷ đồng. Vốn điều lệ hiện tại của Công ty là 169.59 tỷ đồng. Sản phẩm của công ty hiện chiếm 70% thị phần container văn phòng trên cả nước. Công ty có hệ thống Depot rộng khắp, trải dài từ Bắc đến Nam, chủ yếu tập trung tại các cảng biển lớn của Việt Nam như thành phố Hồ Chí Minh, Hà Nội, Hải Phòng, Quy Nhơn, Đà Nẵng. Đây là lợi thế cạnh tranh rất lớn của công ty so với các đối thủ khác.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-06-17","state":0.0,"foreign":0.00437102,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Quỹ UB Funds SPC Limited","p":null,"t":"CORPORATE","q":1618500,"pct":10.819,"d":"2015-06-15"},{"n":"Nguyễn Văn Công","p":null,"t":"INDIVIDUAL","q":1400000,"pct":8.25,"d":"2025-10-05"},{"n":"Dương Thị Hằng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1153400,"pct":7.783,"d":"2015-09-14"},{"n":"Công ty Cổ phần Quản Lý Quỹ Bông Sen","p":null,"t":"CORPORATE","q":612600,"pct":4.095,"d":"2015-06-15"},{"n":"Phan Thị Yến Nhi","p":null,"t":"INDIVIDUAL","q":465100,"pct":3.138,"d":"2015-09-14"},{"n":"Nguyễn Thị Ánh Như","p":null,"t":"INDIVIDUAL","q":453500,"pct":3.06,"d":"2015-09-14"},{"n":"Nguyễn Tuấn Anh","p":null,"t":"INDIVIDUAL","q":450870,"pct":3.042,"d":"2015-09-14"},{"n":"Lê Anh Tú","p":null,"t":"INDIVIDUAL","q":440000,"pct":2.969,"d":"2015-09-14"},{"n":"Dương Công Phùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":285319,"pct":1.91,"d":"2025-10-05"},{"n":"Lotus - Mekong River Equity Fund","p":null,"t":"CORPORATE","q":285021,"pct":1.905,"d":"2015-06-15"},{"n":"Trần Thanh Xuân","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.27,"d":"2022-05-12"},{"n":"Phan Văn Hiếu","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":27221,"pct":0.16,"d":"2025-10-05"},{"n":"Trần Thị Nguồn","p":null,"t":"INDIVIDUAL","q":1200,"pct":0.008,"d":"2025-10-05"},{"n":"Lê Thị Ngọc Mai","p":null,"t"