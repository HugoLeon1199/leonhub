Uông Bí, đường cao tốc Sài Gòn – Trung Lương. Hiện nay sản phẩm thép của công ty đã xuất khẩu sang Mỹ, Canada, EU, Indonesia, Lào, Myanmar (chiếm 30% tổng sản lượng). VGS chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX) từ ngày 04/12/2008.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2008-12-04","state":0.0,"foreign":0.00277954,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thị Thanh Thủy","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":15793787,"pct":25.67,"d":"2026-06-04"},{"n":"Lê Khánh Huyền","p":null,"t":"INDIVIDUAL","q":5069929,"pct":8.24,"d":"2026-06-04"},{"n":"Lê Quốc Khánh","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":3170532,"pct":5.15,"d":"2026-06-04"},{"n":"Nguyễn Hữu Thế","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1888479,"pct":3.07,"d":"2026-01-27"},{"n":"Đỗ Thanh Tùng","p":null,"t":"INDIVIDUAL","q":180000,"pct":0.5,"d":"2015-09-14"},{"n":"Lê Phan Đức","p":null,"t":"INDIVIDUAL","q":92000,"pct":0.256,"d":"2015-09-14"},{"n":"Nguyễn Tuấn Hưng","p":null,"t":"INDIVIDUAL","q":20198,"pct":0.056,"d":"2015-09-14"},{"n":"Ngô Vi Anh Tuấn","p":null,"t":"INDIVIDUAL","q":85,"pct":0.0,"d":"2026-01-27"},{"n":"Ngô Vi Anh Tú","p":null,"t":"INDIVIDUAL","q":116,"pct":0.0,"d":"2026-01-27"}],"rel":[{"c":"VDSJ","n":"Công ty CP Thép Việt Đức","t":"subsidiary","pct":99.94},{"c":"SVGC","n":"Công ty Cổ phần Tập đoàn Sản xuất Thép Việt Đức","t":"affiliate","pct":28.6}],"rel_count":2,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,000 VND","d":"2026-05-19","record":"2026-06-01","ex":"2026-05-29"},{"c":"AGME","t":"VGS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-05","record":"2026-03-24","ex":"2026-03-23"},{"c":"EGME","t":"VGS - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-09-19","record":"2025-10-07","ex":"2025-10-06"},{"c":"DDRP","t":"Lê Minh Hải - Đăng kí Bán 4,000,000 VGS","d":"2025-09-10","record":null,"ex":null},{"c":"AIS","t":"VGS - Niêm yết bổ s