h hàng như điện - điện tử, phụ tùng ô tô, các linh kiện cho ngành xây dựng, khuôn mẫu chính xác, kích thước lớn cung cấp cho các công ty Panasonic, LG Việt Nam, Toyota Việt Nam và các tập đoàn tại Nhật Bản (Lixil Group, Housetec, Hashimoto, Shoden Corp). NHH được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 11/2019.","sector":"Hóa chất","type":"CT","listed":"2017-09-08","state":0.0,"foreign":0.00297759,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Nhựa An Phát Xanh","p":null,"t":"CORPORATE","q":77492740,"pct":68.6,"d":"2026-08-11"},{"n":"Lê Xuân Lương","p":null,"t":"INDIVIDUAL","q":11305700,"pct":10.0,"d":"2026-06-09"},{"n":"Đỗ Thị Hương Giang","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Giám đốc Tài chính/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":4400,"pct":0.004,"d":"2026-08-24"},{"n":"Lâm Thị Hiền","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.001,"d":"2026-08-24"}],"rel":[{"c":"ANTRUNGIND","n":"Công ty TNHH An Trung Industries","t":"subsidiary","pct":100.0},{"c":"VIEXIM","n":"Công ty TNHH Phát Triển Xuất Nhập Khẩu Và Đầu Tư - Viexim","t":"subsidiary","pct":100.0},{"c":"0801238156","n":"Công ty Cổ Phần Vật Liệu Xây Dựng Công Nghệ Cao An Cường","t":"subsidiary","pct":99.84},{"c":"VAPA","n":"Công ty TNHH Linh Kiện Nhựa Ô Tô Vinfast-An Phát","t":"affiliate","pct":50.0},{"c":"0202084468","n":"Công ty Cổ Phần Sản Xuất Pbat An Phát","t":"affiliate","pct":35.51}],"rel_count":5,"events":[{"c":"OTHE","t":"NHH - Thay đổi địa chỉ","d":"2026-08-10","record":null,"ex":null},{"c":"DDIND","t":"Lê Xuân Lương - Đăng kí Mua NHH","d":"2026-06-09","record":null,"ex":null},{"c":"AGME","t":"NHH - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-11","record":"2026-03-30","ex":"2026-03-27"},{"c":"AIS","t":"NHH - Niêm yết bổ sung 3.644.000 cổ phiếu","d":"2025-09-22","record":null,"ex":null},{"c":"AIS","t":"NHH - Niêm yết bổ sung 36.440.000 cổ phiếu","d":"2025-09-05","record":null