9],["2024",17.79],["2025",17.774]]}},"co":{"short":"Traphaco","profile":"Công ty Cổ phần Traphaco (TRA), tiền thân là Tổ sản xuất thuốc thuộc Ty Y tế Đường sắt được thành lập vào năm 1971. TRA chính thức hoạt động theo mô hình công ty cổ phần từ năm 1999. Công ty chuyên sản xuất kinh doanh đông dược, hóa chất và vật tư thiết bị y tế. Là doanh nghiệp sản xuất đông dược lớn nhất Việt Nam, TRA hiện sở hữu 13 vùng trồng/ thu hái dược liệu đạt tiêu chuẩn GACP-WHO, quản lý vận hành 1 nhà máy chiết xuất dược liệu và 3 nhà máy sản xuất đạt tiêu chuẩn GMP-WHO. Ngày 26/11/2008, TRA chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Y tế","type":"CT","listed":"2008-11-26","state":0.35671316,"foreign":0.4636044,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":14786512,"pct":35.67,"d":"2026-08-20"},{"n":"Magbi Fund Limited","p":null,"t":"CORPORATE","q":10361385,"pct":25.0,"d":"2026-07-22"},{"n":"Super Delta Pte. Ltd","p":null,"t":"CORPORATE","q":6267289,"pct":15.12,"d":"2026-07-22"},{"n":"Access S.a., Sicav-sif-asia Top Picks","p":null,"t":"CORPORATE","q":2074000,"pct":5.0,"d":"2026-07-22"},{"n":"Citgroup Global Markets Limited","p":null,"t":"CORPORATE","q":1170760,"pct":4.744,"d":"2015-06-15"},{"n":"Trần Túc Mã","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1724456,"pct":4.16,"d":"2026-08-19"},{"n":"Quỹ Đầu tư Chứng khoán Y tế Bản Việt","p":null,"t":"CORPORATE","q":430056,"pct":1.743,"d":"2015-06-15"},{"n":"VŨ THỊ THUẬN","p":null,"t":"INDIVIDUAL","q":471254,"pct":1.14,"d":"2025-10-05"},{"n":"Nguyễn Huy Văn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":437673,"pct":1.056,"d":"2026-08-19"},{"n":"Nguyễn Thị Mùi","p":null,"t":"INDIVIDUAL","q":121840,"pct":0.494,"d":"2015-09-14"},{"n":"Nguyễn Thị Hoan","p":null,"t":"INDIVIDUAL","q":100560,"pct":0.24,"d":"2025-10-05"},{"n":"Nguyễn Thị Lan","p":null,"t":"INDIV