":[["2018",11.6],["2019",16.317],["2020",0.0],["2021",10.481],["2022",13.988],["2023",16.307],["2024",18.653],["2025",13.667]]}},"co":{"short":"SX và KD Vật tư Thiết bị - VVMI","profile":"Công ty Cổ phần Sản xuất và Kinh doanh Vật tư Thiết bị - VVMI (TB8) có tiền thân là Xí nghiệp Vật tư Vận tải và Chế biến Than, được thành lập vào năm 1983. Công ty hoạt động chính trong lĩnh vực sản xuất và kinh doanh vỏ bao xi măng, lưới thép hầm lò và kéo rút dây thép. TB8 chính thức hoạt động theo mô hình công ty cổ phần từ năm 2004. TB8 hiện đang quản lý và vận hành dây chuyền sản xuất vỏ bao xi măng với công suất 20 triệu vỏ/năm, dây chuyền cán, kéo rút thép có công suất 5 nghìn tấn/năm và dây chuyền sản xuất lưới thép có công suất 2,5-3 triệu m2/năm.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-12-30","state":0.5100056,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Công nghiệp mỏ Việt Bắc TKV - Công ty Cổ phần","p":null,"t":"CORPORATE","q":637500,"pct":51.0,"d":"2026-03-09"},{"n":"Phạm Đức Khiêm","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":257455,"pct":20.596,"d":"2026-04-09"},{"n":"Phạm Đình Tuấn","p":null,"t":"INDIVIDUAL","q":32624,"pct":5.33,"d":"2025-10-05"},{"n":"Phạm Đức Trung","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":13125,"pct":1.05,"d":"2026-04-02"},{"n":"Tô Toàn Thắng","p":null,"t":"INDIVIDUAL","q":9958,"pct":0.796,"d":"2025-10-05"},{"n":"Bùi Phương Anh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":7917,"pct":0.633,"d":"2026-03-09"},{"n":"Lê Thị Kim Chi","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":1667,"pct":0.133,"d":"2026-03-09"},{"n":"Ngô Minh Vinh","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.08,"d":"2026-04-02"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,600 VND","d":"2026-04-15","record":"2026-04-22","ex":"2026-04-21"},{"c":"SUSP","t":"TB8 - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2026-04-13","