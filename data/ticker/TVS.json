h tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Dịch vụ tài chính","type":"CK","listed":"2015-01-15","state":0.0,"foreign":0.17580696,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Trung Hà","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":69856330,"pct":30.55,"d":"2026-08-04"},{"n":"Đinh Thị Hoa","p":null,"t":"INDIVIDUAL","q":31988845,"pct":15.96,"d":"2025-11-18"},{"n":"Wardhaven Vietnam Fund","p":null,"t":"CORPORATE","q":11195837,"pct":4.99,"d":"2026-01-19"},{"n":"Apollo Asia Fund","p":null,"t":"CORPORATE","q":5262474,"pct":4.92,"d":"2025-10-05"},{"n":"Panah Master Fund","p":null,"t":"CORPORATE","q":2000013,"pct":1.87,"d":"2025-10-05"},{"n":"Tina Lin - Chi Ju","p":null,"t":"INDIVIDUAL","q":3016232,"pct":1.51,"d":"2025-11-18"},{"n":"Nguyễn Thanh Thảo","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3220841,"pct":1.41,"d":"2026-08-04"},{"n":"Bùi Thị Kim Oanh","p":null,"t":"INDIVIDUAL","q":2070195,"pct":0.91,"d":"2026-08-04"},{"n":"Trần Thị Hồng Nhung","p":null,"t":"INDIVIDUAL","q":883874,"pct":0.39,"d":"2026-08-04"},{"n":"Trần Vinh Quang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":815571,"pct":0.36,"d":"2026-08-04"},{"n":"Lại Thị Hoa","p":null,"t":"INDIVIDUAL","q":592641,"pct":0.3,"d":"2025-11-18"},{"n":"Ngô Nhật Minh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":645915,"pct":0.28,"d":"2026-08-04"},{"n":"Lê Quang Tiến","p":null,"t":"INDIVIDUAL","q":291506,"pct":0.15,"d":"2025-11-18"},{"n":"Bùi Thành Trung","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":248560,"pct":0.11,"d":"2026-08-04"},{"n":"Hồ Nhật Quang","p":null,"t":"INDIVIDUAL","q":196354,"pct":0.1,"d":"2025-11-18"},{"n":"Nguyễn Trung Thành","p":null,"t":"INDIVIDUAL","q":164289,"pct":0.082,"d":"2026-02-05"},{"n":"Nguyễn Thị Ngọc Tuyền","p":null,"t":"INDIVIDUAL","q":97200,"pct":0.05,"d":"2025-11-18"},{"n":"Đỗ Minh Tiến","p":"Kế toán trưởng/Trưởng phòng Tài chính - Kế toán","t":"