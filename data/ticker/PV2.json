 lớn như: Dự án khu dân cư tại Long Tân và Phú Hội, Nhơn Trạch - Đồng Nai; Dự án khu nhà ở CBCNV Nhà máy lọc dầu Dung Quất - Quảng Ngãi. Ngày 16/12/2010, PV2 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2010-12-16","state":0.0,"foreign":0.0022838,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Phúc Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":9145000,"pct":24.804,"d":"2026-03-03"},{"n":"Chu Minh Châu","p":null,"t":"INDIVIDUAL","q":7478400,"pct":20.284,"d":"2026-03-03"},{"n":"Nguyễn Anh Tuấn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2110200,"pct":5.724,"d":"2026-03-03"},{"n":"Khoa Anh Thắng","p":null,"t":"INDIVIDUAL","q":1829000,"pct":4.96,"d":"2025-10-05"},{"n":"Tôn Thiện Việt","p":null,"t":"INDIVIDUAL","q":1829000,"pct":4.89,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Đại chúng Việt Nam","p":null,"t":"CORPORATE","q":1338816,"pct":3.585,"d":"2015-06-15"},{"n":"Ngân hàng Thương mại Cổ phần Quốc tế Việt Nam","p":null,"t":"CORPORATE","q":1200000,"pct":3.213,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư PVR Hà Nội","p":null,"t":"CORPORATE","q":1100000,"pct":2.945,"d":"2015-06-15"},{"n":"Công ty Cổ phần SJ Group","p":null,"t":"CORPORATE","q":600000,"pct":1.606,"d":"2015-06-15"},{"n":"Lê Anh Tuấn","p":null,"t":"INDIVIDUAL","q":394300,"pct":1.069,"d":"2015-09-14"},{"n":"Nguyễn Đức Dân","p":null,"t":"INDIVIDUAL","q":14500,"pct":0.039,"d":"2015-09-14"},{"n":"Lê Minh Tuấn","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.027,"d":"2015-09-14"},{"n":"Vũ Xuân Hân","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":10000,"pct":0.027,"d":"2026-03-03"},{"n":"Phạm Thị Thanh Nga","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.003,"d":"2015-09-14"},{"n":"Nguyễn Anh Vũ","p":null,"t":"INDIVIDUAL","q":500,"pct":0.001,"d":"2015-09-14"}],"rel":[{"c":"ALADDINTECH","n":"Công Ty Cổ Phần Công Nghệ Aladdin","t":"affiliate","pct":49.0},{"c