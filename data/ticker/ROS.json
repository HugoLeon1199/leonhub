tư 6.000 tỷ đồng trong vòng 9 tháng năm 2015. Ngoài ra, Faros cũng là tổng thầu của dự án Quần thể sân golf, biệt thự nghỉ dưỡng và giải trí cao cấp FLC Quy Nhơn tại tỉnh Bình Định với quy mô 300ha và tổng mức đầu tư 3.500 tỷ đồng và dự án khu tổ hợp nghỉ dưỡng và thể thao giải trí công cộng đa chức năng FLC Vĩnh Thịnh Resort tại Vĩnh Phúc với quy mô 7.4ha và tổng mức đầu tư 600 tỷ đồng.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-09-01","state":0.0,"foreign":0.01879103,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Văn Lợi","p":null,"t":"INDIVIDUAL","q":32940800,"pct":5.804,"d":"2025-10-05"},{"n":"Công ty TNHH Một Thành Viên Flc Land","p":null,"t":"CORPORATE","q":28173600,"pct":4.96,"d":"2025-10-05"},{"n":"Trịnh Văn Quyết","p":null,"t":"INDIVIDUAL","q":23717556,"pct":4.17,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán ARTEX","p":null,"t":"CORPORATE","q":16600536,"pct":2.925,"d":"2025-10-05"},{"n":"VanEck Vietnam ETF","p":null,"t":"CORPORATE","q":3748248,"pct":0.79,"d":"2025-10-05"},{"n":"Trịnh Thị Minh Huế","p":null,"t":"INDIVIDUAL","q":1200000,"pct":0.21,"d":"2025-10-05"},{"n":"Hương Trần Kiều Dung","p":null,"t":"INDIVIDUAL","q":1132000,"pct":0.2,"d":"2025-10-05"},{"n":"Trịnh Thị Thúy Nga","p":null,"t":"INDIVIDUAL","q":600000,"pct":0.11,"d":"2025-10-05"},{"n":"Lê Thành Vinh","p":null,"t":"INDIVIDUAL","q":132000,"pct":0.023,"d":"2025-10-05"},{"n":"Đỗ Như Tuấn","p":null,"t":"INDIVIDUAL","q":66000,"pct":0.012,"d":"2025-10-05"},{"n":"Nguyễn Thanh Bình","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.01,"d":"2025-10-05"},{"n":"Quỹ ETF SSIAM VNX50","p":null,"t":"CORPORATE","q":54010,"pct":0.01,"d":"2026-08-17"},{"n":"Nguyễn Bình Phương","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":39600,"pct":0.007,"d":"2025-10-05"},{"n":"Nguyễn Bình Phương","p":"Thành viên Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":39600,"pct":0.007,"d":"2021-03-23"},{"n":"Nguyễn Tiến 