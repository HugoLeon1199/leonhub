ệt Nam tại khu vực miền Trung và các tỉnh Tây nguyên. Hiện tại sản phẩm xi măng Hải Vân được sản xuất trên dây chuyền công nghệ hiện đại, tự động, thiết bị do hãng Krupp-Polysiua, CHLB Đức chế tạo, lắp đặt và chuyển giao công nghệ. Ngày 18/03/2026, HVX chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-09-28","state":0.75750923,"foreign":0.00778322,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Xi măng Việt Nam","p":null,"t":"CORPORATE","q":31455760,"pct":75.75,"d":"2026-03-03"},{"n":"Dương Xuân Thủy","p":null,"t":"INDIVIDUAL","q":1957749,"pct":4.899,"d":"2015-09-14"},{"n":"Dương Xuân Chung","p":null,"t":"INDIVIDUAL","q":1568671,"pct":3.926,"d":"2015-09-14"},{"n":"Vũ Viết Hoàn","p":null,"t":"INDIVIDUAL","q":1506820,"pct":3.771,"d":"2015-09-14"},{"n":"Công ty Cổ phần Chứng khoán Bảo Việt","p":null,"t":"CORPORATE","q":803240,"pct":2.01,"d":"2015-06-15"},{"n":"Đinh Ngọc Châu","p":"Kế toán trưởng","t":"INDIVIDUAL","q":57900,"pct":0.14,"d":"2026-08-17"},{"n":"Lưu Văn Bòng","p":null,"t":"INDIVIDUAL","q":14632,"pct":0.035,"d":"2026-08-17"},{"n":"Hà Huy Tuấn","p":null,"t":"INDIVIDUAL","q":7400,"pct":0.019,"d":"2015-09-14"},{"n":"Nguyễn Bích Thủy","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.013,"d":"2015-09-14"},{"n":"Đặng Ngọc Bảo","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":5200,"pct":0.013,"d":"2026-08-17"},{"n":"Huỳnh Ngọc Khiêm","p":null,"t":"INDIVIDUAL","q":1100,"pct":0.003,"d":"2025-10-05"},{"n":"Lê Thị Ánh Đào","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":900,"pct":0.002,"d":"2026-08-17"},{"n":"Credit Suise (Hong Kong) Limited","p":null,"t":"CORPORATE","q":300,"pct":0.001,"d":"2015-06-15"},{"n":"Ngô Đức Lưu","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":5000,"pct":0.0,"d":"2019-05-28"}],"events":[{"c":"MOVE","t":"HVX - Chuyển sàn từ HOSE sang UPCoM","d":"2026-03-11","record":null,"ex":null},{"c":