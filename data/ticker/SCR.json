al sẽ tiếp tục triển khai các dự án bất động sản với chất lượng môi trường sống cao cùng những tiện ích công cộng như: công viên, trường học, khu trung tâm thương mại... SCR được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2016.","sector":"Bất động sản","type":"CT","listed":"2016-11-18","state":0.0,"foreign":0.00245148,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Đầu tư Thành Thành Công","p":null,"t":"CORPORATE","q":97678941,"pct":22.69,"d":"2026-02-09"},{"n":"Đặng Hồng Anh","p":null,"t":"INDIVIDUAL","q":34297849,"pct":10.11,"d":"2019-06-13"},{"n":"Trương Thị Ngọc Hiền","p":null,"t":"INDIVIDUAL","q":24793023,"pct":5.758,"d":"2026-03-16"},{"n":"Công ty Cổ phần Thương Mại Thành Thành Công","p":null,"t":"CORPORATE","q":16282631,"pct":4.8,"d":"2025-10-05"},{"n":"Công ty Cổ phần Khu Công Nghiệp Thành Thành Công","p":null,"t":"CORPORATE","q":8429315,"pct":1.96,"d":"2026-08-04"},{"n":"Đặng Văn Thành","p":null,"t":"INDIVIDUAL","q":216000,"pct":0.054,"d":"2026-02-09"},{"n":"Nguyễn Thị Mai Thảo","p":null,"t":"INDIVIDUAL","q":177239,"pct":0.05,"d":"2025-10-05"},{"n":"Công đoàn Ngân hàng Thương mại Cổ phần Sài Gòn Thương Tín","p":null,"t":"CORPORATE","q":105000,"pct":0.042,"d":"2015-06-15"},{"n":"Công ty CP Đầu Tư Hạ Tầng Cụm Công Nghiệp Tân Hội","p":null,"t":"CORPORATE","q":135000,"pct":0.03,"d":"2026-08-04"},{"n":"Trịnh Nguyễn Thuỳ Trang","p":null,"t":"INDIVIDUAL","q":112650,"pct":0.029,"d":"2026-02-09"},{"n":"Trần Thiện Thanh Thùy","p":null,"t":"INDIVIDUAL","q":71000,"pct":0.02,"d":"2025-10-05"},{"n":"Huỳnh Bích Ngọc","p":null,"t":"INDIVIDUAL","q":72280,"pct":0.018,"d":"2026-02-09"},{"n":"Ngân hàng Thương mại Cổ phần Sài Gòn Thương Tín","p":null,"t":"CORPORATE","q":44000,"pct":0.018,"d":"2015-06-15"},{"n":"Công ty Cổ phần Bảo hiểm Viễn Đông","p":null,"t":"CORPORATE","q":40000,"pct":0.016,"d":"2015-06-15"},{"n":"Lương Đình Quang","p":null,"t":"INDIVIDUAL","q":18627,"pct":0.008,"d":"2015-09-1