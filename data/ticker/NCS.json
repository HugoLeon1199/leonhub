e. NCS được giao dịch trên thị trường UPCOM từ cuối năm 2015.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2015-12-02","state":0.60173536,"foreign":0.05675466,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Hàng không Việt Nam - CTCP","p":null,"t":"CORPORATE","q":10800607,"pct":60.17,"d":"2026-05-11"},{"n":"Công ty Cổ phần Dịch vụ Hàng không Sân bay Tân Sơn Nhất","p":null,"t":"CORPORATE","q":1800100,"pct":10.03,"d":"2026-07-15"},{"n":"Công ty TNHH MTV Suất Ăn Hàng Không Việt Nam","p":null,"t":"CORPORATE","q":306015,"pct":1.7,"d":"2026-07-15"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 3,300 VND","d":"2026-05-13","record":"2026-05-20","ex":"2026-05-19"},{"c":"AGME","t":"NCS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-16","record":"2026-03-25","ex":"2026-03-24"},{"c":"AGME","t":"NCS - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-19","record":"2025-03-26","ex":"2025-03-25"},{"c":"AGME","t":"NCS - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-19","record":"2024-03-26","ex":"2024-03-25"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2019 - 1,500 VND","d":"2023-11-15","record":"2023-11-24","ex":"2023-11-23"},{"c":"AGME","t":"NCS - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-05-11","record":"2023-05-26","ex":"2023-05-25"},{"c":"AGME","t":"NCS - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-05-12","record":"2022-05-20","ex":"2022-05-19"},{"c":"AGME","t":"NCS - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-05-18","record":"2021-06-04","ex":"2021-06-03"},{"c":"EGME","t":"NCS - Tổ chức đại hội đồng cổ đông bất thường năm 2020","d":"2020-12-04","record":"2020-12-16","ex":"2020-12-15"},{"c":"EGME","t":"NCS - Tổ chức Đại hội đồng cổ đông bất thường năm 2020","d":"2020-09-30","record":"2020-10-15","ex":"2020-10-14"},{"c":"AGME","t":"NCS - Tổ chức ĐHĐCĐ thường niên 2020","d":"2020-05-22","record":"2020-06-10","ex":"2020-06-09"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2018 - 2,200 VND","d":"201