",-0.973],["2020",-0.274],["2021",0.642]]}},"co":{"short":"Xây Dựng Hạ Tầng Cii","profile":"Công ty Cổ phần Xây dựng Hạ tầng CII (CEE) có tiền thân là Công ty Đầu tư & Kinh doanh Công trình Giao thông 565, được thành lập vào năm 2000. Công ty hoạt động chính trong lĩnh vực xây dựng, lắp đặt, sửa chữa các công trình hạ tầng giao thông, nước, công nghiệp, dân dụng. Địa bàn kinh doanh của Công ty hiện tại là khu vực Thành phố Hồ Chí Minh, các tỉnh Nam Bộ và Nam Trung Bộ. CII đã tham gia thi công nhiều công trình trọng điểm như Cầu Sông Lũy tại Bình Thuận, Cầu Sài Gòn 2, dự án xây dựng hạ tầng kỹ thuật Khu đô thị mới Thủ Thiêm tại Quận 2, Thành phố Hồ Chí Minh, Hạ tầng Kỹ thuật Khu Công nghiệp Thái Hòa và Hạ tầng Kỹ thuật Khu tái định cư Hàm Liêm 3. Bên cạnh đó, CEE còn mở rộng hoạt động sang những lĩnh vực hỗ trợ cho ngành xây dựng như dịch vụ Kỹ thuật cơ điện (M&E), Kinh doanh vật liệu xây dựng và Khai thác sản xuất đá Granite.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-05-15","state":0.0,"foreign":8.795e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trương Lê Duy","p":null,"t":"INDIVIDUAL","q":2292420,"pct":5.8,"d":"2022-02-22"},{"n":"Công ty Cổ Phần Tư Vấn Đầu Tư Lâm Viên","p":null,"t":"CORPORATE","q":1709570,"pct":4.33,"d":"2025-10-05"},{"n":"Lê Quốc Bình","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":500000,"pct":1.27,"d":"2022-05-11"},{"n":"Phạm Vũ Thức","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":365080,"pct":0.92,"d":"2022-05-11"},{"n":"Phùng Văn Hiền","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":117180,"pct":0.3,"d":"2022-05-11"},{"n":"Nguyễn Trường Thanh","p":null,"t":"INDIVIDUAL","q":82180,"pct":0.21,"d":"2019-02-13"},{"n":"Hồ Tiến Trung","p":null,"t":"INDIVIDUAL","q":23430,"pct":0.056,"d":"2017-05-12"},{"n":"Mai Thanh Trường","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.024,"d":"2018-01-18"},{"n":"Lê Thị Bé Mum","p":null,"t":"INDIVIDUAL","q":1500,"pct":