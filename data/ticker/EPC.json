g trại chăn nuôi bò của Công ty có diện tích 1,1 ha, với tổng số bò chăn nuôi ổn định hàng năm đạt khoảng 500 con.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2018-10-03","state":0.32189381,"foreign":1.065e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Đắk Lắk","p":null,"t":"CORPORATE","q":3022100,"pct":32.19,"d":"2025-10-09"},{"n":"Nguyễn Thu Trang","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2300000,"pct":24.5,"d":"2025-10-09"},{"n":"Nguyễn Văn Dương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2013700,"pct":21.45,"d":"2025-10-09"},{"n":"Ngô Văn Hùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1779270,"pct":18.95,"d":"2021-02-23"},{"n":"Ngô Thị Nhung","p":null,"t":"INDIVIDUAL","q":1500000,"pct":15.98,"d":"2025-10-09"},{"n":"Nguyễn Thị Phương Thơm","p":null,"t":"INDIVIDUAL","q":400470,"pct":4.27,"d":"2025-10-05"},{"n":"Huỳnh Trọng Phước","p":"Giám đốc","t":"INDIVIDUAL","q":3800,"pct":0.04,"d":"2025-10-05"},{"n":"Võ Duy Thanh","p":null,"t":"INDIVIDUAL","q":3900,"pct":0.039,"d":"2025-10-05"},{"n":"Cao Văn Khương","p":null,"t":"INDIVIDUAL","q":2200,"pct":0.022,"d":"2025-10-05"},{"n":"Nguyễn Thị Thúy","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2200,"pct":0.02,"d":"2025-10-05"},{"n":"Hoàng Thị Thanh Huyền","p":"Kế toán trưởng/Trưởng phòng Tài chính - Kế toán","t":"INDIVIDUAL","q":700,"pct":0.01,"d":"2025-10-05"},{"n":"Huỳnh Thị Thu Thủy","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1000,"pct":0.01,"d":"2025-10-05"}],"events":[{"c":"SUSP","t":"EPC - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2025-10-07","record":null,"ex":null},{"c":"AGME","t":"EPC - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-18","record":"2025-03-26","ex":"2025-03-25"},{"c":"AGME","t":"EPC - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-18","record":"2024-04-01","ex":"2024-03-29"},{"c":"DDIND","t":"Nguyễn Thu Trang - Đăng kí Mua EPC","d":"2023-05-15","record":null,"