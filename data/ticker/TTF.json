, Thành phố Hồ Chí Minh, Bình Dương, Bình Phước, Vũng Tàu và Long Xuyên. Ngày 18/02/2008, TTF chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2008-02-18","state":0.0,"foreign":0.05380159,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đinh Thị Kim Dung","p":null,"t":"INDIVIDUAL","q":37565763,"pct":9.14,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Xây Dựng U&i","p":null,"t":"CORPORATE","q":29000000,"pct":7.07,"d":"2026-08-05"},{"n":"Nguyễn Thị Xuân","p":null,"t":"INDIVIDUAL","q":8043425,"pct":5.741,"d":"2015-09-14"},{"n":"Phương Xuân Thụy","p":null,"t":"INDIVIDUAL","q":7029397,"pct":5.018,"d":"2022-05-11"},{"n":"Công ty Cổ Phần Logistics U&I","p":null,"t":"CORPORATE","q":3178492,"pct":4.42,"d":"2026-08-05"},{"n":"Vũ Xuân Dương","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":7000000,"pct":1.779,"d":"2026-08-05"},{"n":"Mai Hữu Tín","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":5260000,"pct":1.337,"d":"2026-08-05"},{"n":"Đào Thụy Phương Thảo","p":null,"t":"INDIVIDUAL","q":5000000,"pct":1.27,"d":"2026-08-05"},{"n":"Võ Quốc Lợi","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":4344820,"pct":1.104,"d":"2026-08-05"},{"n":"Liam Pius Cully","p":null,"t":"INDIVIDUAL","q":1087229,"pct":0.776,"d":"2015-09-14"},{"n":"Công ty Cổ Phần Đồng Tâm Dotalia","p":null,"t":"CORPORATE","q":2188500,"pct":0.556,"d":"2025-10-05"},{"n":"Võ Diệp Văn Tuấn","p":null,"t":"INDIVIDUAL","q":650017,"pct":0.463,"d":"2025-10-05"},{"n":"Đoàn Thuỵ Diễm Huyền","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":1135010,"pct":0.28,"d":"2026-08-05"},{"n":"Ngô Thị Hồng Thu","p":null,"t":"INDIVIDUAL","q":200001,"pct":0.143,"d":"2015-09-14"},{"n":"Nguyễn Trọng Hiếu","p":null,"t":"INDIVIDUAL","q":330000,"pct":0.08,"d":"2026-08-05"},{"n":"Hồ Thị Minh Thảo","p":null,"t":"INDIVIDUAL","q":63500,"pct":0.045,"d":"2015-09-14"},{"n":"Phạm Thị Mỹ Hà","p":null,"t":"INDIVI