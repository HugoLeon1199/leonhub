 liệu Thuốc lá thành lập năm 1992. Năm 2004 chuyển sang hoạt động theo mô hình cổ phần. Hoạt động chính của Công ty là sản xuất cây đầu lọc cho thuốc lá và sản phẩm in nhãn thuốc và giấy sáp (màu vàng và trắng). Sản phẩm của công cung cấp chủ yếu cho Tổng Công Ty Thuốc Lá Việt Nam (chiếm khoảng 80% tổng doanh thu). Điểm mạnh của Cát Lợi là công ty hoạt động trong lĩnh vực đang được độc quyền tại Việt Nam, với sản phẩm đầu ra được bảo đảm tiêu thụ bởi Tổng Công ty Thuốc lá Việt Nam, Cát Lợi không phải chịu nhiều sức ép cạnh tranh trong kinh doanh. CLC chính thức được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2006.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2006-11-16","state":0.51000811,"foreign":0.01872229,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"TỔNG CÔNG TY THUỐC LÁ VIỆT NAM - CÔNG TY TNHH MỘT THÀNH VIÊN","p":null,"t":"CORPORATE","q":13366080,"pct":51.0,"d":"2026-08-24"},{"n":"Công ty TNHH MTV Thuốc lá Sài Gòn","p":null,"t":"CORPORATE","q":1672540,"pct":6.4,"d":"2026-08-24"},{"n":"Công ty TNHH Một thành viên Thuốc lá Thăng Long","p":null,"t":"CORPORATE","q":1067608,"pct":4.1,"d":"2026-08-24"},{"n":"Nguyễn Văn Tuý","p":null,"t":"INDIVIDUAL","q":136396,"pct":1.041,"d":"2015-09-14"},{"n":"Nguyễn Văn Đạo","p":null,"t":"INDIVIDUAL","q":75000,"pct":0.572,"d":"2015-09-14"},{"n":"Nguyễn Lê Toàn Thắng","p":"Phó Giám đốc","t":"INDIVIDUAL","q":150000,"pct":0.57,"d":"2026-08-24"},{"n":"Lê Hồng Thúy","p":null,"t":"INDIVIDUAL","q":110361,"pct":0.42,"d":"2026-08-24"},{"n":"Nguyễn Việt Dũng","p":null,"t":"INDIVIDUAL","q":44845,"pct":0.342,"d":"2015-09-14"},{"n":"Nguyễn Hoàng Minh","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":44110,"pct":0.17,"d":"2026-08-24"},{"n":"Nguyễn Thị Diệu Linh","p":null,"t":"INDIVIDUAL","q":30276,"pct":0.12,"d":"2026-08-24"},{"n":"Cù Mạnh Đạt","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":30008,"pct":0.11,"d":"2026-08-24"},{"n":"Phạ