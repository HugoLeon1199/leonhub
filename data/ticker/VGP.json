g thực hiện dịch vụ kinh doanh xuất nhập khẩu trực tiếp và xuất nhập khẩu uỷ thác. Giá trị mỗi hợp đồng từ 1.000.000 USD trở xuống. Các hàng hoá Công ty thực hiện kinh doanh là sắt thép, máy cao tầng, tôn ép, Hoá chât, cao su, gỗ .... đã đem lại doanh thu và lợi nhuận tương đối tốt. Ngày 29/11/2006, VGP chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-11-29","state":0.38426273,"foreign":0.01194798,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Phù Đổng Invest","p":null,"t":"CORPORATE","q":1471322,"pct":18.8,"d":"2025-10-05"},{"n":"Phạm Ngọc Quỳnh","p":"Thành viên Hội đồng Quản trị/Giám đốc/Giám đốc điều hành/Giám đốc khối","t":"INDIVIDUAL","q":1278759,"pct":16.34,"d":"2026-02-27"},{"n":"Công ty cổ phần Tập đoàn VINACAM","p":null,"t":"CORPORATE","q":200000,"pct":2.435,"d":"2015-06-15"},{"n":"Huỳnh Kim Sắt","p":null,"t":"INDIVIDUAL","q":129592,"pct":1.656,"d":"2015-09-14"},{"n":"Huỳnh Nguyên","p":null,"t":"INDIVIDUAL","q":84452,"pct":1.079,"d":"2015-09-14"},{"n":"Nguyễn Văn Thành","p":null,"t":"INDIVIDUAL","q":46666,"pct":0.596,"d":"2015-09-14"},{"n":"Bùi Hoàng Chương","p":null,"t":"INDIVIDUAL","q":38752,"pct":0.41,"d":"2025-10-05"},{"n":"Tạ Mỹ Duyên","p":null,"t":"INDIVIDUAL","q":29333,"pct":0.375,"d":"2015-09-14"},{"n":"Hoàng Thị Mai","p":null,"t":"INDIVIDUAL","q":66,"pct":0.001,"d":"2025-10-05"},{"n":"Công ty Cổ phần A.N.P.H.A","p":null,"t":"CORPORATE","q":33,"pct":0.0,"d":"2015-06-15"}],"events":[{"c":"AGME","t":"VGP - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-05","record":"2026-03-23","ex":"2026-03-20"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 - 400 VND","d":"2025-11-27","record":"2025-12-04","ex":"2025-12-03"},{"c":"AGME","t":"VGP - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-12","record":"2025-03-27","ex":"2025-03-26"},{"c":"DDINS","t":"Công ty TNHH Phù Đổng Invest - Đăng kí Mua VGP","d":"2024-12-27","record":null