 cạnh tranh đến từ các công ty cùng ngành hoạt động tại Cảng Hàng không quốc tế Tân Sơn Nhất, SGN vẫn chiếm hơn 50% thị phần cung cấp dịch vụ mặt đất tại đây và là đơn vị đầu tiên có khả năng phục vụ hàng hóa trọng tải lên đến 32 tấn/ kiện. SGN được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2018.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2015-12-10","state":0.48026322,"foreign":0.2754286,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cảng Hàng không Việt Nam - CTCP","p":null,"t":"CORPORATE","q":16128051,"pct":48.03,"d":"2026-07-28"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":8382414,"pct":24.96,"d":"2025-10-05"},{"n":"Công ty Cổ phần Hàng không Vietjet","p":null,"t":"CORPORATE","q":3060822,"pct":9.11,"d":"2026-07-28"},{"n":"Công ty Cổ phần Bất động sản Trường Sơn","p":null,"t":"CORPORATE","q":1577245,"pct":4.7,"d":"2025-10-05"},{"n":"Công ty TNHH Quản lý quỹ SSI","p":null,"t":"CORPORATE","q":589833,"pct":2.46,"d":"2025-10-05"},{"n":"NGUYỄN ĐÌNH HÙNG","p":null,"t":"INDIVIDUAL","q":243952,"pct":0.73,"d":"2025-10-05"},{"n":"Nguyễn Nhật Long","p":null,"t":"INDIVIDUAL","q":72597,"pct":0.22,"d":"2025-10-05"},{"n":"Nguyễn Văn Mỹ","p":null,"t":"INDIVIDUAL","q":62216,"pct":0.186,"d":"2025-10-05"},{"n":"Lê Thị Diệu Thúy","p":null,"t":"INDIVIDUAL","q":25200,"pct":0.075,"d":"2025-10-05"},{"n":"Lưu Quang Lãm","p":null,"t":"INDIVIDUAL","q":25200,"pct":0.075,"d":"2025-10-05"},{"n":"Nguyễn Thị Đỗ Quyên","p":null,"t":"INDIVIDUAL","q":25200,"pct":0.075,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh Vy","p":null,"t":"INDIVIDUAL","q":7056,"pct":0.021,"d":"2025-10-05"},{"n":"Lê Minh Hưng","p":null,"t":"INDIVIDUAL","q":6350,"pct":0.019,"d":"2025-10-05"},{"n":"Nguyễn Quốc Cường","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":4,"pct":0.0,"d":"2026-07-28"},{"n":"Phùng Thị Thanh Huyền","p":null,"t":"INDIVIDUAL","q":2,"pc