 tiến hành sáp nhập và nâng cấp nhiều nhà máy cấp nước ở thành phố và các huyện, thị trấn trên địa bàn tỉnh Thanh Hóa. Tính đến nay, Công ty đã và đang vận hành 17 nhà máy nước có tổng công suất đạt 107.950m3/ngày đêm, cung cấp nước sạch cho 92,63% số hộ dân sinh sống trên địa bàn tỉnh. THN được chính thức giao dịch trên thị trường UPCOM từ tháng 10/2017.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-10-05","state":0.63622093,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Uỷ Ban Nhân Dân Tỉnh Thanh Hóa","p":null,"t":"CORPORATE","q":20992371,"pct":63.62,"d":"2026-08-17"},{"n":"Phạm Văn Tú","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":6883500,"pct":20.862,"d":"2026-08-17"},{"n":"Nguyễn Huy Nhắn","p":null,"t":"INDIVIDUAL","q":1059000,"pct":3.209,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Cần","p":null,"t":"INDIVIDUAL","q":107900,"pct":0.327,"d":"2025-10-05"},{"n":"Nguyễn Huy Nam","p":null,"t":"INDIVIDUAL","q":106200,"pct":0.32,"d":"2025-10-05"},{"n":"Nguyễn Thị Nga","p":"Kế toán trưởng","t":"INDIVIDUAL","q":66900,"pct":0.2,"d":"2026-08-19"},{"n":"Lê Sỹ Len","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":57400,"pct":0.174,"d":"2026-08-17"},{"n":"Dương Văn Hóa","p":null,"t":"INDIVIDUAL","q":56200,"pct":0.17,"d":"2026-03-03"},{"n":"Lê Văn Sơn","p":null,"t":"INDIVIDUAL","q":57700,"pct":0.17,"d":"2025-10-05"},{"n":"Nguyễn Huy Trường","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":18000,"pct":0.055,"d":"2026-08-19"},{"n":"Nguyễn Văn Tân","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":10000,"pct":0.03,"d":"2026-08-17"},{"n":"Lê Thị Hà","p":null,"t":"INDIVIDUAL","q":7700,"pct":0.023,"d":"2025-10-05"},{"n":"Nguyễn Thế Dũng","p":null,"t":"INDIVIDUAL","q":7600,"pct":0.023,"d":"2025-10-05"},{"n":"Lê Văn Quý","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7400,"pct":0.02,"d":"2026-08-04"},{"n":"Trịnh Thị Huyền","p":"Thành viên Ban kiểm soát","t":"INDIVID