",12.26],["2019",12.226],["2020",0.0],["2021",10.787],["2022",11.052],["2023",6.833],["2024",10.145],["2025",9.786]]}},"co":{"short":"Vận tải và DV Petrolimex Hà Tây","profile":"Công ty Cổ phần Vận tải và Dịch vụ Petrolimex Hà Tây (PTH) là công ty thành viên của Petrolimex Việt Nam được thành lập năm 2000. Hoạt động kinh doanh chính của công ty bao gồm: kinh doanh vận tải xăng dầu và kinh doanh xăng dầu, dầu mỡ nhờn. Công ty chịu trách nhiệm vận chuyển xăng dầu cho các đơn vị thành viên của Petrolimex Việt Nam tại đìa bàn Hà Tây cũ, Hòa Bình và Sơn La. Công ty có trên 70 đầu xe tương đương 1.200 m3 phương tiện và năng lực đạt tới 50 triệu m3 km/năm. Ngoài ra, công ty có 22 cửa hàng xăng dầu và hệ thống đại lý tại các tỉnh miền Bắc.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2010-03-23","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Xăng dầu Việt Nam","p":null,"t":"CORPORATE","q":1786713,"pct":51.0,"d":"2026-08-13"},{"n":"Bùi Trung Định","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":173523,"pct":4.953,"d":"2026-08-13"},{"n":"Đào Văn Chiện","p":null,"t":"INDIVIDUAL","q":60000,"pct":3.75,"d":"2015-09-14"},{"n":"Vũ Quang Tuấn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":125202,"pct":3.574,"d":"2026-08-13"},{"n":"Nguyễn Tiến Cường","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":115024,"pct":3.283,"d":"2026-08-13"},{"n":"Trần Mai Phương","p":null,"t":"INDIVIDUAL","q":115024,"pct":3.28,"d":"2026-08-13"},{"n":"Nguyễn Tử Bình","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":110147,"pct":3.144,"d":"2026-08-13"},{"n":"Lê Tự Cường","p":"Chủ tịch Hội đồng Quản trị/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":108743,"pct":3.104,"d":"2026-08-13"},{"n":"Trịnh Quang Khanh","p":null,"t":"INDIVIDUAL","q":37300,"pct":2.331,"d":"2015-09-14"},{"n":"Dương Tú Oanh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":61329,"pct":1.751,"d"