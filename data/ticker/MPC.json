chuẩn Global Gap. MPC là doanh nghiệp xuất khẩu thủy sản có kim ngạch xuất khẩu lớn nhất trong tất cả các doanh nghiệp xuất khẩu thủy sản của Việt Nam. Từ năm những năm 2000, Công ty đã vươn lên đứng và giữ vững vị trí này trong nhiều năm. MPC được giao dịch trên thị trường UPCOM từ tháng 10/2017.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-10-16","state":0.0,"foreign":0.39712358,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Mpm Investments Pte., Ltd.","p":null,"t":"CORPORATE","q":140400000,"pct":35.004,"d":"2026-08-04"},{"n":"Chu Thị Bình","p":"Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":70371660,"pct":17.545,"d":"2026-07-29"},{"n":"Lê Văn Quang","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":64478900,"pct":16.076,"d":"2026-07-29"},{"n":"Công ty Cổ Phần Đầu Tư Long Phụng","p":null,"t":"CORPORATE","q":16354620,"pct":4.09,"d":"2026-07-29"},{"n":"Lê Thị Dịu Minh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":13131740,"pct":3.274,"d":"2026-07-29"},{"n":"Lê Thị Minh Phú","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":11047036,"pct":2.754,"d":"2026-07-29"},{"n":"Lê Thị Minh Ngọc","p":null,"t":"INDIVIDUAL","q":11032634,"pct":2.751,"d":"2026-07-29"},{"n":"Lê Thị Minh Quí","p":null,"t":"INDIVIDUAL","q":11033534,"pct":2.751,"d":"2026-07-29"},{"n":"Nguyễn Thị Thu Huyền","p":null,"t":"INDIVIDUAL","q":885700,"pct":0.221,"d":"2026-07-29"},{"n":"Chu Văn An","p":null,"t":"INDIVIDUAL","q":420320,"pct":0.105,"d":"2025-10-05"},{"n":"Chu Hồng Hà","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":319140,"pct":0.08,"d":"2026-07-08"},{"n":"Bùi Anh Dũng","p":null,"t":"INDIVIDUAL","q":291640,"pct":0.073,"d":"2025-10-05"},{"n":"Lê Ngọc Anh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":264380,"pct":0.066,"d":"2026-07-29"},{"n":"Nguyễn Văn Di","p":null,"t":"INDIVIDUAL","q":244840,"pct":0.061,"d":"2025-10-05"},{"n":"Thái Hoàng Hùng","p":null,"t":"INDIVIDUAL","q":241064,"pct"