ừa, kho cảng An Sơn (50ha). Bên cạnh đó, Tổng Công ty đã xây dựng được mạng lưới phân phối với 900 cửa hàng và đại lý, trong đó bao gồm 200 của hàng đại lý nằm ở 09 tỉnh phía Bắc và 700 cửa hàng đại lý nằm tại 13 tỉnh thành phía Nam. TLP được giao dịch trên thị trường UPCOM từ cuối năm 2017.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2017-12-08","state":0.36,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Bình Dương","p":null,"t":"CORPORATE","q":85176000,"pct":36.0,"d":"2026-08-05"},{"n":"Lê Trọng Hiếu","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":11724000,"pct":4.96,"d":"2026-08-05"},{"n":"Công ty TNHH Thương Mại Dịch Vụ Thiết Bị Hướng Dương","p":null,"t":"CORPORATE","q":6700000,"pct":2.83,"d":"2025-10-05"},{"n":"Nguyễn Viết Trọng Nhân","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6706700,"pct":2.83,"d":"2026-08-05"},{"n":"Bùi Kim Nga","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7100,"pct":0.003,"d":"2026-08-05"},{"n":"Phạm Thị Kim Thành","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7100,"pct":0.003,"d":"2026-08-05"},{"n":"Trần Tấn Tới","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5900,"pct":0.003,"d":"2026-08-05"},{"n":"Huỳnh Xuân Phương","p":null,"t":"INDIVIDUAL","q":4100,"pct":0.002,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Quỳnh Giao","p":"Kế toán trưởng","t":"INDIVIDUAL","q":5800,"pct":0.002,"d":"2026-08-05"},{"n":"Đặng Văn Đoàn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3600,"pct":0.002,"d":"2026-08-05"},{"n":"Nguyễn Thúy Hằng","p":null,"t":"INDIVIDUAL","q":1700,"pct":0.001,"d":"2025-10-05"},{"n":"Nguyễn Thị Khánh Hà","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.001,"d":"2026-08-05"},{"n":"Phạm Thị Băng Trang","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3200,"pct":0.001,"d":"2026-08-05"},{"n":"Trần Đình Giáp","p":null,"t":"INDIVIDUAL","q":2100,"pct":0.001,"d":"2025-10-05"},{"n":"Đoàn Minh Q