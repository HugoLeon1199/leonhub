máy xi măng Tuyên Quang, Sông Đà, Yaly, Hạ Long, Thép Việt - Ý... Ngày 25/12/2006, SDC chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-12-25","state":0.51010952,"foreign":0.02978278,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Sông Đà","p":null,"t":"CORPORATE","q":1331100,"pct":51.006,"d":"2026-08-07"},{"n":"Phạm Anh Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":647468,"pct":24.81,"d":"2026-08-07"},{"n":"Đinh Thị Nở","p":null,"t":"INDIVIDUAL","q":14565,"pct":0.558,"d":"2015-09-14"},{"n":"Phạm Văn Hùng","p":null,"t":"INDIVIDUAL","q":8743,"pct":0.335,"d":"2015-09-14"},{"n":"Bùi Kim Khánh","p":null,"t":"INDIVIDUAL","q":2909,"pct":0.11,"d":"2025-10-05"},{"n":"Bùi Thị Kim Khánh","p":null,"t":"INDIVIDUAL","q":2909,"pct":0.11,"d":"2021-09-13"},{"n":"Nguyễn Thị Mỹ Hương","p":null,"t":"INDIVIDUAL","q":2466,"pct":0.09,"d":"2026-08-07"},{"n":"Nguyễn Đại Thụ","p":null,"t":"INDIVIDUAL","q":2209,"pct":0.085,"d":"2015-09-14"},{"n":"Nguyễn Thị Lợi","p":null,"t":"INDIVIDUAL","q":480,"pct":0.018,"d":"2015-09-14"},{"n":"Lê Thị Thiên Kim","p":null,"t":"INDIVIDUAL","q":51,"pct":0.002,"d":"2025-10-05"},{"n":"Phạm Quang Tuyên","p":null,"t":"INDIVIDUAL","q":51,"pct":0.002,"d":"2025-10-05"}],"rel":[{"c":"SDRURAL","n":"Công ty Cổ Phần Phát Triển Đô Thị Và Nông Thôn Sông Đà","t":"subsidiary","pct":73.48}],"rel_count":1,"events":[{"c":"AIS","t":"SDC - Niêm yết bổ sung 417.240 cổ phiếu","d":"2026-08-17","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Cổ phiếu thưởng tỉ lệ 16.0%","d":"2026-06-09","record":"2026-06-30","ex":"2026-06-29"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 500 VND","d":"2026-06-09","record":"2026-06-30","ex":"2026-06-29"},{"c":"AGME","t":"SDC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-01-26","record":"2026-03-20","ex":"2026-03-19"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 500 VND",