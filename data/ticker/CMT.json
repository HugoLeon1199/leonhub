 thông tin, viễn thông cho các nhà cung cấp dịch vụ và các doanh nghiệp. Công ty là đại lý bán hàng, nhà phân phối của các nhà cung cấp lớn như Rad Data Communication, Radvision, Radware, Rittech, Patton Electronics, MRV, Optibase, Tadiran Telecom, Zhone... và là nhà cung cấp độc quyền các thiết bị hội nghị truyền hình ở Việt Nam. Hai đối thủ cạnh tranh lớn nhất của công ty là Công ty ứng dụng kỹ thuật và sản xuất - Bộ Quốc phòng và Công ty CP hệ thống thông tin FPT. Ngày 24/04/2019, CMT chính thức giao dịch trên thị trường UPCOM.","sector":"Công nghệ Thông tin","type":"CT","listed":"2010-03-11","state":0.0,"foreign":0.0337085,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Ngọc Tú","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2775580,"pct":34.7,"d":"2025-10-05"},{"n":"Trần Thanh Hải","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1440000,"pct":18.0,"d":"2025-10-05"},{"n":"Lê Thành Trung","p":null,"t":"INDIVIDUAL","q":493430,"pct":6.775,"d":"2015-09-14"},{"n":"AFC Vietnam Fund","p":null,"t":"CORPORATE","q":330820,"pct":4.55,"d":"2025-10-05"},{"n":"Nguyễn Đức Thuận","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":65000,"pct":0.81,"d":"2026-08-19"},{"n":"Phạm Ngọc Sơn","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":59500,"pct":0.74,"d":"2026-08-19"},{"n":"Chu Thị Hiền","p":null,"t":"INDIVIDUAL","q":8500,"pct":0.117,"d":"2015-09-14"},{"n":"Trần Thị Mai Lan","p":null,"t":"INDIVIDUAL","q":7520,"pct":0.094,"d":"2025-10-05"},{"n":"Lê Thị Kiều Dung","p":null,"t":"INDIVIDUAL","q":5630,"pct":0.07,"d":"2025-10-05"},{"n":"Nguyễn Khánh Ly","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":5630,"pct":0.07,"d":"2025-10-05"},{"n":"Lê Bá Hoàng Quang","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.069,"d":"2015-09-14"},{"n":"Phạm Tiến Lộc","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.025,"d":"2025-10-05"}],"rel":[{"c":"IFNS","n":"Công Ty TNHH Công Nghệ Mạng Và Truyền Thông Sài Gòn","t