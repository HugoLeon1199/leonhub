, khu biệt thự DETACO Phú Quốc, cụm cao ốc và khu trung tâm thương mại DETACO Tân Phú. DTA được niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2010.","sector":"Bất động sản","type":"CT","listed":"2010-07-16","state":0.0,"foreign":0.00154877,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phạm Thị Kim Xuân","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1817496,"pct":10.06,"d":"2026-03-04"},{"n":"Phan Thị Xuân Đào","p":null,"t":"INDIVIDUAL","q":906248,"pct":5.018,"d":"2026-06-15"},{"n":"Bùi Đĩnh Mẫn","p":null,"t":"INDIVIDUAL","q":876500,"pct":4.85,"d":"2025-10-05"},{"n":"Nguyễn Chí Thành","p":null,"t":"INDIVIDUAL","q":875200,"pct":4.846,"d":"2025-10-05"},{"n":"Phạm Thị Bình","p":null,"t":"INDIVIDUAL","q":860000,"pct":4.76,"d":"2025-10-05"},{"n":"Nguyễn Hồng Mai","p":null,"t":"INDIVIDUAL","q":724500,"pct":4.01,"d":"2025-10-05"},{"n":"Kiều Thị Thái Hà","p":null,"t":"INDIVIDUAL","q":606956,"pct":3.361,"d":"2025-10-05"},{"n":"Trần Đức Lợi","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":544386,"pct":3.01,"d":"2026-03-04"},{"n":"Nguyễn Thị Hiếu Thiện","p":null,"t":"INDIVIDUAL","q":88326,"pct":0.489,"d":"2025-10-05"},{"n":"Vũ Thị Thanh Vân","p":null,"t":"INDIVIDUAL","q":63944,"pct":0.35,"d":"2025-10-05"},{"n":"Chung Minh Quang","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.1,"d":"2015-09-14"},{"n":"Đào Đình Năng","p":null,"t":"INDIVIDUAL","q":9460,"pct":0.095,"d":"2015-09-14"},{"n":"Trần Văn Hùng","p":null,"t":"INDIVIDUAL","q":7350,"pct":0.04,"d":"2025-10-05"},{"n":"Trần Thị Hảo","p":null,"t":"INDIVIDUAL","q":5396,"pct":0.03,"d":"2025-10-05"},{"n":"Hoàng Thị Thu Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":4094,"pct":0.02,"d":"2026-03-04"}],"events":[{"c":"DDIND","t":"Phan Thị Xuân Đào - Đăng kí Mua DTA","d":"2026-06-12","record":null,"ex":null},{"c":"DDIND","t":"Phan Thị Xuân Đào - Đăng kí Mua DTA","d":"2026-06-03","record":null,"ex":null},{"c":"AIS","t":"DTA - Niêm yế