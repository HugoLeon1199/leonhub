 Luyện kim mầu Bắc Thái trực thuộc Bộ Cơ khí Luyện kim, được thành lập vào năm 1979. Công ty chính thức hoạt động theo mô hình công ty cổ phần từ tháng 07/2014. TMG hoạt động chính trong lĩnh vực khai thác và chế biến quặng kẽm. Công ty hiện đang quản lý và khai thác Mỏ kẽm chì Chợ Điền. TMG đã xây dựng quy trình sản xuất khép kín từ khâu khai thác đến khâu chế biến ra thành phẩm là kẽm thỏi chất lượng 99,95%-99,99% Zn, bột oxit kẽm 90% Zn0 và tinh quặng chì 50%Pb. TMG được giao dịch trên thị trường UPCOM từ tháng 02/2017.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2017-02-07","state":0.51,"foreign":0.00011133,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần","p":null,"t":"CORPORATE","q":9180000,"pct":51.0,"d":"2026-07-29"},{"n":"Công ty CP Lương Gia","p":null,"t":"CORPORATE","q":3148900,"pct":17.494,"d":"2026-07-29"},{"n":"Nguyễn Hoàng Cường","p":null,"t":"INDIVIDUAL","q":1965600,"pct":10.92,"d":"2026-07-29"},{"n":"Công ty TNHH Thương Mại Và Sản Xuất Vũ Hoàng","p":null,"t":"CORPORATE","q":1933900,"pct":10.744,"d":"2026-07-29"},{"n":"Trần Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":1253500,"pct":6.96,"d":"2026-07-29"},{"n":"Hoàng Thị Soi","p":null,"t":"INDIVIDUAL","q":808200,"pct":4.49,"d":"2026-06-22"},{"n":"Nguyễn Văn Định","p":null,"t":"INDIVIDUAL","q":3400,"pct":0.019,"d":"2025-10-05"},{"n":"Nguyễn Văn Khanh","p":null,"t":"INDIVIDUAL","q":2800,"pct":0.016,"d":"2025-10-05"}],"rel":[{"c":"VIETTHAIZINC","n":"Công ty Liên Doanh Công Nghiệp Kẽm Việt Thái","t":"affiliate","pct":40.0}],"rel_count":1,"events":[{"c":"DDIND","t":"Hoàng Thị Soi - Đăng kí Bán TMG","d":"2026-06-22","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2025 - 3,500 VND","d":"2026-05-27","record":"2026-06-05","ex":"2026-06-04"},{"c":"DDRP","t":"Trần Thị Thu Hà - Đăng kí Mua 800,000 TMG","d":"2026-05-21","record":null,"ex":null},{"c":"AGME","t":"TMG - Tổ chức ĐHĐCĐ thường niên 2026","d":"