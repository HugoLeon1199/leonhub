p vào năm 1957. Ngân hàng hoạt động trong lĩnh vực huy động và kinh doanh vốn, và cung cấp các dịch vụ tài chính liên quan. BIDV chính thức hoạt động theo hình thức ngân hàng thương mại cổ phần từ năm 2012. BIDV được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2014. Kết thúc năm 2025, BIDV tiếp tục giữ vững vị thế là ngân hàng thương mại cổ phần có quy mô lớn nhất Việt Nam với tổng tài sản riêng khối ngân hàng thương mại đạt 3.3 triệu tỷ đồng. Năm 2025, so với cùng kỳ, biên lãi thuần (NIM) ở mức 2.11%, giảm 0.21%. Tỷ lệ nợ xấu ở mức 1.47%, tăng 0.06%. Tỷ lệ bao phủ nợ xấu ở mức 99.91%, giảm 31.1%. Lợi nhuận sau thuế công ty mẹ có giá trị bằng 29,9 nghìn tỷ đồng, tăng 18.95%. Tỷ suất lợi nhuận trên vốn chủ sở hữu (ROE) ở mức 19.44%, giảm 0.08%.","sector":"Ngân hàng","type":"NH","listed":"2014-01-24","state":0.76732198,"foreign":0.17481621,"rating":"BUY","target":50500.0,"rating_as_of":"2026-05-21","source":"Vietcap"},"owners":[{"n":"Ngân Hàng Nhà Nước Việt Nam","p":null,"t":"CORPORATE","q":5968431365,"pct":76.73,"d":"2026-08-26"},{"n":"KEB Hana Bank, Co., Ltd.","p":null,"t":"CORPORATE","q":1105431890,"pct":14.21,"d":"2026-08-26"},{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":137436902,"pct":1.767,"d":"2026-08-26"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":85662166,"pct":1.101,"d":"2026-08-26"},{"n":"Hanoi Investments Holdings Limited","p":null,"t":"CORPORATE","q":45650727,"pct":0.587,"d":"2026-08-26"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":21662479,"pct":0.279,"d":"2026-08-26"},{"n":"Công ty TNHH Bảo hiểm Nhân thọ Prudential Việt Nam","p":null,"t":"CORPORATE","q":19705642,"pct":0.253,"d":"2026-08-26"},{"n":"Công Đoàn Ngân Hàng TMCP Đầu Tư Và Phát Triển Việt Nam","p":null,"t":"CORPORATE","q":16116453,"pct":0.23,"d":"2025-12-10"},{"n":"Công ty TNHH Manulife (Việt Nam)","p":null,"t":"CORPORATE","q":15812808,"pct":0.203,"d":"2026-08