0,23 ha đất KĐT tại các tỉnh, thành ở cả ba miền và 235,23 ha đất phục vụ xây dựng nhà máy. Bên cạnh các dự án bất động sản khu công nghiệp, KBC cũng đầu tư phát triển và kinh doanh bất động sản khu đô thị, bất động sản nhà ở. KBC được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2009.","sector":"Bất động sản","type":"CT","listed":"2009-12-18","state":0.0,"foreign":0.06966797,"rating":"BUY","target":34600.0,"rating_as_of":"2026-08-20","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Phát Triển Xanh Bền Vững Châu Á Thái Bình Dương","p":null,"t":"CORPORATE","q":96550000,"pct":10.252,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Tư Vấn Và Đầu Tư Kinh Bắc","p":null,"t":"CORPORATE","q":65275489,"pct":8.5,"d":"2025-10-05"},{"n":"Đặng Thanh Tâm","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":52116665,"pct":5.53,"d":"2026-07-31"},{"n":"Quỹ Đầu Tư Hạ Tầng PVI","p":null,"t":"CORPORATE","q":50000000,"pct":5.31,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư Vinatex - Tân Tạo","p":null,"t":"CORPORATE","q":49239852,"pct":5.229,"d":"2026-07-22"},{"n":"Phạm Thị Lê","p":null,"t":"INDIVIDUAL","q":19551095,"pct":4.94,"d":"2016-11-07"},{"n":"Công ty Cổ phần Chứng khoán VPBank","p":null,"t":"CORPORATE","q":44993700,"pct":4.778,"d":"2026-07-03"},{"n":"Quách Thị Nga","p":null,"t":"INDIVIDUAL","q":15006155,"pct":3.79,"d":"2016-11-07"},{"n":"Công ty Cổ phần Đầu tư Sài Gòn VRG","p":null,"t":"CORPORATE","q":16875000,"pct":3.547,"d":"2015-06-15"},{"n":"Sầm Thị Hường","p":null,"t":"INDIVIDUAL","q":10350000,"pct":2.62,"d":"2016-11-07"},{"n":"Nguyễn Thị Kim Thanh","p":null,"t":"INDIVIDUAL","q":8390266,"pct":2.307,"d":"2026-07-31"},{"n":"Beira Limited","p":null,"t":"CORPORATE","q":10500000,"pct":2.24,"d":"2016-09-23"},{"n":"CTBC Vietnam Equity Fund","p":null,"t":"CORPORATE","q":17000000,"pct":2.215,"d":"2025-10-05"},{"n":"Deutsche Bank Aktiengesellchaft, London Branch","p":null,"t":"CORPORATE","q":9868040,"pct":2.11,"d":"2016-09-26"},{"n":"Công ty Cổ 