ly tâm dự ứng lực mang thương hiệu FECON Pile có đường kính lớn nhất miền Bắc từ 300mm đến 1.200mm với 2 dây chuyền sản xuất đạt 4.000m dài/ngày. Sản phẩm FECON Pile hiện đang chiếm khoảng 30% thị phần cung cấp cọc của toàn thị trường miền Bắc. Các sản phẩm của Công ty đã được ứng dụng ở nhiều công trình lớn cấp quốc gia như Nhà máy lọc dầu Dung Quất, nhà máy Khí điện đạm Cà Mau, nhà máy khi điện Nhơn Trạch 1, Khu đô thị Phú Mỹ Hưng, hệ thống siêu thị Metro trên toàn quốc và các cảng Cái Lân, Hải Phòng, Tiên Sa, Sài Gòn.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2013-05-15","state":0.0,"foreign":0.03269187,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Đầu tư Phan Vũ","p":null,"t":"CORPORATE","q":23575579,"pct":51.0,"d":"2026-02-27"},{"n":"Nguyễn Văn Hiệp","p":null,"t":"INDIVIDUAL","q":1500000,"pct":3.65,"d":"2025-10-05"},{"n":"Phạm Trung Thành","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":31006,"pct":0.07,"d":"2026-08-12"},{"n":"Hà Thế Lộng","p":null,"t":"INDIVIDUAL","q":25000,"pct":0.06,"d":"2021-02-23"},{"n":"Hà Thế Phương","p":null,"t":"INDIVIDUAL","q":25000,"pct":0.06,"d":"2025-10-05"},{"n":"Lê Quang Trung","p":null,"t":"INDIVIDUAL","q":12000,"pct":0.03,"d":"2025-10-05"},{"n":"Phùng Tiến Trung","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.024,"d":"2015-09-14"}],"rel":[{"c":"11043","n":"Công ty Cổ phần Bê Tông Thái Hà","t":"subsidiary","pct":99.96}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2025 - 100 VND","d":"2026-07-30","record":"2026-08-07","ex":"2026-08-06"},{"c":"AGME","t":"FCM - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-05","record":"2026-03-24","ex":"2026-03-23"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2025 - 150 VND","d":"2026-02-03","record":"2026-02-10","ex":"2026-02-09"},{"c":"OTHE","t":"FCM - Thay đổi địa chỉ","d":"2026-01-06","record":null,"ex":null},{"c":"AGME","t":"FCM - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-07","record":"