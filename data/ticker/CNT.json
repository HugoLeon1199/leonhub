àng Mai, Phúc Sơn, Công ty Thép Miền Nam (SSC), Pomina, Vinakyoei, Việt Úc, Việt Ý, Thiết bị vệ sinh Inax, Máy điều hòa không khí và bồn tắm Nikko Kendo. Ngoài ra, Công ty còn có Nhà máy sản xuất sản phẩm bê tông cốt thép dự ứng lực liên doanh với PS.Mitshubisi (Nhật bản). CNT được giao dịch trên thị trường UPCOM từ tháng 03/2015.","sector":"Bất động sản","type":"CT","listed":"2008-07-28","state":0.0,"foreign":0.00151997,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Hồng Mã","p":null,"t":"CORPORATE","q":57762963,"pct":88.124,"d":"2026-07-09"},{"n":"Phạm Quốc Khánh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1086294,"pct":1.659,"d":"2026-02-24"},{"n":"Đỗ Thị Ngọc Bình","p":null,"t":"INDIVIDUAL","q":112150,"pct":1.131,"d":"2015-09-14"},{"n":"Phạm Anh Tuấn","p":null,"t":"INDIVIDUAL","q":74450,"pct":0.751,"d":"2015-09-14"},{"n":"Nguyễn Thị Minh Hường","p":null,"t":"INDIVIDUAL","q":57800,"pct":0.583,"d":"2015-09-14"},{"n":"Đỗ Minh Đức","p":null,"t":"INDIVIDUAL","q":36000,"pct":0.363,"d":"2015-09-14"},{"n":"Nguyễn Phúc Huy","p":null,"t":"INDIVIDUAL","q":28670,"pct":0.289,"d":"2015-09-14"},{"n":"Trần Công Quốc Bảo","p":null,"t":"INDIVIDUAL","q":25610,"pct":0.258,"d":"2015-09-14"},{"n":"Hoàng Ngọc Minh","p":null,"t":"INDIVIDUAL","q":22012,"pct":0.222,"d":"2015-09-14"},{"n":"Đỗ Đức Minh","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.202,"d":"2015-09-14"},{"n":"Nguyễn Thị Minh Thịnh","p":null,"t":"INDIVIDUAL","q":17310,"pct":0.175,"d":"2015-09-14"},{"n":"Hoàng Anh Tuấn","p":null,"t":"INDIVIDUAL","q":5330,"pct":0.054,"d":"2015-09-14"},{"n":"Võ Ngọc Thảo","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.025,"d":"2015-09-14"},{"n":"Lê Viết Nam","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":13200,"pct":0.02,"d":"2026-02-24"},{"n":"Lê Thanh Tùng","p":null,"t":"INDIVIDUAL","q":700,"pct":0.007,"d":"2015-09-14"},{"n":"Nguyễn Sơn Nam","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":2000,"pct":0.003,"d":"2026-01-28"}],"rel":[{"c":"170205