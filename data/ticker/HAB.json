ng cấp, lắp đặt các công cụ hỗ trợ giảng dạy, cơ sở vật chất của các trường học trên địa bàn thành phố Hà Nội.","sector":"Truyền thông","type":"CT","listed":"2018-01-05","state":0.06265,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đỗ Ngọc Khanh","p":null,"t":"INDIVIDUAL","q":620950,"pct":31.05,"d":"2020-05-07"},{"n":"Công ty Cổ phần Tập đoàn T&T","p":null,"t":"CORPORATE","q":570950,"pct":28.55,"d":"2025-10-05"},{"n":"Đỗ Ngọc Bính","p":null,"t":"INDIVIDUAL","q":375903,"pct":18.85,"d":"2021-06-25"},{"n":"Nguyễn Thị Hải","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.13,"d":"2018-01-04"},{"n":"Vũ Xuân Dương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":13900,"pct":0.12,"d":"2021-12-16"},{"n":"Đỗ Vinh Quang","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":7000,"pct":0.06,"d":"2021-12-16"},{"n":"Đỗ Lan Anh","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.05,"d":"2018-01-04"},{"n":"Nguyễn Diệu Trinh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5000,"pct":0.04,"d":"2021-12-16"},{"n":"Phạm Thị Minh Huyền","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":5000,"pct":0.04,"d":"2021-12-16"},{"n":"Phạm Văn Thịnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5000,"pct":0.04,"d":"2021-12-16"},{"n":"Lê Quốc Bảo","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":3700,"pct":0.03,"d":"2021-12-16"},{"n":"Nguyễn Hải Đăng","p":"Kế toán trưởng","t":"INDIVIDUAL","q":2800,"pct":0.02,"d":"2021-12-16"},{"n":"Đỗ Quang Thịnh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2900,"pct":0.02,"d":"2021-12-16"},{"n":"Vũ Huy Thành","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":200,"pct":0.01,"d":"2020-05-07"}],"events":[{"c":"SUSP","t":"HAB - Hủy đăng ký giao dịch trên sàn UPCoM","d":"2022-03-22","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Hải Đăng - Đăng kí Mua 5,500 HAB","d":"2021-12-16","record":null,"ex":null},{"c":"DDIND","t":"Phạm Thị Minh Huyền - Đăng kí Mua 5,000