 sáng. Công ty đã thực hiện lắp đặt hàng chục công trình về đường ống và bể chứa cho các khách hàng lớn như Vietsopetro, Tổng Công ty Dầu khí Việt Nam, Tổng Công ty Khí, Công ty BP (Anh). Ngày 15/06/2010, PXT chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE)","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-15","state":0.51,"foreign":0.02936295,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xây lắp Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":10200000,"pct":51.0,"d":"2026-08-12"},{"n":"Lê Phong Hiếu","p":null,"t":"INDIVIDUAL","q":992180,"pct":4.961,"d":"2015-09-14"},{"n":"Nguyễn Văn Hương","p":null,"t":"INDIVIDUAL","q":41000,"pct":0.21,"d":"2025-10-05"},{"n":"Nguyễn Hữu Đức","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.1,"d":"2015-09-14"},{"n":"Đỗ Đắc Thọ","p":null,"t":"INDIVIDUAL","q":17244,"pct":0.086,"d":"2015-09-14"},{"n":"Đỗ Văn Cường","p":null,"t":"INDIVIDUAL","q":16000,"pct":0.08,"d":"2015-09-14"},{"n":"Nguyễn Thị Việt","p":null,"t":"INDIVIDUAL","q":14830,"pct":0.07,"d":"2025-10-05"},{"n":"Hoàng Ngọc Tuyên","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.05,"d":"2015-09-14"},{"n":"Tô Xuân Mai","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.05,"d":"2015-09-14"},{"n":"Bùi Thức Quý","p":null,"t":"INDIVIDUAL","q":6480,"pct":0.032,"d":"2025-10-05"},{"n":"Phạm Quốc Trung","p":null,"t":"INDIVIDUAL","q":5700,"pct":0.028,"d":"2025-10-05"},{"n":"Nguyễn Văn Hạnh","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.025,"d":"2015-09-14"},{"n":"Nguyễn Văn Bình","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.01,"d":"2015-09-14"},{"n":"Đỗ Quang Hiền","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.005,"d":"2015-09-14"},{"n":"Vũ Thị Châm","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":2000,"pct":0.001,"d":"2026-08-12"}],"events":[{"c":"OTHE","t":"PXT - Thay đổi địa chỉ","d":"2026-05-21","record":null,"ex":null},{"c":"AGME","t":"PXT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-25","record":"202