 án Khách sạn Lam Kinh (Thanh Hóa) và một số dự án khác. Các đối tác lớn của Công ty bao gồm Tổng Công ty Dầu Việt Nam - PVOil; PVFC, Công ty TNHH Cushman & Wakefiled (Mỹ) và CTCP Thương mại và Vận tải Sông Đà. Năm 2010, PFL chính thức được giao dịch tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-11-17","state":0.3486695,"foreign":0.001892,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xây lắp Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":17433475,"pct":34.867,"d":"2026-08-19"},{"n":"Công ty Cổ phần Địa ốc Phú Long","p":null,"t":"CORPORATE","q":3396000,"pct":6.79,"d":"2026-08-19"},{"n":"Công ty Cổ phần Tập Đoàn Đầu Tư Tiến Lộc","p":null,"t":"CORPORATE","q":2500000,"pct":5.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu Tư Song Kim","p":null,"t":"CORPORATE","q":2500000,"pct":5.0,"d":"2025-10-05"},{"n":"Lương Ngọc Lân","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.04,"d":"2015-09-14"},{"n":"Hoàng Hữu Tâm","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.02,"d":"2025-10-05"},{"n":"Nguyễn Công Thành","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.004,"d":"2015-09-14"},{"n":"Phạm Tiến Đạt","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.002,"d":"2025-10-05"},{"n":"Trần Trung Kiên","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.002,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"PFL - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-01","record":"2026-04-08","ex":"2026-04-07"},{"c":"AGME","t":"PFL - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-07","record":"2025-03-26","ex":"2025-03-25"},{"c":"AGME","t":"PFL - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-08","record":"2024-03-26","ex":"2024-03-25"},{"c":"AGME","t":"PFL - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-03-15","record":"2023-03-27","ex":"2023-03-24"},{"c":"AGME","t":"PFL - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-16","record":"2022-03-28","ex":"2022-03-25"},{"c":"DDINS","t":"Công ty Cổ phần Tập Đoàn Đầu Tư Tiến Lộc - Đăng k