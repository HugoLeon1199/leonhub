ề cơ sở chế biến, Công ty sở hữu 01 nhà máy chế biến mủ tờ RSS công suất 1.000 tấn/năm và 01 nhà máy mủ cốm SVR công suất 2.500 tấn/năm. TNC chính thức niêm yết trên Sở Giao dịch Chứng khoán TP. Hồ Chí Minh (HOSE) vào ngày 22/08/2007.","sector":"Hóa chất","type":"CT","listed":"2007-08-22","state":0.51,"foreign":0.00550971,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Uỷ Ban Nhân Dân Thành Phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":9817500,"pct":51.0,"d":"2026-07-28"},{"n":"Ủy Ban Nhân Dân Tỉnh Bà Rịa - Vũng Tàu","p":null,"t":"CORPORATE","q":9817500,"pct":51.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Khu công nghiệp Hố Nai","p":null,"t":"CORPORATE","q":4410460,"pct":22.91,"d":"2026-03-11"},{"n":"Công ty Cổ Phần Đầu Tư New Asia","p":null,"t":"CORPORATE","q":2282220,"pct":11.86,"d":"2025-10-05"},{"n":"Vietnam Dragon Fund Limited","p":null,"t":"CORPORATE","q":963230,"pct":5.004,"d":"2015-06-15"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":913010,"pct":4.743,"d":"2015-06-15"},{"n":"Phan Văn Tiến","p":null,"t":"INDIVIDUAL","q":694300,"pct":3.6,"d":"2025-10-05"},{"n":"Phạm Anh Sơn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":211300,"pct":1.1,"d":"2026-07-28"},{"n":"Đỗ Khắc Tùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":100000,"pct":0.52,"d":"2026-07-28"},{"n":"Công ty TNHH Đầu Tư Và Thương Mại Thiên Hải","p":null,"t":"CORPORATE","q":68650,"pct":0.36,"d":"2025-10-05"},{"n":"Lê Văn Lợi","p":null,"t":"INDIVIDUAL","q":30830,"pct":0.16,"d":"2015-09-14"},{"n":"Lê Như Sinh","p":null,"t":"INDIVIDUAL","q":2800,"pct":0.015,"d":"2015-09-14"},{"n":"Nguyễn Hữu Mạnh Nhường","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1200,"pct":0.006,"d":"2026-07-28"},{"n":"Lê Cao Thương","p":null,"t":"INDIVIDUAL","q":300,"pct":0.002,"d":"2015-09-14"},{"n":"Nguyễn Ngọc Tuấn","p":null,"t":"INDIVIDUAL","q":100,"pct":0.001,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"TNC - Tổ chức ĐHĐCĐ thường niên 2026","d":"