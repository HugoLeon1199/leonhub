g, quạt công nghiệp, quạt nhập khẩu và cung cấp các linh kiện cơ khí cho các Công ty sản xuất quạt điện trong nước. Hiện nay DHP hiện có 2 nhà máy sản xuất đều đặt tại Hải Phòng. Công ty đang sản xuất và kinh doanh thương mại trên 100 loại sản phẩm thuộc 3 nhóm sản phẩm chính là quạt điện các loại, lồng quạt các loại và vật tư, bán thành phẩm. DHP được niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2013.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2013-03-21","state":0.0316049,"foreign":0.00635258,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Hoàng Thanh Hải","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2614181,"pct":27.54,"d":"2026-03-03"},{"n":"Nguyễn Thu Hà","p":null,"t":"INDIVIDUAL","q":2006580,"pct":21.139,"d":"2026-03-03"},{"n":"Nguyễn Quốc Tú","p":null,"t":"INDIVIDUAL","q":663850,"pct":6.99,"d":"2025-10-05"},{"n":"Trần Quang Hưng","p":null,"t":"INDIVIDUAL","q":605276,"pct":6.38,"d":"2025-10-05"},{"n":"Lê Trung Hiếu","p":null,"t":"INDIVIDUAL","q":474500,"pct":5.0,"d":"2026-03-03"},{"n":"Lê Thị Bích Huệ","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":352625,"pct":3.71,"d":"2026-03-03"},{"n":"Phan Quang Huy","p":null,"t":"INDIVIDUAL","q":300000,"pct":3.16,"d":"2026-03-03"},{"n":"Trần Văn Long","p":null,"t":"INDIVIDUAL","q":265369,"pct":2.79,"d":"2025-10-05"},{"n":"Nguyễn Hữu Thành","p":null,"t":"INDIVIDUAL","q":209776,"pct":2.21,"d":"2025-10-05"},{"n":"Mai Văn Minh","p":"Phó Chủ tịch Hội đồng Quản trị/Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":201394,"pct":2.12,"d":"2026-03-03"},{"n":"Dương Tạ Hòa Bình","p":null,"t":"INDIVIDUAL","q":132684,"pct":1.398,"d":"2026-03-03"},{"n":"Trịnh Thị Lan Phương","p":"Thành viên Hội đồng Quản trị/Kế toán trưởng","t":"INDIVIDUAL","q":120277,"pct":1.26,"d":"2026-03-03"},{"n":"Nguyễn Minh Chung","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":100009,"pct":1.05,"d":"2026-03-03"},{"n":"Trần Quốc Tuấn","p