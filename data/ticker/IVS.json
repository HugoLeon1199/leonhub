ay là: Công ty cổ phần Xây lắp điện I, Công ty cổ phần Cơ khí Xăng dầu (PMS), Công ty Cổ phần Licogi 19, tư vấn phát hành riêng lẻ cho Công ty Cổ phần Vĩnh Hòa... Năm 2025, Doanh thu nghiệp vụ môi giới chứng khoán có giá trị bằng 20,65 tỷ đồng, tăng 20.56% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 59.89%, tăng 5.8%. Lợi nhuận trước thuế có giá trị bằng 17,85 tỷ đồng, giảm 17.13%. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 1.34%, giảm 0.9%. IVS được trên Sở Giao dịch chứng Chứng khoán Hà Nội (HNX) từ năm 2011.","sector":"Dịch vụ tài chính","type":"CK","listed":"2011-08-01","state":0.0,"foreign":0.85976831,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Guotai Junan Securities (Hong Kong)","p":null,"t":"CORPORATE","q":70700000,"pct":67.38,"d":"2026-08-06"},{"n":"Pan Zhirong","p":null,"t":"INDIVIDUAL","q":3465900,"pct":5.0,"d":"2025-10-05"},{"n":"Lê Tăng Đức","p":null,"t":"INDIVIDUAL","q":800000,"pct":4.969,"d":"2015-09-14"},{"n":"Ngô Văn Bình","p":null,"t":"INDIVIDUAL","q":800000,"pct":4.969,"d":"2015-09-14"},{"n":"Công Ty TNHH Dazhong (việt Nam) International","p":null,"t":"CORPORATE","q":5108900,"pct":4.87,"d":"2026-02-12"},{"n":"Phạm Hữu Tuân","p":null,"t":"INDIVIDUAL","q":500000,"pct":3.106,"d":"2015-09-14"},{"n":"Đõ Thị Hồng","p":null,"t":"INDIVIDUAL","q":50000,"pct":0.311,"d":"2015-09-14"},{"n":"Nguyễn Thanh Tú","p":null,"t":"INDIVIDUAL","q":115800,"pct":0.17,"d":"2025-10-05"},{"n":"Phạm Thị Ánh Hồng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.062,"d":"2015-09-14"},{"n":"Lê Tất Thành","p":null,"t":"INDIVIDUAL","q":43200,"pct":0.06,"d":"2025-10-05"},{"n":"Đoàn Trung Dũng","p":null,"t":"INDIVIDUAL","q":8900,"pct":0.055,"d":"2015-09-14"},{"n":"Hoàng Thị Thanh Hoa","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.029,"d":"2026-02-12"},{"n":"Nguyễn Ngọc Mai","p":"Kế toán trưởng","t":"INDIVIDUAL","q":300,"pct":0.0,"d":"2026-08-06"},{"n":"Võ Thế Vinh","p":null,"t":"INDIVIDUAL","q":100,"pct":0.0,"d":"2025-10-05"}],"ev