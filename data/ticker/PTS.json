n dụng hút bùn trên 4.500m3/h. Ngày 01/12/2006, PTS chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-12-01","state":0.51,"foreign":0.07669361,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Vận Tải Thủy Petrolimex","p":null,"t":"CORPORATE","q":2839680,"pct":51.0,"d":"2026-08-24"},{"n":"Nguyễn Văn Hùng","p":null,"t":"INDIVIDUAL","q":95812,"pct":1.721,"d":"2015-09-14"},{"n":"Đào Thanh Liêm","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":20000,"pct":0.36,"d":"2026-08-24"},{"n":"Phạm Thị Ngọc Anh","p":null,"t":"INDIVIDUAL","q":19748,"pct":0.35,"d":"2026-05-04"},{"n":"Nguyễn Trọng Thủy","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":12456,"pct":0.2,"d":"2026-08-24"},{"n":"Nguyễn Ngọc Thạch","p":null,"t":"INDIVIDUAL","q":9920,"pct":0.178,"d":"2015-09-14"},{"n":"Đào Thị Tuyết","p":null,"t":"INDIVIDUAL","q":9310,"pct":0.167,"d":"2015-09-14"},{"n":"Nguyễn Minh Trường","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":5700,"pct":0.102,"d":"2026-08-24"},{"n":"Phạm Thị Thu Trang","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1080,"pct":0.002,"d":"2026-08-24"},{"n":"Đỗ Thị Thúy","p":"Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":475,"pct":0.001,"d":"2026-08-24"}],"rel":[{"c":"PTSHP","n":"Công ty TNHH Đóng Tàu Pts Hải Phòng","t":"subsidiary","pct":100.0}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 800 VND","d":"2026-05-13","record":"2026-06-08","ex":"2026-06-05"},{"c":"AGME","t":"PTS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-26","record":"2026-03-13","ex":"2026-03-12"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 500 VND","d":"2025-05-27","record":"2025-06-10","ex":"2025-06-09"},{"c":"AGME","t":"PTS - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-19","record":"2025-03-14","ex":"2025-03-13"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2023 