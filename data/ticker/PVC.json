o chứa dầu nổi được sản xuất bởi Scanjet Inc. Hệ thống bao gồm một hệ thống CIP (Cleaning in Place) có hiệu suất là 550m3/h, công suất làm sạch là 100.000m3/10h...Ngày 15/11/2007, PVC chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Dầu khí","type":"CT","listed":"2007-11-15","state":0.36001691,"foreign":0.0016737,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập Đoàn Công Nghiệp – Năng Lượng Quốc Gia Việt Nam","p":null,"t":"CORPORATE","q":29231380,"pct":36.0,"d":"2026-06-05"},{"n":"Nguyễn Hữu Phẩm","p":null,"t":"INDIVIDUAL","q":7405273,"pct":14.811,"d":"2015-09-14"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":2374000,"pct":5.0,"d":"2025-10-05"},{"n":"Hoàng Trọng Dũng","p":null,"t":"INDIVIDUAL","q":189000,"pct":0.38,"d":"2025-10-05"},{"n":"Bùi Tuấn Ngọc","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":30000,"pct":0.04,"d":"2025-10-05"},{"n":"Phạm Ngọc Khuê","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.04,"d":"2025-10-05"},{"n":"Dương Thị Mai Hoa","p":null,"t":"INDIVIDUAL","q":13940,"pct":0.028,"d":"2015-09-14"},{"n":"Trần Văn Trinh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":15000,"pct":0.02,"d":"2026-04-13"},{"n":"Chu Thị Hiền","p":null,"t":"INDIVIDUAL","q":8600,"pct":0.017,"d":"2015-09-14"},{"n":"Đinh Thị Thủy","p":null,"t":"INDIVIDUAL","q":5148,"pct":0.01,"d":"2015-09-14"},{"n":"Lều Minh Tiến","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.006,"d":"2015-09-14"},{"n":"Trịnh Thị Len","p":null,"t":"INDIVIDUAL","q":1506,"pct":0.003,"d":"2015-09-14"},{"n":"Phạm Minh Đức","p":null,"t":"INDIVIDUAL","q":69,"pct":0.0,"d":"2025-10-05"},{"n":"Đỗ Xuân Vịnh","p":null,"t":"INDIVIDUAL","q":60,"pct":0.0,"d":"2015-09-14"}],"rel":[{"c":"3502441229","n":"Công ty TNHH Dung Dịch Khoan Và Dịch Vụ Dầu Khí","t":"subsidiary","pct":100.0},{"c":"0110398224","n":"Công ty TNHH Dịch Vụ Kỹ Thuật Công Nghiệp PVCHEM","t":"subsidiary","pct":100.0},{"c":"0317824165","n":"Công ty TNHH PVCHEM - CS","t":"subsidi