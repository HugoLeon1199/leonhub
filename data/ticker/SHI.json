ản xuất, kinh doanh các sản phẩm gia dụng và công nghiệp như bồn nước inox, chậu rửa inox, ống thép không gỉ,... SHI có hệ thống phân phối với 30.000 nhà phân phối và điểm bán trải dài khắp các tỉnh thành, 120 chi nhánh cả trong và ngoài ngước. Các sản phẩm của công ty đã được xuất khẩu tới 50 quốc qua và vùng lãnh thổ trên thế giới như Mỹ, Canada, Bắc Âu,... SHI được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 12 năm 2009.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2009-12-30","state":0.0,"foreign":0.00266717,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Vĩnh Sơn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":18221882,"pct":10.7,"d":"2026-08-04"},{"n":"Công Ty TNHH Một Thành Viên Sản Xuất Đầu Tư Và Phát Triển Hoàng Hà","p":null,"t":"CORPORATE","q":13231424,"pct":7.77,"d":"2026-08-04"},{"n":"Nguyễn Thị Hoa","p":null,"t":"INDIVIDUAL","q":7919000,"pct":4.89,"d":"2025-10-05"},{"n":"Lê Phương Trang","p":null,"t":"INDIVIDUAL","q":7879125,"pct":4.87,"d":"2025-10-05"},{"n":"Công ty Cổ phần Đầu tư Chứng khoán Liên minh Việt Nam","p":null,"t":"CORPORATE","q":1736031,"pct":4.729,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán MB","p":null,"t":"CORPORATE","q":1121792,"pct":3.056,"d":"2015-06-15"},{"n":"Nguyễn Xuân Phú","p":null,"t":"INDIVIDUAL","q":1261252,"pct":2.336,"d":"2015-09-14"},{"n":"Lưu Thị Nhâm","p":null,"t":"INDIVIDUAL","q":1127816,"pct":2.089,"d":"2015-09-14"},{"n":"Nguyễn Thành Nhân","p":null,"t":"INDIVIDUAL","q":11200,"pct":0.021,"d":"2015-09-14"},{"n":"Phạm Phú Trường","p":null,"t":"INDIVIDUAL","q":5906,"pct":0.011,"d":"2015-09-14"},{"n":"Nguyễn Thị Lý","p":null,"t":"INDIVIDUAL","q":4365,"pct":0.008,"d":"2015-09-14"},{"n":"Nguyễn Thị Như Dung","p":null,"t":"INDIVIDUAL","q":2247,"pct":0.004,"d":"2015-09-14"},{"n":"Nguyễn Văn Tâm","p":null,"t":"INDIVIDUAL","q":2247,"pct":0.004,"d":"2015-09-14"},{"n":"Nguyễn Thị Việt Hà","p":null,"t":"INDIVIDUAL","q":1100,"pc