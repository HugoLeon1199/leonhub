Tư vấn Xây dựng công trình Hàng hải (TVH) có tiền thân là Đội khảo sát thiết kế trực thuộc Cục vận tải Đường biển được thành lập vào năm 1966. Công ty hoạt động chính trong lĩnh vực cung cấp dịch vụ tư vấn đầu tư xây dựng công trình cảng, đường thủy, giao thông, dân dụng, công nghiệp và hạ tầng. TVH chính thức hoạt động theo mô hình công ty cổ phần từ năm 2004. Công ty đã tham gia cung cấp dịch vụ tư vấn cho một số công trình tiêu biểu như: Cảng Đà Nẵng - Dự án mở rộng Cảng Tiên Sa (Giai đoạn II), Cảng Container Cát Lái, Cảng Container Cái Mép Thượng, Nhà máy Đóng tàu Sông Thu. TVH được giao dịch trên thị trường UPCOM từ tháng 01/2019.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2019-01-17","state":0.49,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Hàng hải Việt Nam - CTCP","p":null,"t":"CORPORATE","q":1961960,"pct":49.0,"d":"2026-07-29"},{"n":"Hoàng Tiến Linh","p":null,"t":"INDIVIDUAL","q":24741,"pct":0.618,"d":"2025-10-05"},{"n":"Trần Thị Ngọc Thuỷ","p":null,"t":"INDIVIDUAL","q":24137,"pct":0.6,"d":"2026-07-29"},{"n":"Nguyễn Hữu Hòa","p":null,"t":"INDIVIDUAL","q":21996,"pct":0.54,"d":"2025-10-05"},{"n":"Trần Hải Thanh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Kế toán trưởng","t":"INDIVIDUAL","q":21398,"pct":0.53,"d":"2026-07-29"},{"n":"Nguyễn Thị Kim Hạnh","p":null,"t":"INDIVIDUAL","q":19796,"pct":0.494,"d":"2026-07-29"},{"n":"Lê Xuân Hùng","p":null,"t":"INDIVIDUAL","q":17966,"pct":0.45,"d":"2026-07-29"},{"n":"Đinh Văn Ngọc","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":14305,"pct":0.36,"d":"2026-07-29"},{"n":"Dương Thị Thanh Huyền","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":12867,"pct":0.321,"d":"2026-07-29"},{"n":"Vũ Ngọc Long","p":null,"t":"INDIVIDUAL","q":10998,"pct":0.275,"d":"2025-10-05"},{"n":"Lê Tấn Đạt","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":10992,"pct":0.27,"d":"2026-07-29"},{"n":"Phạm Trun