à 71.59 héc ta… Ngày 24/12/2019, SZB chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Bất động sản","type":"CT","listed":"2019-12-20","state":0.57628187,"foreign":0.06862333,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Phát triển Khu Công nghiệp","p":null,"t":"CORPORATE","q":13867000,"pct":46.22,"d":"2026-06-23"},{"n":"Công ty Cổ phần Sonadezi Long Thành","p":null,"t":"CORPORATE","q":2521456,"pct":8.4,"d":"2026-06-23"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":2054700,"pct":6.85,"d":"2026-06-23"},{"n":"Công ty Cổ phần Sonadezi Châu Đức","p":null,"t":"CORPORATE","q":1260725,"pct":4.2,"d":"2025-10-05"},{"n":"Quỹ Đầu Tư Phát Triển Đồng Nai","p":null,"t":"CORPORATE","q":900000,"pct":3.0,"d":"2025-12-24"},{"n":"Trần Trung Chiến","p":null,"t":"INDIVIDUAL","q":856300,"pct":2.854,"d":"2025-10-05"},{"n":"Lương Minh Hiền","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":356224,"pct":1.19,"d":"2026-06-23"},{"n":"Nguyễn Bá Chuyên","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":240300,"pct":0.801,"d":"2026-06-23"},{"n":"Lê Thị Ngọc Sáu","p":null,"t":"INDIVIDUAL","q":28400,"pct":0.09,"d":"2025-10-05"},{"n":"Lưu Thị Thúy Vân","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":11200,"pct":0.04,"d":"2026-06-23"},{"n":"Đặng Hải Bằng","p":"Kế toán trưởng","t":"INDIVIDUAL","q":12400,"pct":0.04,"d":"2026-06-23"},{"n":"Đặng Thị Ngọc Hà","p":null,"t":"INDIVIDUAL","q":9000,"pct":0.03,"d":"2025-10-05"},{"n":"Phạm Văn Tỉnh","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":5000,"pct":0.02,"d":"2026-06-23"},{"n":"Lê Thị Kim Tuyền","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.003,"d":"2026-06-23"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 4,500 VND","d":"2026-07-16","record":"2026-07-28","ex":"2026-07-27"},{"c":"AGME","t":"SZB - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-24","record":"2026-03-06","ex":