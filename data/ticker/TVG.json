88]]},"roic":{"q":[["2018-Q4",4.937],["2019-Q4",3.591],["2020-Q4",7.432],["2021-Q4",5.191],["2022-Q4",8.854],["2023-Q4",5.45],["2024-Q4",4.46],["2025-Q4",7.575],["2026-Q2",7.575]],"y":[["2018",4.937],["2019",3.591],["2020",7.432],["2021",5.191],["2022",8.854],["2023",5.45],["2024",4.46],["2025",7.575]]}},"co":{"short":"XD Giao thông Vận tải","profile":"Công ty Cổ phần Tư vấn Đầu tư và Xây dựng Giao thông Vận tải (TVG) có tiền thân là Viện thiết kế Đường sắt được thành lập vào năm 1959. Công ty cung cấp các dịch vụ thuộc lĩnh vực kinh doanh như: đường sắt, đường bộ, cầu, hầm, xây dựng dân dụng, công nghiệp trong phạm vi toàn quốc và quốc tế. Trong đó doanh thu từ thiết kế công trình chiếm tỷ trọng lớn trong tổng doanh thu của công ty. Công ty đã thực hiện các quy hoạch và dự án lớn như điều chỉnh quy hoạch tổng thể phát triển ngành GTVT Đường sắt Việt Nam đến năm 2020, dự án đường sắt đô thị Hà Nội tuyến 1,2,3,5 và các tuyến giao thông đô thị TP HCM. Công ty là liên danh tư vấn của các đối tác nước ngoài như Công ty Tư vấn giao thông Nhật Bản (JTC), ITOCHU, TONICHI, Hiệp hội dịch vụ kỹ thuật đường sắt Nhật Bản (JARTS), Công ty Tư vấn Dosh Consult (DC) và một số công ty Tư vấn khác của Pháp, Trung Quốc, Hàn Quốc. TVG được giao dịch trên thị trường UPCOM từ tháng 01/2010.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-01-25","state":0.49271059,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Du","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":506244,"pct":24.94,"d":"2026-08-26"},{"n":"Nguyễn Thanh Trọng","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":493204,"pct":24.3,"d":"2026-03-06"},{"n":"Hồ Việt Hưng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":405918,"pct":20.0,"d":"2026-03-06"},{"n":"Nguyễn Doãn Bình","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":337055,"pct":16.61,"d":"2026-08-26"},{"n":"Đặng Tuấn Cường","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trác