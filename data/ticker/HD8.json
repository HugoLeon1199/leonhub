h vực đầu tư phát triển và kinh doanh bất động sản. HD8 trở thành công ty đại chúng từ tháng 11/2018. Công ty đã gây dựng và khẳng định được vị thế nhất định trong ngành đầu tư, kinh doanh bất động sản với các dự án Khu đô thị mới Vân Canh, Khu đô thị mới Tây Nam hồ Linh Đàm, Khu văn phòng nhà ở và dịch vụ công cộng Xuân Phương Garden (Hà Nội), Khu nhà ở Bình Minh - Thành phố Lào Cai. Ngoài ra, Công ty còn tham gia cung cấp dịch vụ tư vấn giám sát và quản lý dự án đầu tư như tại Dự án Khu đô thị mới Vân Canh. HD8 được giao dịch trên thị trường UPCOM từ tháng 03/2018.","sector":"Bất động sản","type":"CT","listed":"2019-03-15","state":0.0,"foreign":0.00024,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu tư Phát triển Nhà và Đô thị - Công ty TNHH","p":null,"t":"CORPORATE","q":5100000,"pct":51.0,"d":"2026-08-21"},{"n":"Công ty Cổ phần Tasco","p":null,"t":"CORPORATE","q":900000,"pct":9.0,"d":"2026-08-21"},{"n":"Phạm Tiến Dũng","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":189000,"pct":1.89,"d":"2026-08-21"},{"n":"Nguyễn Phúc Khánh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":60000,"pct":0.6,"d":"2026-08-21"},{"n":"Tạ Trọng Tấn","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.2,"d":"2026-08-21"},{"n":"Võ Thị Nhân","p":"Kế toán trưởng","t":"INDIVIDUAL","q":11200,"pct":0.11,"d":"2026-08-21"},{"n":"Dương Anh Tuấn","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":10000,"pct":0.1,"d":"2026-08-21"},{"n":"Nguyễn Ngọc Hải","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.01,"d":"2026-08-21"},{"n":"Lê Minh Phúc","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":500,"pct":0.005,"d":"2026-08-21"},{"n":"Phan Thị Minh Hương","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":500,"pct":0.005,"d":"2026-08-21"}],"rel":[{"c":"THINHPHATLAND","n":"Công ty TNHH MTV Đầu Tư Phát Triển Nhà Và Đô Thị Thịnh Phát Land","t":"subsidiary","pct":100.0},{"c":"4401101725","n":"Công ty TNHH Đầ