í Minh (HOSE).","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2011-01-11","state":0.51003077,"foreign":0.00554385,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cấp nước Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":6630400,"pct":51.003,"d":"2026-07-28"},{"n":"Lê Huy Hùng","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":1820000,"pct":14.0,"d":"2026-07-28"},{"n":"Công Ty TNHH Thương Mại N.T.P","p":null,"t":"CORPORATE","q":1672350,"pct":12.86,"d":"2026-07-23"},{"n":"Huỳnh Tuấn Anh","p":"Giám đốc","t":"INDIVIDUAL","q":1657600,"pct":12.75,"d":"2021-07-16"},{"n":"Hồ Lê Minh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1104780,"pct":8.5,"d":"2026-07-27"},{"n":"Hồ Lê Nhật","p":null,"t":"INDIVIDUAL","q":156000,"pct":1.2,"d":"2026-07-28"},{"n":"Hoàng Thanh Bình","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":5000,"pct":0.04,"d":"2026-07-28"},{"n":"Đặng Đức Hiền","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":5000,"pct":0.04,"d":"2026-07-28"},{"n":"Dương Nam Sơn","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.023,"d":"2015-09-14"},{"n":"Nguyễn Thị Minh Châu","p":null,"t":"INDIVIDUAL","q":2300,"pct":0.018,"d":"2015-09-14"},{"n":"Hồ Kim Phượng","p":"Phó Giám đốc/Phó Giám đốc Kinh doanh","t":"INDIVIDUAL","q":1200,"pct":0.01,"d":"2026-07-28"},{"n":"Nguyễn Anh Kiệt","p":"Phó Giám đốc/Phó Giám đốc Kỹ thuật","t":"INDIVIDUAL","q":1300,"pct":0.01,"d":"2026-07-28"},{"n":"Vũ Thị Như Quỳnh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":525,"pct":0.004,"d":"2026-07-28"},{"n":"Nguyễn Tú Anh","p":null,"t":"INDIVIDUAL","q":100,"pct":0.001,"d":"2015-09-14"},{"n":"Trương Minh Phương Ánh","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":930,"pct":0.001,"d":"2026-07-28"}],"events":[{"c":"EGME","t":"CLW - Tổ chức ĐHĐCĐ bất thường 2026","d":"2026-07-31","record":"2026-08-19","ex":"2026-08-18"},{"c":"DDRP","t":"Hồ Lê Nhật - Đăng kí Mua 150,000 CLW","d":"2026-06-22","record":null,"ex":null}