6.124],["2020",4.519],["2021",-51.68],["2022",0.0],["2023",0.0],["2024",0.0]]}},"co":{"short":"Licogi 16.6","profile":"Công ty Cổ phần Licogi 16.6 (LCS), tiền thân là Chi nhánh của Công ty Cổ phần Licogi 16 được thành lập năm 2007. Vốn điều lệ hiện tại của công ty là 76 tỷ đồng. Hoạt động kinh doanh của công ty tập trung chủ yếu vào hai lĩnh vực chính là hoạt động thi công xây lắp và hoạt động sản xuất kinh doanh vật liệu xây dựng. Trong đó hoạt động thi công xây lắp là hoạt động chủ lực chiếm hơn 60% tỷ trọng trong cơ cấu doanh thu của công ty. Được sự quan tâm hỗ trợ, tạo điều kiện của Công ty mẹ Licogi 16 trong việc tham gia ký kết hợp đồng cũng như tham gia chào giá đấu thầu tìm kiến dự án. Điển hình là việc giao 04 gói thầu dự án Hữu Nghị - Chi Lăng với tổng giá trị hơn 400 tỷ đồng. Ngoài ra, LICOGI 166 đang tìm kiếm địa điểm để trực tiếp đầu tư nhà máy sản xuất gạch bê tông khí chưng áp với công suất dự kiến khoảng 150.000 m3 sản phẩm/năm.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-24","state":0.0,"foreign":0.00010526,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đặng Lam Giang","p":null,"t":"INDIVIDUAL","q":1672000,"pct":22.0,"d":"2025-10-05"},{"n":"Đặng Lam Giang","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1672000,"pct":22.0,"d":"2022-05-05"},{"n":"Nguyễn Đình Sơn","p":null,"t":"INDIVIDUAL","q":744900,"pct":9.8,"d":"2025-10-05"},{"n":"Bùi Thị Nhân Huệ","p":null,"t":"INDIVIDUAL","q":38900,"pct":0.51,"d":"2025-10-05"},{"n":"Trịnh Thế Dũng","p":null,"t":"INDIVIDUAL","q":37000,"pct":0.487,"d":"2015-09-14"},{"n":"Nguyễn Thu Hà","p":null,"t":"INDIVIDUAL","q":31753,"pct":0.42,"d":"2025-10-05"},{"n":"Nguyễn Việt Hùng","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.263,"d":"2015-09-14"},{"n":"Nguyễn Anh Tú","p":null,"t":"INDIVIDUAL","q":18000,"pct":0.237,"d":"2025-10-05"},{"n":"Vũ Đình Dũng","p":null,"t":"INDIVIDUAL","q":14300,"pct":0.188,"d":"2025-10-05"},{"n":"Phạm Xuân Diện","p":null,"t":"INDIVIDU