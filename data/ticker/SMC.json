ơng Nam và Posco, với thị phần chiếm khoảng 5% so với cả nước và khoảng 17% so với khu vực phía Nam. Hệ thống đại lý, cửa hàng phân phối của Công ty phủ khắp trên địa bàn Thành phố Hồ Chí Minh, Hà Nội, Bình Dương. Đà Nẵng, Cần Thơ và các tỉnh lân cận, các cửa hàng trong thành phố đa số nằm ở những vị trí thuận lợi. Sản phẩm thép của công ty gắn liền với các công trình trọng điểm quốc gia như: Nhà máy điện Phú Mỹ, Thủy điện Hàm Thuận-Đami, Cầu Mỹ Thuận, Nhà ga quốc tế Tân Sơn Nhất, Khu đô thị Phú Mỹ Hưng. Ngày 30/10/2006, SMC chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2006-10-30","state":0.0,"foreign":0.20203866,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Hanwa Company Limited","p":null,"t":"CORPORATE","q":14416476,"pct":19.57,"d":"2025-10-05"},{"n":"Phạm Hoàng Anh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":6000000,"pct":8.14,"d":"2026-09-03"},{"n":"Nguyễn Ngọc Ý Nhi","p":"Phó Tổng Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":2389764,"pct":3.2,"d":"2026-04-28"},{"n":"Công ty Cổ phần Chứng khoán Bảo Minh","p":null,"t":"CORPORATE","q":1893702,"pct":2.573,"d":"2026-07-14"},{"n":"Nguyễn Quốc Thắng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1720467,"pct":2.34,"d":"2025-12-08"},{"n":"Nguyễn Nghĩa Dũng","p":null,"t":"INDIVIDUAL","q":1702861,"pct":2.31,"d":"2025-10-05"},{"n":"Công ty Tài Chính TNHH MTV Bưu Điện","p":null,"t":"CORPORATE","q":465223,"pct":1.576,"d":"2015-06-15"},{"n":"Nguyễn Quang Trung","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":1000000,"pct":1.36,"d":"2026-09-03"},{"n":"Nguyễn Anh Dũng","p":null,"t":"INDIVIDUAL","q":997746,"pct":1.35,"d":"2025-10-05"},{"n":"Nguyễn Ngọc Đăng Khoa","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":756787,"pct":1.03,"d":"2026-04-28"},{"n":"Võ Hoàng Vũ","p":null,"t":"INDIVIDUAL","q":519649,"pct":0.85,"d":"2025-10-05"},{"n":"Nguyễn Thụy 