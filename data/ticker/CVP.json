m. CVP nằm ở tuyến đầu của hành lang kinh tế Đông - Tây , và ở cuối tuyến đường Quốc lộ 9 , cách cửa khẩu Lao Bảo 90 km về phía Đông, cảng Cửa Việt được đánh giá là một công trình quan trọng để thúc đẩy kinh tế khu vực phát triển.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2022-05-04","state":0.96958534,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Quảng Trị","p":null,"t":"CORPORATE","q":3321780,"pct":96.959,"d":"2025-10-05"},{"n":"Nguyễn Văn Minh","p":"Thành viên Hội đồng Quản trị/Kế toán trưởng","t":"INDIVIDUAL","q":8500,"pct":0.248,"d":"2023-03-03"},{"n":"Hoàng Văn An","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":7000,"pct":0.204,"d":"2023-03-03"},{"n":"Hoàng Nam Hải","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":6900,"pct":0.201,"d":"2023-03-03"},{"n":"Phan Minh Ánh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":6900,"pct":0.201,"d":"2023-03-03"},{"n":"Hoàng Đức Chung","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":6700,"pct":0.195,"d":"2023-03-03"}],"events":[{"c":"SUSP","t":"CVP - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2023-06-13","record":null,"ex":null},{"c":"NLIS","t":"CVP - Chính thức đăng ký giao dịch trên UPCoM","d":"2022-04-25","record":null,"ex":null}],"st":{"bsa15":{"label":"Hàng tồn kho, ròng","section":"balance","y":[["2021",0.0],["2022",0.0]],"published":"2023-03-23"},"bsa2":{"label":"Tiền và tương đương tiền","section":"balance","y":[["2021",10.776],["2022",13.235]],"published":"2023-03-23"},"bsa53":{"label":"TỔNG CỘNG TÀI SẢN","section":"balance","y":[["2021",41.907],["2022",43.555]],"published":"2023-03-23"},"bsa54":{"label":"NỢ PHẢI TRẢ","section":"balance","y":[["2021",3.331],["2022",3.714]],"published":"2023-03-23"},"bsa6":{"label":"Đầu tư ngắn hạn","section":"balance","y":[["2021",0.0],["2022",0.0]],"published":"2023-03-23"},"bsa78":{"label":"Vốn chủ sở hữu","section":"balance","y":[["2021",38.57