ực biên tập và xuất bản ba loại sách chính bao gồm sách đại học và cao đẳng, sách trung cấp chuyên nghiệp và sách tham khảo. Ngoài ra, hiện tại công ty cũng đang kinh doanh các thiết bị đồ dùng dạy học, văn hóa phẩm phục vụ giáo dục. Hàng năm, công ty đưa vào xuất bản khoảng 80 - 100 tên sách mới. HEV chính thức được niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2007.","sector":"Truyền thông","type":"CT","listed":"2007-12-11","state":0.04346,"foreign":0.0051334,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thị Thu Đông","p":null,"t":"INDIVIDUAL","q":4000000,"pct":80.0,"d":"2025-12-17"},{"n":"Công ty TNHH MTV Nhà Xuất Bản Giáo Dục Việt Nam","p":null,"t":"CORPORATE","q":217300,"pct":4.346,"d":"2026-08-12"},{"n":"Trần Thị Thu Hằng","p":null,"t":"INDIVIDUAL","q":153000,"pct":3.06,"d":"2025-12-30"},{"n":"Đặng Trần Bảo Tín","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":103020,"pct":2.06,"d":"2026-08-12"},{"n":"Phạm Lê Tú Uyên","p":null,"t":"INDIVIDUAL","q":102000,"pct":2.04,"d":"2025-12-30"},{"n":"Nguyễn Lệ Thủy","p":null,"t":"INDIVIDUAL","q":20300,"pct":2.03,"d":"2015-09-14"},{"n":"Đặng Hồng Thi","p":null,"t":"INDIVIDUAL","q":49980,"pct":1.0,"d":"2026-08-12"},{"n":"Nguyễn Thị Hữu","p":null,"t":"INDIVIDUAL","q":42075,"pct":0.842,"d":"2025-12-30"},{"n":"Doãn Hữu Đoàn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":42075,"pct":0.84,"d":"2026-08-12"},{"n":"Nguyễn Bích Ngọc","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":17850,"pct":0.357,"d":"2026-08-12"},{"n":"Trần Trọng Tiến","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.3,"d":"2025-10-05"},{"n":"Nguyễn Văn Thuận","p":null,"t":"INDIVIDUAL","q":2575,"pct":0.258,"d":"2015-09-14"},{"n":"Lê Quang Dũng","p":null,"t":"INDIVIDUAL","q":2243,"pct":0.22,"d":"2025-10-05"},{"n":"Nguyễn Nam Phóng","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.1,"d":"2025-10-05"},{"n":"Nguyễn Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.1,"d":"2025-10-05"},{"n":"Ameri