ó quy mô lớn nhất trong ngành với 07 nhà máy sản xuất bao bì có tổng công suất 108.000 tấn/năm và 01 nhà máy sản xuất phụ gia CaCO3 An Phát - Yên Bái có công suất 222.000 tấn/năm. So với các doanh nghiệp cùng ngành trong nước khác như Công ty Cổ phần Nhựa Hưng Yên (công suất khoảng 1.000 tấn/tháng), Công ty Cổ phần Nhựa Tú Phương (công suất khoảng 800 tấn/tháng) và một số doanh nghiệp liên doanh khác ở Phía Nam (công suất dao động từ 500 – 700 tấn/tháng). AAA được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ cuối năm 2016.","sector":"Hóa chất","type":"CT","listed":"2016-11-25","state":0.0,"foreign":0.01528839,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn An Phát Holdings","p":null,"t":"CORPORATE","q":197787394,"pct":50.23,"d":"2026-07-01"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":19045000,"pct":4.98,"d":"2025-10-05"},{"n":"Nguyễn Minh Hoa","p":null,"t":"INDIVIDUAL","q":980000,"pct":2.475,"d":"2015-09-14"},{"n":"Nguyễn Lê Trung","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":862234,"pct":0.219,"d":"2026-07-31"},{"n":"Hoà Thị Thu Hà","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Phó Tổng Giám đốc Tài chính - Kế toán","t":"INDIVIDUAL","q":680000,"pct":0.173,"d":"2026-07-31"},{"n":"Nguyễn Thị Tiện","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":680000,"pct":0.173,"d":"2026-07-31"},{"n":"Trần Thị Thoản","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":680000,"pct":0.173,"d":"2026-07-31"},{"n":"Nguyễn Đức Dũng","p":null,"t":"INDIVIDUAL","q":30000,"pct":0.076,"d":"2015-09-14"},{"n":"Nguyễn Hồng Thảo","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.025,"d":"2026-02-09"},{"n":"Nguyễn Lê Thăng Long","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":80000,"pct":0.02,"d":"2026-07-31"},{"n":"Đỗ Thị Thoan","p":null,"t":"INDIVIDUAL","q":5000,"pct":0.013,"d":"2015-09-14"},{"n":"Nguyễn Xuân Cờ","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q"