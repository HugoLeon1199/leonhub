ình Thạnh, Gò Vấp và huyện Hóc Môn. Năm 2005, công ty tiến hành cổ phần hóa. Hoạt động kinh doanh của công ty hiện nay là cung ứng, kinh doanh nước sạch cho nhu cầu tiêu dùng và sản xuất thuộc khu vực Quận Bình Thạnh, Quận Phú Nhuận, 03 phường Quận 3 và 01 phường Quận Gò Vấp.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2010-06-15","state":0.0,"foreign":0.07111621,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cấp nước Sài Gòn - TNHH MTV","p":null,"t":"CORPORATE","q":4865000,"pct":51.211,"d":"2026-08-10"},{"n":"Công ty TNHH Nước Sạch Ree","p":null,"t":"CORPORATE","q":1904688,"pct":20.05,"d":"2026-07-09"},{"n":"Ngân hàng TNHH MTV Số Vikki","p":null,"t":"CORPORATE","q":950000,"pct":10.0,"d":"2026-07-09"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":577900,"pct":6.08,"d":"2025-10-05"},{"n":"Hồ Lê Minh","p":null,"t":"INDIVIDUAL","q":338050,"pct":3.56,"d":"2025-10-05"},{"n":"Hồ Lê Nhật","p":null,"t":"INDIVIDUAL","q":163635,"pct":1.72,"d":"2025-10-05"},{"n":"Công ty TNHH MTV Chứng Khoán Ngân hàng Số Vikki","p":null,"t":"CORPORATE","q":69500,"pct":0.732,"d":"2015-06-15"},{"n":"Huỳnh Thị Bích Phương","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":3000,"pct":0.03,"d":"2026-08-10"}],"rel":[{"c":"REEWATER","n":"Công ty TNHH Nước Sạch Ree","t":"affiliate","pct":0.0}],"rel_count":1,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,900 VND","d":"2026-06-22","record":"2026-06-30","ex":"2026-06-29"},{"c":"AGME","t":"GDW - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-09","record":"2026-03-23","ex":"2026-03-20"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2024 - 986 VND","d":"2025-11-28","record":"2025-12-05","ex":"2025-12-04"},{"c":"DDIND","t":"Hồ Lê Nhật - Đăng kí Mua GDW","d":"2025-08-21","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2024 - 1,900 VND","d":"2025-06-20","record":"2025-06-30","ex":"2025-06-27"},{"c":"AGME","t":"GDW - Tổ ch