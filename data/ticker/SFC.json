t hàng chất đốt trên địa bàn toàn thành phố Hồ Chí Minh. Lĩnh vực kinh doanh chính của công ty là bán lẻ xăng dầu, ngoài ra còn một số các ngành nghề phụ trợ như kinh doanh bất động sản, xây dựng các khu trung tâm thương mại, buôn bán các vật tư máy móc (bếp gas, bình gas…). Công ty có kế hoạch phát triển mạng lưới bán lẻ xăng dầu đặc biệt là dầu DO tập trung nhiều ở ngoại thành, các cửa ngõ ra vào Thành phố đồng thời phát triển thị trường nội địa đối với sản phẩm gỗ, cho thuê bất động sản. Ngày 21/9/2004 là ngày gia dịch đầu tiên của SFC trên sàn HOSE.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2004-09-21","state":0.20012542,"foreign":0.00557129,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Xăng Dầu Và Dịch Vụ Hàng Hải S.T.S","p":null,"t":"CORPORATE","q":5758634,"pct":51.0,"d":"2026-02-27"},{"n":"Công Ty TNHH Một Thành Viên Dầu Khí Thành Phố Hồ Chí Minh","p":null,"t":"CORPORATE","q":2259708,"pct":20.012,"d":"2026-02-27"},{"n":"Lê Trọng Hiếu","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1424345,"pct":12.68,"d":"2026-08-12"},{"n":"Công ty TNHH Quản lý Quỹ đầu tư Chứng khoán Đông Á","p":null,"t":"CORPORATE","q":146277,"pct":1.295,"d":"2015-06-15"},{"n":"Nguyễn Thanh Chánh","p":null,"t":"INDIVIDUAL","q":97300,"pct":0.866,"d":"2015-09-14"},{"n":"Lê Quang Liêm","p":null,"t":"INDIVIDUAL","q":85000,"pct":0.757,"d":"2015-09-14"},{"n":"Công ty TNHH MTV Chứng Khoán Ngân hàng Số Vikki","p":null,"t":"CORPORATE","q":67937,"pct":0.602,"d":"2015-06-15"},{"n":"Trần Đình Thảo","p":null,"t":"INDIVIDUAL","q":17620,"pct":0.157,"d":"2015-09-14"},{"n":"Trần Hoàng Phượng","p":null,"t":"INDIVIDUAL","q":17424,"pct":0.15,"d":"2025-10-05"},{"n":"Cao Văn Phát","p":null,"t":"INDIVIDUAL","q":11811,"pct":0.105,"d":"2015-09-14"},{"n":"Đỗ Thị Lợi","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.089,"d":"2015-09-14"},{"n":"Đặng Ngọc Dung","p":null,"t":"INDIVIDUAL","q":8600,"pct":0.077,"d":"2015-09-14"},{"n":"Nguyễn Thị B