còn thực hiện đầu tư tài chính vào một số công ty như CTCP Đầu tư Hải Đăng, CTCP Dầu khí Nha Trang và CTCP Thiết bị nội ngoại thất Dầu khí (PVC-Metal). Công ty đã tham gia thi công một số công trình tiêu biểu như công trình PetroVietnam Landmark, chung cư B4 Kim Liên và khách sạn PetroLand Tây Ninh. Công ty lỗ liên tiếp 3 năm trong giai đoạn 2011 – 2013 với lỗ năm 2013 là 222 tỷ đồng.</P></DIV>","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2011-03-15","state":0.0,"foreign":0.0006,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xây lắp Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":8711500,"pct":24.72,"d":"2025-10-05"},{"n":"Công ty Cổ phần Quản lý Quỹ Leadvisors","p":null,"t":"CORPORATE","q":3000000,"pct":8.571,"d":"2015-06-15"},{"n":"Công ty Cổ phần Đầu tư Khu Công Nghiệp Dầu khí Long Sơn","p":null,"t":"CORPORATE","q":2520000,"pct":7.2,"d":"2015-06-15"},{"n":"Tổng Công ty Cổ phần Sông Hồng","p":null,"t":"CORPORATE","q":1500000,"pct":4.286,"d":"2015-06-15"},{"n":"Phan Chí Trung","p":"Chủ tịch Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":713750,"pct":2.04,"d":"2025-10-05"},{"n":"Công ty Cổ phần Victory Group","p":null,"t":"CORPORATE","q":297100,"pct":0.849,"d":"2015-06-15"},{"n":"Nguyễn Phi Hoàng","p":null,"t":"INDIVIDUAL","q":169121,"pct":0.483,"d":"2015-09-14"},{"n":"Đinh Văn Hưng","p":null,"t":"INDIVIDUAL","q":17000,"pct":0.049,"d":"2015-09-14"},{"n":"Dương Thành Tín","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.006,"d":"2015-09-14"}],"events":[{"c":"SUSP","t":"PSG - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2026-04-24","record":null,"ex":null},{"c":"EGME","t":"PSG - Tổ chức ĐHĐCĐ bất thường 2023","d":"2023-10-24","record":"2023-10-30","ex":"2023-10-27"},{"c":"DDINS","t":"Công ty Cổ phần Chứng khoán APG - Đăng kí Bán PSG","d":"2023-07-19","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Chứng khoán APG - Đăng kí Bán PSG","d":"2023-02-28","record":null,"ex":null},{"c":"DDINS","t