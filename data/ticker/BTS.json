inh, đường dây 110KV Bắc Nam, thủy điện Tuyên Quang, Sơn La, cầu Tân Đệ, cầu Thanh Trì, Trung tâm Hội nghị quốc gia, công trình thủy điện PlayKrong Kon Tum, thủy điện Ba Hạ Phú Yên. BTS được niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX) từ năm 2006.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-05","state":0.79515257,"foreign":0.00116068,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Xi măng Việt Nam","p":null,"t":"CORPORATE","q":98248939,"pct":79.515,"d":"2026-02-02"},{"n":"Công ty TNHH Chứng khoán ACB","p":null,"t":"CORPORATE","q":6932016,"pct":5.61,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Á Châu","p":null,"t":"CORPORATE","q":6170627,"pct":4.99,"d":"2026-01-05"},{"n":"Công ty TNHH Đầu Tư Tài Chính Á Châu Hà Nội","p":null,"t":"CORPORATE","q":3916894,"pct":3.17,"d":"2026-08-27"},{"n":"Công ty Cổ Phần Địa Ốc A.c.b","p":null,"t":"CORPORATE","q":300000,"pct":0.24,"d":"2026-08-27"},{"n":"Trương Quốc Huy","p":null,"t":"INDIVIDUAL","q":13800,"pct":0.013,"d":"2025-10-05"},{"n":"Nguyễn Huy Quế","p":null,"t":"INDIVIDUAL","q":2850,"pct":0.003,"d":"2015-09-14"},{"n":"Lê Thị Khanh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2719,"pct":0.002,"d":"2026-08-27"},{"n":"Lê Trung Tiến","p":null,"t":"INDIVIDUAL","q":2050,"pct":0.002,"d":"2025-10-05"},{"n":"Lưu Đình Cường","p":null,"t":"INDIVIDUAL","q":2200,"pct":0.002,"d":"2025-10-05"},{"n":"Phan Trọng Lập","p":null,"t":"INDIVIDUAL","q":2400,"pct":0.002,"d":"2015-09-14"},{"n":"Phạm Đức Cường","p":null,"t":"INDIVIDUAL","q":1755,"pct":0.001,"d":"2025-10-05"},{"n":"Tạ Quốc Luận","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.001,"d":"2015-09-14"},{"n":"Nguyễn Văn Duyệt","p":null,"t":"INDIVIDUAL","q":300,"pct":0.0,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"BTS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-29","record":"2026-05-15","ex":"2026-05-14"},{"c":"DDINS","t":"Công ty Cổ Phần Địa Ốc A.c.b - Đăng kí Mua 200,000 BTS","d":