ay công ty chế biến hàng năm 20.000-30.000 tấn thủy hải sản các loại, trong đó 60% dành cho xuất khẩu. Sản phẩm của công ty đã có mặt trên 25 quốc gia. Ngày 07/06/2019, APT chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2019-06-07","state":0.3000225,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Tập Đoàn Somo Việt Nam","p":null,"t":"CORPORATE","q":3616102,"pct":41.0,"d":"2026-08-10"},{"n":"Tổng Công ty Thương Mại Sài Gòn - TNHH Một Thành Viên","p":null,"t":"CORPORATE","q":2640198,"pct":30.0,"d":"2026-08-10"},{"n":"Mạc Bùi Nhã Uyên","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":1936145,"pct":22.0,"d":"2026-08-10"},{"n":"Đoàn Thị Thu Hà","p":"Kế toán trưởng","t":"INDIVIDUAL","q":3900,"pct":0.044,"d":"2026-08-10"},{"n":"Mai Minh Vương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":500,"pct":0.005,"d":"2026-08-10"},{"n":"Nguyễn Thành Vinh","p":null,"t":"INDIVIDUAL","q":400,"pct":0.004,"d":"2025-10-05"},{"n":"Hồ Thị Sương","p":null,"t":"INDIVIDUAL","q":21224,"pct":0.002,"d":"2026-08-10"}],"rel":[{"c":"3901307553","n":"Công ty TNHH Chăn Nuôi Somo Farm Tân Biên","t":"affiliate","pct":40.0}],"rel_count":1,"events":[{"c":"DDINS","t":"Công ty Cổ Phần Tập Đoàn Somo Việt Nam - Đăng kí Mua 264,000 APT","d":"2026-04-02","record":null,"ex":null},{"c":"AGME","t":"APT - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-09","record":"2026-03-25","ex":"2026-03-24"},{"c":"AGME","t":"APT - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-11","record":"2025-03-28","ex":"2025-03-27"},{"c":"AGME","t":"APT - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-18","record":"2024-03-27","ex":"2024-03-26"},{"c":"AGME","t":"APT - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-03-22","record":"2023-03-31","ex":"2023-03-30"},{"c":"AGME","t":"APT - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-03-11","record":"2022-04-01","ex":"2022-03-31"},{"c":"DDINS","t":"Công ty Cổ Phần Tập Đoàn Somo Việt Nam