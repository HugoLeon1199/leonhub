ố tín nhiệm BCA và nâng cao triển vọng tín nhiệm từ “ổn định” lên mức “tích cực” - mức đánh giá thuộc nhóm cao nhất trong hệ thống ngân hàng Việt Nam. Năm 2025, so với cùng kỳ, biên lãi thuần (NIM) ở mức 3.21%, giảm 0.35%. Tỷ lệ nợ xấu ở mức 6.41%, tăng 4.01%. Tỷ lệ bao phủ nợ xấu ở mức 49.97%, giảm 18.46%. Lợi nhuận sau thuế công ty mẹ có giá trị bằng 5,9 nghìn tỷ đồng, giảm 41.12%. Tỷ suất lợi nhuận trên vốn chủ sở hữu (ROE) ở mức 10.34%, giảm 9.69%. TPB được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2018.","sector":"Ngân hàng","type":"NH","listed":"2018-04-19","state":0.0,"foreign":0.21898777,"rating":"BUY","target":18600.0,"rating_as_of":"2026-05-20","source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần FPT","p":null,"t":"CORPORATE","q":149099577,"pct":6.772,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Tập Đoàn Vàng Bạc Đá Quý Doji","p":null,"t":"CORPORATE","q":164549061,"pct":5.93,"d":"2026-07-31"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":104093884,"pct":4.728,"d":"2025-10-05"},{"n":"Sbi Ven Holdings Private Limited","p":null,"t":"CORPORATE","q":125150227,"pct":4.51,"d":"2026-07-31"},{"n":"Công ty TNHH JB","p":null,"t":"CORPORATE","q":113198905,"pct":4.08,"d":"2026-07-31"},{"n":"Công ty TNHH Sp","p":null,"t":"CORPORATE","q":113252223,"pct":4.08,"d":"2026-07-31"},{"n":"Công ty TNHH VG","p":null,"t":"CORPORATE","q":106442665,"pct":3.84,"d":"2026-07-31"},{"n":"Nguyễn Hà Long","p":null,"t":"INDIVIDUAL","q":84126548,"pct":3.82,"d":"2025-10-05"},{"n":"Đỗ Anh Tú","p":null,"t":"INDIVIDUAL","q":102843160,"pct":3.71,"d":"2026-07-31"},{"n":"Lê Quang Tiến","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":100063616,"pct":3.61,"d":"2026-07-31"},{"n":"Công ty TNHH Fd","p":null,"t":"CORPORATE","q":96765354,"pct":3.49,"d":"2026-07-31"},{"n":"Đỗ Minh Quân","p":null,"t":"INDIVIDUAL","q":92651498,"pct":3.34,"d":"2026-07-31"},{"n":"Trần Cẩm Nhung","p":null,"t":"INDIVIDUAL","q":71203312,"pct":3.23,"d":"2025-10-05"},{"n":"Công