:"Khoáng sản Hà Giang","profile":"Công ty Cơ khí và Khai thác Khoáng sản Hà Giang (HGM), tiền thân là Xí nghiệp Cơ khí Hà Giang, được hợp nhất với Công ty Khai thác và Chế biến khoáng sản Hà Giang thành Công ty Cơ khí và Khai thác Khoáng sản Hà Giang. Từ năm 2006, Công ty chính thức hoạt động theo mô hình công ty cổ phần. Công ty tập trung vào hoạt động khai thác và sản xuất sản phẩm Antimon. Hiện Công ty đang khai thác mỏ Mậu Duệ, xã Mậu Duệ, Yên Minh, Hà Giang và đang vận hành nhà máy Luyện Antimon kim loại tại xã Mậu Duệ với công suất 1.000 tấn/năm. Năm 2005, Công ty đã đưa thêm nhà máy tuyển tinh chì kẽm tại xã Minh Sơn Bắc Mê vào hoạt động.","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2009-12-21","state":0.46637143,"foreign":0.00296706,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":5876280,"pct":46.62,"d":"2026-08-24"},{"n":"Công Ty TNHH Quốc Tế Dp","p":null,"t":"CORPORATE","q":1001100,"pct":7.95,"d":"2025-10-05"},{"n":"Đỗ Vân Anh","p":null,"t":"INDIVIDUAL","q":528280,"pct":4.432,"d":"2015-09-14"},{"n":"Công ty Cổ phần khoáng sản Đông Dương","p":null,"t":"CORPORATE","q":400000,"pct":3.17,"d":"2025-10-05"},{"n":"Phạm Thành Đô","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":399800,"pct":3.17,"d":"2026-08-24"},{"n":"Nguyễn Thảo Hiền","p":null,"t":"INDIVIDUAL","q":288100,"pct":2.28,"d":"2026-08-24"},{"n":"Công ty Cổ phần Quản lý quỹ đầu tư chứng khoán Bản Việt","p":null,"t":"CORPORATE","q":266300,"pct":2.113,"d":"2015-06-15"},{"n":"Quỹ đầu tư chứng khoán Bản Việt","p":null,"t":"CORPORATE","q":264800,"pct":2.102,"d":"2015-06-15"},{"n":"Phạm Văn Hội","p":null,"t":"INDIVIDUAL","q":132000,"pct":1.047,"d":"2026-08-24"},{"n":"Công ty XNK Petrolimex","p":null,"t":"CORPORATE","q":120000,"pct":0.952,"d":"2015-06-15"},{"n":"Nguyễn Hữu Phúc","p":null,"t":"INDIVIDUAL","q":111600,"pct":0.94,"d":"2025-10-05"},{"n":"Trịnh Ngọc Hiếu","p":"P