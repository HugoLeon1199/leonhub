t bị, nhà xưởng, 02 cầu cảng, 03 đơn vị thành viên với những sản phẩm và dịch vụ đa dạng. Ngày 17/09/2010, SCO chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-09-17","state":0.46357143,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Thủy sản Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":1947000,"pct":46.36,"d":"2026-03-09"},{"n":"Trần Quý Hùng","p":null,"t":"INDIVIDUAL","q":659208,"pct":16.22,"d":"2026-07-17"},{"n":"Quách Tuấn Hải","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":438000,"pct":10.78,"d":"2026-03-09"},{"n":"Công ty Cổ phần Biển Tây","p":null,"t":"CORPORATE","q":352194,"pct":8.386,"d":"2015-06-15"},{"n":"Trần Vũ Dũng","p":null,"t":"INDIVIDUAL","q":306518,"pct":7.298,"d":"2015-09-14"},{"n":"Vũ Thị Tuyết Cẩm","p":null,"t":"INDIVIDUAL","q":206967,"pct":4.928,"d":"2015-09-14"},{"n":"Bùi Thị Nga","p":null,"t":"INDIVIDUAL","q":55000,"pct":1.31,"d":"2015-09-14"},{"n":"Bùi Thị Tuyết Mai","p":null,"t":"INDIVIDUAL","q":45000,"pct":1.071,"d":"2015-09-14"},{"n":"Nguyễn Văn Tân","p":null,"t":"INDIVIDUAL","q":34500,"pct":0.821,"d":"2025-10-05"},{"n":"Nguyễn Trọng Nghĩa","p":null,"t":"INDIVIDUAL","q":28310,"pct":0.674,"d":"2015-09-14"},{"n":"Tống Thị Ngọc Oanh","p":null,"t":"INDIVIDUAL","q":24165,"pct":0.575,"d":"2015-09-14"},{"n":"Trương Tùng Hưng","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":16000,"pct":0.381,"d":"2026-03-09"},{"n":"Nguyễn Bảy","p":null,"t":"INDIVIDUAL","q":3986,"pct":0.095,"d":"2015-09-14"},{"n":"Nguyễn Hữu Lộc","p":null,"t":"INDIVIDUAL","q":3986,"pct":0.095,"d":"2015-09-14"},{"n":"Nguyễn Trường Văn","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.095,"d":"2015-09-14"}],"events":[{"c":"DDIND","t":"Trần Quý Hùng - Đăng kí Mua SCO","d":"2026-07-17","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Tấn Dũng - Đăng kí Bán 47,402 SCO","d":"2026-05-21","record":null