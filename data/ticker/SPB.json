2019",4.387],["2020",2.635],["2021",18.907],["2022",1.073],["2023",-0.166],["2024",4.225],["2025",4.942]]}},"co":{"short":"Sợi Phú Bài","profile":"Công ty Cổ phần Sợi Phú Bài (SPB) được thành lập vào ngày 14/01/2003. Công ty chuyên sản xuất và kinh doanh sợi các loại và kinh doanh nguyên vật liệu, thiết bị ngành kéo sợi. SPB trở thành công ty đại chúng từ tháng 06/2016. SPB hiện đang quản lý và vận hành dây chuyền sản xuất với quy mô hơn 65.600 cọc sợi và năng suất đạt khoảng 13.500 tấn sợi/năm. Hoạt động kinh doanh chính của công ty là xuất khẩu. Các thị trường lớn của công ty bao gồm Hàn Quốc, Nhật Bản và EU. SPB được giao dịch trên thị trường UPCOM từ tháng 10/2016.","sector":"Hàng cá nhân & Gia dụng","type":"CT","listed":"2016-10-17","state":0.6072749,"foreign":5.692e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Dệt May Việt Nam","p":null,"t":"CORPORATE","q":8076809,"pct":60.727,"d":"2026-08-24"},{"n":"Công ty Cổ Phần Lương Thực Vật Tư Nông Nghiệp Nghệ An","p":null,"t":"CORPORATE","q":2095500,"pct":15.76,"d":"2026-08-24"},{"n":"Công ty Cổ phần Dệt May Huế","p":null,"t":"CORPORATE","q":664890,"pct":5.0,"d":"2026-08-24"},{"n":"Bùi Nguyên Tiến","p":null,"t":"INDIVIDUAL","q":342287,"pct":3.6,"d":"2025-10-05"},{"n":"Trần Thị Kim Chi","p":null,"t":"INDIVIDUAL","q":336001,"pct":2.526,"d":"2025-10-05"},{"n":"Nguyễn Thị Hải Yến","p":null,"t":"INDIVIDUAL","q":118500,"pct":0.89,"d":"2025-10-05"},{"n":"Hoàng Thái Phương","p":null,"t":"INDIVIDUAL","q":57803,"pct":0.435,"d":"2026-02-27"},{"n":"Hoàng Thái Trúc","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":43540,"pct":0.327,"d":"2026-02-27"},{"n":"Hoàng Thị Thu Trang","p":null,"t":"INDIVIDUAL","q":43354,"pct":0.326,"d":"2026-02-27"},{"n":"Trần Đình Hiệp","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":31552,"pct":0.24,"d":"2026-02-27"},{"n":"Lê Hồng Quân","p":null,"t":"INDIVIDUAL","q":2223,"pct":0.023,"d":"2025-10-05"},{"n":"Lê Thị Quê Hương","p":"Thành vi