k bán hàng. BCV được giao dịch trên thị trường UPCOM từ tháng 03/2021.","sector":"Du lịch và Giải trí","type":"CT","listed":"2021-03-16","state":0.93061111,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần","p":null,"t":"CORPORATE","q":923500,"pct":51.31,"d":"2026-08-25"},{"n":"Ủy Ban Nhân Dân Tỉnh Cao Bằng","p":null,"t":"CORPORATE","q":751600,"pct":41.76,"d":"2026-08-25"},{"n":"Nông Thị Thuý","p":"Phó Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.056,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"BCV - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-06","record":"2026-03-23","ex":"2026-03-20"},{"c":"DDINS","t":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần - Đăng kí Bán 923,500 BCV","d":"2025-10-23","record":null,"ex":null},{"c":"DDINS","t":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần - Đăng kí Bán 923,500 BCV","d":"2025-09-25","record":null,"ex":null},{"c":"EGME","t":"BCV - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-09-05","record":"2025-09-11","ex":"2025-09-10"},{"c":"DDINS","t":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần - Đăng kí Bán 923,500 BCV","d":"2025-09-04","record":null,"ex":null},{"c":"AGME","t":"BCV - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-13","record":"2025-03-28","ex":"2025-03-27"},{"c":"AGME","t":"BCV - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-04-24","record":"2024-05-09","ex":"2024-05-08"},{"c":"AGME","t":"BCV - Tổ chức ĐHĐCĐ thường niên 2023","d":"2023-04-12","record":"2023-05-08","ex":"2023-05-05"},{"c":"AGME","t":"BCV - Tổ chức ĐHĐCĐ thường niên 2022","d":"2022-04-01","record":"2022-04-20","ex":"2022-04-19"},{"c":"DDINS","t":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần - Đăng kí Bán 923,500 BCV","d":"2022-03-04","record":null,"ex":null},{"c":"DDINS","t":"Tổng Công ty Khoáng sản TKV - Công ty Cổ phần - Đăng kí Bán 923,500 BCV","d":"2022-01-19","record":null,"ex":null},{"c":"AGME","t":"BCV - Tổ chức ĐHĐCĐ thường niên 2021","d":"2021-04-06","record":