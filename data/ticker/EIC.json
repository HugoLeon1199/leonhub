 Campuchia, được thành lập vào năm 2007. Công ty hoạt động chính trong lĩnh vực đầu tư, xây lắp các dự án thủy điện, chuyên thực hiện các dự án đầu tư tại Lào và Campuchia. Công ty đóng vai trò quan trọng việc thúc đẩy mối quan hệ hợp tác giữa Việt Nam, Lào và Campuchia trong hoạt động sản xuất năng lượng. Các công trình tiêu biểu Công ty đã triển khai là thủy điện Hạ Sê San 1/ Sê San 5, Hạ Sê San 2, thủy điện Sê Kong tại Campuchia và thủy điện Nậm Mô 1 tại Lào. EIC được giao dịch trên thị trường UPCOM từ tháng 02/2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-02-28","state":0.6482702,"foreign":0.0002107,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Phát điện 1","p":null,"t":"CORPORATE","q":9554502,"pct":26.05,"d":"2026-08-26"},{"n":"Công ty Cổ phần Nhiệt điện Phả Lại","p":null,"t":"CORPORATE","q":7080000,"pct":19.3,"d":"2026-08-26"},{"n":"Tập đoàn Công nghiệp Cao su Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":4320000,"pct":11.78,"d":"2026-08-26"},{"n":"Ngân hàng Thương mại Cổ phần An Bình","p":null,"t":"CORPORATE","q":3780000,"pct":10.31,"d":"2026-08-26"},{"n":"Tổng Công ty Điện lực Dầu khí Việt Nam - CTCP","p":null,"t":"CORPORATE","q":2822200,"pct":7.69,"d":"2026-08-26"},{"n":"Tổng Công ty Cổ phần Xuất nhập khẩu và Xây dựng Việt Nam","p":null,"t":"CORPORATE","q":2139500,"pct":5.83,"d":"2025-10-05"},{"n":"Trương Quang Minh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":107475,"pct":0.29,"d":"2026-08-26"},{"n":"Phạm Thị Thủy","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1600,"pct":0.004,"d":"2026-08-26"},{"n":"Lê Thanh Khoa","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1000,"pct":0.003,"d":"2026-08-26"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 1,000 VND","d":"2026-05-20","record":"2026-05-28","ex":"2026-05-27"},{"c":"AGME","t":"EIC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-10","record":"2026-04-03","ex":"2026-04-02"},{"c":"EGME","t":"EIC - Tổ chức 