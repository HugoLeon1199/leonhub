í thuộc Tập đoàn Dầu khí Quốc gia Việt Nam, PVC – MS được định hướng phát triển trở thành đơn vị xây lắp chuyên ngành và khẳng định vị thế của Nhà thầu EPC/EPCI trong lĩnh vực xây lắp công trình Dầu khí biển. Bãi cảng diện tích 23ha (đạt tiêu chuẩn nước sâu cho tàu trên 10.000 DWT) tại Khu Công nghiệp dịch vụ Dầu khí Sao Mai Bến Đình. Ngày 08/07/2022, PXS chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-02","state":0.0,"foreign":0.10529593,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xây lắp Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":30584533,"pct":50.97,"d":"2025-10-05"},{"n":"Mepcom Offshore And Marine Private Limited","p":null,"t":"CORPORATE","q":6000000,"pct":10.0,"d":"2025-10-05"},{"n":"Nguyễn Đức Đạt","p":null,"t":"INDIVIDUAL","q":62800,"pct":0.1,"d":"2025-10-05"},{"n":"Phạm Tất Thành","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.067,"d":"2025-10-05"},{"n":"Nguyễn Tấn Yên","p":null,"t":"INDIVIDUAL","q":36220,"pct":0.06,"d":"2015-09-14"},{"n":"Nguyễn Minh Châu","p":null,"t":"INDIVIDUAL","q":23840,"pct":0.04,"d":"2015-09-14"},{"n":"Trần Sỹ Huấn","p":null,"t":"INDIVIDUAL","q":20800,"pct":0.035,"d":"2025-10-05"},{"n":"Vũ Minh Công","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":20255,"pct":0.034,"d":"2026-02-27"},{"n":"Nguyễn Hữu Thân","p":null,"t":"INDIVIDUAL","q":17440,"pct":0.029,"d":"2015-09-14"},{"n":"Nguyễn Anh Đức","p":null,"t":"INDIVIDUAL","q":11600,"pct":0.02,"d":"2025-10-05"},{"n":"Đinh Văn Tân","p":null,"t":"INDIVIDUAL","q":11000,"pct":0.02,"d":"2025-10-05"},{"n":"Phạm Đình Nhu","p":null,"t":"INDIVIDUAL","q":7000,"pct":0.012,"d":"2015-09-14"},{"n":"Phạm Thị Hải","p":null,"t":"INDIVIDUAL","q":5900,"pct":0.01,"d":"2015-09-14"},{"n":"Võ Thanh Tịnh","p":"Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":6001,"pct":0.01,"d":"2026-02-27"},{"n":"Đinh Văn Hưng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":6090,"pct":0.0