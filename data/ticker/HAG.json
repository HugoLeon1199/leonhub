hao và giải trí. Từ năm 2016, HAG đã chuyển đổi chiến lược kinh doanh khẳng định lĩnh vực kinh doanh cốt lõi là ngành trồng trọt với trọng tâm là sản xuất trái cây để tham gia chuỗi giá trị toàn cầu. HAG được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2008.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2008-12-22","state":0.0,"foreign":0.01788551,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đoàn Nguyên Đức","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":325950533,"pct":25.72,"d":"2026-07-08"},{"n":"Công ty Cổ phần Tư vấn Đầu tư Hướng Việt","p":null,"t":"CORPORATE","q":60060000,"pct":4.74,"d":"2025-10-05"},{"n":"Công ty Cổ phần Chứng khoán LPBank","p":null,"t":"CORPORATE","q":50000000,"pct":4.73,"d":"2025-10-05"},{"n":"Đoàn Hoàng Nam","p":null,"t":"INDIVIDUAL","q":52000000,"pct":4.1,"d":"2026-07-31"},{"n":"Ngân hàng Deutsche Aktiengesellschaft","p":null,"t":"CORPORATE","q":27534575,"pct":3.486,"d":"2015-06-15"},{"n":"Vietnam Century Fund","p":null,"t":"CORPORATE","q":15563153,"pct":1.97,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán OCBS","p":null,"t":"CORPORATE","q":15400000,"pct":1.22,"d":"2025-10-05"},{"n":"Đoàn Hoàng Anh","p":null,"t":"INDIVIDUAL","q":13000000,"pct":1.03,"d":"2026-07-31"},{"n":"Deutche Asset Management (Asia) Ltd.","p":null,"t":"CORPORATE","q":8058010,"pct":1.02,"d":"2015-06-15"},{"n":"Wareham Group Limited","p":null,"t":"CORPORATE","q":5206310,"pct":0.659,"d":"2015-06-15"},{"n":"Trà Văn Hàn","p":null,"t":"INDIVIDUAL","q":1238544,"pct":0.157,"d":"2015-09-14"},{"n":"Hồ Thị Kim Chi","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1595159,"pct":0.15,"d":"2026-07-31"},{"n":"Võ Thị Mỹ Hạnh","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ trách Công bố thông tin/Phó Tổng Giám đốc Kinh doanh","t":"INDIVIDUAL","q":1300001,"pct":0.12,"d":"2026-07-31"},{"n":"Deutsche Asset Management (Asia) Limited","p":null,"t":"CORPORATE","q":2075