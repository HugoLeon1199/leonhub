"2018",18.124],["2019",6.506],["2020",0.0],["2021",6.116],["2022",6.607],["2023",9.081],["2024",11.224],["2025",9.75]]}},"co":{"short":"Xây lắp 1- Petrolimex","profile":"Công ty Cổ phần Tập đoàn Xây lắp 1 - Petrolimex (PCC) có tiền thân là Công ty Xây lắp 1, được thành lập vào năm 1969. Công ty hoạt động chính trong lĩnh vực (i) xây lắp các công trình bồn bể và đường ống trong ngành xăng dầu, công trình dân dụng và công trình công nghiệp (ii) sản xuất bê tông, chế tạo lắp đặt cơ khí và (iii) phát triển các dự án bất động sản. Công ty chính thức hoạt động dưới hình thức công ty cổ phần từ năm 2002. PCC là doanh nghiệp dẫn đầu trong lĩnh vực xây lắp bồn bể chứa xăng dầu, gas, hóa chất với hơn 45 năm kinh nghiệm. Công ty đã thi công nhiều dự án xây lắp bồn bể lớn trong nước như kho xăng dầu ngoại quan Vân Phong – Khánh Hòa, kho hóa chất Nhà Bè – thành phố Hồ Chí Minh, kho gas Hải Phòng, và kho xăng Hải Dương. Về lĩnh vực phát triển bất động sản, Công ty đã triển khai một số dự án như nhà ở tại Gia Lâm – Hà Nội và dự án tổ hợp văn phòng, trung tâm thương mại và nhà ở tại Long Biên – Hà Nội. PCC được giao dịch trên thị trường UPCoM từ cuối năm 2017.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-11-14","state":0.30001757,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV - Tổng Công ty Xây Lắp Và Thương Mại Petrolimex","p":null,"t":"CORPORATE","q":3450202,"pct":30.0,"d":"2026-06-11"},{"n":"Phạm Minh Tâm","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1200000,"pct":10.44,"d":"2026-08-10"},{"n":"Tổng Công ty Cổ phần Bảo hiểm Petrolimex","p":null,"t":"CORPORATE","q":1150066,"pct":10.0,"d":"2026-06-11"},{"n":"Đoàn Văn Mầu","p":null,"t":"INDIVIDUAL","q":291360,"pct":2.53,"d":"2025-10-05"},{"n":"Lê Thị Minh","p":null,"t":"INDIVIDUAL","q":287713,"pct":2.5,"d":"2025-10-05"},{"n":"Lê Quốc Bình","p":null,"t":"INDIVIDUAL","q":281702,"pct":2.45,"d":"2025-10-05"},{"n":"Nghiêm Văn Cương","p":null,"t":"