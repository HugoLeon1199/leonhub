ào khai thác (từ -100m đến -550m) được 84,437 triệu tấn. Ngày 23/07/2009, MDC chính thức giao dịch trên Sở giao dịch chứng khoán Hà Nội (HNX).","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2009-07-23","state":0.65,"foreign":0.17770882,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Công nghiệp Than - Khoáng sản Việt Nam","p":null,"t":"CORPORATE","q":13921925,"pct":65.0,"d":"2026-02-27"},{"n":"Raw & Refined Commodities AG","p":null,"t":"CORPORATE","q":3639268,"pct":16.99,"d":"2025-10-13"},{"n":"Mai Tất Lã","p":null,"t":"INDIVIDUAL","q":19973,"pct":0.132,"d":"2015-09-14"},{"n":"Tạ Văn Bền","p":null,"t":"INDIVIDUAL","q":8862,"pct":0.041,"d":"2025-10-05"},{"n":"Ngô Quốc Tuấn","p":null,"t":"INDIVIDUAL","q":2900,"pct":0.019,"d":"2015-09-14"},{"n":"Bùi Văn Kiểm","p":null,"t":"INDIVIDUAL","q":3366,"pct":0.016,"d":"2025-10-05"},{"n":"Hòa Quang Trung","p":null,"t":"INDIVIDUAL","q":3486,"pct":0.016,"d":"2025-10-05"},{"n":"Phạm Thị Hải","p":null,"t":"INDIVIDUAL","q":3168,"pct":0.015,"d":"2025-10-05"},{"n":"Nguyễn Văn Thành","p":null,"t":"INDIVIDUAL","q":1967,"pct":0.013,"d":"2015-09-14"},{"n":"Nguyễn Hữu Hùng","p":"Phó Giám đốc","t":"INDIVIDUAL","q":1772,"pct":0.01,"d":"2026-02-27"},{"n":"Vũ Tiến Quang","p":null,"t":"INDIVIDUAL","q":1109,"pct":0.01,"d":"2025-10-05"},{"n":"Nguyễn Thế Hanh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":1986,"pct":0.009,"d":"2026-02-27"},{"n":"Lại Quang Trung","p":"Phó Giám đốc","t":"INDIVIDUAL","q":1109,"pct":0.005,"d":"2026-02-27"},{"n":"Hoàng Trọng Hiệp","p":null,"t":"INDIVIDUAL","q":921,"pct":0.004,"d":"2025-10-30"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 600 VND","d":"2026-07-23","record":"2026-07-31","ex":"2026-07-30"},{"c":"AGME","t":"MDC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-17","record":"2026-03-25","ex":"2026-03-24"},{"c":"EGME","t":"MDC - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-09-17","record":"2025-09-30","ex":"2025-09-29"},{"c":"OTHE","t":"M