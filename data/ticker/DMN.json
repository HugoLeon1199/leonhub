 động tại khu vực các tỉnh miền Tây Nam Bộ. Công ty được thành lập từ năm 2008. Ngoài hoạt động chính kinh doanh thức ăn thuỷ sản, DMN còn kinh doanh cá tra nguyên liệu và kinh doanh nguyên liệu sản xuất thức ăn thuỷ sản. Hiện tại, công ty đang quản lý và vận hành một nhà máy sản xuất thức ăn thuỷ sản tại tỉnh Đồng Tháp với dây chuyền sản xuất khép kín, có công suất đạt 12 tấn thành phẩm/giờ. Sản phẩm được DMN vận chuyển trực tiếp đến tay khách hàng là các hộ chăn nuôi và nông dân tại Đồng Bằng Sông Cửu Long mà không thông qua các đại lý. Ngày 22/11/2021, DMN chính thức được giao dịch tại Thị trường Upcom.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2021-11-22","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Võ Đình Ân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":8996720,"pct":71.97,"d":"2026-07-28"},{"n":"Hà Thị Dạ Thảo","p":null,"t":"INDIVIDUAL","q":812000,"pct":6.5,"d":"2026-07-28"},{"n":"Nguyễn Thị Kiều Lệ","p":null,"t":"INDIVIDUAL","q":82000,"pct":0.66,"d":"2026-03-03"}],"rel":[{"c":"1402174632","n":"Công Ty TNHH Thủy Sản Hiệp Thành Phát","t":"subsidiary","pct":100.0},{"c":"1402051038","n":"Công ty Cổ Phần Thủy Sản Trường Phát","t":"affiliate","pct":39.2}],"rel_count":2,"events":[{"c":"AIS","t":"DMN - Đăng ký giao dịch bổ sung 4.999.990 cổ phiếu","d":"2026-08-17","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Cổ phiếu thưởng tỉ lệ 40.0%","d":"2026-06-26","record":"2026-07-08","ex":"2026-07-07"},{"c":"AGME","t":"DMN - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-19","record":"2026-03-31","ex":"2026-03-30"},{"c":"AGME","t":"DMN - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-02-24","record":"2025-03-10","ex":"2025-03-07"},{"c":"EGME","t":"DMN - Tổ chức ĐHĐCĐ bất thường 2024","d":"2024-10-17","record":"2024-10-30","ex":"2024-10-29"},{"c":"AGME","t":"DMN - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-01","record":"2024-03-11","ex":"2024-03-08"},{"c":"ISS","t":"Phát hành cổ