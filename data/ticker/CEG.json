ị Công nghiệp, được thành lập vào năm 1999 trên cơ sở cổ phần hóa Xí nghiệp sản xuất thiết bị xây dựng trực thuộc Công ty Kinh doanh Vật tư và Xây dựng. Công ty hoạt động chính trong lĩnh vực nghiên cứu, chế tạo, kinh doanh thiết bị máy xây dựng, thiết bị công nghiệp, đặc biệt là máy trộn bê tông. Sản phẩm của công ty đã được bán trên thị trường toàn quốc và xuất khẩu sang một số nước Đông Nam Á. Bên cạnh đó, Công ty tham gia đầu tư phát triển Dự án khu tổ hợp căn hộ, văn phòng tại 164 Khuất Duy Tiến, phường Nhân Chính, Quận Thanh Xuân, Thành phố Hà Nội.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2017-05-17","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Vũ Trọng Hiền","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":307489,"pct":8.09,"d":"2023-02-01"},{"n":"Trương Hữu Chí","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":273203,"pct":7.19,"d":"2025-02-18"},{"n":"Tạ Đình Lân","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":247635,"pct":6.517,"d":"2025-02-18"},{"n":"Lê Quốc Tuấn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":225782,"pct":5.942,"d":"2025-02-18"},{"n":"Lê Xuân Thắng","p":null,"t":"INDIVIDUAL","q":221555,"pct":5.83,"d":"2025-02-18"},{"n":"Đỗ Văn Vũ","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":214826,"pct":5.653,"d":"2025-02-18"},{"n":"Nguyễn Đức Minh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":197175,"pct":5.189,"d":"2025-02-18"},{"n":"Trương Minh Khôi","p":null,"t":"INDIVIDUAL","q":190000,"pct":5.0,"d":"2025-02-18"},{"n":"Trương Đắc Duy","p":null,"t":"INDIVIDUAL","q":190000,"pct":5.0,"d":"2025-02-18"},{"n":"Đỗ Quang Minh","p":null,"t":"INDIVIDUAL","q":184544,"pct":4.856,"d":"2025-02-18"},{"n":"Vũ Thị Anh Đào","p":null,"t":"INDIVIDUAL","q":163500,"pct":4.3,"d":"2018-01-08"},{"n":"Trần Thị Ngọc Tuyết","p":null,"t":"INDIVIDUAL","q":125700,"pct":3.308,"d":"2025-02-18"},{"n":"Nguyễn Thị Phương Nga","p":null,"t":"INDIVIDUAL","q":117456,"pct"