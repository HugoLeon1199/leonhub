hầu 1 đoạn Hà Nội – Vinh (310 tỷ đồng), Dự án xây dựng đường Hồ Chí Minh đoạn từ Km164+000 – Km321+000 tỉnh Thanh Hóa-Quảng Trị (677 tỷ đồng), Dự án đường ô tô cao tốc thành phố Hồ Chí Minh – Trung Lương (1.200 tỷ đồng), Dự án xây dựng đường vành đai 3 – Giai đoạn 2 – gói thầu 3 (1.338 tỷ đồng). Năm 2018, TTL chính thức được giao dịch tại Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2018-01-18","state":0.0,"foreign":0.07167367,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Đầu Tư Và Xây Dựng Tng","p":null,"t":"CORPORATE","q":21158908,"pct":50.5,"d":"2026-02-26"},{"n":"Phạm Tuấn Vũ","p":null,"t":"INDIVIDUAL","q":10500000,"pct":25.09,"d":"2025-10-05"},{"n":"Tổng Công ty Cổ phần Bảo hiểm Sài Gòn - Hà Nội","p":null,"t":"CORPORATE","q":3000000,"pct":7.16,"d":"2026-02-26"},{"n":"Bùi Quang Tùng","p":null,"t":"INDIVIDUAL","q":7100,"pct":0.017,"d":"2025-10-05"},{"n":"Nguyễn Anh Văn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":6500,"pct":0.016,"d":"2026-02-26"},{"n":"Đỗ Lê Khang","p":null,"t":"INDIVIDUAL","q":6700,"pct":0.016,"d":"2025-10-05"},{"n":"Hồ Thái Dương","p":null,"t":"INDIVIDUAL","q":6400,"pct":0.015,"d":"2025-10-05"},{"n":"Nguyễn Minh Tú","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":5000,"pct":0.01,"d":"2026-02-26"},{"n":"Trần Duy Hưởng","p":"Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":4000,"pct":0.01,"d":"2026-02-26"}],"rel":[{"c":"TLBJSC1","n":"Công ty Cổ phần Cầu 1 Thăng Long","t":"subsidiary","pct":82.65},{"c":"BOTYENLENH","n":"Công ty TNHH BOT Cầu Yên Lệnh","t":"affiliate","pct":70.0},{"c":"BOTYENLENH","n":"Công ty TNHH BOT Cầu Yên Lệnh","t":"subsidiary","pct":70.0},{"c":"TLG21","n":"Công ty Cổ phần Cầu 21 Thăng Long","t":"subsidiary","pct":65.0},{"c":"TLG35","n":"Công ty Cổ phần Cầu 35 Thăng Long","t":"subsidiary","pct":65.0},{"c":"BOT188","n":"Công ty TNHH B.O.T Đường 188","t":"affiliate","pct":22.03}],"rel_count":6,"e