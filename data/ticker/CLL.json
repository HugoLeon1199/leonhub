SE).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2014-07-08","state":0.47690941,"foreign":0.04378526,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Tổng Công ty Tân Cảng Sài Gòn","p":null,"t":"CORPORATE","q":8716170,"pct":25.636,"d":"2026-07-27"},{"n":"Công Ty TNHH Một Thành Viên Dịch Vụ Công Ích Thanh Niên Xung Phong","p":null,"t":"CORPORATE","q":7498750,"pct":22.055,"d":"2025-10-05"},{"n":"Samarang Ucits - Samarang Asian Prosperity","p":null,"t":"CORPORATE","q":1699652,"pct":4.99,"d":"2025-10-05"},{"n":"Bành Mỹ Hoà","p":null,"t":"INDIVIDUAL","q":1105616,"pct":3.252,"d":"2025-10-05"},{"n":"Bành Mỹ Hạnh","p":null,"t":"INDIVIDUAL","q":1075800,"pct":3.164,"d":"2025-10-05"},{"n":"Bành Mỹ Hậu","p":null,"t":"INDIVIDUAL","q":793100,"pct":2.333,"d":"2026-07-27"},{"n":"Hoàng Minh Thảo","p":"Phó Giám đốc","t":"INDIVIDUAL","q":589690,"pct":1.734,"d":"2026-07-27"},{"n":"Quang Tường Thụy","p":null,"t":"INDIVIDUAL","q":12610,"pct":0.037,"d":"2015-09-14"},{"n":"Nguyễn Huỳnh Mai","p":"Thành viên Hội đồng Quản trị độc lập","t":"INDIVIDUAL","q":5500,"pct":0.016,"d":"2026-07-27"},{"n":"Phạm Hiếu Đạo","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":4607,"pct":0.014,"d":"2026-07-27"},{"n":"Nguyễn Thành Sơn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2886,"pct":0.008,"d":"2026-07-27"},{"n":"Bùi Thị Thanh Hoa","p":null,"t":"INDIVIDUAL","q":2009,"pct":0.006,"d":"2025-10-05"},{"n":"Lê Thành Khoa","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.006,"d":"2025-10-05"}],"rel":[{"c":"CATLAILOGIS","n":"Công ty CP Tiếp Vận Quốc Tế Cảng Cát Lái","t":"subsidiary","pct":54.29},{"c":"TANCANGQV","n":"Công ty Cổ phần Tân Cảng Quế Võ","t":"affiliate","pct":20.0}],"rel_count":2,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 2,614 VND","d":"2026-07-24","record":"2026-08-03","ex":"2026-07-31"},{"c":"AGME","t":"CLL - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-17","record":"2026-05-04","ex