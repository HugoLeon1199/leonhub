,["2025",2.296]]}},"co":{"short":"ĐT DV Tài chính Hoàng Huy","profile":"Công ty Cổ phần Đầu tư Dịch vụ Tài chính Hoàng Huy (TCH) có tiền thân là Công ty TNHH Thương mại Hoàng Huy, được thành lập vào tháng 10/1995. TCH chuyên hoạt động trong lĩnh vực đầu tư kinh doanh bất động sản và lắp ráp phân phối xe ô tô đầu kéo. TCH hiện đang là nhà phân phối chính hãng xe tải thương hiệu International của hãng Navistar (Hoa Kỳ) và các dòng xe Dongfeng (Trung Quốc) tại thị trường Việt Nam. Công ty đã xây dựng hệ thống phân phối xe tải với hơn 25 đại lý trên toàn quốc. Trong lĩnh vực đầu tư kinh doanh bất động sản, TCH đã triển khai thực hiện nhiều dự án quy mô lớn như Hoang Huy Commerce, Hoang Huy New City, Hoang Huy Green River, .... TCH được giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2016.","sector":"Bất động sản","type":"CT","listed":"2016-10-05","state":0.0,"foreign":0.10150044,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đỗ Hữu Hạ","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":275227036,"pct":30.17,"d":"2026-08-10"},{"n":"Công ty CỔ PHẦN HH FINANCE","p":null,"t":"CORPORATE","q":53020170,"pct":5.81,"d":"2026-08-10"},{"n":"Nguyễn Thị Hà","p":null,"t":"INDIVIDUAL","q":42463102,"pct":4.89,"d":"2025-10-05"},{"n":"Nguyễn Thị Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":44586257,"pct":4.888,"d":"2026-08-10"},{"n":"Trần Thị Hoàng Hà","p":null,"t":"INDIVIDUAL","q":23091118,"pct":3.46,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Hh Investment","p":null,"t":"CORPORATE","q":29547940,"pct":3.24,"d":"2026-08-10"},{"n":"Hanoi Investments Holdings Limited","p":null,"t":"CORPORATE","q":12067360,"pct":1.323,"d":"2026-05-26"},{"n":"Vietnam Enterprise Investments Limited","p":null,"t":"CORPORATE","q":10193066,"pct":1.117,"d":"2026-06-19"},{"n":"Hoàng Thị Huyên","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":8967122,"pct":0.98,"d":"2026-08-10"},{"n":"Amersham Industries Limited","p":null,"t":"CORPORATE","q":735