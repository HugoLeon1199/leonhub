6-Q2",7.043]],"y":[["2018",7.538],["2019",7.305],["2020",5.48],["2021",4.933],["2022",5.964],["2023",5.726],["2024",4.197],["2025",4.834]]}},"co":{"short":"Thiết bị Bưu điện Postef","profile":"Công ty Cổ phần Thiết bị Bưu điện (POT), tiền thân là Cơ xưởng Bưu điện Trung Ương, được thành lập năm 1954. Năm 2004, Công ty chuyển đổi mô hình kinh doanh hoạt động là Công ty Cổ phần. Công ty chuyền về xuất khẩu, nhập khẩu vật tư, thiết bị, lắp đặt máy móc chuyên ngành bưu chính, viễn thông, điện tử, tin học. Công ty có thị trường tiêu thụ ổn định với 90% tổng giá trị sản phẩm được tiêu thụ bởi các công ty trong tập đoàn VNPT. Ngoài ra, sản phẩm của công ty còn được xuất khẩu sang thị trường Lào, Hàn Quốc, Campuchia, Châu Phi và Achentina. Với 3 chi nhánh và 5 nhà máy đặt cả ba miền Bắc, Trung, Nam và 3 công to con, sản phẩm của công ty được tiêu thụ trên địa bàn toàn quốc. Hà Nội và thành phố Hồ Chí Minh chiếm trên 90% tổng doanh thu của công ty. Ngày 20/12/2006, POT chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Công nghệ Thông tin","type":"CT","listed":"2006-12-20","state":0.49995867,"foreign":0.00062692,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập Đoàn Bưu Chính Viễn Thông Việt Nam","p":null,"t":"CORPORATE","q":9714200,"pct":49.996,"d":"2026-02-24"},{"n":"Nguyễn Thị Thùy Dương","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":3078562,"pct":15.84,"d":"2026-08-10"},{"n":"Công ty Cổ phần Chứng khoán LPBank","p":null,"t":"CORPORATE","q":2200000,"pct":11.32,"d":"2025-10-05"},{"n":"Phạm Thị Thanh Hồng","p":null,"t":"INDIVIDUAL","q":882320,"pct":4.54,"d":"2025-10-05"},{"n":"Nguyễn Tuấn Hà","p":null,"t":"INDIVIDUAL","q":574280,"pct":2.96,"d":"2025-10-05"},{"n":"Trần Hải Vân","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":203323,"pct":1.046,"d":"2026-08-10"},{"n":"Nguyễn Huyền Sơn","p":null,"t":"INDIVIDUAL","q":47394,"pct":0.244,"d":"2025-10-05"},{"n":"Vương Xuân Hoà","p":null,"t":"INDIVIDUAL",