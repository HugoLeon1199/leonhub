 có giá trị bằng 66,05 tỷ đồng, tăng 55.8% so với cùng kỳ. Nợ vay ký quỹ/Vốn chủ sở hữu ở mức 192.31%. Lợi nhuận trước thuế có giá trị bằng -38.37 tỷ đồng, giảm 47.72%. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức -16.1%. SBS được giao dịch trên thị trường UPCOM từ tháng 04/2014.","sector":"Dịch vụ tài chính","type":"CK","listed":"2010-07-05","state":0.0,"foreign":0.00844111,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"La Mỹ Phượng","p":null,"t":"INDIVIDUAL","q":9123610,"pct":6.22,"d":"2025-10-05"},{"n":"Lưu Thị Lợi","p":null,"t":"INDIVIDUAL","q":3000000,"pct":2.37,"d":"2025-10-05"},{"n":"Ngô Quảng Phú","p":null,"t":"INDIVIDUAL","q":307333,"pct":0.243,"d":"2015-09-14"},{"n":"Nguyễn Huy Cường","p":null,"t":"INDIVIDUAL","q":250333,"pct":0.198,"d":"2015-09-14"},{"n":"Nguyễn Thanh Phong","p":null,"t":"INDIVIDUAL","q":175000,"pct":0.138,"d":"2015-09-14"},{"n":"Thiều Minh Anh Thư","p":null,"t":"INDIVIDUAL","q":161483,"pct":0.127,"d":"2015-09-14"},{"n":"Trần Thanh Hải","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.079,"d":"2015-09-14"},{"n":"Nguyễn Bích Thủy","p":null,"t":"INDIVIDUAL","q":37450,"pct":0.03,"d":"2015-09-14"},{"n":"Đinh Nguyễn Hoài Phương","p":null,"t":"INDIVIDUAL","q":26950,"pct":0.021,"d":"2015-09-14"},{"n":"Hoàng Khánh Sinh","p":null,"t":"INDIVIDUAL","q":23333,"pct":0.018,"d":"2015-09-14"},{"n":"Nguyễn Thị Bình","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.016,"d":"2015-09-14"},{"n":"Trần Minh Trung","p":null,"t":"INDIVIDUAL","q":320,"pct":0.0,"d":"2015-09-14"},{"n":"Đinh Hoài Châu","p":null,"t":"INDIVIDUAL","q":3,"pct":0.0,"d":"2015-09-14"}],"events":[{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 10.2%","d":"2026-08-20","record":"2026-08-19","ex":"2026-08-19"},{"c":"AGME","t":"SBS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-11","record":"2026-03-25","ex":"2026-03-24"},{"c":"ISS","t":"Phát hành cổ phiếu - Phát hành riêng lẻ tỉ lệ 34.1%","d":"2025-12-30","record":null,"ex":null},{"c":"AGME","t":"SBS 