2025-Q4",3.043],["2026-Q2",3.043]],"y":[["2018",-19.0],["2019",35.951],["2020",0.0],["2021",0.048],["2022",6.47],["2023",10.61],["2024",0.168],["2025",3.043]]}},"co":{"short":"Đảm bảo GTĐT Hải Phòng","profile":"Công ty Cổ phần Đảm bảo Giao thông Đường thủy Hải Phòng (DDH) có tiền thân là Đội Công trình III, được thành lập vào ngày 04/09/1972. DDH hoạt động chính trong lĩnh vực quản lý, bảo trì hệ thống đường thủy nội địa, điều tiết đảm bảo giao thông phục vụ thi công, chế tạo và lắp đặt hệ thống báo hiệu giao thông cũng như nạo vét luồng tuyến đường thủy. Công ty chính thức hoạt động dưới hình thức Công ty cổ phần từ 2016. Công ty tham gia tổ chức quản lý, đảm bảo giao thông thông suốt, an toàn cho các phương tiện và hành khách qua lại các bến phà, cầu phao: Bến phà Đình, bến phà Gót, cầu phao sông Hóa. DDH được giao dịch trên thị trường UPCOM từ tháng 06/2016.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-06-30","state":0.65,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Thành Phố Hải Phòng","p":null,"t":"CORPORATE","q":2340000,"pct":65.0,"d":"2025-10-05"},{"n":"Công ty Cổ phần Khu du lịch Đảo Cát Bà","p":null,"t":"CORPORATE","q":519172,"pct":14.42,"d":"2025-10-05"},{"n":"Công ty Cổ phần Công trình Giao thông và cơ giới","p":null,"t":"CORPORATE","q":180000,"pct":5.0,"d":"2025-10-05"},{"n":"Đỗ Văn Thuận","p":null,"t":"INDIVIDUAL","q":30459,"pct":0.846,"d":"2025-10-05"},{"n":"Bùi Thị Ninh","p":null,"t":"INDIVIDUAL","q":27459,"pct":0.76,"d":"2026-08-24"},{"n":"Nguyễn Thị Sáng","p":null,"t":"INDIVIDUAL","q":17729,"pct":0.492,"d":"2026-08-24"},{"n":"Đặng Văn Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":16629,"pct":0.46,"d":"2026-08-24"},{"n":"Phạm Thị Ngọc Hoa","p":null,"t":"INDIVIDUAL","q":16229,"pct":0.45,"d":"2026-07-09"},{"n":"Bùi Hữu Hà","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":2600,"pct":0.07,"d":"2026-08-24"},{"n":"Lại Văn Phượng","p":null,"t":"IND