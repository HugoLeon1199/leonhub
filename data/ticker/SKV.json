ch trên thị trường UPCOM từ đầu tháng 11/2017.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2017-11-03","state":0.51,"foreign":0.00016522,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH Nhà nước MTV Yến Sào Khánh Hòa","p":null,"t":"CORPORATE","q":11730000,"pct":51.0,"d":"2026-08-07"},{"n":"Đinh Viết Thuận","p":null,"t":"INDIVIDUAL","q":69040,"pct":0.3,"d":"2025-10-05"},{"n":"Trần Văn Ngân","p":null,"t":"INDIVIDUAL","q":57800,"pct":0.251,"d":"2026-02-23"},{"n":"Công ty CP Du Lịch Thương Mại Nha Trang","p":null,"t":"CORPORATE","q":27920,"pct":0.12,"d":"2026-04-22"},{"n":"Đặng Minh Thích","p":null,"t":"INDIVIDUAL","q":11600,"pct":0.05,"d":"2026-02-23"},{"n":"Huỳnh Bá","p":null,"t":"INDIVIDUAL","q":11000,"pct":0.048,"d":"2025-10-05"},{"n":"Huỳnh Thị Trần Lê","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":8000,"pct":0.034,"d":"2026-08-07"},{"n":"Huỳnh Đức Trọng","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc Kinh doanh","t":"INDIVIDUAL","q":7100,"pct":0.031,"d":"2026-08-07"},{"n":"Nguyễn Khoa Bảo","p":null,"t":"INDIVIDUAL","q":7200,"pct":0.031,"d":"2026-05-11"},{"n":"Phan Thị Giang","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":7200,"pct":0.031,"d":"2026-08-07"},{"n":"Phạm Quốc Hùng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":7100,"pct":0.031,"d":"2026-08-07"},{"n":"Trịnh Thị Hồng Vân","p":null,"t":"INDIVIDUAL","q":5800,"pct":0.025,"d":"2026-02-23"},{"n":"Phạm Thị Thu Huyền","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":5000,"pct":0.022,"d":"2026-08-07"},{"n":"Phạm Thị Lành","p":null,"t":"INDIVIDUAL","q":4700,"pct":0.02,"d":"2025-10-05"},{"n":"Phạm Duy Hưng","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":3300,"pct":0.014,"d":"2026-08-07"},{"n":"Phạm Thị Duy Trinh","p":"Kế toán trưởng","t":"INDIVIDUAL","q":3100,"pct":0.013,"d":"2026-08-07"},{"n":"Bùi Hoàng Phong Lan","p":null,"t":"INDIVIDUAL","q":3400,"pct":0.01,"d":"2025-