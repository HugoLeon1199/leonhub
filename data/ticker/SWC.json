bao gồm đội tàu 23 chiếc, cảng Sowatco Long Bình diện tích khoảng 200.000 m² và hệ thống kho bãi khoảng 43.125 m². Ngoài vận tải và khai thác cảng, SOWATCO còn vận hành các bến phao, thiết bị bốc xếp và xưởng đóng mới, sửa chữa tàu thủy phục vụ chuỗi dịch vụ logistics đường thủy. SWC được giao dịch tại thị trường UPCoM từ Ngày 29/04/2011.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2011-04-29","state":0.0,"foreign":0.00031013,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Đầu Tư Hạ Tầng Sotrans","p":null,"t":"CORPORATE","q":56625000,"pct":84.39,"d":"2026-08-06"},{"n":"Công ty Cổ phần Kho Vận Miền Nam","p":null,"t":"CORPORATE","q":6000000,"pct":8.94,"d":"2026-08-06"},{"n":"Trần Huy Hiền","p":null,"t":"INDIVIDUAL","q":13893,"pct":0.021,"d":"2015-09-14"},{"n":"Tô Hữu Hùng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":11600,"pct":0.017,"d":"2026-08-06"},{"n":"Hoàng Quyến","p":null,"t":"INDIVIDUAL","q":9267,"pct":0.014,"d":"2015-09-14"},{"n":"Trịnh Văn Quý","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1100,"pct":0.002,"d":"2026-08-06"},{"n":"Phạm văn Tài","p":null,"t":"INDIVIDUAL","q":700,"pct":0.001,"d":"2015-09-14"},{"n":"Quỹ Đầu tư Giá trị MB Capital","p":null,"t":"CORPORATE","q":100,"pct":0.0,"d":"2020-07-14"}],"rel":[{"c":"2301257330","n":"Công ty CP Sowatco Tri Phương","t":"subsidiary","pct":99.997},{"c":"ECCO","n":"Công ty Cổ Phần Xây Lắp Công Trình","t":"subsidiary","pct":99.02},{"c":"CTSHIPYARD","n":"Công ty Cổ phần Đóng Mới Và Sửa Chữa Phương Tiện Thủy Cần Thơ","t":"subsidiary","pct":70.0},{"c":"SOWATMES","n":"Công ty Cổ Phần Dịch Vụ Xây Dựng Và Cơ Khí Đường Thủy Miền Nam","t":"subsidiary","pct":51.0},{"c":"LOGIS1","n":"Công Ty Liên Doanh Phát Triển Tiếp Vận Số 1","t":"affiliate","pct":37.0},{"c":"SOWATCOSER","n":"Công Ty Cổ Phần Dịch Vụ Tổng Hợp Đường Thủy Miền Nam","t":"affiliate","pct":26.27},{"c":"PDN","n":"Công ty Cổ phần Cảng Đồng Nai","t":"affiliate","pct":20.25}],"rel_count":7,"events":