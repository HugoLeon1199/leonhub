ành lập vào năm 1973. Công ty hoạt động chính trong lĩnh vực sản xuất và kinh doanh các sản phẩm phân bón, với sản phẩm chính phân bón Đầu Trâu. BFC được cổ phần hóa và hoạt động theo hình thức công ty cổ phần từ năm 2011. Công ty là doanh nghiệp dẫn đầu về năng lực sản xuất và thị phần phân bón NPK trên thị trường Việt Nam. Công ty hiện quản lý 1 nhà máy chính và có 5 công ty thành viên. BFC chiếm 28% thị phần phân bón khu vực phía Nam và Tây Nguyên, 10% thị phần khu vực miền trung và 10% thị phần khu vực miền Bắc. BFC được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2015.","sector":"Hóa chất","type":"CT","listed":"2015-10-07","state":0.65000008,"foreign":0.00120219,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Hóa chất Việt Nam","p":null,"t":"CORPORATE","q":37159200,"pct":65.0,"d":"2026-06-02"},{"n":"Lê Quốc Phong","p":null,"t":"INDIVIDUAL","q":163440,"pct":0.29,"d":"2025-10-05"},{"n":"Lê Thị Ngân","p":null,"t":"INDIVIDUAL","q":7300,"pct":0.01,"d":"2026-06-02"},{"n":"Võ Văn Phu","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":2448,"pct":0.004,"d":"2026-07-31"},{"n":"Phan Văn Tâm","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":26,"pct":0.0,"d":"2026-07-31"},{"n":"Võ Đình Chinh","p":null,"t":"INDIVIDUAL","q":168,"pct":0.0,"d":"2026-06-02"}],"rel":[{"c":"BDLAS","n":"Công ty TNHH MTV Thể Thao Bình Điền - Long An","t":"subsidiary","pct":100.0},{"c":"BLCO","n":"Công ty Cổ phần Bình Điền - Lâm Đồng","t":"subsidiary","pct":51.0},{"c":"BDMEKONG","n":"Công ty Cổ phần Bình Điền - Mekong","t":"subsidiary","pct":51.0},{"c":"BDNB","n":"Công ty Cổ phần Bình Điền - Ninh Bình","t":"subsidiary","pct":51.0},{"c":"BDQT","n":"Công ty Cổ phần Bình Điền - Quảng Trị","t":"subsidiary","pct":51.0}],"rel_count":5,"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2025 - 3,500 VND","d":"2026-07-21","record":"2026-08-12","ex":"2026-08-11"},{"c":"AGME","t":"BFC - Tổ chức 