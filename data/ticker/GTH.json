588]]}},"co":{"short":"XD-GT Thừa Thiên Huế","profile":"Công ty Cổ phần Xây dựng - Giao thông Thừa Thiên Huế (GTH) có tiền thân là doanh nghiệp nhà nước - Công ty Công trình Giao thông được thành lập vào năm 1993. Lĩnh vực kinh doanh của Công ty là xây dựng cầu, đường giao thông; kinh doanh xăng dầu, sản xuất và kinh doanh đá xây dựng. Sản phẩm của công ty chủ yếu được tiêu thụ tại tỉnh Quảng Trị và Thừa Thiên Huế. Hiện tại Công ty chiếm một thị phần lớn và đáng kể trong lĩnh vực xây dựng giao thông, Dân dụng – Công nghiệp, Hạ tầng và Thủy lợi tại Thừa Thiên Huế và khu vực lân cận.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-10-28","state":0.0,"foreign":0.0207,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Phạm Văn Đức","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":658865,"pct":24.09,"d":"2023-01-31"},{"n":"Nguyễn Đăng Bảo","p":"Phó Chủ tịch Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":373980,"pct":13.67,"d":"2023-01-31"},{"n":"Trần Chính","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":292163,"pct":10.68,"d":"2023-01-31"},{"n":"Ngô Thị Lệ Hương","p":"Kế toán trưởng","t":"INDIVIDUAL","q":165504,"pct":6.05,"d":"2023-01-31"},{"n":"Đặng Quý","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":155683,"pct":5.69,"d":"2023-01-31"},{"n":"Ngô Thị Hạnh","p":null,"t":"INDIVIDUAL","q":101600,"pct":4.233,"d":"2015-09-14"},{"n":"Công ty cổ phần An Phú Thừa Thiên Huế","p":null,"t":"CORPORATE","q":68000,"pct":2.49,"d":"2016-06-16"},{"n":"Trần Phúc Tuấn","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":33106,"pct":1.379,"d":"2022-03-25"},{"n":"Phan Văn Dương","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":31180,"pct":1.14,"d":"2022-03-25"},{"n":"Lê Quang Hùng","p":null,"t":"INDIVIDUAL","q":25000,"pct":1.042,"d":"2015-09-14"},{"n":"Nguyễn Viết Phú","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.833,"d":"2015-09-14"},{"n":"Phạm Văn Minh","p":null,"t":"INDIVIDUAL","q":20204,"pct":0.74,"d":"2016-07-27"},{"n":"Dươn