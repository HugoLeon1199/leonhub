t, đá, cát sỏi và mua bán vật liệu xây dựng. Công ty đã thi công nhiều công trình lớn trên địa bàn tỉnh Hà Nam như thi công đường trục huyện Duy Tiên tuyến Đền Thánh An Mông, đường giao thông liên xã Hòa Mạc - Châu Giang - Mộc Bắc, huyện Duy Tiên, Đường tỉnh lộ huyện Lý Nhân - Duy Tiên, thi công đường N5 thị xã Phú Lý, xây dựng trường THPT Lý Thường Kiệt, trường THPT B Duy Tiên; cung cấp vật liệu xây dựng phục vụ dự án thi công đường cao tốc Cầu Giẽ - Ninh Bình. NHA được niêm yết trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ tháng 12/2020.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-07-13","state":0.0,"foreign":0.00251282,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Minh Hoàn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":14797786,"pct":22.84,"d":"2026-08-06"},{"n":"Nguyễn Hoàng Đạo","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3465181,"pct":5.35,"d":"2026-08-06"},{"n":"Nguyễn Đức Kiên","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":3206464,"pct":4.95,"d":"2026-08-06"},{"n":"Nguyễn Ngọc Hương","p":null,"t":"INDIVIDUAL","q":2331829,"pct":3.27,"d":"2026-08-28"},{"n":"Nguyễn Thành Mỹ","p":null,"t":"INDIVIDUAL","q":1540000,"pct":2.377,"d":"2026-08-06"},{"n":"Tạ Ngọc Nhất","p":null,"t":"INDIVIDUAL","q":1390113,"pct":2.15,"d":"2026-08-06"},{"n":"Nguyễn Hoàng Minh","p":null,"t":"INDIVIDUAL","q":1000000,"pct":1.54,"d":"2026-08-06"},{"n":"Nguyễn Văn Hùng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":630277,"pct":0.973,"d":"2026-08-06"},{"n":"Nguyễn Đắc Long","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":535466,"pct":0.83,"d":"2026-08-06"},{"n":"Vũ Trọng Linh","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":500000,"pct":0.7,"d":"2026-08-28"},{"n":"Cù Đức Ngọc","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":91666,"pct":0.14,"d":"2026-08-06"},{"n":"Lâm Thị Thu Trang","p":null,"t":"INDIVIDUAL","q