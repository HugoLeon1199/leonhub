 giao dịch trên Sở giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE). Năm 2024, so với cùng kỳ, biên lãi thuần (NIM) ở mức 3.27%, giảm 0.26%. Tỷ lệ nợ xấu ở mức 2.9%, giảm 0.12%. Tỷ lệ bao phủ nợ xấu ở mức 58.39%, giảm 10.35%. Lợi nhuận sau thuế công ty mẹ có giá trị bằng 9,3 nghìn tỷ đồng, tăng 27.27%. Tỷ suất lợi nhuận trên vốn chủ sở hữu (ROE) ở mức 17.24%, tăng 1.48%.","sector":"Ngân hàng","type":"NH","listed":"2009-04-20","state":0.00574134,"foreign":0.03828748,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn T&T","p":null,"t":"CORPORATE","q":360471376,"pct":6.75,"d":"2026-07-30"},{"n":"VanEck Vietnam ETF","p":null,"t":"CORPORATE","q":34813621,"pct":3.672,"d":"2015-06-15"},{"n":"Đỗ Vinh Quang","p":null,"t":"INDIVIDUAL","q":134526478,"pct":2.52,"d":"2026-07-30"},{"n":"Đỗ Quang Vinh","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":127165207,"pct":2.38,"d":"2026-07-30"},{"n":"Đỗ Quang Hiển","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":125163350,"pct":2.34,"d":"2026-07-30"},{"n":"Đỗ Thị Thu Hà","p":null,"t":"INDIVIDUAL","q":93372853,"pct":1.848,"d":"2026-05-04"},{"n":"Công ty Cổ phần Xuất Nhập Khẩu Thủ Công Mỹ Nghệ","p":null,"t":"CORPORATE","q":89513704,"pct":1.675,"d":"2026-07-30"},{"n":"Công ty Cổ phần Quản lý Quỹ PVI","p":null,"t":"CORPORATE","q":74451614,"pct":1.393,"d":"2026-06-04"},{"n":"Công ty Cổ phần Chứng khoán Sài Gòn - Hà Nội","p":null,"t":"CORPORATE","q":67211421,"pct":1.26,"d":"2026-07-30"},{"n":"Quỹ Đầu Tư Hạ Tầng PVI","p":null,"t":"CORPORATE","q":50000000,"pct":0.936,"d":"2026-06-04"},{"n":"Quỹ Đầu tư HPP","p":null,"t":"CORPORATE","q":37500000,"pct":0.702,"d":"2026-06-04"},{"n":"Công ty Cổ phần Chứng khoán VIX","p":null,"t":"CORPORATE","q":16000000,"pct":0.299,"d":"2026-06-04"},{"n":"NGUYỄN VĂN LÊ","p":null,"t":"INDIVIDUAL","q":6052731,"pct":0.227,"d":"2025-10-05"},{"n":"Phan Huy Chí","p":null,"t":"INDIVIDUAL","q":1635980,"pc