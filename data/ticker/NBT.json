vào năm 1992. Công ty hoạt động trong lĩnh vực xử lý và cung cấp nước trên địa bàn tỉnh Bến Tre. NBT chính thức hoạt động theo mô hình công ty cổ phần từ năm 2015. Công ty có các nhà máy nước ở xã Sơn Đông (thành phố Bến Tre) và xã Hữu Định (huyện Châu Thành), công suất 32.000 m3/ngày đêm, nhà máy nước Lương Quới công suất 6000 m3 / ngày đêm và nhà máy cấp nước Chợ Lách, công suất 1.000 m3/ngày đêm. . NBT được giao dịch trên thị trường UPCOM từ tháng 06/2016.","sector":"Điện, nước & xăng dầu khí đốt","type":"CT","listed":"2016-06-01","state":0.64,"foreign":0.005,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ủy Ban Nhân Dân Tỉnh Bến Tre","p":null,"t":"CORPORATE","q":18816000,"pct":64.0,"d":"2026-07-07"},{"n":"Ủy Ban Nhân Dân Tỉnh Vĩnh Long","p":null,"t":"CORPORATE","q":18816000,"pct":64.0,"d":"2026-09-03"},{"n":"Công ty CP Cấp Thoát Nước Thủy Anh","p":null,"t":"CORPORATE","q":5109510,"pct":17.379,"d":"2026-09-03"},{"n":"Công ty TNHH Hoàn Cầu","p":null,"t":"CORPORATE","q":4410000,"pct":15.0,"d":"2026-09-03"},{"n":"Nguyễn Thị Diễm Phượng","p":null,"t":"INDIVIDUAL","q":37590,"pct":0.128,"d":"2025-10-05"},{"n":"Lê Thị Hồng Thắm","p":null,"t":"INDIVIDUAL","q":31950,"pct":0.109,"d":"2026-01-28"},{"n":"Võ Thị Thiên Trang","p":"Kế toán trưởng","t":"INDIVIDUAL","q":20865,"pct":0.071,"d":"2026-09-03"},{"n":"Phan Thành Nhân","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":17115,"pct":0.058,"d":"2026-09-03"},{"n":"Lê Văn Phong","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":13230,"pct":0.045,"d":"2026-09-03"},{"n":"Trần Thanh Bình","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":10450,"pct":0.04,"d":"2026-09-03"},{"n":"Trần Hùng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":7770,"pct":0.026,"d":"2026-09-03"},{"n":"Nguyễn Trung Hiếu","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":6405,"pct":0.022,"d":"2026-09-03"},{"n":"Phan Thanh Bình","p":"Thành viên Hội đồng Quản trị/Phó Tổ