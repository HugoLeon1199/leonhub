6 công ty chính thức hoạt động theo mô hình cổ phần với số vốn điều lệ là 300 tỷ đồng. Hoạt động kinh doanh chính của Công ty là trồng, khai thác, chế biến cao su nguyên liệu và tiêu thụ sản phẩm. Hiện nay Công ty đang sở hữu hơn 7.000 ha cao su, hai nhà máy chế biến mủ cốm và hai dây chuyền chế biến mủ ly tâm với máy móc và thiết bị hiện đại. Sản phẩm cao su của Công ty đã đạt chất cao theo tiêu chuẩn quốc tế. Sản lượng tiêu thụ của Công ty được xuất sang các thị trường Indonesia, Singapore, Hàn quốc, Mỹ, Trung quốc, Thổ nhĩ kỳ. TRC chính thức được niêm yết và giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2007.","sector":"Hóa chất","type":"CT","listed":"2007-07-24","state":0.6,"foreign":0.00691087,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Công nghiệp Cao su Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":18000000,"pct":60.0,"d":"2026-07-30"},{"n":"Trần Hoàng Tuấn","p":null,"t":"INDIVIDUAL","q":1534900,"pct":5.12,"d":"2026-07-30"},{"n":"Công ty Cổ phần Đầu tư Sài Gòn VRG","p":null,"t":"CORPORATE","q":1447000,"pct":4.82,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Đầu Tư Và Phát Triển Vrg Long Thành","p":null,"t":"CORPORATE","q":399100,"pct":1.33,"d":"2025-10-05"},{"n":"Lê Bá Thọ","p":null,"t":"INDIVIDUAL","q":23200,"pct":0.08,"d":"2015-09-14"},{"n":"Nguyễn Văn Bấc","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.014,"d":"2015-09-14"},{"n":"Trịnh Văn Vĩnh","p":null,"t":"INDIVIDUAL","q":3700,"pct":0.013,"d":"2015-09-14"},{"n":"Khúc Đình An","p":null,"t":"INDIVIDUAL","q":3000,"pct":0.01,"d":"2015-09-14"},{"n":"Trần Văn Rạnh","p":null,"t":"INDIVIDUAL","q":2800,"pct":0.01,"d":"2015-09-14"},{"n":"Nguyễn Thanh Liêm","p":null,"t":"INDIVIDUAL","q":2700,"pct":0.009,"d":"2015-09-14"},{"n":"Nguyễn Văn Mết","p":null,"t":"INDIVIDUAL","q":2500,"pct":0.009,"d":"2015-09-14"},{"n":"Vương Thị Rang","p":null,"t":"INDIVIDUAL","q":2400,"pct":0.008,"d":"2015-09-14"},{"n":"Võ Trần Minh Đăng","p":"Thành viên Hội 