961]],"y":[["2022",12.929],["2023",10.809],["2024",8.695],["2025",6.535]]}},"co":{"short":"Tập đoàn Giáo dục Trí Việt","profile":"Công ty cổ phần Tập đoàn Giáo dục Trí Việt (CAR) là một doanh nghiệp hoạt động trong lĩnh vực giáo dục, được thành lập từ năm 2013. Hoạt động kinh doanh chính của công ty là cung cấp các dịch vụ giáo dục kỹ năng sống và tiếng Anh. CAR hiện là đơn vị độc quyền nhận nhượng quyền sản phẩm giáo dục từ Tập đoàn Giáo dục Fastrackids (Mỹ). Công ty chủ yếu kinh doanh tại thị trường Hà Nội. Các lớp chính khóa, ngoại khóa về kỹ năng sống đã được công ty tổ chức giảng dạy tại hơn 30 trường tại nhiều quận nội thành Hà Nội như THCS Marie Curie, trường Liên cấp Đa trí tuệ, Tiểu học Mỹ Đình 1,... Ngày 23/10/2024, CAR chính thức giao dịch trên Sở giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2022-07-13","state":0.0,"foreign":7.907e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Thùy Thương","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":884950,"pct":15.9,"d":"2026-08-06"},{"n":"Công ty Cổ Phần Đầu Tư Và Tư Vấn Ib Plus","p":null,"t":"CORPORATE","q":285700,"pct":5.13,"d":"2026-07-23"},{"n":"Đỗ Quốc Hùng","p":null,"t":"INDIVIDUAL","q":204600,"pct":3.68,"d":"2026-07-23"},{"n":"Nguyễn Hoàng Thơ","p":null,"t":"INDIVIDUAL","q":198000,"pct":3.56,"d":"2026-07-23"},{"n":"Công ty Cổ Phần Fibo Invest","p":null,"t":"CORPORATE","q":101260,"pct":1.82,"d":"2026-07-27"},{"n":"Đào Đức Việt","p":null,"t":"INDIVIDUAL","q":117240,"pct":1.66,"d":"2025-10-05"},{"n":"Nguyễn Trường Giang","p":null,"t":"INDIVIDUAL","q":38500,"pct":1.2,"d":"2025-10-05"},{"n":"Vũ Thu Hằng","p":null,"t":"INDIVIDUAL","q":1320,"pct":0.02,"d":"2026-07-17"},{"n":"Hoàng Giang","p":null,"t":"INDIVIDUAL","q":100,"pct":0.003,"d":"2025-10-05"},{"n":"Phạm Thị Anh","p":null,"t":"INDIVIDUAL","q":100,"pct":0.003,"d":"2025-10-05"}],"events":[{"c":"DDIND","t":"Nguyễn Thùy Thương - Đăng kí Bán 88