g thủy nội địa và kinh doanh nhiên liệu xăng dầu. DT4 hoạt động theo mô hình công ty cổ phần từ năm 2015. DT4 quản lý 352 km đường thủy nội địa quốc gia thuộc 7 con sông, gồm 48 km sông Đuống, 104 km sông Cầu, 19 km sông Công, 62 km sông Thương, 7 km sông Thái Bình, 56 km sông Lục Nam và 56 km sông Bằng Giang. Địa bàn quản lý thuộc 6 tỉnh thành là Bắc Ninh, Bắc Giang, Hải Dương, Hà Nội, Thái Nguyên và Cao Bằng, đi qua 21 huyện, thị xã và 159 xã, phường, thị trấn.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2016-07-19","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Dương Hải Thanh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":701700,"pct":60.49,"d":"2022-05-12"},{"n":"Phạm Hồng Minh","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":77500,"pct":6.68,"d":"2022-05-12"},{"n":"Nguyễn Phi Trường","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":60700,"pct":5.23,"d":"2022-05-12"},{"n":"Công ty TNHH Ứng dụng công nghệ Việt Nhật","p":null,"t":"CORPORATE","q":45000,"pct":3.88,"d":"2021-06-07"},{"n":"Trần Văn Ơn","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":44700,"pct":3.85,"d":"2022-05-12"},{"n":"Nguyễn Văn Tặng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":43900,"pct":3.78,"d":"2022-05-12"},{"n":"Trịnh Đình Kiêm","p":"Thành viên Hội đồng Quản trị/Phó Giám đốc","t":"INDIVIDUAL","q":40100,"pct":3.46,"d":"2022-05-12"},{"n":"Phạm Văn Hanh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":28000,"pct":2.41,"d":"2022-05-12"},{"n":"Trần Thị Thoan","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":3000,"pct":0.26,"d":"2022-03-29"},{"n":"Vũ Xuân Trường","p":"Kế toán trưởng","t":"INDIVIDUAL","q":1200,"pct":0.1,"d":"2022-05-12"},{"n":"Nguyễn Thị Hằng","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":1100,"pct":0.09,"d":"2022-05-12"},{"n":"Trần Thị Kiều","p":null,"t":"INDIVIDUAL","q":300,"pct":0.03,"d":"2020-05-07"}],"event