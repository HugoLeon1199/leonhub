ính thức được niêm yết và giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh từ năm 2010.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-09-08","state":0.51,"foreign":0.00834361,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Hàng hải Việt Nam - CTCP","p":null,"t":"CORPORATE","q":71400000,"pct":51.0,"d":"2026-08-24"},{"n":"Tổng Công ty Lương thực Miền Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":2900000,"pct":2.071,"d":"2015-06-15"},{"n":"Quỹ Đầu Tư Chứng Khoán Bảo Việt","p":null,"t":"CORPORATE","q":2253120,"pct":1.609,"d":"2015-06-15"},{"n":"Tập đoàn Bảo Việt","p":null,"t":"CORPORATE","q":1000000,"pct":0.714,"d":"2015-06-15"},{"n":"Credit Suise (Hong Kong) Limited","p":null,"t":"CORPORATE","q":201710,"pct":0.144,"d":"2015-06-15"},{"n":"Cao Minh Tuấn","p":null,"t":"INDIVIDUAL","q":75000,"pct":0.054,"d":"2025-10-05"},{"n":"Lê Thị Thanh Hưng","p":null,"t":"INDIVIDUAL","q":64000,"pct":0.046,"d":"2025-10-05"},{"n":"Vũ Hữu Chinh","p":null,"t":"INDIVIDUAL","q":52700,"pct":0.038,"d":"2015-09-14"},{"n":"Croesus Global Equity Limited","p":null,"t":"CORPORATE","q":40000,"pct":0.029,"d":"2015-06-15"},{"n":"Nguyễn Thị Tám","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.029,"d":"2025-10-05"},{"n":"New-S Securities Company Limited","p":null,"t":"CORPORATE","q":36790,"pct":0.026,"d":"2015-06-15"},{"n":"Lê Ngọc Minh","p":null,"t":"INDIVIDUAL","q":33000,"pct":0.024,"d":"2015-09-14"},{"n":"Trần Văn Đăng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":17290,"pct":0.012,"d":"2026-08-24"},{"n":"Nguyễn Duy Nhì","p":null,"t":"INDIVIDUAL","q":15000,"pct":0.011,"d":"2015-09-14"},{"n":"Nguyễn Minh Hoa","p":null,"t":"INDIVIDUAL","q":14000,"pct":0.01,"d":"2026-06-04"},{"n":"Châu Quang Khải","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.007,"d":"2015-09-14"},{"n":"Aizawa Securities Company Limited","p":null,"t":"CORPORATE","q":6500,"pct":0.005,"d":"2015-06-15"},{"n":"Nguyễn Thị Ánh Tuyết","p":null,"t":"INDIVIDUAL","q"