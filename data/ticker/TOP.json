năm 1990. Năm 2003, Chính thức cổ phần hóa với số vốn điều lệ ban đầu là 3 tỷ đồng. Hoạt động sản xuất của công ty là (i) Phân phối các sản phẩm Trung Nguyên, trà Kim Anh, Lipton, nước Tribeco và (ii) Bán buôn đồ uống, thực phẩm. Công ty chủ yếu phân phối sản phẩm trên địa bàn Hà Nội và Quảng Ninh, thông qua các đại lý cấp 2 và các cửa hàng bán lẻ. Công ty là đại lý cấp 1 phân phối sản phẩm đồ uống Tribeco, cà phê Trung Nguyên, trà Kim Anh, bánh Leibiniz. Mạng lưới phân phối: mở rộng toàn miền Bắc. Riêng đối vớ mặt hàng Bò Úc được phân phối tại các đại lý lớn và nhà hàng lớn tại Hà Nội. Ngày 23/07/2015, TOP chính thức giao dịch trên thị trường UPCOM.","sector":"Bán lẻ","type":"CT","listed":"2015-07-23","state":0.0,"foreign":0.01229191,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Trần Hồng Tài","p":null,"t":"INDIVIDUAL","q":6345500,"pct":25.03,"d":"2026-08-10"},{"n":"Đinh Văn Tạo","p":null,"t":"INDIVIDUAL","q":1100000,"pct":4.34,"d":"2025-10-05"},{"n":"Vũ Đình Phúc","p":null,"t":"INDIVIDUAL","q":1045000,"pct":4.12,"d":"2025-10-05"},{"n":"Nguyễn Văn Quỳnh","p":null,"t":"INDIVIDUAL","q":117000,"pct":3.0,"d":"2015-09-14"},{"n":"Hoàng Thế Nam","p":null,"t":"INDIVIDUAL","q":108000,"pct":2.769,"d":"2015-09-14"},{"n":"Nguyễn Ngọc Dưỡng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":607200,"pct":2.4,"d":"2025-10-05"},{"n":"Trương Văn Hùng","p":null,"t":"INDIVIDUAL","q":300000,"pct":1.18,"d":"2025-10-05"},{"n":"Đoàn Văn Thắng","p":null,"t":"INDIVIDUAL","q":300000,"pct":1.18,"d":"2025-10-05"},{"n":"Nguyễn Tiến Thành","p":null,"t":"INDIVIDUAL","q":266400,"pct":1.05,"d":"2025-10-05"},{"n":"Trần Thị Tâm","p":null,"t":"INDIVIDUAL","q":120000,"pct":0.473,"d":"2025-10-05"},{"n":"Triệu Tiến Duẩn","p":null,"t":"INDIVIDUAL","q":100000,"pct":0.39,"d":"2025-10-05"},{"n":"Vũ Thị Vân Anh","p":null,"t":"INDIVIDUAL","q":76600,"pct":0.3,"d":"2025-10-05"},{"n":"Ngô Văn Hanh","p":null,"t":"INDIVIDUAL","q":56200,"pct":0.22,"d":"2025-10-05"},{"n":"Ph