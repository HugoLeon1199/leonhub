p hàng đầu trong lĩnh vực xây lắp của Tổng Công ty Vinaconex. Thế mạnh của công ty là xây dựng công trình dân dụng và công nghiệp. Công ty sở hữu hệ thống thiết bị xây dựng hiện đại như cần trục tháp, trạm trộn bê tông thương phẩm, hệ thống giàn dáo cho các dự án quy mô lớn. Một số dự án công ty đã triển khai là Tràng Tiền Plaza, nhà chung cư Trung Hòa - Nhân Chính, trung tâm hội nghị Quốc gia và khu văn phòng và nhà ở cao cấp Vinaconex 1. Ngày 14/05/2009, VC1 chính thức giao dịch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2009-05-14","state":0.0,"foreign":0.0002535,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xuất nhập khẩu và Xây dựng Việt Nam","p":null,"t":"CORPORATE","q":6616216,"pct":55.14,"d":"2026-07-23"},{"n":"Công ty Cổ Phần Hipt","p":null,"t":"CORPORATE","q":601000,"pct":5.01,"d":"2025-10-27"},{"n":"Vũ Đình Chầm","p":null,"t":"INDIVIDUAL","q":39192,"pct":0.544,"d":"2015-09-14"},{"n":"Thạch Anh Đức","p":null,"t":"INDIVIDUAL","q":38241,"pct":0.32,"d":"2025-10-05"},{"n":"Hoàng Văn Trình","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":17245,"pct":0.144,"d":"2026-03-02"},{"n":"Nguyễn Phúc Hưởng","p":null,"t":"INDIVIDUAL","q":10000,"pct":0.139,"d":"2015-09-14"},{"n":"Quỹ Đầu Tư Trái Phiếu Mb","p":null,"t":"CORPORATE","q":14200,"pct":0.12,"d":"2025-10-05"},{"n":"Đào Thị Bích Hợp","p":null,"t":"INDIVIDUAL","q":8000,"pct":0.111,"d":"2015-09-14"},{"n":"Nguyễn Sỹ Toàn","p":null,"t":"INDIVIDUAL","q":7876,"pct":0.109,"d":"2015-09-14"},{"n":"Đỗ Lê Tân","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":11351,"pct":0.095,"d":"2026-03-02"},{"n":"Phạm Hùng","p":null,"t":"INDIVIDUAL","q":5530,"pct":0.077,"d":"2015-09-14"},{"n":"Chu Quang Minh","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":6000,"pct":0.05,"d":"2026-03-02"},{"n":"Vũ Văn Mạnh","p":"Trưởng Ban kiểm soát","t":"INDIVIDUAL","q":3027,"pct":0.025,"d":"