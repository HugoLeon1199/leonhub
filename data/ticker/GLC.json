":"Vàng Lào Cai","profile":"Công ty Cổ phần vàng Lào Cai (GLC) được thành lập năm 2007 với vốn điều lệ ban đầu là 45 tỷ đồng. Ngành nghề kinh doanh chủ yếu của Công ty là khai thác, tuyển khoáng, sản xuất tinh quặng vàng. Trải qua 2 lần tăng vốn, đến 2016, vốn điều lệ củ Công ty là 105 tỷ đồng. GLC thực hiện dự án đầu tư khai thác và tuyển quặng vàng gốc mỏ vàng Minh Lương, xã Minh Lương, Huyện Văn Bàn, Tỉnh Lào Cai. Sản phẩm của dự án là tinh quặng vàng hàm lượng (quy đổi) 82 gam Au/tấn: sản lượng thiết kế (max) 7.450 tấn/năm, tương đương sản lượng khai thác khoảng 100.000 tấn quặng. Tháng 9, 2018 GLC trở thành công ty đại chúng","sector":"Tài nguyên Cơ bản","type":"CT","listed":"2019-01-09","state":0.0,"foreign":0.0,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"NGUYỄN TIẾN ĐẠT","p":"Thành viên Hội đồng Quản trị/Giám đốc","t":"INDIVIDUAL","q":2500500,"pct":23.81,"d":"2025-10-05"},{"n":"Nguyễn Thu Thảo","p":null,"t":"INDIVIDUAL","q":2500000,"pct":23.81,"d":"2025-10-05"},{"n":"Uông Huy Giang","p":null,"t":"INDIVIDUAL","q":2408350,"pct":22.94,"d":"2020-04-29"},{"n":"Trần Quang Đặng","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":2020000,"pct":19.24,"d":"2025-10-05"},{"n":"Nguyễn Tiến Hải","p":null,"t":"INDIVIDUAL","q":1201100,"pct":11.44,"d":"2025-10-05"},{"n":"Công Ty TNHH Một Thành Viên Khoáng Sản Bitexco","p":null,"t":"CORPORATE","q":675000,"pct":6.43,"d":"2025-10-05"},{"n":"Phạm Thị Thu Nguyệt","p":null,"t":"INDIVIDUAL","q":500000,"pct":4.76,"d":"2025-10-05"}],"events":[{"c":"AGME","t":"GLC - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-24","record":"2026-05-25","ex":"2026-05-22"},{"c":"DDIND","t":"Cao Trường Sơn - Đăng kí Bán GLC","d":"2025-08-14","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Tiến Hải - Đăng kí Mua GLC","d":"2025-08-13","record":null,"ex":null},{"c":"AGME","t":"GLC - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-25","record":"2025-05-19","ex":"2025-05-16"},{"c":"DDIND","t":"NGUYỄN TIẾN ĐẠT - Đăng kí