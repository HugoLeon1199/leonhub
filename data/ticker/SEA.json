4",-0.042],["2025",1.178]]}},"co":{"short":"SEAPRODEX","profile":"Tổng Công ty Thủy sản Việt Nam (SEA) có tiền thân là Công ty Xuất nhập khẩu Thủy sản, được thành lập vào ngày 26/06/1978. Tổng Công ty hoạt động chính trong lĩnh vực nuôi trồng, chế biến thủy sản xuất khẩu, và cơ khí đóng tàu. SEAPRODEX triển khai dự án nuôi cá tầm thương phẩm với sản lượng 100 tấn/năm tại Hồ thủy lợi Kala, xã Bảo Thuận, huyện Di Linh, tỉnh Lâm Đồng. Ngoài ra, Tổng Công ty có 02 cở sở đóng tàu thuộc Công ty con-Công ty Cổ phần Cơ khí Đóng tàu Hạ Long và Công ty Cổ phần Cơ khí Đóng tàu Thủy sản Việt Nam với năng lực đóng mới và sửa chữa tàu có trọng tải lên đến 6.000 tấn. Ngày 23/12/2016, SEA chính thức giao dịch trên thị trường UPCOM.","sector":"Thực phẩm và đồ uống","type":"CT","listed":"2016-12-23","state":0.633824,"foreign":9.94e-06,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Đầu Tư Và Kinh Doanh Vốn Nhà Nước - Công ty TNHH","p":null,"t":"CORPORATE","q":79228000,"pct":63.38,"d":"2026-08-13"},{"n":"Công ty Cổ Phần Địa Ốc Ngân Hiệp","p":null,"t":"CORPORATE","q":30036800,"pct":24.03,"d":"2026-01-20"},{"n":"Công ty Cổ Phần Đầu Tư Redwood","p":null,"t":"CORPORATE","q":10544900,"pct":8.44,"d":"2026-01-06"},{"n":"Công ty Cổ phần Tập đoàn Gelex","p":null,"t":"CORPORATE","q":3021800,"pct":2.42,"d":"2025-11-25"},{"n":"Công Ty Cổ Phần Nova Hospitality","p":null,"t":"CORPORATE","q":2605700,"pct":2.08,"d":"2025-10-05"}],"rel":[{"c":"FSO","n":"Công ty Cổ phần Cơ khí Đóng tàu - Thủy sản Việt Nam","t":"subsidiary","pct":62.37},{"c":"SPH","n":"Công ty Cổ phần Xuất Nhập khẩu Thủy sản Hà Nội","t":"subsidiary","pct":59.34},{"c":"SNC","n":"Công ty Cổ phần Xuất nhập khẩu Thủy sản Năm Căn","t":"subsidiary","pct":50.784},{"c":"0300755379","n":"Công ty Liên Doanh Thủy Sản Việt Nga SEAPRIMFICO","t":"affiliate","pct":50.0},{"c":"SCO","n":"Công ty Cổ phần Công nghiệp Thủy sản","t":"affiliate","pct":46.36},{"c":"SPD","n":"Công ty Cổ phần Xuất nhập khẩu Thủy 