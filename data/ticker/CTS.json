9%. Lợi nhuận trước thuế có giá trị bằng 714,65 tỷ đồng. Tỷ lệ sinh lời trên vốn chủ sở hữu (ROE) ở mức 22.61%, tăng 11.83%. Ngày 20/06/2017, CTS chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Dịch vụ tài chính","type":"CK","listed":"2009-07-31","state":0.75636985,"foreign":0.00534462,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Ngân hàng Thương mại Cổ phần Công thương Việt Nam","p":null,"t":"CORPORATE","q":205917863,"pct":75.635,"d":"2026-07-30"},{"n":"Lê Đức Thọ","p":null,"t":"INDIVIDUAL","q":4423940,"pct":5.603,"d":"2015-09-14"},{"n":"Nguyễn Văn Thành","p":null,"t":"INDIVIDUAL","q":2200,"pct":0.003,"d":"2015-09-14"},{"n":"Phan Quốc Huỳnh","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.003,"d":"2015-09-14"},{"n":"Bùi Thị Thủy Ngân","p":null,"t":"INDIVIDUAL","q":1400,"pct":0.002,"d":"2015-09-14"},{"n":"Nguyễn Thúy Hà","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.001,"d":"2015-09-14"}],"events":[{"c":"AIS","t":"CTS - Niêm yết bổ sung 59.551.501 cổ phiếu","d":"2026-07-14","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 28.0%","d":"2026-06-09","record":"2026-06-15","ex":"2026-06-12"},{"c":"AGME","t":"CTS - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-11","record":"2026-03-24","ex":"2026-03-23"},{"c":"EGME","t":"CTS - Tổ chức ĐHĐCĐ bất thường 2025","d":"2025-10-07","record":"2025-10-21","ex":"2025-10-20"},{"c":"OTHE","t":"CTS - Thay đổi địa chỉ","d":"2025-09-11","record":null,"ex":null},{"c":"AIS","t":"CTS - Niêm yết bổ sung 63.955.127 cổ phiếu","d":"2025-07-17","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 43.0%","d":"2025-05-29","record":"2025-06-06","ex":"2025-06-05"},{"c":"AGME","t":"CTS - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-07","record":"2025-03-27","ex":"2025-03-26"},{"c":"AGME","t":"CTS - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-02-20","record":"2024-03-04","ex":"2024-03-01"},{"c":"EGM