ự, kinh tế, quốc phòng như: Lăng Chủ tịch Hồ Chí Minh, Viện Bảo tàng Hồ Chí Minh, Trung tâm Hội nghị Quốc gia, Nhà Quốc hội và Hội trường Ba Đình mới, Nhà hát lớn Hà Nội, Trụ sở Bộ Công An (Hà Nội), Trụ sở Bộ Tài chính... HAN được giao dịch trên thị trường UPCOM từ tháng 10/2016.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2016-10-20","state":0.98831326,"foreign":7.1e-07,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bộ Xây Dựng","p":null,"t":"CORPORATE","q":139399608,"pct":98.83,"d":"2026-06-23"},{"n":"Nguyễn Đỗ Quý","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":30000,"pct":0.021,"d":"2026-08-05"},{"n":"Dương Thị Kim Quy","p":"Thành viên Ban kiểm soát","t":"INDIVIDUAL","q":900,"pct":0.001,"d":"2026-08-05"},{"n":"Nguyễn Quang Huy","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.001,"d":"2026-08-05"},{"n":"Dương Ngọc Quang","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":100,"pct":0.0,"d":"2026-08-05"}],"rel":[{"c":"0313353719","n":"Công Ty TNHH Một Thành Viên Hancorp3","t":"subsidiary","pct":100.0},{"c":"0106887159","n":"Công Ty TNHH Một Thành Viên Hantech","t":"subsidiary","pct":100.0},{"c":"0104790271","n":"Công ty Cổ Phần Thiết Bị Và Vật Liệu Xây Dựng Hancorp","t":"subsidiary","pct":95.52},{"c":"0108328727","n":"Công ty Cổ Phần Dịch Vụ Đô Thị Hancorp","t":"subsidiary","pct":51.0},{"c":"0107415688","n":"Công ty Cổ Phần Đầu Tư Và Thương Mại Hancorp1","t":"subsidiary","pct":51.0},{"c":"HC1","n":"Công ty Cổ phần Xây dựng số 1 Hà Nội","t":"subsidiary","pct":50.36},{"c":"THHOUS","n":"Công ty Cổ phần Đầu tư phát triển nhà và xây dựng Tây Hồ","t":"subsidiary","pct":50.09},{"c":"2800788143","n":"Công ty Cổ Phần Xây Dựng Hancorp.2","t":"affiliate","pct":46.07},{"c":"0500453907","n":"Công ty Cổ Phần Xi Măng Mỹ Đức","t":"affiliate","pct":44.0},{"c":"0100105246","n":"Công ty Cổ Phần Tư Vấn - Thiết Kế - Xây Dựng - Kinh Doanh Nhà","t":"affiliate","pct":36.0},