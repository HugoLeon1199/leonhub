026-Q2",20.011]],"y":[["2022",9.251],["2023",11.058],["2024",21.166],["2025",21.11]]}},"co":{"short":"Điện lực Gelex","profile":"Công ty Cổ phần Điện lực Gelex (GEE) được thành lập từ ngày 29/08/2016, có tiền thân là Công ty TNHH MTV Thiết bị đo điện. Công ty hoạt động chính trong lĩnh vực sản xuất, kinh doanh thiết bị điện và năng lượng điện, trong đó, hoạt động chế tạo và sản xuất được GEE thực hiện thông qua các công ty con. Các sản phẩm thiết bị điện của GEE đều là các sản phẩm nổi tiếng, có thương hiệu trong ngành điện như dây cáp điện Cadivi, máy biến áp Thibidi, thiết bị đo điện Emic, động cơ điện HEM,... Bên cạnh đó, GEE cũng đang sở hữu Thủy điện Sông Bung 4A với công suất 49MW, Nhà máy điện mặt trời GELEX Ninh Thuận với công suất 50MW, Cụm nhà máy điện gió GELEX 1, 2, 3 với tổng công suất 90MW. Ngày 14/08/2024, GEE chính thức giao dịch trên Sở giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2022-03-08","state":0.0,"foreign":0.00820942,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Tập đoàn Gelex","p":null,"t":"CORPORATE","q":486490760,"pct":75.95,"d":"2026-08-03"},{"n":"Công ty Cổ phần Máy tính - Truyền thông - Điều khiển 3C","p":null,"t":"CORPORATE","q":31272500,"pct":4.88,"d":"2026-08-03"},{"n":"Công ty Cổ phần Cơ điện Trần Phú","p":null,"t":"CORPORATE","q":14050000,"pct":4.68,"d":"2025-10-05"},{"n":"Công ty Cổ Phần Gvi","p":null,"t":"CORPORATE","q":15745200,"pct":2.5,"d":"2026-08-03"},{"n":"Lê Bá Thọ","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":1260000,"pct":0.2,"d":"2026-08-03"},{"n":"Nguyễn Văn Tuấn","p":null,"t":"INDIVIDUAL","q":720000,"pct":0.2,"d":"2025-10-05"},{"n":"Nguyễn Trọng Trung","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1134000,"pct":0.18,"d":"2026-08-03"},{"n":"Dương Quang Sơn","p":null,"t":"INDIVIDUAL","q":240000,"pct":0.07,"d":"2025-10-05"},{"n":"Đặng Phan Tường","p":"Thành viên Hội đ