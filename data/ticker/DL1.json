ch trên Sở Giao dịch Chứng khoán Hà Nội (HNX).","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2010-03-10","state":0.0,"foreign":0.00313433,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Bùi Pháp","p":null,"t":"INDIVIDUAL","q":37906374,"pct":20.99,"d":"2026-02-24"},{"n":"America Limited Liability Company","p":null,"t":"CORPORATE","q":171340,"pct":5.453,"d":"2015-06-15"},{"n":"Công ty TNHH Global Capital","p":null,"t":"CORPORATE","q":4757115,"pct":4.48,"d":"2025-10-05"},{"n":"Lê Phú Hà","p":null,"t":"INDIVIDUAL","q":59226,"pct":1.885,"d":"2015-09-14"},{"n":"Nguyễn Đình Trạc","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin","t":"INDIVIDUAL","q":2078038,"pct":1.15,"d":"2026-02-03"},{"n":"Võ Châu Hoàng","p":null,"t":"INDIVIDUAL","q":19996,"pct":0.636,"d":"2015-09-14"},{"n":"Nguyễn Văn Nguyên","p":null,"t":"INDIVIDUAL","q":7790,"pct":0.248,"d":"2015-09-14"},{"n":"Lê Hoài Nhân","p":null,"t":"INDIVIDUAL","q":2094,"pct":0.067,"d":"2015-09-14"}],"rel":[{"c":"0315016980","n":"Công ty TNHH Điện Tử Dlg Ansen","t":"subsidiary","pct":100.0},{"c":"MASSNOBLE","n":"Công ty TNHH Mass Noble Investment","t":"subsidiary","pct":97.73},{"c":"PTGPLEIKU","n":"Công ty TNHH Phú Thành Gia Pleiku","t":"subsidiary","pct":80.0},{"c":"CPRC","n":"Công Ty TNHH Một Thành Viên Cao Su Chư Prông","t":"subsidiary","pct":65.0},{"c":"4500619268","n":"Công ty Cổ Phần Điện Mặt Trời Dlg Ninh Thuận","t":"subsidiary","pct":50.0},{"c":"DLDNBAB","n":"Công ty Cổ Phần Bot & Bt Đức Long Đắk Nông","t":"affiliate","pct":29.0}],"rel_count":6,"events":[{"c":"OTHE","t":"DL1 - Thay đổi địa chỉ","d":"2026-06-08","record":null,"ex":null},{"c":"AGME","t":"DL1 - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-14","record":"2026-04-22","ex":"2026-04-21"},{"c":"DDRP","t":"Bùi Pháp - Đăng kí Mua DL1","d":"2026-02-24","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Đình Trạc - Đăng kí Mua 733,425 DL1","d":"2026-02-03","record":null,"ex":null},{"c":"AIS