 hành Tư Vấn Đầu Tư Ánh Dương Việt Nam, được thành lập năm 1995. VNS chuyên cung cấp các dịch vụ vận tải bằng xe taxi (thương hiệu TAXI VINASUN), du lịch (thương hiệu VINASUN TRAVEL), nhà hàng, ăn uống, bất động sản. là một thương hiệu mạnh với mức độ nhận biết trên 95%, Vinasun Taxi chiếm hơn 40% thị phần TP. Hồ Chí Minh, 60% thị phần Bình Dương, Đồng Nai, Bà Rịa - Vũng Tàu. Trong mảng kinh doanh du lịch, Công ty hiện là đại lý cấp 1 của các hãng hàng không như VN airline, đại lý cấp 2 của các hãng như Korean Airline, Shanghai Airline, Thai Airways, China Airline...Công ty liên kết được hơn 800 nhà hàng, khách sạn, siêu thị, sân bay, nhà ga để đón khách. Ngày 29/07/2008, VNS chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Du lịch và Giải trí","type":"CT","listed":"2008-07-29","state":0.0,"foreign":0.0228072,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Đặng Phước Thành","p":null,"t":"INDIVIDUAL","q":16907888,"pct":24.916,"d":"2026-07-28"},{"n":"TAEL Two Partners Ltd.","p":null,"t":"CORPORATE","q":12416710,"pct":18.298,"d":"2015-06-15"},{"n":"Lê Hải Đoàn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":10101010,"pct":14.89,"d":"2026-07-28"},{"n":"Ngô Thị Thúy Vân","p":null,"t":"INDIVIDUAL","q":8080590,"pct":11.908,"d":"2026-07-28"},{"n":"Tổng Công ty Thương Mại Sài Gòn - TNHH Một Thành Viên","p":null,"t":"CORPORATE","q":5370300,"pct":7.914,"d":"2025-10-05"},{"n":"Công ty Cổ Phần VBP","p":null,"t":"CORPORATE","q":5269400,"pct":7.77,"d":"2026-07-28"},{"n":"Đặng Thành Duy","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc/Phó Tổng Giám đốc Đối ngoại và Phát triển","t":"INDIVIDUAL","q":3890020,"pct":5.73,"d":"2026-07-28"},{"n":"Andbanc Investments Sif-Vietnam Value And Income Portfolio","p":null,"t":"CORPORATE","q":2623350,"pct":3.87,"d":"2025-10-05"},{"n":"Công ty Cổ phần Tập đoàn HIPT","p":null,"t":"CORPORATE","q":2429800,"pct":3.58,"d":"2026-07-28"},{"n":"Công ty TNHH Tư Vấn Kim N