u của Việt Nam hoạt động trên nhiều lĩnh vực toàn cầu. Ngày 09/06/2017, VFR chính thức giao dịch trên thị trường UPCOM.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2006-12-28","state":0.0,"foreign":5.34e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty TNHH MTV Thương Mại Và Đầu Tư Hưng Phú","p":null,"t":"CORPORATE","q":3674916,"pct":24.5,"d":"2026-05-12"},{"n":"Công ty Cổ Phần Dịch Vụ Bất Động Sản Đà Nẵng","p":null,"t":"CORPORATE","q":3599619,"pct":24.0,"d":"2026-05-13"},{"n":"Công ty Cổ Phần Thương Mại Và Dịch Vụ Du Lịch Ba Đình","p":null,"t":"CORPORATE","q":2915800,"pct":19.44,"d":"2025-10-05"},{"n":"Công ty TNHH Thương Mại Và Đầu Tư Hoà An","p":null,"t":"CORPORATE","q":1966300,"pct":13.11,"d":"2025-10-05"},{"n":"Nguyễn Thị Thanh","p":null,"t":"INDIVIDUAL","q":1877865,"pct":12.519,"d":"2025-10-05"},{"n":"Ngân hàng Thương mại Cổ phần Quân đội","p":null,"t":"CORPORATE","q":715000,"pct":4.767,"d":"2015-06-15"},{"n":"Công ty Cổ phần Chứng khoán VIX","p":null,"t":"CORPORATE","q":577000,"pct":3.85,"d":"2025-10-05"},{"n":"Trần Bình Phú","p":null,"t":"INDIVIDUAL","q":4200,"pct":0.028,"d":"2025-10-05"},{"n":"Nguyễn Giang Tiến","p":null,"t":"INDIVIDUAL","q":3300,"pct":0.022,"d":"2015-09-14"},{"n":"Nguyễn Toan","p":null,"t":"INDIVIDUAL","q":3300,"pct":0.022,"d":"2015-09-14"},{"n":"Nguyễn Tuấn Anh","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.013,"d":"2015-09-14"},{"n":"Trần Văn Quý","p":null,"t":"INDIVIDUAL","q":2000,"pct":0.013,"d":"2015-09-14"},{"n":"Lê Văn Thành","p":null,"t":"INDIVIDUAL","q":500,"pct":0.003,"d":"2025-10-05"},{"n":"Nguyễn Thanh Thuỷ","p":null,"t":"INDIVIDUAL","q":200,"pct":0.001,"d":"2015-09-14"}],"rel":[{"c":"VFHPLOGIS","n":"Công Ty Tnhh Một Thành Viên Vietfracht Hải Phòng","t":"subsidiary","pct":100.0},{"c":"VFHNLOGIS","n":"Công Ty Trách Nhiệm Hữu Hạn Một Thành Viên Vietfracht Hà Nội","t":"subsidiary","pct":100.0},{"c":"VFHCMLOGIS","n":"Công ty TNHH Một Thành Viên Vietfracht Thành Phố Hồ Chí 