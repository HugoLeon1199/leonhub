 ALC và vữa khô trộn sẵn sang Philippines. Ngày 18/05/2020, SCL chính thức được giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-09-15","state":0.0,"foreign":0.00022304,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ Phần Công Nghiệp - Dịch Vụ Cao Cường","p":null,"t":"CORPORATE","q":4856156,"pct":12.807,"d":"2026-08-27"},{"n":"Kiều Văn Mát","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4481374,"pct":11.819,"d":"2026-08-27"},{"n":"Công ty CP bất động sản tài chính dầu khí","p":null,"t":"CORPORATE","q":336700,"pct":3.741,"d":"2015-08-14"},{"n":"Công ty Cổ phần Dầu khí Đông Đô","p":null,"t":"CORPORATE","q":305700,"pct":3.397,"d":"2015-06-15"},{"n":"Nguyễn Anh Dũng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":972114,"pct":2.564,"d":"2026-08-27"},{"n":"Nguyễn Ánh Hồng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":922581,"pct":2.433,"d":"2026-08-27"},{"n":"Công ty Cổ phần Sông Đà 12","p":null,"t":"CORPORATE","q":517492,"pct":2.31,"d":"2025-10-27"},{"n":"Kiều Thị Nhung","p":null,"t":"INDIVIDUAL","q":625558,"pct":1.65,"d":"2026-08-27"},{"n":"Vũ Văn Chiến","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":594663,"pct":1.568,"d":"2026-08-27"},{"n":"Kiều Quang Vọng","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":536411,"pct":1.415,"d":"2026-08-27"},{"n":"Vũ Thị Thanh Huyền","p":null,"t":"INDIVIDUAL","q":460364,"pct":1.19,"d":"2026-08-18"},{"n":"Kiều Văn Cao","p":null,"t":"INDIVIDUAL","q":338924,"pct":0.894,"d":"2026-08-27"},{"n":"Hoàng Hữu Tâm","p":null,"t":"INDIVIDUAL","q":66666,"pct":0.741,"d":"2015-09-14"},{"n":"Nguyễn Hữu Tuấn","p":null,"t":"INDIVIDUAL","q":205693,"pct":0.542,"d":"2026-08-27"},{"n":"Phạm Văn Thư","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":118447,"pct":0.312,"d":"2026-08-27"},{"n":"Nguyễn Tử Chung","p":null,"t":"INDIVIDUAL","q":28000,"pct":0.311,"d":"2015-09-14"},{"n":"Đõ Dũng","p":null,"t":"INDIVIDUAL","q":26666,"pct":0.296,"d":"201