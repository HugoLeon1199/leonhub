 kinh doanh bất động sản, nhà ở, hạ tầng đô thị và khu công nghiệp; đầu tư khai thác khoáng sản. Ngày 01/06/2018, SD7 chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-27","state":0.0,"foreign":0.00400783,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Nguyễn Hữu Doanh","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":4387800,"pct":41.39,"d":"2026-08-12"},{"n":"Công ty Cổ Phần Thủy Điện Cao Nguyên - Sông Đà 7","p":null,"t":"CORPORATE","q":2500000,"pct":23.58,"d":"2026-08-12"},{"n":"Nguyễn Trọng Khoa","p":null,"t":"INDIVIDUAL","q":800000,"pct":7.55,"d":"2025-10-05"},{"n":"Trần Hữu Duyên","p":null,"t":"INDIVIDUAL","q":445000,"pct":4.944,"d":"2015-09-14"},{"n":"Công ty Cổ phần Đầu tư Châu Á - Thái Bình Dương","p":null,"t":"CORPORATE","q":343700,"pct":3.819,"d":"2015-06-15"},{"n":"Ninh Duy Phóng","p":null,"t":"INDIVIDUAL","q":100000,"pct":1.111,"d":"2015-09-14"},{"n":"Nguyễn Hữu Chuẩn","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":92900,"pct":0.88,"d":"2026-05-19"},{"n":"Phạm Văn Hoạt","p":null,"t":"INDIVIDUAL","q":13324,"pct":0.148,"d":"2015-09-14"},{"n":"Nguyễn Hồng Trường","p":null,"t":"INDIVIDUAL","q":5235,"pct":0.058,"d":"2015-09-14"},{"n":"Nguyễn Sỹ Cát","p":null,"t":"INDIVIDUAL","q":308,"pct":0.003,"d":"2015-09-14"},{"n":"Nguyễn Khắc Tiến","p":null,"t":"INDIVIDUAL","q":74,"pct":0.001,"d":"2015-09-14"},{"n":"Chu Thị Chiến","p":"Thư ký Hội đồng Quản Trị/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":43,"pct":0.0,"d":"2026-08-12"},{"n":"Nguyễn Văn Bút","p":"Tổng Giám đốc","t":"INDIVIDUAL","q":51,"pct":0.0,"d":"2026-08-12"}],"rel":[{"c":"S72","n":"Công ty Cổ phần Sông Đà 7.02","t":"affiliate","pct":34.812}],"rel_count":1,"events":[{"c":"AGME","t":"SD7 - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-03-06","record":"2026-03-27","ex":"2026-03-26"},{"c":"OTHE","t":"SD7 - Thay đổi địa chỉ","d":"2025-11-24","record":null,"ex":null},{"c":"AGME","t":"SD7 - Tổ chức