ờng Đông Hải, quận Hải An, thành phố Hải Phòng với độ sâu trước bến 9,5 m, vũng quay 320m, chiều dài cầu tàu 400m và diện tích bãi container 20ha có thể xếp chứa tối đa 12.000 Teus. VGR được giao dịch trên thị trường UPCOM từ tháng 04/2018.","sector":"Hàng & Dịch vụ Công nghiệp","type":"CT","listed":"2018-04-12","state":0.0,"foreign":0.21770104,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Container Việt Nam","p":null,"t":"CORPORATE","q":44687500,"pct":54.35,"d":"2026-08-12"},{"n":"Evergreen Marine Corp. Ltd","p":null,"t":"CORPORATE","q":17875000,"pct":21.74,"d":"2026-05-28"},{"n":"Công ty Cổ phần Quản lý Quỹ Leadvisors","p":null,"t":"CORPORATE","q":11265000,"pct":13.7,"d":"2026-05-28"}],"events":[{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2026 - 2,000 VND","d":"2026-08-06","record":"2026-08-12","ex":"2026-08-11"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2025 - 3,500 VND","d":"2026-04-03","record":"2026-04-09","ex":"2026-04-08"},{"c":"AGME","t":"VGR - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-02-10","record":"2026-02-24","ex":"2026-02-23"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2025 - 2,000 VND","d":"2025-11-21","record":"2025-11-27","ex":"2025-11-26"},{"c":"DDINS","t":"Công ty Cổ phần Quản lý Quỹ Leadvisors - Đăng kí Mua VGR","d":"2025-11-14","record":null,"ex":null},{"c":"AIS","t":"VGR - Đăng ký giao dịch bổ sung 18.974.959 cổ phiếu","d":"2025-09-17","record":null,"ex":null},{"c":"OTHE","t":"VGR - Thay đổi địa chỉ","d":"2025-08-21","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Container Việt Nam - Đăng kí Bán 6,325,000 VGR","d":"2025-07-25","record":null,"ex":null},{"c":"ISS","t":"Phát hành cổ phiếu - Trả Cổ tức bằng Cổ phiếu tỉ lệ 30.0%","d":"2025-07-21","record":"2025-07-28","ex":"2025-07-25"},{"c":"DDINS","t":"Công ty Cổ phần Quản lý Quỹ Leadvisors - Đăng kí Mua VGR","d":"2025-07-17","record":null,"ex":null},{"c":"DDINS","t":"Công ty Cổ phần Container Việt Nam - Đăng kí B