h, địa phương và các đơn vị liên quan tổ chức rất thành công các triển lãm, sự kiện có quy mô chưa từng có, bao gồm: Triển lãm Thành tựu Đất nước “80 năm Hành trình Độc lập – Tự do – Hạnh phúc” nhân kỷ niệm 80 năm Quốc khánh nước Cộng hoà Xã hội Chủ nghĩa Việt Nam; Hội chợ Mùa Thu lần thứ I năm 2025; Tuần lễ Công nghiệp - Công nghệ Việt Nam năm 2025,... Ngoài ra, VEC cũng đăng cai các sự kiện văn hóa, giải trí mang tầm vóc quốc gia và quốc tế thu hút gần 200 nghìn khán giả. VEF được giao dịch trên thị trường UPCOM từ tháng 12/2015.","sector":"Bất động sản","type":"CT","listed":"2015-12-22","state":0.1,"foreign":6.928e-05,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tập đoàn Vingroup - Công ty CP","p":null,"t":"CORPORATE","q":138810945,"pct":83.32,"d":"2026-06-01"},{"n":"Bộ Văn Hóa, Thể Thao Và Du Lịch","p":null,"t":"CORPORATE","q":16660405,"pct":10.0,"d":"2026-02-23"}],"events":[{"c":"AGME","t":"VEF - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-13","record":"2026-04-28","ex":"2026-04-24"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 2 2025 - 33,000 VND","d":"2025-10-17","record":"2025-10-23","ex":"2025-10-22"},{"c":"OTHE","t":"VEF - Thay đổi địa chỉ","d":"2025-07-22","record":null,"ex":null},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Cả năm 2024 - 13,500 VND","d":"2025-06-06","record":"2025-06-13","ex":"2025-06-12"},{"c":"DIV","t":"Trả cổ tức bằng tiền mặt - Đợt 1 2025 - 30,000 VND","d":"2025-06-06","record":"2025-06-13","ex":"2025-06-12"},{"c":"AGME","t":"VEF - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-04-24","record":"2025-05-06","ex":"2025-05-05"},{"c":"OTHE","t":"VEF - Thay đổi địa chỉ","d":"2024-12-04","record":null,"ex":null},{"c":"AGME","t":"VEF - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-04-05","record":"2024-04-22","ex":"2024-04-19"},{"c":"ISS","t":"Phát hành cổ phiếu - Quyền mua CP cho Cổ đông hiện hữu tỉ lệ 512.0%","d":"2023-09-26","record":null,"ex":null},{"c":"AGME","t":"VEF - Tổ chức ĐHĐCĐ thường niên 2023","d"