2023-Q4",22.934],["2024-Q4",20.955],["2025-Q4",16.045],["2026-Q2",16.045]],"y":[["2018",23.396],["2019",24.878],["2020",29.01],["2021",0.0],["2022",36.284],["2023",22.934],["2024",20.955],["2025",16.045]]}},"co":{"short":"Dược phẩm Nam Dược","profile":"Công ty Cổ phần Nam Dược (NDC) được thành lập năm 2004. Công ty chuyên sản xuất các sản phẩm thuốc tân dược, đông được và thực phẩm chức năng. Sản phẩm của công ty có mặt tại khắp các tỉnh thành trên cả nước. Các sản phẩm tiêu biểu của công ty trên thị trường là thực phẩm chức năng Đại tràng, Giải độc gan, Hoạt huyết...Công ty có nhà máy sản xuất dược phẩm tại khu công nghiệp Hòa Xá, thành phố Nam Định có diện tích 10.000 m2, đạt tiêu chuẩn quốc tế đầu tiên của ngành dược Việt Nam. Hiện công ty đang có 5 vùng nguyên liệu đạt chuẩn GACP-WHO giúp công ty đảm bảo chất lượng của sản phẩm. Ngày 11/03/2010, NDC chính thức giao dịch trên thị trường UPCOM.","sector":"Y tế","type":"CT","listed":"2010-03-11","state":0.0,"foreign":0.02067404,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Dương Thị Sáu","p":null,"t":"INDIVIDUAL","q":1417450,"pct":23.767,"d":"2026-08-25"},{"n":"Công ty Cổ Phần Đầu Tư Thương Mại Dịch Vụ Quảng Cáo Promind","p":null,"t":"CORPORATE","q":1286000,"pct":21.563,"d":"2026-06-26"},{"n":"Công ty TNHH Dược Phẩm Ích Nhân","p":null,"t":"CORPORATE","q":1168320,"pct":19.6,"d":"2026-08-25"},{"n":"Công ty Cổ phần Chứng khoán Châu Á - Thái Bình Dương","p":null,"t":"CORPORATE","q":344000,"pct":6.056,"d":"2015-06-15"},{"n":"Nguyễn Văn Giang","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":359200,"pct":6.023,"d":"2026-08-25"},{"n":"Hoàng Minh Châu","p":"Chủ tịch Hội đồng Quản trị/Tổng Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":189500,"pct":3.18,"d":"2026-08-25"},{"n":"Lã Xuân Hạnh","p":"Thành viên Hội đồng Quản trị","t":"INDIVIDUAL","q":139200,"pct":2.334,"d":"2026-08-25"},{"n":"Dương Thị Lan","p":null,"t":"INDIVIDUAL","q":1