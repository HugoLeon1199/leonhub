g trình dân dụng và công nghiệp trong và ngoài ngành dầu khí. Công ty hiện có Xưởng cơ khí gia công kết cấu thép công suất 3000 tấn/năm, trạm trộn bê tông 90m3/h, 30m3/h cơ sở khai thác, sản xuất và kinh doanh vật liệu xây dựng (Mỏ đá Phước Hoà). Thị trường chủ yếu là các đơn vị trong ngành dầu khí. PXM chính thức được niêm yết tại Sở Giao dịch Chứng khoán Hà Nội (HNX) từ ngày 24/06/2014.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2010-06-21","state":0.49,"foreign":0.00165533,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tổng Công ty Cổ phần Xây lắp Dầu khí Việt Nam","p":null,"t":"CORPORATE","q":7240000,"pct":48.26,"d":"2026-08-12"},{"n":"Phạm Chu Tứ","p":null,"t":"INDIVIDUAL","q":2250000,"pct":15.0,"d":"2025-10-05"},{"n":"Đỗ Văn Cường","p":null,"t":"INDIVIDUAL","q":2250000,"pct":15.0,"d":"2015-09-14"},{"n":"Nguyễn Tiến Hùng","p":null,"t":"INDIVIDUAL","q":1650000,"pct":11.0,"d":"2015-09-14"},{"n":"Công ty TNHH Đầu tư và Phát triển Bất động sản EZ","p":null,"t":"CORPORATE","q":1500000,"pct":10.0,"d":"2015-06-15"},{"n":"Tạ Hùng Minh","p":null,"t":"INDIVIDUAL","q":747900,"pct":4.99,"d":"2025-10-05"},{"n":"Bùi Tiến Thành","p":null,"t":"INDIVIDUAL","q":41000,"pct":0.273,"d":"2015-09-14"},{"n":"Bùi Công Toanh","p":null,"t":"INDIVIDUAL","q":40000,"pct":0.267,"d":"2015-09-14"},{"n":"Vương Minh Sơn","p":null,"t":"INDIVIDUAL","q":23210,"pct":0.155,"d":"2015-09-14"},{"n":"Đỗ Quốc Công","p":null,"t":"INDIVIDUAL","q":23000,"pct":0.153,"d":"2015-09-14"},{"n":"Ngô Giang Nam","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.133,"d":"2015-09-14"},{"n":"Vũ Văn Duẩn","p":null,"t":"INDIVIDUAL","q":20000,"pct":0.133,"d":"2015-09-14"}],"events":[{"c":"AGME","t":"PXM - Tổ chức ĐHĐCĐ thường niên 2026","d":"2026-04-03","record":"2026-04-17","ex":"2026-04-16"},{"c":"AGME","t":"PXM - Tổ chức ĐHĐCĐ thường niên 2025","d":"2025-03-07","record":"2025-03-21","ex":"2025-03-20"},{"c":"AGME","t":"PXM - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-05","reco