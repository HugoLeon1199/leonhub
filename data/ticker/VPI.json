g sản. Công ty đã tham gia thiết kế, thi công được nhiều công trình, dự án quy mô lớn với tổng mức đầu tư lên đến hàng chục ngàn tỷ đồng, triển khai nhiều dự án tiêu biểu có tầm ảnh hưởng lớn, như Khu đô thị mới Văn Phú, The Văn Phú Victoria, Home City, Hùng Sơn Villa, Giảng Võ Complex,...VPI được niêm yết và giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2018.","sector":"Bất động sản","type":"CT","listed":"2017-11-28","state":0.0,"foreign":0.1018263,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Tô Như Toàn","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":72600000,"pct":22.68,"d":"2026-07-30"},{"n":"Công ty Cổ phần Đầu Tư THG Holdings","p":null,"t":"CORPORATE","q":68062500,"pct":21.27,"d":"2026-07-30"},{"n":"Viac Limited Partnership","p":null,"t":"CORPORATE","q":28050192,"pct":8.76,"d":"2025-12-05"},{"n":"Tô Như Thắng","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":8749500,"pct":2.73,"d":"2026-07-30"},{"n":"Lê Châu Giang","p":null,"t":"INDIVIDUAL","q":7260000,"pct":2.27,"d":"2026-07-30"},{"n":"Đào Thị Hồng Hạnh","p":null,"t":"INDIVIDUAL","q":7260000,"pct":2.27,"d":"2026-07-30"},{"n":"Phạm Hồng Châu","p":"Thành viên Hội đồng Quản trị/Tổng Giám đốc","t":"INDIVIDUAL","q":1686900,"pct":0.527,"d":"2026-07-30"},{"n":"Nguyễn Diệu Tú","p":"Phó Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":272250,"pct":0.094,"d":"2026-07-30"},{"n":"Đỗ Thị Thanh Phương","p":"Thành viên Hội đồng Quản trị/Phó Tổng Giám đốc/Phụ trách Công bố thông tin/Người phụ trách quản trị công ty","t":"INDIVIDUAL","q":181500,"pct":0.062,"d":"2026-07-30"},{"n":"Lâm Hoàng Đăng","p":"Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1814,"pct":0.001,"d":"2026-07-30"},{"n":"Nguyễn Thị Lan","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.0,"d":"2026-07-30"},{"n":"Ngô Khắc Nghĩa","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.0,"d":"2026-07-30"}],"rel":[{"c":"VPLB","n":"Công Ty TNHH Văn Phú Resort - Lộc Bình","t":"subsidiary","pc