4],["2024",3.977],["2025",18.594]]}},"co":{"short":"KCN Nam Tân Uyên","profile":"Công ty Cổ phần Khu công nghiệp Nam Tân Uyên (NTC) được thành lập năm 2005. Hoạt động sản xuất chính của Công ty là đầu tư xây dựng kinh doanh kết cấu hạ tầng kỹ thuật khu công nghiệp, và xây dựng công trình công nghiệp, dân dụng, thủy lợi, giao thông, san lấp mặt bằng. NTC hiện đang đầu tư, quản lý 3 khu công nghiệp trên địa bàn thành phố Tân Uyên với tổng diện tích 966,5 ha. Ngoài ra, NTC còn tham gia đầu tư vào các dự án trong cùng lĩnh vực kinh doanh như Khu công nghiệp Bình Long, Khu công nghiệp Đức Hòa III, Khu công nghiệp Bắc Đồng Phú, và các dự án ngoài ngành. Ngày 28/10/2025, NTC chính thức giao dịch trên Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE).","sector":"Bất động sản","type":"CT","listed":"2016-12-19","state":0.53272294,"foreign":0.00044321,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công ty Cổ phần Cao su Phước Hòa","p":null,"t":"CORPORATE","q":7884840,"pct":32.854,"d":"2026-06-02"},{"n":"Tập đoàn Công nghiệp Cao su Việt Nam - Công ty Cổ phần","p":null,"t":"CORPORATE","q":4900500,"pct":20.42,"d":"2026-05-08"},{"n":"Công ty Cổ phần Đầu tư Sài Gòn VRG","p":null,"t":"CORPORATE","q":4789100,"pct":19.95,"d":"2026-06-02"},{"n":"Công ty Cổ Phần Đầu Tư Và Phát Triển Vrg Long Thành","p":null,"t":"CORPORATE","q":479000,"pct":2.0,"d":"2025-10-05"},{"n":"Huỳnh Trung Trực","p":null,"t":"INDIVIDUAL","q":171000,"pct":1.07,"d":"2017-03-21"},{"n":"Công ty Cổ phần Xây dựng - Địa ốc Cao su","p":null,"t":"CORPORATE","q":108000,"pct":0.675,"d":"2015-08-14"},{"n":"Quỹ Đầu tư Cổ phiếu Techcom","p":null,"t":"CORPORATE","q":12300,"pct":0.077,"d":"2020-07-14"},{"n":"Huỳnh Hữu Tín","p":null,"t":"INDIVIDUAL","q":4500,"pct":0.019,"d":"2026-06-02"}],"rel":[{"c":"DORULAND","n":"Công ty Cổ Phần Khu Công Nghiệp Bắc Đồng Phú","t":"affiliate","pct":40.0},{"c":"MH3","n":"Công ty Cổ phần Khu công nghiệp Cao su Bình Long","t":"affiliate","pct":37.79},{"c":"DA