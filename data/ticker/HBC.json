ệm chọn làm nhà thầu chính. Công ty đã thi công các công trình tiêu biểu như Saigon Sky Garden Apartments, Stamford Court, Riverside Apartment, Legend Hotel, Melinh Point Tower, Ocean Place. Công ty là nhà thầu chính dự án Vietinbank Tower (Hà Nội) – công trình cao nhất Việt Nam (cao 363m) và dự án Saigon Centre (TP.HCM) – công trình sâu nhất Việt Nam với 6 tầng hầm (sâu 28m) tại thời điểm thi công. Ngày 18/09/2024, HBC chính thức giao dịch trên thị trường UPCOM.","sector":"Xây dựng và Vật liệu","type":"CT","listed":"2006-12-27","state":0.0,"foreign":0.09011606,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Lê Viết Hải","p":"Chủ tịch Hội đồng Quản trị","t":"INDIVIDUAL","q":46987699,"pct":13.53,"d":"2026-08-04"},{"n":"Hyundai Elevators Co., Ltd.","p":null,"t":"CORPORATE","q":23060750,"pct":6.64,"d":"2026-04-16"},{"n":"KIM Vietnam Growth Equity Fund","p":null,"t":"CORPORATE","q":10921118,"pct":4.73,"d":"2025-10-05"},{"n":"PYN Elite Fund","p":null,"t":"CORPORATE","q":9139402,"pct":4.66,"d":"2025-10-05"},{"n":"Sanei Architecture Planning Co., Ltd","p":null,"t":"CORPORATE","q":5000000,"pct":1.87,"d":"2025-10-05"},{"n":"Bùi Ngọc Mai","p":null,"t":"INDIVIDUAL","q":4756612,"pct":1.37,"d":"2026-02-09"},{"n":"Công ty Cổ phần Quản lý quỹ Ngân hàng TMCP Đại chúng Việt nam","p":null,"t":"CORPORATE","q":869460,"pct":1.166,"d":"2015-06-15"},{"n":"UBS AG London Branch","p":null,"t":"CORPORATE","q":500000,"pct":0.67,"d":"2015-06-15"},{"n":"Lê Thị Anh Thư","p":null,"t":"INDIVIDUAL","q":2005784,"pct":0.58,"d":"2026-02-09"},{"n":"Trương Quang Nhật","p":null,"t":"INDIVIDUAL","q":1578757,"pct":0.58,"d":"2025-10-05"},{"n":"Lê Viết Hiếu","p":"Phó Chủ tịch Hội đồng Quản trị/Phó Tổng Giám đốc","t":"INDIVIDUAL","q":1714264,"pct":0.49,"d":"2026-08-04"},{"n":"Lê Viết Hưng","p":null,"t":"INDIVIDUAL","q":1357680,"pct":0.39,"d":"2026-02-09"},{"n":"Lê Viết Hà","p":null,"t":"INDIVIDUAL","q":1201351,"pct":0.35,"d":"2026-02-09"},{"n":"Nguyễn Lê Tân","p":null,"t":"I