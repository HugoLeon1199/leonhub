C) - thành viên của Tập Đoàn Dầu Khí Quốc Gia Việt Nam. Công ty có vốn điều lệ 40 tỷ đồng và sở hữu 55% cổ phần tại Công ty CP Đầu tư và Khai thác Barite Bắc Kạn. Công ty sở hữu dự án hóa dầu đầu tiên của Việt Nam nằm trong cụm công nghiệp Lọc hóa dầu Dung Quất tại Khu Kinh tế Dung Quất.","sector":"Hóa chất","type":"CT","listed":"2015-12-18","state":0.0,"foreign":0.001,"rating":null,"target":null,"rating_as_of":null,"source":"Vietcap"},"owners":[{"n":"Công Ty Cổ Phần 873 - Xây Dựng Công Trình Giao Thông","p":null,"t":"CORPORATE","q":1970440,"pct":50.21,"d":"2025-10-05"},{"n":"Đặng Đình Hậu","p":null,"t":"INDIVIDUAL","q":784910,"pct":20.0,"d":"2021-11-17"},{"n":"Trần Thị Kim Cúc","p":null,"t":"INDIVIDUAL","q":431700,"pct":11.0,"d":"2023-09-28"},{"n":"Nguyễn Văn Công","p":null,"t":"INDIVIDUAL","q":372850,"pct":9.5,"d":"2023-08-09"},{"n":"Nguyễn Đăng Thưởng","p":null,"t":"INDIVIDUAL","q":137008,"pct":3.49,"d":"2023-06-27"},{"n":"Lương Nguyễn Minh Phượng","p":null,"t":"INDIVIDUAL","q":5500,"pct":0.14,"d":"2023-07-11"},{"n":"Trần Khắc Ngư","p":null,"t":"INDIVIDUAL","q":5200,"pct":0.13,"d":"2019-05-29"},{"n":"Phùng Thị Loan","p":null,"t":"INDIVIDUAL","q":4000,"pct":0.1,"d":"2016-08-18"},{"n":"Nguyễn Thế Hoành","p":null,"t":"INDIVIDUAL","q":2300,"pct":0.06,"d":"2016-08-18"},{"n":"Nguyễn Minh Hải","p":null,"t":"INDIVIDUAL","q":1000,"pct":0.03,"d":"2023-07-11"},{"n":"Đào Thị Minh Thùy","p":null,"t":"INDIVIDUAL","q":300,"pct":0.008,"d":"2016-08-18"}],"events":[{"c":"SUSP","t":"PCN - Hủy đăng ký giao dịch cổ phiếu trên sàn UPCOM","d":"2024-12-02","record":null,"ex":null},{"c":"AGME","t":"PCN - Tổ chức ĐHĐCĐ thường niên 2024","d":"2024-03-14","record":"2024-03-28","ex":"2024-03-27"},{"c":"DDIND","t":"Trần Thị Kim Cúc - Đăng kí Mua PCN","d":"2023-09-28","record":null,"ex":null},{"c":"DDINS","t":"Công Ty Cổ Phần 873 - Xây Dựng Công Trình Giao Thông - Đăng kí Mua 39,100 PCN","d":"2023-08-31","record":null,"ex":null},{"c":"DDIND","t":"Nguyễn Văn Dũng - Đăng kí Bán PCN","d":"2023-08